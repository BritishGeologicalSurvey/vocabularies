    lexicon:hasThicknessDescription "490 metres. Lateral variations, 320 - 490 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of Corwen Grit Member succeeded by pale grey-green siltstones and mudstones of the Fron Frys Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
