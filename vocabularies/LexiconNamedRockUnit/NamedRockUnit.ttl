namedrockunit:CWF
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:DBLB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A residual deposit formed from the dissolution, decalcification and cryoturbation of bedrock strata of the Chalk Group and Palaeogene formations and, in the extreme west of the outcrop, the Upper Greensand Formation. It is unbedded and heterogenous. The dominant lithology is orange-brown and red-brown sandy clay with abundant nodules and rounded pebbles of flint. Angular flints are derived from the Chalk, and rounded flints, sand and clay from Palaeogene formations. There is commonly a discontinuous basal layer up to 10 cm thick, with dark brown to black matrix, stiff, waxy and fissured, with relatively fresh flint nodules stained black or dark green with manganese or glauconite. The deposit locally includes bodies of yellow fine- to medium- grained sand, reddish brown clayey silt, and sandy clay with beds of well-rounded flint pebbles, derived from Palaeogene formations. In the extreme west of the outcrop, in Devon, the deposit locally comprises sand and clayey sand containing angular, shattered blocks of chert. This is derived wholly from the Upper Greensand Formation, in areas where the Chalk Group has been removed by erosion."@en ;
    lexicon:hasLowerBoundaryDefinition "The Clay-with-flints Formation rests upon Palaeogene formations, Chalk Group or Upper Greensand. Where it rests upon a Palaeogene formation or Upper Greensand, the base is taken at the base of intense cryoturbation. The base may be flat or may be highly uneven where it rests in dissolution hollows, particularly where it rests upon the Chalk. If the material is soliflucted and comes to rest on an inclined surface on a hillside, then it is classed as Head and not as a part of the Clay-with-flints Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CWFL ,
        namedrockunit:H3926 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 10 m, but very variable where let down into dissolution pipes in the Chalk Pipes and hollows may be 1 to 50 m in diameter."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly occurs at surface. Mainly overlain by Middle Quaternary glacial deposits, particularly in Hertfordshire. Locally overlain by Late Quaternary head or fluvial deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clay with flints [Obsolete: use CWF, CHGR]"@en ,
        "Clay-with-flints"@en ,
        "Disturbed Blackheath Beds"@en ;
    skos:broader namedrockunit:RESID ;
    skos:definition "Flint and sandy clay with subsidiary chert, clayey silt and sand. Stratified superficial deposits. Occurs onshore. Formed during the Paleogene Period - to - Pleistocene Epoch (Quaternary Period) (66-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DBLB ,
        namedrockunit:HDY ;
    skos:notation "CWF"@en ;
    skos:prefLabel "Clay-with-flints Formation"@en ;
.

