    lexicon:hasThicknessDescription "15 metres, which is approx. thickness to neighbourhood of Raisbeck, beyond which it thickens to c.80 metres at west edge of NY60NW where it is a largely hard, laminated sandstone formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
