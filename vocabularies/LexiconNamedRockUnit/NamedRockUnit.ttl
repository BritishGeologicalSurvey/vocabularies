    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 100 m to 255 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Apparently conformable, probably diachronous, at the base of the lavas of the Montrose Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Barras Conglomerate Formation [Obsolete: use BACO]"@en ,
        "Johnshaven Formation [Obsolete: use BACO, CATC, SJKS, TWSA]"@en ;
    skos:broader namedrockunit:CATC ;
    skos:definition "Conglomerate with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BACO"@en ;
    skos:prefLabel "Barras Conglomerate Member"@en ;
