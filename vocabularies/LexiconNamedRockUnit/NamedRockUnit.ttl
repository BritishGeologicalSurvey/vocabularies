namedrockunit:HWD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLateralEquivalent namedrockunit:YT ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "At outcrop, flaggy, blue-grey, calcereous sandstones with interbedded olive siltstones and overlain by purple and olive siltstones; in Fownhope Borehole, green-grey siltstones with minor claystones (107.7 m. proved) overlain by 135.3 m. of green-grey sandstones with interbedded siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen at outcrop; placed at 982 feet in Fownhope Borehole, where green-grey siltstones of the Yartleton (Haugh Wood) Formation overlie interbedded siltstones and sandstones of the Huntley Hill Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H972 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ST> ;
    lexicon:hasOldestAgeValue 4.386e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/ST> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "93m at outcrop (base not seen); 243m drilled in Fownhope Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of limestone of the Woolhope Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ST> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Upper Haugh Wood Beds and Lower Haugh Wood Beds [Obsolete: use HWD]"@en ,
        "Yartleton Formation"@en ;
    skos:broader namedrockunit:MHS ;
    skos:definition "Sandstone with subsidiary limestone, mudstone and siltstone and trace silicate-claystone. Stratified bedrock. Occurs onshore. Deposited during the Telychian Age (Silurian Period) (438.6-432.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HWD"@en ;
    skos:prefLabel "Haugh Wood Formation"@en ;
.

namedrockunit:HWLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bedded shelly ooidal limestone, locally sandy or pisoidal, with thin interbedded calcareous mudstones. Commonly has a basal mudstone chert and sandstone pebble conglomerate, and coralliferous limestones are developed in the Highway area."@en ;
    lexicon:hasLowerBoundaryDefinition "Base is either: (in east) sharp change up from medium- to coarse-grained sand/sandstone of Beckley Sand Member into shelly ooidal limestone with basal conglomerate, or a non-sequence with interbedded yellowish silty and clayey fine quartz sand with sandstone \"doggers\" and sandy mudstone (Hazelbury Bryan Formation) overlain by shelly ooidal limestone with local conglomerate (Highworth Limestone Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H973 ,
        namedrockunit:H974 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "2 to 3 m in type area, 2.6 m at Lamb and Flag Quarry, thins laterally, 0.3 m at Wooton Bassett."@en ;
    lexicon:hasUpperBoundaryDefinition "Top is marked by upward change from shelly ooidal limestone of the Highworth Limestone Member into cross-bedded fissile sandy ooidal limestone or calcareous mudstone (Pusey Flags Member), where present, or variably sandy grey to brown mudstone (Highworth Clay Member). Contact might be erosional."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Coral Rag [Obsolete: use HWLS]"@en ,
        "Pebble Bed + Pisolite + Lower Trigonia Bed + Upper Trigonia Bed + Urchin Marls [Obsolete: use HWLS]"@en ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Limestone with subsidiary calcareous mudstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HWLS"@en ;
    skos:prefLabel "Highworth Limestone Member"@en ;
.

namedrockunit:HY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SMCCST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the western Weald, the formation comprises mainly fine- to medium-grained, sparsely glauconitic sands, sandstones and silts, locally pebbly, with calcareous or siliceous cement in beds or lenses in some areas. Some clay interbeds, including Fuller's Earth. In Kent and eastern Sussex the formation comprises, alternating sandy limestones (\"Ragstone\") and glauconitic sandy mudstones (Hassock)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the incoming of fine- to medium-grained sands above the silty or sandy clays of the Atherfield Clay, and is generally sharply defined. See also Hoes Farm Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H975 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "18 to 100m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the unconformable to disconformable contact at the base of heterogeneous sediments of the Sandgate Formation. Generally the boundary is identified by the upward change from sparsely glauconitic sands of the Hythe Formation to glauconitic medium-grained sands and silts with pebbles of the individual members of the Sandgate Formation. This boundary is not easy to recognize in much of Sussex. There is generally an unconformable to disconformable contact."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hythe Beds [Obsolete: use HY]"@en ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Limestone, sand and sandstone with subsidiary sandy mudstone and siltstone and trace smectite-claystone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:HFA ;
    skos:notation "HY"@en ;
    skos:prefLabel "Hythe Formation"@en ;
