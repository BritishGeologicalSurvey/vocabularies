namedrockunit:EYF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, fissile, finely ooidal grainstone interbedded with grey, laminated fissile calcareous sandstone, locally decalcified to loose orange-brown sand, with minor beds of shelly and shell-fragmental limestone, marl or fissile mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of limestone/sandstones as described in lithology, resting on fissile mudstone of underlying un-named unit of Fuller's Earth Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1536 ,
        namedrockunit:H2179 ,
        namedrockunit:H898 ,
        namedrockunit:H899 ,
        namedrockunit:SSL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 7 m; 6 to 7 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp generally erosive base of coarse-grained ooidal grainstone of Taynton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cotswold Slates [Obsolete: use EYF]"@en ,
        "Eyford Sandstone Member [Obsolete: use EYF]"@en ,
        "Stonesfield Beds [Obsolete: use EYF]"@en ,
        "Stonesfield Slate Series [Obsolete: use EYF]"@en ,
        "Stonesfield Slate [Obsolete: use EYF]"@en ;
    skos:broader namedrockunit:FE ;
    skos:definition "Limestone with subsidiary sandstone and trace calcareous mudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EYF"@en ;
    skos:prefLabel "Eyford Member"@en ;
