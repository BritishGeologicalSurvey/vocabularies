    lexicon:hasThicknessDescription "0-166m (0-545ft)"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable transition into sandstone-dominated succession of the Sherwood Sandstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
