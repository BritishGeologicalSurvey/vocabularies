    lexicon:hasThicknessDescription "Range 197m-306m. Mean 258m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the highest mappable sandstone (Corley Sandstone) beneath the basal argillaceous sequence of the overlying Allesley Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Coventry Sandstone (middle part) [Obsolete: use KRS]"@en ;
    skos:broader namedrockunit:SAL ;
    skos:definition "Mudstone and sandstone with subsidiary conglomerate and limestone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CRSA ;
    skos:notation "KRS"@en ;
    skos:prefLabel "Keresley Member"@en ;
