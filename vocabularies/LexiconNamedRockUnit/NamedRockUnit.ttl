        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A conglomeratic basal division grading upwards into thinly interbedded and interlaminated sandstones and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the metamorphosed and igneous rocks of the Sarn Complex."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4490 ;
