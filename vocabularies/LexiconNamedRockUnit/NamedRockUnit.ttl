    skos:broader
        namedrockunit:EISR ,
        namedrockunit:HJG ;
    skos:definition "Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 3 - to - Marine Isotope Stage 1 (Quaternary Period) (.059-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MACA"@en ;
