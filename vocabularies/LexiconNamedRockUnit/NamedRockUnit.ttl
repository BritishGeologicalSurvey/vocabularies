        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Shelly, locally sandy, oosparite; lower beds commonly micritic, with interbeds of oolitic marl."@en ;
    lexicon:hasLowerBoundaryDefinition "Fairly abrupt change from oolitic, grey clay, to shelly limestones."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H176 ;
