namedrockunit:PMDS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, dark grey, micaceous and silty, fining upwards, with red-weathering sideritic concretions and layers of phosphate nodules, many containing the bivalve Meleagrinella substriata."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: sharp change up from grey shaly mudstone with common layers of calcareous concretions (Alum Shale Member) into dark grey micaceous and silty mudstone with red-weathering sideritic concretions: Bed 44b on Bed 44a at Blea Wyke (bed numbers of Dean, 1954)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3616 ,
        namedrockunit:H3617 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
