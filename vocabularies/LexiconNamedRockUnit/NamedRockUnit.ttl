    lexicon:hasThicknessDescription "Up to 150 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp entrance of mudstone dominated sequences of the Bronydd, Coldbrook or Golengoed Formations in the type area. Top not seen at Rhayader due to local disconformity at base of Telychian Formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
