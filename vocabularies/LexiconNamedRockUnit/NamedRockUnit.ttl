namedrockunit:OC
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Ormesby Clay is variably glauconitic, partly calcareous clay, commonly silty at the base, with a basal gravel bed. The gravelly bed is typically between 0.1 and 0.2 m thick, comprising unworn green-coated flints in a matrix of bright green, glauconitic-rich sand or sandy silt. The mudstone is intensively bioturbated, blocky and poorly bedded. It is mostly pale grey to dark greenish grey but also includes a bed of red-grey mudstone and thin bands of grey-green mudstone. Sporadic, thin altered tephra layers occur in the lower part (Ellison et al., 1994). The Ormesby Clay differs from offshore portions of the Lista Formation principally in containing significant glauconite (King, in prep.). \r
\r
Marine; outer neritic to upper bathyal (King, in prep.). \r
\r
Late Paleocene (Ellison et al., 1994) and references therein. Late Selandian to mid-Thanetian (King, in prep.), based on dinoflagellate cysts (Zone DP10 to Subzone DP11b) (Jolley, 1992)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Ormesby Clay is the base of the basal sandy flint gravel bed, which rests unconformably on the Chalk Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5089 ,
        namedrockunit:H5090 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GS> ;
    lexicon:hasOldestAgeValue 6.17e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "27.45 m in the type section, reducing to about 10 m at Sizewell, Suffolk. Assumed to thin further southwards towards the Ipswich-Felixstowe High (Boswell, 1915; Jolley, 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition """The top of the Ormesby Clay is an erosion surface (King, in prep.). The uppermost few centimetres commonly includes burrows filled from the overlying sediment. \r
\r
In Norfolk and parts of Suffolk, an upwards change from bioturbated glauconitic clay to dark grey-brown, laminated sandy clay or muddy sand of the Upnor Formation (previously the Hales Clay). \r
\r
In southern Suffolk, an upwards change to interbedded medium-grained sand and laminated grey-green mudstone of the Upnor Formation."""@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ormesby Clay Formation [Obsolete: use OC]"@en ,
        "Ormesby Clay [Obsolete: use OC]"@en ;
    skos:broader namedrockunit:LIST ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Selandian Age - to - Thanetian Age (Palaeogene Period) (61.7-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OC"@en ;
    skos:prefLabel "Ormesby Clay Member"@en ;
.

namedrockunit:OCKD
    a skos:Concept ;
    lexicon:hasLithologyDescription "According to King (1981, 2003) the Ockendon Member can be divided into a lower part (A3i) that comprises silty homogeneous clay with several layers of grey claystones, and an upper part (A3ii) that comprises silty clay with many very thin layers of very fine-grained sand. This also contains claystone but in very thin layers and lenses that are commonly soft and red-brown."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Ockendon Member is marked by the upwards appearance of homogeneous strata mainly comprising grey clays and claystones with calcareous fossils and calcareous concretions, with less silty clay than in the underlying Walton Member (King, 1981, 2003, in prep.)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5088 ,
        namedrockunit:UNITB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The Ockendon Member thickens generally eastwards to a maximum of 18m (King, 1981, in prep.)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Ockendon Member is marked by the disappearance of thin layers and partings of well-sorted, fine-grained sand (beneath a thin bed of sandy silty clay at the base of the Aveley Member) and a return to mainly homogeneous clay."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Division A3 of King (1981) [Obsolete: use OCKD]"@en ,
        "Unit B of Ellison et al., 2004 [Obsolete: use OCKD]"@en ;
    skos:broader namedrockunit:LC ;
    skos:definition "Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OCKD"@en ;
    skos:prefLabel "Ockendon Member"@en ;
.

namedrockunit:OFFA
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:CHAM ,
        namedrockunit:RMU ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Offa Formation consists of a rhythmically interbedded sequence of dark grey mudstones with moderately thick beds of argillaceous limestone and, locally, thin ferruginous developments."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is characterised by a sharp downward change from dark grey mudstones to paler, harder, argillaceous limestones (Penda Formation), together with a sharp down-section increase in velocity and slight decrease in gamma values."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 190 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downward change from hard, silty and sandy limestones (Ida Formation) to mudstones. This corresponds to a gradual or weak increase of gamma-ray values, but a marked decrease in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Charmouth Mudstone Formation"@en ,
        "Redcar Mudstone Formation"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs offshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OFFA"@en ;
    skos:prefLabel "Offa Formation"@en ;
.

