namedrockunit:DRE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFASST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Drefach Group comprises mudstones, limestones and tuffs of Llanvirn to Caradoc age exposed on the southwestern margin of the Lower Palaeozoic Welsh Basin. In its type area, south of the village of Drefach, Carmarthenshire, the Drefach Group comprises a lower Felin Wen Formation (formally the Didymograptus murchisoni Beds) overlain by the Asaphus Ash Formation. This is succeeded in turn by the Hendre Shales Formation, Mydrim Limestone Formation and Mydrim Shales Formation (eg Strahan et al. 1909)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the Group is taken at the base of the Felin Wen Formation. The boundary is not exposed, but the incoming of the Formation was previously described by Strahan et al. (1909), from outcrop in a road bank opposite the corn mill in the village of Felin Wen, which yielded Didymograptus murchisoni graptolites."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Greater than 600m in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the top of the Mydrim Shales Formation. The boundary is not exposed, but in the type area is defined by a faulted contact with pale grey burrow-mottled mudstones of the Nantmel Mudstones Formation of Ashgill age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone with subsidiary calcareous mudstone, limestone, tuff and tuffaceous-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Llanvirn Series - to - Caradoc Series (Ordovician Period) (468-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "DRE"@en ;
    skos:prefLabel "Drefach Group"@en ;
.

namedrockunit:DREN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, orange-red, very fine-to medium-grained, poorly sorted, weakly calcareous dolomitic cement, mudstone up to 25%, deep orange-brown."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational decrease in proportion of red mudstone from underlying White Brae Mudstone Formation [formerly Permian Upper Marls]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "160-177m [525-580 ft]."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, with loss of red mudstones in succeeding Toomebridge Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SSG ;
    skos:definition "Mudstone and sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DREN"@en ;
    skos:prefLabel "Drumcullen Formation"@en ;
