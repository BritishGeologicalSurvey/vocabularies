namedrockunit:ISCAG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamicton, gravel, sand, silt and clay, typically reddish brown and containing clasts of red and yellow sandstone, wacke sandstone and siltstone, granite and granodiorite. Welded tuff (Borrowdale Volcanic Group), mudstone, coal, shell fragments and reworked marine microfossils are common to the south of the Solway Firth."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WCDR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
