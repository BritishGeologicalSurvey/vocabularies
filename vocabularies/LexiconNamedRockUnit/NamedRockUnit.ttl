namedrockunit:CCG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PHGV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Carbonate-rich skeletal sands. The acid-insoluble sand fraction is moderately- to poorly-sorted medium-grained sand, the mud content is low. Basal  lag gravel rich in pebbles of phosphatic mudstone largely derived from the Thames Group."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on the undulose, possibly tidally-scoured, surface of the Thames Group throughout its known distribution."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3283 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasOldestAgeValue 5.33e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.25m maximum onshore."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by rocks of the Norwich Crag Formation across most of its extent, but Red Crag Formation material is banked against a buried ridge of the Coralline Crag in some areas and thin Red Crag deposits overlie the Coralline Crag locally."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q2G> ;
    lexicon:hasYoungestAgeValue 1.8e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Coralline Crag [Obsolete: use CCG]"@en ;
    skos:broader namedrockunit:CRAG ;
    skos:definition "Calcareous sandstone and sand with subsidiary gravel and trace phosphate-gravel. Stratified bedrock. Occurs onshore. Deposited during the Pliocene Epoch (Neogene Period) - to - Gelasian Age (Quaternary Period) (5.33-1.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:S500 ,
        namedrockunit:S750 ,
        namedrockunit:S751 ;
    skos:notation "CCG"@en ;
    skos:prefLabel "Coralline Crag Formation"@en ;
.

namedrockunit:CFB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S134 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Chillesford Church Sand Member comprises well sorted,fine-to medium-grained,micaceous,buff to pale brown,quartz sand.It is commonly decalcified, but locally patches of shell material are preserved, notably in the Chillesford Church Pit [TM 3829 5231] where the deposit was formerly termed the 'Scrobicularia Crag' due to an abundance of this bivalve. The member is characterised by planar bedding and small-scale ripple cross-stratification. Mud laminae, flasers and intraclasts occur sporadically and much of the sequence is strongly bioturbated and contains prominent vertical burrows. A depositional environment of tidal sand flats is probable."@en ;
    lexicon:hasLowerBoundaryDefinition "The Chillesford Church Sand Member overlies the typically coarser grained, and generally more red-brown (green at depth where glauconite has not been oxidized), Red Crag Formation without any marked discontinuity."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H119 ,
        namedrockunit:H2069 ,
        namedrockunit:H3914 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QN> ;
    lexicon:hasOldestAgeValue 2.12e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 13m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Chillesford Church Sand Member passes upwards through a gradational interbedded transition into the Chillesford Clay Member, which consists predominantly of clays and silts."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QN> ;
    lexicon:hasYoungestAgeValue 2e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chillesford Beds [Obsolete: use CFB]"@en ,
        "Chillesford Member"@en ,
        "Chillesford Sand Member [Obsolete: use CFB]"@en ,
        "Chillesford Sand [Obsolete: use CFB]"@en ;
    skos:broader namedrockunit:NCG ;
    skos:definition "Sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Antian/Bramertonian Stage (Quaternary Period) (2.12-2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CFB"@en ;
    skos:prefLabel "Chillesford Church Sand Member"@en ;
.

namedrockunit:CFCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCDI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Layered cumulate gabbros and quartz-gabbros, forming the Mosedale Intrusions which have a calc-alkaline/transitional to tholeiitic composition, microgabbro, microgranite with apatite-bearing iron-rich microdiorite, micromonzodiorite and microgranite zones forming the tholeiitic Carrock Intrusions, quartz-phyric rhyolite of the Harestones Rhyolite, and a microgranite named the Iron Crag Microgranite. Several component intrusions have Ordovician radiometric ages (Mosedale Gabbros, Carrock intrusions)."@en ;
    lexicon:hasLowerBoundaryDefinition "Not defined."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasOldestAgeValue 4.869e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasThicknessDescription "A near-vertical, sheet-like mass of about 8.5 sq. km emplaced at the junction between the Skiddaw Group and the Eycott Volcanic Group."@en ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LDMP ;
    skos:definition "Gabbro, microgabbro and microgranite with subsidiary microdiorite and rhyolite. Bedrock. Occurs onshore. Formed during the Ordovician Period (486.9-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CFCOC ,
        namedrockunit:CFCOH ,
        namedrockunit:CFCOI ,
        namedrockunit:CFCOM ;
    skos:notation "CFCO"@en ;
    skos:prefLabel "Carrock Fell Complex"@en ;
.

namedrockunit:CFCOC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCDI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCMZDI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A microgabbro, cutting the main mass of micrographic microgranite, a narrow marginal zone of apatite-bearing, iron-rich gabbro, microdiorite, micromonzodiorite and microgranite. Radiometric age: microgranite 452.4 +/- 4.1 Ma (U-Pb, zircon) (Millward and Evans, 2003)."@en ;
    lexicon:hasLowerBoundaryDefinition "Not defined."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2682 ,
        namedrockunit:H2683 ,
        namedrockunit:H3915 ,
        namedrockunit:H764 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "A near-vertical sheet like mass emplaced with the Carrock Fell Complex."@en ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carrock Diabase [Obsolete: use CFCOC]"@en ,
        "Carrock Gabbro-Microgranite Division [Obsolete: use CFCOC]"@en ,
        "Carrock Granophyre [Obsolete: use CFCOC]"@en ,
        "Carrock Series [Obsolete: use CFCOC]"@en ;
    skos:broader namedrockunit:CFCO ;
    skos:definition "Gabbro, microgabbro and microgranite with subsidiary microdiorite and micromonzodiorite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CFCOC"@en ;
    skos:prefLabel "Carrock Gabbro-Microgranite Intrusions"@en ;
.

namedrockunit:CG
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to pinkish brown fine- to coarse-grained ooidal, peloidal and shell-detrital packstone to grainstone, with large orange-skinned peloids/pisoids and aggregate grains; common whole shells especially in upper part. Characteristic fauna includes the large echinoid Clypeus ploti Salter, large myacean bivalves and terebratulid brachiopods (Stiphrothyris). From Stroud southwards, includes coral-rich limestone ('Upper Coral Bed') at base."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change from shelly coarsely shell-fragmental limestone (Upper Trigonia Grit Member), to limestone as described under Lithology. Commonly a non-sequence, marked by a hardground, though locally appears to be transitional. Where Upper Trigonia Grit Member absent, boundary is hardground capping Aston Limestone or Birdlip Limestone formations, or unconformity on older beds."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2073 ,
        namedrockunit:H2074 ,
        namedrockunit:H770 ,
        namedrockunit:H771 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 10 to 12m. Type section 10.5 to 12m. Maximum c.16m (Colesbourne area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change to mudstone (Fuller's Earth Formation) in southwest or into fine- to medium-grained ooidal grainstone (Chipping Norton Limestone Formation) in northeast. Generally transitional, but locally marked by a hardground (Sumbler, M G, Barron, A J M and Morigi, A N, 2000)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clypeus Grit [Obsolete: use CG]"@en ,
        "Clypeus Grit and White Oolite [Obsolete: use CG]"@en ,
        "Pholadomya Grit [Obsolete: use CG]"@en ,
        "Rubbly Beds and Upper Coral Bed [Obsolete: use CG]"@en ;
    skos:broader namedrockunit:SALS ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CG"@en ;
    skos:prefLabel "Clypeus Grit Member"@en ;
.

