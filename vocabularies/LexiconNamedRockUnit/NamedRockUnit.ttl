namedrockunit:PRSA
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PRHA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Halite, with thin partings of reddish brown and dark greenish grey mudstone. Breccias formed by dissolution are common at shallow depth."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at the gradational upward transition from the laminated reddish brown and greenish grey mudstones (formerly referred to the Thornton Mudstone Member, now undifferentiated Kirkham Mudstone Member) to the halite of the Preesall Halite Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1775 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100 m to 150 m (Wilson and Evans, 1990)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the gradational upward transition from the halite of the Preesall Halite Member to the predominantly greenish grey laminated mudstone at the base of the overlying undifferentiated Kirkham Mudstone Member (formerly referred to the now Obsolete Coat Walls Mudstone Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasYoungestAgeValue 2.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Preesall Halite Formation"@en ,
        "Preesall Salt [Obsolete: use PRSA]"@en ;
    skos:broader namedrockunit:SIM ;
    skos:definition "Halite with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age - to - Ladinian Age (Triassic Period) (246.7-237 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PRSA"@en ;
    skos:prefLabel "Preesall Halite Member"@en ;
