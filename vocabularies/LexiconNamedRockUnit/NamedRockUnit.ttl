        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thick, massive and pillowed, porphyritic and aphric basalt lavas, partly brecciated. Rare beds of lithic arenite, siltstone, mudstone and polymict basalt lava breccia."@en ;
    lexicon:hasLowerBoundaryDefinition "Succeeds and locally interdigitates with Kilranny Hill Formation (KRY). Distinguished by incoming lava facies."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H451 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
