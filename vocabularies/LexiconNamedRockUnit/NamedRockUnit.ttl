namedrockunit:WTB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silt and sand containing pollen, plant macrofossils, coleopteran, molluscan, ostracod and mammalian evidence of deposition under temperate conditions. The fauna and flora suggest deposition in a warm temperate climate in an environment ranging from estuarine through salt marsh to fluviatile or possibly ponded.The silt and sand interdigitate with gravel. To the west of the type site, the Woodston Member is overlain by gravels mapped as the third terrace of the River Nene."@en ;
    lexicon:hasLowerBoundaryDefinition "Probably unconformable on the Lowestoft Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3772 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 3 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The deposit occurs beneath the Third Terrace of the River Nene from Orton Waterville eastwards for about 3 km."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Woodston Beds [Obsolete: use WTB]"@en ;
    skos:broader namedrockunit:NENE ;
    skos:definition "Sand and silt with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WTB"@en ;
    skos:prefLabel "Woodston Member"@en ;
.

