    skos:notation "TBK"@en ;
    skos:prefLabel "Kinloch Formation"@en ;
.

namedrockunit:TBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, blue-grey, thick-bedded, planar to wavy-bedded, stylolitic, in part fissile with intercalated thin mudstone beds. Fossiliferous, particularly with abundant corals, brachiopods and crinoid debris. It commonly has a Saccamminopsis band 1.5 to 2m from the top. A bed near the top is characteristically argillaceous and \"slaggy\" (Johnson and Dunham, 1963)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp base of limestone overlying measures within the Alston Formation, in places comprising sandstone, elsewhere mudstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2476 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "7.6 to 14.6m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of overlying measures within the Alstone Formation, here usually comprising up to about 10m of compact, hard, dark grey mudstone colloquially referred to as the Tyne Bottom Plate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tyne Bottom Limestone [Obsolete: use TBL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TBL"@en ;
    skos:prefLabel "Tynebottom Limestone Member"@en ;
.

namedrockunit:TBLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly olivine-microphyric basalts (Dalmeny type) interbedded with mugearites. Distal facies characteristics such as lava toes and thin reddened lavas with interbedded boles are well developed near Edinbarnet [NS 503 745]. The highest flow seen in the Douglas Muir area [NS 525 751] is an olivine-clinopyroxene-plagioclase-macrophyric basalt (Dunsapie type) with an unusual 'cumulate' texture."@en ;
    lexicon:hasLowerBoundaryDefinition "The Tambowie Lava Member is underlain by the predominantly plagioclase-macrophyric basalts (Markle type) of the Mugdock Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4917 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Tambowie Lava Member is the youngest unit in the Clyde Plateau Volcanic Formation of the Kilpatrick Hills. It is overlain by the sedimentary rocks of the Lawmuir and Kirkwood formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tambowie Lavas [Obsolete: use TBLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Mugearite and olivine-microphyric basalt with subsidiary olivine-clinopyroxene-plagioclase-macrophyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TBLA"@en ;
    skos:prefLabel "Tambowie Lava Member"@en ;
.

