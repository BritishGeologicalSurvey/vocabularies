namedrockunit:SHCM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly upward-coarsening sandstones above a scoured base. Naticopsis, Myalina and, very rarely, fragments of Thamnopora are found in thin shelly mounds above the scoured surfaces. These sequences give way to grey lenticular-bedded mudstones with sporadic Chondrites and, in the highest beds, Diplocraterion. Cross-bedded sandstones follow to complete the uplands-coarsening sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp transgressive base on rocks of the Rawns Member (q.v.)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1178 ,
        namedrockunit:H520 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "90 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the basal 1m-thick bed at the base of the Little Hangman Member (q.v.), which contains Mylina (mostly in life position) and bryozoans."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Sherrycombe Beds [Obsolete: use SHCM]"@en ,
        "Sherrycombe Formation [Obsolete: use SHCM]"@en ;
    skos:broader namedrockunit:HASA ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHCM"@en ;
    skos:prefLabel "Sherrycombe Member"@en ;
