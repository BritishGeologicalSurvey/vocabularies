namedrockunit:WS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A red-bed succession. The lower part, the Bransty Cliff Sandstone Member (the Whitehaven Sandstone of Akhurst et al., 1997), comprises red to deep purple or purplish brown, cross-bedded, micaceous, medium- to coarse-grained sandstone. There are interbeds of pink to red or grey mudstone and siltstone and thin palaeosols are present locally. These beds are overlain by a thick heterogenous, dominantly red succession (the Millyeat Member) of mudstone, sandstone and marl with thin coals and limestones with Spirorbis sp. \r
\r
The lower part of the formation was deposited from a major braided river system that flowed from the north-east. The upper part of the formation represents deposition in interdistributary bay or lacustrine environments with minor river channels (Akhurst et al., 1997). The reddening was either primary or early diagenetic. \r
\r
Late Bolsovian to early Asturian (Westphalian D)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is taken where the non-reddened, cyclical, mudstone-dominated succession with thin coals of the underlying Pennine Coal Measures Group are succeeded unconformably by red sandstones. The unconformity cuts down to the Aegiranum Marine Band (AGMB) or, locally older strata (Akhurst et al., 1997)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3770 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is at least 280 m thick. The Bransty Cliff Sandstone Member is at least 100 m thick. The Millyeat Member is 180 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the formation is the base of the sub-Permian unconformity, which is overlain by the coarse, poorly bedded, poorly to moderately sorted, generally massive, matrix or clast-supported, typically pebble-grade, breccias of the Permian Brockram (Appleby Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whitehaven Sandstone Series [Obsolete: use WS]"@en ;
    skos:broader namedrockunit:WAWK ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace calcareous mudstone, coal and limestone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage - to - Asturian Substage (Carboniferous Period) (314.75-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BYCS ,
        namedrockunit:MYTB ;
    skos:notation "WS"@en ;
    skos:prefLabel "Whitehaven Sandstone Formation"@en ;
.

namedrockunit:WSE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
