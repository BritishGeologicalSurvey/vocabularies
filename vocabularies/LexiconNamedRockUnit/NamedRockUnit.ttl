namedrockunit:BLSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Slate, black, graphitic, with pyrite and locally abundant chert laminae, and subordinate grey and pale green arenite near top. Lenses of spilite and amphibolite occur locally. Locally fossiliferous with a brachiopod faunal assemblage."@en ;
    lexicon:hasLowerBoundaryDefinition "Incoming of dominant black slate and chert and the outgoing of pale arenites at top of Loch Ard Grit Formation. Probable faulted contact with Dalradian."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4473 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasOldestAgeValue 4.869e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "600m maximum"@en ;
    lexicon:hasUpperBoundaryDefinition "Appearance of carbonated serpentinite and jasper-rich rock of the Lime Hill Serpentinite; contact probably faulted."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Black Slate and Chert [Obsolete: use BLSL]"@en ;
    skos:broader namedrockunit:HBX ;
    skos:definition "Slate with subsidiary amphibolite and chert and trace pelite and psammite. Stratified bedrock. Occurs onshore. Deposited during the Ordovician Period (486.9-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BLSL"@en ;
    skos:prefLabel "Bofrishlie Slate Formation"@en ;
.

