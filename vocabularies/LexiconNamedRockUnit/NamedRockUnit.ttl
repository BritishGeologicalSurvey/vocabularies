namedrockunit:CBAY
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Upper and lower tabular unstratified (till) members, laterally grading to sands and gravels, separated by an intervening lenticular and tabular infill member. The Lower Till Member comprises stiff clay, abundant pebbles, slightly pebbly sand with shell clasts, together suggestive of a sub-glacial lodgement till, and elsewhere includes sands interpreted as ice-proximal glaciomarine deposits. The lenticular component comprises sands with subordinate muds, whereas the associated overlying tabular beds consist of fine-grained silty sands and sandy clays. The Upper Till Member comprises a stiff to hard diamicton of clay with varying content of sand, gravel, shell, cobbles and boulders."@en ;
    lexicon:hasLowerBoundaryDefinition "An erosion surface with a gentle topographic variation of about 15 m on the underlying St George's Channel Formation. Locally on pre-Quaternary erosion surface."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS006> ;
    lexicon:hasOldestAgeValue 1.86e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "28 to 158 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity at base of overlying Upper Western Irish Sea Formation. Locally crops out at sea bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        namedrockunit:BRYG ,
        namedrockunit:ISCG ;
    skos:definition "Diamicton with subsidiary clay, gravel and sand. Stratified superficial deposits. Occurs offshore. Formed during the Marine Isotope Stage 6 - to - Marine Isotope Stage 2 (Quaternary Period) (.186-.0139 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBAY"@en ;
    skos:prefLabel "Cardigan Bay Formation"@en ;
.

namedrockunit:CBDL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically comprises hyaloclastite, basalt and tuff, the latter locally with some limestone grains.  At Cressbrook Dale the member is dominated by amygdaloidal basalt.  At the type locality the lower part comprises brecciated lavas, with oxidised angular fragments of vesicular or non- vesicular basalt and a matrix of silica and chlorite, interdigitated with non-brecciated basalt lavas.  At this locality, the top of the member is a 0.75m thick pale green, pyritic tuff"@en ;
    lexicon:hasLowerBoundaryDefinition "At the type locality, the basalt at the base of the member is underlain by dark grey cherty limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4519 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum thickness of 80.88m proved in the Longstone Edge Borehole, SK27SW/5 [SK 2088 7335)."@en ;
    lexicon:hasUpperBoundaryDefinition "At the type locality, the pale green tuff at the top of the member is overlain by dark grey biomicrosparite limestones of the Monsal Dale Limestone Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cressbrook Dale Lava [Obsolete: use CBDL]"@en ;
    skos:broader namedrockunit:MO ;
    skos:definition "Basalt and tuff. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBDL"@en ;
    skos:prefLabel "Cressbrook Dale Lava Member"@en ;
.

