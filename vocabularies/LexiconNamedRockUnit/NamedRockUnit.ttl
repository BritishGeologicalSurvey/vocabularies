namedrockunit:RNB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Runcton Member comprises 'bright green, glauconitic, clayey sands with much nodular phosphorite' and, at North Runcton, the 'friable brown phosphatic nodules contain Subcraspedites (V.) lamplughi' (Casey, 1973). A horizon of black phosphatic nodules occurs at the base. At West Dereham, the Runcton Member is reduced to a single band of rolled phosphatic nodules 0.15-0.30 m thick. The member can be traced offshore into The Wash, where it passes into the lower part of the Spilsby Sandstone Formation (lower Spilsby Sandstone) (Wingfield et al., 1978)."@en ;
    lexicon:hasLowerBoundaryDefinition "Green, glauconitic, clayey sand with a basal black phosphatic nodule horizon (Runcton Member), rests with a sharp disconformable contact, on grey and yellow-green silty sands with pyrite (Roxham Member)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2396 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "'Glauconitic clayey sands with bands of brown-weathering clay ironstone and (especially near the base) seams of phosphorite' (Mintlyn Member) rests with a sharp disconformable contact on 'bright green, glauconitic, clayey sands with much nodular phosphorite' (Runcton Member) (Casey, 1973)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Runcton Beds [Obsolete: use RNB]"@en ;
    skos:broader namedrockunit:SAS ;
    skos:definition "Sand. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Berriasian Age (Cretaceous Period) (143.1-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RNB"@en ;
    skos:prefLabel "Runcton Member"@en ;
.

