namedrockunit:TCA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse to very-coarse, pebbly red sandstone, thick-bedded (0.5 - 5 m); locally medium grained. Thin subsidiary pebble conglomerates and grey siltstones. Planar and cross-bedding are common. Soft-sediment deformation is common but not ubiquitous."@en ;
    lexicon:hasLowerBoundaryDefinition "Upon Diabaig Formation (TCD) or Kinloch Formation (Sleat Group - TB) via minor unconformity: elsewhere with angular unconformity upon Stoer Group (TA) or Lewisian Gneiss (L)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:TCAI ,
        namedrockunit:TCAL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 2500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Aultbea Formation (TCAU), with gradational boundary, with incoming of consistent fine-medium grained sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Leac-Strearnan Member [Obsolete: use TCA, TCAM]"@en ,
        "Sithean Glac An Ime Member [Obsolete: use TCA]"@en ;
    skos:broader namedrockunit:TC ;
    skos:definition "Pebbly (gravelly) sandstone and sandstone with subsidiary conglomerate and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
