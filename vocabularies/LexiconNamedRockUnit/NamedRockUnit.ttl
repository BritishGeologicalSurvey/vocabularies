namedrockunit:BHIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Beacon Hill Sand and Gravel Member consists of shelly, cross-bedded and rippled sands with flint-rich gravel seams and sporadic intraformational ice wedge casts and drop-soil structures (periglacial involutions). The lower horizons of the deposits are intensely glaciotectonized."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of Beacon Hill Sand and Gravel is erosional throughout much of the deposit's distribution area and it generally rests upon the Bacton Green Till Member of the Sheringham Cliffs Formation. In places, especially in the vicinity of Trimingham and Gimingham, the lower boundary is tectonic and wedges of Bacton Green Till have been thrust upwards into the deposit."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To approximately 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Where the Beacon Hill Sand and Gravel has been observed, it forms the highest stratigraphical unit within the succession intersecting the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BRLA ;
    skos:definition "Sand with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHIL"@en ;
    skos:prefLabel "Beacon Hill Sand And Gravel Member"@en ;
.

