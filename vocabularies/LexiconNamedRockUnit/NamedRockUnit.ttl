namedrockunit:CHGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Packstones and floatstones, bioclastic, mainly medium- to coarse-grained, dark grey, thin-to-medium-bedded, commonly graded and laminated. May show soft sediment deformation structures such as slump folds and convolute ripples. Many beds display erosive, tool-marked and fluted basal surfaces and some beds contain coarse-grained lags and mudstone lithoclasts. The interbedded mudstones are dark grey, fissile, pyritic and locally sideritic and mainly barren of macrofauna. Dark sandy ferruginous siltstones with plant debris also occur."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the first coarse-grained packstone that lies above a succession of thin-bedded, laminated, calcisiltites and mudstones of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 180m"@en ;
    lexicon:hasUpperBoundaryDefinition "Packstones and floatstones of the Chaigley Limestone Member are overlain by slumped, blocky, calcareous mudstones of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HOM ;
    skos:definition "Limestone with subsidiary mudstone and trace siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DUA ;
    skos:notation "CHGL"@en ;
    skos:prefLabel "Chaigley Limestone Member"@en ;
.

