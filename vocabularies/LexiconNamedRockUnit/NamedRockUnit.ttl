namedrockunit:LEAM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A dark grey, blocky, pyritic and calcareous mudstone, interbedded with thin, dark wackestones with diffuse bed boundaries."@en ;
    lexicon:hasLowerBoundaryDefinition "The dark grey blocky mudstone of the Leagram Mudstone Member lies conformably upon limestones of the Limekiln Wood Limestone Member in the Clitheroe Anticline or upon the Whitemore Limestone Member of the Whitewell Anticline."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4155 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
