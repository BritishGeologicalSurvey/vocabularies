namedrockunit:CCOE
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium and medium-pale grey limestones ranging from organic boundstones to packstones and wackestones with a variable grainsize depending on the bioclastic components."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary has not been proved, but it is likely to comprise reef limestones of the Cracoe Limestone Formation resting upon the bedded, medium to medium-dark grey limestone of the Scaleber Quarry Limestone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3909 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Total thickness not proved, but in excess of 100m at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is a marked unconformity, with the reef limestones of the Cracoe Limestone Formation overlain by dark grey mudstones of the Bowland Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Marginal Reef Limestones [Obsolete: use CCOE]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Brigantian Substage (Carboniferous Period) (343-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CCOE"@en ;
    skos:prefLabel "Cracoe Limestone Formation"@en ;
.

