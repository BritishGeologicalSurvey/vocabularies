        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly andesitic and basaltic lavas, commonly amygdaloidal, including olivine basalts, pyroxene andesites and feldsparphyric lavas with subordinate volcanic breccias, tuffs and minor sandstone interbeds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the volcanic rocks seen in the Duneaton Water above the sandstones of the Swanshaw Sandstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
