namedrockunit:BSSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold-phase sands and gravels that underlie the Beeston Terrace. Orange-brown sandy gravel, cryoturbated and decalcified in upper part at least, and dominated by rounded pebbles of \"Bunter\" quartz/quartzite (typically c.80%) with subordinate subangular flint (c.10%), plus minor Triassic and Upper Carboniferous sandstone, Lower Carboniferous chert and silicified limestone; probably contains a moderate proportion of Lower Carboniferous limestone where fresh at depth. Forms a fairly well preserved terrace in the type area, standing c.7m above the Trent alluvium in the type area. Merges into the correlative Allenton Sand and Gravel Member (Derwent Valley Formation), which includes the organic Crown Inn Beds (Ipswichian). Also correlated with the Wanlip Sand and Gravel Member (Soar Valley Formation) and the Fulbeck and ?Scarle Sand and Gravel members (Trent Valley Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pe-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1400 ,
        namedrockunit:H2562 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-c.5m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Beeston Sand and Gravel [Obsolete: use BSSG]"@en ,
        "Beeston Terrace [Obsolete: use BSSG, ALSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BSSG"@en ;
    skos:prefLabel "Beeston Sand and Gravel Member"@en ;
.

