namedrockunit:JKES
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Jukes Formation typically consists of moderately hard, white, occasionally greyish white, variably argillaceous, chalky limestones. Occasional harder limestone bands occur together with comparatively few nodular chert developments."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Jukes Formation is defined by a downward change from moderately hard, relatively chert-free chalks, to darker, consistently harder, argillaceous, cherty chalks of the Lamplugh Formation. This lithological change corresponds to a consistent increase in sonic velocity, sometimes accompanied by a slight downward increase in gamma values."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasOldestAgeValue 8.57e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Jukes Formation ranges up to 500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Jukes Formation is characterized by a downward change from relatively soft chert-bearing argillaceous chalks to harder white chalks with fewer cherts. There is a corresponding slight downward decrease in gamma values and a more marked increase in sonic velocity. There is considerable variability in the sonic response over the formation as a whole as a result of the cyclic interbedding of thin argillaceous units, hard chalks and occasional hard chert-rich bands. The top of the unit is often marked by a thin, hard chalk unit (e.g. well 49/5-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CK ;
    skos:definition "Limestone and trace chert. Stratified bedrock. Occurs offshore. Deposited during the Santonian Age - to - Campanian Age (Cretaceous Period) (85.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "JKES"@en ;
    skos:prefLabel "Jukes Formation"@en ;
.

namedrockunit:JMB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, red to maroon fine-grained, feldspathic and glauconitic, in gently-tapering beds with bimodal tabular-planar and trough cross-bedding. Interbedded with red and green colour-variegated siltstone and mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational into Tuttle Hill Member. Base taken at lowest bed to show variegation and increased proportions of variegated silty and muddy partings."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasOldestAgeValue 5.26e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, erosive contact with grey basal conglomerate or maroon calcareous sandstone of Home Farm Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CQ ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
