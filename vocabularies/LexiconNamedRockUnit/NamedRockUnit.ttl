    lexicon:hasThicknessDescription "233 metres approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of sandstone of the Craighill Sandstone Group to sandstone with thicker limestone units of the Birdoswald Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:FELL ;
