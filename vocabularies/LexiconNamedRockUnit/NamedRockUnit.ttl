namedrockunit:CLAU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent
        namedrockunit:NOT ,
        namedrockunit:S251 ,
        namedrockunit:S252 ,
        namedrockunit:S502 ,
        namedrockunit:S757 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typical delta slope facies. Predominantly sandy grey micaceous shaly siltstones with irregular interbeds of fine- to medium-grained micaceous plant-rich sandstone, very variable thickness and bedding commonly syndepositionally slumped. NOTE: Moseley named the delta slope sequence between the entirely marine Caton Shales and the delta top Crossdale Grit (now Silver Hills Sandstone), the Claughton Flags. Thus it is proposed to rename the unit Claughton Member since it is predominantly siltstone and is analogous to the Roeburndale Member below the Caton Shale Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp junction between fossiliferous fissile clayey blue-grey mudstones with limestone nodules and thin sideritic lenses of Caton Shale Member below and siltstones with sandstones of the Claughton Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3304 ,
        namedrockunit:H4545 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.200-300m in the Claughton area, but upper part not represented."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen; believed to be sharp, at erosional base of delta-top coarse-grained sandstone of the Silver Hills Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
