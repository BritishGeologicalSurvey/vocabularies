namedrockunit:TORR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the fluvial, lacustrine and organic deposits of the River Torridge and its tributaries. It includes floodplain alluvium and the deposits of eight river terraces. The floodplain alluvium comprises soft poorly sorted clays, silts and fine-grained sands, with bodies of peat, overlying sands and subrounded gravels. The terrace deposits dominantly comprise silty and sandy pebbly clays but include sands and gravels and silts. The clays are largely derived from Upper Carboniferous mudstone bedrock. Gravels are dominantly formed of rounded pebbles up to 50mm in diameter of Upper Carboniferous sandstone but also include vein quartz and Lower Carboniferous limestone and chert. Boulders of Dartmoor Granite and quartz-feldspar-tourmaline rock are common in the upper reaches of the River Okement and its tributaries. The terraces contain alluvial tin ore (cassiterite)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable upon bedrock of Early and Late Carboniferous and Permian age and upon the Dartmoor Granite."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CCAT ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:TOR1 ,
        namedrockunit:TOR2 ,
        namedrockunit:TOR3 ,
        namedrockunit:TOR4 ,
        namedrockunit:TOR5 ,
        namedrockunit:TOR6 ,
        namedrockunit:TOR7 ,
        namedrockunit:TOR8 ,
        namedrockunit:TOR9 ;
    skos:notation "TORR"@en ;
    skos:prefLabel "Torridge Valley Formation"@en ;
.

namedrockunit:TRWCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Trent-Witham Catchments Subgroup comprises a suite of fluvial, lacustrine, mass movement (head), periglacial and organic (peat) deposits. The subgroup includes the alluvium and river terrace deposits of the Trent and Witham valleys and pre-diversionary valleys (Trent Valley Formation), the Soar valley (Soar Valley Formation) and the Bain valley (Bain Valley Formation) and their respective tributaries, including the Derwent (Derbyshire), Dove and Devon. The fluvial deposits contain clasts derived from rocks cropping out in the Midlands of England (mainly Triassic \"Bunter\" sandstone, ironstone and chert, Carboniferous sandstone, Lias siltstone, limestone and ironstone)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with units of the Albion Glacigenic Group and bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3733 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Generally less than 5m. Individual terrace deposits up to 9m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but units of this group interfinger locally with units of the Great Britain Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Trent Catchments Subgroup [Obsolete: use TRWCA]"@en ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel and sand with subsidiary clay, diamicton, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BAINV ,
        namedrockunit:BLHD ,
        namedrockunit:HYHD ,
        namedrockunit:LRHD ,
        namedrockunit:PHHD ,
        namedrockunit:SDHD ,
        namedrockunit:SOARV ,
        namedrockunit:TRVA ;
    skos:notation "TRWCA"@en ;
    skos:prefLabel "Trent-Witham Catchments Subgroup"@en ;
.

namedrockunit:UTMS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly sand and gravel forming river terraces and silt, silty clay and sand forming floodplains and concealing sand and gravel. Including units of silty sand, silt, clay and peat. Terrace deposits of the upper Thames contain clasts mainly of limestone lithologies. The formation includes interbedded units of locally fossiliferous silty sand, silt together with organic clay, tufa and peat, which are biostratigraphically correlated with interglacial (warm) stages. The main terrace deposit members are the Freeland Sand and Gravel, Spelsbury Gravel, Hanborough Gravel, Daylesford Sand and Gravel, Wolvercote Sand and Gravel, Summertown-Radley Sand and Gravel, Northmoor Sand and Gravel and Alluvium. In the Thame and Windrush valleys terrace deposit member include the Tiddington Sand and Gravel, Chilworth Sand and Gravel, Blackditch Sand and Gravel, Shabbington Sand and Gravel, Sherbourne Sand and Gravel, Ickford Sand and Gravel, Rissington Sand and Gravel and Quarrendon Sand and Gravel."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on glacigenic deposits of the Anglian stage or older Pleistocene strata or bedrock. Individual terrace deposit members rest unconformably on older Pleistocene strata or bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Single terrace aggradations range from 3 to 12m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:THCAT ;
    skos:definition "Gravel and sand with subsidiary clay, peat, silt and silty sand and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DAY ,
        namedrockunit:FL ,
        namedrockunit:HAN ,
        namedrockunit:NO ,
        namedrockunit:RIN ,
        namedrockunit:SHE ,
        namedrockunit:SPBY ,
        namedrockunit:SURA ,
        namedrockunit:WV ;
    skos:notation "UTMS"@en ;
    skos:prefLabel "Upper Thames Valley Formation"@en ;
.

namedrockunit:WAT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:BWAT ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold phase sands and gravels that underlie the Avon  Second Terrace of Tomlinson (1925) and of BGS Maps. Dominated by clasts of \"Bunter\" quartz/quartzite lithologies with subordinate flint. Locally includes the organic Fladbury Bed, which is \"Mid Devensian\" although the precise age is controversial. Probably correlates with Holt Heath Member of the Severn Valley Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Wolston Formation or Baginton Formation in upper Avon or farther downstream (beyond Coventry) on Lower Jurassic or Triassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1264 ,
        namedrockunit:H1905 ,
        namedrockunit:H3118 ,
        namedrockunit:H3752 ,
        namedrockunit:H4908 ,
        namedrockunit:S350 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
