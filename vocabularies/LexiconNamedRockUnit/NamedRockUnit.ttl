namedrockunit:TDSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to black, thinly banded to laminated, semipelites and subsidiary pelites. Micaceous psammites noted. Thin limestone interbeds. Beds slaty to schistose. To south schistose semipelites. Prominent crystalline limestone member. Graphitic pelite generally present at base."@en ;
    lexicon:hasLowerBoundaryDefinition "At top of calcareous semipelite of Cock Burn Calcareous Schist Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "100-150m. Possibly up to 200m west of Tornahaish."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper limit of pelites, thin limestones and/or calcareous beds below semipelite and micaceous psammite of the Nochty Semipelite and Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DABA ;
    skos:definition "Semipelite with subsidiary limestone, pelite and psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ALGS ,
        namedrockunit:CORG ;
    skos:notation "TDSL"@en ;
    skos:prefLabel "Tornahaish Dark Schist And Limestone Formation"@en ;
.

namedrockunit:TECY
    a skos:Concept ;
