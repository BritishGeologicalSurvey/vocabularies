    lexicon:hasThicknessDescription "Up to 40 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but commonly overlain unconformably by deposits of gravel, sand, silt, clay and peat of the Solway or Cumbria-Lancashire Catchments subgroups."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
