namedrockunit:KHLCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand, pale yellow brown, slightly gravelly, fine and medium, quartzose. Sparse, rounded, quartzite and psammite metasedimentary pebbles. The deposit displays a thin and medium horizontal bedding and some planar cross bedding indicating palaeoflow to the west and southwest. Brown silt laminae are sporadically present. Heavy mineral suite similar to that of the Corse Diamicton Member. Interpreted as glaciofluvial outwash."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal boundary of the deposit is unconformable, sharp, channelled surface cut into underlying dark grey to black diamicton of the Corse Diamicton Member (Whitehills Glacigenic Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GFSG ,
        namedrockunit:H994 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 1.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the formation is generally the present ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glaciofluvial sand and gravel"@en ,
        "Kirkhill Church Sand Formation [Obsolete: use KHLCH]"@en ;
    skos:broader namedrockunit:BLSG ;
    skos:definition "Sand and trace gravel and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KHLCH"@en ;
    skos:prefLabel "Kirkhill Church Sand Member"@en ;
.

