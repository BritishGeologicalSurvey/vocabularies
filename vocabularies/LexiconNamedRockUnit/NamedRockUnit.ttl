namedrockunit:LCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent
        namedrockunit:GYCK ,
        namedrockunit:LMCK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A grey marly chalk with marl content decreasing upwards. No flint. Comprises a thin basal bed of glauconitic marl (Cambridge Greensand) overlain by more typical Lower Chalk sequence that is usually divided into a lower "Chalk Marl" with rhythmic alternations of chalk and marl, and an upper "Grey Chalk" separated by a distinctive hard band. (Totternhoe Stone). \r
\r
Name remains in informal use but generally regarded as obsolete onshore."""@en ;
    lexicon:hasLowerBoundaryDefinition "In Hitchin area, unconformity. Base of Cambridge Greensand resting on Gault Clay."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2893 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "45-80 m in Hitchin area."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp contact with overlying Middle Chalk the base of which is marked by Melbourn Rock, a hard nodular chalk. Top of Lower Chalk marked by a thin but distinctive yellowish marl (Plenus Marl)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chalk, Lower (now Lower Chalk Formation) [Obsolete: use LCK]"@en ,
        "Grey Chalk Subgroup"@en ,
        "Lower Chalk Formation and Middle Chalk Formation (Undifferentiated)"@en ;
    skos:broader namedrockunit:CK ;
    skos:definition "Calcareous mudstone and chalk. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LCK"@en ;
    skos:prefLabel "Lower Chalk Formation"@en ;
.

