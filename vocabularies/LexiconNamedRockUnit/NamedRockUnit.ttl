    lexicon:hasLithologyDescription "Gneissose semipelite with local gradations towards micaceous psammite. Typically magnetite-rich and hence notably magnetic. Thin amphibolites occur locally throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary not exposed. Probably tectonic boundary with Grampian Group rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - c. 400m."@en ;
    lexicon:hasUpperBoundaryDefinition "Where magnetite semipelite is succeeded (rapid / sharp transition) by tremolite schist of the Iubhair Beag Calcareous Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Gneissose semipelite with subsidiary micaceous psammite and trace amphibolite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SRGA"@en ;
    skos:prefLabel "Sron Garbh Semipelite Formation"@en ;
