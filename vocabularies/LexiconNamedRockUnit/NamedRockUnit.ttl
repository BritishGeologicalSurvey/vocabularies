    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 50m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Overstrand Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QB> ;
    lexicon:hasYoungestAgeValue 8.6e-01 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SMCL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "North Sea Drift Formation (part of) [Obsolete: use BERE]"@en ,
        "Sheringham Cliffs Formation"@en ;
    skos:definition "Obsolete name. Diamictite with subsidiary clay and sand. Stratified superficial deposits. Occurs onshore. Formed during the Beestonian Stage (Quaternary Period) (1.78-.86 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BERE"@en ;
    skos:prefLabel "Beeston Regis Formation [Obsolete: use SMCL]"@en ;
.

namedrockunit:BES
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
