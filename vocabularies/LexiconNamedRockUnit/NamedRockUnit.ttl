    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 66m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the incoming of low angle cross bedded lilac coloured conglomerates, conglomeratic quartzites and coarse-grained quartzites of the Mynydd Myddfai Formation above the thick bedded greenish grey and purple fine-grained sandstones of the Cwar Glas Member of the Hafod Fawr Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasYoungestAgeValue 4.227e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carn Powell Facies (of Black Cock Beds) [Obsolete: use CWGL]"@en ,
        "Carn Powell Facies [Obsolete: use CWGL]"@en ,
        "Grammysia Bed [Obsolete: use CWGL]"@en ,
        "Grammysia Beds [Obsolete: use CWGL, GYB]"@en ;
    skos:broader namedrockunit:HAFOD ;
    skos:definition "Mudstone and sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ludlow Epoch (Silurian Period) (426.7-422.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
