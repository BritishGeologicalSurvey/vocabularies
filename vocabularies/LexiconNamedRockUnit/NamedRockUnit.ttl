    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale-medium blue, silty-mudstone, intensely bioturbated in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "No lower boundary is exposed but the pale-medium blue mudstones of the Formation rest with sharp contrast upon the black mudstones of the Nod Glas Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1393 ,
        namedrockunit:H2025 ,
        namedrockunit:H3245 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
    lexicon:hasOldestAgeValue 4.4875e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "400 to 560m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary can be examined at Aberllefenni Quarry, where the contact is transitional, over 0.5m, from the pale-blue of the Broad Vein Mudstone Formation to a medium-blue, laminated silty mudstone of the Narrow Vein Mudstone Formation, accompanied by the development of lamination."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
    lexicon:hasYoungestAgeValue 4.452e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Broad Vein Formation [Obsolete: use BRV]"@en ,
        "Broad Vein [Obsolete: use BRV]"@en ,
        "Red Vein [Obsolete: use BRV]"@en ;
    skos:broader namedrockunit:ARO ;
    skos:definition "Silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Rawtheyan Stage (Ordovician Period) (448.75-445.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRV"@en ;
    skos:prefLabel "Broad Vein Mudstone Formation"@en ;
.

namedrockunit:BSBD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SNDG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Base Bed Member comprises glauconitic, very fine-grained sand and silt, some clayey, with scattered flint gravel, and with a layer (about 1 m thick) of glauconite-coated, pitted and fractured angular flint gravel and cobbles at the base. Dispersed volcanic ash occurs in this unit. The basal gravel corresponds to the Bullhead Bed (BLHB). \r
\r
The Base Bed Member is early Thanetian in age, and is inferred to represent Zone NP6 by inference from magnetostratigraphy (Ali and Jolley, 1996; Knox et al., 1994) and dinoflagellate cyst occurrence (Jolley, 1992; Powell et al., 1996)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Base Bed Member (the base of the Thanet Formation) is the base of the basal sandy, clayey flint gravel bed, which rests on the Chalk Group, often on an irregular, karstic surface modified by dissolution in groundwater."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5081 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasOldestAgeValue 5.92e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "The top of the unit is placed at the change from very fine-grained sands and silts of the Base Bed Member to the silts and silty clays of the overlying Stourmouth Silt Member (STMH)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Thanet Base-Bed [Obsolete: use BSBD]"@en ;
    skos:broader namedrockunit:TAB ;
    skos:definition "Glauconitic sand and silt with subsidiary gravel. Stratified bedrock. Occurs onshore. Deposited during the Thanetian Age (Palaeogene Period) (59.2-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BLHB ,
        namedrockunit:CEGB ;
    skos:notation "BSBD"@en ;
    skos:prefLabel "Base Bed Member"@en ;
.

namedrockunit:BT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the Guildford district the Member comprises buff to brown, gritty to ferruginous, cemented, cross-bedded, coarse-grained sandstone with beds of pale grey calcareous sandstone. Locally a pebble bed occurs at the base, with clasts of Hythe Formation, glauconite pebbles, quartz granules, brown phosphatic pebbles and pebbles of Jurassic limestone. Locally, e.g. Milford Bypass [SU 9435 4413] the member is weakly calcareous and chert beds occur, including one at the base. Hard, calcareous sandstone doggers (Bargate Stone) have also been recorded near the top of the unit around Dorking. In the northeastern part of the Alresford district it consists of friable, calcareous, glauconitic, fine- to medium-grained sandstones and cemented flagstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at a burrowed erosion surface where pebbly sand rests on pale grey, well-sorted, fine- to medium-grained, weakly cemented sandstone of the Hythe Formation (Ellison et al., 2002). Locally, in the Alresford district, the member interdigitates with pebbly, glauconite- and limonite-rich clayey sand of the Rogate Member (Sandgate Formation) (Farrant, 2002)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1401 ,
        namedrockunit:H2646 ,
        namedrockunit:H3878 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 35m in the Alresford district and to 20m in the Guildford district."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Alresford district the upper boundary is characterised by an upsection change from brown, friable, calcareous, glauconitic sandstone, pebbly in part [Farrant, 2002] to grey, friable, well-sorted, fine-grained, glauconitic, weakly cross-bedded sandstone of the Pulborough Sandrock Member. In the Guildford district the brown, gritty, ferruginous, cemented, cross-bedded sandstone with beds of pale grey, calcareous sandstone (Ellison et al., 2002)are overlain by the argillaceous silts and fine- to medium-grained sandstones of the Sandgate Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bargate Beds [Obsolete: use BT]"@en ,
        "Bargate Formation [Obsolete: use BT]"@en ,
        "Bargate Member [Obsolete: use BT]"@en ;
    skos:broader namedrockunit:SAB ;
    skos:definition "Sandstone and trace calcareous sandstone, chert and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BT"@en ;
    skos:prefLabel "Bargate Sandstone Member"@en ;
.

namedrockunit:BTF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale to medium grey calcareous siltstone with thin lenticular or concretionary sandy and silty limestones and a few thin medium to dark grey mudstone beds; pale to medium grey, fine-grained, silty massive and bioturbated calcareous sandstones developed in lower part."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of sediments as described above resting erosively on mudstone of Oxford Clay or (locally) mudstone, siltstone or sandstone of Kellaways Formation; small phosphatic pebbles at base in some sections."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2647 ,
        namedrockunit:H3249 ,
        namedrockunit:H4426 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c.18m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of silty mudstones and mudstones of overlying beds of West Walton Formation undifferentiated."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ampthill Clay [Obsolete: use AMC]"@en ,
        "Brantingham Formation [Obsolete: use BTF]"@en ,
        "Corallian Limestone [Obsolete: use BTF]"@en ;
    skos:broader namedrockunit:WWB ;
    skos:definition "Calcareous mudstone, sandstone and siltstone with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BTF"@en ;
    skos:prefLabel "Brantingham Member"@en ;
