    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.750m in the type area of Barland Common, Bishopston."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at the top of the highest dark grey mudstone, where it is overlain disconformably by pale grey quartzitic sandstones of the Telpyn Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
