    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Woodhouselee Volcanic Member"@en ;
    skos:definition "Obsolete name. Andesite and trachytic-rock. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
