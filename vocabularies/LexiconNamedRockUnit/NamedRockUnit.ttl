    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.6 metres. Generally <10 metres but occurs locally up to 20 metres in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of unit unconformably overlain by younger sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
