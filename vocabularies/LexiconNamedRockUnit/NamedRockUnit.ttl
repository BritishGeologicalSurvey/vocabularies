    lexicon:hasThicknessDescription "At least 310 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from feldspathic grit of the Penrhiw Group to green grit with trachyte fragments of the Treginnis Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AP> ;
