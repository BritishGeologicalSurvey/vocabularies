namedrockunit:HLR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to coarse or pebbly, commonly feldspathic, cross laminated and channel bedded sandstone. The base often channels into the beds below. The sandstone is locally interbedded with thin mudstones. The Hollin Rock Member represeents a widespread deltic sandstone body, or series of bodies, within the Flintshire Coalfield, and may record a period of distributary channel and mouth bar advances at a time of lowered sea level."@en ;
    lexicon:hasLowerBoundaryDefinition "The type section displays a sharp base of grey sandstone overlying dark mudstones with ironstones, about 4.44m above top of Massy (Drowsell) Coal (J500 of British Coal). Elsewhere the base channels down in places to below the Hollin Coal (H800 of British Coal)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Up to 75 thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The type section shows a sharp contact between hard, white sandstone and overlying seat earth (fireclay), about 3 m below base of the Etruria Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasYoungestAgeValue 3.1e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PMCM ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage (Carboniferous Period) (314.75-310 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HLR"@en ;
    skos:prefLabel "Hollin Rock"@en ;
.

