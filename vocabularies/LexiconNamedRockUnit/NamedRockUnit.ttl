namedrockunit:LEHL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Lees Hill Lava Member consists predominantly of trachybasalt but also includes a plagioclase-macrophyric basalt lava (of 'Markle' type). The trachybasalt is typically fine grained, massive, locally slaggy and highly vesicular, and with local platy jointing. A single trachybasalt lava is present in the east [NS 7184 9247], which occurs as an intercalation within the macroporphyritic basalt lavas of the Gargunnock Hills Lava Member, near to its base. In the Gargunnock Burn ([NS 7065 9249] to [NS 7059 9222]) two trachybasalt lavas are present, separated by a plagioclase-macrophyric basalt lava which is absent farther west."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal trachybasalt of the member lies possibly disconformably on plagioclase-microphyric basalt (of 'Jedburgh' type) of the Spout of Ballochleam Lava Member. In the east of its outcrop, the member is represented by a single trachybasalt lava which overlies, apparently conformably or disconformably, a plagioclase-macrophyric basalt (of 'Markle' type) of the Gargunnock Hills Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1022 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-37 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Lees Hill Lava Member is overlain, apparently conformably or disconformably, by the Gargunnock Hills Lava Member, and in the east of its outcrop, the Lees Hills Lava Member is represented by a single trachybasalt lava, which is intercalated with lavas of the Gargunnock Hills Lava Member. The lithological change is to plagioclase-macrophyric basalt lava (of 'Markle' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lees Hill Group [Obsolete: use LEHL]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Trachybasalt with subsidiary basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LEHL"@en ;
    skos:prefLabel "Lees Hill Lava Member"@en ;
.

namedrockunit:LEL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Soft, pale olive, bioturbated calcareous silty mudstones or muddy siltstones, irregularly bedded in shaly or flaggy units, with a blocky fracture (Lawson and White, 1989). \r
\r
A diverse fauna, dominated by small brachiopods representing the Glassia obovata Association, is scattered through the rocks rather than being concentrated in layers (Lawson and White, 1989)."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3520 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Approx. 30 to 45 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The contact with the overlying Middle Elton Formation (MELB) is transitional over a few centimetres."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasYoungestAgeValue 4.25e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Elton Beds [Obsolete: use LEL]"@en ;
    skos:broader namedrockunit:LLUS ;
    skos:definition "Calcareous siltstone. Stratified bedrock. Occurs onshore. Deposited during the Gorstian Age (Silurian Period) (426.7-425 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LEL"@en ;
    skos:prefLabel "Lower Elton Formation"@en ;
.

