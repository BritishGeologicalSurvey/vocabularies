namedrockunit:GWCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Green and red-brown and purple mottled clay with limestone (\"calcrete\") nodules and, locally, a grey rootlet bed (seatearth) and a thin coal at the top."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at the karstified top of the underlying Penllwyn Oolite Member, where the basal green clay of the Gilwern Clay Member drapes the irregular surface of the Penllwyn Oolite Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H299 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5m (Cwar yr Hendre) to 7.4m (Llanelly Quarry)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at the sharp, disconformable junction between the topmost clay (a seatearth at Llanelly Quarry) and the overlying sandy limestone forming the base of the Dowlais Limestone Formation. Where the Garn Caws Sandstone is present, the top is placed at the irregular scoured surface where the topmost clays of the member are erosively overlain by the Garn Caws Sandstone Formation [note that Wright (1981) included this sandstone in the Gilwern Clay, but it was subsequently given separate formation status by Barclay (1989)]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:GACA ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Garn Caws Sandstone Formation"@en ,
        "Gilwern Clay Formation [Obsolete: use GWCL]"@en ;
    skos:broader namedrockunit:LLY ;
    skos:definition "Clay with subsidiary limestone and trace coal and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GWCL"@en ;
    skos:prefLabel "Gilwern Clay Member"@en ;
.

