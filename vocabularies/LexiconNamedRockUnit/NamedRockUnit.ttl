    lexicon:hasThicknessDescription "c.25-27m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Barton Clay Formation. Boundary based a distinction of sand content from fine- to very fine-grained sandstone of the Tellina Bed (topmost Selsey Formation) to the olive grey glauconitic sandy clays of the Barton Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
