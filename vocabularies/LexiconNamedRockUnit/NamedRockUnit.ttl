        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use SAL] Redbed sequence consisting of interbedded mudstones, sandstones and subordinate thin conglomerates with a few thin beds of Spirorbis limestone; subdivision of sequence into members based on recognition of upwards-coarsening cycles."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional boundary defined in the field at the upwards change from grey measures of the Halesowen Formation to redbeds. Defined on geophysical logs (in uncored boreholes) above a narrow zone of high gamma radiation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CYS ,
        namedrockunit:KE ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.730m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top taken at the highest mappable persistent sandstone beneath the predominantly argillaceous sequence of the overlying Tile Hill Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SAL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Coventry Sandstone Formation [Obsolete: use ALY, ASY, MRD]"@en ,
        "Keele Formation [Obsolete: use ALY, HA, MRD, SAL]"@en ,
        "Meriden Formation and Tile Hill Mudstone Formation (Undifferentiated)"@en ,
        "Salop Formation"@en ;
    skos:definition "Obsolete name. Mudstone and sandstone with subsidiary conglomerate and limestone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MRD"@en ;
    skos:prefLabel "Meriden Formation [Obsolete: use SAL]"@en ;
