namedrockunit:RWT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A well-bedded dacitic tuff and lapilli-tuff, with some pyroclastic breccia and accretionary lapilli-tuff, more thinly-bedded, finer grained and better sorted upwards, with abrupt intra-bed changes in grain size common."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the abrupt change from bedded volcaniclastic sandstone to bedded pyroclastic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3016 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 100 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Intruded by andesite sills at the base of the overlying Mardale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rowantreethwaite Member [Obsolete: use RWT]"@en ;
    skos:broader namedrockunit:MRL ;
    skos:definition "Lapilli-tuff and tuff with subsidiary pyroclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RWT"@en ;
    skos:prefLabel "Rowantreethwaite Tuff Member"@en ;
.

namedrockunit:RXB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and yellow-green, pyritic, silty sands with an indurated basal pebbly sandstone with black chert phosphatic nodules and derived Kimmeridgian debris. Bioturbation and burrows occur in the unit and may extend down into the top of the underlying Kimmeridge Clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact at the down-section change from sands, with a pebbly base, to mudstones of the Kimmeridge Clay Formation. An erosion surface separates the two units."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1157 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformable, where green, glauconitic, clayey sands with abundant black phosphatic nodules of the Runcton Member overlies grey and yellow-green, pyritic, silty sands of the Roxham Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Roxham Beds [Obsolete: use RXB]"@en ;
    skos:broader namedrockunit:SAS ;
    skos:definition "Sand with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RXB"@en ;
    skos:prefLabel "Roxham Sand Member"@en ;
.

