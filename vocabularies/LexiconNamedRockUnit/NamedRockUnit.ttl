namedrockunit:BNTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithology is a glacially organized diamicton (till), composed of isolated boulders, gravel and pebbles in a matrix of sandy silty clay. The more elongated clasts are preferentially oriented and the deposit commonly has systematic sets of joints. The deposit is of a stiff to hard consistency and low plasticity. In general the colour of till reflects that of the local bedrock so may be totally different from one area to the next and can be reddish brown (Devonian and Upper Coal Measures) or brownish grey or black (Carboniferous)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity or glacial deformation boundary on bedrock or on assumed older (usually unclassified) Quaternary strata."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2630 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Veneer to more than 20m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity or glacial deformation boundary below younger Quaternary strata. Where data are available the Baillieston Till Formation is overlain by the Broomhill Clay Member and/or the Cadder Sand Member of the Wilderness Till Formation or this till itself."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Baillieston Member [Obsolete: use BNTI]"@en ;
    skos:broader namedrockunit:MVG ;
    skos:definition "Diamicton and trace clay, gravel, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNTI"@en ;
    skos:prefLabel "Baillieston Till Formation"@en ;
.

