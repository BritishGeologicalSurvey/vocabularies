namedrockunit:PYHL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, thin- to medium-bedded crinoidal wackestones and calcareous mudstones. Scattered chert nodules and bands, together with silicified fossils. Local dolomitization. Crinoidal packstones with regular stylolitic partings comprise the basal 5m. Wackestones represent storm generated deposits on a muddy distal carbonate ramp."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at sharp junction between dolomitised crinoidal packstones at the top of the underlying Hobbyhorse Bay Limestone Formation and the crinoidal packstones with mudstone partings of the Pen-y-holt Limestone Formation. This boundary is unsatisfactory [Simpson and Kalvoda, 1987] but has not been changed as it defines the base of the Arundian Stage and needs further work."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 280m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the gradational boundary between the dark grey interbedded wackestones and mudstones of the Formation and the pale grey thick-bedded skeletal and oolitic limestones of the overlying Stackpole Limestone Formation. Top taken at the base of the first oolitic limestone in the Stackpole Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Limestone and mudstone with subsidiary chert and trace dolomitic limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Arundian Substage (Carboniferous Period) (346.7-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PYHL"@en ;
    skos:prefLabel "Pen-y-holt Limestone Formation"@en ;
.

namedrockunit:PYMB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Conglomerates, sandstones and red siltstones, typically arranged in fining-upwards alluvial cycles; the siltstones commonly contain calcrete glaebules and grade up into well developed, massive limestone or dolostone calcretes. \r
\r
Fluvial deposition in a broad south-east-trending meandering river belt. \r
\r
Probably Lochkovian, but no diagnostic fossil evidence has yet been found."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at an erosion surface that truncates 1.5 m of massive calcrete at the top of the underlying Traeth Bach Formation and is overlain by a 1.5 m-thick extraformational conglomerate on the south side of Traeth yr Ora at the base of the Porth-y-Mor Formation. Note that this is slightly above the boundary proposed by Allen (1965a) (Davies, 2005)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "311.5 m at the coast, perhaps thinning inland as a result of internal overlap."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at 477 m (1565 feet) from the base of the section measured by Allen (1965a), at the base of a thinner bedded sandstone/mudstone succession lacking intraformational conglomerates and thick cyclic units (the Traeth Lligwy Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DULB ;
    skos:definition "Conglomerate, sandstone and siltstone with subsidiary calcrete. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age (Devonian Period) (419-412.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PYMB"@en ;
    skos:prefLabel "Porth-y-Mor Formation"@en ;
.

