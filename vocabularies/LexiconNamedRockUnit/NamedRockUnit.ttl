namedrockunit:CHOS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine-grained, poorly sorted, glauconitic sand with some beds of medium-grained sand, more clayey sands and thin ferruginously cemented beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable on various Jurassic formations."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 0 and about 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by the upward change from sand to extremely clayey glauconitic sand and sandy clay of the Bedchester Sands Member, or, in its absence, to the sandy clay of the Gault."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:FO ;
    skos:definition "Glauconitic sandstone and sand with subsidiary ferruginous sandstone and silty sandstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHOS"@en ;
    skos:prefLabel "Child Okeford Sand Member"@en ;
.

namedrockunit:CHPL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of succession is dominated by mid to mid-pale grey, medium- and coarse-grained calcarenite, oolitic grainstones interbedded with conglomerates, \"mixed laminates\" (ie. interbedded siltstone with sandstone and mudstone laminae), dolomicrites and fenestral or algal lime-mudstones. Argillaceous wackestones occur locally in the upper part of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of conglomerate of the Chapel House Limestone Formation where it rests with significant non-sequence on the deeply fissured limestone top surface to the Stockdale Farm Formation, which comprises limestone, siltstone and mudstone. It lies directly on Lower Palaeozoic rocks elsewhere."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum of about 56m adjacent to the Middle Craven Fault, with 33.6m in the type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at sharp conformable upward passage from grainstone of the Chapel House Limestone Formation to darker limestones of the Scalebar Force Limestone Member (Kilnsey Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary conglomerate, mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHPL"@en ;
    skos:prefLabel "Chapel House Limestone Formation"@en ;
.

