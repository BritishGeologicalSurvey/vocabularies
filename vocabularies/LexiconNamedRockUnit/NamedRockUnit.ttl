        "Marsden Formation"@en ,
        "Middle Grit Group [Obsolete: use MARSD, MGT]"@en ,
        "Middle Grits [Obsolete: use MGT]"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary coal, ganister and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Marsdenian Substage (Carboniferous Period) (321.5-320 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MGT"@en ;
    skos:prefLabel "Middle Grit [Obsolete: use MARSD]"@en ;
