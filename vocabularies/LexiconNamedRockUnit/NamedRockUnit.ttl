namedrockunit:MU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MFLAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MFTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mafic agglomeratic tuff, tuffite and thin mafic pillowed lava flows with interbedded silty mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the volcaniclastic sandstones of the Allt Lwyd Formation and passes laterally into the undivided siltstones and mudstones of the Aran Volcanic Group; locally, conformably overlies the felsic tuffs of the Offrwm Volcanic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4208 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
