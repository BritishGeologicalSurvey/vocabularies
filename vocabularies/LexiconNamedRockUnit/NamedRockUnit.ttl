namedrockunit:CRAG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FECRTE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sands, gravels, silts and clays. The sands are characteristically dark green from glauconite but weather bright orange with haematite 'iron pans'. The gravels in the lower part of the group are almost entirely composed of flint. Those higher in the group include up to 10% of quartzite from the Midlands, igneous rocks from Wales, and chert from the Upper Greensand of south-eastern England."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, planar unconformity upon strata extending from the Chalk Group (Cretaceous) in the west to the London Clay Formation (Palaeogene) of the Thames Group in the east. Usually there is a glauconitic conglomerate of rounded flints at the base of the Crag Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasOldestAgeValue 5.33e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 70 m onshore."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by deposits of the Dunwich Group, Albion Glacigenic Group, Britannia Catchments Group or British Coastal Deposits Group. Also interdigitates with the Dunwich Group, from which it can be distinguished by the marine origin of the sediments (all Dunwich Group fromations are fluvial). May be distinguished from the Albion Glacigenic Group by the absence of northern British erratic clasts in the Crag Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GBG ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace ferricrete. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Pliocene Epoch (Neogene Period) - to - Pleistocene Epoch (Quaternary Period) (5.33-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CCG ,
        namedrockunit:NCG ,
        namedrockunit:NCRC ,
        namedrockunit:RCG ,
        namedrockunit:STGR ,
        namedrockunit:WHGR ,
        namedrockunit:WRCG ;
    skos:notation "CRAG"@en ;
    skos:prefLabel "Crag Group"@en ;
