        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Duplicate: use CMBA] \r
\r
Massive to thickly bedded sequence of dacitic volcanic breccia, lapilli tuffs and tuffaceous mudstones/siltstones."""@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed; rests on fine-grained beds of Blackbrook Reservoir Formation, latter greenish-grey and commonly well-laminated."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.21m in east, possibly over 100m in west."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Beacon Tuff Member in east, and by Charnwood Lodge Volcanic Formation (undivided beds) in west."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Dacite and volcaniclastic-breccia with subsidiary lapilli-tuff and trace tuffaceous-mudstone and tuffaceous-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "BENS"@en ;
    skos:prefLabel "Benscliffe Breccia Member [Duplicate: use CMBA]"@en ;
