namedrockunit:SGAOR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cross-stratified conglomerates, containing cornstone, quartzite and Torridonian sandstone clasts predominate. Channels, cross-bedding and a high degree of sediment sorting indicate that fluvial deposition was likely, indicating a gradual transition to the marine conditions of the overlying Allt Dubh Member. Clasts reach a maximum size of 150mm. Not shown on 50K maps."@en ;
    lexicon:hasLowerBoundaryDefinition "Cross-stratified conglomerate mark the base of the Member, above poorly-sorted conglomerates of the A'Mharagach Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Below marine fossil-rich sandstone beds of the Allt Dubh Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MODS ;
    skos:definition "Conglomerate, nodular limestone (cornstone), sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SGAOR"@en ;
    skos:prefLabel "Sgaorishal Member"@en ;
