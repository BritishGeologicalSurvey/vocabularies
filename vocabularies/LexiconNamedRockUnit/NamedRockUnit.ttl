namedrockunit:SK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to medium-grained, muddy marine sands, with clay intercalations in the east. In the south and west it is characterised by gently-dipping prograding reflectors, mostly inclined eastnortheast; in the east its internal reflectors are sub-parallel. It passes laterally eastwards into thick, overlapping westward-prograding units of the Ijmuiden Ground Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies early Lower Pleistocene Westkapelle Ground Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS095> ;
    lexicon:hasOldestAgeValue 2.42e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40 metres.  (20 - 50 metres)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by Yarmouth Roads Formation or Winterton Shoal Formation, or by Upper Pleistocene or Holocene sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS063> ;
