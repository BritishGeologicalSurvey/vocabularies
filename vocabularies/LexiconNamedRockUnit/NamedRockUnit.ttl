        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Calcareous, banded psammite and semipelite, grey and pale green, normally flaggy but schistose in places. Tremolitic amphibole commonly conspicuous in hand specimen. Thin beds of impure metalimestone locally."@en ;
    lexicon:hasLowerBoundaryDefinition "At incoming of calcareous (greenish, tremolite-bearing) psammites and semipelites above the non-calcareous Findlater Flag Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DAAF ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 1200m in coastal section."@en ;
    lexicon:hasUpperBoundaryDefinition "Below graphitic pelites with beds of pure metalimestone comprising the Mortlach Graphitic Schist Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cairnfield Actinolitic Flags [Obsolete: use CCFL]"@en ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Calcareous psammite and calcareous semipelite with subsidiary metadolostone, metalimestone and pelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CRPT ,
        namedrockunit:GART ;
    skos:notation "CCFL"@en ;
    skos:prefLabel "Cairnfield Calcareous Flag Formation"@en ;
.

namedrockunit:CDGP
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PEMB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use BO, HBO, PEMB] Coarse bioclastic and oolitic facies showing variation,giving way upwards to a calcitic mudstone facies."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Gully Oolite where grey coarse grained oolitic and crinoidal limestone conformably rests upon grey granular oolitic limestone of the Black Rock Group."@en ;
