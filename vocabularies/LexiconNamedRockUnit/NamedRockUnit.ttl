namedrockunit:LSC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cyclic: includes coal seams.NOTE: Passage, Upper Limestone, Limestone Coal and Lower Limestone formations were defined for use on Scottish maps by MacGregor, 1960, based, except for the top of the Passage Formation, on the correlation of marine bands. The top of the Passage Formation is defined on the base of the overlying Lower Coal Measures, drawn at an arbitrary line that varies in horizon from basin to basin. The various positions are shown by Ramsbottom and others, 1978. It is proposed that these positions and the marine bands (considered as lithological markers) defining the other formational boundaries be followed here. It is proposed that the divisions be retained but with rank revised from Group to Formation, as these are the units that are mapped in practice and displayed on published 1: 50k maps."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of Top Hosie Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DLST ,
        namedrockunit:H2759 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "530.2 metres in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of Index Limestone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dalry Sandstone Formation [Obsolete: use LSC]"@en ,
        "Limestone Coal Group [Obsolete: use DLST, LSC, KLMD]"@en ;
    skos:broader namedrockunit:CKN ;
    skos:definition "Mudstone, sandstone and siltstone with subsidiary limestone, seat-earth mudstone and seat-earth sandstone and trace coal, ironstone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
