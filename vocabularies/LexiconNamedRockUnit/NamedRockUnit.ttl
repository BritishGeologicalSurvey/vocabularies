    skos:altLabel "Formerly included in Claragh Sandstone Group [Obsolete: use BNMS]"@en ;
    skos:broader namedrockunit:TYRO ;
    skos:definition "Calcareous sandstone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:TUY ;
    skos:notation "BNMS"@en ;
