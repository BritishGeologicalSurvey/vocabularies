namedrockunit:YED
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine- to medium-grained, calcareous, shelly, bioturbated, passing up into limestone, shelly, sandy, variably ooidal, with abundant bivalves and serpulids, and coral debris in the upper part; locally a coral rich bed is preserved near the top (Hackness Coral-Sponge Bed)."@en ;
    lexicon:hasLowerBoundaryDefinition "Non-sequence: generally well-cemented calcareous fine-grained sandstone, locally spicule-rich (Lower Calcareous Grit Formation), sharply overlain by softer fine- to medium-grained calcareous sandstone of basal Yedmandale Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1291 ,
        namedrockunit:H2545 ,
        namedrockunit:H3149 ,
