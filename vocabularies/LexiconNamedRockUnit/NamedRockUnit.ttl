namedrockunit:FFML
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of about three thin (0.1 to 0.3 m) limestone beds, separated by up to 0.5m of calcareous mudstone beds. Limestones are bioclastic packstone/grainstone, shelly, grey, weathering pale orange brown. Fauna includes bivalves, echinoderms, ammonites, corals and the trace fossil Kulindrichnus. Whole Gryphaea shells and crinoid (Pentacrinus) debis abundant on the outcrop. Forms a strong feature with a broad dip slope."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey, calcareous mudstone of the undifferentiated Granby Member; at 58.14 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4647 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1.39 m in type section; up to 2 m in Leicestershire."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into bluish grey, shaly mudstone of the undifferentiated Buckingham Member; at 56.75 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fen Farm Limestone [Obsolete: use FFML]"@en ;
    skos:broader namedrockunit:GRBL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FFML"@en ;
    skos:prefLabel "Fen Farm Limestones Bed"@en ;
.

namedrockunit:FGHL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATRAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Faughlin Lava Member consists predominantly of microporphyritic trachybasalt and basaltic-trachyandesite lavas (hawaiitie to mugearite). A single plagioclase-macrophyric trachybasalt (hawaiite of 'Markle' type) is also present and tuff and agglomerate are present locally at the base of the member. The source of this member is probably local."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the Faughlin Lava Member is conformable or disconformable on the underlying Carron Bridge Lava Member, and is marked in the small stream due south of  bridge over the River Carron [748 838] by a tuff overlying trachybasalt."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4648 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Faughlin Lava Member is overlain by the Campsie Lava Member. The lithological change is to mostly plagioclase-microphyric basalt and trachybasalt (of 'Jedburgh' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Faughlin Lavas [Obsolete: use FGHL]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basaltic-trachyandesite and trachybasalt with subsidiary agglomerate and tuff. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FGHL"@en ;
    skos:prefLabel "Faughlin Lava Member"@en ;
.

namedrockunit:FGLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFBRC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Fin Glen Lava Member consists of trachyte and plagioclase-microphyric varying to aphyric basaltic-trachyandesite (mugearite) transitional to trachybasalt (hawaiite) to basalt (of 'Jedburgh' type). The thickest development is on the east side of Finglen Burn [NS 581 816], but this area is faulted , and exposure is only sporadic. Significant thicknesses of basaltic scoria tuff-breccia and lapilli-tuff occur between most of the lavas. In all but the south-west and south-east, the base of the member is a phonolitic trachyte lava, characterised by well-developed planar jointing. This might be derived from a phonolite intrusion in the North Campsie Linear Vent-swarm near Fintry [NS 614 863] and is one of very few phonolitic lavas in the Carboniferous and Permian successions of Scotland (Upton et al., 2007). In the southern part of its outcrop, another trachyte lava occurs near the top of member. The wide variation in characteristics of the lavas and high degree of their interdigitation suggests individual lavas may have been erupted from different sources, some local and others more distant (Craig, 1980)."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal phonolitic trachyte lava is conformable or disconformable on plagioclase-microphyric trachybasalt (hawaiite) lava of the upper north and south Campsie lavas (Campsie Lava Member)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1538 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "60 to 110 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Fin Glen Lava Member is overlain by the Holehead Lava Member. The lithological change is to mostly to plagioclase-macrophyric olivine basalts and trachybasalts (basalts to hawaiites of 'Markle' type), characterised by the presence of variable amounts of generally small plagioclase macrophenocrysts."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fin Glen Lavas [Obsolete: use FGLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt, hawaiite and mugearite with subsidiary lapilli-tuff, trachyte and tuff-breccia. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FGLA"@en ;
    skos:prefLabel "Fin Glen Lava Member"@en ;
.

