namedrockunit:STRR
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:SRG ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Strath Rory Formation encompasses a range of alluvial-fan and alluvial plain Middle Devonian deposits. Fanglomerates have been encountered at seven sites in the southern Inner Moray Firth. Their principal clast types are of quartzite and gneiss, derived from the metamorphic basement, but dolerite clasts have also been recorded in Quadrant 12, and granitic clasts occur near the South Halibut Granite, in Quadrant 13. The alluvial-plain sediments consist mainly of fine to medium or coarse grained, white and grey sandstones with minor beds of grey and reddish brown, commonly micaceous siltstone and mudstone. These beds include highly radioactive horizons in Quadrant 13 that are presumed to be rich in organic detritus. Sand-dominated sections up to 250 m thick have been proved beneath, within, and above fanglomerates at different sites. Well 12/29-2 also encountered a 67 m-thick section of reddish brown, greyish brown and grey lacustrine siltstones and mudstones of mid Eifelian to early Givetian age above fanglomerates."@en ;
    lexicon:hasLowerBoundaryDefinition "The Strath Rory Formation rests unconformably on mainly lacustrine Lower Devonian sediments or on metamorphic or granitic basement."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation has a maximum drilled thickness of 987 m offshore, but equivalent sequences are more than 3 km thick in parts of northeast Scotland (Mykura, 1991)."@en ;
    lexicon:hasUpperBoundaryDefinition "Regional unconformities separate the Strath Rory Formation from overlying Upper Devonian or Lower Permian fluvial sandstones or Mesozoic sediments. In most sections, the boundary is marked by a clearly defined wireline-log break. Where Middle Devonian and Lower Permian sandy sections are juxtaposed, the latter can be distinguished by a higher proportion of mudstone beds, and the boundary is generally marked by a sharp downward increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Strath Rory Group [See Also STRR]"@en ;
    skos:broader namedrockunit:MIOR ;
    skos:definition "Conglomerate and sandstone and trace mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Eifelian Age - to - Givetian Age (Devonian Period) (394.3-378.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STRR"@en ;
    skos:prefLabel "Strath Rory Formation [See Also SRG]"@en ;
.

namedrockunit:STRSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold phase sands and gravels that underlie a terrace supposedly intermediate in height between  the Cropthorne (4) and Pershore members (5) of the Avon Fourth Terrace of Tomlinson (1925) and of BGS maps. Dominated by clasts of \"Bunter\" quartz/quartzite lithologies with subordinate flint. Terrace surface at type locality approximately 40-42m OD, ie, some 30m above the modern Avon. Overlies the organic Strensham Court Bed (Bowen, 1999), = the Strensham Bed of de Rouffignac (1995), assigned to Stage 7. (See Supplementary Information Description)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable channelled base, resting on Triassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3059 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 4 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Avon Fifth Terrace Deposits [Obsolete: use STRSG]"@en ;
    skos:broader namedrockunit:AVON ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STRSG"@en ;
    skos:prefLabel "Strensham Sand and Gravel Member"@en ;
.

namedrockunit:STRV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Stronend Volcaniclastic Member consists predominantly of volcaniclastic sedimentary rocks and possible tuff, with weathered basalt lava (including 'bole') and the member weathers back to form a prominent shelf in the escarpment on the western side of the Fintry Hills."@en ;
    lexicon:hasLowerBoundaryDefinition "Weathered basalt ('bole') at the base of the member is conformable or disconformable on plagioclase-microphyric basalt lava of the Spout of Ballochleam Lava Member, within which the Stronend Volcaniclastic Member is interdigitated."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H548 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Uncertain"@en ;
    lexicon:hasUpperBoundaryDefinition "Volcaniclastic rocks of the Stronend Volcaniclastic Member are overlain by plagioclase-microphyric basalt lava of the Spout of Ballochleam Lava Member, within which the Stronend Volcaniclastic Member is interdigitated."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Stronend Interbasaltic Beds [Obsolete: use STRV]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Tuff, volcaniclastic-mudstone and volcaniclastic-sandstone with subsidiary basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STRV"@en ;
    skos:prefLabel "Stronend Volcaniclastic Member"@en ;
.

