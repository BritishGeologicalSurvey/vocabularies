namedrockunit:TCC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin-bedded siltstone, mudstone and sandstone, in c. 20 - 50 m thick coarsening-up cycles. Each cycle has an erosional base covered with laminated grey siltstone with dessication cracks, followed by wave-rippled sandstone, topped by trough cross-bedded sandstone to the top."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable upon Aultbea Formation (TCAU) (Contact only exposed on Gruinard Island - not re-analysed since the early 20th century due to anthrax contamination in the Second World War)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 630 m (minimum at type section); total possibly 1000 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Erosional - not exposed. Unconformably overlain by Cambrian Ardvreck Group (ARDV)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TC ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TCC"@en ;
    skos:prefLabel "Cailleach Head Formation"@en ;
