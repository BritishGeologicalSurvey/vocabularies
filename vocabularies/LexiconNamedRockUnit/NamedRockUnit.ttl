namedrockunit:MEON
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Floodplain alluvium and river terrace deposits. The floodplain alluvium comprises overbank deposits of brown organic silty clay and peaty clay, yogether with peat, overlying sand and gravel. The surviving river terrace deposits comprise sand and gravel, commonly cross-bedded, locally overlain by overbank deposits of clayey sandy silts and silty clays. These fine-grained deposits may be partly aeolian in origin. The major gravel lithology is flint, dominantly sub-rounded to sub-angular, some of it well rounded. The sand fraction is composed of well rounded quartz grains and subangular flint. The older, higher terraces are commonly cryoturbated."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Palaeogene bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNTCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MEON"@en ;
    skos:prefLabel "Meon Formation"@en ;
.

namedrockunit:MER
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use TPSF] \r
\r
Siltstone, interbedded and interlaminated with subordinate mudstones and sandstones. Most siltstones are red-brown and most of the sandstones are grey-green. Ripple marks and pseudomorphs after halite are common."""@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable at the base of the siltstone-dominated sequence above the Sherwood Sandstone Group in the Stafford-Eccleshall Basin."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.15m in the Stoke-on-Trent district, though thickens to 60m in the Coton Fields No.1 Borehole at Stafford, near the centre of the Stafford-Eccleshall Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable at the base of the mudstone dominated sequence of the overlying part of the Mercia Mudstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:TPSF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Tarporley Siltstone Formation"@en ;
    skos:definition "Obsolete name. Siltstone with subsidiary mudstone and sandstone and trace halite. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MER"@en ;
    skos:prefLabel "Maer Formation [Obsolete: use TPSF]"@en ;
.

namedrockunit:MERB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Variable lithology; gravel (shingle), sand, silt and clay; commonly charged with organic debris (plant and shell); from the marine and estuarine environments, the 'Raised Beach Deposits' are now above the level of the present shoreline as a result of earth movement or a general fall in sea level. [Generic description]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Sand and silt with subsidiary clay and gravel and trace peat. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "MERB"@en ;
    skos:prefLabel "Marine, Estuarine and Raised Beach Deposits (Undifferentiated)"@en ;
.

namedrockunit:MESC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Schistose semipelite, biotite-muscovite bearing (lower part). Upper part: schistose pelite, garnet-biotite-muscovite bearing, with local kyanite and staurolite. Minor micaceous, flaggy psammite. Quartz segregations occur. Strongly deformed and metamorphosed."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable upon Lewisian Gneiss inlier (L); unconformity highly sheared."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Apparent thickness c. 400 m; deformed."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Altnaharra Formation (ALPS)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Pelite and semipelite with subsidiary micaceous psammite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MESC"@en ;
    skos:prefLabel "Meadie Schist Formation"@en ;
