namedrockunit:MCSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to thick-bedded, medium- to coarse-grained, planar and trough cross-bedded sandstone. In places the bedding is disturbed. Some thin mudstone beds towards top and base. Some granule-sized conglomeratic beds. Sandstone consists mainly of sub-rounded quartz grains with some interstitial quartz and calcite cements."@en ;
    lexicon:hasLowerBoundaryDefinition "Contact of sandstone with underlying mudstone and siltstone of the Fell Sandstone Formation (undifferentiated)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 60m, with the greatest thickness near Shoreswood Farm [NT 3940 6465]."@en ;
    lexicon:hasUpperBoundaryDefinition "Contact of sandstone with overlying mudstone and siltstone of the Fell Sandstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:FELL ;
    skos:definition "Sandstone with subsidiary mudstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Holkerian Substage (Carboniferous Period) (346.7-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MCSA"@en ;
    skos:prefLabel "Murton Crags Sandstone Member"@en ;
.

namedrockunit:MCT
    a skos:Concept ;
