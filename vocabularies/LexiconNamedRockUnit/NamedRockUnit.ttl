    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3 to 8.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at base of the overlying mudstone within measures of the Alston Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eelwell Limestone [Obsolete: use EWL]"@en ,
        "Five Yard Limestone [Obsolete: use FYL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone with subsidiary mudstone and trace calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FYL"@en ;
    skos:prefLabel "Five Yard Limestone Member"@en ;
.

