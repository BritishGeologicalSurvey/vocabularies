    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 50m in moraines, generally 10 to 30m."@en ;
    lexicon:hasUpperBoundaryDefinition "Varies between the present land surface and the contact with later deposits such as glacial lake deposits, outwash deposits and blown sand."@en ;
