    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.70m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain disconformably by Wroxham Crag Formation, unconformably by Kesgrave Valley Subgroup and Mid Pleistocene glacigenic deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasYoungestAgeValue 7.8e-01 ;
