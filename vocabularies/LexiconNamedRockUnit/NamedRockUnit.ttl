namedrockunit:CBHR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFAMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grades from a basal facies of poorly sorted, grey, small-pebble conglomerates interbedded with coarse-grained sandstones, to graded sandstones and thin conglomerates, with grey tuffaceous mudstones and siltstones above."@en ;
    lexicon:hasLowerBoundaryDefinition "No longer seen, formerly stated to sharply overlie \"coarse green hornstones\" that are now referred to the Bradgate Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2667 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable, 0 to 47m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen. The unit fines upwards, towards the base of the overlying Swithland Formation, but an unconformity is suspected since the latter is now regarded as of Early Cambrian age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hanging Rocks Conglomerate Member [Obsolete: use CBHR]"@en ;
    skos:broader namedrockunit:CMV ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone and trace tuff, tuffaceous-mudstone and tuffaceous-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBHR"@en ;
    skos:prefLabel "Hanging Rocks Formation"@en ;
.

namedrockunit:CBL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:MDVL ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Well bedded limestone, fine to medium grained, dark grey to bluish-black, with rich fauna including tabulate and rugose corals, dendroid stromatoporoids. Limestone locally contains shale partings, typically of red colour, and locally up to 50 mm thick (at Broadridge Wood Quarry [SX 8390 7112]. Dolomitisation and fissuring are seen locally; fissures at Bickleyball Quarry [SX 8850 7400] are filled with slipped Upper Greensand and flint gravel. Dip of the limestone beds is typically 20 degrees to the E-SE, although this varies over the area."@en ;
    lexicon:hasLowerBoundaryDefinition "Chercombe Bridge Limestone of the Ugbrooke Unit (i.e. in the thickness of rock that is bound between the Bickington Thrust in the north and the Ware Barton Thrust in the south) has thrust contact with Carboniferous rocks around Bickington, and a thrust contact with Upper Devonian slate near to Telegraph Hill [SX 8082 7338]. Chercombe Bridge Limestone from the Ugbrooke - East Ogwell Succession conformably overlies the East Ogwell Limestone in an inverted succession at [SX 8850 7400]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 245 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Chercombe Bridge Limestone of the Ugbrooke Succession is locally faulted against the Kingsteignton Volcanic Group. In the Ugbrooke Unit (i.e. in the thickness of rock that is bound between the Bickington Thrust in the north and the Ware Barton Thrust in the south) the top of the formation is diachronous, with mid Frasnian ages at Chudleigh in the north [SS 8611 7793], and Givetian near Whiteway Barton [SX 8338 7090] in the south. In the Denbury and East Ogwell Successions, the upper boundary is a conformable one with the overlying Foxley Tuff."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Devonian Limestone"@en ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age - to - Givetian Age (Devonian Period) (394.3-378.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "CBL"@en ;
    skos:prefLabel "Chercombe Bridge Limestone Formation"@en ;
.

namedrockunit:CBLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lowest exposed part of the member (80 m seen) comprises flows of olivine-microphyric basalt and plagioclase-microphyric basalt to hawaiite, with single flows of plagioclase-macrophyric basalt to hawaiite and olivine-clinopyroxene-plagioclase-macrophyric basalt. The upper part (50 m maximum) is dominantly of flows that are varients of olivine-clinopyroxene-plagioclase-macrophyric basalt, with olivine-clinopyroxene-microphyric basalt flows towards the top. Flows vary from a few metres to over 20 m in thickness. Thin intercalations of basaltic agglomerate and tuff also occur."@en ;
    lexicon:hasLowerBoundaryDefinition "The succession dips gently to the south or south-east, and hence the lowest lavas occur in the north. Since the northern boundaries of the member are entirely faulted (against Limestone Coal Formation and Scottish Coal Measures Group strata), the base of the member does not crop out."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4637 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 130 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Various lavas are overlain unconformably by volcaniclastic sedimentary rocks of the Kirkwood Formation in the south-west of the outcrop, around Carmunnock, and by sandstones and mudstones of the Lawmuir Formation in the south-east, near Nerston."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Eaglesham Lavas [Obsolete: use CBLA, EMLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Olivine-clinopyroxene-plagioclase-macrophyric basalt and olivine-microphyric basalt with subsidiary hawaiite, plagioclase-macrophyric basalt and plagioclase-microphyric basalt and trace basaltic agglomerate, basaltic tuff and olivine-clinopyroxene-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBLA"@en ;
    skos:prefLabel "Cathkin Braes Lava Member"@en ;
.

