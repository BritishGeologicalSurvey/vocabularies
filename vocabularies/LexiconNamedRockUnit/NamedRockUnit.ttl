namedrockunit:KKBS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:S540 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCASST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A medium-bedded, very fine- to medium-grained, ripple cross-laminated, micaceous, buff to pale brown sandstone, interbedded with greenish grey siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp upward change in a conformable succession from predominantly grey mudstone/siltstone to sandstone - base of first sandstone above the Black Bed Coal."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 to 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upward change in a conformable succession from sandstone to predominantly grey mudstone - top of last sandstone bed below the Crow Coal."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Grenoside Rock"@en ;
    skos:broader namedrockunit:PLCM ;
    skos:definition "Micaceous sandstone and sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Langsettian Substage (Carboniferous Period) (319-318 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KKBS"@en ;
    skos:prefLabel "Kirkburton Sandstone"@en ;
.

namedrockunit:KKSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Marine, grey, soft to firm, clayey silt and dusky yellowish-brown silty clay interlaminated, containing sub-angular ice-rafted clasts (dropstones) of coal, basalt, mudstone and sandstone; characterised by laminations and in some cases, many thin beds of pale coloured silt and sand that are ripple bedded in places. Sporadic mottling and banding in black sulphide. The deposit is considered to be prodeltaic in origin."@en ;
    lexicon:hasLowerBoundaryDefinition "The relationship of the Kenneil Kerse Silt Member (Forth Clay Formation) to the underlying Errol Clay Formation is transitional."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4126 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Diachronous transitional top with the Abbotsgrange Silt Member is speculative; known only to be overlain unconformably by younger deposits such as the Claret Clay Member (Carse Clay Formation) and Bothkennar Gravel Member (Forth Clay Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kinneil Kerse Beds [Obsolete: use KKSI]"@en ;
    skos:broader namedrockunit:FOCL ;
    skos:definition "Clay and silt with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KKSI"@en ;
    skos:prefLabel "Kinneil Kerse Silt Member"@en ;
.

