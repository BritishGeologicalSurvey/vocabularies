    skos:definition "Diamicton with subsidiary sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SUTI"@en ;
    skos:prefLabel "Suidheig Till Formation"@en ;
.

namedrockunit:SVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of the formation comprises green-grey, pillowed, andesitic or dacitic hyaloclastites (Bevins et al, 1992; cf. Thomas and Cox, 1924) The upper part of the Formation comprises rhyolitic tuffs.Geochemical investigations undertaken by Bevins et al (1992) confirm the calc-alkaline chemistry of these rocks, indicating that they are the continental-side products of island arc magmatism."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational passage from shales of underlying Rosebush Formation. Boundary is drawn where volcanic rocks become dominant over shales."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1211 ,
        namedrockunit:H2464 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OF> ;
    lexicon:hasOldestAgeValue 4.7075e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "90 - 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with the base of the Aber Mawr Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OF> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Sealyham Volcanic Group [Obsolete: use SVO]"@en ,
        "Sealyham Volcanic Series [Obsolete: use SVO]"@en ;
    skos:definition "Lava, rhyolite and tuff with subsidiary andesite and trace dacite. Stratified bedrock. Occurs onshore. Deposited during the Fennian Stage (Ordovician Period) (470.75-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SVO"@en ;
    skos:prefLabel "Sealyham Volcanic Formation"@en ;
.

namedrockunit:SWB
