    lexicon:hasThicknessDescription "About 2 m; 1.94 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey, shelly, bioclastic limestone of the undifferentiated Beckingham Member; at 38.62 in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
