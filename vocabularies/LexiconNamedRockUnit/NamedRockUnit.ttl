namedrockunit:TDL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use LEEL] \r
\r
Comprises interbedded skeletal limestones and distinctive porcellanous limestones; rests unconformably on cleaved Ordovician mudstones. The formation is capped by the widely recognised Bryn Tirion Member and overlain by the massive or rubbly skeletal limestones of the Penmon Limestone."""@en ;
    lexicon:hasLowerBoundaryDefinition "Contact with Ordovician rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "45m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of uppermost porcellanous limestone of the Bryn Tirion Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:LEEL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Leete Limestone Formation"@en ;
    skos:definition "Obsolete name. Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TDL"@en ;
