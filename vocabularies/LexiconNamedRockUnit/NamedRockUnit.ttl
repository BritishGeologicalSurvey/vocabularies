namedrockunit:BUR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, fine-grained silicified tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "The Buxton Rock is regarded as the basal member of the Burway Formation.The base is generally sharply defined, usually overlying dark grey mudstones of the Stretton Shale Formation. However, it is not uncommon for turbiditic sandstone facies, characteristic of the Burway Formation, to appear below the Buxton Rock. Lithologies comparable to the Stretton Shale Formation also occur locally up to 15m above the Buxton Rock (Greig et al, 1968; Wilson, 2000)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3255 ,
        namedrockunit:YSBB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "7 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "the unit has a sharply defined planar top, usually overlain by thinly interbedded turbiditic sandstones and mudstones of the Burway Formation (but see above)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Buckstone Grit [Obsolete: use BUR]"@en ,
        "Buxton Rock [Obsolete: use BUR]"@en ;
    skos:broader namedrockunit:BUGP ;
    skos:definition "Tuff. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BUR"@en ;
    skos:prefLabel "Buxton Rock Member"@en ;
.

namedrockunit:BUSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "White to brown, generally very fine- to very fine-grained (occasionally medium- to coarse-grained) sandstones, which are poorly to well sorted, locally calcite cemented, and sometimes micaceous. The sandstones may be massive, several tens of metres thick, or thinly bedded with thin interbedded mudstones. The member interdigitates with the mudstones of the Heather Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is defined by a sharp down-section change from sandstones to mudstones (Heather Formation) and a down-section increase in gamma-ray values."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5140 ,
        namedrockunit:H5141 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 95 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is characterised by a down-section change from mudstones (Heather Formation) to sandstones. It is accompanied by a down-section decrease in gamma-ray values, and in many wells, an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Katrine Member [Obsolete: use BUSA]"@en ,
        "Nevis Member [Obsolete: use BUSA]"@en ;
    skos:broader namedrockunit:HTHE ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Callovian Age - to - Oxfordian Age (Jurassic Period) (165.3-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BUSA"@en ;
    skos:prefLabel "Bruce Sandstone Member"@en ;
