        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, semipelite and pelite, interbanded, gneissose and migmatitic. Quartzo-feldspathic segregations common. Commonly garnetiferous. Some subunits are more psammitic; others more pelitic."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary is mainly a structural boundary with the underlying Swordly Thrust. However, thin slivers of strained Lewisianoid gneiss (“Swordly Inlier”) suggest the Loch Coire Formation may be deposited unconformably upon Lewisianoid Gneiss."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BACH ,
        namedrockunit:KIRY ,
        namedrockunit:SGMC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Strongly deformed, possibly > 1 km."@en ;
    lexicon:hasUpperBoundaryDefinition "Likely overlain by the Portskerra Formation, but any contact is highly sheared. In part cut by overlying Skinsdale Thrust."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Badenloch Pelite Member [Obsolete: use LOCE]"@en ,
        "Kirtomy Gneisses [Obsolete: use LOCE]"@en ,
        "Sgurr Marcasaidh Formation [Obsolete: use LOCE]"@en ;
    skos:broader namedrockunit:GLEN ;
    skos:definition "Gneissose pelite, gneissose psammite and gneissose semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SWOR ;
    skos:notation "LOCE"@en ;
    skos:prefLabel "Loch Coire Formation"@en ;
.

