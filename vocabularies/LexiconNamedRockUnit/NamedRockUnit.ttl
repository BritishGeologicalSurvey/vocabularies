namedrockunit:CATI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The California Till Member consists of a stratified matrix-supported diamicton that comprises beds of massive brown sandy diamicton, separated by beds of massive and horizontal-bedded chalky sand with sporadic augen-shaped lenses of fine silty sand. It is similar in lithology to the Corton Till Member."@en ;
    lexicon:hasLowerBoundaryDefinition "The California Till Member overlies the Corton Sand Member within the Scratby and California area. The contact between the two units is gradational."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3276 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum observed thickness of 13m at California Gap."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the California Till Member is typically scoured and erosional, and is overlain by chalky outwash and till deposits of the Lowestoft Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Corton Till [Obsolete: use CATI]"@en ;
    skos:broader namedrockunit:HPGL ;
    skos:definition "Diamicton with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CATI"@en ;
    skos:prefLabel "California Till Member"@en ;
.

