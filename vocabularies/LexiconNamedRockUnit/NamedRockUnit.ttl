    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRGS ;
    skos:definition "Flaggy micaceous psammite with subsidiary flaggy semipelite, micaceous psammite, psammite, quartzite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LINN ,
        namedrockunit:RESS ;
    skos:notation "EILDE"@en ;
