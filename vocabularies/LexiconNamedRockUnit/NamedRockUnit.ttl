namedrockunit:PBK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly limestone but with interbedded sandstone and possibly mudstone. Limestones not only include pale grey biosparites etc, as in Knipe Scar Limestone, but also dark grey, platy beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Where medium to dark grey, medium- and coarse-grained limestones and shaly limestones of the Potts Beck Limestone overlie pale, grey-brown, flaggy, fossiliferous limestone of the Ashgill Limestone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1753 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "70 metre. (Thins slightly westward to c.60m north of Orton)."@en ;
    lexicon:hasUpperBoundaryDefinition "Where pale grey limestone and dark grey limestone and sandstone of the Potts Beck Limestone is overlain by pale grey, scar-forming limestone (mostly thick-bedded biosparites and biopelsparites commonly pseudobrecciated) of the Knipe Scar Limestone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Potts Beck Limestone [Obsolete: use PBK]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PBK"@en ;
    skos:prefLabel "Potts Beck Limestone Formation"@en ;
.

namedrockunit:PBTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S816 ;
    lexicon:hasLithology
