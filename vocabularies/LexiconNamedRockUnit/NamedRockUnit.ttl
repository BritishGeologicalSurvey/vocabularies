    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "800m to 2000m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by volcaniclastic sediments and rhyolitic air-fall tuffs of the Minfordd Formation. Details of the boundary are unknown."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
