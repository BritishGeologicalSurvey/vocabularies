    lexicon:hasThicknessDescription "A near-vertical sheet-like mass, emplaced at the junction between the Skiddaw Group and  the Eycott Volcanic Group."@en ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carrock Fell Complex (Mosedale Division) [Obsolete: use CFCOM]"@en ;
    skos:broader namedrockunit:CFCO ;
    skos:definition "Gabbro and quartz-gabbro. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
