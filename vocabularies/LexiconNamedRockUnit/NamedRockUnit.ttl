namedrockunit:ECL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of the formation is dominated by thinly to thickly bedded, brownish-grey, finely bioclastic and peloidal to conglomeratic limestone, containing chert nodules and mudstone partings, in sharp based, poorly graded turbiditic beds. In the middle, thinly bedded and laminated dark grey micritic limestone passes up into thicker bedded limestone. The upper part of the formation, includes dark grey fine-grained limestone, and coarser-grained, sharp-based graded beds of turbiditic origin."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of thicker-bedded, paler grey peloidal and crinoidal bioclastic limestone above dark grey, thinly-bedded, fine-grained limestones of the Milldale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:APSL ,
        namedrockunit:H2166 ,
        namedrockunit:H2776 ,
        namedrockunit:MXL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 225m in the type area, increasing to a maximum of 258m proved around Grindon [SK 093 541]."@en ;
    lexicon:hasUpperBoundaryDefinition "A transitional conformable base taken at the lowest thick grey mudstone of the Widmerpool Formation, above grey limestones of the Ecton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Apestor Limestone [Obsolete: use ECL]"@en ,
        "Apestor Limestones [Obsolete: use ECL]"@en ,
        "Ecton Limestones Formation [Obsolete: use ECL]"@en ,
        "Mixon Limestones [Obsolete: use ECL]"@en ;
    skos:broader namedrockunit:CRAV ;
    skos:definition "Limestone and trace chert and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:ECLK ;
    skos:notation "ECL"@en ;
    skos:prefLabel "Ecton Limestone Formation"@en ;
