    lexicon:hasThicknessDescription "130m minimum thickness in general area. 20m minimum in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity surface. Overlain by Lower Cambrian beds of the Hartshill Sandstone Formation or by Triassic sandstone and breccia."@en ;
