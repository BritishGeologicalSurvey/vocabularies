namedrockunit:MMI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLateralEquivalent namedrockunit:S568 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HNFELS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMPY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Numerous thin sills of grey-green spessarite, lamprophyre and thicker composite sills of hornblende diorite, commonly melanocratic at the base, intruded into strata ranging from Precambrian to Ordovician (Tremadoc) age."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen; no information on depth extent of the intrusive complex."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasOldestAgeValue 4.4975e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/S> ;
    lexicon:hasThicknessDescription "The individual sills range from c. 1 m (lamprophyre), to about 60 m (diorite). An aggregate thickness of 100 - 150 m is probable"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the unconformity between the sills and their host rocks and overlying strata of Devonian, Carboniferous and Triassic age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Syenite or Diorite Intrusions"@en ;
    skos:broader namedrockunit:CIGSS ;
    skos:definition "Diorite with subsidiary lamprophyre and trace hornfels. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ashgill Series (Ordovician Period) (449.75-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MMI"@en ;
    skos:prefLabel "Midlands Minor Intrusive Suite"@en ;
.

namedrockunit:MMLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAALK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRAND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Moyne Moor Lava Member consists of plagioclase porphyritic trachybasalts (hawaiites) with discrete subordinate alkali basalt and rare basaltic trachyandesites (mugearites) near the top of the Member. These might herald the initiation of trachytic magma generating the trachytes of the overlying Harelaw Lava Member."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is possibly unconformable on the sedimentary strata of the Ballagan Formation (Inverclyde Group), but the contact is not seen because of faulting."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2325 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription ">100m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the geographically separate (and laterally equivalent) alkali basalts of the Eaglesham and Neilston Lava members. The contacts are considered conformable but also locally unconformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Moyne Moor Lavas [Obsolete: use MMLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Trachybasalt with subsidiary alkali basalt and trace trachyandesite. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MMLA"@en ;
    skos:prefLabel "Moyne Moor Lava Member"@en ;
.

