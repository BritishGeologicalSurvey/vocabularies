    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Slate with subsidiary lava and trace calcareous siltstone and nodules (undifferentiated). Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (378.9-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
