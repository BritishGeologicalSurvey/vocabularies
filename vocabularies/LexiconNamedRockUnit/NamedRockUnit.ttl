namedrockunit:LNML
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly pale, thick-bedded, locally cross-stratified, shelly limestones (packstones and grainstones), subordinate thinner bedded dark grey limestones (packstones) and oolitic limestones.  Upper parts (of early Asbian age), which interdigitate with the Leete Limestone Formation, include limestones rich in peloids, plates of dasycladacean algae, oncoids and reworked micrite intraclasts.  On the Great Orme, the formation is extensively dolomitised. The Llanarmon Limestone Formation records the intoduction of carbonate depositional environments across North Wales during a major and sustained Arundian marine transgression. The initial distribution of facies suggests a ramp-like setting, with darker off-shore limestones deposited in the north and east (of the Clwydian Range) and shallower, inner ramp facies to the west (Vale of Clwyd). Subsequently, during the late Arundian, these high energy, inner ramp limestones prograded northwards and eastwards to establish a low-gradient carbonate platform. During the early Asbian, these shoal facies withdrew to the outer edge of the platform to form a protective barrier to the peritidal facies of the Leete Limestone Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "East of the Clwydian Range, the base is taken at lowest massive, thick-bedded packstones and grainstone above thinner bedded, heterolithic sequences of the Foel Formation. West of the Clwydian Range, the Llanarmon Limestone Formation rests conformably on red beds of the Ffernant Formation, or sits unconformably on older Silurian rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1665 ,
        namedrockunit:H2910 ,
        namedrockunit:H3537 ,
        namedrockunit:H371 ,
        namedrockunit:LBRL ,
        namedrockunit:LLYL ,
        namedrockunit:LPD ,
        namedrockunit:OYFL ,
        namedrockunit:S550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Ranges from 75m in the Vale of Clwyd to 280m in the Dyserth-Caerwys area."@en ;
    lexicon:hasUpperBoundaryDefinition "Where overlain by the Leet Limestone Formation, the top is taken at the lowest porcellaneous limestone diagnostic of this formation; however, east of the Clwydian Range, the Leete Limestone Formation passes laterally northwards into the Llanarmon Limestone Formation so that north of Nannerch the top of the latter is taken at the entry of pseudobrecciated and mottled packstone of the Loggerheads Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dyserth Quarry Limestone [Obsolete: use LNML]"@en ,
        "Gop Hill Limestone [Obsolete: use LNML]"@en ,
        "Llandudno Pier Dolomite Formation [Obsolete: use LNML]"@en ,
        "Llandudno Pier Dolomite [Obsolete: use LNML]"@en ,
        "Llysfaen Limestone Formation [Obsolete: use LNML]"@en ,
        "Llysfaen Limestone [Obsolete: use LNML]"@en ,
        "Lower Brown Limestone [Obsolete: use FOF, LEEL, LNML]"@en ,
        "Moel Hraddug Limestone [Obsolete: use LNML]"@en ,
        "Ochr-y-Foel Limestone Formation [Obsolete: use LNML]"@en ;
    skos:broader namedrockunit:CLWYD ;
    skos:definition "Dolomitic limestone and limestone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LNMLK ,
        namedrockunit:LYFS ,
        namedrockunit:NYGL ;
    skos:notation "LNML"@en ;
    skos:prefLabel "Llanarmon Limestone Formation"@en ;
