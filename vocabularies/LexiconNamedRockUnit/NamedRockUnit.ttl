namedrockunit:BDMO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically yellowish brown, crudely bedded, angular to well-rounded clasts, with extremely variable sorting,  of both matrix- and clast-supported clayey gravel, with boulders and sandy diamicton, composed of psammite, metagreywacke, granite and quartzite, with some gneiss, slate and dolerite, elsewhere locally formed of mainly granite or gabbroic rocks, forming hummocky ground and cross-valley moraine ridges."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a  sharp, undulating, unconformable contact with a yellowish brown, gravelly clayey sand diamicton of the Banchory Till Formation and other sandy tills of the East Grampian Glacigenic Subgroup."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2593 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hummocky glacial deposits undivided [Obsolete: use BDMO]"@en ;
    skos:broader namedrockunit:EGD ;
    skos:definition "Boulders, diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BDMO"@en ;
    skos:prefLabel "Blairdaff Moraine Formation"@en ;
.

