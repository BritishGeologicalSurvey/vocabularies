namedrockunit:BACT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises a lower unit of red, red-brown and grey mudstones (Bunter Shale Formation), and an upper unit of red, orange and white dolomitic sandstones interbedded with red and grey mudstone (Bunter Sandstone Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Slightly unconformable, at an abrupt upward transition from the evaporites or dolomitic limestones of the upper part of the underlying Zechstein Group to the red or red-brown mudstones of the lower part of the Bacton Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 600 m (Johnson et al., 1994)."@en ;
    lexicon:hasUpperBoundaryDefinition "Slightly unconformable, at abrupt upward change from sandstone of the Bacton Group to red-brown dolomitic mudstone with evaporites of the overlying Haisborough Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BNS ,
        namedrockunit:BTSH ;
    skos:notation "BACT"@en ;
    skos:prefLabel "Bacton Group"@en ;
