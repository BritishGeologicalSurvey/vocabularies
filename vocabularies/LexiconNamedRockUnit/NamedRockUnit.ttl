    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Averages c.1800 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of massive sandstones of the Bayston - Oakswood Formation to more flaggy siltstones and laminated sandstones of the Bridges Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
