namedrockunit:PNWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use OHL] Stacked cyclic sequence of dark grey limestones in which shelly and crinoidal grainstones are the major components; beds are locally sandy, and chert layers and nodules are abundant. Many cycles are truncated by subaerial surfaces underlain by nodular limestones and overlain by seatearths and thin coals."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the point where dark limestones of the Penwyllt Limestone overlie pale grey oolite of the Penderyn Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H462 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the point where the dark grey limestones of the Penwyllt Limestone are overlain by thinly bedded impure limestones of the Oystermouth Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:OHL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Middle Dibunophyllum Limestones [Obsolete: use PNWL]"@en ,
        "Oxwich Head Limestone Formation"@en ;
    skos:definition "Obsolete name. Limestone with subsidiary sandy limestone and trace chert, coal and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PNWL"@en ;
    skos:prefLabel "Penwyllt Limestone [Obsolete: use OHL]"@en ;
.

namedrockunit:PNYF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Red-brown and purple quartz-rich sandstones, locally pebbly and conglomeratic with interbeds of red-brown mudstone (Taylor, 1972; Hall et al., 1973; Taylor and Thomas, 1974, 1975; Lovell, 1978a, b); some sandstones contain fish fragments and some beds yield brachiopods. A fish-bearing horizon, the Afon y Waen Fish Bed was thought by Hall et al. (1973) to be a laterally continuous horizon and was used by them to divide the Plateau Beds into lower and upper units. Lovell (1978a) considered that the horizon was not continuous, but that fish-bearing conglomerates occur as lenses at different levels. He recognised three subdivisions (Divisions A, B and C) on sedimentological grounds. \r
\r
Mainly fluvial, but with some shallow marine environments; some possible aeolian deposition has also been suggested (Lovell, 1978a, b), but a tidal channel environment may be more likely. A mudflow debrite lies at the base of the formation."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the formation is placed at a sharp junction where the basal hard purple sandstones of the formation unconformably overlie the softer drab red sandstones of the Brownstones Formation. A quartz granule debrite bed marks the base of the formation locally. A slight angular discordance between the formations is visible locally, as on the Carmarthen Fans of Bannau Sir Gaer and Fan Brycheiniog."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:PLB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "36 m at outcrop, with up to 58 m proved in boreholes at depth (Taylor and Thomas, 1975)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at a sharp junction where the topmost red sandstones of the formation are overlain by grey and grey-green sandstones of the overlying Wern Watkin (formerly Grey Grits) Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Plateau Beds Formation [Obsolete: use PNYF]"@en ;
    skos:broader namedrockunit:POB ;
    skos:definition "Mudstone and sandstone with subsidiary pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age - to - Famennian Age (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PNYF"@en ;
    skos:prefLabel "Pen y Fan Formation"@en ;
.

