namedrockunit:DHKG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "At Teindland Quarry the Deanshillock Gravel comprises coarse cobble gravel with clasts of quartzite and psammite. It passes upwards into very pale brown (10 YR 7/4) sand, the Orbliston Sand Bed. The Deanshillock Gravel and Orbliston Sand Bed are of probable glaciofluvial origin and, together with the underlying Red Burn Till Formation, probably date from Oxygen Isotope Stage (OIS) 6. At the Red Burn site, the Deanshillock Gravel Formation comprises a unit of sand with sporadic clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "The Deanshillock Gravel rests unconformably on stiff, reddish brown (2.5 YR 4/4) massive, matrix-supported sandy silty clayey diamicton of the Red Burn Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4606 ,
        namedrockunit:S141 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">6.5m."@en ;
    lexicon:hasUpperBoundaryDefinition "At Teindland Quarry, the pale brown sand of the Orbliston Sand Bed is overlain unconformably by bleached sand at the base of the Teindland Palaeosol Formation. At the Red Burn site, the upper contact of the Deanshillock Gravel Formation is gradational with overlying bleached silty sandy gravel at the base of the Teindland Palaeosol Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Orbliston and Deanshillock Members of the Teindland Formation [Obsolete: use DHKG]"@en ,
        "Teindland Gravel and Teindland Lower Sand [Obsolete: use DHKG]"@en ;
    skos:broader namedrockunit:CGAG ;
    skos:definition "Gravel with subsidiary sand and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DHKG"@en ;
    skos:prefLabel "Deanshillock Gravel Formation"@en ;
.

