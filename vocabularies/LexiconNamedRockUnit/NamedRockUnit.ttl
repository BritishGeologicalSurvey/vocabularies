namedrockunit:UPOR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly fluvial, terrestrial sediments of Late Devonian to Early Carboniferous."@en ;
    lexicon:hasLowerBoundaryDefinition "The group rests conformably on Givetian to early Frasnian marine beds (Kyle Group) near the international median line (Cameron 1993), and possibly also in northern Quadrant 44 (Cameron et al. 1992). Elsewhere, it is likely to rest on deformed Lower Paleozoic strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasUpperBoundaryDefinition "The Upper Old Red Group generally underlies Permian or younger strata, but is conformably overlain by the Cementstone Formation along the southern flank of the Mid North Sea High."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Conglomerate, mudstone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Late Devonian Epoch (Devonian Period) - to - Courceyan Substage (Carboniferous Period) (378.9-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BUHN ,
        namedrockunit:TYPO ;
    skos:notation "UPOR"@en ;
    skos:prefLabel "Upper Old Red Group [Offshore]"@en ;
.

