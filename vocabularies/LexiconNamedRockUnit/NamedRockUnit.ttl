    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "20 to 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Narrow Vein Mudtone Formation is taken at the base of the first sand band seen in an air shaft on Foel Crochan (7706 1050). The boundary is transitional over 2.65m, where sandy bands 1-2cm thick, occur separated by 10-20cm silty mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
    lexicon:hasYoungestAgeValue 4.452e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Narrow Vein Formation [Obsolete: use NRV]"@en ,
        "Narrow Vein [Obsolete: use NRV]"@en ;
    skos:broader namedrockunit:ARO ;
    skos:definition "Silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Rawtheyan Stage (Ordovician Period) (448.75-445.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NRV"@en ;
    skos:prefLabel "Narrow Vein Mudstone Formation"@en ;
.

namedrockunit:NSCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Suite of glacial, glaciofluvial, glaciolacustrine and possibly glaciomarine deposits that contain clasts predominantly from northeast England (yellow, grey and white sandstones, mudstone, limestone, coal, dolerite), southern Scotland (greywacke sandstone and mudstone, granite, andesite, red sandstone) and offshore (marl, gypsum, chalk and sparse Scandinavian erratics). Including clayey diamictons (till), sand, gravel, silt and clay. Deposited by ice sourced mainly in the Scottish Borders and central Scotland that flowed southeastwards along the eastern coast of England (but mainly offshore) as far as north Norfolk."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1095 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QC> ;
    lexicon:hasOldestAgeValue 8.6e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, mainly planar contact with units of the North Sea Coast Glacigenic Subgroup. Possible lateral interdigitation with units of the North Pennine (Albion) Glacigenic Subgroup."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "North Sea Drift [Obsolete: use NSCA, NSG]"@en ;
    skos:broader namedrockunit:ALBI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Cromerian Stage - to - Wolstonian Stage (Quaternary Period) (.86-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WAHG ;
    skos:notation "NSCA"@en ;
    skos:prefLabel "North Sea Coast (Albion) Glacigenic Subgroup"@en ;
.

