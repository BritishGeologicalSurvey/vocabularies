namedrockunit:GLPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Siliceous to micaceous psammite with subsidiary pelite beds. In lower part: thick beds (0.3 - 2 m) with coarsening upwards cycles with cm thick pelitic beds. In higher part: coarsening upwards units of rhythmically interbedded psammitic (siliceous and locally quarzitic) and pelitic beds, with water escape structures and slump folds."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Altnaharra Psammite Formation (ALPS) - commonly with gradational boundary with the Glen Achall Psammite and Semipelite Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1562 ,
        namedrockunit:H4677 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 4000-5000 m (estimate); thinning to the west."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Vaich Pelite Formation (VAPE). Boundary with Vaich Pelite Formation is normally sharp incoming of thick-bedded semipelite beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Psammite [Obsolete: use GLPS]"@en ,
        "Lower Quartzite [Obsolete: use GLPS]"@en ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Micaceous psammite and psammite with subsidiary pelite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:BKIL ;
    skos:notation "GLPS"@en ;
    skos:prefLabel "Glascarnoch Psammite Formation"@en ;
