    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clayband Ironstone Formation [Obsolete: use CBIF]"@en ,
        "Clayband Ironstone Measures [Obsolete: use CBIF]"@en ;
    skos:broader namedrockunit:PUCM ;
    skos:definition "Mudstone and siltstone with subsidiary coal, ironstone, sandstone and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage (Carboniferous Period) (314.75-310 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBIF"@en ;
    skos:prefLabel "Clayband Ironstone Member"@en ;
