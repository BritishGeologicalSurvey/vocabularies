        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Variable from bioclastic oolite, fine- to medium-grained oolite, biomicrite, with thin beds of marl, sandy marl and fine-grained sand."@en ;
    lexicon:hasLowerBoundaryDefinition "Usually a coarse shelly oolite, resting (locally with angular discordance) on fine, evenly graded oolite of the Todber Freestone (where present), or on clay and sandy clay of the Newton Clay."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:S710 ,
        namedrockunit:TCLB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
