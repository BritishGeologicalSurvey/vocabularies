namedrockunit:KSDC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey to black laminated thin- to thick- bedded blocky cherts with interbedded shaly siliceous mudstones and a few partly silicified limestones. Scattered chert nodules occur within the limestones."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of abundant blocky chert with few limestones of the Kersdown Chert Member above the siliceous radiolarian shaly mudstones with some silicified limestones forming the lower part (Hayne Beech Beds) of the Bampton Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2883 ,
        namedrockunit:H2884 ,
        namedrockunit:H3866 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
