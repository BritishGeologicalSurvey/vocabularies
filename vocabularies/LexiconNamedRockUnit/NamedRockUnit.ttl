namedrockunit:LCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red plastic clay, typically laminated, with laminae of very fine-grained micaceous sand, locally with rhythmic, 2-3cm-thick cyclopels, thin beds of interlaminated fine- and medium-grained sand, sparse boulders and discoid calcareous concretions towards the base. Becoming more interbedded with sand inland. AMS radiocarbon dates of 17,065 and 17,720 ka BP on marine microfauna reported by McCabe et al (2007)."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp conformable contact with gravel recorded by Rice (1960) at the former Anniston Brickworks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BCY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 11m proved"@en ;
    lexicon:hasUpperBoundaryDefinition "Apparently sharp, unconformable contact at no higher than 23m OD with overlying glaciofluvial gravel of the Drumlithie Sand and Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Brick clay"@en ;
    skos:broader namedrockunit:ERRCL ;
    skos:definition "Clay with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LCL"@en ;
    skos:prefLabel "Lunan Clay Member"@en ;
.

