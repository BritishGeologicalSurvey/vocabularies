    lexicon:hasLithologyDescription """[Obsolete: use ALY, HA, MRD, SAL] \r
\r
(Potteries Coalfield only). Sandstone and mudstone, predominantly red, brown and purple; minor grey strata; some thin limestones. Mudstones more variegated, and sandstones more lithic and micaceous, than in the overlyinging Radwood Formation. NOTE: Originally called Keele Sandstone Series - see Gibson, 1899, p.122-129. Boundaries are redefined here because the base in the type area is diachronous; the Sidway Mill Borehole(SJ 73 NE/3) provides a reference section)."""@en ;
    lexicon:hasLowerBoundaryDefinition "(Potteries Coalfield only). Taken at lowest red or purple beds overlying grey Newcastle Formation. This boundary varies relative to named sandstones, and is noticeably diachronous."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1620 ,
        namedrockunit:H1947 ,
        namedrockunit:H341 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "200-350m."@en ;
    lexicon:hasUpperBoundaryDefinition "(Potteries Coalfield only). Gradation up into Radwood Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    lexicon:isObsoleteEquivalentOf
