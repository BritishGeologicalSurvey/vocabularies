namedrockunit:EYL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thinly bedded, dark grey, cherty, bioclastic limestone with fossiliferous beds of brachiopods, corals and crinoids and a few dark mudstone intercalations, which is overlain by massive pale reef limestone in the south. The reef facies occur at the base in the central and southern parts, and in the upper part in the north, and is typically a core of massive biomicrite with a distinctive brachiopod fauna, passing laterally and downward into well-bedded, coarsely crinoidal biomicrites and biosparites."@en ;
    lexicon:hasLowerBoundaryDefinition "Dark grey to grey brown basal limestone, resting upon clay or mudstone partings of the Eyam Limestone Formation, on a potholed surface above pale to medium grey limestone of the Monsal Dale Limestone Formation. Around Ashford-in-the-Water [SK 19 69], where both formations are dark grey, the boundary is taken at the top of the laminated beds of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CW ,
        namedrockunit:CWDL ,
        namedrockunit:EMGP ,
        namedrockunit:H4036 ,
        namedrockunit:H900 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At Eyam Dale, 54 m thick including 30 m of reef facies; at  Wardlow Mires No 2 borehole, it is 9.18 m, and contains no reef facies."@en ;
    lexicon:hasUpperBoundaryDefinition "A gradational top, marked by a transition from dark grey, bioclastic limestone or pale grey massive reef limestone of the Eyam Limestone, to dark grey, calcareous mudstone of the Widmerpool Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ashford Beds [Obsolete: use EYL]"@en ,
        "Cawdor Group [Obsolete: use BSG, EYL]"@en ,
        "Cawdor Limestone [Obsolete: use EYL]"@en ,
        "Eyam Group [Obsolete: use EYL]"@en ,
        "Eyam Limestones Formation [Obsolete: use EYL]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Limestone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:EYLF ,
        namedrockunit:EYLK ;
    skos:notation "EYL"@en ;
    skos:prefLabel "Eyam Limestone Formation"@en ;
.

namedrockunit:FEND
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Formation encompasses the marine, estuarine and terrestial deposits that were formed in the Fens and adjacent areas during the Holocene and previous interglacial periods. The complex includes fresh and brackish water peats, salt marsh clays, fluvial silts and fine-grained sands, marine sands, and beach-face sands and gravels. In centre of the Fen Basin, five stratigraphical units are present. In ascending order these are basal sand and gravel, the Fen Lower Peat, Barroway Drove Beds, Nordelph Peat and Terrington Beds. Barroway Drove Beds comprise intertidal soft grey clays and silty clays cut by tidal channels and creeks infilled with silt and fine-grained sand. Terrington Beds comprise marine and brackish water silts and fine-grained sands. Marine sands and gravels marginal to the Fen Basin are the Woodstone Member (silty clays and fine sands), the March Gravel Member (sandy gravel to clayey pebbly sand) and the Abbey Sand and Gravel Member (clayey, sandy gravels)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable of glacial deposits and upon Jurassic and Cretaceous bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasOldestAgeValue 4.23e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Peat, sand and silt with subsidiary clay and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Hoxnian Stage - to - Holocene Epoch (Quaternary Period) (.423-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ABSG ,
        namedrockunit:BYD ,
        namedrockunit:CRWB ,
        namedrockunit:FLPT ,
        namedrockunit:MRCG ,
        namedrockunit:NP ,
        namedrockunit:TTB ;
    skos:notation "FEND"@en ;
    skos:prefLabel "Fenland Formation"@en ;
.

