        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use BSG] Dark grey and grey mudstones with subordinate bands of limestone, ironstone, siliceous sandstone and siltstone, and calcareous siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Incoming of Cravenoceras leion, or where limestone bands decrease markedly upwards in a mudstone sequence."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1397 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Varies greatly, 0 at basin margin, 240m in type area, 370m in Alport Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of lowest significant feldspathic sandstone (Mam Tor Sandstones in type area)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BSG ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Bowland Shale Formation"@en ,
        "Edale Shales [Obsolete: use BSG, ESH]"@en ;
    skos:definition "Obsolete name. Mudstone with subsidiary ironstone, limestone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Namurian Stage (Carboniferous Period) (330.3-319 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ESH"@en ;
    skos:prefLabel "Edale Shale Group [Obsolete: use BSG]"@en ;
.

namedrockunit:ESHTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S645 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pinkish brown, very stiff, pebbly sandy silty clay diamicton containing clasts of local sandstone, mudstone, coal and dolerite, far travelled sedimentary, igneous and metamorphic rocks and shell fragments, including sparse paired valves of marine molluscs yielding Late Devensian amino acid ratios. (Described as being similar to the shelly lodgement tills of Ayrshire, but probably a deformation till)."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable, planar to gently undulating contact with dark brown, laminated organic silt and clay of the Sourlie Organic Silt Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1530 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 3.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, convex-up, undulose unconformity with overlying dark grey silty sandy stony clay diamicton of the Auchenwinsey Till Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eglinton Member"@en ,
        "Unit E [Obsolete: use ESHTI]"@en ;
    skos:broader namedrockunit:WITI ;
    skos:definition "Gravel with subsidiary clay and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ESHTI"@en ;
    skos:prefLabel "Eglinton Shelly Till Member"@en ;
.

