    skos:broader namedrockunit:SWAS ;
    skos:definition "Conglomerate with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Ludlow Epoch (Silurian Period) - to - Early Devonian Epoch (Devonian Period) (426.7-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ISP"@en ;
    skos:prefLabel "Isle Port Conglomerate Member"@en ;
