namedrockunit:CNCL
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lithologically varied dolostone with calcite concretions formed by a variety of primary and secondary sedimentary processes. Interpreted as the basin slope deposit of the Roker Formation (see Smith, 1994, fig.46 on page 94)."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational, by interdigitation with the underlying Hartlepool Anhydrite Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H149 ,
        namedrockunit:H2105 ,
        namedrockunit:UML ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to a maximum of about 95 - 100m."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the overlying Forden Evaporite Formation, marked by the incoming of anhydrite and halite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
