namedrockunit:WISG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A suite of glacial, glaciofluvial and glaciolacustrine deposits that contain clasts derived predominantly from Lewisian rocks of the Western Isles, including sandy diamictons (till), sand, gravel, silt and clay. Deposited by ice that mainly radiated outwards from an ice divide positioned along the western seaboard of the Western Isles archipelago."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with bedrock or planar unconformity with units of the Western Isles (Albion) Glacigenic Subgroup."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or unconformable contact with various Flandrian deposits, predominantly peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CALI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LEWTI ,
        namedrockunit:PBTI ;
    skos:notation "WISG"@en ;
    skos:prefLabel "Western Isles Glacigenic Subgroup"@en ;
.

namedrockunit:WLSS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glauconitic, clayey sandstone and shell beds containing layers of siliceous concretions. Very locally developed thin shelly limestones. Coral-rich bed at base, locally replaced by coarse gravel. Bands of quartz gravel are locally developed."@en ;
    lexicon:hasLowerBoundaryDefinition "The contact with the underlying Telegraph Hill Sands Member, marked by the upward facies-change from finer-grained, clay-free sandstone (Telegraph Hill Sands) to coarser, less well-sorted, clay-rich sandstone (Woodlands Sands). A coral-rich horizon (Haldon Coral Bed) generally marks this boundary. Where the Telegraph Hill Sands are absent, the Woodlands Sands Member unconformably overlies Devonian and Carboniferous strata, and a coarse gravel marks the basal part of the Woodlands Sands Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1299 ,
        namedrockunit:H4417 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4.14m."@en ;
    lexicon:hasUpperBoundaryDefinition "Contact with the overlying Ashcombe Gravels Member, marked by the upward facies-change to interbedded sandstone and gravel."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Haldon Sands Formation [Obsolete: use ACGR, CUSC, UGSD, WLSS]"@en ,
        "Haldon Sands [Obsolete: use UGSD, ACGR, CUSC, THSS, WLSS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Glauconitic sandstone with subsidiary muddy sandstone and sandstone and trace shelly limestone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WLSS"@en ;
    skos:prefLabel "Woodlands Sands Member"@en ;
.

namedrockunit:WNR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
