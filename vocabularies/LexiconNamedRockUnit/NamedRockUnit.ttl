namedrockunit:CHUD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin bedded cherts and siliceous mudstones, black mudstones and limestones passing up into thick-bedded to massive sandstones with subordinate conglomerate and mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Chudleigh area the lower boundary is taken at the incoming of black sooty and siliceous mudstones of the Chudleigh Group (Winstow Chert Formation) above the purple, green and grey mudstones of the underlying Tamar Group (Whiteway Mudstone Formation). The contact is generally sharp. In the Plymouth area it is taken at the incoming of dark grey cherts and siliceous mudstones of the Chudleigh Group (Winstow Chert Formation) above the mid grey silty mudstones of the Tamar Group (Saltash Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3928 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Not known but probanly about 550m+"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at an angular unconformity where fine-grained glauconitic sandstone of the Upper Greensand Formation rests upon thick-bedded to massive, locally pebbly to conglomeratic sandstone of the Ugbrooke Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Culm [Obsolete: use CHUD, CU]"@en ;
    skos:broader namedrockunit:CU ;
    skos:definition "Sandstone with subsidiary chert, conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Namurian Stage (Carboniferous Period) (359.3-319 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:UGST ,
        namedrockunit:WCH ;
    skos:notation "CHUD"@en ;
    skos:prefLabel "Chudleigh Group"@en ;
