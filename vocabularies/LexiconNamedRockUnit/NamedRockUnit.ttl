namedrockunit:WRAB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ASH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRSD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Wrabness Member comprises tuffaceous clayey silts and silty clays, with both disseminated ash and numerous distinct tephra layers (Unit A), overlain with apparent disconformity by bioturbated fine-grained silty sand with clay interbeds (Unit B). There is a concentration of glauconite in sandy clayey silt at the base of Unit A (Jolley, 1996; King, in prep.). Layers of concretionary argillaceous limestone occur at several levels, including the tabular Harwich Stone Band (HARS), which is about 0.25 m thick and which includes a central ash bed (Elliott, 1971; Jolley, 1996; King, 1981, in prep.; Knox and Ellison, 1979). The occurrence and correlation of the ash in the Wrabness Member is described by Knox (1983, 1996b) and Knox and Morton (1988). \r
\r
Occurrences at Walton-on-the-Naze have yielded an extensive assemblage of fossil birds (George and Vincent, 1977; Harrison, 1983; Harrison and Walker, 1977). \r
\r
Marine: inner to mid shelf. \r
\r
Early Eocene (early Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Wrabness Member, which rests on the silts and sands of the Orwell Member, is marked by a sharply-defined discontinuity surface and a basal concentration of glauconite."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HWM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to about 24 m (King, in prep.)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Wrabness Member is marked by the disconformable base of the Walton Member mudstones, which contain sporadic well-rounded flint gravel (Jolley, 1996). According to King (1981, p.25), the Walton Member has much less glauconite and much less bioturbation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Harwich Member [Obsolete: use WRAB]"@en ;
    skos:broader namedrockunit:HWH ;
    skos:definition "Clayey silt and silty clay with subsidiary ash, limestone, pyroclastic-sediment and silty sand. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:HARS ;
    skos:notation "WRAB"@en ;
    skos:prefLabel "Wrabness Member"@en ;
.

