namedrockunit:MALC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A fine- and coarse-grained, cobbly, poorly sorted, matrix supported conglomerate, with clasts of vein quartz, quartzite and some igneous lithologies, coarsening north-eastwards, and clast supported around Beinn Dearg."@en ;
    lexicon:hasLowerBoundaryDefinition "A transitional contact with the siltstone facies of the undivided Cromlix Mudstone Formation, especially in the lower part where interbeds of siltstone, sandstone and conglomerate show a diffuse boundary."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 120m at Beinn Dearg [NN 589 038]. 50 m near Malling, thinning south-westwards to about 15 m at Carse of Shannochill [NS 5385 9850], and to just 1m in Kelty Water [NS 4973 9504]."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp contact with the siltstone facies of the undivided Cromlix Mudstone Formation, which is commonly seen as a pronounced topographical feature."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CXF ;
    skos:definition "Conglomerate with subsidiary pebbly (gravelly) sandstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MALC"@en ;
    skos:prefLabel "Malling Conglomerate Member"@en ;
.

