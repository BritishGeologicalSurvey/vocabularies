    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to tens of metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or unconformable contact with units of the Caledonia Glacigenic Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "West Cumbria Drift Group [Obsolete: use ISCAG, ISCG]"@en ;
    skos:broader namedrockunit:ALBI ;
    skos:definition "Clay, diamicton, gravel, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
