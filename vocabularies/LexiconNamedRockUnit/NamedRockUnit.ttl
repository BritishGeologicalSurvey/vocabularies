    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "30m at type section in southwest Pembrokeshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at sharp junction between the dark limestones, cherts and mudstones of the Formation and the overlying thick-bedded coarsely crinoidal limestones of the Hobbyhorse Bay Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Linney Head Beds [Obsolete: use LHD]"@en ;
