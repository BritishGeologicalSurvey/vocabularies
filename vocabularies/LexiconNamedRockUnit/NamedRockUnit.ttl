namedrockunit:ASLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:MINO ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Grey and brown variously shelly, ooidal, sandy, shell-detrital and bioturbated limestones; rubbly in parts, with a median peloidal ooid-grainstone unit (Notgrove Member) well developed in places, and minor sandy and shell-detrital calcareous mudstone beds. The formation includes a bored hardground on top of the Notgrove Member. \r
\r
Shallow marine carbonate shelf. Mainly low energy conditions with carbonate mud deposition and terrigenous sediment influx, and a profuse shelly epifaunal biota. Higher energy conditions at times depositing coarser carbonate grains (ooids). \r
\r
Discites Zone to Sauzei Zone."""@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformity: upward change from ooidal and peloidal limestone (Scottsquar Member: Birdlip Limestone Formation) or sand, mudstone and sandy limestone (Harford Member: Birdlip Limestone Formation) - the Bajocian Unconformity, into grey and brown variously shelly, ooidal, sandy, shell-detrital and bioturbated limestones. The basal beds commonly contain pebbles derived from the underlying rocks. Generally a hardground."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1958 ,
        namedrockunit:MINO ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Type section up to about 6.45 m. Maximum c.22 m (Cleeve Hill area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformity, generally a hardground: grey and brown variously shelly, ooidal, sandy, shell-detrital and bioturbated limestones overlain by members of the Salperton Limestone Formation, i.e. very shelly and coarsely shell-detrital ooidal grainstone and packstone (Upper Trigonia Grit Member, where present) or rubbly, fine- to coarse-grained ooidal, peloidal and finely shell-detrital packstone to grainstone (Clypeus Grit Member) - the Vesulian Unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hartley Hill Formation [Obsolete: use ASLS]"@en ,
        "Middle Inferior Oolite [Obsolete: use ASLS]"@en ;
    skos:broader namedrockunit:INO ;
    skos:definition "Limestone with subsidiary calcareous mudstone and trace sandstone and sandy limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GRGR ,
        namedrockunit:LTG ,
        namedrockunit:NGRV ,
        namedrockunit:ROBA ;
    skos:notation "ASLS"@en ;
    skos:prefLabel "Aston Limestone Formation"@en ;
.

