namedrockunit:WN
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Presumed fine- or medium-grained sands with minor clay laminations (1 x 0.66 metres core sample only in British Sector). Mainly structureless in seismic profiles, but in some sections gently-dipping reflectors prograde westwards onto erosional base. Unconformably overlain by unit with chaotic reflector configuration, overlies eastward-prograding (Smith's Knoll Formation) or westward-prograding beds (Ijmuiden Ground Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Widespread unconformities. Overlies early Pleistocene Prodelta Beds, overlain by Yarmouth Roads Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS062> ;
    lexicon:hasOldestAgeValue 1.8e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 130 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Widespread unconformities. Overlies early Pleistocene Prodelta Beds, overlain by Yarmouth Roads Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS022> ;
    lexicon:hasYoungestAgeValue 8.7e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNSG ;
    skos:definition "Sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 62 - to - Marine Isotope Stage 22 (Quaternary Period) (1.8-.87 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WN"@en ;
    skos:prefLabel "Winterton Shoal Formation"@en ;
.

