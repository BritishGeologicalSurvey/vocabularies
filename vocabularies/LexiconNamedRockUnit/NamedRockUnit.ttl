    skos:broader namedrockunit:LI ;
    skos:definition "Sandy mudstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PABS"@en ;
    skos:prefLabel "Pabay Shale Formation"@en ;
