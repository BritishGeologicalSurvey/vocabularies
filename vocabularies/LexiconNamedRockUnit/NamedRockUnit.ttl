namedrockunit:WEGN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, variably gneissose, commonly garnetiferous, biotite rich. Minor schistose pelite, with staurolite or kyanite. Layers of calc-silicate rock and marble occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "lower contact is formed by the Westing Ultramafic Zone, but stratigraphically likely overlying the Kirkaby Gneiss Formation (KIGN)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasUpperBoundaryDefinition "Likely overlain by Westing Limestone Formation (WELS)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WEGP ;
    skos:definition "Psammite with subsidiary calcsilicate-rock and pelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SNAP ;
    skos:notation "WEGN"@en ;
    skos:prefLabel "Westing Gneiss Formation"@en ;
.

namedrockunit:WEH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cyclical sequence of red-brown mudstones and purple-red-brown sandstones (latter from c.25 - 30% of the beds). Lack of calcretes except in transitional highest beds and many more sandstones distinguishes the member from the overlying Raglan Mudstone. The underlying Downton Castle Sandstone consists of yellow-brown sandstones and thin grey to brown siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed. Probably rapidly transitional."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LEB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.200 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed. Slowly transitional."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ledbury Beds [Obsolete: use WEH]"@en ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Silurian Period (443.1-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "WEH"@en ;
    skos:prefLabel "Wellington Heath Member"@en ;
