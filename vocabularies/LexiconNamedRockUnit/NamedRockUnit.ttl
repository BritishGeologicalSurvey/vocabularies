        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly carbonate mudstones, but with significant grainstones, locally cross-bedded, and oolites in upper part; ranges from peritidal to marine. Extensively dolomitized."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed. Taken where limestone becomes dominant over shale (Rose and Dunham, 1977, p.28). In practice, taken in boreholes at first significant shale parting, beds below there being assigned to `Basement Beds', now renamed `Low Furness Basal Formation'."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0-135m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of \"Red Hill Oolite\", now redefined as the Red Hill Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Calcareous mudstone with subsidiary dolomitic limestone, dolostone, limestone and ooid-limestone and trace mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Chadian Substage (Carboniferous Period) (359.3-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MTL"@en ;
    skos:prefLabel "Martin Limestone Formation"@en ;
.

namedrockunit:MTON
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
