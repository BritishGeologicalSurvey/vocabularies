namedrockunit:LVS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A medium to thickly bedded, grey, medium-to coarse-grained, cross-bedded sandstone with beds of grey siltstone and a lingula band in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp upward change in a comformable succession from predominatly grey mudstone to sandstone, at the base of the first sandstone above the Cancelloceras cumbriense (G1b1) Marine Band."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasOldestAgeValue 3.2e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 10 - 25 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp upward change in a conformable succession from sandstone to predomantly mudstone to top of the last sandstone below the subcrenatum Marine Band (where recognised) or below the Winkesley Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
