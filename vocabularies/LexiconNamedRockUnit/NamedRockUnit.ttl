namedrockunit:SCLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A typically fine grained, chocolate-brown, massive and highly amygdaloidal olivine basalt, with imperfect pillow structures and red oolitic limestone fragments in all stages of alteration and assimilation, which in places appear to occupy spaces between pillows.  In the centre of the member, cindery lava is mixed with broken limestone fragments.  Calcite veins are common throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is irregular and channelled up to 1.2 m into the underlying limestone of the High Tor Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "15 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp boundary forms the upper boundary between basalt and overlying reddish-fawn, dolomitised limestone of the High Tor Limestone Formation, containing tuffaceous debris in the bottom 1.5m, decreasing upwards from the base."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HTL ;
    skos:definition "Basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCLA"@en ;
    skos:prefLabel "Spring Cove Lava Member"@en ;
.

