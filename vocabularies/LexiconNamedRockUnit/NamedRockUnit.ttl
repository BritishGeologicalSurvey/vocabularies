    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by mudstones of the Millstone Grit Group, whoch crop out to the south and west of the volcanic neck."@en ;
