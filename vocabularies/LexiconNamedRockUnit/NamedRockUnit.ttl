namedrockunit:RIRM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Composite deposit: 'Raised Intertidal Deposits': variable lithology - gravel through to clay, may be rich in organic matter; from the intertidal coastal zone, but now above the level of the present shoreline as a result in earth movement or a general fall in sea level. 'Raised Marine Deposits': also a variable lithology - gravel (shingle), sand, silt and clay; commonly charged with organic debris (plant and shell) now above the level of the present shoreline as a result of earth movement or a general fall in sea level. [Generic description]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
