namedrockunit:LMKL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Packstones, floatstones, grainstones, Waulsortian limestone, limestone-mudstone lithoclast breccias and boulder beds, thin to thick-bedded, interbedded with mudstones, some of which are lithoclastic. Laminated, erosive-based, graded beds occur at the type locality. Crinoidal debris is very conspicuous."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is not seen at the type locality. Taken at the base of the succession of lithoclast breccias and boulder beds, packstones, floatstones, grainstones resting unconformably upon mainly pale grey packstones, wackestones and floatstones of the Clitheroe Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1034 ,
        namedrockunit:H3532 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
