namedrockunit:DBST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DIAMIT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDIAMT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower part: Calcareous diamictite with dominantly calcareous clasts. Central part: Schistose and feldspathic psammite and quartzite (discontinuous). Upper part: Quartz-rich diamictite with dominantly granite and quartzite clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradation from biotite calc-pelite to calcareous diamictite over 10m."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DBBT ,
        namedrockunit:H1484 ,
        namedrockunit:H201 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 250m in Sheet 55W"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp contact between quartzose diamictite and thinly-bedded quartzite. However, 10 - 20m bed of reworked granite diamictite occurs near base of Schiehallion Quartzite Formation on Cnoc nan Aighean."@en ;
