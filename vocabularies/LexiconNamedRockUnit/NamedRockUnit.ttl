namedrockunit:BROM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to brown, coarse-grained, poorly sorted, conglomeratic sandstone with mudstone clasts. In some areas it is dominantly medium- to coarse-grained, often carbonate-cemented sandstone with carbonaceous streaks. Cross-bedding locally occurs. Sandy mudstone units with burrows, including Arenicolites, and ferruginous, and oolitic sandstones occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "The Broom/Drake formational boundary is characterised by a gradational downward change from medium- to coarse-grained sandstones to mudstones. There is a down-section increase in gamma-ray values."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5178 ,
        namedrockunit:H5179 ,
        namedrockunit:H5180 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downward change from very fine- to fine-grained sandstone (Rannoch Formation) to coarse grained or pebbly sandstone (Broom Formation). Where the Rannoch mudstone unit is present at the base of the unit, there is a down-section change from micaceous mudstones to coarse-grained sandstones. In some areas where Broom-like and Rannoch-type facies are interbedded, the top is taken at the top of the highest coarse-grained or pebbly sandstones. The upper boundary is always marked by a  down-section decrease in gamma values."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basal Sand Bed [Obsolete: use BROM]"@en ,
        "Basal Sand [Obsolete: use BROM]"@en ,
        "Broom Sub-Unit [Obsolete: use BROM]"@en ;
    skos:broader namedrockunit:BRNT ;
    skos:definition "Sandstone and trace mudstone. Stratified bedrock. Occurs offshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BROM"@en ;
    skos:prefLabel "Broom Formation"@en ;
.

namedrockunit:BRR
    a skos:Concept ;
