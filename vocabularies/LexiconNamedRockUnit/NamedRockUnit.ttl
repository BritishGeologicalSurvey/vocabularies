namedrockunit:UELB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Olive-grey, well-bedded, shaly and flaggy sandy and calcareous siltstones, with prominent hard flaggy calcareous bands. The latter distinguish this formation from the underlying beds. \r
\r
The fauna, like that of the Middle Elton Formation (MELB), is predominantly pelagic, with graptolites (essentially a monospecific fauna of Pristiograptus tumescens (Wood), not as diverse as that in the Middle Elton Formation, indicating the Pristiograptus tumescens/Saetograptus incipiens Biozone) and orthocones, accompanied by rare small brachiopods (Holland et al., 1963; Lawson and White, 1989)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The contact with the underlying Middle Elton Formation (MELB) is transitional."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1889 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated thickness of between 45 and 75 m (Holland et al., 1963; Lawson and White, 1989)."@en ;
    lexicon:hasUpperBoundaryDefinition "The overlying Lower Bringewood Formation (LBN) is distinguished from the Upper Elton Formation by its more irregular bedding and more homogeneous lithology."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasYoungestAgeValue 4.25e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Elton Beds [Obsolete: use UELB]"@en ;
    skos:broader namedrockunit:LLUS ;
    skos:definition "Calcareous siltstone. Stratified bedrock. Occurs onshore. Deposited during the Gorstian Age (Silurian Period) (426.7-425 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UELB"@en ;
    skos:prefLabel "Upper Elton Formation"@en ;
.

