    skos:definition "Obsolete name. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PBL"@en ;
    skos:prefLabel "Penmaen Burrows Limestone Formation [Obsolete: use BRL, BHL, FPL]"@en ;
.

namedrockunit:PBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mylor Slate Formation lithofacies (dark grey slate with pale siltstone laminae of variable spacing with some grading where the laminae are wider, thin beds of siltstone and fine sandstone and grey-green slate interbedded with siltstone or fine sandstone) as the matrix to a variably framework or matrix-supported breccia deposit. The clasts, of varying sizes up to 2 m in length, are of Portscatho Formation lithofacies - clasts include sandstone, siltstone, mudstone and trachyte."@en ;
    lexicon:hasLowerBoundaryDefinition "Thrust contact; Porthleven Breccia Member is in the footwall of the Carrick Thrust, with Portscatho Formation rocks structurally above. This contact would be identified in the field by an abrupt transition from the dark slate matrix and varied clasts of the Breccia Member (described above) to the sandstone turbidites with interbedded grey slate of the Portscatho Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H407 ,
        namedrockunit:MRSR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Less than 3300 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable and gradational with the lower part of the Mylor Slate Formation. Transitional relationship from dark grey, locally grey-green slates, interbedded thin bands and laminae of sandstone, basic lavas and sedimentary breccias to the overyling framework and matrix supported breccias with coarse sandstone clasts and grey slate matrix (as described above)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Mylor Series [Obsolete: use MRSL, PBR]"@en ,
        "Mylor Slates [Obsolete: use MRSL, PBR]"@en ;
    skos:broader namedrockunit:MRSL ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone and trace trachyte. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PBR"@en ;
    skos:prefLabel "Porthleven Breccia Member"@en ;
.

