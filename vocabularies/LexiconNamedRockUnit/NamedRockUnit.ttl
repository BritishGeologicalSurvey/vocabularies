    lexicon:hasThicknessDescription "Unknown"@en ;
    lexicon:hasUpperBoundaryDefinition "Boundary with overlying Macduff Formation, where the more semipelitic and pelitic lithologies give way to more psammitic lithologies with grits and conglomerates. Imprecise boundary, probably transgressive."@en ;
