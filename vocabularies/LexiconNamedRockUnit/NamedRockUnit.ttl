namedrockunit:SPBK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Member comprises rhythmically bedded white and pink limestones and grey or red marls or calcareous clays. The colouration of the argillaceous beds is paler in the lower part, but reddening becomes darker up-sequence. The limestones become harder upwards and the clays become marly and nodular."@en ;
    lexicon:hasLowerBoundaryDefinition "The boundary is placed at a change from marly limestone and seams of limestone of the Queens Rock Member into rhythmically bedded limestones, marls and clays."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3.49m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is placed at the change from alternating white and pink limestones and clays up into nodular limestones (Dulcey Dock Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HUCK ;
    skos:definition "Calcareous mudstone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SPBK"@en ;
    skos:prefLabel "Speeton Beck Member"@en ;
.

namedrockunit:SPBU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
