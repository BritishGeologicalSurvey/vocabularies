namedrockunit:COSCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clayey silt and clay, commonly rooty and structureless; highly laminated with silt and very fine- to medium-, locally coarse-grained sand; grey, black and brownish grey, finely micaceous, dark sulphidic patches, shells and shell fragments, vivianite grains. These are deposits of an estuarine tidal flat complex formed just before and during highest Holocene sea-level (Main Post-Glacial Shoreline)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, on the sub-Carse Peat (Flanders Moss Peat Formation) and older Holocene and late Devensian units including the Letham Silt Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H803 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to perhaps as much as 15m"@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary partly unconformable with transgressing Claret Clay Member (Carse Clay Formation) and unconformably overlain by surface peats; commonly at surface partly because of peat clearances from the 18th century onwards. It also passes laterally into the peat bodies of East and West Flanders Mosses."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carse Clay [Obsolete: use COGW, COSCL]"@en ;
    skos:broader namedrockunit:CARCL ;
    skos:definition "Clay and silt with subsidiary sand and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COSCL"@en ;
    skos:prefLabel "Carse of Stirling Clay Member"@en ;
.

