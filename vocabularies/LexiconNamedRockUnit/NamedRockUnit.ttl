    skos:altLabel
        "Bowland Shale Formation"@en ,
        "Bowland Shale, Lower [Obsolete: use LBS]"@en ;
    skos:definition "Obsolete name. Mudstone with subsidiary limestone and sandstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LBS"@en ;
    skos:prefLabel "Lower Bowland Shale Formation [Obsolete: use BSG]"@en ;
