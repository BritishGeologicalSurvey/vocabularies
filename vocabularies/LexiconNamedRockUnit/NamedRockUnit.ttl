    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRCS"@en ;
    skos:prefLabel "Bryncroes Formation"@en ;
.

namedrockunit:BRCT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The dominant lithology is planar and trough cross-bedded, irregularly bedded and structureless red-brown sandstones. Subordinate lithologies are conglomerates composed of subrounded to angular clasts. Extraformational clasts include quartz, quartzite, limestone, chert and tuff; intraformational clasts include mudstone, siltstone and sandstone. There are subordinate beds of grey-green mudstone and siltstone. The sequence shows repeated fining-upward cycles, from conglomerate to mudstone; the siltstone and mudstone components of these are commonly absent. Sedimentary structures include ripple marks, flute casts, slump structures and convolute bedding. Micaceous bedding planes are common. A solitary fish spine was recorded from the member (Wills, 1970)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the lowest conglomerate resting on soft red sandstones of the Wildmoor Sandstone Member of the Wilmslow Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickest known sequence is 192.4 m, in the Sugarbrook No.3 Borehole, but the base has not been proved."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the top of the highest bed of extraformational conglomerate, above which are sandstones and mudstones of the overlying Finstall Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRCT"@en ;
    skos:prefLabel "Burcot Member"@en ;
.

