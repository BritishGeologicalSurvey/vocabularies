namedrockunit:UGCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A typically reddish brown, but locally dark grey, black, brown and yellowish brown,  laminated clay, silt and fine-grained sand, with localised black organic laminae formed of reworked Jurassic material."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp, undulating, draped, unconformable contact with the gravelly clayey sand diamictons (tills) of the East Grampian Glacigenic Subgroup, but locally a sharp, undulating, draped, unconformable contact with deposits of glaciofluvial gravel with erect pebbles at the top, probably formed in a periglacial environment."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2515 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp, undulating, draped, erosional and unconformable contact with glaciofluvial or alluvial sand and gravel. Locally the boundary is seen as a sharp, planar, unconformable glacitectonic contact with red clayey diamictons (deformation tills, glaci- tectonites) of the  Logie-Buchan Glacigenic Subgroup towards the North Sea coast."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Red Series clays or glaciolacustrine deposits [Obsolete: use UGCL]"@en ;
    skos:broader namedrockunit:LBD ;
    skos:definition "Clay and silt with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:TSCL ;
    skos:notation "UGCL"@en ;
    skos:prefLabel "Ugie Clay Formation"@en ;
.

namedrockunit:UGST
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thick-bedded massive, grey, medium-to coarse-grained, locally pebbly and conglomeratic sandstones with impersistent thick units of pebble-cobble conglomerate, argillaceous sandstone and dark grey mudstones with thin sandstones and siltstones. Pebbly mudstones are also present. Conglomerate clasts include chert and granite."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the incoming of dark grey and greenish grey mudstones with thin siltstones and fine- to coarse-grained sandstones of the Ugbrooke Sandstone Formation above the thin-bedded cherts, shales and limestones of the underlying Winstow Chert Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1890 ,
        namedrockunit:H589 ;
