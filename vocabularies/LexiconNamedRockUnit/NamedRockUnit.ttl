namedrockunit:OCKS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ockran Sandstone Formation consists of medium to coarse grained, variably argillaceous, bioclastic sandstone grading to sandy limestone towards the base. The bioclastic debris includes bivalves, gastropods and, most distinctively, bryozoans. Wireline-log character indicates that the formation is consistently sandy and well bedded. Calcite-cemented beds are represented by high-velocity spikes, these are especially abundant in the lower part of the 205/26a-2 section, in which the calcareous sandstone grades into sandy limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Ockran Sandstone Formation is defined by a downward change from bioclastic sandstone or sandy bioclastic limestone to calcareous mudstone. It is marked by a sharp downward increase in gamma-ray values and decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GD> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "It reaches a maximum recorded thickness of 260 m in well 205/26a-2."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Ockran Sandstone Formation is defined by a sharp downward change from calcareous mudstone to sandstone, and by an accompanying downward decrease in gamma-ray values."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GD> ;
    lexicon:hasYoungestAgeValue 6.17e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STLN ;
    skos:definition "Limestone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Danian Age (Palaeogene Period) (66-61.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OCKS"@en ;
    skos:prefLabel "Ockran Sandstone Formation"@en ;
.

