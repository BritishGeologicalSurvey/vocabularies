        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MSLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use KHSA] \r
\r
Thin-bedded and laminated sandstone, interpreted as distal turbidites."""@en ;
