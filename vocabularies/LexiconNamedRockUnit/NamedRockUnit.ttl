namedrockunit:FL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold phase sands and gravels that underlie the Freeland Terrace. Dominated by clasts of "Bunter" quartz/quartzite, typically with sporadic ironstone and rare flint, in a sandy loam matrix. Limestone clasts are generally rare probably because of pervasive decalcification. Near Oxford [SP515 014] [probable] equivalents [probably] overlie the organic Sugworth Beds, thought from palaeontology to be "Cromerian" (MIS 13+). \r
\r
River terrace deposits. Mid Pleistocene (MI Stage 12)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Jurassic bedrock or (locally near head of River Evenlode) on Quaternary Wolston Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GSG ,
        namedrockunit:H253 ,
        namedrockunit:H254 ,
        namedrockunit:H2803 ,
        namedrockunit:H3405 ,
        namedrockunit:H4044 ,
        namedrockunit:NDR ,
        namedrockunit:SGUO ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 4 m, typically <2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Freeland Member [Obsolete: use FL]"@en ,
        "Freeland Terrace Deposits [Obsolete: use FL]"@en ,
        "Glacial sand and gravel [Obsolete]"@en ,
        "Northern Drift Formation [Obsolete: use FL, SBRY]"@en ,
        "Northern Drift [Obsolete: use FL]"@en ,
        "Plateau Drift [Obsolete: use FL]"@en ,
        "Sand and gravel of unknown origin [Obsolete: use SGAO]"@en ,
        "Unbedded drift [Obsolete: use FL]"@en ;
    skos:broader namedrockunit:UTMS ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FL"@en ;
    skos:prefLabel "Freeland Sand and Gravel Member"@en ;
