        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, grey, bedded, calcareous, shell detrital, with subordinate fine grained, shell detrital and ooidal limestone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp change up from fine-grained limestone of the Tresham Rock Formation, locally (seen in Biddestone borehole) a non-sequence with a hardground, or massive ooid-limestone of the Athelstan Oolite Formation (where present) into mudstone of Lansdown Clay."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 10 m. 3.9 m in Biddestone borehole (ST87SE 1) [ST 8609 7282]."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp change up from mudstone of Lansdown Clay into ooid-limestone or coarse-grained shelly ooidal limestone ('Grickstone Beds'), locally with limestone pebbles, of Chalfield Oolite Formation. May be a non-sequence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Fuller's Earth Member"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Calcareous mudstone with subsidiary ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LDN"@en ;
    skos:prefLabel "Lansdown Clay Formation"@en ;
