namedrockunit:SPR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANDTFF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded coarse-grained pebbly volcaniclastic sandstone, planar bedded and cross-bedded.  Includes units of banded andesitic tuff (pyroclastic fall-out deposits) and a succession of silicic tuff and lapilli-tuff (pyroclastic fall-out and density current deposits (the Glaramara Tuff).  The facies associated separates this from the underlying Cockley Pike Member"@en ;
    lexicon:hasLowerBoundaryDefinition "The gradational base is taken at the first appearance of pyroclastic rocks in the sandstone succession"@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4899 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 70m"@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the base of the overlying silicic pyroclastic rocks of the Lincomb Tarns Formation.  The contact varies from conformable and with angular discordance"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sprinkling Tarn Member [Obsolete: use SPR]"@en ;
    skos:broader namedrockunit:SET ;
    skos:definition "Volcaniclastic-sandstone with subsidiary andesitic tuff and dacitic tuff and trace pyroclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:GMT ;
    skos:notation "SPR"@en ;
    skos:prefLabel "Sprinkling Tarn Sandstone Member"@en ;
.

namedrockunit:SPRK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLateralEquivalent namedrockunit:BUS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSSDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, greenish grey, silty, sandy, dolomitic, well indurated; nodules of celestite (strontium sulphate) common, especially towards top."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at abrupt or near abrupt upward change from the reddish brown mudstone of the Mercia Mudstone Group (undivided) to the greenish grey dolomitic sandy mudstone of the Stoke Park Rock Bed."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3043 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasOldestAgeValue 2.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.5 to 2m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at gradational upward transition from greenish grey mudstone with celestite of the Stoke Park Rock Bed to reddish brown and greenish grey mottled mudstone of the Mercia Mudstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Butcombe Sandstone Member [Obsolete: use AS]"@en ,
        "Severnside Evaporite Bed [Obsolete: use SPRK]"@en ;
    skos:broader namedrockunit:MMG ;
    skos:definition "Dolomitic silicate-mudstone and dolomitic silicate-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Carnian Age (Triassic Period) (237-227.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SPRK"@en ;
    skos:prefLabel "Stoke Park Rock Bed"@en ;
