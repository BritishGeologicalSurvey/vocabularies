    lexicon:hasThicknessDescription "Approximately 85m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of coarse-grained Nottage Crag Grit above siltstones and fine-grained sandstones of the Barncroft Beck Beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
