    lexicon:hasThicknessDescription "100-200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of abundant black slate with chert (at base of Borfrishlie Slate Formation); contact may be tectonic."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Achray Sandstone [Obsolete: use LADG]"@en ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Sandstone with subsidiary slate and trace metamudstone and metasandstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) - to - Comley Series (Cambrian Period) (635-508 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LADG"@en ;
    skos:prefLabel "Loch Ard Grit Formation"@en ;
