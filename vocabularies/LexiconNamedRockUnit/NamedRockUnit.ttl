namedrockunit:UTG
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very hard poorly but thickly bedded grey and brown very shelly shell-detrital and moderately ooidal grainstone and packstone; characteristic fauna includes trigoniid bivalves, commonly as moulds, and brachiopods."@en ;
    lexicon:hasLowerBoundaryDefinition "Hardground capping various members of Aston Limestone or Birdlip Limestone formations, or correlative disconformity on Lias Group, overlain by limestone as in lithological description."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3109 ,
        namedrockunit:H595 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 1 to 2.5m. Type section; 1.05 to 1.2m. Maximum c.5m (Colesbourne area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change from limestone as in lithological description, to fine- to coarse-grained ooidal, peloidal/pisoidal and shell-detrital packstone to grainstone (Clypeus Grit Member); commonly a non-sequence marked by a hardground."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Trigonia Grit [Obsolete: use UTG]"@en ,
        "Upper Trigonia Grit [Obsolete: use UTG]"@en ;
    skos:broader namedrockunit:SALS ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UTG"@en ;
    skos:prefLabel "Upper Trigonia Grit Member"@en ;
.

