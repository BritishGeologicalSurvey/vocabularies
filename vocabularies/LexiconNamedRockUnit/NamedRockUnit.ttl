namedrockunit:NABS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mottled brownish yellow, yellowish brown, brown and grey silty, sporadically clayey fine to coarse sand. Characteristically poorly sorted and locally laminated. Grains dominated by quartz with sporadic plagioclase feldspar. Commonly shows a fining upwards sequence from lower boundary with underlying laminated clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Commonly sharply erosive, and characterised by a thin (<10mm) bed of coarse sand with rare gravel directly overlying mottled reddish brown and grey stiff laminated clay of the Hemingbrough Glaciolacustrine Formation"@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:SDVY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Varies from <0.5m to 2.5m at Naburn flood alleviation pit [SE 59840 45280]."@en ;
    lexicon:hasUpperBoundaryDefinition "This unit is typically exposed at surface, or the upper boundary is represented by a gradational contact with fine-grained aeolian sand of the Sutton Sand Formation. This unit is inferred to thin and pinch out eastwards to the west of Elvington."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sands of 25-Foot Drift of Vale of York [Obsolete: use BIES, BREI, NABS, SKIS]"@en ;
    skos:broader namedrockunit:BREI ;
    skos:definition "Sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NABS"@en ;
    skos:prefLabel "Naburn Sand Member"@en ;
.

namedrockunit:NACL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Nar Clay Formation consists of finely laminated marine clays, silts and silty clays, and peat of the Nar Valley Freshwater Peat Beds. Brickpits have yielded a rich fauna of well preserved bivalves and gastropods, foraminiferida, ostracods and diatoms. The clay has also yielded the bones and teeth of mammals."@en ;
    lexicon:hasLowerBoundaryDefinition "Clays of the Nar Clay Formation overlie freshwater peat of the Nar Valley Freshwater Beds (NVFB) (which are included in the formation), and oversteps onto a variety of older rocks with marked unconformity. At East Winch the base of the clay is marked by a shell bed composed almost entirely of the oyster Ostrea edulis."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasOldestAgeValue 4.23e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Nar Clay Formation is present at surface. It is locally overlain unconformably by the Tottenhill Sand and Gravel Formation (Briton's Lane Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasYoungestAgeValue 3.62e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Hoxnian Stage (Quaternary Period) (.423-.362 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:NVFB ;
    skos:notation "NACL"@en ;
    skos:prefLabel "Nar Clay Formation"@en ;
.

namedrockunit:NBED
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SV"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravelly sand with local occurrences of fine-grained organic material. The gravel fraction (bedload sediment) is dominated by flint of local origin, with only a trace of chert from the Weald and far-travelled quartzose rocks from west of the London basin."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:PBGR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
