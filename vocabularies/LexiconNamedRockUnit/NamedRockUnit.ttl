namedrockunit:RDSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S691 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glaciofluvial sediments that are associated with the Holkham Till Member in the area around Heacham, Ringstead, Hunstanton and Holkham. Landforms associated with meltwater deposition include the Hunstanton Esker in Old Hunstanton Park [TF 206 940]. Mainly sand and flint gravel, locally with chalk clasts. Also typically contains a minor component of igneous clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "The Ringstead Sand and Gravel Member rests unconformably on the Holkham Till Member and a variety of Cretaceous formations. In places it can be difficult or impossible to distinguish the Ringstead Sand and Gravel from the sand and gravel of the older Sheringham Cliffs Formation in adjacent outcrops."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Of very variable thickness, generally less than 5 m, but potentially greater in the Hunstanton Esker."@en ;
    lexicon:hasUpperBoundaryDefinition "The Ringstead Sand and Gravel Member is overlain by the Holkham Till Member and Head, and silt and clay of the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ringstead Sand And Gravel"@en ;
    skos:broader namedrockunit:HOLD ;
    skos:definition "Gravel and sand with subsidiary silt. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RDSG"@en ;
    skos:prefLabel "Ringstead Sand and Gravel Member"@en ;
.

