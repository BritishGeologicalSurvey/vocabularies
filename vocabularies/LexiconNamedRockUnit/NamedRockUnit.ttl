namedrockunit:LBSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDSH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very poorly sorted accumulations of shells and shell fragments, with sporadic pebbles, set in a very soft, dark greyish brown (2.5Y 4/2), muddy sandy matrix. Shell concentrations dominated by Chlamys islandica and Arctica islandica, with subordinate Tridonta elliptica."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the Assynt Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.64-0.68 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "In outer Loch Broom, it is unconformably overlain by the Summer Isles Formation; in the inner loch, it is overlain by the Rhiroy Member of the Assynt Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Shell sediment (shells). Stratified superficial deposits. Occurs offshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "LBSH"@en ;
    skos:prefLabel "Loch Broom Shell Bed"@en ;
