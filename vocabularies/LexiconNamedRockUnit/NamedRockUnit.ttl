    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5.28m."@en ;
    lexicon:hasUpperBoundaryDefinition "Contact with the overlying Cullum Sands-with-Cherts Member, marked by the upward facies change from coarse-grained sandstones and gravels (Ashcombe Gravels Member) to sandstones containing chert horizons (Cullum Sands-with-Cherts Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Haldon Sands Formation [Obsolete: use ACGR, CUSC, UGSD, WLSS]"@en ,
        "Haldon Sands [Obsolete: use UGSD, ACGR, CUSC, THSS, WLSS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Sandstone and sandy gravel and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age - to - Cenomanian Age (Cretaceous Period) (113.2-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ACGR"@en ;
    skos:prefLabel "Ashcombe Gravel Member"@en ;
