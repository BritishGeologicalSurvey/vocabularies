    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Bowhills Member [Obsolete: use BWH]"@en ,
        "Enville Member"@en ;
    skos:definition "Obsolete name. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage (Carboniferous Period) (310-307.5 Ma BP)."@en ;
