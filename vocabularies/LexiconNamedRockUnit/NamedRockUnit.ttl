    skos:altLabel "Coventry Sandstone [Obsolete: use CYS, ASY]"@en ;
    skos:broader namedrockunit:SAL ;
    skos:definition "Mudstone and sandstone and trace conglomerate and limestone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
