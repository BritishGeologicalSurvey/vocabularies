namedrockunit:WLWS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Woolwich Sands comprise cross-bedded or bioturbated fine- to coarse-grained sand and silty sand, locally with a low-diversity fossil mollusc fauna. \r
\r
Marginal marine. \r
\r
Early Eocene (earliest Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "At Lower Upnor, the Woolwich Sands overlies the Lower Shelly Beds, probably on an erosion surface (Kennedy and Sellwood, 1970). Further east at Canterbury it comprises the entire Woolwich Formation and rests on the Upnor Formation (Gamble, 1972) (King, in prep.)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to about 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Woolwich Sands is a sharply defined erosive contact at the base of the overlying fine-grained glauconitic sands of the Oldhaven Member (Harwich Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WL ;
    skos:definition "Sand and silty sand. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WLWS"@en ;
    skos:prefLabel "Woolwich Sands"@en ;
