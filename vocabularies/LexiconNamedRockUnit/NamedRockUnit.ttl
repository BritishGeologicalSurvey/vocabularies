    skos:altLabel "Tillybrachty Sandstones [Obsolete: use TIS]"@en ;
    skos:broader namedrockunit:RHN ;
    skos:definition "Sandstone with subsidiary conglomerate and lava and trace basaltic-andesite. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TIS"@en ;
    skos:prefLabel "Tillybrachty Sandstone Formation"@en ;
