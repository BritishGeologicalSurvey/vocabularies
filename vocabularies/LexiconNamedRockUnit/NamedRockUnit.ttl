namedrockunit:CROM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly blocky grey to dark grey laminated and fossiliferous mudstone, which becomes fissile on weathering. The mudstone contains siderite mudstone lenses and nodules at some levels. There are several thin marine bands composed of dark grey, platy mudstone with scattered oblate carbonate septarian nodules. Thin beds of sandstone are present and notably common in the uppermost few metres."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp basal boundary placed at the change from the sandstone-dominated Silver Hills Sandstone to the overlying mudstone-dominated Crossdale Mudstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2117 ,
        namedrockunit:H3332 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "14 to 23m in Crossdale; estimated 165m in Dolphinholme area."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upper boundary placed at the change from the mudstone-dominated Crossdale Mudstone overlain by the Accerhill Sandstone, a thickly bedded sandstone-dominated succession."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CH> ;
    lexicon:hasYoungestAgeValue 3.23e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crossdale Mudstone Formation [Obsolete: use SILS, CROM]"@en ,
        "Crossdale Shales [Obsolete: use CROM]"@en ;
    skos:broader namedrockunit:MG ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage - to - Chokierian Substage (Carboniferous Period) (327-323 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CROM"@en ;
    skos:prefLabel "Crossdale Mudstone"@en ;
.

namedrockunit:CRPT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
