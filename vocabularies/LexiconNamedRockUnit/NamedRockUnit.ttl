namedrockunit:TCSM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine- to medium-grained sandstones without \"exotic\" pebbles, thick-bedded. Abundant cross-bedding and convolute, soft-sediment deformation structures. Detrital heavy minerals of silt to fine-grained sand grade common."@en ;
    lexicon:hasLowerBoundaryDefinition "Base: (eg NM 3769 9147 or NG 3360 0247) : marked by the disappearance of 'exotic' pebbles characteristic of the Applecross Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3074 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
