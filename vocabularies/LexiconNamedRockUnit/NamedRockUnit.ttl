    lexicon:hasThicknessDescription "To 90 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the sharp contact of the finely banded dark to pale grey mudstones with thin siltstones of the overlying Trambley Cove Formation with the tuffs, lavas and agglomerates of the Tintagel Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
