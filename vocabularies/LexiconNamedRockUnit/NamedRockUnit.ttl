namedrockunit:PHS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, laminated mudstones, finely micaceous, silty and calcareous, interbedded with dark grey,  laminated, blocky and calcareous siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type locality and also in the Whitewell Anticline, the dark grey mudstones rest conformably upon crinoidal packstones of the Clitheroe Limestone Formation. Elsewhere, the mudstones are underlain conformably by lithoclast breccias and boulder beds, packstones, floatstones and grainstones of the Limekiln Wood Limestone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H450 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 350 m, with the thickest development in the Plantation Farm Anticline."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Slaidburn and Whitewell anticlines the dark grey mudstones are overlain conformably by pale blue-grey wackestones and packstones of the Whitemore Limestone Member. Elsewhere, the mudstones are overlain by non-micaceous, laminated mudstones interbedded with laminated calcisiltites of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Phynis Shales [Obsolete: use PHS]"@en ;
    skos:broader namedrockunit:HOM ;
    skos:definition "Mudstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PHS"@en ;
    skos:prefLabel "Phynis Mudstone Member"@en ;
.

