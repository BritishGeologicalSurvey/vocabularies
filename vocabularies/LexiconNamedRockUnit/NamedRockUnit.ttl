namedrockunit:BAINV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fluvial terrace deposits of the River Bain. Mainly sand, gravel and mud; divided (in type area) into two principal \"terrace\" members (Thorpe and Castle) plus alluvium (Bain Member of Bowen, 1999), and an older (late Anglian) terrace (Martin/Tattershall Airfield of Bowen, 1999), plus local named organic deposits. Includes contemporaneous head, colluvium and soil deposits. Gravel dominated by flint and chalk pebbles, and other Jurassic/Cretaceous material derived mainly from glacial deposits of the Anglian Lowestoft Formation, plus an additional component of Upper Jurassic and Cretaceous material from the bedrock of the catchment."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base on Anglian glacial deposits or on pre-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WIVY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c. 8m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Witham Valley Formation [Obsolete: use BAINV, TRVA]"@en ;
    skos:broader namedrockunit:TRWCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CASSG ,
        namedrockunit:THSG ;
    skos:notation "BAINV"@en ;
    skos:prefLabel "Bain Valley Formation"@en ;
.

namedrockunit:BAKS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The group comprises interbedded sandstones, siltstones and mudstones of the Statfjord Formation, which are overlain by sandstones of the Nansen Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by the base of the Statfjord Formation. Where that formation is absent (e.g. East Shetland Basin), the arenaceous Nansen Formation rests on Triassic red, argillaceous strata (Cormorant Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5176 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasOldestAgeValue 2.057e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 360 m in the East Shetland Basin and up to 155 m in the Beryl Embayment."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by the top of the Nansen Fomation, which is placed at a downward change from mudstones of the Dunlin Group (Amundsen or Darwin formations) to sandstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Statfjord Group [Obsolete: use BAKS]"@en ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Rhaetian Age (Triassic Period) - to - Sinemurian Age (Jurassic Period) (205.7-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:NANN ,
        namedrockunit:STAT ;
    skos:notation "BAKS"@en ;
    skos:prefLabel "Banks Group"@en ;
.

