        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLAM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CVB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly glacial till (sandy clay, clayey sand and clay with gravel and boulders) with interbedded sand, gravel and laminated clay, plus more substantial areas of those individual lithologies incorporated in the till sheet and moraines."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock or older superficial deposits such as valley deposits, outwash deposits and laminated clays formed in front to the advancing glacier."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1257 ,
        namedrockunit:H1258 ,
        namedrockunit:H1901 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
