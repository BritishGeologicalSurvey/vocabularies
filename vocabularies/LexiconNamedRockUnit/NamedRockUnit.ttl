namedrockunit:WHISA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Whiting Sandstone Unit consists of white to grey or grey to brown or occasionally green, very fine- to medium-grained, well-sorted, poorly cemented, partly laminated, micromicaceous sandstones with interbedded mudstones, silty mudstones and minor amounts of limestones. The mudstones and silty mudstones are grey to dark grey, green or red to brown, moderately firm, partly calcareous and carbonaceous."@en ;
    lexicon:hasLowerBoundaryDefinition "In the West Shetland Basin, the Whiting Sandstone Unit (e.g. 206/10a-l) and the Dab Limestone Unit (e.g. 206/8-4) rest unconformably on the Clair Group and Victory Formation, respectively."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasUpperBoundaryDefinition "On wireline logs, the top of the unit is represented by a sudden downward decrease in gamma-ray log values and an increase in velocity as Kyrre Formation mudstones grade to Whiting Sandstone Unit sandstones, siltstones and limestones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KO> ;
    lexicon:hasYoungestAgeValue 8.57e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KYRE ;
    skos:definition "Sandstone with subsidiary mudstone and trace limestone. Stratified bedrock. Occurs offshore. Deposited during the Turonian Age - to - Coniacian Age (Cretaceous Period) (93.9-85.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WHISA"@en ;
    skos:prefLabel "Whiting Sandstone Unit"@en ;
.

