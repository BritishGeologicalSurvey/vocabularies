namedrockunit:STBT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pebbly silty clay diamicton, calcareous, very still, massive, matrix-supported; dark greyish brown. It contains well dispersed subangular to rounded pebbles of red sandstone, white and yellow Coal Measure sandstones, coal, greywacke, slate, limestone and Borrowdale Volcanic Group rocks. It is typically thinly interlaminated with dark yellowish orange silt towards its base; locally a dense, thickly interlaminated bed (<3m thick) of fine-grained sand and silt (showing ripple-drift lamination) occurs at the base of the Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally conformable contact (but with evidence of glacitectonic shearing) on the St Bees Sand and Gravel Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3430 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3.0m thick at its Type Section, 2.0m thick at its Reference Section."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational contact with the base of the overlying Gutterfoot Sand Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "St Bees Till [Obsolete: use GFSA, STBT]"@en ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Diamicton with subsidiary gravel, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STBT"@en ;
    skos:prefLabel "St Bees Till Member"@en ;
.

namedrockunit:STCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Marl-free, soft chalk with large irregular flints."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable at a marly bed with included marl, above which the chalk is marl-free in the Alum Bay/Scratchell's Bay section on the Isle of Wight and at \"the lower horizon of yellow-stained chalk on Old Harry Rock\" in Studland Bay, Dorset (Gale et al., 1987). It is not discernible from the published literature whether these two beds are in the same stratigraphical position. This doubt, together with the lack of exposure and geomorphological expression of the member, has led to the BGS reverting to the original concept of the Portsdown Chalk Member (Bristow, Mortimore and Wood, 1997). This is also the position stated in Rawson, Allen and Gale (2001) and thus the Portsdown Chalk Formation covers all of the chalk up to the sub-Palaeogene erosion surface."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4902 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 23 m preserved beneath the sub-Palaeogene unconformity in Alum Bay on the Isle of Wight."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is the sub-Palaeogene unconformity in the Southern Province. Relationship to the Upper Campanian and Maastrichtian chalks of the northeast \"Transitional\" Province is poorly understood due to poor exposure."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Studland Chalk [Obsolete: use STCK]"@en ;
    skos:broader namedrockunit:PCK ;
    skos:definition "Chalk with subsidiary flint. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STCK"@en ;
    skos:prefLabel "Studland Chalk Member"@en ;
.

