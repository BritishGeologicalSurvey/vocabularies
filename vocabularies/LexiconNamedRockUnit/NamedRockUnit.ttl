    lexicon:hasThicknessDescription "Up to 27 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is generally a non-sequence displaying a sharp change upward from bioclastic limestone to cream or grey shelly or ooidal limestone or calcareous mudstone of the Inferior Oolite, elsewhere it may be conformable, displaying a change up into sandy mudstone of undivided Bridport Sand Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
