namedrockunit:THS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A grey to yellow, locally bioturbated massive parallel or cross-bedded fine-grained, patchily iron-cemented but otherwise friable sandstone with plant debris, rootlets and thin lignite lenses, with thinly bedded and laminated locally sphaerosideritic and pyritic sandstone, siltstone and mudstone, seatearths and thin coals, which may include a median unit of marine fossiliferous calcareous mudstone or siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Passage up from the ooidal limestone-dominated succession of  the Lincolnshire Limestone Formation into a predominantly sand-dominated, generally non-calcareous succession, which in places comprises a dark sooty mudstone, accentuated in the weathered zone by the development of a secondary limonitic bed at the base, known as the 'Ironstone Junction Bed' which lies at the base of the Thorncroft Sand, although elsewhere, there may be up to 2 m of interdigitated ooidal limestone and sandstone strata, or indications of a non-sequence, such as limestone pebbles or oxidation of the top of the Lincolnshire Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2484 ,
        namedrockunit:H4370 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up 18 m or more thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp often rootleted contact with the mudstone-dominated upper part of the Rutland Formation described as the Priestland Clay Member of Gaunt et al, 1992."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Sandy Beds [Obsolete: use THS]"@en ,
        "Thorncroft Sands Member [Obsolete: use THS]"@en ;
    skos:broader namedrockunit:RLD ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THS"@en ;
    skos:prefLabel "Thorncroft Sand Member"@en ;
.

