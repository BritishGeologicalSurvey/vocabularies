    lexicon:hasThicknessDescription "18m"@en ;
    lexicon:hasUpperBoundaryDefinition "No overlying unit on Rum."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MODS ;
    skos:definition "Calcareous sandstone and sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
