    skos:altLabel "Raasay Sandstone Member [Obsolete: use DAFS]"@en ;
    skos:broader namedrockunit:BEAS ;
    skos:definition "Limestone and sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age - to - Bajocian Age (Jurassic Period) (184.2-168.2 Ma BP)."@en ;
