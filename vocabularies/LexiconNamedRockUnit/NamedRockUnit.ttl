namedrockunit:NARC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Nar Valley Formation encompasses the fluvial, lacustrine, organic and marine deposits of the Nar River and its tributaries. Floodplain alluvium comprises soft clay, silts and fine sands, with bodies of peat, overlying sands and gravels. River terrace deposits (Wormegay Member, Pentney Member and Marham Member of Lewis, 1999) comprise sands, gravelly sands and gravels, with the pebbles dominantly of angular to sub-rounded flint, and Chalk. Marine deposits (\"Nar Valley Clay\") comprise blue-grey finely laminated shelly silty clays; the underlying Nar Valley Freshwater Bed comprises grey fine-grained silty sands and silts and a compressed wood peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Mid Pleistocene glacial deposits, and on bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:NV ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Nar Valley Clay [Obsolete: use NARC]"@en ;
    skos:broader namedrockunit:ONCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WGAY ;
    skos:notation "NARC"@en ;
    skos:prefLabel "Nar Valley Formation"@en ;
.

namedrockunit:NCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
