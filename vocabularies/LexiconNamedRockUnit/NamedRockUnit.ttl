namedrockunit:DKT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALTF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Weakly bedded and cross-bedded lapilli-tuff and tuff of basaltic/basaltic andesite composition; locally intruded by penecontemporaneous sills; pyroclasts include abundant Skiddaw Group mudstone and sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies Skiddaw Group in type area where it is the lowest Member of the Birker Fell Andesite Formation (and of the BVG). On Latterbarrow overlies the Latterbarrow Sandstone, where the base of the Devoke Water Tuff Member is taken at the bed of lapilli-tuff overlying sandstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3362 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "550 - 620m; complete thickness unknown because of faulting."@en ;
    lexicon:hasUpperBoundaryDefinition "At change to basaltic/basaltic andesite flows of Birkby Fell Member, or to overlying andesite sheets of Birker Fell Andesite Formation (undivided)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Devoke Water Member [Obsolete: use DKT]"@en ;
    skos:broader namedrockunit:BFA ;
    skos:definition "Basaltic lapilli-tuff and basaltic tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DKT"@en ;
    skos:prefLabel "Devoke Water Tuff Member"@en ;
