namedrockunit:LOLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Knoll reef limestones comprising highly fossiliferous, massive, pale, fine-grained, recrytallised and locally dolomitised limestones with abundant calcite-lined former cavities with internal geopetal sediment (stromatactis). Contains a rich brachiopod and goniatite fauna. During the time of late Asbian carbonate platform development in North Wales a series of knoll reefs formed along, and serve to define, the platform margin. The knoll reef facies interdigitate with platformal facies on one side, and resedimented basinal facies of the Craven Group on the other."@en ;
    lexicon:hasLowerBoundaryDefinition "Entry of massive \"reef\" limestones above well-bedded Loggerheads Limestone Formation; also passes laterally into Loggerheads Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4168 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, but was probably overlain unconformably by red beds of the late Westphalian Warwickshire Group, or by Permo - Triassic strata (? Kinnerton Sandstone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Knoll Reef Limestones [Obsolete: use LOLS]"@en ;
    skos:broader namedrockunit:LGHL ;
    skos:definition "Limestone with subsidiary dolostone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LOLS"@en ;
    skos:prefLabel "Little Orme Limestone Member"@en ;
.

namedrockunit:LONFN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:LOFN ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises dark grey-brown finely laminated fissile mudstone ('paper shale') with interbedded ooidal limestone. Brackish water faunas, including bivalves, conchostracans, gastropods and ostracods are present. Desiccation cracks, indicating emergence, are present in the uppermost beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the Kildonnan Member (KILDN)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "As for parent formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lonfearn Member [Duplicate: use LONFN]"@en ;
    skos:broader namedrockunit:LASH ;
    skos:definition "Mudstone with subsidiary ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LONFN"@en ;
    skos:prefLabel "Lonfearn Member"@en ;
.

namedrockunit:LOOR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Well 26/14-1, in the Forth Approaches Basin, encountered a complete, 70 m thick Lower Devonian section comprising pink, red, grey and green, fine to coarse grained, poorly sorted sandstone with beds of greenish grey, micaceous shale and reddish brown calcareous mudstone. Nearby well 26/12-1 terminated after penetrating 24 m of weathered olivine-basalts and reddish brown mudstones. Similar volcanic sequences in the Scottish Midland Valley are mainly Gedinnian in age (Gatliff, 1994). \r
\r
The steeply dipping Lower Devonian section drilled in well 20/9-1, in the South Halibut Basin, comprises reddish grey, greenish grey, pink and white siltstones, with sporadic thin beds of reddish brown mudstone and fine or very fine grained sandstone."""@en ;
    lexicon:hasLowerBoundaryDefinition "In well 26/14-1, which lies along strike from the Southern Uplands of Scotland, the Lower Old Red Group rests on steeply dipping Lower Paleozoic turbidites. The base of the Devonian has not been penetrated in the South Halibut Basin."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Lower Devonian sediments are up to 9000 m thick along the northern flank of the Midland Valley of Scotland (Mykura, 1991), but it is unlikely that they are so thick offshore."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Lower Old Red Sandstone is an angular unconformity throughout Scotland (Mykura, 1991), except at the centre of the Orcadian Basin where there is a conformable transition to Middle Old Red Sandstone. In the Forth Approaches and South Halibut basins, Lower Devonian sediments generally subcrop Permian strata. However, in well 26/12-1, Upper Silurian or Lower Devonian volcanics are unconformably overlain by Upper Devonian strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone, sandstone and siltstone with subsidiary olivine-basalt. Stratified bedrock. Occurs offshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:STIE ;
    skos:notation "LOOR"@en ;
    skos:prefLabel "Lower Old Red Group"@en ;
.

