    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 55m in the type section (King, 1981, in prep.)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Sheppey Member is marked by a change upwards from silty clay with common sandy clayey silt interbeds, to silty clay with sandy laminae, of the Claygate Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
