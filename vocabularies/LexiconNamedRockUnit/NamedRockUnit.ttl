namedrockunit:BRHI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QWACKE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation's basal unit is the Swithland Camp Member, composed of purple siltstones and conglomerates. The upper part of the formation is composed of the Stable Pit Member of quartz-arenites and wackes, locally burrowed and cross-bedded."@en ;
    lexicon:hasLowerBoundaryDefinition "Lies unconformably on the late Neoproterozoic Hanging Rocks Formation (formerly the Hanging Rocks Conglomerate Member), latter comprising small-pebble conglomerates fining up to grey/purple volcaniclastic siltstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasOldestAgeValue 5.26e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable gradational passage upwards to grey slaty mudstones of the Swithland Formation, believed to be Lower Cambrian in age (e.g. McIlroy, et al, 1998)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CBA ;
    skos:definition "Muddy sandstone and quartz-wacke with subsidiary conglomerate and quartz-arenite and trace mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CBSP ;
    skos:notation "BRHI"@en ;
    skos:prefLabel "Brand Hills Formation"@en ;
