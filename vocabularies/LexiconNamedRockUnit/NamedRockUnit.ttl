        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A reddish grey, fine- to medium-grained, commonly cross-bedded sandstone, interbedded with siltstone and chocolate brown to brick red, silty mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "A gradational contact with the Dalmary Sandstone Member of the Teith Sandstone Formation, which is generally greenish grey and commonly contains plant remains."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H94 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 400 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is not seen, as it is faulted against and unconformably overlain by the basal conglomerate and sandstones of the Stockiemuir Sandstone Formation, of the Upper Devonian, Stratheden Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Purple Sandstone Facies [Obsolete: use BUCS]"@en ;
