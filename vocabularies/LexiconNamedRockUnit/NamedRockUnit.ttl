namedrockunit:INVN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/L"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithology is angular to subrounded boulders, cobbles, gravel and pebbles in a clayey sand matrix. The clasts appear to have had barnacles growing on them although no in-situ examples were retrieved. The formation also contains intact, faded, life-coloured shells of the scallop Chlamys islandica. The shells are not significantly abraded."@en ;
    lexicon:hasLowerBoundaryDefinition "The Inverleven Gravel Member of the Clyde Clay Formation rests with angular unconformity on older Quaternary sediments or on bedrock. Most comonly it rests on the Paisley Clay Member of the Clyde Clay Formation or on the Wilderness Till Formation (WITI) of the Caledonia Glacigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1613 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Interleven Gravel Member of the Clyde Clay Formation is overlain conformably or disconformably by younger Quaternary sediments, commonly either the Balloch Clay Member of the Clyde Clay Formation or the Clydebank Clay Formation of the British Coastal Deposits Group. It is not exposed at the surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Inverleven Formation [Obsolete: use INVN]"@en ;
    skos:broader namedrockunit:CLYD ;
    skos:definition "Boulders and gravel with subsidiary clay, clayey sand, cobbles, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "INVN"@en ;
    skos:prefLabel "Inverleven Gravel Member"@en ;
.

