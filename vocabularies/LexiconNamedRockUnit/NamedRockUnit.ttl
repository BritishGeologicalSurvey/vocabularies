namedrockunit:PKSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly interbedded sand, sandy silt, pebbly silty sandy clay, diamicton and gravel, typically red-brown in colour. The member typically drapes older glacial and glaciofluvial deposits, and thickens into hollows and kettleholes in their surface. Synsedimentary small-scale normal faulting and collapse structures are common within the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on older-Quaternary deposits, including the more thickly bedded Gutterfoot Sand and Gravel Member of the Gosforth Glacigenic Formation (in the St Bees Moraine), the coarse-grained, cross-bedded Peel Place Sand and Gravel Member of the Gosforth Glacigenic Formation, at Seascale, and the Fishgarth Wood Till Member of the Gosforth Glacigenic Formation, at Ravenglass."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4662 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically between 1.0 and 3.0m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Holocene deposits such as peat and blown sand."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Boulder Clay [Obsolete: use FWTI, GOGL, HMTI, PKSA, PLBT, RSTI, STPTG]"@en ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Clay, sand and silt with subsidiary diamicton and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PKSA"@en ;
    skos:prefLabel "Peckmill Sand Member"@en ;
.

