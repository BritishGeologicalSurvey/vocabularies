    lexicon:hasLithologyDescription "[Obsolete: use CHES] Sandstone, fine- to coarse-grained, commonly pebbly, with conglomerates and sporadic siltstones; cross-stratified."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of sequence dominated by sandstones containing pebbles and conglomerates; pebbles do not have a local derivation. Conformable on the Kinnerton Formation or unconformable on Palaeozoic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BNP ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "<90m - >220m"@en ;
    lexicon:hasUpperBoundaryDefinition "Transition at base of Wilmslow Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CHES ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Bunter Pebble Beds [Obsolete: use CHES, CPB, KDM, NTC, PLWF]"@en ,
        "Chester Formation"@en ;
    skos:definition "Obsolete name. Pebbly (gravelly) sandstone and sandstone with subsidiary conglomerate and trace siltstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CPB"@en ;
    skos:prefLabel "Chester Pebble Beds Formation [Obsolete: use CHES]"@en ;
.

