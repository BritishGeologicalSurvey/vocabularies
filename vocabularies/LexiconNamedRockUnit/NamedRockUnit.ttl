namedrockunit:PE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarsening upwards sequence of sand and gravel deposits, frequently with shell fragments. Distal parts of the (coastal) deposit are frequently finer grained. Underlain by a stiff to hard clay and overlain by fine, reworked. Holocene sand in some places."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies clay of the Tampen or Norwegian Trench Formations with a marked unconformity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasOldestAgeValue 2.4e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40 metres. Thins and coarsens to north and northwest, on North Sea Plateau. Thins and fines to south east and east in deeper waters in the Norwegian Trench."@en ;
    lexicon:hasUpperBoundaryDefinition "Underlies thin Holocene sand sedimentation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:REAP ;
    skos:definition "Gravel and sand with subsidiary shelly sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 2 (Quaternary Period) (.024-.0139 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PE"@en ;
    skos:prefLabel "Plateau Edge Formation"@en ;
