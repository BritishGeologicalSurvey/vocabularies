    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lune Valley Formation"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay, sand and silt with subsidiary gravel and peat. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
