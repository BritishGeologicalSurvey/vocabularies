namedrockunit:SB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly green and green-grey (locally red-brown and purplish green), very fine to medium-grained, micaceous sandstones, mainly channelised, cross-bedded and parallel-laminated, with green and red-brown siltstone and mudstone interbeds, some calcretes and intraformational conglomerates; characterised by the presence of vascular fossil plant remains."@en ;
    lexicon:hasLowerBoundaryDefinition "In Black Mountains, at base of green sandstones, which overlie cyclic red-brown sandstones and mudstones of the underlying St Maughans Formation. Where mature calcretes at the top of the St Maughans Formation are present (the Ffynnon Limestones), the base of the formation is placed at the top of the uppermost calcrete."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CFO ,
        namedrockunit:H2409 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasOldestAgeValue 4.124e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "300 to 450 m in the Brecon Beacons and Black Mountain, 150 to 200 m in the Black Mountains."@en ;
    lexicon:hasUpperBoundaryDefinition "In Black Mountains, where red sandstones of the Brownstones Formation overlie the green sandstones of the Senni Beds Formation, the junction being gradational."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clee Sandstone Formation [Obsolete: use SB]"@en ,
        "Senni Beds [Obsolete: use SB]"@en ;
    skos:broader namedrockunit:COB ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace calcrete. Stratified bedrock. Occurs onshore. Deposited during the Pragian Age - to - Emsian Age (Devonian Period) (412.4-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SB"@en ;
    skos:prefLabel "Senni Formation"@en ;
.

