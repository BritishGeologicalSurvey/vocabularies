namedrockunit:BOYL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin-bedded metalimestone, semipelite calc-silicate rock. Old Hythe Limestone Member: finely interbedded semipelite and psammite with lenses of quartzite and white cream metalimestone. Boyne Castle Limestone Member: thin-bedded metalimestone, 200m thick, with minor calc-silicate rock; shows abundant minor folding. Whyntie Brae Limestone Member: calc-silicate rock, laminated and striped, passing upward into semipelite with minor thin metalimestone and lenses of reworked carbonate material."@en ;
    lexicon:hasLowerBoundaryDefinition "First white limestone at the west side of Old Hythe Bay."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DBBO ,
        namedrockunit:H717 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
