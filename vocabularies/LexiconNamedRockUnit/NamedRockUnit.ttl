namedrockunit:EASN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDSH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Partly cemented, well sorted gravel and sand containing marine shells. The gravel is composed predominantly of limestone and dolostone of the Zechstein Group (formerly Magnesian Limestone) towards the base, with an increasing content upwards of Carboniferous rock types. Cheviot andesite, Borrowdale Volcanic Group rock types and dolerite. Also including sparse halleflinta, rhomb-porphyry and garnet-hornblende schist of supposed Scandinavian affinity. Twelve temperate genera of marine mollusc have been identified from the deposit, and borings by marine molluscs and annelid worms in the rock platform as well as in cobbles confirm that the deposit is in situ."@en ;
    lexicon:hasLowerBoundaryDefinition "The beach gravel rests on a bevelled, subhorizontal platform, bored by marine molluscs, cut into limestones and dolostones of the Zechstein Group (formerly Magnesian Limestone) at about 30m above sea level."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2163 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Thought to be a planar horizontal or undulating unconformable contact with dark grey diamicton of the Blackhall Till Formation, but contact is obscured and inaccessible."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Easington Formation [Obsolete: use EASN]"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Gravel with subsidiary sand and trace shell sediment (shells). Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Ipswichian Stage (Quaternary Period) (.48-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EASN"@en ;
    skos:prefLabel "Easington Raised Beach Formation"@en ;
.

namedrockunit:EBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A red breccia containing clasts from 30 - 100mm in diameter, in a silty sandy matrix, with cross-bedded and planar-bedded sandstone sets up to 3m thick. Breccia clasts include sandstone, slate and quartz porphry."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies and interdigitates with the Dawlish Sandstone Formation, which is essentially a red sandstone in  planar- or cross-bedded units with sparse pebble seams."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2165 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "85m"@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformable with the overlying Exmouth Mudstone and Sandstone Formation, which comprises predominantly thick units of red-brown mudstone with sporadic sandstone beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Exe Breccia [Obsolete: use EBR]"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Breccia and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EBR"@en ;
    skos:prefLabel "Exe Breccia Formation"@en ;
.

