    lexicon:hasThicknessDescription "c. 700 m: Lower unit: c. 0-165 m; Upper Unit c. 500 m (minimum)."@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed - eroded."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
