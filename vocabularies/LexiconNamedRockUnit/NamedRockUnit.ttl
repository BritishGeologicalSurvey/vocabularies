namedrockunit:MVG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Suite of glacial, glaciofluvial and glaciolacustrine deposits including sand diamictons (till), sand, gravel, silt and clay. The sediments were deposited by or are the deglaciation products of ice that eminated from the western Grampian Highlands and streamed generally eastwards across the Midland Valley of Scotland. The deposits contain clasts derived predominantly from Carboniferous to Permian sedimentary rocks (sandstone, siltstone, mudstone) and volcanic and intrusive rocks (basalt, microdiorite) of the Midland Valley of Scotland with varying but minor proportions of Dalradian metasedimentary rocks (metasandstone, metapelite) and Caledonian igneous rocks (granite, granodiorite, gabbro). In contrast to the Mearns Glacigenic Subgroup, with red tills dominated by clasts and matrix of Devonian origin of the Strathmore Basin, the Midland Valley Glacigenic Subgroup tills have characteristically grey matrices. However, locally they can be red where the diamictons are derived from red or reddened measures (e.g. Upper Coal Measures, Permian strata, small outcrops of Devonian rocks)."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with bedrock. Pre-Ipswichian Quaternary deposits are not proven within the Midland Valley of Scotland."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CLVY ,
        namedrockunit:H1076 ,
        namedrockunit:H1717 ,
        namedrockunit:H2951 ,
        namedrockunit:H4212 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 100m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with unit of the Britannia Catchments Group (Forth Catchments Subgroup, Tay Catchments Subgroup, Clyde Catchments Subgroup) and the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clyde Valley Formation"@en ,
        "Forth-Teith Formation [Obsolete: use MVG]"@en ,
        "Parts of Mounthouse Formation of Sutherland [Obsolete: use MVG]"@en ,
        "Parts of Tayburn Formation [Obsolete: use MVG]"@en ,
        "Sourlie Formation [Obsolete: use MVG]"@en ;
