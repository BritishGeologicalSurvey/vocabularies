namedrockunit:SLEV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the marine, estuarine and terrestrial deposits that were formed in the Somerset Levels area during the Holocene transgression. The deposits are dark blue-grey silty clays and silts with subordinate sands and beds of peat, submerged forests and gravel. The deposits rest on a rockhead platform intricately dissected by river valleys formed when sea levels were lower, and their upper surface is approximately level at c 4.6 to 6.7m OD. The river valleys are infilled with gravels and sands, which become shelly upwards. See also \"Supplementary Information\"."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Triassic and Jurassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1185 ,
        namedrockunit:H1827 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial deposits and peat [Obsolete: use SLEV]"@en ,
        "Estuarine alluvium and higher estuarine alluvium [Obsolete: use SLEV]"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay and silt with subsidiary gravel, peat and sand. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage - to - Holocene Epoch (Quaternary Period) (.126-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLEV"@en ;
    skos:prefLabel "Somerset Levels Formation"@en ;
.

