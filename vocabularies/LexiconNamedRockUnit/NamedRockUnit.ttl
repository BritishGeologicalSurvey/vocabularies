namedrockunit:HSZM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BLSTMY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MYLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEPITE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Closely-packed masses of coarse-grained, dominantly hornblendic rocks, cut by and contained within, fine-grained and dominantly hornblendic blastomylonites."@en ;
    lexicon:hasLowerBoundaryDefinition "On the western boundary, the rocks of the slide zone belong to the Shetland Boundary Zone.  There is no lithological discordance at the junction but it is marked by a continuous and rapid increase in the intensity of the schistosity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2857 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
