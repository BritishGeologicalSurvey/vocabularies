    lexicon:hasThicknessDescription "c.460 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, but taken at the base of the incoming of abundant packets of thinly interbedded turbidite mudstone and laminated hemipelagites."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ST> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
