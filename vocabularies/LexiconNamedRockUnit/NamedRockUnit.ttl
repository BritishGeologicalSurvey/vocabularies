    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 590 m in the Upton Borehole"@en ;
    lexicon:hasUpperBoundaryDefinition "The red and grey mudstones and sandstones of the Windrush Member are overlain unconformably by red mudstones of the Mercia Mudstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Windrush Formation [Obsolete: use WNR]"@en ,
        "Windrush Group [Obsolete: use WNR]"@en ;
    skos:broader namedrockunit:GDB ;
    skos:definition "Mudstone with subsidiary coal, sandstone and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WNR"@en ;
    skos:prefLabel "Windrush Member"@en ;
