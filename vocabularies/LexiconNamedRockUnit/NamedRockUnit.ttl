namedrockunit:RIN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone-rich gravels forming the First Terrace of the River Windrush in the Vale of Bourton. The gravels extend beneath the alluvium. Channel-filling silts beneath cryoturbated gravels have yielded molluscs and pollen indicative of cold interstadial conditions (Gilbertson in Roe, 1976; Brown et al., 1980) and woolly mammoth has been recorded from several sites (O'Neil and Shotton, 1974; Briggs in Roe, 1976; Briggs et al., 1985, p. 32; Brown et al., 1980)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4863 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rissington Gravel [Obsolete: use RIN]"@en ;
    skos:broader namedrockunit:UTMS ;
    skos:definition "Gravel with subsidiary silt. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RIN"@en ;
    skos:prefLabel "Rissington Sand and Gravel Member"@en ;
.

