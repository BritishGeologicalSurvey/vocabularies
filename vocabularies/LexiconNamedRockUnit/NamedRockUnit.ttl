    lexicon:hasThicknessDescription "6.0m at the type site."@en ;
    lexicon:hasUpperBoundaryDefinition "Boundary placed at the conformable upward change from hard brown sandstone (Bed 14) of The Crackers Member into sporadically glauconitic brown sandy mudstone (Bed 15) of the Upper Lobster Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
