namedrockunit:GY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DALTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, dacitic lapilli-tuff; contains significant quantities of lithic clasts, mainly of siltstone and sandstone derived from the subvolcanic,  Skiddaw Group, basement."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of dacitic lapilli tuff. Unconformable, locally overlies Great Whinscale Dacite and elsewhere un-named basaltic andesite and andesite in the Birker Fell Andesite Formation."@en ;
