namedrockunit:LSS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:RIL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/NODL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The succession comprises dark grey to grey slates, brownish-grey sandstones (locally cross-bedded, with beds up to 1.4 m thick), gritty sandstones, siltstones and mudstones (commonly with abundant Chondrites) and thinly bedded crinoidal shelly limestone with nodules. The Holey Limestone is located near the top of the Formation: it is up to 0.8 m thick, dark grey with mudstone partings and contains corals and brachiopods."@en ;
    lexicon:hasLowerBoundaryDefinition "Obscured by folding and faulting, but likely to be gradational and conformable with the underlying Wild Pear Slates; estimated to be below the lowest thick sandstone of the overlying Lester Slates and Sandstones Member (a sequence of slates, sandstones, gritty sandstones, siltstones and mudstones)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ILFG ,
        namedrockunit:LESTB ,
        namedrockunit:LESTS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasOldestAgeValue 3.853e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 40 to 100 m."@en ;
    lexicon:hasUpperBoundaryDefinition "10 m above the top of the Holey Limestone (a lateral equivalent of Holwill's (1964) Rillage Limestone). Below the boundary, rocks assigned to the underlying Lester Slates-and-Sandstones, are sandstones and siltstones with abundant Chondrites; the rocks at the base of the Combe Martin Slates are silvery grey, calcareous slates that are commonly silty, with thin (< 0.3 m) grey fine-grained sandstones. Chondrites are less common in the Combe Martin Slates than in the underlying Lester Slates and Sandstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
