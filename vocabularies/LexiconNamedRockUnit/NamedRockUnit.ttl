namedrockunit:CYSI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine- to coarse-grained sand, silt and clay, grey and brownish grey, well laminated to thin bedded, some pebbles up to 4cm, finely micaceous, rooty near top below sub-Carse Peat (Flanders Moss Peat Formation); depending on location within the palaeo-estuary, the dominant material varies from sand to clay. The deposit forms a series of raised beaches/terraces related to transgressive and regressive cycles of sea-level change."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable and transgressive base on older units including the Tay-Earn Gravels and Culfargie Sand members of the Forth Clay Formation and the Errol Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1471 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 8m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by the sub-Carse Peat (Flanders Moss Peat Formation) and trangressive estuarine clay, silt and sand of the Carse of Gowrie Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carey Beds [Obsolete: use CYSI]"@en ;
    skos:broader namedrockunit:CARCL ;
    skos:definition "Clay, sand and silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CYSI"@en ;
    skos:prefLabel "Carey Silt Member"@en ;
.

namedrockunit:CYTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stony sandy clay diamicton, matrix supported, \"strong brown\" (Munsell Soil) to dark yellowish brown, fissile, massive, extremely compact, containing angular to subrounded clasts of gneissose psammite and semipelite, granite and Devonian sandstone and siltstone. Typical lodgement till with well developed north-easterly fabric and containing concavo-convex discontinuities that are commonly sand-filled. Commonly includes rip-up masses of the underlying till unit (Athais Till Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Either a planar, gradational contact over 10 to 20cm with underlying stony, clayey, sandy diamictions of the Athais Till Formation, or a sharp, planar, glacitectonic boundary with that Formation. Locally filling wedge structures in the top surface of the Athais Till Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1472 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "6.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a gradational contact, but a sharp change in colour, with dark yellowish brown stony sandy clay diamicton of the overlying Ruallan Till Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Dalcharn Upper Till Formation [Obsolete: use CYTI]"@en ;
    skos:broader namedrockunit:BUTI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CYTI"@en ;
    skos:prefLabel "Cantray Till Member"@en ;
.

