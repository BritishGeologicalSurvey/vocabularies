    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Alluvium, 1"@en ;
    skos:definition "Obsolete name. Silty clay with subsidiary gravel and sand and trace peat. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
