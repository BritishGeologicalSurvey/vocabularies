namedrockunit:DMR
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Granite with varying grain size; mostly coarse and locally porphyritic. In the north and north-east of the granite, tourmaline is a common constituent, although the amount of tourmaline and biotite varies across the granite; locally one or both minerals may be very abundant. Fine-grained granite occurs in the area around Birch Tor and Vitifer Mine. In the eastern area, the granite has a coarsely crystalline porphyritic texture, composed principally of quartz, biotite and orthoclase but locally with microperthite, albite and black tourmaline. Textures vary over short distances, with the boundaries between them being predominantly gradational. Over the whole extent of the Dartmoor Granite, more than 50% is composed of granite in which feldspar megacrysts of > 15mm compose over 10% of the rock volume."@en ;
    lexicon:hasLowerBoundaryDefinition "Not known."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DMGR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasOldestAgeValue 3.075e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Present day erosional surface, with local cover of Head and/or peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Dartmoor Granite [Obsolete: use DMR]"@en ;
    skos:definition "Granite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Stephanian Stage (Carboniferous Period) - to - Cisuralian Epoch (Permian Period) (307.5-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "DMR"@en ;
    skos:prefLabel "Dartmoor Intrusion"@en ;
.

