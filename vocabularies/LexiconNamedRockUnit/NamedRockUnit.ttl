namedrockunit:MHPL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Ooid-limestone, mainly grainstone, very fine- to coarse-grained, white, grey, yellow, cross-bedded and bedded, variably shell-detrital, pervasively burrowed in parts, with common whole shells in some beds, including rare ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "Ooid-limestone, resting sharply on brown, fine-grained sandy limestone of Througham Member of Fuller's Earth Formation, or where that is absent, grey calcareous mudstone of Fuller's Earth Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5070 ,
        namedrockunit:H5071 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5 to 9m at Minchinhampton Common, including Minchinhampton Borehole (SO80SE4), at least 4.4m at Bisley Borehole. Thins to zero to the south and west, probably passes east into the Taynton Limestone and Hampen formations."@en ;
    lexicon:hasUpperBoundaryDefinition "Ooid-limestone, sharply overlain by shell-detrital, fine-grained calcisiltite limestone of Dodington Ash Rock Member (Fuller's Earth Formation), where present, or very shelly calcareous mudstone (part of 'The Scroff') at the base of the Athelstan Oolite Formation at Minchinhampton Common."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Minchinhampton Beds [Obsolete: use MHPL]"@en ,
        "Shelly Beds and Weatherstones [Obsolete: use MHPL]"@en ;
    skos:broader namedrockunit:TY ;
    skos:definition "Ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MHPL"@en ;
    skos:prefLabel "Minchinhampton Limestone Member"@en ;
.

namedrockunit:MIOR
