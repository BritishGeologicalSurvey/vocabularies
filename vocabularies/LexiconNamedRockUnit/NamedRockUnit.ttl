namedrockunit:MQU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithologyDescription """An area of Made Ground where the pre-existing (natural or artificial) land surface is raised by artificially deposited material as part of a building or structure of an early epoch (including prehistorical remains). The exact nature of the structure is unspecified. The English Heritage classification (National Monuments Record Monument Type Thesaurus) is recommended for further subdivision of this type of Archaeological feature. \r
\r
Composition: variable."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/TY> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MGR ;
    skos:definition "Artifical (anthropogenic) deposits and excavations. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:MQBU ,
        namedrockunit:MQRU ,
        namedrockunit:MQWU ;
    skos:notation "MQU"@en ;
    skos:prefLabel "Archaeological Raised Ground (Undivided)"@en ;
.

namedrockunit:MRCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S682 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/H"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Boreholes indicate that the deposit can vary from sandy flint gravel to clayey, silty, pebbly sand. The deposit is commonly cross-bedded and shelly. Locally the gravels contain pebbles of limestone and ironstone in addition to flint. The fauna includes marine bivalves and gastropods, and mammalian bones have also been recorded."@en ;
    lexicon:hasLowerBoundaryDefinition "The gravels rest unconformably on Oxford Clay Formation mudstones and elsewhere unconformably on chalk-rich till (uncertain whether this is of the Lowestoft Formation or possibly younger). At Town End, March, the gravels locally appear to be banked up against a low cliff or steep slope cut in the till."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:FEG ,
        namedrockunit:H2946 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to about 5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The gravels typically crop out at the surface on 'raised islands'. Locally for example at Wimblington Common in the Ely district, the March Gravels are contiguous with the river terrace gravels. Seale (1975) noted that the two gravels are impossible to distinguish in some parts of the Ely district and that Baden-Powell's (1934) differentiation on the basis of their position relative to OD is unreliable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Fen gravel [Obsolete: use ABSG, MRCG]"@en ,
        "March Formation"@en ,
        "March Gravel [Obsolete: use MRCG]"@en ;
    skos:broader namedrockunit:FEND ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace shells. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage (Quaternary Period) (.126-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MRCG"@en ;
    skos:prefLabel "March Gravels Member"@en ;
.

