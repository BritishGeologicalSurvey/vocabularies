namedrockunit:HGSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The unit is a subgreywacke in the type area of Holdgate, typically medium grained, limonite and iron stained, relatively well sorted and consisting of subangular grains of quartz, feldspar, lithic fragments and detrital heavy minerals (Greig et al., 1968). In the Neen Solars and Abberley areas, it is a coarse-grained, gritty, commonly pebbly, ridge-forming, red-brown sandstone, locally containing fish fragments (Mitchell et al., 1962)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasOldestAgeValue 4.227e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "As envisaged by King, the unit is 5 to 10 m thick at Holdgate, but the Holdgate Sandstones Group/Formation of Allen and Tarlo (1963) extends to about 120 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MOCL ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Pridoli Epoch (Silurian Period) (422.7-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HGSA"@en ;
    skos:prefLabel "Holdgate Sandstone"@en ;
