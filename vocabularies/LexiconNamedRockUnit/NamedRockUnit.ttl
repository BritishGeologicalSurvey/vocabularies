    lexicon:hasThicknessDescription "c.70m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp incoming of tuff or tuffaceous sandstone, or locally calcareous sandstone and shelly limestone of the overlying Asaphus Ash Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasYoungestAgeValue 4.582e+02 ;
