namedrockunit:SCHD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGNA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QDI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A grey to pink, medium- to coarse-grained granophyric diorite with a distinctive \"mottled\" appearance caused by the clumping together of dark grey ferromagnesian minerals (mainly hornblende and chlorite) and grey-green hypidiomorphic plagioclase crystals. Both components are surrounded by a pink to grey granophyric mesostasis. The texture coarsens in places, but true pegmatites are rarely developed; green-grey aplite sheets cross the diorite in some quarries."@en ;
    lexicon:hasLowerBoundaryDefinition "Where intrusive contacts are exposed (eg Cliffe Hill Quarry), the diorite fines progressively in grain size over about 10m, eventually developing a selvage 1.5m wide consisting of dark grey porphyritic andesite. The contact sharply truncates bedding in adjacent volcaniclastic rocks of the Charnian Supergroup, the latter developing thermal spots that are locally attenuated within the plane of a later cleavage. Many contacts are sheared and faulted."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1166 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "c.1100m"@en ;
    lexicon:hasUpperBoundaryDefinition "Intrusive, as for the Lower Boundary; in places overlain unconformably by Triassic strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "South Charnwood Diorites Complex [Obsolete: use SCHD]"@en ;
    skos:definition "Diorite with subsidiary granodiorite and quartz-diorite and trace aplitic microgranite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SCHD"@en ;
    skos:prefLabel "South Charnwood Diorites"@en ;
.

namedrockunit:SCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, pale to medium-grey, wavy bedded, crinoidal with fissile uppermost part and shaly partings; styolitic. Fossiliferous, with bands of Siphonodendron junceum, but comparatively unfossiliferous in the south though a bed rich in brachiopods is present at the base in the southern part of the Brough district (Burgess and Holliday, 1979). Nodules of chert are commonly found in this limestone. In the Longcleugh No 1, Allenheads No 1, and Rookhope boreholes an interbedded unit of black pyritic fossiliferous mudstone with sporadic small ironstone nodules in the upper part of the member. Goniatites of the P2a biozone are found in mudstone just above the limestone at Bowlees in Teesdale."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp base of limestone overlying measures within the Alston Formation; directly underlain locally by dark mudstone, seatearth sandstone or by a coal seam."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1805 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4 to 14.6m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of overlying measures within the Alston Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Scar Limestone [Obsolete: use SCL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone with subsidiary mudstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCL"@en ;
    skos:prefLabel "Scar Limestone Member"@en ;
.

