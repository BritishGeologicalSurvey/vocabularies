namedrockunit:DOVEY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, stratified gravels, sands, silts and clays forming the alluvial deposits of the River Dovey (Afon Dyfi) and its tributaries. Includes contemporaneous head, colluvium and pedigenic deposits within the catchment area. Clasts principally consist of local, Lower Palaeozoic turbidites. Aggradational river terraces and major alluvial fans are dominated by pebble cobble gravels and medium- to coarse-grained sand; the modern floodplain is dominated by silt and clay, and locally includes lenses of peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable and locally channelised on bedrock and Late Devensian head deposits and Welsh glacigenic deposits (including Eryri and Plynlimon till formations). Interdigitates in a complex manner with Tidal Flat Deposits (Gwynllwg Formation of Bowen, 1999) in the estuary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALF ,
        namedrockunit:ALV ,
        namedrockunit:HEAD ,
        namedrockunit:LDE ,
        namedrockunit:RTD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally to around 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface or, locally, overlain by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial fan deposits"@en ,
        "Alluvium"@en ,
        "Head"@en ,
        "Lacustrine deposits"@en ,
        "River terrace deposits"@en ;
    skos:broader namedrockunit:WWACA ;
    skos:definition "Clay, gravel, sand and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DOVEY"@en ;
    skos:prefLabel "Dovey Valley Formation"@en ;
.

namedrockunit:DUNR
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:DRB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Mudstones, sandstones and siltstones of the constituent formations: Orrin Formation; Lady's Walk Formation; Mains Formation; Golspie Formation. \r
\r
The Group is almost equivalent to Dunrobin Bay Formation (DRB) onshore, although subdivided differently. Onshore the lower boundary of the formation was placed at the base of the 'Carbonaceous Siltstone and Clay Unit' by Neves and Selley (1975), but at the base of the Dunrobin Pier Conglomerate by Batten et al. (1986). The top of the formation is not exposed onshore. Offshore, the Dunrobin Pier Conglomerate is not recognised and the Orrin Formation is apparently equivalent to the unexposed part of the onshore sequence."""@en ;
    lexicon:hasLowerBoundaryDefinition "The boundary between the Golspie Formation and the Stotfield Calcrete Formation (Heron Group)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasOldestAgeValue 2.057e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 180 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary between the Brora Coal Formation (Fladen Group) and the Orrin Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Dunrobin Bay Formation [See Also DUNR]"@en ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Rhaetian Age (Triassic Period) - to - Toarcian Age (Jurassic Period) (205.7-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GOLS ,
        namedrockunit:LDYW ,
        namedrockunit:MANS ,
        namedrockunit:ORRN ;
    skos:notation "DUNR"@en ;
    skos:prefLabel "Dunrobin Bay Group [See Also DRB]"@en ;
.

namedrockunit:DURN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent namedrockunit:DSB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominated by interbedded, shelly limestones and dark mudstones. The shell material commonly contains Unio and Viviparus. Detrital quartz is present through much of the formation in West Dorset (west of Stair Hole), but is confined to the Stair Hole Member in East Dorset (Worbarrow and Durlston). The Durlston Formation comprises two members in Dorset, which, in ascending order are: the Stair Hole Member and the Peveril Point Member. Elsewhere the formation is undivided, or is itself incorporated into an undivided Purbeck Limestone Group. The formation includes the informal Upper Purbeck Beds, and the upper part of the Middle Purbeck Beds, above the base of the Cinder Bed, of the traditional scheme. Within the Weald, an equivalent of the Cinder Bed has been identified, thus allowing the succession there to be considered within the formal terminology."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable and marked by the first upward occurrence of very shelly micrite (Cinder Bed) above purer micrites at the top of the Lulworth Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DSB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "18 to 57m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary varies from unconformable to disconformable and is marked by the last occurrence of significant limestone below monotonous Wealden Group sandy mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Durlston Beds [Obsolete: use DURN]"@en ;
    skos:broader namedrockunit:PB ;
    skos:definition "Limestone, mudstone and shelly limestone. Stratified bedrock. Occurs onshore. Deposited during the Berriasian Age (Cretaceous Period) (143.1-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GRL ,
        namedrockunit:PEP ,
        namedrockunit:SHO ;
    skos:notation "DURN"@en ;
    skos:prefLabel "Durlston Formation"@en ;
.

