    lexicon:hasThicknessDescription "c.750m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the predominantly sandstone succession in the Eastfield Inlier where it is overlain by thick conglomerate belonging to the Greywacke Conglomerate Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Downtonian sandstone including quartzite-conglomerate [Obsolete: use MAWO]"@en ;
    skos:broader namedrockunit:CARM ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) (432.9-426.7 Ma BP)."@en ;
