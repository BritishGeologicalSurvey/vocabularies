    skos:definition "Mudstone and siltstone with subsidiary andesite, chert, rhyolite and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Pragian Age (Devonian Period) (412.4-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RHNC ;
    skos:notation "DRY"@en ;
    skos:prefLabel "Dryden Flags Formation"@en ;
