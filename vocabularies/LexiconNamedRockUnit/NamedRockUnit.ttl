    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark red, fine-grained to coarse-grained sandstone and locally derived conglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable on Birrenswark Volcanic Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H16 ,
