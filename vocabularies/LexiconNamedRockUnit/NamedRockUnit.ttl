namedrockunit:WMCS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lacustrine and organic sediments infilling Lake Windermere, comprising upper (Upper Laminated Clay), and lower (Lower Laminated Clay) units of laminated clay separated by a sequence of silt or organic silt (non-organic and organic silt unit). Sporadic rock fragments are present in the organic silt."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies gravel and till of the Central Cumbria Glacigenic Subgroup (Caledonia Glacigenic Group)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasOldestAgeValue 2.6e-02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Cores of up to 6 m have been sampled on the lake floor in water depths of 30 m. Echo sounding in deeper water indicates 21 to 40 m of sediment (Howell, 1971)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Upper Laminated Clay passes conformably upwards into organic muds of the Cumbria-Lancashire Catchments Subgroup (Britannia Catchments Group) of Holocene age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDW> ;
    lexicon:hasYoungestAgeValue 1.265e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
