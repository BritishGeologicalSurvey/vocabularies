namedrockunit:MEL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-grained, pale grey limestones with pseudobreccias and calcite mudstones, and some bands of shaly mudstone and sandstone. The uppermost part of the formation is the Robinson Limestone (bed), which comprises alternations of limestone, shaly mudstone and sandstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 35 to c.107m. The uppermost (Robinson Limestone) bed is generally 4 to 6m thick, but reaches 25m as it approaches the Stainmore Trough."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone and trace mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RNL ;
    skos:notation "MEL"@en ;
    skos:prefLabel "Melmerby Scar Limestone Formation"@en ;
.

namedrockunit:MELB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Olive-grey, shaly and thinly flaggy, muddy siltstones, commonly 'soapy' with a characteristic smooth conchoidal fracture. Less common are slightly calcareous muddy siltstones with finely divided mica. There are occasional paper shales and calcareous nodules. Bentonites are common and conspicuous. Its well-defined bedding planes, less calcareous nature and colour distinguish the Middle Elton Formation from the Lower Elton Formation (LEL). \r
\r
A pelagic fauna, consisting of graptolites (nilssoni and scanicus biozones) and orthocones, is dominant; benthic organisms are rare, although brachiopods are present (Holland et al., 1963; Lawson and White, 1989)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The contact with the underlying Lower Elton Formation (LEL) is transitional over a few centimetres."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1061 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be between 45 and 105 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The contact with the overlying Upper Elton Formation (UELB) is transitional."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasYoungestAgeValue 4.25e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Elton Beds [Obsolete: use MELB]"@en ;
    skos:broader namedrockunit:LLUS ;
    skos:definition "Muddy siltstone. Stratified bedrock. Occurs onshore. Deposited during the Gorstian Age (Silurian Period) (426.7-425 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MELB"@en ;
    skos:prefLabel "Middle Elton Formation"@en ;
.

