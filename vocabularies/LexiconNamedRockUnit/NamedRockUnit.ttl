namedrockunit:HRTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very dense, pale reddish grey to red (Munsell Soil), very gravelly sandy clay diamicton with many cobbles and boulders, with clasts of Borrowdale Volcanic Group rocks (rhyolite, welded tuff, slate), granite and granophyre. Generally matrix supported and massive, but with some interbeds of cobble and boulder gravel, and of pebbly clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Variable, but mainly a sharp, irregular, unconformable contact with bedrock, or an undulating to planar, unconformable contact with laminated silt and clay of the Stubble Green Silt or Carleton Hall Clay members of the Glannoventia Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1603 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 11m"@en ;
    lexicon:hasUpperBoundaryDefinition "Variable, mainly a sharp, undulating, draped unconformable contact with overlying dark brown laminated clay of the Whinneyhill Coppice Clay Member of the Aikbank Farm Glacigenic Formation or a sharp, planar, unconformable contact with reddish brown, gravelly sandy clay diamicton of the Ravenglass Till Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower boulder clay of the main glaciation [Obsolete: use HRTI]"@en ;
    skos:broader namedrockunit:BLGL ;
    skos:definition "Diamicton with subsidiary gravel and trace clay and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HRTI"@en ;
    skos:prefLabel "Holmrook Till Member"@en ;
.

