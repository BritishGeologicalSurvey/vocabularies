namedrockunit:STYL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded cryptalgal and fenestral, calcite mudstones, coquinoid limestones, skeletal, peloid, intraclast, ooid packstone/grainstones, ooid grainstones and the characteristic oncolitic grainstones.  Scattered algal bioherms. Deposited in a peritidal enviroment."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the first bed of calcite mudstone occuring above the ooid grainstones and the subordinate skeletal packstones of the underlying Cornelly Oolite Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "55 to 65m in the central and western Vale of Glamorgan."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Vale of Glamorgan the top is taken at the sharp contact, defined by a paleokarstic surface, between the heterolithic lithologies of the Formation and the overlying partially dolomitised sandy skeletal packstones and calcareous sandstones of the Pant Mawr Sandstone Member [Oxwich Head Limestone Formation]. In Gower and Pembrokeshire it is taken at the palaeokarstic surface separating the heterolithic lithologies of the Formation from the mottled and pseudobrecciated skeletal packstones of the Oxwich Head Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HBO ;
    skos:definition "Limestone with subsidiary calcite-mudstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STYL"@en ;
    skos:prefLabel "Stormy Limestone Formation"@en ;
.

namedrockunit:SUB
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey well-sorted crinoidal limestone, oolitic in upper part. Deposited in a shallow marine setting."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the junction between the dolomitised packstones of the underlying Black Rock Limestone Subgroup and the undolomitised crinoidal limestones of the Bed. The boundary needs further investigation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
