    lexicon:hasThicknessDescription "0 - 70m"@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by bases of overlying formations; usually the Dunnerdale Sandstone Formation (volcaniclastic sandstone) but locally the Lickle Tuff Formation (rhyolitic and dacitic tuff)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
