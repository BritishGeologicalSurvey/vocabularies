namedrockunit:HADD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fossiliferous marine limestones and lagoonal limestones together with calcareous and commonly glauconitic, sandstones and sands."@en ;
    lexicon:hasLowerBoundaryDefinition "Upwards change from fully marine limestones with large molluscan fossils of the Portland Stone Formation (Portland Group) to lagoonal fine-grained limestones and marls of the Haddenham Formation (Purbeck Limestone Formation on BGS maps), the base of which is commonly marked either by laminated, ostracod-bearing or oyster-bearing marl, or by a sharp non-sequential junction."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1583 ,
        namedrockunit:H2229 ,
        namedrockunit:H948 ,
        namedrockunit:PLND ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 13m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by generally non-calcareous and commonly ferruginous sands and sandstones of the Lower Greensand or Whitchurch Sand Formation, or by calcareous mudstones of the Gault Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Portland Beds [Obsolete: use HADD, PL, PLND]"@en ,
        "Portland Formation (Wiltshire, Oxfordshire and Buckinghamshire) [Obsolete: use PL]"@en ,
        "Purbeck Limestone Formation [Obsolete: use PB, HADD]"@en ,
        "Purbeck Limestone [Obsolete: use HADD]"@en ;
    skos:broader namedrockunit:PB ;
    skos:definition "Calcareous sandstone, glauconitic sandstone and limestone with subsidiary micritic limestone, ooid-limestone, shelly limestone and shelly sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HADD"@en ;
    skos:prefLabel "Haddenham Formation"@en ;
.

namedrockunit:HAI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
