        "Matlock Upper Basalt [Obsolete: use URB]"@en ,
        "Matlock Upper Lava [Obsolete: use URB]"@en ,
        "Upper Matlock Lava [Obsolete: use URB]"@en ;
    skos:broader namedrockunit:MO ;
    skos:definition "Basalt with subsidiary tuff. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "URB"@en ;
    skos:prefLabel "Upper Matlock Lava Member"@en ;
.

