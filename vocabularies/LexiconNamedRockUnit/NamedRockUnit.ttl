namedrockunit:LKNB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:CB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises sandstones overlying thin mudstones with a thin, but persistent basal limestone bed. Sandstones are glauconitic and variably carbonate cemented."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at the base of a thin limestone unit (coeval with the Cornbrash) where there is usually a downward change to mudstone dominated sediments (Hudleston Formation). It usually coincides with the base of a low gamma/high velocity spike. Locally, where the limestone is absent, the upper boundary is placed at a downward change from sandstone to variegated mudstone and a downward increase in gamma values and decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a sharp down-section change from mudstones (Seeley Formation) or sandstones (Corallian Formation (Offshore)). A corresponding decrease in gamma values takes place at the boundary, and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cornbrash Formation"@en ;
    skos:broader namedrockunit:WSTS ;
    skos:definition "Sandstone with subsidiary mudstone and trace limestone. Stratified bedrock. Occurs offshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LKNB"@en ;
    skos:prefLabel "Leckenby Formation"@en ;
.

