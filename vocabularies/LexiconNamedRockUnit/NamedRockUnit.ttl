namedrockunit:LUBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Breccia, sandy breccia, pebbly sandstone and sandstone, reddish brown, commonly calcareous; calcite-veined in places, and locally well-cemented-clasts in breccias; mainly angular platy slate, shale, sandstone and quartz. Thin unit of conglomerate with rounded boulders of Devonian sandstone. Near base, reddish brown, weakly cemented, silty, fine- to medium-grained sandstone unit, up to 70m."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable: rests on Hangman Sandstone (Eifelian)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1671 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 650 m. estimated."@en ;
    lexicon:hasUpperBoundaryDefinition "Probably unconformable: overlain with probable angular discordance by Mercia Mudstone Group (Triassic)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
