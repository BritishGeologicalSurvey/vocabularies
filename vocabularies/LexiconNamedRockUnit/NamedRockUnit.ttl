namedrockunit:GMT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A widespread package of dacitic pyroclastic rocks including coarse lithic-rich lapilli-tuff and pyroclastic breccia, bedded tuff with beds containing accretionary lopilli, and nodular eutaxitic lapilli-tuff. The uppermost part comprises massive to bedded pebbly sandstone with accumulations of broken accretionary lapilli in channels and scours."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the sharp contact at the base of dacitic pyroclastic rocks overlying sandstones with an overall andesitic composition. In places the contact is an erosion surface of low relief."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3437 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "About 20m in type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the overlying sandstones of the uppermost part of the Sprinkling Tarns Member or, where not distinguished, by the uppermost part of the Seathwaite Fell Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glaramara Tuff Member [Obsolete: use GMT]"@en ;
    skos:broader namedrockunit:SPR ;
    skos:definition "Dacitic tuff and lapilli-tuff with subsidiary volcaniclastic-sandstone and trace pyroclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GMT"@en ;
    skos:prefLabel "Glaramara Tuff"@en ;
.

