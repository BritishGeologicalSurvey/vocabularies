        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/M"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Freshwater muds (Beeston Beds) and a lower bed of laminated freshwater silty clays (Woman Hythe Clay)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QB> ;
    lexicon:hasOldestAgeValue 1.78e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QB> ;
