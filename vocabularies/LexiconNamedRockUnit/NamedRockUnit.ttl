    lexicon:hasThicknessDescription "200 - 500m"@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by base of overlying formations including Caw (volcaniclastic breccia and sandstone), Lag Bank (dacitic lapilli tuff) and Low Water (dacitic tuff) formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
