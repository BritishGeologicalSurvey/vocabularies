namedrockunit:IRCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale grey to off- white or yellowish limestone with thin marls and mudstones, fossiliferous, bioturbated peloidal, ooidal and shell-fragmental more or less argillaceous packstones and wackestones, with subordinate cross-bedded, ooidal, shell-fragmental grainstones, containing a fauna mainly of bivalves, and locally brachiopods, such as Digonella digonoides, described as the Digonoides Beds of Torrens, 1967."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp boundary with the underlying Roade Member comprising ofsimilar limestones generally containing K sharpi, or else a marl or mudstone bed at this level, which may prove a reliable marker, such as the mudstone at the base of the equivalent Ardley Member of the White Limestone Formation in Bucks-Oxon."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:GOL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically from 5 m to 7 m thick, measured as 6.15 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp boundary of the limestones with mudstones of the Blisworth Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Great Oolite Limestone [Obsolete: use BWL, CFDO, GOG, IRCH, WHL]"@en ;
    skos:broader namedrockunit:BWL ;
    skos:definition "Limestone with subsidiary calcareous mudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IRCH"@en ;
    skos:prefLabel "Irchester Member"@en ;
.

