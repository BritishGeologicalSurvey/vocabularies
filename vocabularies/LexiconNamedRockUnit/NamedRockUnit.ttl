namedrockunit:AGR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Seen as 10-20cm-thick beds of lenticular-bedded abraded flint and chert gravels, with subordinate red-mottled silts and clays, coarse, angular, flinty gravelly clayey sand, with some cross-bedded coarse sand, lenticles of white clayey sand and reddish brown coarse sand. Locally finer-grained, more distinctly bedded flint gravels overlie the coarse gravels. The unit is interpreted to have been deposited by braided streams; the source is postulated to have been the Dartmoor highlands (Selwood and others, 1984; Cope et al., 1992), The constituents of the gravel vary locally, and may contain some or all of the following: flint, quartz and tourmaline rock, Greensand chert, Lower Carboniferous chert, Upper Carboniferous sandstone, white rounded clay clasts, vein quartz, dark grey hornfels and tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Upper Greensand, where the contact is marked by an unconformable transition from pale green to pale brown sand with some glauconitic bands, iron staining with local chert from the Upper Greensand, to the overlying deposits of Aller Gravels. At Wolborough [SX 8535 7034], Aller Gravel has a faulted or unconformable contact with Upper Devonian Slates; here the contact is recognised by an abrupt change from the lithology of the Aller Gravel to coarse, locally dolomitised, limestones with red mudstone layers of the East Ogwell Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1305 ,
        namedrockunit:H3157 ,
        namedrockunit:H633 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Aller Gravels are locally overlain by the Palaeogene clays and sands of the Bovey Formation, indeed the Sandygate Borehole [SX 8672 7507] passes through this contact. In this location, the overlying Lappathorn Member of the Bovey Formation is comprised of siliceous clays, sands and silts with pink, red and brown iron staining; these are all underlain by flint gravels that are thought to represent the Aller Gravel."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasYoungestAgeValue 3.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Aller Gravel [Obsolete: use AGR]"@en ,
        "Bovey Beds [Obsolete: use AGR, BHGR]"@en ,
        "Tertiary Deposits [Obsolete]"@en ;
    skos:definition "Gravel with subsidiary clay and sand. Stratified bedrock. Occurs onshore. Deposited during the Eocene Epoch (Palaeogene Period) (56-33.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "AGR"@en ;
    skos:prefLabel "Aller Gravel Formation"@en ;
.

namedrockunit:ALBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLateralEquivalent namedrockunit:TBR ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Breccia, reddish brown, clayey, silty, fine-grained. Clasts predominantly culm shale and sandstone, together with hornfels, chert, quartz-porphyry, and lava. Most clasts less than 4cm; some range up to 0.1m and large boulders of porphyry are locally present."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Whipton Formation or on basalt. Junction with the  Whipton Formation is gradational over a vertical interval of about 10m, the boundary being drawn where breccia becomes the dominant lithology. Where the formation overlies basalt, a large hiatus is present between c.290 Ma basalts and c.260 Ma or younger Alphington Breccia."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4424 ,
        namedrockunit:H638 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "160-240m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Heavitree Breccia, which forms a scarp above the Alphington Breccia owing to the difference in cementation between the two formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alphington Breccia Member [Obsolete: use ALBR]"@en ,
        "Alphington Breccias [Obsolete: use ALBR]"@en ,
        "Teignmouth Breccia"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Breccia. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ALBR"@en ;
    skos:prefLabel "Alphington Breccia Formation"@en ;
.

