namedrockunit:BRYD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "This formation, which underlies much of the marshland in the Great Yarmouth district, is dominated by unconsolidated silt and clay with a shelly marine fauna. Sand is generally a minor component, though locally substantial sand bodies interrupt the argillaceous succession. Peat, of freshwater and brackish origins, is a major component adjacent to much of the marshland margin and particularly in the valleys of the River Yare and tributary streams. It also occurs as three widespread though locally inpersistent layers, at the base of the formation, within it, and at the top, mainly in the marshland fringe."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable. Commonly overlies tills and outwash sands and gravels of the Happisburgh and Lowestoft formations and also sands, gravels and silts of the Crag Group. Also overlies gravels of the Yare Valley Formation (as in the type section). In the west of the outcrop the base of the formation locally overlies rocks of the Chalk Group and London Clay Formation (Thames Group)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:ALV ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 22 m, but thins towards the margins of the outcrop."@en ;
    lexicon:hasUpperBoundaryDefinition "At surface. Not overlain by other deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Alluvium"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay, peat and silt with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BRY1 ,
        namedrockunit:BRY2 ,
        namedrockunit:BRY3 ,
        namedrockunit:BRY4 ,
        namedrockunit:BRY5 ;
    skos:notation "BRYD"@en ;
    skos:prefLabel "Breydon Formation"@en ;
.

namedrockunit:BWC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicate-mudstone, grey, commonly variegated purplish red, yellow and green, poorly bedded to blocky. Commonly contains fossil rootlets and sideritic ironstone nodules, and locally with impersistant beds and lenses of argillaceous limestone including (mainly in the south) shell fragmental wackestones, packstones and grainstones, and (mainly in the north) sandstone. Mudstone weathers to highly plastic clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp but generally more or less conformable contact: limestone of the Blisworth Limestone Formation (or locally, near its northern limit, bluish and greenish grey variably shelly mudstones of the Rutland Formation) overlain by grey or variegated mudstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GLF ,
        namedrockunit:GOC ,
        namedrockunit:H4507 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c. 10 m; typically 2 to 4 m throughout most of its range."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, generally disconformable contact: grey or variegated mudstone overlain by bioclastic limestone of the Cornbrash Formation or (very locally near its northern limit) by mudstone and sandstone of the Kellaways Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blisworth Clay Member [Obsolete: use BWC]"@en ,
        "Glentham Formation [Obsolete: use BWL, BWC, RLD]"@en ,
        "Great Oolite Clay [Obsolete: use BWC]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Mudstone with subsidiary ironstone, limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
