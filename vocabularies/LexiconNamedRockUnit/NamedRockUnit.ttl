namedrockunit:CFTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S501 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy, silty diamicton (till), very stiff, grey (2.5Y N5) to very dark grey (7.5YR N3), massive to crudely horizontally bedded with sparse pebbles. Clast lithologies comprise mainly rounded quartzite and flint, with lesser amounts of subangular grey granite, mafic igneous, red sandstone and soft grey siltstone. The matrix is a micaceous sandy silt and clay; clay mineralogy is largely kaolinite, illite-smectite and minor glauconite."@en ;
    lexicon:hasLowerBoundaryDefinition "The unit rests on, and locally grades down into, and incorporates rafts of glauconitic Moreseat Sandstone Formation (Lower Cretaceous)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 2m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, unconformable contact with compressed humified peat and organic sand of the Berry Peat Bed, where the upper part of the till is mottled (weathered)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Corse Of Balloch Member"@en ;
    skos:broader namedrockunit:BCAG ;
    skos:definition "Clay with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CFTI"@en ;
    skos:prefLabel "Camp Fauld Till Formation"@en ;
.

