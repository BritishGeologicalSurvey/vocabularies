namedrockunit:GNSV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Volcaniclastic sedimentary rocks and tuffs. Tephra cones at Clachan of Campsie [NS 610 797] and Craigton [NS 525 770] cause the unit to thicken to over 50 m. West of Greenside [NS 452 747] up to 40 m of lacustrine mudstones containing fossil fish and plant remains and thin coal seams are found near the top of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "The Loch Humphrey Borehole [NS 4592 7555] penetrated the lowest 20 m of the Greenside Volcaniclastic Member which overlies lavas of the Carbeth Lava Member. There is an unconformity between the two units and elsewhere the Greenside Member rests directly upon the Auchineden Lava Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Mostly 5-10 m but up to 55 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Greenside Volcaniclastic Member is overlain by the lavas of the Cochno Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Tuff and volcaniclastic-sedimentary-rock with subsidiary mudstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GNSV"@en ;
    skos:prefLabel "Greenside Volcaniclastic Member"@en ;
.

