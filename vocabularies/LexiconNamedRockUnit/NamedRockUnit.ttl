namedrockunit:ABI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Iron-ooidal grainstone and sandy packstone, muddy sandstone, clean sandstone and mudstone. Bioturbated and bioclastic in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "A disconformable boundary with the underlying Sandsfoot Grit Member (Sandsfoot Formation), marked, in the stratotype area, by the upward lithological change from sandstone with erosion surfaces to iron-ooid packstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1 ,
        namedrockunit:H2 ,
        namedrockunit:H3784 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "35 to 40m present around Abbotsbury village. Up to 8.4m visible in exposure near Abbotsbury [SY 576 856](Wright and Cox, 2001, p. 61). Up to 57m present in the BGS Abbotsbury boreholes."@en ;
    lexicon:hasUpperBoundaryDefinition "A conformable junction of the formation with the overlying Kimmeridge Clay Formation, marked by the upward lithological change from sandstone and muddy sandstone to mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasYoungestAgeValue 1.492e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Abbotsbury Iron Ore [Obsolete: use ABI]"@en ,
        "Abbotsbury Ironstone [Obsolete: use ABI]"@en ,
        "Passage Beds (Formation) [Obsolete: use ABI]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Muddy sandstone, mudstone, ooid-ironstone and sandstone with subsidiary ferruginous sandstone. Stratified bedrock. Occurs onshore. Deposited during the Kimmeridgian Age (Jurassic Period) (154.8-149.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ABI"@en ;
    skos:prefLabel "Abbotsbury Ironstone Formation"@en ;
.

namedrockunit:ACCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey calcareous mudstone, becoming more shelly and shell-detrital upwards, grading into pyritic shell bed (Comptoni Bed), overlain by brownish grey shaly mudstone (at type section) or grey calcareous mudstone with pale grey ovoid argillaceous limestone nodules and burrowed top (from Bedfordshire south) ( Acutistriatum Bed). Comptoni Bed has rich fauna of oysters, nuculacean bivalves, belemnites, and ammonites (including Binatisphinctes comptoni). Acutistriatum Bed fauna is rich in forams, and includes ammonites, notably species of  Kosmoceras, including K. acutistriatum"@en ;
    lexicon:hasLowerBoundaryDefinition "Passage up from relatively unfossiliferous brownish grey mudstone of undifferentiated Peterborough Member into shelly mudstone with fauna of Comptoni Bed as described under Lithology; base of Bed 37 in type section (Hudson and Martill, 1984, p.118)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1943 ,
        namedrockunit:H2557 ,
        namedrockunit:S840 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.3 to 0.6 m; 0.45 m at type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up from brownish grey mudstone with fauna of Acutistriatum Bed, as described under Lithology, into greenish grey mudstone of undifferentiated Peterborough Member, top is burrowed; top of Bed 38 in type section (Hudson and Martill, 1994, p. 118)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Acutistriatum Band [Obsolete: use ACCO]"@en ,
        "Acutistriatum Bed [Obsolete: use ACCO]"@en ,
        "Comptoni Bed [Obsolete: use ACCO]"@en ;
    skos:broader namedrockunit:PET ;
    skos:definition "Mudstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ACCO"@en ;
    skos:prefLabel "Acutistriatum-Comptoni Bed"@en ;
.

