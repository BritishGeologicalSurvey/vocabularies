    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 6 m in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Top taken at change up from sandy ooidal limestone or calcareous mudstone of the Pusey Flags Member into grey or brown sandy mudstone (Highworth Clay Member, where present) or sand or sandstone with ooids (Highworth Grit Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pusey Flags [Obsolete: use PYF]"@en ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Ooid-limestone with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PYF"@en ;
    skos:prefLabel "Pusey Flags Member"@en ;
