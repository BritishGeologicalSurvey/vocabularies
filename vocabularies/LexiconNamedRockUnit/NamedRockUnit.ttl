namedrockunit:BUF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "An olistrostrome deposit comprising disrupted, sheared and folded mudstone, siltstone and sandstone turbidite olistoliths. There are two members near the middle of the Formation, the Goats Gill Member, a sedimentary breccia and the sandstone-dominated Robinson Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "1500m+"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is tectonic and overthrust by rocks of the Crummock Water Aureole."@en ;
