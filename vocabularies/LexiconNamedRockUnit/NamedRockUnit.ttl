namedrockunit:SWUCM
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PSUCM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey (productive) coal-bearing mudstones/siltstones with seatearths and minor grey, quartz-rich sandstones, coals and ironstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Formation is placed at the top of the Cambriense (Upper Cwmgorse) Marine Band. Mid-grey mudstones or siltstones conformably overlie darker grey, fossiliferous mudstones of the Cambriense Marine Band, which mark the top of the underlying South Wales Middle Coal Measures (Stubblefield and Trotter, 1957)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H366 ,
        namedrockunit:H4912 ,
        namedrockunit:UCM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to a maximum of 184 m, southwest of Ammanford [SN 58 09]."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is placed at the incoming of the first thick (over c. 3 m) lithic arenite (\"Pennant Sandstone\"), where the arenite rests conformably but diachronously on grey mudstones/siltstones at the top of the South Wales Upper Coal Measures Formation. On the east crop of the coalfield, the top is placed at the diachronous incoming of red/green mottled mudstones, which mark the base of the Deri Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Llynfi Beds [Obsolete: use SWUCM, LLFB]"@en ,
        "Pennine Upper Coal Measures Formation and South Wales Upper Coal Measures Formation (Undifferentiated)"@en ,
        "Upper Coal Measures Formation [Obsolete: use PUCM, SWUCM, UCMS]"@en ,
        "Upper Coal Measures [Obsolete: use SWUCM]"@en ;
    skos:broader namedrockunit:SWCM ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone, seat-earth mudstone and seat-earth sandstone and trace coal and ironstone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage - to - Asturian Substage (Carboniferous Period) (314.75-307.5 Ma BP)."@en ;
