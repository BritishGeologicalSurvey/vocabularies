    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:RSR ,
        namedrockunit:SCD ;
    skos:notation "LME"@en ;
    skos:prefLabel "Lingmell Tuff Formation"@en ;
