namedrockunit:KLTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, yellowish brown, reddish brown or dark grey, silty sandy clayey diamicton containing angular to rounded clasts up to boulder size of rocks derived from the southern Lake District and the Howgill Fells, including Borrowdale Volcanic Group rocks (rhyolite, welded tuff, slate), granite, wacke sandstones and siltstones of the Windermere Supergroup and locally, Carboniferous basal conglomerate and limestone. Large erratics are ubiquitous, both as individuals and forming trains. They range in size up to 3x2x1m, consisting commonly of Silurian wacke sandstone, but also including Borrowdale volcanic rocks and Shap granite."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, irregular, unconformable contact with underlying bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "<5m to >40m in drumlins"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally at surface or overlain unconformably by a variety of Flandrian sediments, including peat and alluvium. Locally unconformably overlain by glaciofluvial sand and gravel."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BLGL ;
    skos:definition "Clay with subsidiary gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KLTI"@en ;
    skos:prefLabel "Kendal Till Member"@en ;
.

