    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 400m"@en ;
    lexicon:hasUpperBoundaryDefinition "The fairly sharp base of the greywacke-pebble bearing Greywacke Conglomerate Formation above the predominantly sandstone succession of the Eastgate Sandstone Member of the Westgate Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
