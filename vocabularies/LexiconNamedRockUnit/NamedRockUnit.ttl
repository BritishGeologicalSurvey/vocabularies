    skos:broader namedrockunit:CYK ;
    skos:definition "Sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age - to - Kimmeridgian Age (Jurassic Period) (165.3-149.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FCYSD"@en ;
