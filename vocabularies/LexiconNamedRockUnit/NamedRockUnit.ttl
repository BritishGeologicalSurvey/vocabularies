namedrockunit:SRH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use YRL] \r
\r
Pink to pale grey flow-banded or flow-folded rhyolite with lithophysae locally present. Contrasts with sedimentary formations above and below."""@en ;
    lexicon:hasLowerBoundaryDefinition "At junction with calcareous siltstones of Stile End Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasOldestAgeValue 4.4925e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum thickness c. 190 metres, thins and dies out westwards over a distance of 2 km. Continues eastwards to Shap, but exposure is discontinuous and lateral variation uncertain."@en ;
    lexicon:hasUpperBoundaryDefinition "At junction with limestones of the Applethwaite Formation (Mcnamara, 1967), at several localities the formation is overlain by a conglomerate of rhyolite pebbles."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasYoungestAgeValue 4.4875e+02 ;
