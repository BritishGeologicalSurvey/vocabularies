    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Estimated to be approximately 2.5m maximum."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp to gradational upwards transition (over several cms) via finely interbedded silty sand and clay into clays of the Thorganby Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Silts and Clays of 25-Foot Drift of Vale of York [Obsolete: use BREI, LHF]"@en ;
    skos:broader namedrockunit:HEM ;
    skos:definition "Silty sand with subsidiary sand and silt and trace gravelly sand and gravelly silty sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LHF"@en ;
    skos:prefLabel "Lawns House Farm Sand Member"@en ;
