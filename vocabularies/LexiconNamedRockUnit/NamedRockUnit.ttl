namedrockunit:PUB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly a grey mudstone and siltstone, with subordinate sandstone and rare thin coals.  The sandstones are typically of lithic 'Pennant' type, but also include massive quartzose sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the Top of the Withy Mills Vein Coal in the Radstock Basin; top of the Forty Yard Vein Coal in the Pensford Basin.  Underlain conformably by grey mudstones of the Radstock Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2382 ,
        namedrockunit:H2987 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "A maximum thickness of 600 m is recorded in the Pensford Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the grey mudstone and siltstone of the Publow Member is truncated by the Permo-Triassic unconformity, overlain by the red mudstones of the Mercia Mudstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
