namedrockunit:COD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Superficial deposit of chalk dry valleys, composed of fine-grained weathered chalky silt and clay matrix with clasts of chalk and flint and some erratic pebbles. \r
\r
Coombe deposits are solifluction and gelifluction deposits (head) found in some valleys on chalk and other limestone bedrock (called coombe rock, where cemented)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Variable lithology. Scree and solifluction deposits in some chalk valleys ('Coombe Rock' where cemented). [Generic description: 'TMOS' Procedures]."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4561 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasThicknessDescription "Typically 1 to 2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper surface, or may be overlain by more-recent superficial deposits."@en ;
