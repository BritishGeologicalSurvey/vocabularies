namedrockunit:NNH
    a skos:Concept ;
    lexicon:hasLithologyDescription "Chlorite-muscovite schist and phyllite, semipelite predominates with subsidiary psammite. Metabasaltic rock and calcsilicate rock locally. Abundant sheet-like units of metamafic rock (amphibolite) occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Rhoscolyn Formation (NSR)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EF> ;
    lexicon:hasOldestAgeValue 4.97e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "2000 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity with the Cemaes Group (CMES)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OTR> ;
    lexicon:hasYoungestAgeValue 4.771e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:NHI ;
    skos:definition "Stratified bedrock. Occurs onshore. Deposited during the Furongian Epoch (Cambrian Period) - to - Tremadocian Age (Ordovician Period) (497-477.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CTSG ,
        namedrockunit:NHLB ;
    skos:notation "NNH"@en ;
    skos:prefLabel "New Harbour Formation"@en ;
.

namedrockunit:NOE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MBAR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Three lithologies with oceanic affinities are juxtaposed: (i) metabasalt, commonly spilitised, locally retaining pillows, metamorphosed to chlorite-schist over much of the outcrop; (ii) chert, brownish, pyritic in places, with cavities filled with yellow limonite; (iii) black slaty pelite rich in iron oxides, weathering reddish away from stream sections."@en ;
    lexicon:hasLowerBoundaryDefinition "No lower stratigraphical boundary identifiable."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DCHV ,
        namedrockunit:H2340 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Outcrop belt 600m wide: thickness unknown."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by Margie Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasYoungestAgeValue 4.6125e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Jasper and Green-Rock Series [Obsolete: use NOE]"@en ,
        "Volcanic Rocks and Black Shales (Highland Border Complex) [Obsolete: use NOE]"@en ;
    skos:broader namedrockunit:HBX ;
    skos:definition "Basalt, chert, pelite and schist with subsidiary psammite and trace metabasalt, metabasaltic-rock, metachert and metaconglomerate. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series - to - Abereiddian Stage (Ordovician Period) (486.5-461.25 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NOE"@en ;
    skos:prefLabel "North Esk Formation [Not Same As NES]"@en ;
.

namedrockunit:NOL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
