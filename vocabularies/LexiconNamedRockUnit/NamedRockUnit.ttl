namedrockunit:MCSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to dark grey, sporadically greenish, micaceous and pyritic mudstone with common current ripple-bedded sandy wisps. Common beds of grey, fine-grained, disturbed, glauconitic sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Sedimentary break. Basal conglomerate with mudstone clasts and quartz pebbles rests on dark grey mudstone of Abbey Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2316 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasOldestAgeValue 5.08e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "General range 30 - >75m. 58m in reference section."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational with Outwoods Formation. Taken at level below which dark pyritic mudstone, typical of Outwoods Formation, becomes insignificant."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasYoungestAgeValue 4.99e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mancetter Grits and Shales [Obsolete: use MCSH]"@en ;
    skos:broader namedrockunit:SSH ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the St David's Series (Cambrian Period) (508-499 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:STPC ;
    skos:notation "MCSH"@en ;
    skos:prefLabel "Mancetter Shale Formation"@en ;
.

namedrockunit:MDGT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CSSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use MN, SAML, SILS] A group of grit and shales."@en ;
