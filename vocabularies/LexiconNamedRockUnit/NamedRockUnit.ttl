        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Suite of glacial, glaciofluvial and glaciolacustrine deposits that contain clasts derived predominantly from offshore of the Aberdeenshire coast (calcareous siltstone, limestone, red sandstone, shell fragments), including clayey diamictons (till), sand, gravel, silt and clay. Deposited from ice that pushed onshore from the North Sea Basin."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1013 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with units of the Logie-Buchan and East Grampian Glacigenic subgroups."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Red Series [Obsolete: use MDR, LBD, MEAG, LBAG]"@en ;
    skos:broader namedrockunit:ALBI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:BECL ;
    skos:notation "LBAG"@en ;
    skos:prefLabel "Logie-Buchan (Albion) Glacigenic Subgroup"@en ;
.

namedrockunit:LBC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk) with numerous flint bands. Shell debris abundant with distinct \"pellet\" or fragmentary limestone clasts evident on weathered surfaces. Three persistent erosion surfaces divide the Larry Bane Chalk Formation into two 'Beds' (A and B). These surfaces may be treated as marl seams. Very large belemnites are a prominent feature of this formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable at a lower prominent erosion surface/marl (see Lithology) resting on the Boheeshane Chalk Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4747 ,
        namedrockunit:H4748 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "7.29m at the type-site with Bed A 2.44m and Bed B 4.85m thick. This 1:2 ratio of bed thickness is considered to be characteristic of the whole Larry Bane Chalk Formation outcrop."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable and marked by an upper prominent erosion surface/marl (see Lithology) beneath the Ballintoy Chalk Formation. Overlapped by younger members at the margins of structural highs."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Larry Bane Chalk Member [Obsolete: use LBC]"@en ,
        "Larry Bane Chalk [Obsolete: use LBC]"@en ;
    skos:broader namedrockunit:UWLF ;
    skos:definition "Chalk with subsidiary flint and limestone. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LBC"@en ;
    skos:prefLabel "Larry Bane Chalk Formation"@en ;
.

namedrockunit:LBN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Light olive-grey, irregularly bedded and flaggy, calcareous, finely micaceous, medium to coarse siltstones, with frequent bands, lenses and nodules of limestone. \r
\r
There is a marked faunal contrast between the Upper Elton and Lower Bringewood formations, with a conspicuous benthic fauna in the Lower Bringewood Formation comprising large brachiopods (including species that are common in the Wenlock), solitary rugose corals and trilobites (the Mesopholidostrophia laevigata Association). The faunal change is most marked in the Ludlow area, where the Upper Elton Formation is graptolitic, but is also noticeable where equivalents of the Upper Elton Formation have a more benthic fauna (Holland et al., 1963; Lawson and White, 1989)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The Lower Bringewood Formation is distinguished from the underlying Upper Elton Formation (UELB) by its more irregular bedding and more homogeneous lithology."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1639 ,
        namedrockunit:H4749 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is estimated to be between 50 and 60 m thick (Holland et al., 1963; Lawson and White, 1989)."@en ;
    lexicon:hasUpperBoundaryDefinition "An increase in the proportion of harder limestone to calcareous siltstone distinguishes the overlying Upper Bringewood Formation (UBB) from the Lower Bringewood Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasYoungestAgeValue 4.25e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bringewood Group [Obsolete: use LBN]"@en ,
        "Lower Bringewood Beds [Obsolete: use LBN]"@en ;
    skos:broader namedrockunit:LLUS ;
    skos:definition "Calcareous siltstone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Gorstian Age (Silurian Period) (426.7-425 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LBN"@en ;
    skos:prefLabel "Lower Bringewood Formation"@en ;
.

