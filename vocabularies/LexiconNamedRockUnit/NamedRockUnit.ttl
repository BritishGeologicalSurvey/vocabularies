namedrockunit:BNOCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S488 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Generally stiff, structureless, stony, sandy and silty diamict and clayey gravel, characteristically containing abundant Old Red Sandstone clasts (derived from Black Mountain, Fforest Fawr and the Brecon Beacons) and sparse, if any Lower Palaeozoic clasts. Subordinate stratified sand and gravel are locally present. Colour and dominant clast composition are variable and generally reflect the local bedrock geology: in the Usk Valley it is red and exclusively composed of Old Red Sandstone material."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type locality it unconformably overlies Early Devensian head deposits and Ipswichian raised beach deposits of the Pennard Formation (of Bowen, 1999); elsewhere it is generally unconformable on bedrock or regolith (Barclay et al, 2005)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3232 ,
        namedrockunit:H4481 ,
        namedrockunit:H4482 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Highly variable, locally to 25m (Waters and Lawrence, 1987)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or overlain by Late Glacial organic deposits infilling kettleholes (see Bowen, 2005, p.155)(Britannia Catchments Group), or Kenfig Formation or Gwent Levels Formation (British Coastal Deposits Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brecknockshire Drift [Obsolete: use BNOCK, LDTI]"@en ,
        "Brecknockshire Formation [Obsolete: use BNOCK, WALES]"@en ,
        "Langland Member"@en ,
        "Welsh till [Obsolete: use MNTI, PLYNT, BNOCK]"@en ;
    skos:broader namedrockunit:WALES ;
    skos:definition "Diamicton with subsidiary gravel and sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:HDTI ,
        namedrockunit:LDTI ;
    skos:notation "BNOCK"@en ;
    skos:prefLabel "Brecknockshire Glacigenic Formation"@en ;
.

namedrockunit:BO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive pale grey ooidal limestones and ooidal/crinoidal limestones. Beds of coarse crinoidal limestone in lower part and calcite mudstones in uppermost part. Locally dolomitised in lowermost part."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at gradational junction of sparsely crinoidal dolomite of underlying Black Rock Limestone Subgroup and the ooidal limestone (locally dolomitised) of the Burrington Oolite Subgroup. In the eastern Mendip Hills, taken at the incoming of the ooidal limestones above the coarse crinoidal limestones of the Vallis Limestone Formation. Both contacts need further investigation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CDGP ,
        namedrockunit:H3234 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "210 m at Burrington Combe to 230 m at Wells, thinning to a feather edge in the eastern Mendip Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the incoming of calcite mudstones and dark splintery limestones of the Clifton Down Limestone Formation above the ooidal and ooidal/crinoidal limestones of the Subgroup."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Burrington Oolite Formation [Obsolete: use BO]"@en ,
        "Clifton Down Group [Obsolete: use BO, HBO, PEMB]"@en ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Ooid-limestone with subsidiary limestone and trace calcite-mudstone and dolostone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Arundian Substage (Carboniferous Period) (346.7-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AVHL ,
        namedrockunit:HMM ,
        namedrockunit:QTWL ,
        namedrockunit:RBM ;
    skos:notation "BO"@en ;
    skos:prefLabel "Burrington Oolite Subgroup"@en ;
.

namedrockunit:BRBE
    a skos:Concept ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the group is placed at the base of the lowest bed that overlies the regional Acadian unconformity. A change of colour from red sandstones below the unconformity to pale green or buff sandstones above is common."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:ORSU ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "In Wales, the thickness of the group ranges from 45 m on the south-east crop of the South Wales Coalfield to 350 m in the Pembroke peninsula. A maximum thickness of 490 m occurs east of the Severn Estuary."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Old Red Sandstone (and of the Upper Old Red Sandstone) is placed generally at the top of the highest red bed of terrestrial facies, and at the base of limestones and mudstones of the Avon Group of the Carboniferous Limestone Supergroup, which mark the marine transgression in the early Carboniferous and the inception of shallow marine carbonate sedimentation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Old Red Sandstone Group [Obsolete: use BRBE]"@en ;
    skos:broader namedrockunit:ORS ;
    skos:definition "Stratified bedrock. Occurs onshore. Deposited during the Late Devonian Epoch (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (378.9-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:MFC ,
        namedrockunit:POB ,
        namedrockunit:QTZC ,
        namedrockunit:SES ,
        namedrockunit:SHWC ;
    skos:notation "BRBE"@en ;
    skos:prefLabel "Brecon Beacons Group"@en ;
.

namedrockunit:BREI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCV"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly yellow to pale brown and reddish yellow slightly clayey sand to silty sand with a variably developed very dusky red to black compressible peat to clayey sandy peat base. Typically composed of moderately well-sorted medium quartz grains with minor bands of finer, coarser or poorly sorted material, including finely comminuted flint and lithic clasts. Thin beds of clayey sandy peat and poorly developed fine- to medium-grained slightly gravelly clayey sand are noted towards the base of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp to gradational (over several tens of cms) transition to underlying clay, silt or sand of the Hemingbrough Glaciolacustrine Formation, gravels of the Pocklington Gravel Formation, or directly to bedrock. A moderate to well developed basal dark brown peat (Skipwith or Bielby Peat Bed) is present in some localities. The presence of sparsley disseminated fine flint gravel is noted close to the lower boundary, particularly towards the Formation's eastern limits (Bielby Sand Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CDVY ,
        namedrockunit:H1384 ,
        namedrockunit:SDVY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Average 1 to 2m but can exceed 6m in some cases."@en ;
    lexicon:hasUpperBoundaryDefinition "Typically exposed at surface beneath a thin (0.2 to 0.5m thick) sandy soil or locally overlain by alluvial and aeolian deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Breighton Cover Sand Formation [Obsolete: use BREI]"@en ,
        "Sands of 25-Foot Drift of Vale of York [Obsolete: use BIES, BREI, NABS, SKIS]"@en ,
        "Silts and Clays of 25-Foot Drift of Vale of York [Obsolete: use BREI, LHF]"@en ;
    skos:broader namedrockunit:YKC ;
    skos:definition "Clayey sand with subsidiary peat and trace gravelly clayey sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BIES ,
        namedrockunit:NABS ,
        namedrockunit:SKIS ;
    skos:notation "BREI"@en ;
    skos:prefLabel "Breighton Sand Formation"@en ;
.

namedrockunit:BREN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:TSL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, locally siliceous, mudstone with laminae and thin beds of siltstone. Scattered packets of blue-grey to grey-green coarse grained greywacke sandstone with interbedded dark grey mudstone. There are locally distributed units of tuff and basaltic lava. As mapped and defined, this formation may include parts of previously contiguous and coeval formations. Further work is needed as this formation may represent a collection of mud-prone Dinantian lithologies brought together tectonically."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is not seen; all observed contacts are tectonic."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GSTN ,
        namedrockunit:H1386 ,
        namedrockunit:H4491 ,
        namedrockunit:H719 ,
        namedrockunit:LYDD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "450 m +, but more or less due to thrusting."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is not seen; all observed contacts are tectonic."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Culm Measures and Upper Devonian Slates [Obsolete: use BREN]"@en ,
        "Greystone Formation [Obsolete: use BREN]"@en ,
        "Lydford Formation [Obsolete: use BREN]"@en ,
        "Middle Culm Measures [Obsolete: use BREN, SME]"@en ,
        "Tredorn Slate Formation"@en ,
        "Upton Wood Formation [Obsolete: use BREN]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Mudstone with subsidiary basalt, sandstone, siliceous mudstone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BREN"@en ;
    skos:prefLabel "Brendon Formation"@en ;
.

namedrockunit:BRHD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CARN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Complex thin sequence of bedded coarse calcareous sandstone, bioclastic limestone, calcarenite and shell-detrital limestone, with a distinct nodularity and well-developed hardgrounds. Glauconitic and phosphatic. Includes the Wilmington Sand Member in calcarenite facies. Subdivision: None included here, but defined by Jarvis and Woodroof (1984) as comprising the Pounds Pool Sandy Limestone, Hooken Nodular Limestone and Little Beach Bioclastic Limestone members of the Beer Head Limestone Formation ."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is disconformable and placed at the burrowed surface on the top of the Small Cove Hardground of the Upper Greensand Formation. The yellow brown very coarse-grained calcareous sandstone of the Pounds Pool Sandy Limestone (\"Member\") rests on this hardground surface."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CKM ,
        namedrockunit:H2637 ,
        namedrockunit:H4494 ,
        namedrockunit:S21 ,
        namedrockunit:S381 ,
        namedrockunit:S745 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 10.4 m at Hooken Cliffs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is disconformable at the surface of the Humble Point Hardground with the Pinnacles Member (of Jarvis and Woodroof, 1984), which is the sub-Plenus Marls Member erosion surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cenomanian Limestone [Obsolete: use BRHD]"@en ,
        "Chalk Marl [Obsolete: use WMCH, BRHD]"@en ,
        "Chloritic Marl [Obsolete: use BRHD, CBG, GLML]"@en ,
        "Hooken Nodular Limestone Member [Obsolete: use BRHD]"@en ,
        "Little Beach Bioclastic Limestone Member [Obsolete: use BRHD]"@en ,
        "Pounds Pool Sandy Limestone Member [Obsolete: use BRHD]"@en ;
    skos:broader namedrockunit:GYCK ;
    skos:definition "Calcarenite and limestone with subsidiary calcareous sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRHD"@en ;
    skos:prefLabel "Beer Head Limestone Formation"@en ;
.

namedrockunit:BRNT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
