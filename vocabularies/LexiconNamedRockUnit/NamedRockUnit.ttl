        "Northampton Sand [Obsolete: use NS]"@en ,
        "Variable beds of Northampton Sand [Obsolete: use NS]"@en ,
        "Wroot Formation"@en ;
    skos:broader namedrockunit:INO ;
    skos:definition "Ferruginous limestone, ferruginous mudstone, ferruginous sandstone and ooid-ironstone with subsidiary calcareous sandstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:NSI ;
    skos:notation "NS"@en ;
    skos:prefLabel "Northampton Sand Formation"@en ;
