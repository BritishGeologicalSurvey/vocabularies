namedrockunit:WDWR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises pale to dark grey and calcareous mudstone with occasional thin interbedded sandstone and siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by a downward change pale, silty mudstone to hard oolitic limestone (Corallian Formation, Offshore) or sandstone (Seeley Formation). There is a corresponding decrease in gamma values and an increase in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Very variable in thickness up to a maximum of c. 90 m on the East Midlands Shelf (e.g. Well 47/14a-2)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downward change from dark, hard mudstone (Kimmeridge Clay Formation (Offshore)) to paler, more calcareous mudstone. On geophysical logs, the boundary is usually characterised by a down-section decrease in gamma values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HMBG ;
    skos:definition "Mudstone and trace sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WDWR"@en ;
    skos:prefLabel "Woodward Formation"@en ;
.

