    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.475m"@en ;
    lexicon:hasUpperBoundaryDefinition "Succeeded by Slockenray Hyaloclastite and Lava Formation (SLO). Distinguised by incoming of hyalocastite and basalt lava with large bladed plagioclase phenocrysts."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pinbain Formation [Obsolete: use PIN]"@en ;
    skos:broader namedrockunit:BCN ;
    skos:definition "Pillowed basalt lava and trace lithic-arenite, mudstone, siltstone and volcaniclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PIN"@en ;
    skos:prefLabel "Pinbain Lava Formation"@en ;
.

namedrockunit:PKE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red breccio-conglomerate with rare thin silty sandstone lenses. Clasts are predominantly [90%] of \"greywacke\" sandstone of pebble to cobble size, the remainder are of mudstone, chert, basalt and various granitic and gabbroic coarse-grained igneous rocks.  No serpentinite clasts are recorded, either in the primary survey by Peach and Horne in 1894 or in recent survey, which is in contrast to the publications of Pringle and Brookfield. The clasts are mostly subrounded to subangular, are contained in a siltstone or fine sandstone matrix and crudely imbricated indicating deposition from a palaeocurrent flowing towards the northwest."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the Formation not seen but faulted against Lower Ordovician igneous rocks in Ballantrae harbour."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2977 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">250m"@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary with the overlying Corseclays Sandstone Formation is concealed but inferred to be conformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ballantrae Breccia Formation [Obsolete: use PKE]"@en ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Breccia with subsidiary conglomerate and trace silty sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PKE"@en ;
    skos:prefLabel "Park End Breccia Formation"@en ;
.

