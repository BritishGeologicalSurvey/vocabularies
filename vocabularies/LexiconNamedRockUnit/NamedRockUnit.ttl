namedrockunit:MUND
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/H"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and flint gravel of marine origin. This unit has a lower frequency of far travelled material and an absence of distinctive far-travelled lithologies other than Triassic quartzose rocks and Carboniferous, Rhaxella and Greensand cherts. The lack of far-travelled materila probably reflects the distance of the mouth of the contemporary Thames from the coastal zone, and also local erosion by tributaries of the major rivers."@en ;
    lexicon:hasLowerBoundaryDefinition "Locally, unconformable on Cromer Forest-bed Formation, elsewhere unknown."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4711 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Probably up to c. 10 m, but little information available due to lack of clast lithological analysis."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by glacigenic deposits of the Sheringham Cliffs Formation with distinct change in lithology to sands and sandy, chalky tills."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bure Valley Beds and Weybourne Crag [Obsolete: use HOWH, MUND]"@en ;
    skos:broader namedrockunit:WRCG ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace shells. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MUND"@en ;
    skos:prefLabel "Mundesley Member"@en ;
.

namedrockunit:MUSM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4210 ;
