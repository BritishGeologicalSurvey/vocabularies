namedrockunit:LTW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The unit comprises:  (i) A lower unit of thinly interbedded silty fine-grained sandstones and common, though subordinate, siltstone and rare beds of clay or silty clay;  (ii) An upper unit of largely massive or thickly bedded, fine- and medium-grained sandstone (Ardingly Sandstone Member of the Tunbridge Wells Sand Formation). It is cross-bedded and festoon-bedded in part. In much of the Horsham district it is composed of \"sandrock\", a clean white or greyish white, soft quartzose sandstone that forms crags.  It becomes finer-grained towards the south of the Horsham district.  Locally, in the East Grinstead area, stringers of quartz and quartzite pebbles are common. The pebbles become larger towards Tunbridge Wells."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken where interbedded silty sandstones and subordinate siltstones of the unit rest with a sharp contact on red stained mudstones of the Wadhurst Clay Formation. Commonly a spring line is  associated with the junction."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2926 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 33m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the base of the Top Tunbridge Wells Pebble Bed, which is situated at the base of the mudstones of the Grinstead Clay Member. Where the pebble bed fails, as in the Tunbridge Wells district, the base is placed at the junction between the Grinstead Clay Member above the Ardingly Sandstone Member below. Locally ripples of coarse-grained sand separate these two members. In some districts, however, such as Tenterden (304) Hastings (320/321) and Lewes (319) where the Ardingly Sandstone Member and the Grinstead Clay Member thin out, the sands between the Wadhurst Clay Formation and the Weald Clay Formation are undifferentiated and called the Tunbridge Wells Sand Formation in BGS Memoirs and on BGS maps."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Tunbridge Wells Sand Formation [Obsolete: use LTW]"@en ;
    skos:broader namedrockunit:TWS ;
    skos:definition "Sandstone with subsidiary siltstone and trace clay. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age (Cretaceous Period) (137.7-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LTW"@en ;
    skos:prefLabel "Lower Tunbridge Wells Sand"@en ;
.

namedrockunit:LTY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ,
