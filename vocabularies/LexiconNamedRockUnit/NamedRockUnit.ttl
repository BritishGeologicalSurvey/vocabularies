namedrockunit:SBY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:MOXC ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly pale to medium grey, commonly smooth, variably silty, calcareous, poorly fossiliferous, blocky mudstones. Subordinate beds of silty mudstones packed with immature shells of the bivalve Bositra buchii (Roemer). Thin, calcareous siltstones, particularly in upper part, commonly with Gryphaea. Ammonites and other macrofauna generally pyritised."@en ;
    lexicon:hasLowerBoundaryDefinition "At top of highest brownish-grey, organic rich mudstone within thinly interbedded transition (to c.3m thick) to brownish-grey, fissile mudstones of underlying 'Lower Oxford Clay'(Peterborough Member). More or less arbitrary in field mapping."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4317 ,
        namedrockunit:MOXC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - c.50m."@en ;
    lexicon:hasUpperBoundaryDefinition "At the top of the Lamberti Limestone (where present) or an equivalent shell bed or siltstone. The horizon is clear on geophysical logs. Change in Gryphaea faunas (G.lituola, below to G. dilatata, above) and ammonite faunas. (Kosmoceras, below: Cardioceras, above) useful supportive indicators. Base of Weymouth Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Oxford Clay Member [Obsolete: use SBY]"@en ,
        "Middle Oxford Clay [Obsolete: use SBY]"@en ;
    skos:broader namedrockunit:OXC ;
    skos:definition "Mudstone with subsidiary siltstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBY"@en ;
    skos:prefLabel "Stewartby Member"@en ;
.

