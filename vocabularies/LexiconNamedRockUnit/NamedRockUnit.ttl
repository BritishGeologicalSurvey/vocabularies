namedrockunit:BAV1
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:BA1T2 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PALSOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Bathampton Gravel Member comprises gravels, 3 m thick, with a surface of about 3-5 m above the present River Avon. It is considered to be no younger than MIS 6 (Campbell, p. 77 in Bowen, 1999). \r
\r
The Bathampton Palaeosol is a cryoturbated, rubified clay-rich soil developed on the Bathampton Gravel Member. It is correlated probably with MIS 5e (Hunt, 1990; Campbell, p. 77 in Bowen, 1999)."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S371 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bathampton Gravel Member and Stidham Gravel Member Undifferentiated"@en ,
        "Bathampton Member [Obsolete: use BAV1]"@en ;
    skos:broader namedrockunit:BAVON ;
    skos:definition "Gravel with subsidiary palaeosoil. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage - to - Ipswichian Stage (Quaternary Period) (.362-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BAV1"@en ;
    skos:prefLabel "Bathampton Gravel Member"@en ;
.

