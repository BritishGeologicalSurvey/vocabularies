namedrockunit:BYCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The subgroup encompasses all the fluvial, lacustrine and organic deposits of the Proto-Soar and Bytham rivers. Deposits of four separate river terrace levels are recognised as members of the Ingham Formation. Commonly a basal sandy gravel is overlain by pebbly sands, with few clay and silt beds. The gravels of all contain a high proportion of rounded pebbles of grey and purple \"Bunter\" quartzite of Triassic derivation, and of vein quartz, Jurassic and Cretaceous rocks are local important constituents. Sedimentary structures indicate deposition by braided rivers."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock of Carboniferous to Pleistocene age."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "c.18m"@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by Middle Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is generally helpful."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DUNW ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BGSG ,
        namedrockunit:BYTH ,
        namedrockunit:ISAG ,
        namedrockunit:SMSG ;
    skos:notation "BYCA"@en ;
    skos:prefLabel "Bytham Catchments Subgroup"@en ;
.

namedrockunit:BYS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded brown and grey fine-grained sandstones, siltstones and greenish-grey shaly mudstones with thicker buff, fine- and medium-grained feldspathic and micaceous sugary sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The unit is conformable with the underlying Upcott Slates. The Baggy Sandstones sequence of grey and buff, fine- to medium-grained, thickly-bedded and massive sandstones, marked by local ferruginous staining is in sharp contact of cream, buff, green, grey and purple slates and silty slates of the underlying Upcott Slates."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BMB ,
        namedrockunit:H100 ,
        namedrockunit:H1410 ,
        namedrockunit:H1411 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 450 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable with the overlying Pilton Shales, though no sharp formation boundary lines can be traced. The top of the Baggy Sanstones, characterised by thickly-bedded and medium-grained sugary sandstones with partings of thinly-bedded micaceous sandstone, passes transitionally into the Pilton Shales, seen typically as shales and siltstones with placed at the top of the highest of the fine- to medium-grained sugary sandstones of the Baggy Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Baggy Beds [Obsolete: use BYS]"@en ,
        "Baggy and Marwood Beds [Obsolete: use BYS]"@en ,
        "Baggy and Marwood Slates [Obsolete: use BYS]"@en ,
        "Marwood Beds [Obsolete: use BYS]"@en ;
    skos:broader namedrockunit:EXM ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BYS"@en ;
    skos:prefLabel "Baggy Sandstones Formation"@en ;
.

