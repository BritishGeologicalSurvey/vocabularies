    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "2750 m approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from pelite and quartzite of the Scatsta Quartzitic Formation to the Weisdale Limestone."@en ;
