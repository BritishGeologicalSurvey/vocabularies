namedrockunit:COSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstones with interbedded siltstone and mudstone. Sandstones are quartzose, very fine- to coarse- or very coarse- grained, pale grey to white and sporadically glauconitic. Generally calcareous, although commonly friable. Interbedded mudstones and siltstones are pale to dark grey, calcareous, micromicaceous and locally carbonaceous. Sporadic white to pale grey and tan, microcrystalline and argillaceous, hard to soft limestone concretions produce high velocity spikes (e.g. well 12/30-1)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at a downward change from sandstones and siltstones with interbedded mudstones to dominantly argillaceous strata (Valhall Formation). On wireline logs there is a downward increase in gamma-ray values and, commonly, an increase in velocity (e.g. 12/30-1)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 400 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken at a downward change from pale to dark grey, calcareous mudstones (Valhall Formation) to pale grey sandstones and siltstones with interbedded mudstones. On wireline logs, it is normally a downward decrease in gamma-ray values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WISA ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace limestone. Stratified bedrock. Occurs offshore. Deposited during the Hauterivian Age - to - Barremian Age (Cretaceous Period) (132.6-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COSA"@en ;
    skos:prefLabel "Coracle Sandstone Member"@en ;
.

namedrockunit:COSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Packstone, dark grey, well bedded, blocky, partly dolomitized and bituminous, with the common occurrence of the coral Dorlodotia. Cyclically interbedded with thin mudstone and siltstone beds. The limestone beds are a fairly constant 0.75m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "At the base of limestone, overlying a 5m unit of interbedded sandstone and mudstone, which forms a topographic depression at the top of the underlying Park Hill Limestone Member. The junction is nowhere exposed now, but the interbedded unit was formerly seen in a road cutting at [NY 7248 0448] during the construction of the Ravenstonedale By-pass, and the junction was recorded in M6 Site Investigation Boreholes at [NY 5885 0998]"@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "40 to 50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the overlying Brownber Formation, where there is a change from dark grey cyclically bedded limestone to pale grey ooidal limestone and calcarenite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SCBL ;
    skos:definition "Calcilutite and limestone with subsidiary dolostone, mudstone and siltstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COSL"@en ;
    skos:prefLabel "Coupland Sike Limestone Member"@en ;
.

