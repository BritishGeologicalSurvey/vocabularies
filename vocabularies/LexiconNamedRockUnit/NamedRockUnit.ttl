    lexicon:hasThicknessDescription "Over 1000m."@en ;
    lexicon:hasUpperBoundaryDefinition "Uppermost sediments of the Orcadian Old Red Sandstone sequence. (Top everywhere eroded)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:EDY ;
