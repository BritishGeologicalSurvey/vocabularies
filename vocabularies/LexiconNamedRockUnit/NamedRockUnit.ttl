    skos:broader namedrockunit:DORN ;
    skos:definition "Mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Late Paleocene - to - Early Eocene (Palaeogene Period) (59.2-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DHMU"@en ;
    skos:prefLabel "Dornoch Mudstone unit"@en ;
