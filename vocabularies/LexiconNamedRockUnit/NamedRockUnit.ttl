namedrockunit:CLSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fawn to pale brown, coarse- to very coarse-grained, lithic arkose to subarkose with pebbly horizons, thin to very thick beds; slumped cross-bedded channels, basal conglomerate with calcrete nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Variable; either resting unconformably on Dalradian Supergroup metamorphic rocks or unconformably overstepping older Carboniferous strata, everywhere with a basal conglomerate."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H136 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
