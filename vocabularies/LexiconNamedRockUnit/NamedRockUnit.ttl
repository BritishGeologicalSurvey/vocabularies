namedrockunit:NYGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, bryozoan-rich reef limestone (bafflestone/framestone).  Early Asbian buildup of trepostome bryozoan rich limestones at the margin of the North Wales Dinantian carbonate platform."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen, but presumed to be a contact between massive, bryozoan-rich, reef limestones and underlying well-bedded, extensively dolomitised liestones (peloidal and skeletal grainstones) of the Llanarmon Limestone Formation"@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Contact between \"massive reef\" limestones and well bedded, extensively dolomitised limestones (peloidal and skeletal grainstones) of the Llanarmon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LNML ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NYGL"@en ;
    skos:prefLabel "Nant-y-Gamar Limestone Member"@en ;
.

namedrockunit:O
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thick marine mudstone and siltstone, with the the Orchard Limestone near the base."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a change from fluvial sandstone and overlying seatearth or coal, if present, to marine mudstone within the Upper Limestone Formation."@en ;
