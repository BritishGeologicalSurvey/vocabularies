        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFASST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, coarse-grained, buff, brown or blue-grey tuffaceous sandstones in at least four beds, interbedded with greenish grey and purple mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Uncertain.  Considered by Greig et al (1968) to rest unconformably on the Ragleth Tuff Formation, but Cobbold and Whittard (1935) and Pauley (1991) suggested a conformable contact based on lithological similarities with the underlying rocks. The base is marked by a sharp transition from lithic tuffs and interbedded purple mudstones of the Ragleth Tuff Formation, the boundary being taken at the base of the first massive sandstone bed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3469 ,
        namedrockunit:YSHH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Uncertain. Pauley (1991) considered the possibility of an unconformity with the overlying Stretton Shale Formation at this level on the basis of variations in dip between the two units. Accordingly he placed the Helmeth Grit as a Member in the upper part of the Ragleth Tuff Formation.  The boundary is therefore taken at the top of the highest coarse-grained sandstone bed beneath the pale greenish grey mudstones of the Stretton Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Helmeth Grit [Obsolete: use HLG]"@en ,
        "Helmeth Grits [Obsolete: use HLG]"@en ,
        "Watling Shales"@en ;
    skos:broader namedrockunit:RT ;
    skos:definition "Mudstone with subsidiary tuffaceous-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HLG"@en ;
    skos:prefLabel "Helmeth Grit Member"@en ;
.

namedrockunit:HMB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone with subordinate interbedded calcareous mudstone ('marl'); limestone characteristically grey to brown, thinly bedded, fine- to very fine-grained, well-sorted, ooidal grainstone to packstone, commonly slightly sandy or silty, with small-scale cross-bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "Well bedded fine-grained limestone and calcareous mudstone, resting sharply on cross-bedded coarse-grained ooidal grainstone of the Taynton Limestone Formation or on mudstone/sandy limestone of the Fuller's Earth Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2243 ,
        namedrockunit:H320 ,
        namedrockunit:H3471 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 4-11 m; 8.96 m at type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "More or less sharp boundary between interbedded fine-grained limestone and calcareous mudstone, overlain by purer, off-white or yellowish peloidal packstone, wackestone or grainstone of the White Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hampen Marly Beds [Obsolete: use HMB]"@en ,
        "Hampen Marly Formation [Obsolete: use HMB]"@en ,
        "Marly Beds [Obsolete: use HMB]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Calcareous mudstone and limestone with subsidiary mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HMB"@en ;
    skos:prefLabel "Hampen Formation"@en ;
.

