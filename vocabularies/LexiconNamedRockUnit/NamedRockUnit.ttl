namedrockunit:NUNV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BTLAVA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Nun Volcanics Formation comprises altered, red to purple, fine-grained, strongly vesicular ?trachyandesitic lavas with a felsic groundmass and abundant microphenocrysts of plagioclase."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is not defined, as no wells have penetrated it."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Nun Volcanics Formation has only been encountered in well 205/27a-1 on the Solan Bank High, where it attained an unbottomed thickness of only 1.6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Nun Rock Volcanics Formation is marked by a downward change from Solan Bank Formation pebbly or conglomeratic sandstones, to lavas. No wireline logs were run within the Nun Volcanics Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RLG ;
