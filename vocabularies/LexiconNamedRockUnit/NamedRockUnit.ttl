namedrockunit:BW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone and siltstone, micaceous, fine-grained, grey-weathering and argillaceous in lower part, yellow-weathering and silty in upper part. In the Rosedale, Farndale, Fryup Dale and Danby Dale area, includes thin beds of ooidal ironstone at the top and between the grey and yellow sandstone and siltstone units (see Supplementary Information)."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational; rapid upward transition from dark grey mudstone of the Whitby Mudstone Formation to paler burrow-mottled silt- and sand-rich sediment."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2034 ,
        namedrockunit:H2035 ,
        namedrockunit:H2651 ,
        namedrockunit:H2652 ,
        namedrockunit:H3259 ,
        namedrockunit:H3885 ,
        namedrockunit:H98 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "15.6 to 18.0 m at Ravenscar, generally up to about 10 m in Rosedale area, locally possibly up to 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity: base of ferruginous, pebbly sandstone of the Dogger Formation (Middle Jurassic) on ooid-ironstone beds of Rosedale Ironstone Member (Rosedale area) or yellow-weathering fine-grained sandstone of Yellow Sandstone Member (Ravenscar area)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
