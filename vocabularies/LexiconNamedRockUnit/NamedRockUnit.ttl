namedrockunit:TBF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown and grey clays, ooidal and glauconitic in part, with a sandy limestone in the middle part of the formation.  It can be divided into three units.  Lower unit. Blue-grey clay, glauconite-rich at some horizons and silty ooidal in the lower part [Lower Tealby Clay Member]  Middle unit.  Comprises sandy limestones and oolitic clays [Tealby Limestone Member].  The limestones are thicker and more indurated in northern Lincolnshire, becoming thinner, softer and more argillaceous towards the south.  Upper unit.  Grey and buff clays, silty at some horizons and locally glauconitic [Upper Tealby Clay Member].  Locally, ooidal horizons occur at the top."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is an erosion surface where there is a downsection change from blue-grey clay, glauconite-rich at some horizons and silty and ooidal in the lower part [Lower Tealby Clay Member] to clayey, ooidal ironstone [Claxby Ironstone Formation]."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1217 ,
        namedrockunit:TYB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 31m."@en ;
    lexicon:hasUpperBoundaryDefinition "In southern Lincolnshire and The Wash a rhythmic succession of interburrowed and interbedded clay, \"chamosite\" mud, chamosite ooids, quartz sand and small pebbles of quartz and ironstone [Roach Formation] rest on grey and buff clays, silty at some horizons, locally glauconitic or ooidal [Upper Tealby Clay Member].  In central to northern Lincolnshire ferruginous, sandy limestone and ferruginous, oolitic mudstones [Roach Formation] rest on grey and buff clays, silty at some horizons, locally glauconitic or ooidal [Upper Tealby Clay Member]  In northern Lincolnshire, between Nettleton Top and Audleby, sandstones of the overstepping Carstone Formation rest on the limestones of the Tealby Limestone Member, and between Audleby and Clixby the arenaceous Carstone Formation rests on mudstones of the Lower Tealby Clay."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Greystone [Obsolete: use TAL, TBF]"@en ,
        "Tealby Beds [Obsolete: use TBF]"@en ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hauterivian Age - to - Barremian Age (Cretaceous Period) (132.6-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LTC ,
        namedrockunit:TAL ,
        namedrockunit:UTBC ;
    skos:notation "TBF"@en ;
    skos:prefLabel "Tealby Formation"@en ;
.

namedrockunit:TC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominated by red sandstone: coarse in Applecross Formation; fine-medium in Aultbea Formation. Thick-bedded, cross-bedded and commonly contorted. Subordinate pebble conglomerate and thin grey siltstones. Planar and cross-bedding are common, with co-sets typically 0.5-1 m thick, locally up to 3-6 m. Soft-sediment deformation is common and ubiquitous in the Aultbea Formation. The higher Cailleach Head Formation comprises thinly bedded mudstones and siltstones in coarsening upwards cycles."@en ;
    lexicon:hasLowerBoundaryDefinition "Upon Kinloch Formation (TBK) (Sleat Group - TB) via minor unconformity: elsewhere with angular unconformity upon Stoer group (TA) or Lewisian Gneiss (L)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3073 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "c. 4000-6000 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed, eroded. Unconformably overlain by Cambrian Ardvreck Group quartz arenite (ARDV)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Torridon Sandstone [Obsolete: use TC]"@en ;
    skos:broader namedrockunit:WROS ;
    skos:definition "Sandstone with subsidiary conglomerate and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:TCA ,
        namedrockunit:TCAU ,
        namedrockunit:TCC ,
        namedrockunit:TCD ;
    skos:notation "TC"@en ;
    skos:prefLabel "Torridon Group"@en ;
.

