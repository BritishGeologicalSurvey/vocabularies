namedrockunit:PBS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Uniformly fine-grained, friable, well-sorted, fossiliferous sandstone; rarely cross-bedded, grey when fresh, yellowish-brown when weathered. Sparse coarse grains can be present near base. Coarse ferruginous sand locally present at top. Thin clay beds in places."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is identified at the upward change from poorly sorted sands, typically pebbly, limonitic and/or clayey (locally at a pebbly sandy clay), of the Fittleworth Member, Selham Ironshot Sands Member or the Rogate Member, to dominantly fine-grained, well-sorted sands."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H443 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 35m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the type area, the upper boundary is taken at the top of a thin cemented ironstone beneath the clays and silts of the Marehill Clay Member; around Petersfield it is at the change from mainly sand to mainly grey silty clay in a short gradational sequence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sandgate Beds [Obsolete: use PBS, SAB]"@en ;
    skos:broader namedrockunit:SAB ;
    skos:definition "Sandstone and trace clay and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:PBSL ,
        namedrockunit:PBSU ;
    skos:notation "PBS"@en ;
    skos:prefLabel "Pulborough Sandrock Member"@en ;
.

