namedrockunit:THM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fossiliferous, dark grey, calcareous mudstone and highly argillaceous limestone. The Tollhouse Mudstone is a widely recognised bed of marine mudstone occurring within the late Asbian platform carbonate succession of North Wales. Recognised on Anglesey and at Llandudno, it appears to record a temporary cessation of limestone deposition and (or caused by) an increase in the volume of terrigenous mud supplied to this northwestern portion of the platform."@en ;
    lexicon:hasLowerBoundaryDefinition "In its type section, the base is taken at the contact between the mudstone and underlying dolomitised limestones (formerly part of the Llandudno Pier Dolomite, but now included in the Loggerheads Limestone Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 2m"@en ;
    lexicon:hasUpperBoundaryDefinition "In its type section, the top is taken at the entry of overlying, pale, thick-bedded limestones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LGHL ;
    skos:definition "Mudstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THM"@en ;
    skos:prefLabel "Tollhouse Mudstone Bed"@en ;
.

