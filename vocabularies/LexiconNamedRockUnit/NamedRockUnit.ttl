    skos:definition "Andesitic lapilli-tuff and andesitic tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THW"@en ;
    skos:prefLabel "Tarn Hows Tuff Formation"@en ;
.

namedrockunit:TIS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
