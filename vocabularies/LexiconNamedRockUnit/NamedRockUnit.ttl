namedrockunit:CAA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded mudstones and thin siltstones with subordinate thin sandstones and bioclastic limestones."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Hills Gardens Formation where beds of interbedded siltstones and sandstone conformably rest upon sandstone and siltstone of the Caecastell Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "155 m approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of limestone of the Llanderyn Formation with mudstone, calcrete and sandstone of the Raglan Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasYoungestAgeValue 4.227e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and siltstone with subsidiary limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Gorstian Age - to - Ludfordian Age (Silurian Period) (426.7-422.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "CAA"@en ;
    skos:prefLabel "Cardiff Group"@en ;
.

namedrockunit:CAAS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown to green-grey, medium to thick-bedded, medium- to coarse-grained sandstones, pebbly sandstones and conglomerates with low angle cross-bedding, with laminated to thinly bedded sequences of green or red mudstone and siltstone and thin, sharp-based and graded sandstone beds. Numerous reddened beds of poorly sorted structureless mudstone, siltstone and argillaceous sandstone with red to grey mottles along roots."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity with weathered, green mudstones of the Stockingford Shale Group, overlain by 13 m of thick basal conglomerate, commonly containing volcanic pebbles."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as 70.6 m thick in the Ticknall Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Marine flooding surface, overlain by green to grey, fine- to medium-grained sandstone with pebble-rich lenses, and shelly lags of Lingula of the Arch Farm Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "CAAS"@en ;
    skos:prefLabel "Calke Abbey Sandstone Formation"@en ;
.

