    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 1010m."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the base of the overlying formations that comprise a mixed succession of bedded pyroclastic rocks and volcaniclastic sandstones including: Lingmell Formation in the Central Fells, and the Duddon Hall Formation in the Coniston and Ulpha areas."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
