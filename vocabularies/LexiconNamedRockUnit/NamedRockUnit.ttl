    lexicon:hasUpperBoundaryDefinition "Gradational boundary with the Meall Dubh Graphitic Schist Formation with admixture of graphitic and calc-schists is poorly exposed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
