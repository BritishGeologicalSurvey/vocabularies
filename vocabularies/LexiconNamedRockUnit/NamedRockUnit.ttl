namedrockunit:CMBN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale greyish olive, greenish grey and greyish red mudstones and thin beds of olive-grey and purplish siltstones, locally containing marine fossils. One interbedded unit of greyish orange to greyish red quartose sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Faulted out by the Carmichael Fault."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H141 ,
        namedrockunit:H3946 ,
        namedrockunit:H3947 ,
        namedrockunit:H4515 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.168m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of the predominantly mudstone succession of the Carmichael Burn Formation below the fairly sharp incoming of the Fence Conglomerate Member of the Westgate Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
