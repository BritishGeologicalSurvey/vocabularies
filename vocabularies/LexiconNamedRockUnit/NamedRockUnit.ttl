namedrockunit:AMC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:WWAC ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, mainly smooth or slightly silty, pale to medium grey with argillaceous limestone (cementstone) nodules; some rhythmic alternations of dark grey mudstone in the lower part; topmost beds are typically pale grey marls with cementstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of mudstones (as described under Lithology), resting on darker more silty mudstone of the West Walton Formation or on limestone/sandstone of that formation's members (Upware Limestone, Elsworth Rock) or of the Corallian Group; generally a marked colour change and break of slope at outcrop; change commonly well-marked on borehole geophysical (particularly gamma-ray) logs. Base of unit AmC1 in Fenland (Cox and Gallois, 1979)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2563 ,
        namedrockunit:H3164 ,
        namedrockunit:H3798 ,
        namedrockunit:H4426 ,
        namedrockunit:H4427 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c.90m; typically c.25m in Oxon-Bucks., c.10m in the Bedfordshire type section; c.50m in Fenland, c.90m in north Lincolnshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change to darker mudstone of the Kimmeridge Clay Formation; commonly an erosive non-sequence marked by phosphatic pebbles; generally a marked colour change and break of slope at outcrop; change comonly well-marked on borehole geophysical (particularly gamma-ray) logs. Top of unit AmC42 in Fenland (Cox and Gallois, 1979), but incomplete and succeeded unconformably by Cretaceous rocks in the vicinity of the type section."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ampthill Clay [Obsolete: use AMC]"@en ,
        "Bluntisham Clay [Obsolete: use AMC]"@en ,
        "Corallian [Obsolete: use AMC, WWB]"@en ,
        "Gamlingay Clay [Obsolete: use AMC]"@en ,
        "Tetworth Clay [Obsolete: use AMC]"@en ,
        "West Walton Formation and Ampthill Clay Formation (Undifferentiated)"@en ;
    skos:broader namedrockunit:AMG ;
    skos:definition "Mudstone with subsidiary calcareous mudstone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RDDI ;
    skos:notation "AMC"@en ;
    skos:prefLabel "Ampthill Clay Formation"@en ;
.

