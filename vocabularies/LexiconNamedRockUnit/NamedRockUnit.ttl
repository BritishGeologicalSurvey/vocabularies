namedrockunit:BBLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale to dark grey, crinoidal, bioclastic, argillaceous limestone interpreted to be of marine origin generally with a massive lower portion and a thinly  bedded upper part, and is a name applied to limestone beds within the Balgrochan Beds., which are mostly mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Usually seen as a change from an apparently marine mudstone, known as the Balgrochan Beds, in the Lawmuir Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DULS ,
        namedrockunit:H42 ,
        namedrockunit:MULS ,
        namedrockunit:STUL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Generally up to 0.35m thick, and possibly up to 7.0m in the Paisley and Glasgow districts. Elsewhere, the unit is represented by the Balgrochan Beds."@en ;
    lexicon:hasUpperBoundaryDefinition "Mostly identified by a change to probable marine mudstone of the Balgrochan Beds in the Lawmuir Formation overlain by non-marine strata locally including the freshwater Baldernock Limestone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Douglas Under Limestone [Obsolete: use BBLS]"@en ,
        "Muirkirk Under Limestone [Obsolete: use BBLS]"@en ,
        "Nodular White Limestone [Obsolete: use BBLS]"@en ,
        "Stonehouse Under Limestone [Obsolete: use BBLS]"@en ;
    skos:broader namedrockunit:LWM ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BBLS"@en ;
    skos:prefLabel "Blackbyre Limestone"@en ;
