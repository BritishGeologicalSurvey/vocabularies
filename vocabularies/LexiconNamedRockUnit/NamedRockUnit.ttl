    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "As defined in the type-site the beds are 1.4m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The exact relationship with the overlying Galboly Chalk Formation is not certain (Fletcher, 1978 p.8 para. 2). It is taken at a well-developed separation plane below which the beds contain arenaceous \"contamination\"."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasYoungestAgeValue 8.37e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cloughfin Sponge Bed Member [Obsolete: use CSP]"@en ,
        "Sponge Bed [Obsolete: use CSP]"@en ,
        "Spongiarian Zone [Obsolete: use CSP]"@en ;
