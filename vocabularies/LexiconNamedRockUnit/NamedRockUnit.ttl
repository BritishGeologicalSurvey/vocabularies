namedrockunit:SKAD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Skade Formation consists of fine to coarse grained, often shelly sandstone with subordinate beds of brown silty mudstones or siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "In distal sections, the base of the Skade Formation is marked by a downward transition from sandstone to brown-grey or grey-brown mudstone of the Lark Formation. In more proximal sections, in which the Lark Formation is absent, the base of the Skade Formation is marked by a downward change from highly glauconitic silty mudstone to sandstone of the Mousa Formation. Normal wireline log responses are displayed in both cases, except that a high-gamma peak is commonly present at the base of the Skade Formation in proximal sections, reflecting the high glauconite content. The sandstone unit at the top of the underlying Mousa Formation is also glauconite-rich, but displays distinctly lower gamma-ray values e.g. 14/19-8 and 15/21-1)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasOldestAgeValue 3.39e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Rarely exceeds 200 m in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Skade Formation is typically marked by a downward change from green-grey, glauconitic, silty mudstone (Nordland Group) to shelly sandstone. The boundary is marked by a downhole decrease in gamma values, with a distinct high-gamma peak often occurring in the basal sediments of the Nordland Group. Where sandstone is present at the base of the overlying Nordland Group (Utsira Formation), the boundary may be difficult or impossible to define (but refer to the Nordland Group for comments concerning the status of the Utsira Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NM> ;
    lexicon:hasYoungestAgeValue 5.33e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WESY ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Oligocene Epoch (Palaeogene Period) - to - Miocene Epoch (Neogene Period) (33.9-5.33 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKAD"@en ;
    skos:prefLabel "Skade Formation"@en ;
.

namedrockunit:SKAS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Skadan Sandstone Member consists of fine to medium grained sandstone interbedded with medium to dark grey siltstone and mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Where mudstone is present at the base of the Sele Formation (e.g. 16/8-1), the base of the Skadan Sandstone Member is taken at a sharp downward change from sandstone to dark grey mudstone, associated with an increase in gamma-ray values and decrease in velocity. In a few sections the sandstone rests directly on Lista mudstone (e.g. 16/7a-14)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Less than 30 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Skadan Sandstone Member is taken at a sharp downward change from dark grey laminated mudstone to sandstone, associated with a decrease in gamma-ray values. Low-gamma mudstones of Sele unit 1b commonly overlie the sandstone (e.g. 16/7a-14, 16/8-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SELE ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKAS"@en ;
    skos:prefLabel "Skadan Sandstone Member"@en ;
.

