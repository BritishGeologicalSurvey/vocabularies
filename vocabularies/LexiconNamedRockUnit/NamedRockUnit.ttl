namedrockunit:CHVG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Suite of sandy diamictons (till, morainic and solifluction deposits), sand, gravel, silt and clay originating from the Cheviot Hills. The deposits contain clasts derived predominantly from volcanic and intrusive rocks (basalt, andesite and granite) of the Cheviot Hills. Varying proportions of Lower Palaeozoic wacke sandstone and siltstone are also present near the western limits of the subgroup. Tills are generally matrix-supported diamictons with characteristically brownish grey or yellowish grey matrices. However, locally they can be reddish brown either where the diamictons are weathered or are derived from red strata (e.g. Devonian outcrops)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with bedrock. Bedrock is commonly weathered to depths of several metres."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasOldestAgeValue 2.6e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with peat or fluvial deposits of the Britannia Catchments Group (Tweed Catchments or Northumbria Catchments subgroup)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasYoungestAgeValue 1.47e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CALI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Dimlington Stadial (Quaternary Period) (.026-.0147 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:KWTI ;
    skos:notation "CHVG"@en ;
    skos:prefLabel "Cheviot Glacigenic Subgroup"@en ;
.

namedrockunit:CHVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAMCP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Consists of pale greenish-grey to grey, amygdaloidal, earthy weathered to hard microporhyritic olivine basalt (Dalmeny type) lava flows and beds of grey and \"pink\" volcaniclastic airfall and/or waterlain lapilli tuff. Beds of limestone and mudstone are known very locally (as on Meadulse)."@en ;
    lexicon:hasLowerBoundaryDefinition "Defined at the base of the lowest lava flow or bed of volcaniclastic rock resting on non-cyclic fluvial and lacustrine sedimentary rocks of the underlying Fife Ness Formation, which consists of sandstones and mudstones with beds of carbonate (limestone and dolostone). The contact is nowhere seen and therefore might be tranistional, sharp or unconformable."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H129 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Tens of metres, but very uncertain, assessed as more than 30m thick at Charles Hill."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the highest tuff bed that is overlain by the non-cyclic sedimentary rocks of the overlying Anstruther Formation, consisting of dark grey to black lacustrine mudstones with thin beds of argillaceous ostracod-bearing limestone and dolostone and pale grey sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Charles Hill Volcanic Beds [Obsolete: use CHVO]"@en ;
    skos:broader namedrockunit:ARBS ;
    skos:definition "Basalt with subsidiary basaltic tuff, lapilli-tuff, microporphyritic basalt and olivine-macrophyric basalt and trace limestone and mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHVO"@en ;
    skos:prefLabel "Charles Hill Volcanic Member"@en ;
.

namedrockunit:CIFD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly grey mudstone and siltstone, with some reddening, coal and sandstone. The lower part of the succession is dominantly argillaceous and included relatively thick coals, including the Brazilly and Crow coals. The middle part of the member includes the Serridge Sandstone, which passes from exclusively sandstone in the north to interbedded sandstone and shale to the south. The upper argillaceous part of the member includes further coal seams (Woodgreen Coals)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the Brazilly Coal, which rests conformably upon thick-bedded, coarse-grained sandstone of the Coleford Member of the Pennant Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3300 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 180 m thick in the north, to 300 m in the south of the Forest of Dean Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "The member is the youngest unit within the Forest of Dean outlier. The top of the member is not proved."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cinderford Formation [Obsolete: use CIFD]"@en ;
    skos:broader namedrockunit:GDB ;
    skos:definition "Mudstone and siltstone with subsidiary coal and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CIFD"@en ;
    skos:prefLabel "Cinderford Member"@en ;
.

