        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clast-supported, poorly sorted gravel with lenses of sand. Clasts are mainly subangular to rounded, up to cobble size and composed of red (Permo-Triassic) and yellow (Carboniferous) sandstones, and coal."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp erosional contact on diamictons of the Low Wath Till Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H122 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1.2m thick at type section but up to 10m thick in boreholes around Egremont."@en ;
    lexicon:hasUpperBoundaryDefinition "At the type section conformably overlain by silt and clay of the Ehen Valley Silt Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Sands and Gravels [Obsolete: use GFSA, SEAG, CGWD, LOGG, PLSG, PFS, EVSI, THBG, EVSG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CGWD"@en ;
    skos:prefLabel "Catgill Wood Sand And Gravel Member"@en ;
