    lexicon:hasThicknessDescription "Approx. 600 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of the Bonally Group where fine- grained andesites are overlain by pink aphanitic rhyolite with flow banded platy weathering of the Bell's Hill and Howden Burn Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    lexicon:isObsoleteEquivalentOf
