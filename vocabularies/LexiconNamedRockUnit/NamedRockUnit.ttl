    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 300 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the base of the Mardale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Atkinson and Fordingdale Ignimbrite Group [Obsolete: use WLT]"@en ,
        "Haweswater Ignimbrite Group [Obsolete: use WLT]"@en ,
        "Hugh's Laithes Pike Ignimbrite Group [Obsolete: use WLT]"@en ,
        "Place Fell Group [Obsolete: use WLT]"@en ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Lapilli-tuff and tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:PLH ,
        namedrockunit:PNH ;
    skos:notation "WLT"@en ;
    skos:prefLabel "Whelter Knotts Tuff Formation"@en ;
.

namedrockunit:WROT
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:DGR ,
        namedrockunit:GRF ,
        namedrockunit:NS ,
        namedrockunit:PNTL ,
        namedrockunit:S971 ,
        namedrockunit:SWK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises mudstones with interbedded siltstones and sandstones. Mudstones and siltstones are pale grey to grey-green or purple, waxy, poorly to non-calcareous and carbonaceous. The interbedded sandstones are very fine- to fine-grained, pale grey to white, poorly cemented and carbonaceous."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is characterised by a downward change from sandstone and siltstone lithologies to harder, grey, marine, Lower Jurassic siltstones, sandstones or mudstones (Cerdic Formation). It coincides with a down-section increase in gamma values and in velocity. The boundary between the West Sole Group and the Lias Group in the North Sea is a major erosive break."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 95 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is normally defined by a downward change from sandstones or siltstones with interbedded mudstones and limestones (Strangways Formation) to variegated siltstones and mudstones. There is a corresponding down-section increase in gamma values and decrease in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dogger Formation"@en ,
        "Grantham Formation"@en ,
        "Northampton Sand Formation"@en ,
        "Pentland Formation"@en ,
        "Saltwick Formation"@en ,
        "Werkendam Shale Formation"@en ;
    skos:broader namedrockunit:WSTS ;
