namedrockunit:BNKS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A dark grey, brown weathered, massive, thick-to thin-bedded, fine-to medium-grained, calcareous, quartzitic, bioclastic (crinoid and brachiopod debris), finely micaceous sandstone, interbeddedwith thin, dark grey, calcareous, laminated mudstones and siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base taken at the base of the first sandstone bed above laminated calcisiltites and mudstones of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum thickness of 11.5 m in the Thornley Anticline."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the passage of sandstone into the overlying laminated mudstones and thin-bedded calcisiltites of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HOM ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNKS"@en ;
    skos:prefLabel "Buckbanks Sandstone Member"@en ;
.

namedrockunit:BNL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lithology. Pebbly sandstone of the Bennane Lea Member is present at the northern limit of the outcrop of the parent Corseclays Formation. At Bennane Lea the sandstone contains matrix-supported sub-angular clasts predominantly of altered basalt. The member is a lateral facies variant developed at the base of the formation where it unconformably overlies Lower Ordovician igneous rocks (Stone, 1988). It was previously informally referred to as the 'Bennane Lea Member' by  Peach and Horne as part of the 1894 resurvey and it is noted by Stone (1988) that the Bennane Lea Member has erroneously been referred to an 'upper breccia division' (Jackson et al., 1995)."@en ;
    lexicon:hasLowerBoundaryDefinition "Highest exposed part of the Corseclays Sandstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Highest exposed part of the Corseclays Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CLY ;
    skos:definition "Sandstone with subsidiary breccia. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNL"@en ;
    skos:prefLabel "Bennane Lea Breccia Member"@en ;
.

