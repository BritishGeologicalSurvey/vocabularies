        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A localised thick conglomerate unit at or near the top of the generally flaggy Ardwell Farm Formation. Thickly bedded. Grey-green and buff- to yellow-weathering grits with scattered pebbles and boulders up to 60cm across of dolerite, spilite, gabbro, granophyre, granite and olive green mudstone rafts in a slightly calcareous matrix."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of conglomerate, resting on flaggy sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3965 ,
        namedrockunit:H4572 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the conglomerate and return to flaggy sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cascade Beds [Obsolete: use CSC]"@en ,
        "Cascade Grits and Conglomerates [Obsolete: use CSC]"@en ;
    skos:broader namedrockunit:ARD ;
    skos:definition "Coarse silicate-sandstone, conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CSC"@en ;
    skos:prefLabel "Cascade Conglomerate Member"@en ;
