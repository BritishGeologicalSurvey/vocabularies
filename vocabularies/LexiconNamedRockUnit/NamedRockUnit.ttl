namedrockunit:BNSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine to medium-grained (locally coarse to very coarse), poorly to moderately sorted sandstones, variously cemented with carbonate. Interbedded with grey and brown to black siltstones and mudstones typical of the Kimmeridge Clay Formation."@en ;
    lexicon:hasLowerBoundaryDefinition """The base is placed either at a down-section change from sandstone to mudstone or at a downward transition from sandstone-dominated to mudstone-dominated sediments. This is reflected in the gamma-ray values, which may be sharp (e.g.well 20/2-2) or gradual (e.g. 20/2-5). Velocity decreases downwards. \r
\r
NB: There is potential for confusion as the thin sandstones which occur within the Kimmeridge Clay and below the main sandstone unit of the present member (e.g. 12/24-2) are not included here."""@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5148 ,
        namedrockunit:H5149 ,
        namedrockunit:H5150 ,
        namedrockunit:H5151 ,
        namedrockunit:H5152 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Variable to 1344 m and probably thicker adjacent to hanging walls of major syndepositional faults."@en ;
    lexicon:hasUpperBoundaryDefinition """The top is usually defined by a downward change from mudstones (Kimmeridge Clay Formation) to sandstones or interbedded sandstones and mudstones. The boundary is marked by a down-section decrease in gamma-ray values and an increase in velocity (NB: thin sandstones, which may occur within the overlying Kimmeridge Clay Formation, are not included in the member). \r
\r
Locally, sandstones of the Cromer Knoll Group overlie the Burns Sandstone Member and the boundary is difficult to identify without biostratigraphy. However, in some sections, (e.g. well 20/2-5) there is a down-section change from thickly bedded sandstones (of the Cromer Knoll Group) to thinly bedded sandstones with interbedded mudstones (Burns Sandstone Member). \r
\r
Mudstones associated with the Cromer Knoll Group sandstones are more calcareous than those in the Burns Sandstone Member, so that gamma-ray values are lower and velocities are higher."""@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cromarty Sand Member [Obsolete: use BNSA]"@en ,
        "Ettrick Sandstone [Obsolete: use BNSA]"@en ,
        "Helmsdale Boulder Beds equivalent [Obsolete: use BNSA]"@en ,
        "Lower Hot Shale [Obsolete: use BNSA]"@en ,
        "Upper Hot Shale [Obsolete: use BNSA]"@en ;
    skos:broader namedrockunit:KC ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Kimmeridgian Age (Jurassic Period) - to - Berriasian Age (Cretaceous Period) (154.8-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNSA"@en ;
    skos:prefLabel "Burns Sandstone Member"@en ;
.

