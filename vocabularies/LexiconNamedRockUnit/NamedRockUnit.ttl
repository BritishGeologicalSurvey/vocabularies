namedrockunit:BRON
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The two typical lithofacies are beds of very fine- to medium-grained sand, and fine to coarse gravel and boulders with a sandy matrix. The deposit is loose to dense. At Shieldhall (Browne and McMillan, 1989a, Figure 19), west Glasgow, the Member showed a gross upward-fining succession of about 20m thickness. The sands and silts showed flat bedding, ripple-lamination and climbing ripple-lamination, and planar and trough cross-bedding (westward transport). There were indistinct channels filled with massive sand, and two discrete ones up to 2m thick (width not known) containing framework-supported fine to very coarse gravel. Microfaulting was rarely seen and consisted of small reversed faults. There was evidence of soft sediment deformation, in that these deposits and the overlying laminated clays, originally flat-lying, dipped centroclinally into basins at angles up to as much as 80 degrees. This member forms the basal part of the Clyde Clay Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The Bridgeton Sand Member rests with angular unconformity on bedrock or older Quaternary sediments. It commonly rests on the Wilderness Till Formation of the Caledonia Glacigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2022 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to over 20 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "The Bridgeton Sand Member is overlain unconformably or disconformably by younger Quaternary sediments, normally the Paisley Clay Member of the British Coastal Deposits Group or the Clyde Valley Formation of the Britannia Catchments Group (Clyde Catchment Subgroup). It is almost always concealed below younger sediments throughout its area of occurrence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bridgeton Formation [Obsolete: use BRON]"@en ;
    skos:broader namedrockunit:CLYD ;
    skos:definition "Sand with subsidiary gravel and silt and trace boulders. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRON"@en ;
    skos:prefLabel "Bridgeton Sand Member"@en ;
.

namedrockunit:BRORO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bioturbated, shelly medium-grained sandstone with scattered quartzite pebbles and coal fragments. Occurs at the base of the Cadh'-an-Righ Shale Member (CARSH) at Balintore, and at the base of the Brora Shale Member (BROR) in the Brora area, where it forms prominent outcrops on the foreshore."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp planar lithological change where bioturbated medium-grained sandstone of the Brora Roof Bed (BRORO) rests on the Brora Coal (BRORC). The boundary appears to be erosional."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.5 m at Balintore. Up to 2.3 m in the Brora area."@en ;
    lexicon:hasUpperBoundaryDefinition "At Balintore, is overlain by the bituminous fissile mudstone of the Cadh'-an-Righ Shale Member (CARSH). At Brora, is overlain by the silty sand of the Brora Shale Bed (BROSH)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        namedrockunit:BROR ,
        namedrockunit:CARSH ;
    skos:definition "Sandstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRORO"@en ;
    skos:prefLabel "Brora Roof Bed"@en ;
.

