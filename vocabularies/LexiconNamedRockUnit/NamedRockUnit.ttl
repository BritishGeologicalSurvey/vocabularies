namedrockunit:AFS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Ashfell Sandstone Formation comprises thick-bedded, fine-grained sandstone with current ripple laminations, rare cross-bedding, and convolute bedding. Interdigitating are beds of marine mudstone and thin limestone with shelly faunas. \r
\r
Fluviodeltaic. Late Arundian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation overlying the Breakyneck Scar Limestone Formation cannot be defined precisely due to poor exposure."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2559 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is 152 m thick in the Ravenstonedale area, thinning northwards. In the Raydale Borehole (BGS Registration Number SD98SW/1) [SD 9026 8474] it is 38.40 m thick. In the Appleby district it is 20-40 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation conformably underlies the mainly packstone, shelly grainstone or lime mudstone of the Ashfell Limestone Formation in the Stainmore Trough and Shap, east Cumbria, and the mainly biomicrosparites and biomicrites of the Fawes Wood Limestone Formation on the Askrigg Block."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ashfell Sandstone [Obsolete: use AFS]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AFS"@en ;
    skos:prefLabel "Ashfell Sandstone Formation"@en ;
.

