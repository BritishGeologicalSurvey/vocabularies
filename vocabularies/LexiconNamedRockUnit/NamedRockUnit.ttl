namedrockunit:SIPI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A chaotic, coarse volcanotectonic megabreccia comprising successions of tuff, lapilli-tuff, volcaniclastic sandstone, andesite and rhyolite. Some megablocks may be assigned to established formations, but other blocks are not recognizably parts of formations. The volcanic-complex passes laterally into more coherent stratigraphy."@en ;
    lexicon:hasLowerBoundaryDefinition "Base faulted, passes into more coherant stratigraphy."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4884 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/VC> ;
    lexicon:hasUpperBoundaryDefinition "Faulted, passes into more coherant stratigraphy."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Side Pike Complex [Obsolete: use SIPI]"@en ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Breccia. Bedrock. Occurs onshore. Formed during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SIPI"@en ;
    skos:prefLabel "Side Pike Volcanic-Complex"@en ;
.

namedrockunit:SIS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand, purplish-reddish-brown, cross-bedded, poorly-sorted, medium- to coarse-grained, with polished dark brown to black limonite grains to granule size locally and secondary iron-pan concretions in parts. From about 9km from Stedham, West Sussex [SU 86 22] to east of Selham, West Sussex [SU 94 20] the Fittleworth Member is divided by the Selham Ironshot Member. Samuel (1994) proposed the name \"Upper Fittleworth Beds\" for these superposed beds (c.2m thick)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is a sharp junction between the purplish to reddish brown medium- to coarse-grained sand of the member with the sandy clay (which includes some limonite grains at this level) of the lower part of the Fittleworth Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S328 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 0 to 24.4m (passes laterally into \"loams\", Fittleworth Member or Rogate Member to the west)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is a sharp junction of sand overlying the upper part of the Fittleworth Member (pale sandy clay, non-ferruginous, becoming very dark greenish-grey where thinning out) or of hardground-like ferruginous sandstone with fine well-sorted sand of the Pulborough Sandrock, where the Fittleworth Member is absent."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Selham Ironshot Sands [Obsolete: use SIS, RGTB]"@en ;
    skos:broader namedrockunit:SAB ;
    skos:definition "Sand and sandstone with subsidiary ferruginous sandstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SIS"@en ;
    skos:prefLabel "Selham Ironshot Sands Member"@en ;
.

