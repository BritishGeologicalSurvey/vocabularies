namedrockunit:GRCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Grampian Catchments Subgroup encompasses the mainly late-Devensian and Holocene alluvial and river terrace deposits that occur in the Grampian Highlands. \r
\r
Sand, gravel, clay and organic deposits. Sand, gravel and boulders include clasts derived from rocks cropping out in the eastern Grampian Mountains and Buchan. \r
\r
Alluvium and river terrace deposits, and associated organic and lacustrine deposits. \r
\r
Devensian to Holocene (MIS 2 - 1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with units of the Central Grampian, East Grampian, Inverness, Banffshire Coast and Caithness, and Logie-Buchan Glacigenic subgroups, and with bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but units of this subgroup locally interfinger with units of the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel and sand with subsidiary boulders, clay, diamicton, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SPEY ;
    skos:notation "GRCA"@en ;
    skos:prefLabel "Grampian Catchments Subgroup"@en ;
.

