namedrockunit:HHF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark, flaggy sandstones, phosphatic and calcareous in places. This division appears to be partly erected on biostratigraphical grounds, and so little of it is exposed that its status has to be regarded as doubtful. Propose that it be retained as an informal term, with Member status regarded as provisional, until a fuller study of the divisions of the Upper Comley Sandstone Formation is undertaken."@en ;
    lexicon:hasLowerBoundaryDefinition "Appears to overlie the greenish grey Quarry Ridge Shales (Upper Comley Sandstone Formation) conformably, but little is seen of the junction."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2236 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasOldestAgeValue 5.08e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1m exposed."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Hill House Grits, also of the Upper Comley Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasYoungestAgeValue 4.99e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hill House Flags [Obsolete: use HHF]"@en ;
    skos:broader namedrockunit:UCSS ;
