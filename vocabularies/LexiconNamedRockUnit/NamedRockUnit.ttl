    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 20 m thick at outcrop at least 50 m thick in the Mogshaw Borehole (SK 16 NE 19) (SK 1889 6778)."@en ;
    lexicon:hasUpperBoundaryDefinition "Basalt lava of the Shacklow Wood Lava Member is overlain by mainly dark and medium grey limestone, thinly bedded and cherty, of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
