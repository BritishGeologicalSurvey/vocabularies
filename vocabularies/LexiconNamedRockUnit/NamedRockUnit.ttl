    lexicon:hasThicknessDescription "Estimated to be about 1500 thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Micklewood Beds (Tremadoc). Contact not seen but probably conformable and gradational. The Micklewood Beds are distinguished from the Breadstone Shale Formation by the more common occurrence of flaggy sandstone and siltstone beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasYoungestAgeValue 4.771e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Breadstone Shales [Obsolete: use BDSH]"@en ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series (Ordovician Period) (486.5-477.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "BDSH"@en ;
    skos:prefLabel "Breadstone Shale Formation"@en ;
