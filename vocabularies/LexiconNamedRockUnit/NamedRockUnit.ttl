    lexicon:hasThicknessDescription "55-400m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the Cravenoceras leion Marine Band."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BSG ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
