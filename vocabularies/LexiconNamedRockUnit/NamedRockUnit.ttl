namedrockunit:DIEP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, schistose, garnet-mica bearing pelite and semipelite, increasingly pelitic towards the top. Locally calc-silicate and psammite layers. The formation is partly hornfelsed in the thermal aureole of the Carn Chuinneag granite gneiss pluton: hornfelsed pelite locally preserves laminations, ripple marks, cross-bedding and possible mud cracks (Wilson and Shepherd, 1979). Andalusite and cordierite assemblages occur in the aureole."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Crom Psammite Formation (CMPS). Defined as where predominantly psammitic lithologies pass into predominantly pelitic lithologies."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4608 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 200-400 m (minimum estimate)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary cannot be seen, as it is obscured by the Carn Chuinneag-Inchbae Granite Gneiss Intrusion."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Pelite [Obsolete: use DIEP]"@en ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Pelite and semipelite with subsidiary psammite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DIEP"@en ;
