        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGBGL"^^xsd:anyURI ,
