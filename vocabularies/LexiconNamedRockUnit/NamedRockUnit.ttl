namedrockunit:KNCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCABR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPPH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Schistose to gneissose semipelite, locally phyllitic and calcareous. Banded calc-silicate rocks, quartzite, amphibolite, metacarbonate rocks and striped psammite and semipelite."@en ;
    lexicon:hasLowerBoundaryDefinition "Contact typically sheared with arkosic-banded dominantly psammitic gneisses of the underlying Glen Banchor succession. Over large parts of the area contact zone is marked by sheet of amphibolite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2877 ,
        namedrockunit:H4131 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "90 - 100 m estimated."@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of well-bedded, grey turbiditic, locally graded psammites of the Loch Laggan Psammite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basal Grampian Division [Obsolete: use KNCG]"@en ,
        "Ord Ban Subgroup [Obsolete: use KNCG]"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Gneissose semipelite, psammite and semipelite with subsidiary amphibolite, calcsilicate-rock, metalimestone, pelite, phyllitic semipelite and quartzite and trace metacarbonate-rock. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNCG"@en ;
    skos:prefLabel "Kincraig Formation"@en ;
.

namedrockunit:KNDL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Kendal Group comprises a lower sequence of graded siltstone-mudstone couplets with locally extensive intercalations of tubiditic sandstone (Bannisdale Mudstone Formation (BND)), overlain by massive to convolute laminated and ripple-cross laminated fine-grained sandstone (Kirkby Moor Sandstone Formation (KMF))."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the group coincides with that of the Bannisdale Mudstone Formation (BND) and is therefore gradational from the sandstone-dominated Coniston Group (CTG) into the interbedded siltstone-mudstone couplets of the Bannisdale Mudstone Formation (BND)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "The group is more than 2500 m thick and possibly up to 5000 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is an erosion surface, which is unconformably overlain by Upper Old Red Sandstone Group (ORSU) red-bed rocks or by basal Carboniferous strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WIN ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ludlow Epoch - to - Pridoli Epoch (Silurian Period) (426.7-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BND ,
        namedrockunit:KMF ;
    skos:notation "KNDL"@en ;
    skos:prefLabel "Kendal Group"@en ;
.

