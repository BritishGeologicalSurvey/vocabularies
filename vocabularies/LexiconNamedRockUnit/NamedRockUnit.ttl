    lexicon:hasThicknessDescription "To c.283m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational contact with overlying sandstones and siltstones of Staithes Sandstone Formation, but defined at the base of the \"Oyster Bed\" (highly fossiliferous calcareous and ferruginous sandstone)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
