    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithologyDescription "The term Middle Old Red Sandstone was introduced for Middle Devonian terrestrial sediments of Britain by Murchison in 1859. The term Middle Old Red Group was introduced by Cameron (1993) for equivalent sediments in the Central and Northern North Sea, where sandstone forms a relatively minor component of many sections."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
