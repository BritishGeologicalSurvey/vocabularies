        "Nodular Member [Obsolete: use NOL]"@en ;
    skos:broader namedrockunit:WEL ;
    skos:definition "Calcareous mudstone and limestone with subsidiary sandstone and trace tuff. Stratified bedrock. Occurs onshore. Deposited during the Homerian Age (Silurian Period) (430.6-426.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NOL"@en ;
    skos:prefLabel "Nodular Limestone Member"@en ;
