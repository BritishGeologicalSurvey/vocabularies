namedrockunit:TBT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Dominantly thick, massive beds of well sorted, medium-grained volcaniclastic sandstone up to 1 m thick, separated by thin volcaniclastic siltstone units up to several centimetres thick and locally with ripple cross-lamination (Bell, 1997). Over much of the outcrop, the siltstone is missing, giving the appearance of a uniform featureless sandstone. Locally, there are intraclasts\r
of mudstone, volcaniclastic siltstone and tuff, typically a few centimetres across. Towards the top of the formation there are some interbedded thin, dark grey mudstone units, similar to those seen in the underlying Skiddaw Group. \r
\r
The age has not been constrained biostratigraphically though it is presumed to be Llanvirn or early Caradoc."""@en ;
    lexicon:hasLowerBoundaryDefinition "The contact is nowhere seen, locally the formation is inferred to lie unconformably above steeply dipping mudstone of the Tarn Moor Mudstone Formation (Skiddaw Group)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 200 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by rocks at the base of the Borrowdale Volcanic Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Volcaniclastic-sandstone with subsidiary volcaniclastic-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Llanvirn Series - to - Caradoc Series (Ordovician Period) (468-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TBT"@en ;
    skos:prefLabel "Tailbert Sandstone Formation"@en ;
.

