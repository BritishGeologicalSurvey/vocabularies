    lexicon:hasThicknessDescription "Maximum thickness probably exceeds 750m under the Firth of Forth"@en ;
    lexicon:hasUpperBoundaryDefinition "Not known at outcrop due to unconformity beneath Permo-Triassic rocks."@en ;
