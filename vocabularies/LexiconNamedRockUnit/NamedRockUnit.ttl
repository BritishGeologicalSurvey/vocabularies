namedrockunit:CUST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Notably striped, semipelites and psammites, laminated and thinly banded, slaty to schistose. Psammites more quartzose and abundant near the base of the formation. Semipelites dominate towards the top."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transition from quartzite of the underlying Kymah Quartzite Formation to striped semipelite - psammite unit."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "285 - 1200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Upper limit of semipelite at base of graphitic pelite of the Glenbuchat Graphitic Schist Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DBED ;
    skos:definition "Psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CAQU ,
        namedrockunit:CBST ,
        namedrockunit:COPH ;
    skos:notation "CUST"@en ;
    skos:prefLabel "Culchavie Striped Formation"@en ;
.

