namedrockunit:ALPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Siliceous to feldspathic psammite with micaceous psammite, grey to buff; locally with micaceous layers. Gritty psammite occurs in the lower part; higher up in the unit, thin semipelitic beds become more common. Generally, strongly deformed and flaggy ('bed' thickness 5 - 30 cm). In low strain zones, the psammite shows thick beds (0.5 - 5 m): sedimentary structures include channels with pebble lags, planar and trough cross-bedding, slump-like folds, dewatering pipes and oversteepened cross-beds (Krabbendam et al., 2008). Palaeo-currents are to east or NE."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable upon Lewisian Gneiss inlier (L); unconformity highly sheared; locally conformable (?) on Meadie Schist Formation. In many places, base is cut and deformed by the Moine Thrust."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:AMPS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3 to 5 km. Accurate thickness is difficult to estimate due to subsequent deformation, see discussion in Krabbendam et al. (2014)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper part of the Altnharra Formation is the Glen Achall Psammite and Semipelite Member (GACH). The upper boundary of this boundary is marked by a return to psammite of the Glascarnoch Psammite Formation. In western parts, the Altnaharra Formation is directly overlain by the Vaich Pelite Formation (Bonsor et al. 2010). In the north, the upper boundary is commonly marked by thrusts."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "A'Mhoine Psammite Formation [Obsolete: use ALPS]"@en ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Psammite with subsidiary pebbly psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GACH ,
        namedrockunit:STRC ;
    skos:notation "ALPS"@en ;
    skos:prefLabel "Altnaharra Psammite Formation"@en ;
.

namedrockunit:AMND
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:DARW ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly light to dark grey, non-calcareous to calcareous, bioturbated siltstones and mudstones, which are locally carbonaceous and pyritic. The lower beds are, locally, more calcite cemented. Sandstones, particularly in the upper parts of the formation, attain a thickness of 24 m (Well 3/15-3). They are white, grey or brown and locally cemented by calcite or silica. Locally kaolinite, glauconite and mica occur. Upward-coarsening sections are common and reflect the upward decrease in gamma values."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is marked by a downward change from mudstones/siltstones to sandstones (Nansen Formation). This is accompanied by a down-section decrease in gamma values and, usually, an increase in velocity."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5174 ,
        namedrockunit:H5175 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "6-100 m in the East Shetland Basin, but thins and disappears on highs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a downward change from mudstones (Burton Formation) to siltstones or sandstones. It is accompanied by an often weak, down-section decrease in gamma values and increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Amundsen Sub-Unit [Obsolete: use AMND]"@en ,
        "Darwin Formation"@en ,
        "Dunlin Siltstone Member [Obsolete: use AMND, BURT, COOK]"@en ;
    skos:broader namedrockunit:DUNL ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMND"@en ;
    skos:prefLabel "Amundsen Formation"@en ;
.

namedrockunit:AMSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, grey, non-bituminous, with common layers of grey calcareous concretions particularly in the lower (Hard Shale Beds) and upper (Cement Shale Beds) parts; the median part (Main Alum Shale) is softer, less silty and generally less calcareous, and weathers pale grey and yellow; fossils including ammonites, bivalves and belemnites common throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: base of non-bituminous grey shaly mudstone resting upon dark grey bituminous mudstone (Mulgrave Shale Member) with a double layer of sideritic concretions (Ovatum Bed). Bed 49 on Bed 48 at Hawsker Bottoms and Whitby (Howarth, 1955).  Bed xvi on Bed xv at Blea Wyke (Howarth, 1962)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H14 ,
        namedrockunit:H642 ,
        namedrockunit:H643 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "37m at Blea Wyke, where complete; 27m at Whitby; 40m near Osmotherley (Frost, 1998); 13.2m in Felixkirk Borehole (Ivimey-Cook and Powell, 1991), overstepped south and west by Dogger Formation; absent at Brown Moor Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable: sharp change up from grey shaly mudstone with common layers of calcareous concretions into dark grey micaceous and silty mudstone with red-weathering sideritic concretions (Peak Mudstone Member): Bed 44b on Bed 44a at Blea Wyke(bed numbers of Dean, 1954), or unconformably overlain by ferruginous, pebbly sandstone, ooidal ironstone or limestone of the Dogger Formation (Middle Jurassic)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alum Rock [Obsolete: use AMSH]"@en ,
        "Alum Shale Series [Obsolete: use AMSH]"@en ,
        "Alum Shale [Obsolete: use AMSH]"@en ;
    skos:broader namedrockunit:WHM ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMSH"@en ;
    skos:prefLabel "Alum Shale Member"@en ;
.

