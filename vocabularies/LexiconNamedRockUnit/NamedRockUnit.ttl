namedrockunit:TAYS
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:CNSA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly or thickly bedded, clean to argillaceous, fine to medium grained sandstones, interbedded with variably silty, fissile, green-grey to grey mudstones and siltstones. Thin turbidite sandstones occur within the mudstone units."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Tay Sandstone Member normally rests conformably on a thin unit of Horda mudstone. However, over salt-induced highs in the south of Quadrant 21 it locally rests disconformably on Balder Formation, Sele Formation (e.g. 21/25-6), or Lista Formation (e.g. 21/22-1)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "The top of the Tay Sandstone Member is defined by a downward change from green-grey mudstone to relatively clean sandstone. This is associated with a decrease in gamma-ray values and generally by an increase in velocity (but see 21/25-6)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEM> ;
    lexicon:hasYoungestAgeValue 3.77e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Caran Sandstone unit"@en ;
    skos:broader namedrockunit:HORD ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Early Eocene - to - Mid Eocene (Palaeogene Period) (56-37.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TAYS"@en ;
    skos:prefLabel "Tay Sandstone Member"@en ;
.

