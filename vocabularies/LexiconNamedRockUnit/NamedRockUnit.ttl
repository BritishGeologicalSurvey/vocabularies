namedrockunit:SKGM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use SKG] \r
\r
Silty mudstone with some turbidite sandstone."""@en ;
    lexicon:hasLowerBoundaryDefinition "The southern boundary is gradational over a few tens of metres into unbleached dark grey mudstone of the Skiddaw Group. The northern contact occurs at a fault or unconformity and thus major change in lithology, with the Borrowdale Volcanic Group. The metasomatic alteration is associated with tourmaline veins and possibly due to a concealed intrusion (Ulverston memoir, Johnson et al 2001)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "In the Skiddaw inlier less than 5000 m thick, in the Black Combe inlier more than 1000 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Black Combe inlier, the top is not seen, but t is unconformably overlain by the Borrowdale Volcanic Group or is faulted against Carboniferous rocks.  In the northern part of the Skiddaw inlier, the youngest siltstones and mudstones of the Kirk Stile Formation of the Skiddaw Group, are unconformably overlain by volcanogenic mudstones and andesites of the Eycott Volcanic Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasYoungestAgeValue 4.582e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SKG ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Skiddaw Group"@en ;
    skos:definition "Obsolete name. Metamudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series - to - Llanvirn Series (Ordovician Period) (486.5-458.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKGM"@en ;
    skos:prefLabel "Skiddaw Group (metasomatically altered) [Obsolete: use SKG]"@en ;
.

