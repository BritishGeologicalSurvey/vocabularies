    lexicon:hasLithologyDescription "Pink, grey and fawn feldspathic psammite and micaceous psammite with pebbly layers, particularly towards the top of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional, placed where feldspar clasts and pebble bands become abundant within the Garva Bridge Psammite Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "up to 700 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt and locally transitional over a few metres. Placed where highly strained pebbly psammite, psammite and some quartzite are overlain by schistose to gneissose semipelite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GABR ;
    skos:definition "Micaceous psammite and psammite with subsidiary pebbly psammite and trace migmatitic psammite, pebbly migmatitic psammite, quartzite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GAIR"@en ;
    skos:prefLabel "Gairbeinn Pebbly Psammite Member"@en ;
