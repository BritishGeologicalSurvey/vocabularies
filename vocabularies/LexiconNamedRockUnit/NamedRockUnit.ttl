    lexicon:hasLithologyDescription "Thick sequence mainly of grey, purple and green quartzitic fine- to medium-grained sandstone, commonly parallel laminated and convolute-bedded, with shale and silty shale interbeds. Abundant scoured surfaces and silty drapes. Scattered scarce remains of Psilophyton sp. and a calamitid-like stem. Local distictive facies of deformed laminae of red siltstones and very fine-grained sandstones in which desiccation cracks alternate with convolute laminae."@en ;
    lexicon:hasLowerBoundaryDefinition "?Conformable on rocks of the Hollowbrook Member (q.v.)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H960 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 1250 m (Tunbridge, 1978)."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain ?conformably by rocks of the Rawns Member (q.v.)"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Trentishoe Grits [Obsolete: use HOB, TGR]"@en ;
    skos:broader namedrockunit:HASA ;
    skos:definition "Sandstone with subsidiary siltstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TGR"@en ;
    skos:prefLabel "Trentishoe Member"@en ;
.

