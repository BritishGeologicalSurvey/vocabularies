    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, glauconitic, calcareous in part, greenish grey weathering to foxy brown (reddish-brown) sand; concretionary \"doggers\" and tabular sandy limestones at several levels."@en ;
    lexicon:hasLowerBoundaryDefinition "In west Dorset's coastal sections the base is a conformable and gradational transition from the sandy mudstones of the Gault Formation to the sandstones of the Foxmould Member. Elsewhere the boundary is placed at an unconformity where the Foxmould Member rests on strata ranging from Triassic (in the west) to Lower Jurassic (in the east)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H268 ,
        namedrockunit:S155 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "30 to 32m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is at the base of a mineralized hardground surface (Culverhole Hardground) above which concretionary calcareous sandstones are absent and cherts are common in the Whitecliff Chert Member of the Upper Greensand Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Foxmould Sands [Obsolete: use FXMD]"@en ,
        "Foxmould and Cowstone Beds [Obsolete: use FXMD]"@en ,
        "Greensands [Obsolete: use HBG]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Glauconitic sandstone and sandstone with subsidiary calcareous sandstone and sandy limestone and trace clay and sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FXMD"@en ;
    skos:prefLabel "Foxmould Member"@en ;
.

