namedrockunit:KTNGF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravel. Typically clast supported with a matrix of coarse felsitic sand. Pale olive-brown and pale pinkish brown. Clasts are typically angular and subangular with rare subrounded shapes. Clast litholigies are dominated by felsite with rare quartzitic and psammitic metasedimentary rocks and red granite. It displays crude, medium scale, moderately high angle cross-bedding. Interpreted as periglacial gelifractate/talus."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the unit was observed to sharply overlie, and be buttressed laterally against felsite bedrock at a channel/basin margin in the southeast face B of Kirkhill Quarry (infilled)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1008 ,
        namedrockunit:H1009 ,
        namedrockunit:H2886 ,
        namedrockunit:H4140 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the unit was observed in the southeast face B of Kirkhill Quarry (infilled) to be gradationally overlain by, and to interdigitate laterally with, felsitic sands and gravels of the Pitscow Sand and Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kirkhill Gelifluctate Complex 1 [Obsolete: use KTNGF]"@en ,
        "Kirkhill Head 1 [Obsolete: use KTNGF]"@en ,
        "Kirkton Gelifluctate Bed [Obsolete: use KTNGF]"@en ,
        "Kirkton Member [Obsolete: use KTNGF]"@en ;
    skos:broader namedrockunit:POWSG ;
    skos:definition "Gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KTNGF"@en ;
    skos:prefLabel "Kirkton Gelifractate Bed"@en ;
.

namedrockunit:LASH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation typically comprises fossiliferous silty fissile mudstones with subordinate thin limestones and septarian nodules. A gradual coarsening-upward trend is discernible."@en ;
    lexicon:hasLowerBoundaryDefinition "The boundary of the Lealt Shale Formation with the underlying Elgol Sandstone Formation is abrupt. The uppermost bed of the Elgol Sandstone is a very coarse-grained sandstone with sporadic granules and pebbles, and is overlain by the fissile mudstones of the Lealt Shale (Harris and Hudson, 1980, fig.5)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1012 ,
        namedrockunit:H1638 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Typically between 45m and 50m. However, thicknesses quoted by authors for the same localities may be at considerable variance, due to the nature of the topography (e.g. sea cliffs) and of the laterally variable sequences, and to the difficulties of aggregating thickness ranges given for components. All thicknesses below are from Harris and Hudson (1980), except where indicated. In Trotternish, north Skye, including the Lonfearn Member type section, the formation ranges from 39 (British Geological Survey, 2007) to 43m thick, and on Raasay from 50 to 62m (British Geological Survey, 2006). On Strathaird it is about 46m thick, on Eigg between 45m (Emeleus, 1997) and 52m, and on Ardnamurchan, 2 to 3m (Richey and Thomas, 1930)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Valtos Sandstone Formation-Lealt Shale Formation transition is a gradational boundary characterized by interbedded fissile mudstones, silty fissile mudstones and siltstones. The top of the Lealt Shale is marked by the range top of the conchostracan Cyzicus. The base of the Valtos Sandstone is marked by the lowermost occurrence of silty mudstone with monotypic Neomiodon beds. The formation is unconformably overlain by extrusive rocks of the Paleocene Skye Lava Group in places."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Estheria Shales [Obsolete: use LASH]"@en ,
        "Estheria Shales plus Mytilus Shales [Obsolete: use LASH]"@en ;
    skos:broader namedrockunit:GEST ;
    skos:definition "Mudstone and silty mudstone with subsidiary limestone and siltstone and trace ooid-limestone and sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:KILDN ,
        namedrockunit:LONFN ;
    skos:notation "LASH"@en ;
    skos:prefLabel "Lealt Shale Formation"@en ;
.

namedrockunit:LAWS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very pure white to pale yellow-brown well-sorted medium-grained quartz sandstone. Massive with laminated and shelly beds to base. Most comprehensively described by Humphries (1961) at its type-site."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable (?) on the Morvern Greensand Formation, at the change from glauconitic calcareous sandstones upward into pure white quartz sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H235 ,
        namedrockunit:H2890 ,
        namedrockunit:H354 ,
        namedrockunit:H4144 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 40 feet (12.2m) on the west side of Loch Aline, according to Humphries (1961)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is unconformable beneath the Gribun Chalk Formation or Coire Riabhach Phosphatic Formation. At the upward change from pure quartz sandstone into hard chalk or glauconitic sand with phosphatic nodules."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasYoungestAgeValue 8.37e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Loch Aline Glass Sand [Obsolete: use LAWS]"@en ,
        "Loch Aline Sandstone [Obsolete: use LAWS]"@en ,
        "Loch Aline White Sandstone [Obsolete: use LAWS]"@en ,
        "White Sandstone [Obsolete: use LAWS, ESA]"@en ;
    skos:broader namedrockunit:IHEB ;
    skos:definition "Quartz-arenite and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Turonian Age - to - Santonian Age (Cretaceous Period) (93.9-83.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LAWS"@en ;
    skos:prefLabel "Lochaline White Sandstone Formation"@en ;
.

namedrockunit:LCSS
    a skos:Concept ;
