        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VLSS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thick pile of andesitic lava with associated pyroclastic and reworked volcanic rocks, subordinate biotite-phyric rhyolite and tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the volcanic rocks resting unconformably on Wenlock strata or, locally the White Hill Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CHV ,
        namedrockunit:H125 ,
        namedrockunit:H2692 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 1000 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the volcanic pile, uncomnformably overlain by the upper Devonian to  lower Carboniferous rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cheviot Lavas [Obsolete: use CHEV]"@en ,
        "Cheviot Volcanic Group [Obsolete: use CHEV]"@en ,
        "Cheviot Volcanic Series [Obsolete: use CHEV]"@en ;
    skos:broader namedrockunit:REST ;
    skos:definition "Andesite, biotite-phyric rhyolitic-rock and volcaniclastic rocks (both pyroclastic and reworked volcanic rocks) with subsidiary pyroclastic-breccia and tuff. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHEV"@en ;
    skos:prefLabel "Cheviot Volcanic Formation"@en ;
.

namedrockunit:CHGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/N> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VFLY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Well rounded flint pebble gravels, sandy gravels, pebbly sands and sands. Lithologies similar to those in the Harwich Formation (formerly Blackheath Beds or Disturbed Blackheath Beds) from which it is thought to have been mainly derived."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Upper Chalk or Thanet Sand, locally let down into dissolution hollows. Poorly exposed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DBLB ,
        namedrockunit:H2081 ,
        namedrockunit:H2694 ,
        namedrockunit:H3926 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasOldestAgeValue 5.33e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable and uncertain, not exposed. Typically 2-5 m. May be 10 m where infilling hollows or pipes in Chalk."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasYoungestAgeValue 2.58e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blackheath Beds [Obsolete: use CHGR, BLB]"@en ,
        "Chelsfield Gravel [Obsolete: use CHGR]"@en ,
        "Clay with flints [Obsolete: use CWF, CHGR]"@en ,
        "Disturbed Blackheath Beds"@en ;
    skos:broader namedrockunit:RESID ;
    skos:definition "Flinty gravel and gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Pliocene Epoch (Neogene Period) (5.33-2.58 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHGR"@en ;
    skos:prefLabel "Chelsfield Gravel Formation"@en ;
.

namedrockunit:CHLGE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravel and diamicton gravel. Crudely bedded over pale olive brown and pale pinkish brown, pebble-cobble gravel, clast supported with a matrix of coarse quartzose or felsitic sand typically overlying matrix supported pebble gravel with a silty sand matrix. Clasts are very angular and subangular. Clast lithologies are dominated by felsite with subsidiary psammites, quartzites, basic igneous rocks and red and grey granites. Thin beds of rippled fine-medium quartzose sand are present locally. In Kirkhill quarry (infilled) frost cracks penetrate downwards from within this bed, through the underlying Kirkhill Palaeosol Bed into the Pitscow Sand and Gravel Formation. In Leys quarry (disused) truncated ice wedge casts also descend from the top of the bed down through the Kirkhill Palaeosol Bed into the Pitscow Sand and Gravel Formation beneath. Interpreted as periglacial talus and gelifluction deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the unit is gradational (typically over 0.05m) with organic sand of the underlying Swineden Sand Bed in Kirkhill Quarry (infilled). In Leys Quarry (disused) it unconformably overlies white sand of the truncated Kirkhill Palaeosol Bed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2083 ,
        namedrockunit:H3295 ,
        namedrockunit:H3927 ,
        namedrockunit:H4537 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 2.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "In Kirkhill Quarry (infilled) the upper boundary of the unit is a subhorizontal, planar erosion surface overlain unconformably by yellowish brown diamicton of the Rottenhill Till Formation. In Leys Quarry (disused) the upper boundary of the unit is an erosional unconformity, with channels (up to 1m in depth) filled with sandy gravels of the West Leys Sand and Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Corse Member [Obsolete: use CHLGE]"@en ,
        "Kirkhill Gelifluctate Complex 2 [Obsolete: use CHLGE]"@en ,
        "Kirkhill Gelifluctate Complex 3 [Obsolete: use CHLGE, CSEND]"@en ,
        "Kirkhill Head 2 [Obsolete: use CHLGE]"@en ;
    skos:broader namedrockunit:WLSG ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHLGE"@en ;
    skos:prefLabel "Camphill Gelifluctate Bed"@en ;
.

namedrockunit:CLHD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DLMDM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey, pale buff and reddish grey, fine- to coarse-crystalline, thin to very thickly bedded dolostones, with shaly mudstone or clay partings and beds. Bioclastic grainstones interbedded with mudstones and dolostones are defined as the Cloud Wood Member, calcareous mudstones seen where undolomitised. The mudmound reef dolostones are typically buff to grey, massive, fine-grained and fossiliferous with common brachiopods, crinoids, corals, gastropods, nautiloids and ammonoids."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is an unconformity, possibly in part a shear surface, with biosparites and micrites of the Milldale Limestone Formation of early Asbian age below, locally marked by the incoming of mudstone-dominated sediments, such as the Cloud Wood Member, and may be crowded with Thallasinoides trace fossils."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H133 ,
        namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 125 m thickness proved at type section."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken at the incoming of the first palaeosol of friable siltstone and sandstone, displaying carbonate nodules of the overlying Ticknall Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carboniferous Limestone [Obsolete: use CL, PKLM, CLWYD, PEMB, BOHI, HOHI, TRLI]"@en ,
        "Cloud Hill Dolomite Formation [Obsolete: use HYBH, CLHD]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolostone and limestone with subsidiary mudmound dolostone and mudstone and trace calcareous mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CLWD ,
        namedrockunit:SCBR ;
    skos:notation "CLHD"@en ;
    skos:prefLabel "Cloud Hill Dolostone Formation"@en ;
.

