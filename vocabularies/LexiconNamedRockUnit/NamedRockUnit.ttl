    lexicon:hasThicknessDescription "5 to 10 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by mid-Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is usually helpful."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Satwell Member [Obsolete: use SWGR]"@en ;
    skos:broader namedrockunit:SBRY ;
    skos:definition "Gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SWGR"@en ;
    skos:prefLabel "Satwell Gravel Member"@en ;
.

namedrockunit:SWIK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, with interbedded subordinate claystone and siltstone. Limestones are packstone and wackestone, grey, bioclastic including crinoids and corals, bioturbated, sharp based, graded beds with hummocky cross bedding. Claystones and siltstones are grey, bioclastic, forming thin, discontinuous beds. Interpreted as a mid-ramp carbonate facies with limestones representing storm deposits and mudstones quiet water conditions. The member represents a period of maximum flooding."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Sandwick Member is poorly defined. It is poorly exposed on the foreshore at Derbyhaven [SC 2835 6653] where it overlies the Turkeyland Member. The boundary is gradational, taken at the change from limestone (Turkeyland Member) to limestone with interbedded claystones (Sandwick Member)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3063 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.46m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the member is poorly defined. It is overlain by limestones, sandstones and siltstones of the Skillicore Member, with a gradational contact, taken at the appearance and increasing occurrence of fine-grained sandstone, together with an increase in siltstone and a more tabular bedding style."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ronaldsway Member [Obsolete: use SWIK]"@en ;
    skos:broader namedrockunit:DBH ;
    skos:definition "Limestone with subsidiary silicate-claystone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SWIK"@en ;
    skos:prefLabel "Sandwick Member"@en ;
.

