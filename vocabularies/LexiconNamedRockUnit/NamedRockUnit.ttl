namedrockunit:KSL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alternating groups of slate-rich and sandstone-rich units. Slate units are composed of dark grey and silvery grey slates, commonly with lenticles of silt or fine sand and beds of sandstone (up to 0.5 m thick) and limestone (up to 0.2 m thick). Sandstone-rich units are composed of massive grey or pinkish-grey coarse-grained sandstone up to 2 m thick, slates and some thinner, finer-grained, cross-bedded sandstones up to 1 m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Located 30 m above the top of the David's Stone Limestone (two beds of limestone separated by slates identified at [SS 5703 4742]); the boundary is distinguished by a change from limestones (below) to thickly-bedded sandstone (above)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DVHB ,
        namedrockunit:ILFB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasOldestAgeValue 3.853e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 150 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Junction with the overlying Morte Slates is seen clearly on the coast. The top beds of the Kentisbury Slates are comprised of silvery grey, smooth calcareous slates with current-bedded sandstones (at [SS 5021 4714]); the lowest beds of the overlying Morte Slates at [SS 4972 4720]  are described as bluish grey or silvery grey slates which are commonly silty. The junction between the Kentisbury Slates and the overlying Morte Slates forms a clear topographical feature inland."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasYoungestAgeValue 3.711e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "David's Hole Beds [Obsolete: use KSL]"@en ,
        "Ilfracombe Beds [Obsolete: use IFS, KSL]"@en ;
    skos:broader namedrockunit:IFS ;
    skos:definition "Sandstone and slate with subsidiary limestone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Givetian Age - to - Frasnian Age (Devonian Period) (385.3-371.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KSL"@en ;
    skos:prefLabel "Kentisbury Slates Member"@en ;
.

