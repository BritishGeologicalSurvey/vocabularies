namedrockunit:UND
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use KMF] Uniform succession of sediments consisting generally of ill-sorted, silt-size quartz grains irregularly distributed in a matrix of very fine silt and clay, with subordinate discontinuous units of well-sorted siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken where the characteristic finer-grained \"banded-facies\" (Rickards, 1964) of the underlying Bannisdale Slate Formation passes vertically or laterally into ill-sorted siltstones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BASL ,
        namedrockunit:H3236 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasOldestAgeValue 4.25e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.200m in type area: thin northwards to less than 50m in the Staveley Syncline; increase eastwards to a maximum of c. 900m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of the massive siltstones of the Kirkby Moor Flags."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasYoungestAgeValue 4.227e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KMF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Bannisdale Slates [Obsolete: use BND, UND]"@en ,
        "Kirkby Moor Formation"@en ,
        "Passage Beds [Obsolete: use BOOC, SGBK, CLGB, MCH, UND, YED, MYS]"@en ;
    skos:definition "Obsolete name. Siltstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Ludfordian Age (Silurian Period) (425-422.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UND"@en ;
    skos:prefLabel "Underbarrow Flag Formation [Obsolete: use KMF]"@en ;
.

namedrockunit:UPBM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
