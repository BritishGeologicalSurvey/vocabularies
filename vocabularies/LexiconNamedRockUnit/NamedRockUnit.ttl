namedrockunit:HIYS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Hildasay Sandstone Member is dominated by mudstones and sandstones mostly of progradational shallow marine facies, but ranging from paralic 'delta-top' facies in proximal sections to 'prodelta' facies in distal sections. \r
\r
Paralic 'delta-top' facies are represented by claystones, mudstones, siltstones and sandstones of highly variable facies, with thin lignites. \r
\r
The more distal 'progradational' successions have not been encountered in cores, but appear from cuttings descriptions to be dominated by grey mudstones and siltstones interbedded with fine to coarse grained sandstones. The beds are mostly organized into upward-coarsening cycles, clearly identified on wireline-log character."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Hildasay Sandstone Member is defined by a downward change from sandstone to mudstone within a gradational lithological transition. The underlying mudstone forms the base of a large-scale upward-coarsening cycle (unit F2) and is normally recognizably thicker than the mudstones within the overlying and underlying sandstone members."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPL> ;
    lexicon:hasOldestAgeValue 5.92e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The member reaches a maximum thickness of 203 m in well 205/9-1."@en ;
    lexicon:hasUpperBoundaryDefinition "In most sections the top of the Hildasay Sandstone Member is defined by a downward change from mudstone to sandstone and is marked by a sharp downward decrease in gamma-ray values."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPL> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:FLET ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Late Paleocene (Palaeogene Period) (59.2-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HIYS"@en ;
    skos:prefLabel "Hildasay Sandstone Member"@en ;
.

