    lexicon:hasThicknessDescription "0 - 5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Within Bin Mountain Sandstone: Top of conglomerate marked by 0.04m of black coaly shale and orange-weathering medium- to coarse-grained decalcified pebbly sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
