namedrockunit:PSV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYLAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFASST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises principally rhyolite lava, rhyolitic tuff and agglomerate and basalt.  In its type area on Papa Stour, the lava is largely devitrified.  It occurs in two thick flows with intercalations of tuff, basalt and sandstone.  The rhyolite is strongly banded.  The basalt, which is intensly weathered locally, occurs in up to four flows.  These have thick scouriaceous upper zones with chaledony-, calcite-barytes- and zeolite-filled vesicles.  Similar rhyolite and pyroclastic rocks , such as the Melby Rhyolite Member, occur on the Walls Peninsula on Mainland Shetland."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type area, there is an unconformable contact upon sandstone and tuffaceous sandstone of the Melby Sandstone Formation. In the Melby area, it is in faulted contact along the Melby Fault against the Sandness Formation (Lower ORS] on the Walls Peninsula, or along a highly irregular contact with 'blocks and tongues' of rhyolite, that penetrated the underlying grey, micaceous, ripple laminated sandstone with rhyolite clasts of the Melby Sandstone Formation, to a depth of about 60 cm whilst it was an unconsolidated sediment."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H471 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to at least 200 m in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "In the type area, the rock at the top of the Papa Stour volcanic sequence is the youngest exposed bedrock.  In the Melby area, the top of the upper unit of the Melby Rhyolite Member is a disconformable, irregular, brecciated contact against fine-to-medium-grained, planer bedded pink sandstone, with partings of flaggy sandstone and siltstone, and containing scattered rhyolite clasts of the Melby Sandstone Fm. The upper boundary of the lower unit is not exposed, but mapping suggests that it is disconformably overlain by similar sediments of the Malby Sandstone Fm to those overlying the upper unit."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Old Red Sandstone volcanic rocks and sediments of Papa Stour [Obsolete: use PSV]"@en ;
    skos:broader namedrockunit:STMA ;
    skos:definition "Basalt and rhyolite lava with subsidiary agglomerate and rhyolitic tuff and trace tuffaceous-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:MYRH ;
    skos:notation "PSV"@en ;
    skos:prefLabel "Papa Stour Volcanic Formation"@en ;
.

namedrockunit:PTSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
