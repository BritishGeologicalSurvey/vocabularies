    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not known, but at least 500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at an angular unconformity, where fine grained glauconitic sandstone at the Upper Greensand Formation rests upon thick-bedded to massive, locally pebbly to conglomeratic sandstone of the Ugbrooke Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ugbrooke Park Beds [Obsolete: use UGST]"@en ,
        "Ugbrooke Park Sandstones [Obsolete: use UGST]"@en ;
    skos:broader namedrockunit:CHUD ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage - to - Namurian Stage (Carboniferous Period) (330.9-319 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UGST"@en ;
    skos:prefLabel "Ugbrooke Sandstone Formation"@en ;
