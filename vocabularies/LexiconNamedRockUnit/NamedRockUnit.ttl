namedrockunit:CONWY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, stratified gravels, sands, silts and clays forming the alluvial deposits of the Afon Conwy (River Conway) and its tributaries. Includes contemporaneous head, colluvium and pedogenic deposits within the catchment area. Clasts principally consist of local Lower Palaeozoic turbidites admixed with Ordovician volcanic rock clasts derived from Snowdonia and the Harlech Dome (either primarily, or secondarily from the reworking of glacigenic deposits). Aggradational riverr terraces and major alluvial fans are dominated by pebble cobble gravels and medium- to coarse-grained sand, and locally by silty clay with pebble and cobble beds (Warren et al, 1984), the modern floodplain is dominated by silt and clay, and locally includes lenses of peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable and locally channelised, predominantly on bedrock and Late Devensian head and Welsh glacigenic deposits (e.g. Eryri Till Formation). Interdigitates in a complex manner with Tidal Flat Deposits (Gwynllwg Formation of Bowen, 1999) in the estuary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALF ,
        namedrockunit:ALV ,
        namedrockunit:HEAD ,
        namedrockunit:LDE ,
        namedrockunit:RTD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally to around 10m, with up to 2m exposed locally (Warren et al. 1984)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface or, locally, overlain by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial fan deposits"@en ,
        "Alluvium"@en ,
        "Head"@en ,
        "Lacustrine deposits"@en ,
        "River terrace deposits"@en ;
    skos:broader namedrockunit:CNWCA ;
    skos:definition "Clay, gravel, sand and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CONWY"@en ;
    skos:prefLabel "Conwy Valley Formation"@en ;
.

