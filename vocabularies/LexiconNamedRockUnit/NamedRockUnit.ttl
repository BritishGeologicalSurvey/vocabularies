    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0-100m"@en ;
    lexicon:hasUpperBoundaryDefinition "At base of overlying main part of the Long Top Tuff Member: rhyolitic tuff and lapilli-tuff that is of lower-grade (less densely welded)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Oxendale Member [Obsolete: use OXT]"@en ;
    skos:broader namedrockunit:LTT ;
    skos:definition "Rhyolitic tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OXT"@en ;
    skos:prefLabel "Oxendale Tuff"@en ;
.

