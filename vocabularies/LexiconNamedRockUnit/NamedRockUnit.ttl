namedrockunit:LYBV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Amphibolite/metabasalt, mostly aphyric, locally with fragmented pillow structures. Interbedded with greywacke grits and slaty to phyllitic pelites."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of lowest metabasalt of the Blackwater Formation. In most of area this coincides with the faulted and/or sheared lower boundary of the Blackwater Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H384 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
