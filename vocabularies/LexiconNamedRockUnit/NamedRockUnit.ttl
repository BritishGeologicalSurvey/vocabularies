        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A component of the Hebridean Province (HBRID) comprising three geographically and petrologically related centres (Glen More (GLMO), Beinn Chaisgidle (BCHA) and Loch Ba (LOBA)) that occur in the mountains of southern Isle of Mull. Includes a wide variety of intrusive and extrusive igneous rocks, together with both sedimentary and metamorphic country rocks, particularly in major vent-complexes."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasYoungestAgeValue 2.304e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HBRID ;
    skos:definition "Trace andesite, basalt, dolerite, felsite, gabbro, glassy andesite, glassy basalt, glassy microgabbro, granophyric granite, microgabbro, mugearite, rhyolite, syenite and trachyte. Bedrock. Occurs onshore. Formed during the Paleogene Period (66-23.04 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BCHA ,
        namedrockunit:GLMO ,
        namedrockunit:LOBA ,
        namedrockunit:LSCR ;
