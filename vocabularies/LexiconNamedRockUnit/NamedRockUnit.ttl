    skos:broader namedrockunit:APAL ;
    skos:definition "Psammite and semipelite with subsidiary calcsilicate-rock and limestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ALDP"@en ;
    skos:prefLabel "Allt Dregnie Phyllite Member"@en ;
