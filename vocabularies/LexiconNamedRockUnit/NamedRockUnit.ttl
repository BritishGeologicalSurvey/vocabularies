namedrockunit:SSC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DALTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DATUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dacitic ignimbrite in the form of lapilli-tuff, mostly with a eutaxitic foliation due to welding, and with bedded tuffs at the base and top (some with accretionary lapilli, top only) which represent pyroclastic fall and surge deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "Basal bedded tuffs are conformable on sandstone of the Deepdale Sandstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 45-55m"@en ;
    lexicon:hasUpperBoundaryDefinition "Bedded tuffs are overlain by andesite - probably a sill."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
