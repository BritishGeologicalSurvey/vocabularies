    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Creag Leacach Quartzite [Obsolete: use CLQU]"@en ,
        "Schiehallion Quartzite [Obsolete: use DBSQ]"@en ;
    skos:broader namedrockunit:DBIS ;
    skos:definition "Quartzite with subsidiary psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BLQU ,
        namedrockunit:CDQU ;
    skos:notation "CLQU"@en ;
    skos:prefLabel "Creag Leacach Quartzite Formation"@en ;
