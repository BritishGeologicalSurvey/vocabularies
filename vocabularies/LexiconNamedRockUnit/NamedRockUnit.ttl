        "Oakley Beds [Obsolete: use OKLY, ELR]"@en ,
        "Oakley Clay [Obsolete: use OKLY]"@en ;
    skos:broader namedrockunit:STFD ;
    skos:definition "Calcareous mudstone and limestone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OKLY"@en ;
    skos:prefLabel "Oakley Member"@en ;
.

namedrockunit:OSBY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, calcareous, and poorly lithified sand; generally massive bedded, greenish-grey, weathering at outcrop to yellow-brown, fine- to medium-grained, with beds of berthierine (chamosite) ooids, calcareous siltstone and thin limestone. Sandstone beds are generally highly bioturbated with horizontal and vertical burrows."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable boundary where the soft grey mudstone of the underlying Cayton Clay Formation passes gradationally up to the pale yellow, clayey sandstone of the overlying Osgodby Formation (Redcliff Rock Member). Where the Cayton Clay Formation and the underlying Cornbrash Formation are absent in the Hambleton Hills (in the west of the Cleveland Basin) the Osgodby Formation rests unconformably on non-marine mudstone or sandstone of the Scalby Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1106 ,
        namedrockunit:H1745 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 28.5 m on the North Yorkshire Coast (Wright 1968a; Wright, 1978; Rawson and Wright, 2000); thins to c. 20 m in the Hambleton Hills (Powell et al., 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a fairly sharp, but conformable junction between the yellow-brown sandstone of the Osgodby Formation (Hackness Rock Member) and the green-grey silicate-mudstone (locally with occasional berthierine ooids) of the overlying Oxford Clay Formation. Locally in the Hambleton Hills, the Oxford Clay Formation and upper part of the Osgodby Formation are absent so that the Lower Calcareous Grit Formation (Oldstead Oolite Member) rests unconformably on the Osgodby Formation (Redcliff Rock Member) (Wright, 1983; Powell et al., 1992; Powell, 2010)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kellaways Rock Member [Obsolete: use OSBY]"@en ,
        "Kellaways Rock [Obsolete: use OSBY]"@en ;
    skos:definition "Sandstone with subsidiary calcareous siltstone and ferruginous limestone and trace calcareous sandstone and ooid-ironstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:HACR ,
        namedrockunit:LANG ,
        namedrockunit:RDCR ;
    skos:notation "OSBY"@en ;
    skos:prefLabel "Osgodby Formation"@en ;
.

namedrockunit:PABS
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:ADS ,
        namedrockunit:PABB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basal beds consist of fine-grained, dark, micaceous fissile mudstones. The remainder of the Formation consists of silty and micaceous mudstones. The unit is rich in infaunal and epifaunal benthic faunas, ammonites and belemnites. The unit coarsens upwards to the Scalpay Sandstone Formation, with thin, local, clastic coarsening cycles."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt facies change from Ardnish Formation sandstones to dark mudstones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1111 ,
        namedrockunit:H3601 ,
        namedrockunit:PABB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "200 m maximum."@en ;
    lexicon:hasUpperBoundaryDefinition "Diachronous and transitional to the Scalpay Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
