namedrockunit:DOSM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, white-fawn, medium to coarse-grained, micaceous; calcareous horizons, weathering orange-brown, are friable and sparsely fossiliferous, bioturbated, cross-bedded, sporadic beds of crinoidal, sandy packstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable; abrupt change from interbedded blocky mudstones, micaceous and blocky siltstones and blue-grey silty sandstones, at top of Bundoran Shale Formation, to orange weathering, thick beds of medium-grained sandstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.20 - 25m"@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt change, probably disconformable, between sandstones and overlying part of Mullaghmore Sandstone Formation, predominantly grey calcareous mudstones and thin peritidal limestones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MMS ;
    skos:definition "Sandstone with subsidiary calcareous sandstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DOSM"@en ;
    skos:prefLabel "Dromore Sandstone Member"@en ;
.

namedrockunit:DOST
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Floodplain alluvium and river terrace deposits. The floodplain alluvium comprises overbank deposits of mottled dark grey and orange organic silt, silty clay and clayey sand, and peat, overlying sand and gravel. Thirteen river terraces are preserved. The river terrace deposits comprise very sandy gravels. The clasts are sub-angular to sub-rounded, poorly sorted, up to 10cm in diameter, dominantly flint, with a little Upper Greensand chert, \"sarsen\" stone, vein quartz, Jurassic limestone, Chalk, and well-rounded flints from the Palaeogene, in a matrix of clayey sand. Deposits of the higher terraces are cryturbated."@en ;
    lexicon:hasLowerBoundaryDefinition "The fluvial deposits rest unconformably on Jurassic, Cretaceous and Palaeogene strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 11m, including up to 4m of alluvial overbank deposits."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNTCA ;
    skos:definition "Gravel, sand and silt with subsidiary clay and peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DOST"@en ;
    skos:prefLabel "Dorset Stour Formation"@en ;
.

