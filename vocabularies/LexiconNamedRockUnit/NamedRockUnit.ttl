namedrockunit:BUTTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S497 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, brown, gravelly sandy clay diamicton, commonly with well dispersed clasts of andesite, tuff and granite from the Lake District; greywacke and grandiorite from southern Scotland, and red sandstones probably of both Triassic and Devonian age, in addition to Carboniferous lithologies (sandstone, gritty sandstone, limestone, mudstone, coal). Commonly thinly intercalated with dark grey, laminated silts and clays, and lenses if sand and gravel."@en ;
    lexicon:hasLowerBoundaryDefinition "Commonly intercalated with dark grey, laminated silts and clays, or sand and gravel of the Tyne and Wear Glaciolacustrine Formation. Some contacts possibly glaciotectonic."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1405 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 15m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Butterby Member"@en ,
        "Upper Stony Clays [Obsolete: use BUTTI]"@en ;
    skos:broader namedrockunit:WETI ;
    skos:definition "Diamicton with subsidiary clay and trace gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BUTTI"@en ;
    skos:prefLabel "Butterby Till Member"@en ;
