    lexicon:hasThicknessDescription "4 to 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the upper tongue of calcareous sandstone of the Member, above which the pale grey ooid grainstones of the Penderyn Oolite Member enter."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
