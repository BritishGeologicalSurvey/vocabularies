    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "2 m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Passes up gradationally from organic-rich shales of the Portree Shale Formation to ironstone of the Raasay Ironstone Formation (RASI)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Portree Shale [Obsolete: use PEE]"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Calcareous mudstone, micaceous mudstone and siliciclastic argillaceous rock and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PEE"@en ;
    skos:prefLabel "Portree Shale Formation"@en ;
