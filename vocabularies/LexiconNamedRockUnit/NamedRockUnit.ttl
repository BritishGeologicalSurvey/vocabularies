namedrockunit:GCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to grey, thick-bedded to massive, medium- to coarse-grained oolite and ooidal limestone with lenses of crinoidal limestone. Deposited in a barrier environment."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Bristol area and Broadfield Down it is taken at the incoming of ooidal limestones of the Formation above the dolomite and calcite mudstones and mudstones of the underlying Clifton Down Mudstone Formation. In the Weston-super-Mare area and Steepholm it is taken at the incoming of massive, coarse crinoidal and ooidal limestones of the Formation above the grey to dark grey, medium-bedded skeletal limestones of the High Tor Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "15m in the Bristol area (Avon Gorge) thickening to 70 m at Weston-super-Mare."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Weston-super-Mare area it is taken at the incoming of the calcite mudstones of the Clifton Down Mudstone Formation above the ooidal limestones of the Formation. In the Bristol area it is taken at the incoming of calcite mudstones and skeletal limestones of the Clifton Down Limestone Formation above the ooidal limestones of the Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GCO"@en ;
    skos:prefLabel "Goblin Combe Oolite Formation"@en ;
