namedrockunit:PETRO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation includes the deposits of five river terraces. The deposits of the first terrace are largely gravel of Carboniferous sandstone with scattered flints, with thin seams of clayey sand and sandy clay, 1.5 - 7m thick. The pebbles are up to 20mm in diameter, increasing to 130mm at the base. Deposits of the higher terraces are less gravelly, and dominantly comprise clay with gravel seams."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock of Paleogene and Late Carboniferous age."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c.8m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CCAT ;
    skos:definition "Clay, gravel and sand with subsidiary silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:PET1 ,
        namedrockunit:PET2 ,
        namedrockunit:PET3 ,
        namedrockunit:PET4 ,
        namedrockunit:PET5 ;
    skos:notation "PETRO"@en ;
    skos:prefLabel "Petrockstow Valley Formation"@en ;
.

namedrockunit:PIBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Pibroch Sandstone Member comprises mainly fine- to coarse-grained sandstones with subordinate dark grey, marine mudstones. It has been divided into five lithofacies: \r
\r
1) Bioturbated, fossiliferous mudstones with thin (1-2 m thick), poorly sorted, glauconitic, very fine-grained sandstones at their base. \r
\r
2) Bioturbated, silty, fine-grained sandstones with broken bivalves and belemnites. \r
\r
3) Well-sorted, massive to cross-bedded, bioturbated, medium-grained sandstones with sporadic shelly debris. \r
\r
4)  Well sorted, massive to planar bedded, coarse grained sandstones. \r
\r
5) Upward fining, cross-bedded, very coarse- to coarse-grained sandstones. \r
\r
Thin coals formed locally. The lithofacies are arranged in a stacked succession of large scale, upward coarsening cycles, about 20 m thick."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at a down-section transition from sandstone to mudstone (Heather Formation) and a down-section increase in gamma-ray values. Locally the Pentland Formation underlies the Pibroch Sandstone Member and here it rests on coal or coal-bearing mudstones of the Stroma Member or volcanics of the Rattray Volcanics Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5168 ,
        namedrockunit:H5169 ,
        namedrockunit:H5170 ,
        namedrockunit:H5171 ,
        namedrockunit:H5172 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 150 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by the base of the overlying, widespread, marine mudstone, informally named the 'I Shale' (of Maher, 1981). This down-section change from mudstone to sandstone usually coincides with a marked by a decrease in gamma-ray values and increased velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "J Sand [Obsolete: use PIBR]"@en ,
        "Main Piper Sandstone [Obsolete: use PIBR]"@en ,
        "Pibroch Member [Obsolete: use PIBR]"@en ,
        "Piper Formation Lower Sand Member [Obsolete: use PIBR]"@en ,
        "Scott Member (Sgiath Formation) [Obsolete: use PIBR]"@en ;
    skos:broader namedrockunit:PIPR ;
    skos:definition "Sandstone with subsidiary mudstone and trace coal. Stratified bedrock. Occurs offshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PIBR"@en ;
    skos:prefLabel "Pibroch Sandstone Member"@en ;
.

