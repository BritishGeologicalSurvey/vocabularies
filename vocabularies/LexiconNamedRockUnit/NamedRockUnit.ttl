    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 3.7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, conformable contact with sand and gravel of the St Bees Sand and Gravel Member of the Seascale Glacigenic Formation above."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "St Bees silts and clays [Obsolete: use SBSI]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBSI"@en ;
    skos:prefLabel "St Bees Silt Member"@en ;
.

namedrockunit:SBT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Black, sandy micaceous slates and pale greenish grey slates with nodular limestones. Some thick siltstone and fine-grained sandstone horizons."@en ;
    lexicon:hasLowerBoundaryDefinition "Thrust bounded."@en ;
