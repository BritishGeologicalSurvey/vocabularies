namedrockunit:CMBS
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:H3683 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Camberley Sand Formation comprises a fairly uniform sequence of homogeneous, bioturbated, yellow-brown, sparsely to moderately glauconitic silty fine-grained sand, or sandy silt, with some ironstone concretions and masses of white sandstone. Sporadic flint gravel or a gravel bed occur near the base. Thin beds of pale grey clay occur in places (Ellison and Williamson, 1999). Fossils include fish teeth and marine bivalve molluscs, although occurrences above the water table generally have been decalcified (Curry, 1958). Some beds rich in foraminifera occur in the BGS Mytchett Borehole (SU85NE184) [SU 8830 5541]."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Camberley Sand Formation is probably an omission surface marking the upwards change from the heterogeneous Windlesham Formation to the more homogeneous, paler-coloured Camberley Sand Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BGBU ,
        namedrockunit:H5085 ,
        namedrockunit:H665 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 69m in the Windsor district (Ellison and Williamson, 1999)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Camberley Sand is the youngest Palaeogene unit in the London Basin, so it is overlain, if at all, only by deposits of Quaternary age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Barton Beds [Obsolete: use BA, CMBS]"@en ,
        "Selsey Formation [Obsolete: use SLSY]"@en ,
        "Upper Bagshot Beds [Obsolete: use CMBS]"@en ,
        "Upper Bagshot Sands [Obsolete: use CMBS]"@en ;
    skos:broader namedrockunit:BRB ;
    skos:definition "Sand and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CMBS"@en ;
    skos:prefLabel "Camberley Sand Formation"@en ;
