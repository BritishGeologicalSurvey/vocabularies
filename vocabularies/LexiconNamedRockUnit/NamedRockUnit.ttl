namedrockunit:KLLQ
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDIAMT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, white, orthoquartzite, feldspathic quartzite and siliceous psammite. Locally prominent white to pink feldspars. Pebbly beds developed locally. Sporadic development of a 'boulder bed' near the top of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transitional boundary (quartzite, psammite, semipelite and micaceous psammite) with the underlying Aonach Beag Semipelite Formation. Where psammite is interbedded with semipelite below, boundary is placed where psammite becomes the dominant lithology. Elsewhere boundary is where quartzite replaces semipelite and psammite."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DAKQ ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 160m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upper contact placed where quartzite (or 'boulder bed' where present) is abruptly replaced by semipelite, pelite and / or metalimestone / calc-silicate rocks of the Coire Cheap Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kinlochlaggan Quartzite [Obsolete: use KLLQ]"@en ;
    skos:broader namedrockunit:APP ;
    skos:definition "Quartzite with subsidiary metadiamictite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KLLQ"@en ;
    skos:prefLabel "Kinlochlaggan Quartzite Formation"@en ;
