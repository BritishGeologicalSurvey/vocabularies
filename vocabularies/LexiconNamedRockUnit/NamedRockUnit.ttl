namedrockunit:CAW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use MBSA] Osborne White (1921) described the formation as \"highly ferruginous coarse sand or grit\" and Casey (1961) described it as \"gritty, reddish-brown sands with pebbles and phosphatic nodules.\"  There is a concentration of nodules at the base. The nodules contain abundant shelly material including ammonites, gastropods and bivalves."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is a sharp eroded surface where there is a marked down-section change from gritty, reddish-brown sandstone to the yellow and white quartz sandstone at the top of the underlying rhythmical succession of the Sandrock Formation.  This depositional break is called the \"Mid tardefurcata break\" by Casey (1961)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4518 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 21.9m at Red Cliff. Thickens towards the northeast from as little as 5cm at Punfield on the Dorset coast, and on the Isle of Wight, to 1.8m at Compton Bay, 3.7m at Blackgang, 9.1m at Bonchurch (Osborne White, 1921)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is gradational, where the reddish brown ferruginous coarse-grained sandstones of the Monks Bay Sandstone Formation pass up into dark grey mudstones of the Gault Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:MBSA ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Group XVI [Obsolete: use CAW]"@en ,
        "Monk's Bay Sandstone Formation"@en ;
    skos:definition "Obsolete name. Ironstone and sandstone with subsidiary siltstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CAW"@en ;
    skos:prefLabel "Carstone (Isle of Wight) [Obsolete: use MBSA]"@en ;
.

namedrockunit:CAWD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
