namedrockunit:RIBV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silt, sand and clay in Alluvium grading into gravel at base. River Terraces are dominated by gravel grading upwards into silt and sand."@en ;
    lexicon:hasLowerBoundaryDefinition "Probably unconformable, irregular and in places strongly incised into lithologically variable sediments of the Caledonia or Albion Glacigenic Groups or into bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2393 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally less than 5m but locally up to 12m."@en ;
    lexicon:hasUpperBoundaryDefinition "At the ground surface or unconformable below artificial deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fluvial parts of Swettenham and Lytham formations [Obsolete: use RIBV]"@en ;
    skos:broader namedrockunit:CLCA ;
    skos:definition "Clay, sand and silt with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RIBV"@en ;
    skos:prefLabel "Ribble Valley Formation"@en ;
.

namedrockunit:RID
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In west Dorset, comprises dark greyish brown, carbonaceous muds and pale marls and micrites, commonly containing thin detrital quartz laminations that form isolated ripples. The mudstones are replaced in east Dorset by micritic limestone, and at Durlston Bay, where the sequence becomes very monotonous, it is difficult to define the Member."@en ;
    lexicon:hasLowerBoundaryDefinition "First significant occurrence of dark grey or brown muds above thickly bedded, ostracod-rich limestone of the Mupe Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3639 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3 to 7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of thicker mudstone beds beneath thick-bedded, ripple cross-laminated, quartz-detrital limestone of the overlying the Worbarrow Tout Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bincombe Mudstone Member [Obsolete: use RID]"@en ;
    skos:broader namedrockunit:LULW ;
    skos:definition "Calcareous mudstone and micritic limestone with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) - to - Berriasian Age (Cretaceous Period) (149.2-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RID"@en ;
    skos:prefLabel "Ridgeway Member"@en ;
.

