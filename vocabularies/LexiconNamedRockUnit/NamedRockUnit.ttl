namedrockunit:FANT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red,purple and variegated silty mudstones, siltstones and sandstones with lenticular bodies of conglomerate.  Breccias dominantly composed of weathered Lower Palaezoic mudstone clasts occur at base. The silty mudstones locally display glaebular calcrete profiles including abundant calcareous nodules and thin units of nodular locally dolomitised limestone. The formation records the accumulation, within palaeovalleys and embayments, of screes and alluvial sediments during the initial phases of Dinantian transgression, prior to the establishment of carbonate platform conditions of the Clwyd Limestone Group."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on cleaved and folded Silirian rocks (Elwy Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BED ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 330m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, erosive contact with limestones at the base of the Llanarmon Limestone Formation (Clwyd Limestone Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Beds Formation [Obsolete: use FANT, FRFA, LGY, MEST, PANT, PDW]"@en ;
    skos:definition "Breccia, conglomerate, mudstone, sandstone and siltstone with subsidiary dolomitic limestone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Arundian Substage (Carboniferous Period) (346.7-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "FANT"@en ;
    skos:prefLabel "Ffernant Formation"@en ;
.

