namedrockunit:VTIS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey siltstones and mudstones with subordinate beds of sandstone, shelly limestone, clay ironstone and ironstone. Commonly described as thinly-bedded mudstone (\"shale\" or \"paper shale\") and the whole is generally finely- and evenly-bedded."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable and marked by an abrupt change from the brightly coloured (generally red tinged) friable sandstones and calcareous mudstones of the Wessex Formation up into the dull grey and blue-grey mudstones of the Vectis Formation. In the Isle of Wight Memoir the section at Brixton Bay (p.13), now called Brighstone Bay, places the lower boundary at the base of \"red sand with bones\" (the \"Hypsilophodon Bed\") (Osborne White, 1921). This \"bone bed\" (a red pedogenic siltstone) is now considered  as being several metres below the base of the formation as alluded to in the footnote on that Memoir page."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1255 ,
        namedrockunit:WSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasOldestAgeValue 1.265e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum of c.66m on the Isle of Wight."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the change from grey mudstones with an eroded and burrowed upper surface in contact with the overlying dark green to greyish green basal glauconitic very shelly sandstone of the Perna Bed Member (Insole et al., 1998) of the Atherfield Clay Formation. This boundary is generally some 4 to 5m above a distinctive shelly limestone associated with a \"Beef-Bed\" (fibrous calcite commonly showing cone-in-cone structures)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Wealden Shales (Isle of Wight) [Obsolete: use VTIS]"@en ,
        "Wealden Shales [Obsolete: use VTIS]"@en ;
    skos:broader namedrockunit:W ;
    skos:definition "Mudstone and siltstone with subsidiary ironstone, sandstone and shelly limestone. Stratified bedrock. Occurs onshore. Deposited during the Barremian Age - to - Aptian Age (Cretaceous Period) (126.5-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BHSA ,
        namedrockunit:CCH ,
        namedrockunit:SHCH ;
    skos:notation "VTIS"@en ;
    skos:prefLabel "Vectis Formation"@en ;
.

namedrockunit:WC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey thinly-bedded mudstones (shales) and mudstones with subordinate siltstones, fine- to medium-grained sandstones, including calcareous sandstone (e.g. Horsham Stone Member), shelly limestones (the so called \"Paludina Limestones\") and clay ironstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is generally poorly defined and gradational in complete successions, from the siltstones and silty fine-grained sandstones of the underlying Tunbridge Wells Sand Formation up into the mudstones of the Weald Clay Formation. Locally, the basal beds of the Weald Clay are weakly sideritised. Elsewhere, the boundary is erosive and unconformable, with the Weald Clay resting on beds down to the Grinstead Clay Member (e.g. southwestern part of the Maidstone Geological Sheet around Pearsons Green [TQ 694 433])."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2522 ,
        namedrockunit:H4963 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 460m around Guildford; 122m at Hythe; 240m south of Maidstone and 180m at Eastbourne."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is unconformable and sharp at the contact between the drab, ochre-brown mudstones of the upper part of the Weald Clay and the overlying \"chocolate\" (dark yellow brown) brown (dark grey or black when unweathered) mudstones of the basal Atherfield Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Weald Clay Group [Obsolete: use WC]"@en ,
        "Weald Clay [Obsolete: use WC]"@en ;
    skos:broader namedrockunit:W ;
    skos:definition "Mudstone and silty mudstone with subsidiary sand, sandstone and siltstone and trace ironstone and limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Hauterivian Age - to - Barremian Age (Cretaceous Period) (132.6-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:HST ,
        namedrockunit:LWY ,
        namedrockunit:UWC ;
    skos:notation "WC"@en ;
    skos:prefLabel "Weald Clay Formation"@en ;
.

namedrockunit:WCH
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:SAH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin- to medium-bedded green, grey-green, black and purple radiolarian cherts with interbeds of siliceous mudstones and \"shales\". In the Chudleigh area, there is a thin (to 14 m) basal unit of black siliceous and sooty mudstones (the Winstow Mudstone Member). The uppermost part of the Formation, the Posidonia Beds, comprises 10 m of thin-bedded cherts, shales and limestones with an abundant fauna of Posidoniid bivalves and spirally striated goniatites."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Chudleigh area the lower boundary is taken at the incoming of black sooty and siliceous mudstones of the Winstow Mudstone Member above the purple, green and grey mudstones of the underlying Whiteway Mudstone Formation. The contact is generally sharp. In the Plymouth area it is taken at the incoming of dark grey cherts and siliceous mudstones of the Winstow Chert Formation above the mid grey silty mudstones of the Saltash Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3120 ,
        namedrockunit:H77 ,
        namedrockunit:WNC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "45 m in the Chudleigh area; about 30 m+ in the Plymouth area."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Chudleigh area the upper boundary is taken at the incoming of dark grey and greenish grey mudstones with thin siltstones and fine- to coarse-grained sandstones of the overlying Ugbrooke Sandstone Formation above the thin-bedded cherts, shales and limestones (Posidonia Beds) of the Winstow Chert Formation. In the Plymouth area the top of the formation is not exposed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Culm Measures [Obsolete: use BPLM, MQF, NCH, TEVY, WCH]"@en ,
        "Saltash Formation"@en ,
        "Winstow Chert [Obsolete: use WCH]"@en ,
        "Winstow Cherts [Obsolete: use WCH]"@en ;
    skos:broader namedrockunit:CHUD ;
    skos:definition "Chert and siliceous mudstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage - to - Brigantian Substage (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WWM ;
