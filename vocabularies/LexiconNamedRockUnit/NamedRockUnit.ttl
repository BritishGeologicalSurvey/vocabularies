    lexicon:hasThicknessDescription "Up to 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or unconformable contact with units of the Britannia Catchments Group and the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
