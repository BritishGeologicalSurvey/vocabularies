namedrockunit:SKPE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PCS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very dusky red to black compressible peat to clayey sandy peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp to bioturbated (principally by root development) contact between red to black peat and clayey sandy peat with underlying sands and clays of the Hemingbrough Glaciolacustrine Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 0.2m"@en ;
    lexicon:hasUpperBoundaryDefinition "Where preserved, the Skipwith Common Peat Bed is overlain by a sharp to gradational (reworked) contact with sands of the Skipwith Common Sand Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SKIS ;
    skos:definition "Peat with subsidiary sandy clayey peat. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKPE"@en ;
    skos:prefLabel "Skipwith Peat Bed"@en ;
.

