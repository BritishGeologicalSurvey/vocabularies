    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FNB"@en ;
    skos:prefLabel "Fife Ness Formation"@en ;
.

namedrockunit:FNSTL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The dominant lithology is planar and trough cross-bedded, irregularly bedded and structureless, pale red-brown and greenish grey sandstones. Subordinate lithologies are red-brown and grey-green mudstone and siltstone. The sequence shows repeated fining-upward cycles, from sandstone to mudstone; there is commonly an intraformational conglomerate at the base of each cycle and the upper beds of sandstone are commonly parallel laminated. Sedimentary structures include ripple marks, flute casts, slump structures, mudcracks and convolute bedding. Micaceous bedding planes are common. Bioturbation occurs in the lower part of the member and plant remains and Euestheria have been found in the upper part in the reference section. Elsewhere the member has yielded acritarchs, miospores, plant remains, annelids, brachiopods, bivalves, Euestheria, ostracods, and remains of arachnids, fish, amphibians and reptiles."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the base of the cycle above the highest bed of extraformational conglomerate."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5112 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickest known sequence is 139.5 m, in the Sugarbrook No.3 Borehole; the minimum known thickness is 33.6 m, in the Longbridge Laundry Borehole [SP 0201 7847] (Powell et al., 2000)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at top of the highest significant (>1 m) bed of sandstone with large scale cross bedding."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Building Stones [Obsolete]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FNSTL"@en ;
    skos:prefLabel "Finstall Member"@en ;
.

namedrockunit:FNTL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Hard, olive grey, brown weathering, finely sandy (especially in the north), silty, bioclastic, fine-grained limestone, in one or locally two beds, with small ammonites and pectiniids. Fauna also includes forams, serpulids, brachiopods, other bivalves, ostracods and echinoderms. Forms a weak feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey mudstone of undifferentiated Foston Member; at 27.10 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1544 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.3 to 1.0 m; 0.34 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey mudstone of undifferentiated Foston Member; at 26.76 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fenton Limestone [Obsolete: use FNTL]"@en ;
    skos:broader namedrockunit:FSTL ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FNTL"@en ;
    skos:prefLabel "Fenton Limestone Bed"@en ;
