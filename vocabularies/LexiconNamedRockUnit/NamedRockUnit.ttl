        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Tuffaceous mudstones and tuffs."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the junction of tuffaceous mudstones and tuffs with underlying basaltic lavas of the Clyde Plateau Volcanic Formation"@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable, to c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the overlying Lawmuir Formation or Lower Limestone Formation. The boundary is commonly irregular with interdigitation of lithologies."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
