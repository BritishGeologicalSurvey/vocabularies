namedrockunit:NBPY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The North Berwick Pyroclastic Member consists of green (lower part in the north) and red coloured (all in the south) tuffs and lapilli-tuffs and agglomerate locally with sedimentary intercalations of a lacustrine limestone, the Sunnyside Limestone, up to 2.9m thick. These are commonly well bedded and waterlain and interbedded with volcaniclastic sedimentary rocks including thin dolostones and siliciclastic mudstones with sandstones showing ripplemarks."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is conformable on the underlying Ballagan Formation (Strathclyde Group). The change is transitional by interbedding of tuff and lapilli tuff into the underlying siliciclastic and carbonate rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H413 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 220m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the basaltic flows of the East Linton Lava Member to south of the Dunbar-Gifford Fault where the somewhat younger siliciclastic Gullane Formation rests directly on it. The contact is conformable and locally unconformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "North Berwick Member [Obsolete: use NBPY]"@en ;
    skos:broader namedrockunit:GHV ;
    skos:definition "Lapilli-tuff and tuff with subsidiary mudstone, sandstone and volcaniclastic-sedimentary-rock and trace dolostone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NBPY"@en ;
    skos:prefLabel "North Berwick Pyroclastic Member"@en ;
.

namedrockunit:NCHD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse-grained inequigranular diorite, comprising a dark grey matrix with c.40-50% of white, subhedral plagioclase crystals. Fine-grained and equigranular at chilled margin."@en ;
    lexicon:hasLowerBoundaryDefinition "Margins generally cut Charnian bedding at high angles and show chilling within c.5-10m of contact."@en ;
