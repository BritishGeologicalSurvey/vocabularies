    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 73 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is the base of the aeolian beds belonging to the Lossiemouth Sandstone Formation or, where that is absent, the base of the Stotfield Cherty Rock Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
