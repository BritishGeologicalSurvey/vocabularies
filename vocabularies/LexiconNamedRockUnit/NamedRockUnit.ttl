        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk) with small flints scattered in the lower part and small discontinuous tabular flints in the upper part. The formation can be divided into two \"Beds\" (A and B) across a conspicuous separation plane. The formation is terminated by the \"wavy-bedded\" Altachuile Breccia (of ?member status)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary conformably overlies \"Bed\" B of the Larry Bane Chalk Formation. Oldest of the post-Larry Bane Chalk \"Subgroup\"."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1402 ,
        namedrockunit:H3248 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "12.65m at its type site with Bed A 9.65m and Bed B 3.00m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformably succeeded by the Glenarm Chalk Formation above the Altachuile Breccia (?Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ballintoy Chalk Member [Obsolete: use BTC]"@en ,
        "White Bay Chalk [Obsolete: use BTC]"@en ;
    skos:broader namedrockunit:UWLF ;
    skos:definition "Chalk with subsidiary flint and limestone. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BTC"@en ;
    skos:prefLabel "Ballintoy Chalk Formation"@en ;
.

namedrockunit:BTG
    a skos:Concept ;
