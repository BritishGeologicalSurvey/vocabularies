namedrockunit:POCKG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Matrix to clast supported clayey sandy medium to coarse gravel. Clast composition is typically polymodal, domiated by chalk and flint. Average clast composition is 75% well-rounded chalk, 15% sub-angular flint, plus 10% accessory lithologies including ironstone and oolitic limestone. Clast composition varies in extreme cases to 100% chalk or 100% flint, increased flint content may be due in part to different dissolution of chalk clasts. Matrix material is characterized by reddish brown clayey sand to sandy clay with varying degrees of partially decomposed chalk."@en ;
    lexicon:hasLowerBoundaryDefinition "Sandy gravel of the Pocklington Gravel Formation rests unconformably on Mesozoic bedrock with a sharp to variably disturbed (cryoturbated, soliflucted, reworked) basal content."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:OLSG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "In excess of 1m (1.2m observed in temporary excavation [480417, 448013])."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper contact with the Breighton Sand Formation is proved in auger holes to be relatively sharp with minor intercalation due to local reworking. Elsewhere, the Pocklington Gravel Formation is known to be overlain by alluvial, aeolian and artificial deposits with varying degrees of incision and disturbance."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Older littoral sand and gravel"@en ;
    skos:broader namedrockunit:NPEG ;
    skos:definition "Sandy clayey gravel with subsidiary gravelly clayey sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "POCKG"@en ;
    skos:prefLabel "Pocklington Gravel Formation"@en ;
.

