namedrockunit:LTC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower Tealby Clay comprises blue-grey clay, glauconite-rich at some horizons and silty and oolitic in the lower part."@en ;
    lexicon:hasLowerBoundaryDefinition "The erosional base separates blue-grey clay, glauconite-rich at some horizons and silty and oolitic in the lower part (Lower Tealby Clay) from clayey, oolitic ironstone (Claxby Ironstone Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1048 ,
        namedrockunit:H4773 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 13m proved, but an estimated 18m at North Willingham (Owen and Thurrell, 1968)."@en ;
    lexicon:hasUpperBoundaryDefinition "In much of Lincolnshire, sandy limestones and thin oolitic clays (Tealby Limestone Member) overlie blue-grey clay, silty and glauconite-rich at some horizons (Lower Tealby Clay). In southern-most Lincolnshire, in the Skegness Borehole, and beneath The Wash, the Tealby Limestone Member is missing and the Lower Tealby Clay  cannot be separated satisfactorily from the Upper Tealby Clay. In northern Lincolnshire, between Audleby and Clixby, the arenaceous Carstone Formation rests on mudstones of the Lower Tealby Clay."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasYoungestAgeValue 1.265e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
