    skos:definition "Bedrock. Occurs both onshore and offshore. Formed during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "JNRU"@en ;
    skos:prefLabel "Bathonian Rocks (Undifferentiated)"@en ;
.

