namedrockunit:FD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pebbly and shelly, sandy silty clay to clayey silty sand. Stiff to very stiff, possibly till. Shell fragments common at top, middle and base of unit, sand and clay partings are common. Less sandy than underlying Mariner Formation, geotechnically stronger than overlying Cape Shore Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary is a marked unconformity with \"channeling\" up to 50 metres deep. In places erosion has removed all Quaternary material below this reflector."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS006> ;
    lexicon:hasOldestAgeValue 1.86e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "50 metres. Thins to south and west. Thickens to north and east on the North Sea Plateau and may be 200 metres or more in the northern part of the Norwegian Trench."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is unconformable with Holocene sand at the sea bed or apparently conformable/disconformable below the Cape Shore Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS004> ;
    lexicon:hasYoungestAgeValue 5.9e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        namedrockunit:HJG ,
        namedrockunit:REAP ;
    skos:definition "Clay and sand with subsidiary shelly clay. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 6 - to - Marine Isotope Stage 4 (Quaternary Period) (.186-.059 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FD"@en ;
    skos:prefLabel "Ferder Formation"@en ;
.

