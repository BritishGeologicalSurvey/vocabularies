    lexicon:hasThicknessDescription "70-90 m (71 m in Cropwell Bridge borehole, SK63NE/28)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at abrupt base of lowest pale grey sandstone bed of the Cotgrave Sandstone Member, overlying red-brown blocky mudstone of the Gunthorpe Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasYoungestAgeValue 2.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
