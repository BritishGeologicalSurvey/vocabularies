    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly flaggy, greenish grey siltstones and sandstones with massive sandstone beds. The top c.122m is mainly purple in colour."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Lightspout Formation where the grey mudstones and siltstones rest conformably upon dominantly purple mudstones and siltstones in the Synalds Formation."@en ;
