        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use MIHO] A grey to brownish grey, fine-grained limestone, somewhat dolomitic, slightly bioclastic, crinoidal, interpreted to be of marine origin, with Zoophycus caudagalli trace fossil common."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a conformable change from the rooted top of a c.10m-thick sandstone within the Lower Limestone Formation that directly overlies the Chapel Point Limestone (now the Main Hosie Limestone)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Generally to 0.3m, but seen as 1.8m in East Lothian, although may be locally absent."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally apparently conformable change to pale reddish brown, cross-bedded, medium-grained sandstone within the Lower Limestone Formation. Because of erosion, higher strata in the Lower Limestone Formation are not known in this area."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:MIHO ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Barns Ness East Limestone"@en ,
        "Mid Hosie Limestone"@en ;
    skos:definition "Obsolete name. Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNSS"@en ;
    skos:prefLabel "Barns Ness Limestone [Obsolete: use MIHO]"@en ;
