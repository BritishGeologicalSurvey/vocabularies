        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Kaolinitic clays, sandy and silty clays, silts, lignites and sands."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain along its eastern outcrop and south of Newton Abbot by the Aller Gravel and the Upper Greensand. Elsewhere unconformable upon, or faulted against, Devonian, Carboniferous or Permian Rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 1200 m (Curry et al., 1978)."@en ;
    lexicon:hasUpperBoundaryDefinition "The original top of the Formation is not preserved, and its eroded top now forms the land surface, underlying the modern soil."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasYoungestAgeValue 2.304e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
