namedrockunit:BICG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine- to medium-grained, commonly bioturbated and shelly with ammonites, bivalves and sponge spicules, some beds cross-bedded, generally weathering to soft sandstone, but some beds more calcareous and harder, including in the upper part (at Filey Brigg) a shelly, bioclastic sandy limestone bed"@en ;
    lexicon:hasLowerBoundaryDefinition "Soft fine- to medium-grained calcareous sandstone of Birdsall Calcareous Grit Member sharply but conformably overlies shelly ooidal limestone (Hambleton Oolite Member, lower leaf) where present, or non-sequentially overlies generally well-cemented calcareous fine-grained sandstone, locally spicule-rich (Lower Calcareous Grit Formation) where present, or in the extreme south, grey mudstone (Oxford Clay Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 27m: 6.5 to 7m at Filey Brigg (Wright, 1983; Coe, 1995), 0 to about 20m in Hambleton Hills (Powell et al., 1992), thickening south, 18 to 20m in Howardian Hills, 27m in Brown Moor Borehole (SE86SW/4) (Gaunt et al., 1980)."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp change upwards from fine-grained generally calcareous sandstone into variously shelly, sandy and ooidal limestone (Hambleton Oolite Member), or where this is absent, difficult to distinguish from Middle Calcareous Grit Member, or where this is absent, non-sequentially overlain by mudstone of Langton Clay Member (Upper Calcareous Grit Formation) or of Ampthill Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:COO ;
    skos:definition "Sandstone with subsidiary calcareous sandstone and sandy limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BICG"@en ;
    skos:prefLabel "Birdsall Calcareous Grit Member"@en ;
.

