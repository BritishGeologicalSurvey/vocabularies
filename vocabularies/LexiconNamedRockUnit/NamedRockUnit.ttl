namedrockunit:CHA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent namedrockunit:S756 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-, medium- and coarse-grained volcaniclastic sedimentary rocks with locally abundant tuffs and volcanic breccias. Intruded in Charnwood Forest by massive to brecciated andesites and dacites of the Whitwick Volcanic Complex and the Bardon Hill Volcanic Complex. The rocks are fractured, cleaved and show very low-grade metamorphism (Nuneaton) or upper greenschist metamorphism (Charnwood Forest)."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SG> ;
    lexicon:hasThicknessDescription "3000m minimum."@en ;
    lexicon:hasUpperBoundaryDefinition "Weathered and eroded, fractured or cleaved volcaniclastic rocks are overlain unconformably by strata ranging from earliest Palaeozoic to Mesozoic age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Usually Called 'Ancient Volcanic Rocks'."@en ;
    skos:definition "Volcaniclastic-sandstone and volcaniclastic-siltstone with subsidiary andesite, dacite, sandstone, tuff and volcaniclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BDHV ,
        namedrockunit:CAV ,
        namedrockunit:CBK ,
        namedrockunit:CMV ,
        namedrockunit:WVO ;
    skos:notation "CHA"@en ;
    skos:prefLabel "Charnian Supergroup"@en ;
.

namedrockunit:CI
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:CIHC ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AROC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to dark brown, ferruginous oolitic, silty clay with varying concentrations of oolitic ironstone and pink or cream, calcareous, siltstone bands at some levels. Chert and quartz grit are found at some horizons. Phosphatic nodules, which occur at some horizons, contain moulds of shelly fossils, including ammonites, belemnites and bivalves. In southern Lincolnshire, the lower part of the formation comprises pale, purple-grey, mottled brown, silty clay [Hundleby Clay Member]. The top of the formation is more calcareous and has been termed \"calcareous beds\" by some authors."@en ;
    lexicon:hasLowerBoundaryDefinition "Between Benniworth and Donnington-on Bain [Lincolnshire] the base is defined by a downsection change from grey and brown, ferruginous, oolitic mudstones [Hundleby Clay Member, Claxby Ironstone Formation] [Casey, 1973]. Farther north, where the Hundleby Clay Member is missing, argillaceous, oolitic ironstone is separated from the underlying pale-yellow sandstones [upper part of Spilsby Sandstone Formation] by an erosion surface. At Nettleton a basal conglomerate contains derived fossils from the Spilsby Formation [Casey, 1973; Kelly and Rawson, 1983]. Borehole evidence suggests that below The Wash, bioturbated, shelly silt and glauconitic sand [which appears to be the Hundleby Member] overlies brown ironstone and fine-grained, silty sand [Mintlyn Member of the Sandringham Sands Formation] [Wingfield et al., 1978]."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CYB ,
        namedrockunit:H2699 ,
        namedrockunit:H3299 ,
        namedrockunit:S596 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 8 m [an estimated 9 m was recorded at Dalby by Owen and Thurrell, 1968]."@en ;
    lexicon:hasUpperBoundaryDefinition "The Claxby Ironstone Formation grades into the overlying Tealby Formation, although a minor erosion surface has been used to separate the calcareous mudstones at the top of the Claxby Ironstone Formation [Upper Claxby Ironstone Member of Gaunt et al., 1992], from the overlying oolitic clays of the Tealby Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasYoungestAgeValue 1.265e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Claxby Beds [Obsolete: use CI]"@en ,
        "Claxby Ironstone Formation and Hundleby Clay Member (Undifferentiated)"@en ,
        "Claxby Ironstone [Obsolete: use CI]"@en ,
        "Ferruginous Band [Obsolete: use CI]"@en ,
        "Lower Sand and Sandstone [Obsolete: use CI, SYS]"@en ;
    skos:definition "Mudstone, siliciclastic argillaceous rock and silty mudstone with subsidiary ironstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age - to - Hauterivian Age (Cretaceous Period) (137.7-126.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:HBC ;
    skos:notation "CI"@en ;
    skos:prefLabel "Claxby Ironstone Formation"@en ;
.

