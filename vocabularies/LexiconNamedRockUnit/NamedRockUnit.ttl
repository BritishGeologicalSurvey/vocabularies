namedrockunit:LMN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONGAP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red, irregularly bedded siltstone and fine-grained sandstone that may be cross-bedded. It includes beds of coarse-grained sandstone with well-rounded frosted grains in a fine matrix, slump structures, small gypsiferous nodules, breccio-conglomerate and near-horizontal gypsum-cemented veins."@en ;
    lexicon:hasLowerBoundaryDefinition "Apparently conformable lithostratigraphical boundary with underlying coarse, red sandstone of \"millet seed\" grains of Corncockle Sandstone Formation as noted in the log of borehole NY08SE/1 at the Princes Street Dairy, Lochmaben."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "More than 54m proven in the Lochmaben Hospital Trial Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen; any rocks deposited over the Lochmaben Formation are no longer preserved."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Sandstone and siltstone with subsidiary angular pebble-grade conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LMN"@en ;
    skos:prefLabel "Lochmaben Formation"@en ;
.

