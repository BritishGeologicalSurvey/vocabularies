    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Not known in detail, estimated to be 2 to 3 m. Member might be one of a number of such beds of hard chalk between 5 and 10 m below the mapped base of the Newhaven Chalk Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper bounday is conformable at the top of the uppermost bed of very hard chalk."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasYoungestAgeValue 8.37e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Winchester Hardground [Obsolete: use STRK]"@en ;
