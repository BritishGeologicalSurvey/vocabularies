namedrockunit:KNLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Knowehead Lava Member consists of a broad range of petrographic types, including plagioclase-macrophyric trachybasalt (hawaiite of 'Markle' type), olivine-clinopyroxene-plagioclase-macrophyric basalt ('Dunsapie' type), microporphyritic trachybasalt (hawaiite), basaltic trachyandesite (mugearite), and a rhyolite lava of restricted lateral extent. Numerous intercalations of coarse tuff and the slaggy tongue-like character of some of the lavas, led Craig (1980) to suggest that at least some of the lavas are close to their eruptive source, although no vents have been identified."@en ;
    lexicon:hasLowerBoundaryDefinition "The Knowehead Lava Member is fault bounded and the lower boundary is not seen."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3502 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Greater than 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Knowehead Lava Member is fault bounded and the upper boundary is not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Knowehead Lavas [Obsolete: use KNLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and hawaiite with subsidiary mugearite, rhyolite and tuff. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNLA"@en ;
    skos:prefLabel "Knowehead Lava Member"@en ;
.

