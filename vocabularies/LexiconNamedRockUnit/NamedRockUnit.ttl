namedrockunit:HETD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Gravels, sands and loams that underlie the Hemington Terrace. Forms a terrace typically c. 0.5 to 1 m above the modern floodplain in the type area, and often distinguishable from the latter by the presence of mediaeval ridge and furrow. Generally comprises a lower unit of planar cross-bedded (laterally accreted, meandering river) gravel (up to 5 m) and an upper unit of overbank silt (up to 2 m); may also include organic muds in channels at the base. Gravel much as Holme Pierrepont Sand and Gravel, i.e. dominated by rounded pebbles of "Bunter" quartz/quartzite (c. 80%) with subordinate subangular flint, etc., but typically less sandy and orange-brown (not pinkish). \r
\r
Upper Pleistocene to Holocene (MI Stage 2 to 1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting (generally) on Holme Pierrepont Sand and Gravel or (more locally) pre-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H311 ,
        namedrockunit:H3463 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 7 m; typically c. 5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface, or base of alluvium."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ambaston Member [Obsolete: use HETD]"@en ,
        "Hemington Terrace Deposits [Obsolete: use HETD]"@en ;
    skos:broader
        namedrockunit:SOARV ,
        namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene - to - Holocene Epoch (Quaternary Period) (.126-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HETD"@en ;
    skos:prefLabel "Hemington Gravel Member"@en ;
.

