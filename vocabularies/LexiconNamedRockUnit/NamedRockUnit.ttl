    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.200 to 250m on coast section, but locally tightly folded; not measurable inland."@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional decrease in frequency of limestone beds and increase in proportion of calc-psammites relative to calc-semipelites."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
