namedrockunit:MR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Hard to very hard off-white, blocky fractured chalk with numerous nodular chalk beds and thin anastomosing marls."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable on the highest marl seam of the Plenus Marls Member. This is the Foyle Marl of Mortimore (1986)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1708 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 3 m in the classic Chiltern area but noted in the Hitchin Memoir to be between 2 and 7 m (Hopson et al., 1996). A range of 2.7 to 4 m is given in Mortimore (1986)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable but difficult to place in the \"Transitional\" Province where it is usually considered to be at a horizon of less hard flaggy chalks with significant anastomosing marls. This is probably equivalent to the Meads Marls sequence of the Southern Province and Mortimore (1986) places the boundary at the Meads Marl 1 in Sussex."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasYoungestAgeValue 8.94e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Melbourn Rock [Obsolete: use MR]"@en ;
    skos:broader namedrockunit:HCK ;
    skos:definition "Chalk and limestone with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age - to - Turonian Age (Cretaceous Period) (100.5-89.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MR"@en ;
    skos:prefLabel "Melbourn Rock Member"@en ;
.

