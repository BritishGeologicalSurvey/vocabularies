namedrockunit:NT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff to hard sandy silty clay, commonly with a till-like appearance. Seismic texture indicates the presence of sand and clay lenses or layers. Pebbles, including chalk fragments are common and shell fragments are also present. It is underlain by a geotechnically weaker and more uniformly textured clay and overlain by a soft, silty clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Partially unconformable on the underlying Cape Shore Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasOldestAgeValue 2.4e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40 metres +. Thins to 0 on the west side of the Norwegian Trench and to the north within the Norwegian Trench area."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the accoustically well-bedded soft clays of the Kleppe Senior Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:REAP ;
    skos:definition "Clay with subsidiary sand and shelly clay. Stratified superficial deposits. Occurs offshore. Formed during the Marine Isotope Stage 2 (Quaternary Period) (.024-.0139 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NT"@en ;
    skos:prefLabel "Norwegian Trench Formation"@en ;
.

