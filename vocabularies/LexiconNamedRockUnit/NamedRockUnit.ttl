namedrockunit:WWYM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Consists predominantly of red and purple mudstone with subordinate green and grey-black, locally laminated mudstone. Calcareous nodules are common where the formation is condensed and near the base, but in thicker developments calcareous, siliceous and, rarely, sideritic nodules and laminae are sparsely present. The mudstones and calcareous nodules contain a rick planktonic fauna of ammonoids, ostracods and conodonts; benthic fauna include crinoid debris and brachiopods, amongst others. Thin units of basalitic (spilitic) lava are sparsely present in thicker developments."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the gradational incoming of red, purple and green mudstones with scattered limestone nodules of the Whiteway Mudstone Formation above the red and green nodular cephalopod limestones with subordinate mudstones of the underlying Luxton Nodular Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3148 ,
        namedrockunit:H3780 ,
        namedrockunit:WYSL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "26 - ?200 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of black sooty and siliceous mudstones of the Winstow Mudstone Member (basal Winstow Chert Formation) above the purple, green and grey mudstones of the underlying Whiteway Mudstone Formation. The contact is generally sharp."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Mount Pleasant Group (pars) [Obsolete: use WWYM]"@en ,
        "Saltern Cove Formation (pars) [Obsolete: use WWYM]"@en ,
        "Whiteway Slate Formation [Obsolete: use WWYM]"@en ;
    skos:broader namedrockunit:TAMA ;
    skos:definition "Mudstone and trace basalt lava and limestone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WWYM"@en ;
    skos:prefLabel "Whiteway Mudstone Formation"@en ;
