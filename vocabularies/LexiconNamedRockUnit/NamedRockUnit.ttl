namedrockunit:CFC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly unfossiliferous pale grey silty clay, with rare sand laminae. The deposit is bioturbated and burrowed and locally contains shell debris, for example in the Captain's Wood Borehole TM35SE/62 [TM 4237 5455]. The deposit is thought to have formed on high intertidal mudflats. Studies of the palaeomagnetism, pollen and foraminifera tentatively suggest a Baventian-Pre-Pastonian age."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradual interbedded transition from the underlying Chillesford Church Sand Member, but locally oversteps onto Coralline Crag Formation and Red Crag Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EBC ,
        namedrockunit:H3292 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QV> ;
    lexicon:hasOldestAgeValue 2e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain mainly by fluvial sand and gravel of the Kesgrave Formation, but also by till or sand and gravel of the Lowestoft Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QV> ;
    lexicon:hasYoungestAgeValue 1.82e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chillesford Clay [Obsolete: use CFC]"@en ,
        "Easton Bavents Clay Member [Obsolete: use CFC]"@en ;
    skos:broader namedrockunit:NCG ;
    skos:definition "Clay and silt with subsidiary sand and trace shelly silt. Stratified superficial deposits. Occurs onshore. Formed during the Pre-Pastonian/Baventian Stage (Quaternary Period) (2-1.82 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CFC"@en ;
    skos:prefLabel "Chillesford Clay Member"@en ;
.

