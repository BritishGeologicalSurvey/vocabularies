namedrockunit:HBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey, thick-bedded, coarsely crinoidal packstones. Locally dolomitized. Deposited in a distal ramp setting."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at a sharp junction between the dark limestones, cherts and mudstones of the Linney Head Formation and the overlying thick-bedded coarsely crinoidal limestones of the Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "17 m at type locality in southwest Pembrokeshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at sharp junction between dolomitised crinoidal packstones at the top of the Formation and the crinoidal packstones with mudstone partings of the overlying Pen-y-holt Limestone Formation. This boundary is unsatisfactory but has not been changed as it defines the base of the Arundian Stage and needs further work."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Limestone with subsidiary dolomitic limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HBL"@en ;
    skos:prefLabel "Hobbyhorse Bay Limestone Formation"@en ;
.

namedrockunit:HBLE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Floodplain alluvium and river terrace deposits. The floodplain alluvium comprises overbank deposits of brown organic silty clay, together with peaty clay, and peat, overlying sand and gravel. The surviving river terrace deposits comprise sand and gravel, commonly cross-bedded, locally overlain by overbank deposits of clayey and sandy silts and silty clays. These fine-grained deposits may be partly aeolian in origin. The major gravel lithology is flint, dominantly sub-rounded to sub-angular, with a little well-rounded. The sand fraction is composed of well-rounded quartz grains and sub-angular flint. The older, higher terraces are commonly cryoturbated."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Palaeogene bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNTCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HBLE"@en ;
