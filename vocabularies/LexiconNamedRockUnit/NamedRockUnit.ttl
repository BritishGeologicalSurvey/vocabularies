namedrockunit:AMOG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MOLGB"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use SMOG] Comprises the Fe-rich members of the Scourie Dyke Swarm. The dykes of the Subswarm occur within the Lewisian Gneiss Complex in the Assynt region, and they typically have a broadly east-west trend. They have the primary mineralogy olivine - clinopyroxene - orthopyroxene - plagioclase - kaersutite - biotite - Fe-Ti oxide, although most have been subjected to amphibolite-facies metamorphism and thus many of the original minerals have been replaced."@en ;
    lexicon:hasLowerBoundaryDefinition "Contacts are cross-cutting, and have been modified by subsequent metamorphism."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UW> ;
    lexicon:hasThicknessDescription "From about 50 cm to 50 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "N/A."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SMOG ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Sionascaig Meta-Olivine-Gabbro Subswarm"@en ;
    skos:definition "Obsolete name. Meta-olivine-gabbro. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Paleoproterozoic Era (Precambrian) (2500-1600 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMOG"@en ;
    skos:prefLabel "Assynt Meta-Olivine Gabbro Subswarm [Obsolete: use SMOG]"@en ;
.

namedrockunit:AMP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MPCT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MPDT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use BMP] Comprises the Mg-rich members of the Scourie Dyke Swarm. The dykes of the Subswarm are most abundant within the Lewisian Gneiss Complex in the Assynt region, and they typically have a broadly east-west trend.The dykes of the Subswarm are picritic and have the primary mineralogy olivine - orthopyroxene - clinopyroxene - plagioclase - phlogopite - chromite, although most have undergone amphibolite-facies metamorphism with replacement of the majority of the primary minerals."@en ;
    lexicon:hasLowerBoundaryDefinition "Contacts are cross-cutting and have been modified by subsequent metamorphism."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UW> ;
    lexicon:hasThicknessDescription "From about 50 cm to 50 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "N/A."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BMP ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Beannach Metapicrite Subswarm"@en ;
    skos:definition "Obsolete name. Metaperidotite and metapicrite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Paleoproterozoic Era (Precambrian) (2500-1600 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMP"@en ;
    skos:prefLabel "Assynt Metapicrite Subswarm [Obsolete: use BMP]"@en ;
.

