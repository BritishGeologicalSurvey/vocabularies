    lexicon:hasThicknessDescription "3.4 metres +. Up to 15 metres on seismic sections."@en ;
    lexicon:hasUpperBoundaryDefinition "Lower limit : Ferder, Mariner and Shackleton Formation beneath an unconformity which may be ice scoured."@en ;
