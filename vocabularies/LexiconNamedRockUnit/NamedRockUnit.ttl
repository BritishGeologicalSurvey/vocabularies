namedrockunit:FFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:LDL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, packstone, fine-grained, medium and dark grey, thick bedded and wavy-bedded, with few mudstone partings; somewhat argillaceous, particularly at the top. Typically contains layers of nodules and lenses of black chert. Crinoidal but not particularly fossiliferous on the Alston Block; contains conspicuous coral biostromes to the north and south of the Alston Block. Goniatites indicative of the P2c biozone have been found in mudstones above the Four Fathom Limestone in the Mount Pleasant Borehole [NZ034 152] near Barnard Castle (Johnson et al, 1962)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the generally conformable, sharp base of the first bed of limestone that overlies measures of the Alston Formation. On the Alston Block, usually overlies less than 2m of dark grey seatearth mudstone and mudstone with abundant plants that overlies as a prominent sandstone referred to there as the Natrass Gill Hazle. In the Bellingham district a coal underlies the limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BUCC ,
        namedrockunit:H2799 ,
        namedrockunit:H904 ,
        namedrockunit:H905 ,
        namedrockunit:LDL ,
        namedrockunit:SBKL ,
        namedrockunit:UNL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "7-10m north of the Lake District and in Northumberland; 5 to 12m on the Alston Block; about 9m on the Askrigg Block, but locally up to 25m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the uppermost limestone bed that is overlain by a sequence of dark grey mudstones, the lowermost of which are calcareous and fossiliferous. On the Askrigg Block the limestone member is overlain by a dark grey or almost black chert referred to as the Underset Chert."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Buccleuch Limestone [Obsolete: use FFL]"@en ,
        "Eight Yard Limestone [Obsolete: use FFL]"@en ,
        "Four Fathom Limestone [Obsolete: use FFL]"@en ,
        "Low Dean Limestone [Obsolete: use FFL]"@en ,
        "Sandbanks Limestone [Obsolete: use FFL]"@en ,
        "Second Limestone [Obsolete: use FFL]"@en ,
        "Underset Limestone [Obsolete: use FFL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone with subsidiary mudstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FFL"@en ;
    skos:prefLabel "Four Fathom Limestone Member"@en ;
.

namedrockunit:FIN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VLSS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clastic sediment, red-bed conglomerates, sandstones, siltstones and mudstones; contemporaneous acid volcanic rocks in the lower levels."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable in the northeast and east on the early Caledonian Tyrone Igneous Complex and the Lower Silurian at Pomeroy. Elsewhere in Fintona Block the contact is faulted."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1993 ,
        namedrockunit:H3404 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Difficult to gauge owing to lack of a distinctive lithostratigraphy. Estimated unreliably as c.3000m in east outcrop (1:50,000 Sheet 34, Pomeroy)."@en ;
    lexicon:hasUpperBoundaryDefinition "Either not exposed and faulted out, or overlain unconformably by Lower Carboniferous basal clastics and Visean marine sediments on the south side of the Fintona Block."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KILS ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dingle Beds [Obsolete: use FIN, TPMS, BRC, BLM]"@en ,
        "Fintona Beds [Obsolete: use SHAN, FIN]"@en ,
        "Kilskeery Group"@en ;
    skos:broader namedrockunit:ORS ;
    skos:definition "Conglomerate, mudstone, sandstone and siltstone with subsidiary volcaniclastic rocks (both pyroclastic and reworked volcanic rocks). Stratified bedrock. Occurs onshore. Deposited during the Mid Devonian Epoch - to - Late Devonian Epoch (Devonian Period) (394.3-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GOCF ,
        namedrockunit:RSF ,
        namedrockunit:SHAN ,
        namedrockunit:SMSF ,
        namedrockunit:TEDD ;
