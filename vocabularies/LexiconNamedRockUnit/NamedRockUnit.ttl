namedrockunit:SHHB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Varied sequence of greenish grey, silty, moderately shelly and calcareous mudstones, pale greenish grey shelly marls and fine-grained shelly limestones with marine and freshwater faunas. Rootlets are common, and some mudstones display seatearth textures and more variegated colours, also indicating shallow, proximal conditions. Subordinate siltstone and sandstone beds are present near the base of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Non-sequential, on the Chipping Norton Limestone Formation, where present or the Horsehay Sand Formation. The base, which may be marked by an uneven junction, is taken as the first mudstone (commonly carbonaceous), marl, sand or micritic limestone (commonly richly fossiliferous or pebbly), above the ooidal limestones of the Chipping Norton Limestone Formation (Horton, 1987, p.74), or the barren sands of the Horsehay Sand Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3673 ,
        namedrockunit:H523 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 5 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by ooidal and shelly detrital limestones of theTaynton Limestone Formation, where present, otherwise, the formation is difficult to distinguish from the lithologically similar Rutland Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CHAR ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Charlbury Limestone Member"@en ,
        "Neaeran Beds [Obsolete: use SHHB]"@en ,
        "Sharp's Hill Beds [Obsolete: use SHHB]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Calcareous mudstone, limestone and mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHHB"@en ;
    skos:prefLabel "Sharp's Hill Formation"@en ;
.

namedrockunit:SHIP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to off-white or yellowish limestone, peloidal wackestone and packstone with subordinate ooidal and shell fragmental grainstone, and re-crystallised limestone with beds of argillaceous limestone, marl and mudstone or clay."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the peloidal wackestone/packstone/grainstone, overlies marls and fine-grained ooidal grainstones of the Hampen Formation or Rutland Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1179 ,
        namedrockunit:H1819 ,
        namedrockunit:H4883 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 3 m to 10 m thick, increasing to the south-west, about 4 m thick in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "A generally sharp, erosive boundary, and commonly a bored and oyster-encrusted hardground,at  the top of the Excavata Bed, which is a peloidal packstone at the top of the Shipton Member, and generally succeeded by a sandy mudstone or sandy limestone at the base of the Ardley Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ardley Beds [Obsolete: use SHIP]"@en ,
        "Croughton Member [Obsolete: use SHIP]"@en ,
        "Excavata Beds [Obsolete: use SHIP]"@en ;
    skos:broader namedrockunit:WHL ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHIP"@en ;
    skos:prefLabel "Shipton Member"@en ;
.

namedrockunit:SHLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:AVL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale to dark grey, argillaceous, crinoidal, shelly bioclastic limestone, interpreted to be of marine origin. Thicker occurrences consist of calcareous mudstone and lime mudstone with a dolomitic top."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a conformable change from marine mudstone within the Lower Limestone Formation, underlain by Lillie's Shale Coal in the Glasgow area. Not uncommon for Second and Top Hosie limestone to be separated by only marine strata or even to become fused together."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BIBU ,
        namedrockunit:MIKI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Generally up to 0.38m, and locally up to 2.10m in the Airdrie, Falkirk and Glasgow districts. This limestone fuses with the Top Hosie Limestone in the west Glasgow district and at Wairdlaw [NS 995 731] in the Bathgate Hills. In shelf settings, such as in Midlothian, it can be as much as 15m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally seen as a conformable change to marine mudstone within the Lower Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Anvil Limestone"@en ,
        "Bilston Burn Limestone [Obsolete: use SHLS]"@en ,
        "Mid Kinniny Limestone [Obsolete: use SHLS]"@en ;
    skos:broader namedrockunit:LLGS ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHLS"@en ;
    skos:prefLabel "Second Hosie Limestone"@en ;
.

namedrockunit:SHREW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S106 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stratified sand and gravel with interbeds of laminated clay, silt and diamict (till), all characteristically containing Lower Palaeozoic clasts derived from the Welsh Massif."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on elements of the Stockport Glacigenic Formation (after Bowen, 1999) at the stratotype locality, and locally on the Merion Till Member (Plynlimon Glacigenic Formation)in the Shrewsbury area (Thomas, 1989). At some locations farther north, it interdigitates with glacigenic deposits of the Irish Sea Coast Glacigenic Subgroup derived from the Irish Sea Basin in a complex manner (Worsley, 2005; Cannell, 1982). Locally, it overlies bedrock unconformably."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BOC ,
        namedrockunit:H3029 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c.6m at the stratotype locality."@en ;
    lexicon:hasUpperBoundaryDefinition "Irregularly overlain at the stratotype locality by Late Glacial solifluction deposits and thence Windermere interstadial peat (Worsley, 1991) of the Britannia Catchments Group. Elsewhere provides the present ground surface or is overlain unconformably by fluvial deposits of the Severn and Avon Catchments Subgroup."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Boulder clay [Obsolete: use TILL]"@en ,
        "Fluvio-glacial flood gravels [Obsolete: use SHREW]"@en ,
        "Shrewsbury Formation"@en ;
    skos:broader namedrockunit:WALES ;
    skos:definition "Diamicton, gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHREW"@en ;
    skos:prefLabel "Shrewsbury Glacigenic Formation"@en ;
.

namedrockunit:SHYS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member is an alternating succession of fine- to medium-grained glauconitic sand and sandstone. At the top, a massive, 2 to 3m-thick, shelly calcareous sandstone called the Ragstone is present in some areas."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is not usually observed and is probably gradational with an upwards decrease in silt and clay grade material and mica of the underlying Cann Sand Member up into fine- to medium-grained glauconitic, partially cemented sands of the member. In field mapping terms the boundary is a well-marked feature break, presumably coinciding with incoming of cemented sandstone in the overlying Shaftesbury Sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1181 ,
        namedrockunit:H3676 ,
        namedrockunit:H525 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 25m (3.9m exposed at the type locality, of a total thickness of about 15m)."@en ;
    lexicon:hasUpperBoundaryDefinition "In general the upper boundary is placed at the facies change from indurated, shell-rich sandstone without chert (\"Ragstone\") of the Shaftesbury Sandstone Member, to less indurated sandstone with regularly developed beds of chert of the Boyne Hollow Chert Member. Where the \"Ragstone\" is absent the boundary is placed below the lowest chert bed or at a disconformity immediately beneath. The boundary is locally marked by phosphatic nodules in the Shaftesbury (Sheet 313) district, and may also be disconformable thereabouts. In some parts of the Shaftesbury district, the upper boundary is the unconformable contact with the Bookham Conglomerate Bed at the base of the Chalk Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ragstone Beds [Obsolete: use SHYS]"@en ,
        "Ragstone [Obsolete: use SHYS]"@en ,
        "Ragstone and Freestone Beds [Obsolete: use SHYS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Calcareous sandstone, sand and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHYS"@en ;
    skos:prefLabel "Shaftesbury Sandstone Member"@en ;
.

namedrockunit:SI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically brownish grey sandy or clayey peloidal wackestone, commonly with shell-fragments and lignite, associated with green and brown mudstone/clay; also shell-fragmental ooidal grainstones, brown sandy limestone and white carbonate mudstone and coralliferous marl."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of rock types as described in lithological description, resting on (generally) hardground or eroded surface of white carbonate mudstone or wackestone at top of underlying Ardley Member of White Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4326 ,
        namedrockunit:H526 ,
        namedrockunit:KEB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - 11m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally sharp, erosive boundary with cross-bedded shell-fragmental ooidal limestone, or mudstone of Forest Marble Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kemble Beds Units I And II [Obsolete: use SI]"@en ,
        "Kemble Beds [Obsolete: use BLAD, FMB, SI]"@en ,
        "Signet Beds [Obsolete: use SI]"@en ;
    skos:broader namedrockunit:WHL ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SI"@en ;
    skos:prefLabel "Signet Member"@en ;
.

