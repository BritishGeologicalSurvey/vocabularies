namedrockunit:SILS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine- to very coarse-grained pebbly feldspathic sandstone, interbedded with grey siltstone and mudstone and subordinate marine black shales, thin coals and seatearths. The lower part of the formation is dominated by thinly bedded sandstone, siltstone and mudstone forming sharp-based, normal graded beds of interpreted turbiditic origin."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp base of dark grey fissile claystones of the Cravenoceras cowlingense Marine Band with diagnostic eponymous fauna, commonly underlain by a thin, fine-grained, calcareous and phosphatic sandstone of the Pendleton Formation. Elsewhere the boundary is taken at the base of the first thick quartz-feldspathic sandstone of Arnsbergian age, present above the dark grey, carbonaceous mudstone of the Bowland Shale Formation. It is taken at the base of the Mirk Fell Ironstones in the Stainmore Trough or the top of the Lower Howgate Edge Grit in the northern part of the Askrigg Block."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CSH ,
        namedrockunit:H2117 ,
        namedrockunit:H3030 ,
        namedrockunit:H3304 ,
        namedrockunit:H4285 ,
        namedrockunit:H4327 ,
        namedrockunit:MDGT ,
        namedrockunit:SLVS ,
        namedrockunit:SMGR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Lancaster 1000m; Bradford 400m; Askrigg Block and Stainmore Trough up to 190m."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the dark grey fissile claystones of the Isohomoceras subglobosum Marine Band, with diagnostic eponymous fauna. Where the Marine Band is not proven, the boundary is taken at the base of a thick, medium or dark grey mudstone succession, with numerous marine bands of the Samlesbury Formation.It is taken at the top of the Lower Follifoot Grit in the southern part of the Askrigg Block, or the base of a mudstone succession with Lingula in the Stainmore Trough."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
