namedrockunit:BDNS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent namedrockunit:SHWK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine- to coarse-grained, glauconitic sandstone, locally very shelly with thin lenticular and tabular beds of chert. Locally developed thin glauconite-rich horizons and complex bedding, including slump bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is immediately above the Whitecliff Hardground, a mineralised surface, at the top of the Whitecliff Chert Member. Chert horizons are generally much thinner and less regularly developed in this member than in the Whitecliff Chert Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:SHWK ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 8m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the member is marked by the Small Cove Hardground, immediately below the base of the Beer Head Limestone Formation. In most areas the boundary is a sharp upward facies change from glauconitic sandstone to indurated limestone. A less-pronounced facies change occurs where the Bindon Sandstone is locally overlain (e.g. Hooken Cliff) by the Wilmington Sandstone Member (nodular calcareous bioclastic sandstone) of the Beer Head Limestone Formation, but the Small Cove Hardground is a persistent feature."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Shapwick Member [Obsolete: use BDNS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Glauconitic sandstone with subsidiary chert and shelly sandstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BDNS"@en ;
    skos:prefLabel "Bindon Sandstone Member"@en ;
.

namedrockunit:BDTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S373 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DIATOM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown, gravelly sandy silty clayey diamicton dominated by locally-derived clasts such as of the Kidderminster Formation (Bunter Pebble Beds) conglomerates, but with a significant proportion of erratics including grey granite from the Southern Uplands, striated volcanic rocks, Eskdale Granite, Ennerdale Granophyre and slates from the Lake District, limestone, flint and marine shells. The tills are typically thinner, more eroded, more weathered and considerably more cryoturbated than those of the Stockport Glacigenic Formation lying to the north of the Wrexham-Ellesmere-Whitchurch-Barr Hill Moraine in Cheshire."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with fluviatile gravel (Four Ashes Sand and Gravel Formation) containing mainly well rounded clasts derived from the Kidderminster Formation (Bunter Pebble Beds) conglomerates and numerous organic-rich lenses of Ipswichian to Middle Devensian age. The diamicton is heavily cryoturbated at the type section at Four Ashes where it has been loaded down into the underlying gravel."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1340 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3 m at type section. Up to 17 m at Madeley in Telford district"@en ;
    lexicon:hasUpperBoundaryDefinition "The ground surface or unconformable contacts with glaciofluvial sand and gravel or younger Quaternary deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Stockport Formation"@en ,
        "Unnamed till of Irish Sea provenance at Four Ashes [Obsolete: use BDTI]"@en ;
    skos:broader namedrockunit:ISCG ;
    skos:definition "Diatomite with subsidiary gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BDTI"@en ;
    skos:prefLabel "Brewood Till Formation"@en ;
.

