namedrockunit:CCHR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses fluvial, lacustrine and organic deposits of the pre-diversionary River Thames. Most of the surviving deposits are fluvial gravels, with sedimentary structures indicating deposition by a braided river. Lacustrine silts and clays and organic peats are uncommon. The gravels of the formation are characterised by quartz and quartzite from the Triassic, Carboniferous and Devonian rocks of the West Midlands, Welsh borderland and possibly southwestern Pennines, and felsic volcanic rocks from northern Wales. These lithologies form a lower percentage than in the Sudbury Formation, and are believed to be derived from that formation, but mega-erratics and felsic volcanic rocks from Wales and the Welsh borderland occur with a  generally greater frequency than in the Sudbury Formation. The fluvial gravels occupy terrace levels and the members are defined on the basis of altitude and pebble clast content. The members comprise bodies of cross-bedded and massive, moderately sorted sand and gravel. The aggredations are generally entrenched into bedrock with a difference in surface elevation in the order of 5m. Intraformational ice wedge casts and pollen indicate periglacial, cool temperate and warm temperate climates."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock: Cretaceous, Palaeogene and Crag Group. Differentiation from the Crag Group can be difficult where the latter is reworked, and the distinction must be made on the basis of sedimentological structures: the Crag Group is marine, the Kesgrave Catchment Subgroup is fluvial."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3284 ,
        namedrockunit:KES ,
        namedrockunit:KGSG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Individual terrace aggradations are typically 5-12m thick, total thickness may locally reach c.21.3m."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by Middle Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is usually helpful. The uppermost 1.0-1.5m of the formation is commonly affected by the Valley Farm Soil, a rubified and clay-enriched horizon, and/or by the Barham Arctic Structure Soil, a complex pedogenic horizon (Rose et al., 1985)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Essex White Ballast [Obsolete: use KGCA]"@en ,
        "Kesgrave Formation [Obsolete: use KGCA]"@en ,
        "Kesgrave Sands and Gravels [Obsolete: use KGCA]"@en ;
    skos:broader namedrockunit:KGCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:S133 ,
        namedrockunit:S753 ,
        namedrockunit:S864 ,
        namedrockunit:WALD ,
        namedrockunit:WIHG ,
        namedrockunit:WLGR ;
    skos:notation "CCHR"@en ;
    skos:prefLabel "Colchester Formation"@en ;
.

namedrockunit:CHCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A generally massive, well-rounded pebble and boulder (up  to 0.6m diameter) conglomerate, of andesitic lava, locally quartzite and other lithologies of 'Highland' origin, interbedded with andesite, basaltic andesite and basalt lava members, together with minor sandstone, siltstone and mudstone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "An unconformable contact on ignimbrites of the Crawton Volcanic Formation or on Dalradian Supergroup metamorphic rocks, varied along the Highland Border area."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Over 500 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the Scone Sandstone Formation, which is locally overlain by the Hatton Conglomerate Member, with the Highland conglomerate overlying the volcanic conglomerate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
