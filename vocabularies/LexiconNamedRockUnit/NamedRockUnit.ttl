namedrockunit:CRBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown, poorly to moderately cemented breccia with a silt, sand and clay matrix. Clasts mostly less than 4cm. Clasts of sandstone, siltstone, slate, shale, hornfells, chert, acid lava and tuff, quartz-porphyry, vein quartz, and a variety of tournalinised rocks. Poorly developed bedding in units mostly over 1m thick. Thin interbedded or lenses of red mudstone throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies unconformably early Permian formations - Knowle Sandstone, Bow Breccia, Cadbury Breccia, Thorverton Sandstone, except in Crediton area, where the Creedy Park Sandstone intervenes."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CRCG ,
        namedrockunit:H1456 ,
        namedrockunit:H817 ,
        namedrockunit:H818 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 240m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Newton St Cyres Breccia fairly sharply, with feature locally developed at the junction. East of Shute [SS 890 001] overlain by the Shute Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crediton Beds [Obsolete: use CRBR]"@en ,
        "Crediton Breccias [Obsolete: use CRBR]"@en ,
        "Crediton Conglomerates [Obsolete: use CRBR]"@en ,
        "Yenpacott Breccia [Obsolete: use CRBR]"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Breccia. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRBR"@en ;
    skos:prefLabel "Crediton Breccia Formation"@en ;
.

namedrockunit:CRF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ORMUD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the fluvial, lacustrine and organic deposits of the postulated 'Ancaster River', which is believed to have flowed from the Pennines to the North Sea along a line corresponding approximately to the present north coast of Norfolk. Four members are recognised in north Norfolk coastal sections. The Sheringham Member (lowest member) comprises freshwater organic mud, clay and sand. The Runton Member includes laminated freshwater silty clay. The West Runton Member comprises layers of alluvial clay and organic freshwater mud. The Bacton Member (highest Member) comprises clay and organic mud."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests disconformably on Chalk or on Wroxham Crag Formation, and interdigitates with Wroxham Crag Formation. The interdigitated succession is as follows, from top down: Bacton Member (Cromer Forest-bed Formation); Mundesley Member (Wroxham Crag Formation); Runton Member  (upper part, Woman Hithe Gravel of Reid, 1882;  Wroxham Crag Formation); Runton Member (lower part, Woman Hithe Clay of Reid, 1882; Cromer Forest-bed Formation); Paston Member (Wroxham Crag Formation); Sheringham Member (Cromer Forest-bed Formation); Sidestrand Member (Wroxham Crag Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Middle Pleistocene glacial deposits (Happisburgh Glacigenic, Lowestoft, Sheringham Cliffs and Briton's Lane formations)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DUNW ;
    skos:definition "Clay, organic mud and silt with subsidiary peat and sand. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BACTO ,
        namedrockunit:RUNTO ,
        namedrockunit:SHERI ,
        namedrockunit:WRUNT ;
    skos:notation "CRF"@en ;
    skos:prefLabel "Cromer Forest-bed Formation"@en ;
.

namedrockunit:CRK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYLTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Rhyolitic tuffs, lapilli-tuffs and pyroclastic breccias that are mostly very densely welded; rocks are conspicuously garnetiferous. Widespread intercalations of laminated rhyolitic tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of high-grade rhyolitic pyroclastic rocks. Locally unconformable on older parts of Airy's Bridge Tuff Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3956 ,
        namedrockunit:H4568 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - 700m"@en ;
    lexicon:hasUpperBoundaryDefinition "Contact with overlying formations comprising a mixed succession of bedded pyroclastic rocks and volcaniclastic sandstones, containing lavas and sills of andesite and basaltic andesite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crinkle Member [Obsolete: use CRK]"@en ,
        "Crinkle Tuffs [Obsolete: use CRK]"@en ;
    skos:broader namedrockunit:AIB ;
    skos:definition "Rhyolitic lapilli-tuff and rhyolitic tuff with subsidiary pyroclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BDP ,
        namedrockunit:REG ;
    skos:notation "CRK"@en ;
    skos:prefLabel "Crinkle Tuff Member"@en ;
