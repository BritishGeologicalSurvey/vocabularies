    lexicon:hasLithologyDescription "A soft red sandstone with abundant beds of \"millet seed\" sand grains alternating with beds of fine-grained sharp sand (Tonks, and others, 1931); some interbedded grey sandstones locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary is a major plane of unconformity, generally on reddened Carboniferous Coal Measures strata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3964 ,
        namedrockunit:H748 ;
