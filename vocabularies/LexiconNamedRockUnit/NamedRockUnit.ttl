    lexicon:hasThicknessDescription "To 220m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by silty mudstones of the Aran Volcanic Group over much of the Harlech district, but locally overstepped by the Benglog Formation with apparent unconformity/disconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasYoungestAgeValue 4.582e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Melau Tuff Formation [Obsolete: use MU]"@en ;
    skos:broader namedrockunit:AVG ;
