namedrockunit:LAWSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, flat laminated and also cross bedded grey, fine- to coarse-grained sand with silt and traces of fine gravel, locally loose to dense, dark brownish grey, framework-supported, sub-angular to rounded fine to medium gravel with sand. Bedded silt with thin peat units and organic layers are intercalated. In places the member may encompass an even wider range of grain sizes including coarse gravel, cobbles and boulders."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably on bedrock and many older Quaternary strata including the Wilderness Till Formation and Bellshill Clay Member at Law and conformably on the Lochwinnoch Clay Member at Lochwinnoch."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LAW ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 18m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Law Sand and Gravel Member passes insensibly downstream into the estuarine and marine deposits of the Gourock Sand and Erskine Clay members of the Clydebank Clay Formation. It is widely exposed at the surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Law Formation [Obsolete: use CLVY, LAWSG]"@en ;
    skos:broader namedrockunit:CLVY ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LAWSG"@en ;
    skos:prefLabel "Law Sand And Gravel Member"@en ;
