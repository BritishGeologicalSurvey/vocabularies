namedrockunit:TNTH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDHLM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The succession is dominated by laminated hemipelagic mudstone and siltstone (Brathay and Wray Castle mudstone formations) that record a background accumulation of anaerobic organic mud with periodic input of turbiditic sand. Interbedded with these are a unit of calcareous siltstone (Coldwell Siltstone Formation) and units of turbiditic sandstone (Birk Riggs Sandstone Formation in the south-west Lake District, and the Austwick Sandstone Formation in the Craven inliers). The nomenclature is distinct in the Craven inliers (Arthurton et al., 1988), reflecting the subtle differences in lithofacies. \r
\r
Wenlock to lower Ludlow (lowest Gorstian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the group coincides with that of the Brathay Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2491 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SS> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "From Ulverston to Shap the thickness varies between 450 and 1110 m, whereas only 260 m are present in the Howgill Fells."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by the diachronous base of the overlying Coniston Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasYoungestAgeValue 4.25e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Windermere Group [Obsolete: use TNTH, WIN]"@en ;
    skos:broader namedrockunit:WIN ;
    skos:definition "Laminated hemipelagic mudstone and siltstone with subsidiary calcareous siltstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Sheinwoodian Age - to - Gorstian Age (Silurian Period) (432.9-425 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AUF ,
        namedrockunit:BBWC ,
        namedrockunit:BKR ,
        namedrockunit:BRF ,
        namedrockunit:CDW ,
        namedrockunit:HNF ,
        namedrockunit:WRE ;
    skos:notation "TNTH"@en ;
    skos:prefLabel "Tranearth Group"@en ;
