namedrockunit:TRLI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A pale to dark grey, typically darker towards the base, micritic to crystalline limestone, with subordinate partings and thin beds of calcareous mudstone, locally abundant chert, crinoid and brachiopod debris. A pale grey, fine- to medium-grained dolostone is locally present, near the base of the group. \r
\r
Shallow water platform to ramp carbonates. Chadian to Brigantian."""@en ;
    lexicon:hasLowerBoundaryDefinition "A conformable base of argillaceous dolostone (Holme Chapel Borehole) or dark grey to black blocky claystone, grading upward into medium to dark grey micritic limestone of the Trawden Limestone Group, above pale grey medium-grained sandstone with siliceous and dolomitic cement, interbedded with medium to dark grey fine-grained sandstone, with an argillaceous and dolomitic matrix of the Roddlesworth Formation (Roddlesworth Borehole). The base is evident as a sharp change from highly serrated and high gamma responses below, and generally lower and more subdued  gamma ray responses above the boundary."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Thickest development of 1055 m in the type locality, and 422 m in the Holme Chapel Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the group is marked by a conformable base of the overlying dark brown to black, calcareous and carbonaceous claystone to siltstone, of the Bowland Shale Formation above pale grey limestone of the Trawden Limestone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carboniferous Limestone [Obsolete: use CL, PKLM, CLWYD, PEMB, BOHI, HOHI, TRLI]"@en ;
    skos:broader namedrockunit:CL ;
    skos:definition "Limestone with subsidiary dolostone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Brigantian Substage (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TRLI"@en ;
    skos:prefLabel "Trawden Limestone Group"@en ;
.

