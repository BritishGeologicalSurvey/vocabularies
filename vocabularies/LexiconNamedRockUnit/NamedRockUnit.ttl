namedrockunit:SELF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The dominant lithology is a red-brown, weathering to orange-brown, fine-grained, well-sorted sandstone with well-rounded grains of aeolian origin. It is commonly cross-bedded. This aeolian dune facies is interbedded with an interdune facies comprising well-cemented fine- to medium-grained, poorly sorted sandstone with common wavy silty laminae. Small-scale convolutions, loading and dewatering structures are common."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the sharp upward change from fine- to coarse-grained fluvial sandstone in the underlying undivided Helsby Sandstone Formation to medium-grained, aeolian sandstone. In borehole geophysical logs it is marked by an upward decrease in gamma-ray values and an upward increase in mean interval transit time in the sonic log. Both log signatures are more serrated than in the underlying part of the Helsby Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4998 ,
        namedrockunit:OMS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickest known sequence is 176.42 m, in the Sellafield 13B Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is not seen but will be marked by the incoming of dominantly red-brown mudstones and siltstones of the Mercia Mudstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kirklinton Sandstone [Obsolete: use SELF]"@en ,
        "Ormskirk Sandstone Formation [Obsolete: use HEY, SELF]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SELF"@en ;
    skos:prefLabel "Sellafield Member"@en ;
.

namedrockunit:SEO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, typically fine- to medium-grained but ranging from very fine- to coarse-grained. Generally medium- to thick-bedded over thicknesses of tens of metres interspersed with units up to few metres very thin to thin-bedded. Interbedded siltstone or silty mudstone generally in thin beds; sandstone and siltstone typically greenish grey when fresh, pale brown weathering. The Selcoth Formation is of broadly similar character to the Glendearg Formation, although it lacks the very thick-bedded parallel laminated sandstone units typical of the latter and has a very restricted age range in comparison."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable sedimentary boundary with rocks of the Moffat Shale Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4033 ,
        namedrockunit:H4034 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Few hundred metres to 2000m"@en ;
    lexicon:hasUpperBoundaryDefinition "Faulted, no stratigraphical contact preserved."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Queensbury Formation [Obsolete: use ETRK, KKHP, SEO]"@en ,
        "Queensbury Grits [Obsolete: use ETRK, KKHP, QBY, SEO]"@en ;
    skos:broader namedrockunit:ETRK ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Llandovery Epoch (Silurian Period) (443.1-432.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SEO"@en ;
    skos:prefLabel "Selcoth Formation"@en ;
.

