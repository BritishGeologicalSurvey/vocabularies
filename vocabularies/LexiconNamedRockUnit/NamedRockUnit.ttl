namedrockunit:MNTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S926 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Generally stiff, blue-grey, stony, sandy and silty clay and clayey gravel, characteristically containing Lower Palaeozoic clasts (derived from the Cambrian Mountains) with some erratics from Snowdon and the Harlech Dome. Subordinate stratified sand and gravel are locally present. Colour and dominant clast composition are variable and generally reflect the local bedrock geology."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally unconformable on bedrock or regolith/head (e.g. Hiraethog Member of Bowen 1999)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3232 ,
        namedrockunit:H4636 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Highly variable, locally in excess of 30m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or unconformable contact with overlying peat, head, river terrace deposits or alluvium (Cheshire - North Wales Catchments Subgroup). The surface of the till is drumlinized in the Conwy Valley, on Mynydd Hiraethog and in the southern part of the Vale of Clwyd."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Central Wales Drift [Obsolete: use ELTI, MNTI, PLYNT]"@en ,
        "Meirion Formation [Obsolete: use WALES]"@en ,
        "Welsh till [Obsolete: use MNTI, PLYNT, BNOCK]"@en ;
    skos:broader namedrockunit:PLYNT ;
    skos:definition "Diamicton with subsidiary gravel and sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MNTI"@en ;
    skos:prefLabel "Merion Till Member"@en ;
.

namedrockunit:MONT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Montrose Group is characterized by mudstones that are variable in character but that differ from those of the overlying Moray Group in containing an abundant microfauna and in being poorly bedded, non-pyritic and mostly non-carbonaceous. In its type area it comprises the Lista Formation and the Maureen Formation, of which only the Lista Formation extends into the more southerly parts of the Southern North Sea. The mudstones of the Maureen Formation display a downward increase in the proportion of carbonate, culminating in chalky marls that grade downwards into the chalky limestones of the Ekofisk Formation. The sandstones of the Montrose Group were deposited as submarine fans (Parker 1975; Knox et al., 1981; Rochow 1981; Mudge and Bliss 1983; Stewart 1987)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Maureen Formation is taken at the upward change from chalky limestone or marl of the Chalk Group or Shetland Group to a more variable succession of thinly interbedded marl and limestone with local sandstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "The Montrose Group reaches over 600 m in parts of the Outer Moray Firth."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downward change from grey to grey-brown, carbonaceous, pyritic, mudstones and siltstones of the Moray Group to greenish, non-pyritic mudstones with abundant microfauna of the Montrose Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and sandstone with subsidiary limestone and tuff. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LIST ,
        namedrockunit:MAUR ,
        namedrockunit:TAB ;
    skos:notation "MONT"@en ;
    skos:prefLabel "Montrose Group"@en ;
.

