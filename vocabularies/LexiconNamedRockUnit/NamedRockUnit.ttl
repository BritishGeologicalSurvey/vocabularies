namedrockunit:KNL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, scar-forming limestones, mostly thick-bedded biosparites and biopelsparites commonly pseudobrecciated, and probable thin siliciclastic bed, not exposed at type section."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlying Potts Beck Limestone comprises interbedded pale grey limestones (of those in Knipe Scar Limestone), dark grey limestones and sandstones (up to 3 metres thick)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "61m seen, but top 16 metres of formation not present - but exposed in sections on Limestone Scars within 1 km to east and can be seen to comprise comparable thick-bedded pale grey limestones. Thickness fairly constant along outcrop on NY60NW and NY60NE with slight eastward increase up to c.90 metres on Little Asby Scar."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlying beds are a variable sandstone/siltstone/mudstone unit between Knipe Scar and Robinson Limestones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone and trace mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
