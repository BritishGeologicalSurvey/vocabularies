    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "c.40m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed; sandstones of the Nottage Crag Grit are overlain by siltstone of the Claughton Moor Siltstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Claughton Member"@en ,
        "Crossdale Grit"@en ;
    skos:broader namedrockunit:CLAU ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NOT"@en ;
    skos:prefLabel "Nottage Crag Grit"@en ;
.

