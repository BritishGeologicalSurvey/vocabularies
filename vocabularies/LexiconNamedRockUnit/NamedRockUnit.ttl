namedrockunit:BOWO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, massive and thickly bedded limestone.  At the type locality the formation comprises very fine-to-very coarse-grained, slightly dolomitised packstones containing shell fragments with micritic [cyanobacterial] coatings, and calcareous mudstones"@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is not proved and the underlying succession is unknown"@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2632 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Minimum thickness of 13.5m measured at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "At Astbury [SJ 86 59], the top of the formation is taken at the conformable base of the mudstone-rich succession, with surbordinate limestone, of the Astbury Formation above the limestone- dominated succession of the Bowsey Wood Formation.  In the Bowsey Wood and Bittern's Wood boreholes the top of the formation is an unconformity, overlain by mudstone of the Bowland Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Astbury Limestone [Obsolete: use BOWO]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BOWO"@en ;
    skos:prefLabel "Bowsey Wood Formation"@en ;
.

