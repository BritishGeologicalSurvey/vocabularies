        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly of sandstones arranged in upward-fining cycles; argillaceous rocks are commonly poorly bedded: mainly fluvial in origin."@en ;
    lexicon:hasLowerBoundaryDefinition "The conformable base of the Formation lies in a lithological transition and is taken above the highest bed of carbonate conglomerate belonging to the underlying Clyde Sandstone Formation (formerly Balcomie Beds)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H256 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum thickness exceeds 230m in east Fife."@en ;
    lexicon:hasUpperBoundaryDefinition "Not known at outcrop: would be taken at the lithological change to the relatively mudstone/sitlstone-rich cyclical deposits of the overlying Anstruther Formation from the sandstone dominated sequences of the Fife Ness Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
