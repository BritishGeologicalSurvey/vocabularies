    skos:definition "Sandstone with subsidiary conglomerate, limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Llandovery Epoch (Silurian Period) (443.1-432.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RBS"@en ;
    skos:prefLabel "Rubery Sandstone Member"@en ;
