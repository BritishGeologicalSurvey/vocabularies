    lexicon:hasThicknessDescription "775m in type area (maximum aggregate of partial type sections)."@en ;
    lexicon:hasUpperBoundaryDefinition "Hard, grey, commonly fractured mudstone overlain with unconformity by beds that may comprise: Devonian sandstone or conglomerate, Carboniferous mudstone, sandstone and Triassic breccia or mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
