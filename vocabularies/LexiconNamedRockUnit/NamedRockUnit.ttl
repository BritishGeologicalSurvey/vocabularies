namedrockunit:CFS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "White and pale grey, fine- to medium-grained, planar- and cross-bedded, quartzose sandstones, pebbly sandstones and thin beds of quartz conglomerate; with units of calcareous sandstone, sandy limestone, chert and siliceous mudstones in lower part; locally thick beds of siltstone and mudstone, and thin, impersistent coal seams. Lithologies are commonly arranged in coarsening upwards cycles. The Formation records fluviodeltaic deposition across the former North Wales Dinantian platform. The cyclic arrangement of lithologies represent progradational sequences formed in response to contemporary movements in marine base level. The sandstones and conglomerates record the advance of delta distributary channels and mouth bars across finer pro-delta and interdistributary mud and silt facies."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of sandstone and conglomerate of Cefn-y-Fedw Sandstone Formation where it rests conformably on sandy limestone of the Minera Formation or Cefn Mawr Limestone Formation. Intertongues on Halkyn Mountain with Pentre Chert Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CTSH ,
        namedrockunit:H1423 ,
        namedrockunit:H2071 ,
        namedrockunit:H3918 ,
        namedrockunit:H3919 ,
        namedrockunit:H768 ,
        namedrockunit:HAF ,
        namedrockunit:MCFS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 585m"@en ;
    lexicon:hasUpperBoundaryDefinition "Highly diachronous, but taken at conformable contacts between sandstone of the Cefn-y-Fedw Sandstone Formation and mudstones of the Bowland Shale Formation. However, the two formations exhibit complex intertonguing."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CZ> ;
    lexicon:hasYoungestAgeValue 3.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
