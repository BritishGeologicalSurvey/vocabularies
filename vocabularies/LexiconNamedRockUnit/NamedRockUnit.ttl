namedrockunit:AVLY
    a skos:Concept ;
    lexicon:hasLithologyDescription "The Aveley Member comprises mainly homogeneous silty clay, which is, however, very silty and micaceous at some levels. There are regular discontinuous layers of claystone concretions. Thin beds or partings of clayey silt, very fine-grained sand or glauconitic clay are present at some levels. The basal part is sandier and finely glauconitic (King, in prep.)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Aveley Member is marked by a thin basal bed of sandy silty clay, some of which is glauconitic, above the silty clay with thin layers and partings of well-sorted, fine-grained sand of the Ockendon Member, and by a return to mainly homogeneous clay."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5079 ,
        namedrockunit:UNITC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 56m in the type area (King, in prep.)"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Aveley Member is marked by a change upwards to silty clay with common sandy clayey silt interbeds of the Sheppey Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Division B and the lower part of Division C of King, 1981 [Obsolete: use AVLY]"@en ,
        "Unit C of Ellison et al., 2004 [Obsolete: use AVLY]"@en ;
    skos:broader namedrockunit:LC ;
    skos:definition "Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AVLY"@en ;
    skos:prefLabel "Aveley Member"@en ;
.

