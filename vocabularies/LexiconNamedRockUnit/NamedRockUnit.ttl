namedrockunit:WDH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale lilac or pink trachytes and andesites with phenocrysts of biotite and alkali-feldspars. Generally highly kaolinized."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: where rhyolitic tuff and flow-banded rhyolite of the Caerketton Volcanic Member are overlain by, or locally interbedded with, pale lilac or pink trachytes and andesite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1269 ,
        namedrockunit:H1270 ,
        namedrockunit:WBG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasOldestAgeValue 4.227e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Variable - 75-150m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable: where pale lilac or pink trachytes and andesites are overlain by feldspar-phyric and fine-grained microporphyritic basalts and andesites of the Carnethy Volcanic Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Woodhouselee Group [Obsolete: use WDH]"@en ,
        "Woodhouselee Volcanic Formation [Obsolete: use WDH]"@en ,
        "Woodhouselee and Braid Hills Group [Obsolete: use WDH]"@en ;
    skos:broader namedrockunit:PDH ;
    skos:definition "Andesite and trachytic-rock with subsidiary rhyolite. Stratified bedrock. Occurs onshore. Deposited during the Pridoli Epoch (Silurian Period) - to - Lochkovian Age (Devonian Period) (422.7-412.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WDH"@en ;
    skos:prefLabel "Woodhouselee Volcanic Member"@en ;
.

namedrockunit:WDHO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin-bedded mudstones, siltstones and sandstones, some of which are turbiditic and others cross-laminated and wave rippled. The succession is cut by several channels filled from 3 to 25 m deep by slumped and disturbed strata, or more rarely cross-bedded or cross-laminated sandstones"@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of channels overlain by syndepositionally disturbed units and thick, locally cross- bedded sandstones of the Westward Ho! Member above the regularly interbedded mudstones and turbidite sandstones of the underlying Crackington Formation. This boundary is not exposed on the coast at the type locality and has never been mapped, as the Westward Ho! Member was previously included in the Crackington Formation. Further investigation of this boundary is needed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CKF ,
        namedrockunit:H691 ,
        namedrockunit:WHF ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "400m+"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of coarsening-upwards cycles (mudstone, interbedded mudstone and sandstone, cross-bedded sandstone) of the main part of the Bideford Formation above the top of the Mermaid's Pool Sandstone, a thick, mappable, cross-bedded sandstone at the top of Westward Ho! Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crackington Formation"@en ,
        "Northam Beds [Obsolete: use BFF, WDHO]"@en ,
        "Westward Ho Formation [Obsolete: use BFF, WDHO]"@en ;
    skos:broader namedrockunit:BFF ;
