namedrockunit:CRKY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to yellowish brown limestones; lower part dominated by medium- to coarse-grained ooidal shell-fragmental grainstone ('Lower Limestone'), passing up into rubbly, poorly sorted, shelly, shell-detrital, moderately to highly pisoidal grainstones and packstones ('Pea Grit') with thin marl beds. South of Painswick, the succession is apparently replaced by ooidal grainstones comprising the Frocester Hill Oolite and Selsey Hill Oolite of Mudge, D C, 1978a, but the relationship between these strata and the type Crickley Member is uncertain."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward transition from ferruginous, bioturbated, sandy, muddy shell-detrital limestone (Leckhampton Member) into limestones as described in lithology."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H165 ,
        namedrockunit:H2116 ,
        namedrockunit:H3327 ,
        namedrockunit:H3937 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically about 7m. Type section (Crickley Hill); c.15.7m, probably the maximum (Ager, D V, 1969)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward gradation from pisoidal limestones as described in lithology, into ooidal grainstones (Cleeve Cloud Member) in mid and north Cotswolds; a non-sequence marked by a hardground in southern Cotswolds (Mudge, D C, 1978a)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crickley Limestone and Crickley Oncolite [Obsolete: use CRKY]"@en ,
        "Frocester Hill Oolite and Selsey Hill Oolite [Obsolete: use CRKY, CLCL]"@en ,
        "Lower Limestone and Pea Grit [Obsolete: use CRKY]"@en ,
        "Pea Grit Series [Obsolete: use CRKY]"@en ;
    skos:broader namedrockunit:BLPL ;
    skos:definition "Limestone with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LLST ;
    skos:notation "CRKY"@en ;
    skos:prefLabel "Crickley Member"@en ;
.

namedrockunit:CSEND
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravelly sandy silt diamicton. Crudely bedded, brown, matrix supported, non-calcareous. Clasts are typically angular to subangular. Clast lithologies are dominated by felsite with lesser amounts of quartzitic and psammitic metasediments, basic igneous rocks, red stained quartzites, red-brown sandstone, grey granite and pelitic metasediments. In thin section silt droplet fabrics have been recorded indicating incipient pedogenesis under cold climate conditions. A truncated ice-wedge cast has also been recorded descending from the upper surface of this deposit into the Rottenhill Till Formation beneath. Interpreted as a periglacial gelifluctate."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the bed is a planar, subhorizontal erosion surface truncating weathered diamicton of the Fernieslack Palaeosol Bed/Rottenhill Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H169 ,
        namedrockunit:H2126 ,
        namedrockunit:H2127 ,
        namedrockunit:H4537 ,
        namedrockunit:H823 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 0.80m"@en ;
