namedrockunit:DBTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dusky red stiff plastic silty and clayey diamicton with well dispersed sand grains and angular clasts (up to 30mm) of Borrowdale Volcanic Group rocks, Skiddaw Group siltstones and sandstones; some granite, red and white sandstone; sparse shell fragments. Rip-up clasts of underlying units common."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally planar subhorizontal unconformity generally on the Kirkland Wood Sand and Gravel Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1.07m thick at its type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the erosional base of the Drigg Holm Sand Member of the Gosforth Glacigenic Formation and by Holocene peat in a hollow on the foreshore at Barn Scar."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DBTI"@en ;
    skos:prefLabel "Drigg Beach Till Member"@en ;
