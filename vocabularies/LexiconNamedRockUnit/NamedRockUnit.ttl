namedrockunit:CSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use WLSF] Red brown, medium to coarse, generally poorly sorted well rounded sandstone, cross bedded.  Onshore aeolian sandstones are dominant: offshore fluvial sandstones are dominant."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary on the underlying St Bees Sandstone Formation is sharp and is taken at the upward change to typical aeolian sandstones from typical fluvial sandstones, which are finer grained and better cemented.  Geophysically the boundary is sharp, marked by an increase in sonic interval transit time and an increase in gamma-ray values. "@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1162 ,
        namedrockunit:H2125 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "469-529 m in Sellafield boreholes."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of a thick (40-50m) fluvial sandstone unit that is well cemented and overlain by coarser, less well cemented aeolian sandstones (Ormskirk Sandstone Formation). The top is marked by a rapid decrease in gamma-ray values and an increase in sonic interval transit times."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:WLSF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "St Bees Sandstone [Obsolete: use SBS, CHES]"@en ,
        "Upper St Bees Sandstone [Obsolete: use CSA]"@en ,
        "Wilmslow Sandstone Formation"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CSA"@en ;
    skos:prefLabel "Calder Sandstone Formation [Obsolete: use WLSF]"@en ;
.

namedrockunit:CSC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
