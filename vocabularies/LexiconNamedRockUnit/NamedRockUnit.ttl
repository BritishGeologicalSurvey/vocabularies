namedrockunit:CWYDV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, stratified gravels, sands, silts and clays forming the alluvial deposits of the River (Afon) Clwyd and its tributaries. Includes contemporaneous head, colluvium and pedogenic deposits within the catchment area. Clasts comprise variable proportions of Lower Palaeozoic turbidites, Ordovician volcanic rocks, Permian/Trias sandstone and Carboniferous Limestone and Coal Measures reflecting the underlying bedrock geology and complex glacigenic sequence. North of approximately Denbigh, the deposits in the Clwyd and the Wheeler valleys, as well as those in the lower reaches of the Elwy valley, may contain exotic (Irish Sea Ice-derived) materials reworked from the Lleyn Formation. Aggradational river terraces and major alluvial fans are dominated by pebble cobble gravels and medium- to coarse-grained sand; the modern floodplain is dominated by silt and clay, and locally includes lenses of peat (Warren et al., 1984)."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable and locally channelised, predominately on bedrock and Late Devensian head and glacigenic deposits (e.g Ruabon Member and Wheeler Member of Bowen, 1999, p.89, and Lleyn Formation). Interdigitates in a complex manner with Tidal Flat Deposits (Gwynllwg Formation of Bowen, 1999) in the estuary (Warren et al, 1984)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALF ,
        namedrockunit:ALV ,
        namedrockunit:HEAD ,
        namedrockunit:LDE ,
        namedrockunit:RTD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally to around 10m; 8m were recorded by Warren et al (1984) in the Vale of Clwyd and 6m are exposed near Plasnewydd [SH 9460 6640]."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface or, locally, overlain by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial fan deposits"@en ,
        "Alluvium"@en ,
        "Head"@en ,
        "Lacustrine deposits"@en ,
        "River terrace deposits"@en ;
    skos:broader namedrockunit:CNWCA ;
    skos:definition "Clay, gravel, sand and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CWYDV"@en ;
    skos:prefLabel "Clwyd Valley Formation"@en ;
.

