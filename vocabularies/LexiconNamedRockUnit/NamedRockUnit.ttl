namedrockunit:FWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Fawes Wood Limestone Formation comprises mid to dark grey biomicrosparites and biomicrites (calcarenite, mainly grainstone and packstone) with silty or stylolitic partings and some porcellaneous micrites. \r
\r
Shallow marine carbonate. Holkerian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The formation conformably overlies the sandstones of the Ashfell Sandstone and biosparites of the Tom Croft Limestone formations."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HTNL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation ranges in thickness from 80.77 m in the River Clough to 55.80 m in the Beckermonds Scar Borehole (Dunham and Wilson, 1985)."@en ;
    lexicon:hasUpperBoundaryDefinition "The formation is conformably overlain by the limestones with interbedded sandstones, siltstones and numerous thin beds of mudstone of the Garsdale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Horton Limestone [Obsolete: use FWL, GAL]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone and trace mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage (Carboniferous Period) (343-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FWL"@en ;
    skos:prefLabel "Fawes Wood Limestone Formation"@en ;
.

