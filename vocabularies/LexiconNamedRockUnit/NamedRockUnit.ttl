namedrockunit:LISA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to coarse-grained (rarely fine-grained) sandstones, each bed being 1 to 10 m thick. Mudstone rip-up clasts, water escape features, and gravel lags present (Cockings et al., 1992). Relatively thin, dark grey to black mudstones are interbedded with the sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the member is defined by a down-section change from sandstones to mudstones. It is marked by a sharp down-section increase in gamma-ray values and often a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 124 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by a down-section transition from mudstone (Heather Formation) to sandstone; a down-section decrease in gamma ray values; and often by an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HTHE ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LISA"@en ;
    skos:prefLabel "Ling Sandstone Member"@en ;
