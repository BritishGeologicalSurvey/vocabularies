namedrockunit:MOSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine-grained, silty, glauconitic, very dark grey. Bioturbated with moulds of mollusca."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed. Probably unconformable on granite, or crystalline basement. Basal unit usually a strongly weathered siltstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 12m. Not seen at one exposure."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, overlain by the Buchan Ridge Gravel Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CRKN ;
    skos:definition "Glauconitic sandstone with subsidiary siltstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hauterivian Age - to - Barremian Age (Cretaceous Period) (132.6-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MOSA"@en ;
    skos:prefLabel "Moreseat Sandstone Formation"@en ;
.

