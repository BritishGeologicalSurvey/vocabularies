    lexicon:hasLithologyDescription """[Obsolete: use BRL] \r
\r
Dark grey to black fine-grained limestones, fossiliferous, massive and thin-bedded, overlain by dolomitised fossiliferous limestone."""@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Black Rock Limestone where dark grey to black fine-grained limestone conformably rests upon banded dark fossiliferous limestone with the Lower Limestone Shales."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Not defined."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from dolomitised fossiliferous limestone of the Black Rock Dolomite to coarse bioclastic oolitic facies of the Gully Oolite of the Clifton Down Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BRL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Black Rock Limestone Subgroup"@en ;
    skos:definition "Obsolete name. Limestone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BPGP"@en ;
