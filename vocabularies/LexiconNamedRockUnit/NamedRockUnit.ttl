    skos:definition "Sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BACB"@en ;
    skos:prefLabel "Barncroft Beck Beds"@en ;
