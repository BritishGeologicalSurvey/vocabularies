    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 7m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Starston Till Member with overlying glaciofluvial outwash (un-named) is erosional. Hollows on the upper surface of the till are commonly infilled by a coarse gravel lag."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
