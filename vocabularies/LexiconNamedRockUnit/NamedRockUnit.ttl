namedrockunit:HUCK
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:HFCK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Rubbly to massive chalks with marl bands; typically pink to brick-red (due to disseminated haematite), but locally the upper part is grey due to secondary alteration of the iron minerals. The lower part of the formation is commonly weakly sandy. No formal subdivisions. The Hunstanton Formation as defined by Mitchell (1995), describing the thick succession at Speeton in the Cleveland Basin, is divided into five members. These are in ascending order the Queens Rocks Member, Speeton Beck Member, Dulcey Dock Member, Weather Castle Member and the Red Cliff Hole Member."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is a sharp or (apparently) gradational boundary with marly chalk of the formation overlying ferruginous sandstones of the Carstone Formation or (in the Cleveland Basin) mudstone of the Speeton Clay Formation; commonly marked by a line of phosphatic nodules as burrow-fills."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1606 ,
        namedrockunit:H330 ,
        namedrockunit:H331 ,
        namedrockunit:H3482 ,
        namedrockunit:H968 ,
        namedrockunit:RCK ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 1m at the type section in Norfolk, typically 3m in Lincolnshire and south Yorkshire, thinning over the Market Weighton High, but expanding to an estimated 30m in the Cleveland Basin with about 24m exposed in the cliffs at Speeton."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is an erosion surface, locally developed as a hardground, with hard red limestone overlain by nodular chalk (lowest Cenomanian) of the Paradoxica (or Sponge) Bed or (in the Cleveland Basin) Crowe's Shoot Member (Mitchell, 1995); this horizon (the base of the Lower Chalk in Norfolk, or elsewhere of the Ferriby Formation) may or may not correspond with the upper limit of red chalks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hunstanton Chalk Formation [Obsolete: use HUCK]"@en ,
        "Hunstanton Chalk Member [Obsolete: use HUCK]"@en ,
        "Hunstanton Formation and Ferriby Chalk Formation (Undifferentiated)"@en ,
        "Hunstanton Limestone [Obsolete: use HUCK]"@en ,
        "Hunstanton Red Chalk Formation [Obsolete: use HUCK]"@en ,
        "Hunstanton Red Rock [Obsolete: use HUCK]"@en ,
        "Red Chalk [Obsolete: use HUCK]"@en ;
    skos:definition "Chalk with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age - to - Cenomanian Age (Cretaceous Period) (113.2-93.9 Ma BP)."@en ;
