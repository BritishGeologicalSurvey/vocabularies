namedrockunit:CHRM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LIGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-grained, silty, commonly glauconitic and micaceous sand, interbedded with yellowish brown, often carbonaceous, colour-banded and laminated sand and silt. Palaeosols with or without rootlets are common."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp contact on uniform, bioturbated, shelly clays of the London Clay Formation. In King (in press) the basal boundary is amended down to the depth of 243.9m in the Christchurch Borehole [SZ 2002 9301]. King (in press) places the lower boundary at the base of a prominent rounded-pebble bed at a major basin-wide erosion surface and contends that the underlying very fine-grained glauconitic sand can be correlated with Unit B of the London Clay Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-75m. 53m in the Christchurch Borehole SZ29SW12 [SZ 2002 9301]."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, erosive contact with sands of the overlying Poole Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LC ;
    skos:definition "Sand with subsidiary gravel and silty clay and trace lignite. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHRM"@en ;
    skos:prefLabel "Christchurch Member"@en ;
.

