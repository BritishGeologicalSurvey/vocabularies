namedrockunit:CNAL1
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FPBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Aphyric basalt, basalt with sparse plagioclase phenocrysts and feldsparphyric basalts with small plagioclase crystals (<5 mm in length). The flows are generally less than 7 m thick and interbedded coarse fluviatile conglomerates are common. The highest flow on Sanday, at Creag Ard [NG 263 045] and either side of An Doirlinn [NG 266 049], contains plagioclase, olivine and possibly augite in glomeroporphyritic aggregates."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Emeleus (1997, fig. 40) notes a thickness of > 70 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Succeeded by the Tighard Member (CNAL2) on Canna."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CNAL ;
    skos:definition "Basalt and feldspar-phyric basalt with subsidiary conglomerate and trace basaltic tuff. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CNAL1"@en ;
    skos:prefLabel "Basal Member (Canna Lava Formation)"@en ;
.

