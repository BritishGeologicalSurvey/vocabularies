        namedrockunit:POB ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Cwrt-yr-ala Formation"@en ,
        "Pennard Conglomerate Formation"@en ,
        "Portishead Subgroup"@en ;
    skos:definition "Obsolete name. Calcareous mudstone, conglomerate and sandstone with subsidiary coarse silicate-sandstone and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "QCG"@en ;
    skos:prefLabel "Quartz Conglomerate Group (South Wales) [Obsolete: use CWA, PENN, POB]"@en ;
