namedrockunit:URB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly vesicular and non-vesicular basalts. At Groaning Tor adit, Via Gellia (SK 283 572) the Member is seen as a 1m-thick clay wayboard (Walters and Ineson, 1981)."@en ;
    lexicon:hasLowerBoundaryDefinition "The basalt lava (or clay derived from weathered lava) of the Upper Matlock Lava Member rests upon thickly bedded limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1898 ,
        namedrockunit:H1899 ,
        namedrockunit:H3746 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "36m thick in boreholes at Cawdor Quarry, Matlock (SK 285 605) (Smith et al., 1967)"@en ;
    lexicon:hasUpperBoundaryDefinition "The basalt lava (or clay derived from weathered lava) of the Upper Matlock Lava Member is overlain by thickly bedded limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
