namedrockunit:CNL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LIGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, off-white to pale brown fine- to medium-grained ooidal and coated peloidal grainstone, with common fine burrows, medium- to coarse-grained shell debris and flakes of greenish grey mudstone and dark lignite and minor amounts of fine-grained sand. Thick-bedded and cross-bedded or massive, weathering to flaggy or platy. Thin shell-detrital and ooidal marl and mudstone intercalations in places. Becoming very sandy eastward (\"Swerford Beds\" facies). Locally a mudstone bed (\"Roundhill Clay\" of Richardson, L, 1929) up to c.1m thick occurs at the base."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable/non-sequential on fine- to coarse-grained ooidal and peloidal limestone, locally ironshot, of Clypeus Grit Member. Oversteps northeastwards to rest non-conformably on Grantham Formation, Northampton Sand Formation and Whitby Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H151 ,
        namedrockunit:H800 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Rapid passage upwards into mudstone-dominated Fuller's Earth Formation or Sharp's Hill Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chipping Norton Formation [Obsolete: use CNL]"@en ,
        "Chipping Norton Limestone [Obsolete: use CNL]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Ooid-limestone with subsidiary calcareous mudstone and mudstone and trace lignite and sand. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CNL"@en ;
    skos:prefLabel "Chipping Norton Limestone Formation"@en ;
.

