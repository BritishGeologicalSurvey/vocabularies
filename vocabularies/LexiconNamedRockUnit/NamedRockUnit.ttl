    lexicon:hasThicknessDescription "30m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the base of mudstone-dominated succession overlying the Blackstone Edge Sandstone, below black fissile mudstone that includes a Reticuloceras reticulatum Marine Band."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasYoungestAgeValue 3.215e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ballbrook Sandstone Member [Obsolete: use BES]"@en ;
    skos:broader namedrockunit:MORRI ;
    skos:definition "Sandstone with subsidiary mudstone and trace ironstone. Stratified bedrock. Occurs onshore. Deposited during the Kinderscoutian Substage (Carboniferous Period) (322-321.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
