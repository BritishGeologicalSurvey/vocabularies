namedrockunit:CCAT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Cornubian Catchments Subgroup encompasses all the fluvial, lacustrine and organic deposits of the rivers of Devon and Cornwall from the River Axe westwards. Floodplain alluvium comprises soft silts and clays, commonly with beds of peat and a basal bed of sand and gravel. River terrace deposits are largely sand and gravel. The gravels include a wide range of Palaeozoic and Mesozoic rocks, reflecting the rock types cropping out in the various catchments. Peat is a minor component, and minor marine deposits are included where they are intercalated in dominantly fluvial formations."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock of Devonian to Cretaceous age."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 22.5m recorded in the buried sub-drift valley of the 7th terrace of the Taw Valley Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AXEV ,
        namedrockunit:EXEV ,
        namedrockunit:PETRO ,
        namedrockunit:TAVA ,
        namedrockunit:TAW ,
        namedrockunit:TORR ;
    skos:notation "CCAT"@en ;
    skos:prefLabel "Cornubian Catchments Subgroup"@en ;
.

namedrockunit:CDL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:DL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Splintery dark grey calcite and dolomite mudstones, pale grey oolitic, dark grey bioclastic and oncolitic limestones and some mudstones. Scattered cherts and silicified fossils in lower half. Sandy limestone at base in Bristol area. Deposited in a barrier/back barrier/shelf lagoon setting."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Bristol area taken at the sharp contact between the interbedded dolomite and calcite mudstones of the underlying Clifton Down Mudstone Formation and the basal sandy limestone of the Clifton Down Limestone Formation. The boundary needs further investigation. In Broadfield Down and the Mendip Hills it is taken at the incoming of calcite mudstones of the Clifton Down Limestone Formation above the oolitic and oolitic/bioclastic limestones of the Goblin Combe Oolite Formation and undivided Burrington Oolite Subgroup respectively."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H758 ,
        namedrockunit:LCDL ,
        namedrockunit:UCDL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "266 m in the Avon Gorge at Bristol, thinning northwards to 137 m north of Bristol and thinning southwards to 150-200 m in the Mendip Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the last calcite mudstones of the formation, above which occur the dark grey crinoidal and bioclastic limestones and paler oolitic limestones of the Oxwich Head Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cheddar Limestone Formation [Obsolete: use CDL, CDRL]"@en ,
        "Drybrook Limestone Formation [Obsolete: use HBO]"@en ,
        "Lower Clifton Down Limestone Formation [Obsolete: use CDL]"@en ,
        "Upper Clifton Down Limestone Formation [Obsolete: use CDL]"@en ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Limestone and trace chert, dolomitic limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Holkerian Substage (Carboniferous Period) (344.5-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CDRL ,
        namedrockunit:CDRO ;
    skos:notation "CDL"@en ;
    skos:prefLabel "Clifton Down Limestone Formation"@en ;
