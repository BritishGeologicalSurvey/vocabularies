    skos:definition "Mudstone with subsidiary sandstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage - to - Stephanian Stage (Carboniferous Period) (310-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PUB"@en ;
    skos:prefLabel "Publow Member"@en ;
