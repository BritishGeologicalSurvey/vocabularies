namedrockunit:STE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Can be divided informally into a lower unit of interbedded porcellanous limestones, argillaceous limestones, sandstones and mudstones c.25 metres thick and an upper unit of mostly porcellanous limestone with some flaggy dolomites c. 55 metres + thick. Overlying Coldbeck Limestone comprises dark grey, fine-grained limestones with interbedded mudstone and flaggy dolomite in which algal macrostructures are common. Underlying Shap Conglomerate comprises green/brown/red sandstones, siltstones mudstones and conglomerates."@en ;
    lexicon:hasLowerBoundaryDefinition "At depth of 49.73 metres in Wyegarth Gill No.1 Borehole (NY 7201 0355)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2454 ;
