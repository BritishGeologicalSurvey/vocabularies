namedrockunit:RNTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stony sandy clay diamicton, matrix-supported, dark yellowish brown, fissile, massive, extremely compact, containing angular to sub-rounded clasts of gneissose psammite and semipelite, pink and grey granite and some Devonian sandstone and siltstone.  Typical lodgement till with well developed north-easterly fabric and containing concavo-convex discontinuities that are commonly sand-filled."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a gradational contact over 10 to 20cm, but locally a sharp, planar contact and change in colour from dark yellowish brown to \"strong brown\" (Munsell Soil), with underlying stony sandy clay diamictons of the Cantray Till Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4302 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Erosional contact with gravel of the Carn Monadh Gravel Formation at the Allt Odhar Interstadial site, otherwise overlain by various younger deposits or boundary at the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Member of the Dalcharn Upper Till [Obsolete: use RNTI]"@en ;
    skos:broader namedrockunit:BUTI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RNTI"@en ;
    skos:prefLabel "Ruallan Till Member"@en ;
.

