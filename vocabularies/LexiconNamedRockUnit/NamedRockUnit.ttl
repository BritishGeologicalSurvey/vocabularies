namedrockunit:ETM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent
        namedrockunit:HD ,
        namedrockunit:KTB ,
        namedrockunit:RM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red, purple, brown, ochreous, green, grey and commonly mottled mudstone, with lenticular sandstones and conglomerates referred to as 'espleys'. Common pedogenic horizons, but coal seams are rare. Subordinate, lenticular sandstones and conglomerates commonly consist mostly of volcanic and lithic clasts. Intrusions of dolerite sills and dykes and extrusion of a small volume of volcaniclastic rocks are present in south Staffordshire and south Nottinghamshire."@en ;
    lexicon:hasLowerBoundaryDefinition "Passage by alternation from grey mudstones of the Pennine Coal Measures Group to red, purple mudstone of the Etruria Formation. Locally, in Shropshire, Warwickshire and Lincolnshire, the lower boundary is an unconformity (Symon Unconformity)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:AM ,
        namedrockunit:BFC ,
        namedrockunit:H1532 ,
        namedrockunit:H2791 ,
        namedrockunit:H2793 ,
        namedrockunit:H3392 ,
        namedrockunit:HD ,
        namedrockunit:KTB ,
        namedrockunit:RM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 300 m thick in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain conformably by predominantly grey sandstone and mudstone strata of the Halesowen Formation, although locally, in South Staffordshire the upper boundary is an unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ardwick Marl(s) [Obsolete: use ETM]"@en ,
        "Buckley Fireclay Formation [Obsolete: use ETM]"@en ,
