namedrockunit:NIT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold phase sands and gravels that underlie the Avon Third Terrace of Tomlinson (1925) and of BGS maps. Dominated by clasts of "Bunter" quartz/quartzite lihtologies with subordinate flint. Terrace surface some 15 m above modern Avon alluvial floodplain (e.g. at type locality) apparently decreasing to perhaps 10 m downstream. Locally includes organic Eckington Bed (or New Inn Fossil Bed) at base, which is assigned to MIS 5e. Correlation with members of Severn Valley Formation problematical. \r
\r
River terrace deposits. Late Pleistocene [MI Stage 5e to ?5b or ?4)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Lower Jurassic or Triassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1085 ,
        namedrockunit:H2956 ,
        namedrockunit:H3581 ,
        namedrockunit:H3582 ,
        namedrockunit:H4219 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 3 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Avon Third Terrace Deposits [Obsolete: use NIT]"@en ,
        "New Inn Member [Obsolete: use NIT]"@en ,
        "New Inn Terrace Deposits (Warwickshire Avon) [Obsolete: use NIT]"@en ,
        "No.3 Terrace Deposits [Obsolete: use NIT]"@en ,
        "Third Terrace Deposits [Obsolete: use WV, NIT]"@en ;
    skos:broader namedrockunit:AVON ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NIT"@en ;
    skos:prefLabel "New Inn Sand and Gravel Member"@en ;
.

namedrockunit:OKLY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded pale grey marls, silty, argillaceous micritic limestones, siltstones and silty to sandy mudstones, commonly containing scattered ferruginous ooids, and locally rich in Nanogyra nana and serpulids."@en ;
    lexicon:hasLowerBoundaryDefinition "A marked, and generally sharp, non-sequential, lithological change from sand or sandstone of the Beckley Sand or Arngrove Spiculite members of the Kingston Formation, or silty mudstones of the West Walton Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1526 ,
        namedrockunit:H1741 ,
        namedrockunit:H1742 ,
        namedrockunit:H1743 ,
        namedrockunit:H2352 ;
