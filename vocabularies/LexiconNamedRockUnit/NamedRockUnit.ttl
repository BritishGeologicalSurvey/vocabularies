        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Semipelite dominant with interbedded pelite, micaceous psammite and volcaniclastic rocks (Green Beds), and containing minor pebbly psammite. Metamorphosed to garnet-mica schist in type area."@en ;
    lexicon:hasLowerBoundaryDefinition "Change from silty limestone at top of Loch Tay Limestone to dominantly semipelitic and pelitic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2146 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
