    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLowerBoundaryDefinition "Slightly diachronous, locally interfingering with the underlying sandstone of the Dunblane Sandstone Member in the Stirling area, the Scone Formation in the Perth area, and the Tannadice Sandstone Member and Deep Conglomerate in the Laurencekirk area."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3342 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
