namedrockunit:PDS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Purple, red-brown and greenish-grey sandstones, commonly current bedded and generally fine to medium grained. Subordinate red and grey cleaved mudstones predominate at the base and top of the formation: fish fragments have been found towards the base of the formation where it is exposed on the coast; plant fragments have been found inland. Base of the formation is marked by a sporadic but persistent band of tuff (Bittadon Felsite), up to 8 m thick, the type locality of which is alongside the driveway to Hewish Barton [SS 5502 4086] which is massive, slighty foliated, fine- to-coarse grained with iron oxide spots and broken feldspar laths."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlie Morte Slates; the base of the formation is marked by a persistant keratophyric tuff band up to 8 m thick which is massive and strong where fresh, and forms a distinct topographic feature. The lower boundary is distinguished by a change from the grey cleaved mudstones of the Morte Slates to the massive, slightly foliated fine- to coarse-grained tuff."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:PWS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Approx. 1200 m."@en ;
    lexicon:hasUpperBoundaryDefinition "At Napps Cliff [SS 4460 4072] the contact is stratigraphic and gradational over approximately 9 m of strata; progressively higher sandstones become thinner and finer-grained and give way to predominant siltstones, silty slates and slates in the Upcott Beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pickwell Down Sandstones [Obsolete: use PDS]"@en ;
    skos:definition "Mudstone and sandstone with subsidiary tuff. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "PDS"@en ;
    skos:prefLabel "Pickwell Down Sandstones Formation"@en ;
.

namedrockunit:PDW
    a skos:Concept ;
