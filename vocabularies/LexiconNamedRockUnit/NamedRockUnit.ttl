namedrockunit:RDBRN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S827 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, reddish brown (2.5 YR 4/4), massive, matrix-supported sandy silty clayey diamicton. Quartzite and psammite clasts are dominant, but the presence of Devonian sandstone and Mesozoic siltstone and sandstone suggests ice movement from the north-west."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, uneven, unconformable contact with bedrock, locally a gradational unconformable contact with weathered Devonian conglomerate."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">1.5m."@en ;
    lexicon:hasUpperBoundaryDefinition "At the Red Burn site, the Red Burn Till is overlain unconformably by a unit of sandwith sporadic clasts that appears to correlate with the Deanshillock Gravel Formation at the base of the known sequence at Teindland Quarry. At the latter site, the Deanshillock Gravel is at least 3.5m thick, comprises coarse cobble gravel with clasts of quartzite and psammite, and passes upwards into up to 3m of very pale brown (10 YR7/4) sand, the Orbliston Sand Bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Red Burn Member"@en ;
    skos:broader namedrockunit:BCAG ;
    skos:definition "Clay with subsidiary gravel and trace sand. Stratified bedrock. Occurs onshore. Deposited during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RDBRN"@en ;
    skos:prefLabel "Red Burn Till Formation"@en ;
.

