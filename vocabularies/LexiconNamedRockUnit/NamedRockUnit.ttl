namedrockunit:MEST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Varied sequence of breccias, conglomerates, sandstones, siltstones and silty mudstones including veriegated yellow and purple \"loam\".  Spherical ferruginous (goethite) ooids are abundant in both the mudstones and the mudstone matrix of the breccias.  The formation records the accumulation of late Asbian terrestrial screes and alluvial deposits along the local margin of the Dinantian carbonate platform. The goethite ooids are the product of pedogenic processes."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Ordovician rocks (Nant Ffrancon Formation) and Precambrian rocks of the Monian Supergroup."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BED ,
        namedrockunit:H1063 ,
        namedrockunit:H1689 ,
        namedrockunit:H4790 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 43m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by thick-bedded limestones of the Loggerheads Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basement Beds Formation [Obsolete: use FANT, FRFA, LGY, MEST, PANT, PDW]"@en ,
        "Bridges Sandstone Formation [Obsolete: use MEST]"@en ,
        "Fanogle Sandstone [Obsolete: use MEST]"@en ,
        "Menei Straits Formation [Obsolete: use MEST]"@en ;
    skos:definition "Breccia, conglomerate, mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
