namedrockunit:EMLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAALK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Eaglesham Lava Member consists of mainly macro- to micro-porphyritic olivine, clinopyroxene and plagioclase or plagioclase alkali-basalt lavas but include ankaramites and feldspathic trachybasalts. One trachytic flow is known."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is apparently conformable on the Moyne Moor Lava Member that consists predominantly of trachybasalt, but might locally be unconformable."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4637 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 250m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the Dumdruff Hill Lava Member. The contact is considered conformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Eaglesham Lavas [Obsolete: use CBLA, EMLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Alkali basalt with subsidiary trachybasalt and trace trachyte. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EMLA"@en ;
    skos:prefLabel "Eaglesham Lava Member"@en ;
.

namedrockunit:EMLD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises very fine- to medium-grained, shelly, bioturbated sandstone and subordinate siltstone, often with a thin basal conglomerate. In many sections, the lower part of the formation is coarser and cleaner than the upper part, but in some sections log signatures indicate upward coarsening."@en ;
    lexicon:hasLowerBoundaryDefinition "The Emerald formation may overlie, lower Jurassic, Upper Palaeozoic, Lower Palaeozoic and Precambrian strata. In some sections (e.g. 2/10-8) the base can be placed between the basal conglomerate Lower Jurassic sandstones and this is shown on geophysical logs by a distinct downward increase in velocity. In other sections there is a down-section change from clean brownish sandstone (Emerald Formation) to red or varicoloured sandstones, siltstones or limestones of Devonian age, accompanied by a downward increase in gamma values and velocity. Where the formation rests on Lower Palaeozoic or Precambrian rocks, there is a downward change from clean sandstone to gneiss and a downward increase in gamma values and decrease in velocity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5100 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10-30 m (average c. 15 m)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is characterised by a downward change from grey mudstones and siltstones (Heather Formation) to sandstones (Emerald Formation). The boundary is marked by a down-section decrease in gamma values and increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Emerald Sandstone [Obsolete: use EMLD]"@en ;
    skos:broader namedrockunit:HMBG ;
    skos:definition "Sandstone with subsidiary conglomerate and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Bathonian Age - to - Oxfordian Age (Jurassic Period) (168.2-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EMLD"@en ;
    skos:prefLabel "Emerald Formation"@en ;
.

namedrockunit:ENDR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Mains of Kilmaronock Borehole (Browne and McMillan, 1989, Figure 6) contains the standard section in the Endrick Sand Member (5.99m to 13.6m in depth). The typical lithology is loose, fine- to medium-grained sand with some silt layers. The deposit is reddish brown and contains abundant plant remains and some dark organic clay bands. The sand usually appears to be flat-bedded but traces of cross-bedding are also present. Overall the deposit becomes coarser-grained upwards. The sediment at Mains of Kilmaronock might have been deposited by a meandering river in similar environments to those of the present Endrick. They could also be partly deltaic in origin."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional base with the underlying Kilmaronock Silt Member (Strathendrick Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4639 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to over 7.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp conformable contact with the overlying Erskine Clay Member (Clydebank Clay Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Endrick Formation [Obsolete: use ENDR]"@en ;
    skos:broader namedrockunit:SRCK ;
    skos:definition "Sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ENDR"@en ;
    skos:prefLabel "Endrick Sand Member"@en ;
.

