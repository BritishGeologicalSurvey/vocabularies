        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Heterogeneous association of red silicious mudstone locally with cherty bands, containing in places, slumped blocks of pillow lava. Also lava breccia, greenish grey mudstone, grey-green cherts."@en ;
    lexicon:hasLowerBoundaryDefinition "Lowest occurrence of slumped heterogenous association of the same or all the above lithologies."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "100m+"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper limit is the apparent occurrence of the same."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TAP ;
    skos:definition "Mudstone with subsidiary chert, lava and volcaniclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage - to - Caradoc Series (Ordovician Period) (468-449.75 Ma BP)."@en ;
