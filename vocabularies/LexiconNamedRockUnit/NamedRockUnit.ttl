namedrockunit:QHF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Green, purple-stained, bedded mudstones with thin subsidiary sandstone beds, conglomerate and mass-flow deposits with olistoliths."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the Auldthorns Formation. The boundary is taken at the change from the alternating sandstone (dominant) and silty mudstone succession of the Auldthorns Formation to the fossiliferous green purple-stained bedded mudstones with thin subsidiary sandstones of the Quarrel Hill Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2990 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasOldestAgeValue 4.4925e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "115m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Lady Burn Formation. The poorly defined boundary is taken at the change from fossiliferous green, purple-stained bedded mudstones with thin subsidiary sandstones of the Quarrel Hill Formation into the more massive, nodular pale grey unbedded silty mudstones of the Lady Burn Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasYoungestAgeValue 4.4875e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Quarrel Hill Flags [Obsolete: use QHF]"@en ;
    skos:broader namedrockunit:DKG ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cautleyan Stage (Ordovician Period) (449.25-448.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:GMD ;
    skos:notation "QHF"@en ;
    skos:prefLabel "Quarrel Hill Formation"@en ;
