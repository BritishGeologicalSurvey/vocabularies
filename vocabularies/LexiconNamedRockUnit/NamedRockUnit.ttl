namedrockunit:TAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises sandy limestone with ooid-rich mudstones. The limestones are thicker and more indurated in northern Lincolnshire, becoming thinner, softer and more argillaceous towards the south."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where blue-grey mudstones, glauconite-rich in some horizons and silty and ooid-rich in the lower part (\"Lower Tealby Clay\") are overlain by sandy limestones and ooid-rich mudstones (Tealby Limestone Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1217 ,
        namedrockunit:H3067 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasOldestAgeValue 1.265e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Generally up to c.4m, but estimated to be 6m at North Willingham [Owen and Thurrell, 1968]."@en ;
    lexicon:hasUpperBoundaryDefinition "In much of Lincolnshire, the base is taken where sandy limestones with ooid-rich mudstones (Tealby Limestone Member) are overlain by grey and buff mudstones, silt-rich in some horizons and locally glauconitic of the \"Upper Tealby Clay\". In the Brigg District, to the north of Normandy, sandy limestones (Tealby Limestone Member) are overlain by ferruginous limestone (Roach Formation). In the Audleby-Nettleton Top area, the Tealby Limestone Member is overlain by pebbly sandstone of the Carstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Greystone [Obsolete: use TAL, TBF]"@en ,
        "Tealby Limestone [Obsolete: use TAL]"@en ;
    skos:broader namedrockunit:TBF ;
    skos:definition "Calcareous mudstone, limestone and sandy limestone with subsidiary clay. Stratified bedrock. Occurs onshore. Deposited during the Barremian Age (Cretaceous Period) (126.5-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TAL"@en ;
    skos:prefLabel "Tealby Limestone Member"@en ;
.

namedrockunit:TARB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to brown, relatively massive fine- to medium-grained, locally calcite-cemented sandstone with subordinate, thin siltstones, mudstones and coals."@en ;
    lexicon:hasLowerBoundaryDefinition """Usually there is a sharp downward change from micaceous and/or bioturbated sandstone to a more thinly bedded, heterolithic sequence of sandstones, siltstones, mudstones and coal (Ness Formation) and a down-section change to erratic gamma-ray values.  Where sandstones of the Tarbert Formation are thin, it is difficult to differentiate that formation from the Ness formation, particularly where there are local facies variations as well.  There is usually a coarse-grained lag deposit at the boundary. \r
\r
In the north-eastern part of the East Shetland Basin, the Tarbert Formation rests on the Etive Formation without the intervening and distinctive argillaceous interval between, and the boundary is again difficult to locate."""@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5210 ,
        namedrockunit:H5211 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 75 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is marked by a downward change from grey siltstones with minor limestones (Heather Formation) to sandstones.  There is a corresponding down-section decrease in gamma-ray values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Tarbert Sub-Unit [Obsolete: use TARB]"@en ,
        "Upper Brent Sandstone Member [Obsolete: use TARB]"@en ;
    skos:broader namedrockunit:BRNT ;
    skos:definition "Sandstone with subsidiary coal, mudstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TARB"@en ;
    skos:prefLabel "Tarbert Formation"@en ;
.

namedrockunit:TARF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent
        namedrockunit:ARDR ,
        namedrockunit:MNSP ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded semipelite and micaceous psammite, contains distinctive garnets with snowball and spiral inclusion patterns in semipelites near shear zones. Quartzite and pelite interbeds, notably in basal part."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable transition from underlying Glen Doe Psammite to semipelite/micaceous psammite-dominated sequence. Locally marked by appearance of impersistent quartzite beds and striped psammites."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Minimum 2.7km up to c. 3km."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen - faulted and sheared with Glen Buck Pebbly Psammite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ardair Semipelite Formation"@en ,
        "Monadhliath Semipelite Formation"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Micaceous psammite and semipelite with subsidiary pelite and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TARF"@en ;
    skos:prefLabel "Tarff Banded Formation"@en ;
.

namedrockunit:TAS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Main formation: red, coarse pebbly sandstone, thick bedded, abundant cross bedding and with soft-sediment deformation structures. Thinner beds of mudstone and thin-bedded mudstone-sandstone alternations. Sandstone with mafic fragments and accretionary lapilli (Stac Fada Member) and mudstone (Poll' a Mhuilt Member) at top of formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the Clachtoll Formation (TAT). The contact is defined as an erosion surface where pebbly red sandstones of the Bay of Stoer Formation overlie muddy red sandstone of the Clachtoll Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasOldestAgeValue 1.2e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At Stoer: 240 m maximum, of which top 100 m is Pollt a' Mhuilt Member. Near Loch Maree, c. 1000 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Meall Dearg Formation (TAD), marked by the incoming of red sandstone overlying the mudstones of the Pollt a Mhuilt Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasYoungestAgeValue 1e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TA ;
    skos:definition "Sandstone with subsidiary mudstone and trace pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Stenian Period (Precambrian) (1200-1000 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:TASF ,
        namedrockunit:TASP ;
    skos:notation "TAS"@en ;
    skos:prefLabel "Bay of Stoer Formation"@en ;
.

