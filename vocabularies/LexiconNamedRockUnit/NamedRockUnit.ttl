    lexicon:hasThicknessDescription "Up to at least 13 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "An upward transition from fine-grained silty sands and clayey silts to coarser grained, calcareous possibly spiculitic sand or sandstone of the Beckley Sand Member, Arngrove Spiculite Member, or very locally, mudstone and limestone of the Littlemore Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Calcareous Grit [Obsolete: use HYB, KTON, TECY, BYSA]"@en ,
        "Lower Corallian [Obsolete: use TECY, BYSA, KTON]"@en ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Sand, sandstone, silt and siltstone with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TECY"@en ;
    skos:prefLabel "Temple Cowley Member"@en ;
.

namedrockunit:TEG
    a skos:Concept ;
