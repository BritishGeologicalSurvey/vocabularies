namedrockunit:NCRC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Composite: Norwich Crag Formation: mainly reddish to yellow (oxidised) sand above watertable, green where saturated. Glauconitic, fine- to coarse-grained, micaceous, locally shelly. Includes gravels and clay layers particularly towards top of sequence. Commonly decalcified. Basal stone bed composed of flint, overlain by shelly sand; cross-bedded, overlain by sand and green-brown clay; flasar-bedded, overlain by quartz-quartzite gravel (outwash suite). Red Crag Formation: shelly sand, silt and clay. [Generic description]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NP> ;
    lexicon:hasOldestAgeValue 5.33e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CRAG ;
    skos:definition "Calcareous sandstone, sand and sandstone with subsidiary gravel and trace silty clay. Bedrock. Occurs onshore. Formed during the Pliocene Epoch (Neogene Period) - to - Pleistocene Epoch (Quaternary Period) (5.33-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NCRC"@en ;
    skos:prefLabel "Norwich Crag Formation And Red Crag Formation (Undifferentiated)"@en ;
.

