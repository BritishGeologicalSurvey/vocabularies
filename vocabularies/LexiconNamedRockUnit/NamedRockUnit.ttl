namedrockunit:BHSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium-grained yellow to grey sandstone as a single unit. In Compton Bay the member comprises three coarsening-upward sandstones separated by laminated mudstones. Topmost bed usually comprises a thin mudstone and bivalve conglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable and marked by an abrupt or gradational change from grey mudstone and fine-grained sandstone of the Cowleaze Chine Member of the Vectis Formation up into to medium-grained yellow sandstone of this formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1986 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasOldestAgeValue 1.265e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "2.5 to 7m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable at a sharp but irregular contact between medium-grained sandstone (or mudstone/bivalve conglomerate) of the formation and the overlying rhythmically-bedded fine-grained sandstones, siltstones and mudstones of the Shepherd's Chine Member of the Vectis Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sandstone of Cowleaze Down and Barnes High [Obsolete: use BHSA]"@en ;
    skos:broader namedrockunit:VTIS ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Barremian Age (Cretaceous Period) (126.5-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHSA"@en ;
    skos:prefLabel "Barnes High Sandstone Member"@en ;
.

namedrockunit:BHVF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massively-bedded and unbedded acid tuffs rich in embayed quartz xenocrysts. Locally, welding fabrics are preserved. Also includes agglomeratic tuffs, sandstones and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Marked by the rapid transition from bioturbated fine-grained sandstones (Basement Beds of Jones, 1933 op.cit) to massive tuffs."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4464 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Very variable - complicated by intrusion of dolerite sills. 40m - 420m."@en ;
    lexicon:hasUpperBoundaryDefinition "Marked by the rapid transition from massive tuffs to mudstones, conglomerates and siltstones of the Bifidus Slate Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasYoungestAgeValue 4.6125e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Beacon Hill Volcanic Group [Obsolete: use BHVF]"@en ;
    skos:broader namedrockunit:AVG ;
    skos:definition "Mudstone, sandstone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series - to - Abereiddian Stage (Ordovician Period) (477.1-461.25 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHVF"@en ;
    skos:prefLabel "Beacon Hill Volcanic Formation"@en ;
.

namedrockunit:BIAD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MIMDST"^^xsd:anyURI ,
