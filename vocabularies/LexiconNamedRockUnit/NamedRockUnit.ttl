    lexicon:hasThicknessDescription "30 to 195m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the anoxic hemipelagic mudstones of the Cwmere Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
