namedrockunit:SLAV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Slackgun Volcaniclastic Member consists predominantly of bedded tuff and/or volcaniclastic sedimentary rock, with weathered basalt lava (including 'bole') and a local olivine-microphyric basalt lava."@en ;
    lexicon:hasLowerBoundaryDefinition "The Slackgun Volcaniclastic Member unconformably overlies the Skiddaw Lava Member. The lithological change is from transitional plagioclase-macrophyric to plagioclase-microphyric basalt lava or composite basalt lava to a dull red 'bole' reflecting prolonged weathering of the underlying lavas."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3682 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 80 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Slackgun Volcaniclastic member is overlain, conformably or disconformably, by the Spout of Ballochleam Lava Member. The lithological change is from tuff or volcaniclastic sedimentary rock to plagioclase-microphyric basalt lava (of 'Jedburgh' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Slackgun Interbasaltic Beds [Obsolete: use SLAV]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Tuff, volcaniclastic-mudstone and volcaniclastic-sandstone with subsidiary basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLAV"@en ;
    skos:prefLabel "Slackgun Volcaniclastic Member"@en ;
.

namedrockunit:SLED
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGNA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCTO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QDI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TO"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "An association of coarse-grained igneous rocks, mainly quartz diorites, occurring as a complex of circular to elongate, roughly overlapping intrusive bodies."@en ;
    lexicon:hasLowerBoundaryDefinition "Where not in mutual contact, the intrusions are believed to have been emplaced into mudrocks of Cambrian to Ordovician (possibly Tremadoc) age, correlatives of the Stockingford Shale Group."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1826 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasThicknessDescription "Vertical thickness unknown; boreholes show the complex is approximately 16 km in diameter."@en ;
    lexicon:hasUpperBoundaryDefinition "Where not roofed by their host rocks, the intrusions are unconformably overlain by Triassic strata or Quarternary superficial deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Syenites [Obsolete: use SLED]"@en ;
    skos:broader namedrockunit:CIGSS ;
    skos:definition "Quartz-diorite and tonalite with subsidiary diorite and microtonalite and trace aplitic microgranite and pegmatite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLED"@en ;
    skos:prefLabel "South Leicestershire Diorite Complex"@en ;
.

