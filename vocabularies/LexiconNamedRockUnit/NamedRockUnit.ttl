    skos:narrower namedrockunit:ARBI ;
    skos:notation "MFT"@en ;
    skos:prefLabel "Mill of Forest Till Formation"@en ;
.

namedrockunit:MGLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAROCM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly plagioclase-macrophyric basalts (Markle type). Near Devil's Craig Dam [NS 560 782] a few lavas have abundant feldspar phenocrysts of about 5 mm and some up to 2 cm in length. Near Craigend Castle [NS 548 777] a thin olivine-clinopyroxene-macrophyric basalt (Craiglockhart type) occurs and in the western part of the Kilpatrick Hills, mugearite lavas are present."@en ;
    lexicon:hasLowerBoundaryDefinition "The Mugdock Lava Member overlies the more-mafic olivine-microphyric basalts (Dalmeny type), olivine-clinopyroxene-plagioclase-macrophyric basalts (Dunsapie type) and olivine-clinopyroxene-macrophyric basalts (Craiglockhart type) of the underlying Cochno Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1693 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100-200 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Mugdock Lava Member is overlain by the olivine-microphyric basalts (Dalmeny type) of the Tambowie Lava Member in the south of the Kilpatrick Hills. To the north, the Tambowie Lava Member is absent and the Mugdock Lava Member is directly overlain by the sedimentary rocks of the Lawmuir Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mugdock Lavas [Obsolete: use MGLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Plagioclase-macrophyric basalt with subsidiary mugearite and olivine-clinopyroxene-macrophyric basaltic-rock. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MGLA"@en ;
    skos:prefLabel "Mugdock Lava Member"@en ;
.

