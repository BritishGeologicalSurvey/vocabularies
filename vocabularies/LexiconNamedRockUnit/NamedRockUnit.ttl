namedrockunit:KNRN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, with interbedded subordinate claystone and siltstone at the top. Limestones very from wackestone to fine-grained packstone; they are often nodular in form and argillaceous. Thin beds of black fissile claystone are also present. Zoophycos burrows and siltstone are common near the base of the formation. The formation contains the large caninoid coral Siphonphyllia benburbensis and the brachipod Megachonetes papilionensis."@en ;
    lexicon:hasLowerBoundaryDefinition "The formation overlies the Skillicore Member of the Derbyhaven Formation. The basal boundary is taken as immediately above a byozoan bed which is exposed to the north-east of the airport light gantry at Ronaldsway, at Port St Mary and Ballasalla (Dickson et al.1987). No grid references are quoted in the Dickson et al.(1987) paper for these localities so the boundary can be regarded as not well defined."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1630 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.21m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is poorly defined. The Knockrushen Formation is overlain by the Hodderense Limestone Formation.This boundary is marked by a change from the wackestones and packstones of the Knockrushen Formation to massive lime mudstones of the Hodderense Limestone Formation. Dickson et al. (1987) describe the base as occurring close to the Visitor Centre at Scarlett south of the old lime kilns [SC 2580 6620], where the base of the Hodderense Limestone Formation 'is taken at the lowest mottled horizon'. This mottling is a result of the presence of blue or grey micrite nodules up to 3cm in size."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Castletown Formation-Knockrushen Member [Obsolete: use KNRN]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary mudstone and silicate-claystone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage (Carboniferous Period) (343-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNRN"@en ;
    skos:prefLabel "Knockrushen Formation"@en ;
.

namedrockunit:KNS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown sandstone, mostly well cemented, with common breccia beds and lenses, commonly cross-bedded. Contains interbedded lamprophyre and basalt lavas."@en ;
    lexicon:hasLowerBoundaryDefinition "On northern side of the Crediton Trough, Bow Breccia with passes up into Knowle Sandstone by gradual increase in the proportion of sandstone; thus the boundary is somewhat arbitrary. Around Posbury and in the Dunchideock area (southwest of Exeter), rests directly on Crackington Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1003 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "120-150m at eastern edge of Okehampton district, to 100m in Crediton area, 18m at Bow."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by Creedy Park Sandstone along north side of Crediton Trough. At Posbury and Dunchideock, overlain by basalt, in turn overlain by Crediton or Alphington Breccia."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Knowle Sandstones [Obsolete: use KNS]"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Breccia and sandstone with subsidiary basalt. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNS"@en ;
    skos:prefLabel "Knowle Sandstone Formation"@en ;
.

namedrockunit:KNSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand, very fine- to medium-grained with silt and clay laminae, grey and brownish grey, finely micaceous, with some shells and comminuted shell debris and dark sulphidic patches. The sediments contain a marine microfauna of temporate estuarine type. Locally, the unit has a gravelly base and clasts to 20 cm of schist and quartzite."@en ;
    lexicon:hasLowerBoundaryDefinition "Gravelly erosive base locally unconformable, assumed to be deeply channelised into the Errol Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1631 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "20 m known at Kingston; up to 14.9 m at Barry Buddon."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary (unconformable?) with transgressing Carse of Gowrie Clay Member but may pass laterally into the Carey Silt Member (Carse Clay Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Buddon Sands [Obsolete: use KNSA]"@en ;
    skos:broader namedrockunit:CARCL ;
    skos:definition "Sand with subsidiary silt and trace clay and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNSA"@en ;
    skos:prefLabel "Kingston Sand Member"@en ;
.

namedrockunit:KNSF
