namedrockunit:CTLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Craigentimpin Lava Member consists of plagioclase-macrophyric basalt to trachybasalt (hawaiite) (of 'Markle' type) with particularly large platy phenocrysts of calcic labradorite. The maximum thickness of the member, about 30 m, is developed in the Sloughmuclock area [NS 627 795], where two lavas are present. Elsewhere, it generally consists of only one lava that thins out entirely farther west.The orientation of the feldspar phenocrysts suggests that the source of the lava was the Waterhead Centre ('Waterhead Central Volcanic Complex') (Whyte and MacDonald, 1974)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is conformable or disconformable on the underlying plagioclase-microphyric trachybasalt lava of lower north Campsie lavas (Campsie Lava Member) in the north of its outcrop, and by plagioclase-microphyric trachybasalt lavas of the lower north and south Campsie lavas (Campsie Lava Member) in the south of its outcrop."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2130 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 30 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Craigentimpin Lava Member is overlain with apparent conformity by the upper north and upper south Campsie lavas (Campsie Lava Member). The lithological change is to mostly plagioclase-microphyric basalt to trachybasalt (hawaiite) lavas (of 'Jedburgh' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Craigentimpin Lavas [Obsolete: use CTLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and hawaiite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CTLA"@en ;
    skos:prefLabel "Craigentimpin Lava Member"@en ;
.

