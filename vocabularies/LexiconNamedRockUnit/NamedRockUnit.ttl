namedrockunit:STBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of two to four limestone beds separated by mudstone. Uppermost bed is typically brown and grey mottled, highly bioturbated, shelly, bioclastic, ferru-ooidal, packstone with numerous bored Gryphaea, weathering to orange brown, and 0.61 m thick in the type section. Below are one to three thinner, non-ooidal argillaceous limestone beds. Rich fauna including forams, serpulids, corals, brachiopods, gastropods and ammonites. Forms a strong scarp feature with a dip slope."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from bluish grey, shaly mudstone with numerous phosphatic nodules of uppermost 1m of the undifferentiated Beckingham Member; at 34.65 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2452 ,
        namedrockunit:H361 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1.0 to 2.4 m; 1.14 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey, mudstone of the undifferentiated Foston Member; at 33.51 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Plungar Ironstone [Obsolete: use LGFL, STBL]"@en ,
        "Stubton Limestone [Obsolete: use STBL]"@en ;
    skos:broader namedrockunit:FSTL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STBL"@en ;
    skos:prefLabel "Stubton Limestones Bed"@en ;
.

namedrockunit:STCF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, red-brown and grey-green mottled, and sandstone, coarse-grained, sporadically pebbly, brown or grey-green. Sandstone occurs within convoluted soft sediment injection structures and sandstone dykes."@en ;
    lexicon:hasLowerBoundaryDefinition "Slightly unconformable, at the abrupt transition from sandstone of the underlying Sherwood Sandstone Group to deformed mudstone and sandstone of the Seaton Carew Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1841 ,
        namedrockunit:H545 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
