    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.250 to 300m on coast section; not measurable inland."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp change from tremolitic flags to interbedded graphitic pelite, semipelite and metalimestone of Mortlach Graphitic Schist Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
