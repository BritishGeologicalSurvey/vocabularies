    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10m"@en ;
    lexicon:hasUpperBoundaryDefinition "At land surface or overlain unconformably by glaciofluvial/glaciolacustrine or Flandrian sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Main Late Devensian Till of the Vale of Eden [Obsolete: use GYTI]"@en ;
    skos:broader namedrockunit:CCGL ;
    skos:definition "Diamicton with subsidiary gravel and sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:EDTI ;
    skos:notation "GYTI"@en ;
    skos:prefLabel "Greystoke Till Formation"@en ;
