    skos:definition "Diamicton with subsidiary gravel and sand and trace clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:THGTI ;
    skos:notation "CCAG"@en ;
    skos:prefLabel "Central Cumbria (Albion) Glacigenic Subgroup"@en ;
