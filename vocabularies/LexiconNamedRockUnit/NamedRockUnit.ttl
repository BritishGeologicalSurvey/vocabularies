namedrockunit:SHN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly a sandy sequence with pebbles and shell fragments. Some clayey partings but generally a well-sorted fine-grained to silty sand. Similar in lithology to base of Mariner Formation above it, but base of unit rests on a variety of lithologies, especially in the west of the area where it onlaps to, or offlaps from, a variety of older strata. "@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Pliocene and older strata of varied lithology and competence."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS062> ;
    lexicon:hasOldestAgeValue 1.8e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40 metres approximately at Borehole 80/1, 90 metres approximately at Borehole 81/18. Thickens to north, east and northwest on North Sea Plateau. May be absent in parts of the Norwegian Trench where it has been eroded away."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable/disconformable or apparently conformable with the sandy material of the overlying Mariner Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS013> ;
    lexicon:hasYoungestAgeValue 5e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ZULU ;
    skos:definition "Sand with subsidiary clay and shelly sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 62 - to - Marine Isotope Stage 13 (Quaternary Period) (1.8-.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHN"@en ;
    skos:prefLabel "Shackleton Formation"@en ;
.

