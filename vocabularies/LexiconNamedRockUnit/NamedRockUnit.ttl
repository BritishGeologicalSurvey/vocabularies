namedrockunit:THGTI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Extremely compact, silty sandy gravelly diamicton containing clasts mainly of slate. \"Borrowdale Volcanic Group\" lithologies and Threlkeld microgranite. Dark grey at base becoming increasingly weathered upwards to yellowish brown with olive brown, orange and white mottling where it has been cryoturbated. Most clasts are decomposed towards top and are commonly bleached. The deeply weathered zone of the unit is named formally as the Troutbeck Palaeosol."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally an uneven, unconformable boundary with slate bedrock, but locally a thin unit of weathered sand and gravel intervenes. Bedrock commonly decomposed."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2482 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 15m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp, planar, or gradational glacitectonic boundary with greyish brown stony clay diamicton (Threlkeld Till Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Thornsgill Formation [Obsolete: use THGTI]"@en ;
    skos:broader namedrockunit:CCAG ;
    skos:definition "Gravel with subsidiary sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THGTI"@en ;
    skos:prefLabel "Thornsgill Till Formation"@en ;
.

namedrockunit:THHB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone and pebbly sandstone, greyish-brown. Fine- to medium-grained, moderately- to poorly-sorted. Laterally impersistent. Very well cemented in comparison to sandstone units immediately above (Thurstaston Sandstone Member) and below (Wilmslow Sandstone Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of a maximum 3m thick pebbly sandstone bed (the Thurstaston Hard Sandstone Bed), overlying pebble-free reddish-orange sandstone (Wilmslow Sandstone Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3081 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 to 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of a maximum 3m thick pebbly sandstone bed (the Thurstaston Hard Sandstone Bed), underlying pebble-free reddish-orange sandstone (Thurstaston Sandstone Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Thin inconsistent bed of hard sandstone [Obsolete: use THHB]"@en ;
    skos:broader namedrockunit:THUN ;
    skos:definition "Pebbly (gravelly) sandstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THHB"@en ;
    skos:prefLabel "Thurstaston Hard Sandstone Bed"@en ;
