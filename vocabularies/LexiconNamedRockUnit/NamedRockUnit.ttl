namedrockunit:OF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FTUFF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thick- to thin-bedded, locally welded, felsic ash-flow tuffs, subordinate rhyolitic lavas and dark grey mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the siltstones and sandstones of the Allt Lwyd Formation or the conglomerates of its highest subdivision, the Aran Boulder Bed Member in the Harlech area and western part of the Cadair Idris district, but is disconformable on the Dol-cyn-afon, Dolgellau and Ffestiniog Flags formations in the south and east."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1064 ,
        namedrockunit:H1101 ,
        namedrockunit:H3593 ,
        namedrockunit:H432 ,
        namedrockunit:H4822 ,
        namedrockunit:H4823 ,
        namedrockunit:LAV ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 290 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Cregennen Formation (locally the Bryn Brith Member) over much of the Cadair Idris district, but unconformably overlain by the Ty'r Gawen Mudstone Formation (Fron Newydd Member) in the southwest. In the Harlech district it is variably overlain by the Cregennen, Melau and Benglog formations, with possible unconformity/disconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OE> ;
    lexicon:hasYoungestAgeValue 4.582e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Beacon Hill Acid Group [Obsolete: use OF]"@en ,
        "Lower Acid Group [Obsolete: use OF]"@en ,
        "Lower Acid Volcanic Group [Obsolete: use OF]"@en ,
        "Mynydd Gader Volcanic Series [Obsolete: use OF]"@en ,
        "Mynydd-Y-Gader Group [Obsolete: use OF]"@en ,
        "Rhyolitic Series and Ashy Series [Obsolete: use OF]"@en ,
        "Upper Volcanic Series [Obsolete: use OF]"@en ;
    skos:broader namedrockunit:AVG ;
