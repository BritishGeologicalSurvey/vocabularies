namedrockunit:PLCM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:PSLCM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SISTCC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded grey mudstone, siltstone and pale grey sandstone, commonly with mudstones containing marine fossils in the lower part, and more numerous and thicker coal seams in the upper part."@en ;
    lexicon:hasLowerBoundaryDefinition "At the base of the dark grey, fissile mudstone of the Subcrenatum Marine Band with eponymous fossils, or at the base of the lowest coal of the coal-bearing sequence if this marker cannot be recognised. Typically, the formation rests conformably upon the Rossendale Formation (Millstone Grit Group). However, in north, west and east Cumbria, the Solway Basin (except the Canonbie area), the Stainmore and Northumberland troughs, on the Alston Block and in northeast Northumberland, the formation overlies conformably the repetitive mudstones, siltstones, sandstones, thin limestones and thin coals of the Stainmore Formation (Yoredale Group). In the Canonbie Coalfield, the formation is underlain unconformably by the Alston Formation (Yoredale Group)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GRM ,
        namedrockunit:H1759 ,
        namedrockunit:LCM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 650 m thick in the North Staffordshire (Potteries) Coalfield, and 720 m thick in Lancashire."@en ;
    lexicon:hasUpperBoundaryDefinition "At the base of the mudstone of the Vanderbeckei Marine Band with eponymous fossils."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
