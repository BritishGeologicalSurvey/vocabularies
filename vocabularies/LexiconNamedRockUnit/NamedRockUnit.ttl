    lexicon:hasLithologyDescription "Limestone, grey, buff, nodular, interbedded with green-grey, calcareous mudstone; sporadic beds of bioclastic limestone and sparse bentonitic tuffs; sparse limestone bioherms (reefs)."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational passage taken at the base of the first predominantly calcareous mudstone and nodular limestone overlying the bedded, limestone-dominated Lower Quarried Limestone Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4222 ,
        namedrockunit:NOB ;
