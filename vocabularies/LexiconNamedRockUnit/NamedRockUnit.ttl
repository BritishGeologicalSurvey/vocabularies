        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, reddish brown, with abundant halite veins and nodules, and common mudstone breccias."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at the gradational upward transition from laminated reddish brown and greenish grey mudstones (Sidmouth Mudstone Formation, undifferentiated) to the halite-rich, reddish-brown mudstones of the Rossall Halite Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1147 ,
        namedrockunit:H1148 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 12 m (Wilson and Evans, 1990)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the gradational upward transition from the halite-rich mudstones of the Rossall Halite Member to structureless reddish brown mudstones (Sidmouth Mudstone Formation, undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
