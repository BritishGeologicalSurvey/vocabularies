namedrockunit:CASSG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/M"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold-phase sand and gravels that underlie the Castle or First Terrace of the River Bain. Dominated by clasts of flint and chalk (though decalcified near ground surface) and a smaller proportion of Upper Jurassic and Lower Cretaceous lithologies plus minor exotics, notably ?Carboniferous sandstone and 'Bunter' pebbles (mostly derived from Anglian tills). Forms well-developed terrace surface typically about 1 m above modern alluvial floodplain; the deposits extend beneath the latter and are incised into the adjacent Thorpe Terrace. Sections show syndepositional ice wedge casts but no epigenetic casts or cryogenic involutions. Locally includes cold-phase organic silts and peats, but channel-filling organic silts at the base (Tattershall Bed) yield a temperate flora and fauna assigned to MIS 5e. Correlates and merges with the following members of the Trent Valley Formation, Kirkstead Sand and Gravel Member (of the Proto-Trent) and broadly correlates with the combined Beeston and Holme Pierrepont Sand and Gravel Member, and Fulbeck and Scarle Sand and Gravel members (of the Proto-Trent). \r
\r
Middle to Upper Pleistocene (MI Stage 5e to 2)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Anglian Wragby Till or (locally) gravels of the Thorpe Sand and Gravel Member in the type area, and possibly locally on Upper Jurassic mudstone bedrock, if present, elsewhere."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H110 ,
        namedrockunit:H2053 ,
        namedrockunit:H3275 ,
        namedrockunit:H3902 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 8 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or against alluvium."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Castle Member [Obsolete: use CASSG]"@en ,
        "Lower River Terrace Deposits [Obsolete: use CASSG]"@en ,
        "Southrey Terrace Deposits [Obsolete: use THSG, CASSG, SOYSG]"@en ,
        "Tattershall-Kirkby Terrace Deposits [Obsolete: use THSG, CASSG]"@en ;
    skos:broader namedrockunit:BAINV ;
    skos:definition "Gravel and sand with subsidiary mud and peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Late Pleistocene (Quaternary Period) (.78-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CASSG"@en ;
    skos:prefLabel "Castle Sand and Gravel Member"@en ;
.

namedrockunit:CAYC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:CBCA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PHNOD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SIMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, soft clay and mudstone, laminated in part, becoming silty at the top and passing up gradationally into the Osgodby Formation (Redcliff Rock Member). The clay contains numerous small grey phosphatic nodules which may enclose the shrimp Meyeria or the ammonite Macrocephalites spp. and bivalves Meleagrinella aff. braamburiensis, Modiolus bipartus, and Nuculana sp."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp, conformable boundary between bioclastic, berthierine (chamosite) ooid-rich, sandy limestone of the underlying  Cornbrash Formation and the dark grey, silty mudstone (locally shelly) of the Cayton Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3277 ,
        namedrockunit:H3278 ,
        namedrockunit:H752 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 3m (Wright 1968a; 1977); locally absent in the west of the Cleveland Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable boundary where the soft, grey mudstone of the Cayton Clay Formation passes gradationally up to the pale yellow, clayey sandstone of the overlying Osgodby Formation (Redcliff Rock Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clays-of-the-Cornbrash [Obsolete: use CAYC]"@en ,
        "Cornbrash Formation and Cayton Clay Formation (Undifferentiated)"@en ,
        "Shales-of-the-Cornbrash Member [Obsolete: use CAYC]"@en ,
        "Shales-of-the-Cornbrash [Obsolete: use CAYC]"@en ;
    skos:definition "Calcareous mudstone with subsidiary nodular phosphorite and trace calcareous siltstone and silicate-mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "CAYC"@en ;
    skos:prefLabel "Cayton Clay Formation"@en ;
.

namedrockunit:CBCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Clydebank Clay Formation comprises mainly clay and silt, with subsidiart sand and gravel deposits, forming four members (q.v.): from oldest to youngest these are the Buchanan Clay, Longhaugh Sand and Gravel, Erskine Clay and Gourock Sand members. More detail of the lithologies of the individual members is included in the related Lexicon entries."@en ;
    lexicon:hasLowerBoundaryDefinition "The Clydebank Clay Formation rests with angular unconformity on older Quaternary sediments or bedrock. It most commonly rests on the Wilderness Till Formation (WITI) of the Caledonia Glecigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Ranges from a veneer to more than 15m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Clydebank Clay Formation is overlain unconformably by younger Quaternary sediments, normally either the Clippens Peat Formation or Clyde Valley Formation of the Clyde Catchment Subgroup (Britannia Catchments Group). It is also extensively exposed at surface in the lower Clyde valley."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay and silt with subsidiary gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BCHN ,
        namedrockunit:ERSK ,
        namedrockunit:GOSA ,
        namedrockunit:LUGH ;
    skos:notation "CBCL"@en ;
    skos:prefLabel "Clydebank Clay Formation"@en ;
.

