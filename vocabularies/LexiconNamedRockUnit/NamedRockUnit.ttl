namedrockunit:DUCS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstones with mostly thin interbedded siltstones - a delta slope facies. Sandstone, grey, weathering orange-brown, fine- to medium-grained, micaceous, thin- to thick-bedded in packets up to c.25m thick. Siltstone, grey micaceous bed c.15m thick in the middle of the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional from grey, micaceous, sandy siltstones with few thin sandstones (commonly less than 0.1m) of the Roeburndale Member (undifferentiated to the sandstone-dominated Dure Clough Sandstones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H876 ,
        namedrockunit:PAW ,
        namedrockunit:S571 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
