    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glacial sand and gravel [Obsolete]"@en ;
    skos:broader namedrockunit:SBRY ;
    skos:definition "Gravel with subsidiary clay, peat, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Cromerian Stage - to - Anglian Stage (Quaternary Period) (.86-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WOGR"@en ;
    skos:prefLabel "Woodford Gravel Member"@en ;
