namedrockunit:CANS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCASST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand, fine-grained, glauconitic, micaceous with fine lenses or bioturbated laminae of micaceous, very fine-grained sand and silt."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by the sharp contact at the incoming of fine-grained glauconitic sand above the dark grey sandy clay of the Gault Formation. Base commonly marked by a spring line."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2048 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "16 to 30m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is not commonly observed and is probably gradational with an upwards decrease in silt- and clay-grade material and mica up into fine- to medium-grained glauconitic partially cemented sands. In field surveying terms the boundary is a well-marked feature break, presumably coinciding with incoming of cemented sandstone in the overlying Shaftesbury Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glauconitic and micaceous sands of the zone of Mortoniceras inflatum [Obsolete: use CANS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Glauconitic sandstone, micaceous sandstone, sand and sandstone with subsidiary silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CANS"@en ;
    skos:prefLabel "Cann Sand Member"@en ;
.

