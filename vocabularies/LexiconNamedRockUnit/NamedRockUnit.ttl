namedrockunit:RGST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly red and some grey mudstones with calcareous beds (rogenstein), generally less than 1 m thick, which contain abundant ferruginous ooliths; thin beds of fine sandstone, siltstone and dolomite occur, and traces of anhydrite may be present. The member typically displays gamma-ray and velocity log signatures similar to those shown by the underlying Bunter Shale Formation mudstones but differentiated by the presence of low gamma-ray and high velocity peaks generated by the oolitic beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Rogenstein Member is placed at the base of the lowest occurrence of ooliths and of the associated low gamma-ray and high velocity peaks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Thicknesses range from about 100 m to more than 210 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Rogenstein Member corresponds to the top of the Bunter Shale Formation and is placed at an abrupt downward increase in the proportion of mudstone below the dominantly arenaceous Bunter Sandstone Formation. The boundary is marked by an abrupt downward increase in gamma-ray values and, in some logs, by a downward decrease in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BTSH ;
    skos:definition "Mudstone with subsidiary dolostone, sandstone and siltstone and trace anhydrite-stone. Stratified bedrock. Occurs offshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
