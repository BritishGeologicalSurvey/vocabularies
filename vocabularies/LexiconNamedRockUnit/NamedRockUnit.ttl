    lexicon:hasThicknessDescription "Up to approximately 360 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from a marine band containing Gastrioceras Cancellatum to shales of the Rough Rock Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CZ> ;
    lexicon:hasYoungestAgeValue 3.2e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:MARSD ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
