namedrockunit:KYL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey nodular limestone with siltstone partings overlain by grey massive beds of bioclastic limestone that are locally dolomitised; probably lowest part seen comprises dark grey siltstone with thin impure limestone beds.  Thin unit of synsedimentary breccia and siltstone at top of Formation.  Limestone is locally richly fossiliferous."@en ;
    lexicon:hasLowerBoundaryDefinition "Formation seen only in core of anticline, base not reached."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasOldestAgeValue 4.4975e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "More than 50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of black mudstones of overlying Silurian strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DNT ;
    skos:definition "Limestone with subsidiary siltstone and trace breccia. Stratified bedrock. Occurs onshore. Deposited during the Ashgill Series (Ordovician Period) (449.75-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KYL"@en ;
    skos:prefLabel "Keisley Limestone Formation"@en ;
.

