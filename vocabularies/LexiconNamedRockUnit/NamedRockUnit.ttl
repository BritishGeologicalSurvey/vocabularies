namedrockunit:WAR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sequence of siltstone, variably-cemented sandstone/sand and mudstone. Glauconite is present in many of the sandstone beds. Thin layers of black chert pebbles, strongly bioturbated beds and shelly beds occur at some levels. There are also unconfirmed reports of palaeosols and evaporitic pseudomorphs at some localities. Higher intervals, comprising bioclastic, lime mud-rich limestones and glauconitic limestones, previously considered as forming part of the Portland Sand Formation (Wimbledon, 1976, 1980), were classified with the Portland Stone Formation by Bristow et al. (1999). Vale of Pewsey, Wiltshire: Sand and variably cemented sandstone, very well sorted fine- to medium-grained, quartzose and moderately glauconitic, green where unweathered, bioturbated, shells and shell debris in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change from dark grey, slightly sandy mudstone of the Kimmeridge Clay Formation to clayey sand and sandy mudstone; boundary taken at the base of a glauconitic sand forming the top to a coarsening-upward cycle. Springs commonly mark the base."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2373 ,
        namedrockunit:H3115 ,
        namedrockunit:H3116 ,
        namedrockunit:H3812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Vale of Wardour up to 24m; Vale of Pewsey up to 20m; 30m in Urchfont borehole (SU05NW 18 [SU 0444 5816])."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change from sandy mudstone and clayey sand and sandstone to fine-grained bioclastic sandstone and sandy limestone (Vale of Pewsey; undivided Portland Stone Formation) or (Vale of Wardour) shelly lime-mudstone of the Tisbury Member (Portland Stone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ,
        "Lower Portland Beds [Obsolete: use WAR]"@en ,
        "Portland Sand [Obsolete: use POSA, PLS, PSND, WAR]"@en ,
        "Wardour Member [Obsolete: use WAR]"@en ;
    skos:broader namedrockunit:PL ;
    skos:definition "Glauconitic sandstone, mudstone, sand, sandstone and siltstone with subsidiary conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WAR"@en ;
    skos:prefLabel "Wardour Formation"@en ;
.

