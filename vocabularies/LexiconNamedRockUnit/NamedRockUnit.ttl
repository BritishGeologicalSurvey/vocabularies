namedrockunit:THUN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, reddish-orange and rare pebbly sandstone, reddish-grey. Predominantly fine-grained; well-sorted with spherical to sub spherical grains. Rare laterally impersistent pebbly sandstone beds up to 3m thick in lower part. Soft sediment deformation common in pebble-free units. Less well-cemented in comparison to overlying Delamere Sandstone Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at base of a maximum 3m thick pebbly sandstone bed (the 'Thurstaston Hard Sandstone Bed'), overlying pebble-free reddish-orange sandstone of the Wilmslow Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:UMS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "58m in Hoylake Water Works No.2 Borehole (SJ28NW/5). Wirral. 62m in Hoylake Water Works No.1 Borehole (SJ28NW/4). Wirral."@en ;
    lexicon:hasUpperBoundaryDefinition "At boundary of weakly-cemented, pebble-free sandstone and overlying pebbly sandstone of the Delamere Sandstone Member (Helsby Sandstone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Mottled Sandstone [Obsolete: use THUN, WLSF, WRS]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:THHB ;
    skos:notation "THUN"@en ;
    skos:prefLabel "Thurstaston Sandstone Member"@en ;
.

