namedrockunit:MACK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Marl-free smooth white chalk with little flint, weakly developed indurated iron-stained sponge beds. There are no formal subdivisions, but informally the member includes a number of laterally persistent flint and marl beds named in Robinson (1986), which can be traced outside Kent in the Southern and \"Transitional\" provinces where they are correlated with the named beds of Mortimore (1986) within the Newhaven Chalk Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable at the surface immediately above the Barrois Sponge Bed in Thanet (Robinson, 1986)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1679 ,
        namedrockunit:H385 ,
        namedrockunit:S917 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasOldestAgeValue 8.57e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 24m in the North Foreland to Foreness Point and Palm Bay sections on the Isle of Thanet in north Kent."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is limited by the sub-Palaeogene erosion surface in the Isle of Thanet."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Margate Chalk Formation [Obsolete: use MACK]"@en ,
        "Margate Chalk [Obsolete: use MACK]"@en ,
        "Margate Member [Obsolete: use MACK]"@en ;
    skos:broader namedrockunit:NCK ;
    skos:definition "Chalk and trace flint. Stratified bedrock. Occurs onshore. Deposited during the Santonian Age - to - Campanian Age (Cretaceous Period) (85.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MACK"@en ;
    skos:prefLabel "Margate Chalk Member"@en ;
.

namedrockunit:MALM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive to weakly bedded, pale grey to very pale grey, medium- to coarse-grained calcarenite packstones and grainstones, and well bedded, thick to very thick-bedded, mid-pale to very pale calcarenite packstones, wackestones and subordinate grainstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of pale grey limestone of the Cove Limestone Member (of the Malham Formation) where is rests conformably (but gradationally and slightly diachronously) on the mid dark-grey limestone of the Scaleber Quarry Member (of the Kilnsey Formation) or, locally, unconformably on Lower Palaeozoic strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription " 220m south of the Middle Craven Fault to about 140m north of the North Craven Fault."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from pale grey limestone of the Gordale Limestone Member (of the Malham Formation) to darker grey limestone of the Lower Hawes Limestone at the base of the Alston Formation, Yoredale Group. However, in the Cominco S11 Borehole (SD 8590 6340) (SD86SE/5) the upper boundary of what is probably the Malham Formation is unconformable beneath rocks of the Bowland Shale Formation, Craven Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CVLS ,
        namedrockunit:GDLL ,
        namedrockunit:MALMA ;
    skos:notation "MALM"@en ;
    skos:prefLabel "Malham Formation"@en ;
.

namedrockunit:MARG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
