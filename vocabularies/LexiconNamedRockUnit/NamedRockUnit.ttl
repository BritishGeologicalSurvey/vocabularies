    skos:broader namedrockunit:IHEB ;
    skos:definition "Siltstone and silty mudstone with subsidiary carbonaceous mudstone and micaceous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Late Cretaceous Epoch (Cretaceous Period) - to - Paleocene Epoch (Palaeogene Period) (100.5-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BIAD"@en ;
    skos:prefLabel "Beinn Iadain Mudstone Formation"@en ;
.

