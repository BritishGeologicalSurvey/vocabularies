    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Estuarine clayey silt and clay, may be rooty and structureless or highly laminated with silt and very fine- to medium-grained sand; grey and brownish grey, finely micaceous, with dark sulphidic patches. Brown and grey, fine-grained shelly sand locally indicates a more open marine environment."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable terraced estuarine deposits, commonly on the Tay-Earn Gravels Member (Forth Clay Formation) and other late Devensian and Holocene units."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:GOSI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary most commonly at the surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gowrie Silt Member [Obsolete: use GWR]"@en ;
    skos:broader namedrockunit:CARCL ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GWR"@en ;
    skos:prefLabel "Gowrie Member"@en ;
.

namedrockunit:GWSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive to medium-bedded grey calcareous sandstone. Locally shelly. Thin mudstones in uppermost part. Represents transgressive shoreface sand in response to the post glacial rise in sea level at the end of the Ordovician."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the unconformable contact of the Graig-wen Sandstone with the underlying limestones and mudstones of the Dolhir Formation. The contact is locally an irregular palaeokarstic surface with the Graig-wen Sandstone penetrating through solution pits in the limestone into the underlying mudstones. It is likely the Graig-wen Sandstone Formation may be conformable with the Dolhir Formation near its feather edge but further work is needed."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H945 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasOldestAgeValue 4.452e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the gradational (over about a metre) incoming of the mudstone dominant sequence of the Laundry Mudstone Formation above the sandstones and subordinates thin mudstones at the top of the underlying Graig-wen Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Meristina Crassa Sandstone [Obsolete: use GWSA]"@en ;
    skos:definition "Sandstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hirnantian Age (Ordovician Period) (445.2-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "GWSA"@en ;
    skos:prefLabel "Graig-wen Sandstone Formation"@en ;
.

