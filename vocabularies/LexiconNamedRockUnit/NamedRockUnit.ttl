namedrockunit:ULHLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Upper Lecket HIll Lava Member consists generally of relatively evolved lavas, including trachybasalt (hawaiite), basaltic-trachyandesite (mugearite), trachyte and rare plagioclase-microphyric basalt transitional to trachybasalt (of 'Jedburgh' type). The member is generally poorly exposed, but at least seven platy-jointed and rather slaggy lavas are present. North-east of the summit of Lecket Hill [NS 6445 8121], lapilli-tuffs and agglomerates predominate locally over lavas. Craig (1980) has inferred that the source of the member was the nearby Waterhead Centre ('Waterhead Central Volcanic Complex')."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal basaltic-trachyandesite (mugearite) lava of the member is conformable or disconformable on underlying plagioclase-macrophyric trachybasalt (hawaiite) lava of the Boyd's Burn Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4383 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "65 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Upper Lecket Hill Lava Member is overlain apparently conformably or disconformably by the Kilsyth Hills Lava Member, which has a similar geographical distribution. The lithological change is to plagioclase-macrophyric transitional to plagioclase-microphyric basalt and trachybasalt (hawaiite) lavas (of 'Markle' type transitional to 'Jedburgh' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Lecket Hill Lavas [Obsolete: use ULHLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Hawaiite, mugearite and trachyte with subsidiary agglomerate, basalt and lapilli-tuff. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ULHLA"@en ;
    skos:prefLabel "Upper Lecket Hill Lava Member"@en ;
.

