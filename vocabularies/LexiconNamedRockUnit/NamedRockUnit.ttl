    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Limestone, mudstone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
