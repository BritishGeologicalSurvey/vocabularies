namedrockunit:THSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly reddish brown fine- to very fine-grained sandstone, with local thin beds and partings of reddish brown clay. Lenticular breccia bed south of Raddon (c.SS 915 016); possibly other thin breccias present. Basaltic lavas at various levels. May correlate with Knowle Sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Cadbury Breccia, apparently fairly sharply, possibly unconformably; exact nature of contact uncertain."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1475 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 120m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain, apparently fairly sharply and unconformably west of Thorverton by Crediton Breccia, and by Yellowford Formation elsewhere."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Sandstone [Obsolete: use DAS, THSA]"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Sandstone with subsidiary basalt, breccia and clay. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THSA"@en ;
    skos:prefLabel "Thorverton Sandstone Formation"@en ;
.

namedrockunit:THSS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Green and red glauconitic sandstone, generally fine-grained, clay-free and well-sorted, with several layers of chertified sandstone. A massive basal conglomerate is locally developed and in places strongly silicified, with oyster-encrusted pebbles and scattered corals. Lenses of shelly, indurated sandstone containing silicified bivalves occur in the lower part of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with Permian breccias. In some places the unconformity is irregular and overlain by a massive, locally silicified, highly fossiliferous conglomerate; elsewhere the unconformity is relatively flat and overlain by a bed of derived pebbles."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1299 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 5.26m."@en ;
    lexicon:hasUpperBoundaryDefinition "Contact with the overlying Woodlands Sands Member, marked by an upward facies-change to coarser, less well-sorted and more clay-rich sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Haldon Sands [Obsolete: use UGSD, ACGR, CUSC, THSS, WLSS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Glauconitic sandstone and sandstone with subsidiary chert, conglomerate and shelly sandstone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THSS"@en ;
    skos:prefLabel "Telegraph Hill Sands Member"@en ;
.

namedrockunit:THTL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Packstones, wackestones and subordinate grainstones predominantly wavy-bedded, muddy, pale to dark grey, bioclastic and locally cherty, interbedded with variable amounts of dark-grey calcareous mudstone and siltstone. Bioturbation is common."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Chatburn Limestone Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by the Hodder Mudstone Formation in the Worston Shale Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CLL ;
    skos:definition "Limestone with subsidiary calcareous mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:THTK ;
    skos:notation "THTL"@en ;
    skos:prefLabel "Thornton Limestone Member"@en ;
.

namedrockunit:THW
    a skos:Concept ;
