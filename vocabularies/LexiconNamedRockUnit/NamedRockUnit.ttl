namedrockunit:SCSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold-phase sands and gravels that underlie the Scarle Terrace. Gravel dominated by rounded pebbles of \"Bunter\" quartz/quartzite with subordinate subangular flint, and rarer Triassic sandstone, Lias limestone, etc. Infills a shallow channel diverging from the Trent at Collingham and extending northnortheastwards to North Scarle where it is apparently truncated by the Kirkstead Sand and Gravel Member. Surface is c.3 to 4m above the Trent floodplain, and up to c.2m above the adjoining Kirkstead/Holme Pierrepont Terrace. Correlated with Beeston Sand and Gravel Member (Trent Valley Formation), and Fulbeck Sand and Gravel Member (Proto-Trent)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3023 ,
        namedrockunit:H325 ,
        namedrockunit:H4874 ,
        namedrockunit:ORSG ,
        namedrockunit:RGR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Floodplain terrace [Obsolete]"@en ,
        "Older river sand and gravel"@en ,
        "River gravel"@en ,
        "Scarle Member [Obsolete: use SCSG]"@en ,
        "Scarle Sand and Gravel [Obsolete: use SCSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCSG"@en ;
    skos:prefLabel "Scarle Sand and Gravel Member"@en ;
.

namedrockunit:SCY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:HDST ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of the formation (Moor Grit Member) is dominated in coastal exposures by grey, medium- to coarse-grained, sporadically pebbly, trough cross-bedded sandstone, with thin siltstone and mudstone beds; plant fragments and fossil wood casts are common. Inland, in the Hambleton Hills (Powell et al., 1992) this member is represented by grey to white, fine-grained, orthoquartzitic sandstone, with low-angle cross stratification and planar bedding. The uppermost Long Nab Member comprises laminated grey mudstones and siltstones with yellowish grey, fine- to medium-grained, planar bedded and cross-stratified sandstones. Plant fragments and rootlets are common in both members, together with sporadic thin coals and grey mudstone seatearths."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is disconformable or unconformable, at the abrupt upward transition from grey, shelly mudstone or shelly sandstone of the Scarborough Formation to grey, cross-bedded and planar laminated sandstone with sporadic plant fragments of the lower part of the Scalby Formation (Moor Grit Member)  (Gowland and Riding, 1991; Nami and Leeder, 1978; Powell et al., 1992). The boundary is commonly a scoured, erosional surface."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3024 ,
        namedrockunit:H697 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 60 m on the North Yorkshire coast; 32 to 48 m in the Hambleton Hills in the west of the outcrop."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable or disconformable, at the boundary between siltstone, mudstone or cross-bedded sandstone with plant fragments of the Long Nab Member (Scalby Formation) and the Cornbrash Formation, which at Cayton Bay [TA 078 841], comprises red-brown, sandy, nodular, bioturbated limestone with oysters and other bivalves; u-shaped burrows extend down from the base of the Cornbrash Formation into the underlying grey siltstone and silty sandstone of the Scalby Formation (Wright, 1977). Inland in the Hambleton Hills and Howardian Hills, the Cornbrash Formation (limestone) is generally absent (Powell et al., 1992, p.53) and the upper boundary is taken at the base of the yellow-brown, calcareous medium-grained sandstone with bivalves (Kellaways Rock Member, Osgodby Formation). The Kellaways Rock Member is referred to as the Redcliff Rock Member by Page (1989)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hudleston Formation"@en ,
        "Upper Deltaic Series [Obsolete: use SCY]"@en ,
        "Upper Estuarine Series [Obsolete: use BIAD, RLD, SCY]"@en ;
    skos:broader namedrockunit:RAG ;
    skos:definition "Mudstone and sandstone with subsidiary quartz-arenite and siltstone and trace coal and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LNAB ,
        namedrockunit:MRG ;
    skos:notation "SCY"@en ;
    skos:prefLabel "Scalby Formation"@en ;
.

