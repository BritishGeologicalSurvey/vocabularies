namedrockunit:BUTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stoney sandy clay diamicton, matrix-supported, dark yellowish brown to olive-grey, fissile, massive, extremely compact, containing angular to subrounded clasts of gneissose psammite and semipelite, granite and some Devonian sandstone and siltstone. Typical lodgement till with well developed north-easterly fabric and containing concavo-convex discontinuities that are commonly sand-filled."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a gradational contact over 10-20cm, or locally a sharp, planar one, with stony, sandy diamictons of the underlying Athais Till Formation, or on bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1472 ,
        namedrockunit:H4506 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Erosional contact with gravel of the Carn Monadh Gravel Formation at the Allt Odhar Interstadial site, various younger deposits or the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dalcharn Upper Till Formation [Obsolete: use CYTI]"@en ,
        "The Moy Upper Till Member [Obsolete: use BUTI]"@en ;
    skos:broader namedrockunit:CGDR ;
    skos:definition "Diamicton with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CYTI ,
        namedrockunit:RNTI ;
    skos:notation "BUTI"@en ;
    skos:prefLabel "Beinn an Uain Till Formation"@en ;
