namedrockunit:CCLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAROCM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Cochno Lava Member includes a wide range of lava types but is characterised by more mafic varieties, particularly near the base. These include olivine-microphyric basalts (Dalmeny type), olivine-clinopyroxene-macrophyric basalts (Craiglockhart type) and olivine-clinopyroxene-plagioclase-macrophyric basalts (Dunsapie type). Localised plagioclase-macrophyric basalts (Markle type) and plagioclase-microphyric basalts (Jedburgh type) occur in the south-west, around Bowling [NS 445 738]."@en ;
    lexicon:hasLowerBoundaryDefinition "The Cochno Lava Member overlies the Greenside Volcaniclastic Member and represents the restarting of lava extrusion after a major break in activity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H756 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100-250 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Cochno Lava Member is overlain by the Mugdock Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cochno Lavas [Obsolete: use CCLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Olivine-clinopyroxene-macrophyric basaltic-rock, olivine-clinopyroxene-plagioclase-macrophyric basalt and olivine-microphyric basalt with subsidiary plagioclase-macrophyric basalt and plagioclase-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CCLA"@en ;
    skos:prefLabel "Cochno Lava Member"@en ;
.

