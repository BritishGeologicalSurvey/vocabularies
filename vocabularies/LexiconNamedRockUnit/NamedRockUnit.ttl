    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "DINA-SLAR: Interbedded sandstone, limestone and argillaceous beds - locally with conglomerates. DINA-LSSA: Interbedded limestone with subordinate sandstone and argillaceous beds. DINA-LMST: Dominated by limestones and locally dolostones."@en ;
    lexicon:hasLowerBoundaryDefinition "Typically an unconformable boundary representing the base of Carboniferous strata, resting upon Lower Palaeozoic rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasThicknessDescription "Up to c. 2000 m in Peak District; up to c. 2100 m in Clitheroe area of south Pennines; c. 1100 m in south Cumbria; c. 350 m in west Cumbria; 55 m on Alston Block; c. 1100 m around Ravenstonedale; c. 900 m in Somerset Coalfield; up to 1000 m in southern England, South Wales and North Wales; 140 m in Kent Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by Craven Group strata across North Wales, Midlands, Lancashire and Yorkshire. Across northern England conformably overlain by the Yoredale Group. In Berkshire and Kent coalfields overlain unconformably by South Wales Coal Measures Group. In South Wales-Bristol area conformably overlain by the Marros Group. In East Anglia unconformably overlain by Permian strata (undifferentiated)and across much of southern England in subsurface overlain unconformably by Mercia Mudstone Group/Lias Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Avon Group"@en ,
        "Clwyd Limestone Group"@en ,
        "Craven Group"@en ,
        "Great Scar Limestone Group"@en ,
        "Peak Limestone Group"@en ,
        "Pembroke Limestone Group"@en ,
        "Ravenstonedale Group"@en ;
    skos:definition "Limestone and sandstone with subsidiary dolostone and mudstone and trace conglomerate. Bedrock. Occurs both onshore and offshore. Formed during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "DINA"@en ;
    skos:prefLabel "Dinantian Rocks (Undifferentiated)"@en ;
