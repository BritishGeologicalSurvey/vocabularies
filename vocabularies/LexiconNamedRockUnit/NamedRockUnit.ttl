namedrockunit:MO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale to medium grey, thickly-bedded and bioturbated well-sorted biosparites and pelsparites, to poorly sorted biomicrites. The limestone contains sporadic chert nodules, and emergent surfaces are marked by pedogenic tubes and crusts of brown laminated micrite. The lower part at Cressbrook Dale - Millers Dale and all around Litton, comprise dark grey thinly-bedded, cherty limestone containing dark argillaceous partings, the limestone being typically a poorly sorted bioclastic calcisiltite with a micritic matrix, and includes several volcanic members of basaltic lava and tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp unconformable boundary with the lowest bed of dark limestone, commonly marked by abundant Girvanella or Saccamminopsis, above the pale grey limestones of the Bee Low Limestone Formation. Elsewhere, the boundary is marked by the base of the Upper Millers Dale Lava, Winstermoor Lava or Lower Matlock Lava."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1068 ,
        namedrockunit:H3555 ,
        namedrockunit:H401 ,
        namedrockunit:H402 ,
        namedrockunit:H403 ,
        namedrockunit:LMD ,
        namedrockunit:MAG ,
        namedrockunit:UMD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Appears 143 m thick in the Cressbrook Dale section (200m at Ashford on the Water [SK 19 69], and 359 m at Longstone Edge [SK 20 73]."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the dark grey - grey-brown limestones of the overlying Eyam Limestone, which locally overlies an erosive surface and clay wayboard above the pale to medium grey limestone, of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Monsal Dale Beds [Obsolete: use MO]"@en ,
        "Matlock Group [Obsolete: use MO]"@en ,
        "Monsal Dale Beds [Obsolete: use MO]"@en ,
        "Monsal Dale Formation [Obsolete: use MO]"@en ,
        "Monsal Dale Group [Obsolete: use MO]"@en ,
        "Monsal Dale Limestones Formation [Obsolete: use MO]"@en ,
        "Monsal Dale Limestones [Obsolete: use MO]"@en ,
        "Upper Monsal Dale Beds [Obsolete: use MO]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Limestone with subsidiary basalt and tuff. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
