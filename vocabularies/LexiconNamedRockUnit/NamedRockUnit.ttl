namedrockunit:TYPO
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:TAYP ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Tayport Formation in the Southern North Sea is composed of alternating mudstone or siltstone beds, up to 15 m thick, and sandstone beds up to 60 m thick. The mudstones are red, reddish brown, grey, greenish grey or occasionally purple, and the sandstones are grey, purplish grey or white. The thickest sandstones display complex, upward-fining, or blocky gamma-log motifs. Their grain sizes range from fine to coarse; they are locally pebbly, and are poorly sorted. The formation displays gross upward-coarsening trends in well 37/10-1 and below 2595 m in 38/24-1. The sediments are commonly micaceous, and they are locally very micaceous."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Tayport Formation has not been penetrated in the Southern North Sea. In the Central North Sea, the formation rests on fluvial sandstones of the Buchan Formation (Cameron 1993). The Buchan Formation may also occur beneath the Tayport Formation in the Southern North Sea."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum drilled thickness is 649 m in well 37/10-1."@en ;
    lexicon:hasUpperBoundaryDefinition "Over the crest of the Mid North Sea High, the Tayport Formation is unconformably overlain by Upper Permian carbonates and evaporites of the Zechstein Group. Along the southern flank of the High, the formation is conformably overlain by dolomitic carbonates (cementstones) and clastic sediments of the Cementstone Formation, the boundary being marked by the base of the sonic-log spike corresponding to the lowest cementstone bed (e.g. 44/2-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tayport Formation [Duplicate: use TYPO]"@en ;
    skos:broader namedrockunit:UPOR ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Famennian Age (Devonian Period) - to - Courceyan Substage (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TYPO"@en ;
    skos:prefLabel "Tayport Formation"@en ;
.

