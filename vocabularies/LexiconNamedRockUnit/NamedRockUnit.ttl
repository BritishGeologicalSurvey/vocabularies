namedrockunit:PET
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent
        namedrockunit:LOXC ,
        namedrockunit:MPMU ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly brownish-grey, fissile, organic-rich (bituminous) mudstones; shelly fauna dominated by crushed aragonitic ammonites and bivalves, including nuculoid and meleagrinella shell-beds. Subordinate beds of pale-medium grey, blocky mudstone. Several bands of cementstone nodules/concretions. Basal beds commonly silty, with Gryphaea-rich shell beds."@en ;
    lexicon:hasLowerBoundaryDefinition "At top of highest sandstone of underlying Kellaways Formation (this is the best definition for mapping purposes and consistency; a boundary based on the lowest mudstone is more subjective and arbitrary. This boundary is also the lower boundary of the Oxford Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2367 ,
        namedrockunit:LOXC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - c.65m"@en ;
    lexicon:hasUpperBoundaryDefinition "At top of highest brownish-grey, organic-rich mudstone within thinly interbedded lithological transition (up to c.3m thick) to pale grey, calcareous mudstones of overlying 'Middle Oxford Clay' (see Stewartby Member). Inevitably, more or less arbitrary in field mapping."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Oxford Clay Member [Obsolete: use PET]"@en ,
        "Lower Oxford Clay [Obsolete: use PET]"@en ,
        "Mohuns Park Mudstone Bed"@en ;
    skos:broader namedrockunit:OXC ;
    skos:definition "Mudstone with subsidiary calcilutite and shelly mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ACCO ,
        namedrockunit:MPMU ;
    skos:notation "PET"@en ;
    skos:prefLabel "Peterborough Member"@en ;
