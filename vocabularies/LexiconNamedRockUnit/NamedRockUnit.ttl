namedrockunit:CDHP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey flaggy quartzo-feldspathic psammite with micaceous psammite interlayers grading into micaceous pelitic tops, including muscovite and biotite. Psammites 10 to 40cm thick are common, thinner near the base; amalgamated psammites up to 6m thick are known. Semipelites/pelites are usually about 1cm thick but locally up to 20cm thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of the Torr na Truim Semipelite Formation, where predominantly schistose semipelite is overlain by the flaggy bedded, predominantly psammitic succession belonging to the Creag Dhubh Psammite Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4416 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.700m +"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the Creag na Sanais Semipelite Formation, where predominantly gneissose semipelite overlies the psammitic succession belonging to the Creag Dhubh Psammite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Part of the Moine Psammites [Obsolete: use ABIP, CDHP]"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Micaceous psammite and psammite with subsidiary semipelite and trace calcsilicate-rock and pelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CDHP"@en ;
    skos:prefLabel "Creag Dhubh Psammite Formation"@en ;
.

namedrockunit:CDLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Craigdouffie Lava Member consists of a sequence of at least four lavas, comprising alternating plagioclase-macrophyric basalt or trachybasalt (basalt to hawaiite of 'Markle' type) and aphyric basaltic-trachyandesite (mugearite), all with proximal-facies characteristics. The source is probably an undetected vent in the immediate vicinity (Craig, 1980)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is faulted and unseen."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H759 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "More than 15 m, base not seen."@en ;
    lexicon:hasUpperBoundaryDefinition "The Craigdouffie Lava Member is overlain by poorly exposed volcaniclastic sedimentary rocks of the Kirkwood Formation of the Strachclyde Group. The lithological change is from basalt or trachybasalt to tuffaceous mudstones and tuffs but the nature of the contact is not known."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Craigdouffie Lavas [Obsolete: use CDLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and hawaiite with subsidiary mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CDLA"@en ;
    skos:prefLabel "Craigdouffie Lava Member"@en ;
.

