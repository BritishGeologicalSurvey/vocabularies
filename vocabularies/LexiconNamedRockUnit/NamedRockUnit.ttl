namedrockunit:PGWS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Pegwell Silt Member comprises interbedded silty sands, some clayey, and sandy or silty clays, with sparse bivalve fossils. \r
\r
The Pegwell Silt is early to mid-Thanetian in age (NP6 to NP8), based on microfossils (especially nannofossils) (King, in prep.) and magnetostratigraphy (Ali and Jolley, 1996)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Pegwell Silt Member occurs at the appearance of fine-grained sand above the Stourmouth Silt Member (STMH)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5091 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasOldestAgeValue 5.92e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 13 m in east Kent, diminishing westwards."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Pegwell Silt Member is taken at the transitional change to more uniform fine-grained sands of the overlying Kentish Sands Member (KNTS)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pegwell Marls [Obsolete: use PGWS]"@en ;
    skos:broader namedrockunit:TAB ;
    skos:definition "Clay, sand and silt. Stratified bedrock. Occurs onshore. Deposited during the Thanetian Age (Palaeogene Period) (59.2-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PGWS"@en ;
    skos:prefLabel "Pegwell Silt Member"@en ;
