namedrockunit:VTS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation is dominated by sandstone, medium- to coarse-grained, white to pale yellow, friable, cross-bedded in sets up to about 6m thick with prominent large (up to 1m in diameter), ovoid to near-spherical calcareous concretions or doggers produced following burial. Some of the medium-grained sandstones are significantly carbonaceous. The sandstone units are normally upward coarsening and capped by thin shelly limestones, normally coarse, sandy Neomiodon biosparites. Bioturbated green silty fissile mudstones and Neomiodon limestones occur within the sandstone units."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation in the type area is marked by the first upsection occurrence of silty fissile mudstones with monotypic Neomiodon beds.  These beds overlie the fissile mudstones of the Lealt Shale Formation; hence this boundary is gradational."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1256 ,
        namedrockunit:H2520 ,
        namedrockunit:H2521 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Thicknesses from Harris and Hudson (1980) except where indicated. A maximum onshore thickness of 120m is estimated in Trotternish, Skye. Southwards, the formation thins significantly to about 70m in north-west Skye (British Geological Survey, 2006a), up to 52m on Raasay (British Geological Survey, 2006b), around 21m in Strathaird, Skye and about 60m on Eigg. At least 15m are present on Muck."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is defined by the first upsection occurrence of the oyster Praeexogyra hebridica (Forbes) in the lowermost beds of the Duntulm Formation. Lithologically, this boundary is gradational with the fissile mudstones with freshwater faunas of the uppermost Valtos Sandstone Formation being overlain by fissile mudstones with marine fossils of the lowermost Duntulm Formation. The formation is unconformably overlain by extrusive rocks of the Paleocene Skye Lava Group in places."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Concretionary Sandstone Series [Obsolete: use VTS]"@en ,
        "Concretionary Sandstones [Obsolete: use VTS]"@en ,
        "Cyrena Limestones [Obsolete: use VTS]"@en ;
    skos:broader namedrockunit:GEST ;
    skos:definition "Sandstone with subsidiary limestone, mudstone and sandy limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "VTS"@en ;
    skos:prefLabel "Valtos Sandstone Formation"@en ;
.

