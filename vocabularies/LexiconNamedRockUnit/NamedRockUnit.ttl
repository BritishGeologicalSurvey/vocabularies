namedrockunit:HYBH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to coarsely crystalline sandy dolostone, dolomitic sandstones and dolomites with thin stylolitic shaly mudstone and clay partings."@en ;
    lexicon:hasLowerBoundaryDefinition "The incoming of common beds of sandy dolostone/dolomitic sandstone in the Milldale Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H133 ,
        namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-61m"@en ;
    lexicon:hasUpperBoundaryDefinition "In the type section the top is taken at the top of the highest sandy dolomite, here additionally containing derived pebbles. The member is suceeded by grey, medium to thickly-bedded dolostones of the undivided Milldale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carboniferous Limestone [Obsolete: use CL, PKLM, CLWYD, PEMB, BOHI, HOHI, TRLI]"@en ,
        "Cloud Hill Dolomite Formation [Obsolete: use HYBH, CLHD]"@en ;
    skos:broader namedrockunit:MI ;
    skos:definition "Dolomitic limestone with subsidiary mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HYBH"@en ;
    skos:prefLabel "Holly Bush Member"@en ;
.

namedrockunit:HYSH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use HYMU] Hard dark-blue or bluish-green, generally mottled, shales and mudstones. Calcareous bands and nodules, and calcareous shales and mudstones occur near the top and a calcareous siltstone (yielding rich Famennian faunas locally) forms a small ridge at Hyner (SX 8404 8214) and east of Christow (SX 8407 8488). Where the Hyner Shale is within the metamorphic aureole of the Dartmoor Granite, calc-flintas are common and siliceous nodules are characteristic of the lower parts of the formation.."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3484 ,
        namedrockunit:H4719 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Uncertain; at least 244m in Teign Valley (Selwood and others, 1984, p.50)."@en ;
    lexicon:hasUpperBoundaryDefinition "Passes conformably upwards into grey and green micaceous shales of the Trusham Shale. (Entomozoid ostracods in the upper part of the Hyner Shale define the Devonian-Carboniferous boundary.) In most locations the transition is marked in the field by variation from dark blue or bluish-green mottled shales and calcareous beds at the top of the Hyner Shale (described under Lithology) to grey micaceous and green shales of the Trusham Shale. This boundary cannot be detected in the area between the Lustleigh and Bovey Tracey faults, where the influence of the metamorphic aureole is more prevalent. In this area the Hyner and Trusham shales have not been separated."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:HYMU ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Hyner Formation [Obsolete: use HYMU, HYSH]"@en ,
        "Hyner Mudstone Formation"@en ,
        "Hyner Shale [Obsolete: use HYMU, HYSH]"@en ;
    skos:definition "Obsolete name. Mudstone with subsidiary calcareous mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Courceyan Substage (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HYSH"@en ;
    skos:prefLabel "Hyner Shale Formation [Obsolete: use HYMU]"@en ;
.

namedrockunit:IFLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ivy Farm Laminated Silt Member consists of two distinctive lithofacies: (1) rhythmically-bedded dark grey clays and pale grey silts that grade upwards into a pale yellow laminated marl; (2) horizontally bedded and rippled fine-grained pale grey sand rich in the heavy mineral zircon."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt but conformable lower boundary with either the diamicton facies of the Walcott Till Member or the sandy facies of the Mundesley Sand Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2862 ,
        namedrockunit:H4720 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "In excess of 22m. The true thickness is difficult to determine because the unit is truncated by several large-scale basal shear planes."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Trimingham area, the upper boundary of the silts and clays of the Ivy Farm Laminated Silt Member is truncated by the diamicton facies of the Bacton Green Till Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Happisburgh Clays [Obsolete: use IFLS]"@en ,
        "Trimingham Clays [Obsolete: use IFLS]"@en ;
    skos:broader namedrockunit:SMCL ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IFLS"@en ;
    skos:prefLabel "Ivy Farm Laminated Silt Member"@en ;
.

