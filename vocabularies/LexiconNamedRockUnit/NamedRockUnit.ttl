    lexicon:hasThicknessDescription "To 3 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the uppermost argillaceous limestone marked by a decrease in shell-detritus."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
