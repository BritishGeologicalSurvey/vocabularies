    skos:altLabel "Permian Evaporite C [Obsolete: use CBE]"@en ;
    skos:broader namedrockunit:EDSH ;
    skos:definition "Gypsum-stone. Stratified bedrock. Occurs onshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBE"@en ;
    skos:prefLabel "C-Bed Evaporite"@en ;
