namedrockunit:JWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:S901 ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, bioclastic, dark grey, thick wavy beds with fissile mudstone parting, and usually with abundant fossils. At many localities it contains a Saccaminopsis band about two thirds of the thickness above the base (Burgess and Holliday, 1979). A complete section is recorded from the Rookhope Borehole, but the lower 5m are intensely mineralized, whereas the upper part is black crinoidal limestone (Johnson and Nudds, 1996). In Cumbria, the member is composed of pale porcellaneous limestone with spots at the base, overlain by well bedded grey and grey-blue limestone that is crowded with Saccaminopsis fusulinaformis, and in some beds with abundant \"Lithostrotion\" (Eastwood et al., 1968)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp base of limestone beds, overlying a generally conformable ganister sandstone of the Alston Formation, or north of the Lake District resting on a few metres of siltstone, mudstone and sandstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H987 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Varies between 5 and 9.5m on the Alston Block; 9.1 to 12.2m north of the Lake District massif."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain, generally conformably, by siltstone and mudstone of the Alston Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Jew Limestone [Obsolete: use JWL]"@en ,
        "Oxford Limestone [Obsolete: use OXL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "JWL"@en ;
    skos:prefLabel "Jew Limestone Member"@en ;
.

namedrockunit:KARN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Killearn Borehole [NS 5100 8467] (Browne and McMillan, 1989a, Figure 8) contains the standard section of the Killearn Sand and Gravel Member (15.61 to 34.8m depth). The deposit forms an upward coarsening deltaic unit up to 17.95m and then fines up to the top of the member at a depth of 15.61m. The chief lithology is fine to medium grained sand. Silt and clay layers also occur, especially near the top and base, and there is also bands of fine gravel or sand with gravel (3cm maximum) in the upper part. They are dense to very dense and reddish brown or orange in colour. Other deposits are present locally in the Clyde valley in central and eastern Glasgow. They include deposits of beaches and river terraces as well as deltas. The stratigraphical relationships and geographical distribution of this member are illustrated in Browne and McMillan (1989a, Figures 2c, 3A, C, D and 4A, B) and also by sections described by Rose (1975) at Erskine Bridge [NS 4703 7286] and by Carruthers (1904) at Clydebank Cemetary [NS 4755 7285]. In both, the beach deposits are bedded sand and gravel."@en ;
    lexicon:hasLowerBoundaryDefinition "The Killearn Sand and Gravel Member of the Clyde Clay Formation rests with angular unconformity on older Quaternary sediments or bedrock. It normally rests either unconformably or by interdigitation on the Paisley Clay and Linwood Clay members of the Clyde Clay Formation or on the Wilderness Till Formation (WITI) of the Caledonia Glacigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1375 ,
        namedrockunit:H4723 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Ranges from a thin veneer to more than 15m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Killearn Sand and Gravel Member of the Clyde Clay Formation is overlain unconformably by younger Quaternary sediments normally belonging to the British Coastal Deposits Group. It is also exposed at surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clyde Beds [Obsolete: use PRTS, BOCH, LIWD, PAIS, KARN, CLYD]"@en ,
        "Killearn Formation [Obsolete: use KARN]"@en ;
    skos:broader namedrockunit:CLYD ;
    skos:definition "Sand with subsidiary gravel and silt and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KARN"@en ;
    skos:prefLabel "Killearn Sand And Gravel Member"@en ;
.

