namedrockunit:LFLA
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Loup of Fintry Lava Member consists of two lavas, separated by a thin bed of basaltic lapilli-tuff, with a combined thickness of nearly 30 m in the vicinity of Loup of Fintry [NS 662 862]. The lower lava is a plagiogclase-macrophyric trachybasalt (of 'Markle' type). The upper lava is a composite flow of similar overall composition, with intermingling of aphyric and feldspar-phyric components [NS 656 858]."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower (basal) plagioclase-macrophyric trachybasalt lava is conformable or disconformable on the underlying plagioclase-microphyric trachybasalt of  the lower north Campsie lavas (Campsie Lava Member)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4158 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "30 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper composite lava of the Loup of Fintry Lava Member is overlain apparently conformably, or disconformably by the upper north Campsie lavas (Campsie Lava Member). The lithological change is mostly to plagioclase-microphyric basalt (of 'Jedburgh' type), trachybasalt and basaltic-trachyandesite (mugearite)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Loup of Fintry Lavas [Obsolete: use LFLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Trachybasalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LFLA"@en ;
    skos:prefLabel "Loup of Fintry Lava Member"@en ;
.

namedrockunit:LFMLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAALK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BSN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use FMLA] \r
\r
The Lower Flow Moss Lava Member consists of alkali basalts and subordinate basanites and ankaramites."""@en ;
    lexicon:hasLowerBoundaryDefinition "The nature of the base is unknown but it might be unconformable on Inverclyde Group or older strata."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4159 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by and interbedded with the Moyne Moor Lava Member in the western part of the area of occurrence. Elsewhere where locally known, a thick bole is developed on the uppermost flow and the Upper Flow Moss Lava Member rests on this."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:FMLA ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Flow Moss Lava Member"@en ,
        "Flow Moss Lavas [Obsolete: use LFMLA, UFMLA]"@en ;
    skos:definition "Obsolete name. Alkali basalt with subsidiary basanite. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LFMLA"@en ;
    skos:prefLabel "Lower Flow Moss Lava Member [Obsolete: use FMLA]"@en ;
.

