namedrockunit:SHEP
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Sheppey Member comprises silty clay diffusely interbedded with sandy clayey silt; it is commonly glauconitic. There are several layers of calcareous concretions."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Sheppey Member is marked by a change upwards from mainly homogeneous silty clay of the Aveley Member to silty clay with common sandy clayey silt interbeds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
