namedrockunit:ESKRM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CVS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly greyish brown to yellowish brown, poorly sorted, gravelly sandy clay to slightly gravelly clay matrix with a little, ranging to much, gravel and cobbles (Morainic Till)."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed. The Escrick moraine is generally resting in older glaciolacustrine deposits of the Heminbrough Glaciolacustrine Formation. The contact between these two deposits can be irregular and glaciotectonised."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BICKM ,
        namedrockunit:DOD ,
        namedrockunit:H4031 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 20 to 30m recorded in borehole SE44SE/364 and 18.4m in borehole SE44SE/356; in type section it is up to 13.4m thickand in all boreholes the deposit rests on thin laminated clay belonging to underlying Heminbrough Glaciolacustrine Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed, or the present land surface. The unit is overlain locally by younger fluvial and aeolian deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bickerton Moraines Formation [Obsolete: use ESKRM]"@en ,
        "Escrick Moraine [Obsolete: use ESKRM]"@en ,
        "Morainic drift [Obsolete]"@en ;
    skos:broader namedrockunit:VYORK ;
    skos:definition "Sandy gravelly clay with subsidiary gravelly clayey sand and trace sandy gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ESKRM"@en ;
    skos:prefLabel "Escrick Moraine Member"@en ;
.

namedrockunit:FARO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The term Faroe Group was introduced by Knox et al. (1997) for the succession of mudstones and sandstones that lies between the Moray Group and the calcareous mudstones of the Shetland Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPM> ;
    lexicon:hasOldestAgeValue 6.17e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPL> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Mid Paleocene - to - Late Paleocene (Palaeogene Period) (61.7-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:KTLA ,
        namedrockunit:LMBA ,
        namedrockunit:VAIL ;
    skos:notation "FARO"@en ;
    skos:prefLabel "Faroe Group"@en ;
.

namedrockunit:FCK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "White, well-bedded, flint-free chalk with common marl seams (typically about one per metre). Common stylolitic surfaces and pyrite nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is at the top of the highest flint band of the underlying thick, flint-rich unit of chalk (ie. the Burnham Formation; qv); in the type section this is the High Stacks Flint, but elsewhere can be at a somewhat different horizon."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H241 ,
        namedrockunit:H4039 ,
        namedrockunit:H903 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasOldestAgeValue 8.57e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The type section, between Flamborough Head and Sewerby, exposes the basal about 160m of the formation. Equivalent, and probably slightly higher beds (extending up to about 220m above the base of the formation, according to Whitham, 1993) crop out inland, in the northernmost part of the Yorkshire Wolds, near Driffield. Still higher beds occur beneath drift in the Holderness region where the formation, in boreholes, appears to total about 265m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is at the base of the lowest flint of the succeeding thick, flint-rich Rowe Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chalk Without Flints [Obsolete: use FCK, FYCK]"@en ,
        "Flamborough Formation [Obsolete: use FCK, ROWE]"@en ,
        "Upper Chalk [Obsolete: use UWLF, FCK]"@en ;
    skos:broader namedrockunit:WHCK ;
    skos:definition "Chalk with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Santonian Age - to - Campanian Age (Cretaceous Period) (85.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FCK"@en ;
    skos:prefLabel "Flamborough Chalk Formation"@en ;
.

namedrockunit:FDNS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation is now divided from the base into the Faringdon Sponge Gravel Member, Baulking Sand Member and the Fernham Sand Member. The Faringdon Sponge Gravel Member comprises cross-bedded pebbly sands and highly fossiliferous gravels composed predominantly of the remains of calcareous sponges, with brachiopods, echinoderms and bryozoa. Bored mudstone and limestone clasts and phosphatised fossils, derived from the underlying Kimmeridge Clay and Corallian Group strata, occur at the base of the formation and at higher levels within the succession. Two subdivisions,comprising lower \"yellow gravel\" and upper (iron-oxide stained) \"red gravel\", have previously been recognized, separated by a non-sequence. According to Poole et al. (1971), cross-bedding diminishes upwards from the \"yellow gravel\" into the \"red gravel\", and there is a change in current direction as indicated by apparent dips. The Baulking Member comprises fine- to medium-grained siltstone and sandy mudstone with horizons of fuller's earth. Locally richly glauconitic with some horizons of shelly sand. The lower part of the interval is usually sandier, with horizons of fuller's earth and slumped beds. The upper part of the formation is mostly dark grey, thin current-bedded mudstone, with ironstone locally developed in the lower part of the interval. The mudstone contains white, fine-grained sandy and silty wisps and laminae. The Ferham Sand Member comprises reddish-brown, ferruginous, cross-bedded, shell-fragmental, medium- to coarse-grained, clean sandstone. There are scattered pebbles, bands of conglomeratic grit and minor horizons of mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, channelled, at the basal contact of the \"yellow gravel\" with underlying Kimmeridge Clay mudstones or, locally, Corallian Group limestones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable depending on local superposition of constituent members that have maximum thicknesses of about 50 m (Faringdon Sponge Gravel Member), up to 48 m (Baulking Sand Member) and at least 24 m (Fernham Sand Member)."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen. The Fernham Sand Member occurs as hill-cappings in the Baulking area. The top of the member is locally defined by the depth of the present-day weathered zone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Ferruginous sandstone, glauconitic sandstone, pebbly (gravelly) sandstone, sandstone, shelly sandstone and siltstone with subsidiary conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BKGS ,
        namedrockunit:FHMS ,
        namedrockunit:FSG ;
    skos:notation "FDNS"@en ;
    skos:prefLabel "Faringdon Sand Formation"@en ;
.

namedrockunit:FFG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ffairfach Grits Formation comprises massive, pink-weathering, medium- to coarse-grained arkosic sandstone with scattered, impersistent pebbly horizons with felsic tuff and rhyolite locally developed toward the top of the Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type area, the formation rests upon black, micaceous, graptolitic mudstones of the Abergwilli Formation (formerly known as Didymograptus bifidus Beds). The lower boundary is taken at the incoming of beds of indurated, medium-grained arkosic sandstone, which gradually pass up into massive sandstone (Williams, 1952). The contact is not exposed, but a near complete section is preserved in railway cuttings, small quarries, and in the banks of the River Cennen just south of the village of Ffairfach (Ordovician GCR)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:FFA ,
        namedrockunit:H2184 ,
        namedrockunit:H245 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 160m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Formation is overlain by fossiliferous, buff weathering, thinly interbedded fine-grained sandstone, silty calcareous mudstone and limestone of the Llandeilo Flags Formation. The contact between the two formations is not exposed and has been argued as being disconformable (Bergstrom et al., 1987). The most intact section across the boundary is preserved in the railway cutting south of Ffairfach, which has also been taken as the type section for the Llandeilo Flags Formation itself (Rushton et al., 1999)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasYoungestAgeValue 4.6125e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ffairfach Grit Member [Obsolete: use FFG]"@en ,
        "Ffairfach Grit [Obsolete: use FFG]"@en ,
        "Ffairfach Group [Obsolete: use FFG]"@en ;
    skos:definition "Feldspathic-arenite with subsidiary pebbly (gravelly) sandstone and trace rhyolite and rhyolitic tuff. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage (Ordovician Period) (468-461.25 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "FFG"@en ;
    skos:prefLabel "Ffairfach Grit Formation"@en ;
.

namedrockunit:FGSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SISST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thickly bedded, cross-stratified, pale grey to pale yellow, medium-grained sandstone. The unit represents the first thick sandstone in a generally more thinly-bedded sequence. It is consequently a mappable unit. It is a notable reflector in seismic sections and a marker horizon in borehole cores, marking the top of the Bighouse Formation in the Dounreay area."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies a thinly interbedded, sandstone-dominated rhythmic sequence of sandstones, siltstones and laminated carbonate mudstones (fish beds) of the Bighouse Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:FRSB ,
        namedrockunit:H246 ,
        namedrockunit:H907 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "32m"@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the overlying Sandside Bay Formation, which displays a cyclic depositional sequence dominated by sandstones, with thicker well-developed carbonate laminated mudstones (fish beds)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Fresgeo Sandstone [Obsolete: use FGSA]"@en ,
        "Fresgoe Sandstone Bed [Obsolete: use FGSA]"@en ,
        "Fresgoe Sandstone [Obsolete: use FGSA]"@en ;
    skos:broader namedrockunit:BIGH ;
    skos:definition "Sandstone and silicate-sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FGSA"@en ;
    skos:prefLabel "Fresgoe Sandstone Member"@en ;
.

namedrockunit:FIB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glauconitic sandy clays and clayey sands: orange-brown where weathered; bright green where unweathered."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by the incoming of conspicuous glauconitic clayey sands and sandy clays on fine-grained to medium-grained \"Bargate Beds\" (now Easebourne Member) where present."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H249 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "10 to 60 m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the area from Stedham to Storrington the upper boundary is marked by the change from glauconitic sandy clay and clayey sand upwards into fine-grained well-sorted sands of the Pulborough Sandrock. From Storrington eastwards the boundary is diffuse at the upward passage into silty clay of the Marehill Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fittleworth Beds [Obsolete: use FIB]"@en ;
    skos:broader namedrockunit:SAB ;
    skos:definition "Glauconitic mudstone, glauconitic sandstone, muddy sandstone and sandy mudstone with subsidiary clay and sand. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LFIB ,
        namedrockunit:UFIB ;
    skos:notation "FIB"@en ;
    skos:prefLabel "Fittleworth Member"@en ;
.

namedrockunit:FIFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPFLG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly thinly banded, flaggy, micaceous psammite and semipelite with more dominant semipelite locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of thinly bedded, flaggy psammites and semipelites above massive or thick-bedded quartzites of the Grampian Group (eg Cullen Quartzite Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DAFF ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 1350m on coast section; over 400m inland."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of non-calcareous flaggy psammites and semipelites that pass upwards into banded calcareous flags of the Pitlurg, Cairnfield or Foddsletter Formations, depending upon locality."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Findlater Flags [Obsolete: use FIFL]"@en ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Psammite and semipelite with subsidiary quartzite and trace flaggy semipelite and schist. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FICQ ,
        namedrockunit:WESD ;
    skos:notation "FIFL"@en ;
    skos:prefLabel "Findlater Flag Formation"@en ;
.

namedrockunit:FIND
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Findhorn Formation in Quadrant 12 is composed largely of very fine to fine grained, occasionally medium or coarse grained, argillaceous, locally micaceous, sandstones. The sandstones are moderately or poorly sorted, and reddish brown or, less commonly, pale grey in colour. They are mainly cemented by anhydrite or kaolinite and are mostly non-calcareous. Subsidiary beds, up to 5 m thick, of darker reddish brown or greenish grey mudstone or siltstone are present. Calcareous sandstones and thin beds of limestone have been noted in several wells. In the south of the quadrant, in particular, the gamma-ray response is irregular, suggesting an alternation of thinly bedded clean sandstones, argillaceous sandstones and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Red, unfossiliferous clastic sediments of the Findhorn Formation rest unconformably on reddened, sparsely fossiliferous Devonian clastic sediments across most of the Inner Moray Firth (e.g. on the Lower Devonian Struie Formation in 12/27-1, and on the Middle Devonian Strath Rory Formation in 12/27-2). Locally, they rest on metamorphic or granitic basement, or, as in well 12/23-1, on Upper Devonian to Lower Carboniferous strata (Buchan Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Findhorn Formation is more than 500 m thick in most of Quadrant 12; it has a maximum drilled thickness of 842 m in well 12/29-2. The formation is appreciably thinner adjacent to the Wick Fault and in central Quadrant 13, where it is about 300 m or less in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "The Findhorn Formation is conformably overlain by basal Upper Permian mudstones of the Kupferschiefer Formation in almost all wells, and the top of the formation is thus defined by a sharp downward change from mudstones to sandstones, marked by a sharp decrease in gamma-ray values. In the few wells in which the Kupferschiefer is absent, the Findhorn Formation is overlain by Upper Permian carbonates or, where the Upper Permian has been removed, by Upper Jurassic or Cretaceous rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RLG ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace limestone. Stratified bedrock. Occurs offshore. Deposited during the Cisuralian Epoch - to - Lopingian Epoch (Permian Period) (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FISI ,
        namedrockunit:LFSA ,
        namedrockunit:UFSA ;
    skos:notation "FIND"@en ;
    skos:prefLabel "Findhorn Formation"@en ;
.

namedrockunit:FINT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff stony sandy clay diamicton (Lodgement Till), predominantly sandstone clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable, glacitectonic contact with Clava Shelly Formation or with bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BOC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "8m or more"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp contact with glaciofluvial sheet deposits, ice contact deposits or moundy glacial deposits."@en ;
