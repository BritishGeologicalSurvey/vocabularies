namedrockunit:SMSG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses fluvial, lacustrine and organic deposits of the pre-Glacial Bytham River, At the type site, yellowish red to brownish yellow cross-stratified sands, with minor beds of pebbly sand, overlie sands and gravels. In the lower unit, massive and planar cross-stratified gravels alternate with planar cross-stratified, thick bedded massive pebbly and trough-bedded sands. Clast analysis of the gravels (11.2-16.0mm fraction) indicated 60.1% quartz and quartzite, 19.0% flint, 12.1% chert and 7.0% ironstone, and quartzite is derived from Triassic pebble beds to the west, chert from the Carboniferous, and flint from the local Chalk."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Cretaceous bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2436 ,
        namedrockunit:H531 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.6m"@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by Mid Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is usually helpful."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Shouldham Sands [Obsolete: use SMSG]"@en ,
        "Shouldham Sands and Gravels [Obsolete: use SMSG]"@en ;
    skos:broader namedrockunit:BYCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FOGR ,
        namedrockunit:HLSI ,
        namedrockunit:LHTH ;
    skos:notation "SMSG"@en ;
    skos:prefLabel "Shouldham Sand and Gravel Formation"@en ;
.

namedrockunit:SOARV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly post-Anglian fluvial terrace and alluvial deposits of the River Soar of Leicestershire and those of its tributaries such as the Wreake, but excluding Anglian/pre Anglian deposits of the so-called Proto-Soar or Bytham River. Mainly sand, gravel and mud; divided (in type area) into six principal \"terrace\" members (Eagle Moor, Knighton, Birstall, Wanlip, Syston, and Hemington members), plus Holocene alluvium (the Soar Member of Bowen, 1999). Includes contemporaneous head, colluvium and soil deposits. Gravel is generally dominated by \"Bunter\" pebbles and flints in roughly equal proportions, plus other components including Charnian material."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base on Anglian glacial deposits (Wolston Formation) or on pre-Quaternary bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c. 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TRWCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BISG ,
        namedrockunit:HETD ,
        namedrockunit:KNSG ,
        namedrockunit:SYSG ,
        namedrockunit:WASG ;
    skos:notation "SOARV"@en ;
    skos:prefLabel "Soar Valley Formation"@en ;
.

namedrockunit:SPC
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S702 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Speeton Clay Formation comprises mudstones, cementstones and sporadic bentonites. It was divided by Lamplugh (1889), into five units (E to A from the base up) related to belemnite content, and these divisions are still maintained.\r
E Bed: The basal bed comprises mainly phosphatic nodules with scattered rolled and fragmented, pyritised and phosphatised bivalves, ammonites and bone, and is usually referred to as the Coprolite Bed (Lamplugh, 1923). There is a marked break in the succession at the base of this bed and a less obvious one at its top. D Beds: Black shale is overlain by greenish-brown, brown and grey clays and includes the Blue Bed (D6), the Ligula Bed (D5), the Astarte Bed (D4) and the D3 Bed (un-named). A compound nodular bed (Bed D1) occurs at the top of the "D beds". A significant break in the succession occurs between Beds D2D and D2E. These beds are also historically known  as the Lateralis Beds (Lamplugh, 1923). C Beds: Alternations of pale and dark grey clays and shaley clays are characteristic of these beds. Nodules and glauconite occur at some levels. Includes the Main Speetonensis Bed (C6) and the Echinospatangus Bed (C3). Historically known also as the Jaculum Beds (Lamplugh, 1923). B Beds: A lower part of pale and dark grey and blue-grey clays with nodules and pyritous at some horizons passes upwards into the "Cement Beds" and into an upper succession of striped blue, black and grey clays with nodules. Historically known also as the Brunsvicensis Beds (Lamplugh, 1923). A Beds: Grey and brown calcareous clays passing up into glauconitic clays with nodules (the "Greensand Streak", Bed A7) and up into grey, red and mottled calcareous clays. Known as the "Ewaldi Marl" below and the "Minimus Marl" above the Greensand Streak (Lamplugh, 1923) (Ewaldi Beds and Minimus Marls of Rawson (1992) and Rawson and Wright (2000))."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where grey and black clays (the D Beds of the Speeton Clay Formation) on a thin, but prominent, pyritized and phosphatized basal bed (E Bed) rest on dark grey to black mudstones of the Kimmeridge Clay Formation, which has an eroded upper surface."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2439 ,
        namedrockunit:H2440 ,
        namedrockunit:H4897 ,
        namedrockunit:S702 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 100 m at outcrop, but possibly up to c. 400 m in boreholes [Rawson et al., 1978]."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is at a sharp contact where brown and grey-green, glauconitic and calcareous clays, with horizons of phosphatic nodules, that form the A Beds of the Speeton Clay are overlain by nodular and almost entirely red limestone (one bed near the base is white) of the Hunstanton Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Neocomian Strata [Obsolete: use SPC]"@en ,
        "Speeton Clay [Obsolete: use SPC]"@en ,
        "Speeton Series [Obsolete: use SPC]"@en ,
        "Upper Shale [Obsolete: use SPC]"@en ;
    skos:definition "Clay and mudstone with subsidiary calcareous mudstone and calcilutite. Stratified bedrock. Occurs onshore. Deposited during the Berriasian Age - to - Albian Age (Cretaceous Period) (143.1-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SPC"@en ;
    skos:prefLabel "Speeton Clay Formation"@en ;
.

namedrockunit:SSTV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone and siltstone, generally bituminous with significant subordinate units of silty sandstone, commonly muddy and glauconitic. At Brora, the overall thickness is about 55 m. The lowermost unit is the Brora Roof Bed - up to 2.3 m of bioturbated, shelly medium-grained sandstone with scattered quartzite pebbles and coal fragments. It is overlain by about 2.3 m of silty sand grading up into about 25 m of bituminous fissile mudstone with thin interbedded glauconitic sandstone beds. This is the Brora Shale Bed that, together with the Brora Roof Bed, makes up the Brora Shale Member (Arkell, 1933; Sykes, 1975). This is overlain by 10.1 m of coarsening-upwards glauconitic muddy and silty sandstones with a siltstone interbed - the Glauconitic Sandstone Member (Sykes, 1975), overlain by 15 m of bituminous sandy siltstone with mudstone intercalations; five fining-upwards cycles have been recognised - the Brora Brick Clay Member (Arkell, 1933; Sykes, 1975). The formation yields marine biota and marine microfossils throughout. The macrofauna is dominated by ammonites, belemnites, bivalves, brachiopods and gastropods (Cox and Sumbler, 2002, p.374) and dinoflagellate cysts are abundant and diverse (Riding, 2005). The sequence stratigraphy of the formation was interpreted by Stephen and Davies (1998)."@en ;
    lexicon:hasLowerBoundaryDefinition "The formation overlies the Brora Coal (Bed) of the Brora Coal Formation. The boundary is marked by a sharp planar lithological change where bioturbated medium-grained sandstone (the Brora Roof Bed) rests on the Brora Coal. The boundary appears to be erosional."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BRARG ,
        namedrockunit:H1382 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At the type section at Brora, the thickness of the formation is about 55 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a change up from the bituminous sandy siltstone with mudstone intercalations of the Brora Brick Clay Member to the coarse siltstone to silty fine-grained sandstone of the Fascally Siltstone Member of the Clynekirkton Sandstone Formation. The boundary is conformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brora Argillaceous Formation [Obsolete: use BALR, SSTV]"@en ,
        "Brora Argillaceous Series [Obsolete: use BRARG, SSTV]"@en ;
    skos:broader namedrockunit:SUTH ;
    skos:definition "Bituminous mudstone and siltstone with subsidiary silty sandstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BROBC ,
        namedrockunit:BROR ,
        namedrockunit:GLCSA ;
    skos:notation "SSTV"@en ;
    skos:prefLabel "Strathsteven Mudstone Formation"@en ;
.

namedrockunit:STAM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale greenish grey to yellowish and white, generally massive, fine-grained, generally friable, quartzose, unfossiliferous sandstone or siltstone, interpreted as mainly swamp and lacustrine, seen particularly in the upper part of the succession and in thicker successions as a sandy silty mudstone with plant debris, rootlets and thin lignite lenses, especially near the top, locally including interpreted lacustrine carbonaceous mudstones in hollows at the base and at the top."@en ;
    lexicon:hasLowerBoundaryDefinition "In the north, this junction is identified by a sandstone/siltstone/mudstone lithology, sharply and unconformably overlying an uneven channelled surface of marine ooidal limestones of the Lincolnshire Limestone Formation, commonly marked by a secondary limonitic 'Ironstone Junction Bed', and in a presumed narrow zone beyond the limit of the Lincolnshire Limestone-Kettering-Peterborough by similar sandstone, siltstone and mudstone sediments of the Grantham Formation, although in most of Northants, this boundary is seen as an ironstone or ferruginous sandstone of the Northampton Sand Formation or mudstones of the Lias Group, and across the London Platform subcrop the sediments overlie Palaeozoic strata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1201 ,
        namedrockunit:H3049 ,
        namedrockunit:H4345 ,
        namedrockunit:H976 ,
        namedrockunit:LFRSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 12m, but typically 4m to 5m thick, measured as 4.5 m in the type section."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the sandstone/siltstone/mudstone as above, often strongly rootletted or with more or less well-developed mudstone seatearth, generally sharply and erosively overlain by marine beds of typically mudstone or sandy mudstone of the succeeding rhythm."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brackish Water Beds [Obsolete: use STAM]"@en ,
        "Freshwater Beds [Obsolete: use STAM]"@en ,
        "Lower Freshwater Bed of Thompson, 1930 [Obsolete: use STAM]"@en ,
        "Lower Freshwater Sequence [Obsolete: use STAM]"@en ,
        "White Sands [Obsolete: use HYSA, STAM]"@en ;
    skos:broader namedrockunit:RLD ;
    skos:definition "Sandstone and siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STAM"@en ;
    skos:prefLabel "Stamford Member"@en ;
.

namedrockunit:STBA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Staffin Bay Formation is a succession of marine fissile mudstone and sandstone. A coarsening-upward trend is discernible from the dark grey, fissile mudstone with a shelly limestone bed, minor shell beds and laminated and rippled sandstones (the Upper Ostrea Member) being overlain by fine- to medium-grained bioturbated, carbonaceous sandstones with siltstones (the Belemnite Sands Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Formation in Trotternish is sharply-defined by the range base of dark-grey fissile mudstones with shell beds of the Upper Ostrea Member, which abruptly overlie the mottled green-grey-red clays of the Skudiburgh Formation. In Strathaird the base of the Staffin Bay Formation is also abrupt where the medium- to coarse-grained Carn Mor Sandstone Member sharply overlies the Skudiburgh Formation with a well-developed erosion surface."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2451 ,
        namedrockunit:H4346 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At the type section at Staffin Bay [NG 473 708], the formation is 15.95m thick and attains 19m in the wider Trotternish district (Hudson and Harris, 1979). The unit is significantly thinner to the south on Strathaird, where it is 9m (Sykes, 1975, p.68)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation in Trotternish is abruptly-defined; marked by a sharp facies change from the fine- to medium-grained sandstone of the Belemnite Sands Member to the bituminous fissile mudstones with thin glauconitic silts of the overlying Dunans Shale Member of the Staffin Shale Formation. In Strathaird, the uppermost surface of the Staffin Bay Formation is sharp, with a marked facies change from the medium- to coarse-grained sandstone of the Carn Mor Sandstone Member to the overlying silty clays of the Tobar Ceann Siltstone Member of the Staffin Shale Formation (Sykes, 1975, fig.6). The formation is unconformably overlain by extrusive rocks of the Paleocene Skye Lava Group in places."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Staffin Bay Beds [Obsolete: use STBA]"@en ,
        "Upper \"Ostrea\" Beds and Belemnite Sands [Obsolete: use STBA]"@en ;
    skos:definition "Mudstone, sandstone and siltstone with subsidiary limestone and trace shelly mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BSSK ,
        namedrockunit:CMSA ,
        namedrockunit:UOST ;
    skos:notation "STBA"@en ;
    skos:prefLabel "Staffin Bay Formation"@en ;
.

namedrockunit:STIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown clayey-sand matrix-supported diamicton with flint and sporadic chalk pebbles. Laminations are common."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal boundary of the Starston Till Member is abrupt and commonly erosional. The Member overlyies Bytham River (Bytham Catchment Subgroup) deposits at the stratotype locality, where a lithological change from sand and gravel to till can be observed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1205 ,
