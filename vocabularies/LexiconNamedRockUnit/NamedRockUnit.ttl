namedrockunit:CWPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite and semipelite, interbedded, thinly-banded, gneissose in part. Calcareous near base (dominantly calc-silicate beds). Also contains limestone unit in lower part (Rosehall Croft Limestone) and beds of calcareous semipelite near top. Locally migmatitic with quartz and leucotonalite veining."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen at type section due to Portsoy Shear Zone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DBCH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Probably 800m in coast section; may reach 1.5km around Cornhill."@en ;
    lexicon:hasUpperBoundaryDefinition "Lowest (white) limestone on western side of Old Hythe Bay."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cowhythe Gneiss [Obsolete: use CWPS]"@en ;
    skos:broader namedrockunit:DBCN ;
    skos:definition "Psammite and semipelite with subsidiary calcsilicate-rock, limestone and pelite and trace calcareous pelite and calcareous semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CWPS"@en ;
    skos:prefLabel "Cowhythe Psammite Formation"@en ;
.

namedrockunit:CYACK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GDM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GNL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Granodiorite, aphyric, pinkish-white, massive equigranular, medium- to coarse-grained, hornblende-/biotite-bearing rock. Separate mafic (more hornblende-rich) granodiorite body at southern end of main pluton. Detached white to pink, medium- to coarse-grained, xenolithic leucogranite body to south of main pluton. Minor granite veins throughout pluton."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4581 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/P> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Corrieyairack Granitic Complex [Obsolete: use CYACK]"@en ;
    skos:broader namedrockunit:ANHGR ;
    skos:definition "Granodiorite and trace granite, leucogranite, melagranodiorite and microgranite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Silurian Period - to - Devonian Period (443.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CYACK"@en ;
    skos:prefLabel "Corrieyairack Pluton"@en ;
.

namedrockunit:CYBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown to reddish-brown unbedded to very roughly bedded breccia, consisting of angular to subrounded pebbles and cobbles of Culm Sandstone in very poorly sorted gritty, clayey, sandy, silt. The clasts are mainly locally derived Culm Sandstone generally not exceeding 0.3m diameter; other clasts include vein quartz, chert and fossiliferous sandstone of Pilton Beds type. Unnamed unit of sand and clay mapped with Cadbury Breccia between Greenslinch (SS 969 035) and Hele (SS 999 030)."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Bude Formation or Crackington Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2735 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
