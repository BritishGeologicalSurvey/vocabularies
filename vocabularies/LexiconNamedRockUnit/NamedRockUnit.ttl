namedrockunit:SCPT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member is characterised by tabular beds of pale wackestone and calcisiltite. These beds, which can be cherty and pyritious, have gradational (locally dolomitised) boundaries with the interbedded black fissile, blocky claystones. 'Chondritiform' and Helminthoides burrows are common in the limestones. Inadunate crinoid lags and scattered ammonoids (Beyrichoceras or Bollandoceras) also occur, some preserved in a semi-buoyant resting position, with the venter resting on the former sea bed. Deposition was in a deep marine hemi-pelagic environment, but with periodic fine clastic and carbonate supply (gravitational)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the lowest black claystone, which is about 0.12m thick, overlying the fine-grained, pale mottled limestone (wackestone) of the Hodderense Limestone Formation at Scarlett Point [SC 2583 6633]."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3021 ,
        namedrockunit:SCLB ,
        namedrockunit:STH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "14m"@en ;
    lexicon:hasUpperBoundaryDefinition "This is not exposed, so the nature of the upper boundary is therefore unknown. The overlying succession comprises black hemipelagic mudstones of the Bowland Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Scarlett Beds [Obsolete: use SCPT]"@en ,
        "Scarlett and Strandhall Beds [Obsolete: use SCPT]"@en ,
        "Strandhall Beds [Obsolete: use SCPT]"@en ;
    skos:broader namedrockunit:BSG ;
    skos:definition "Limestone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCPT"@en ;
    skos:prefLabel "Scarlett Point Member"@en ;
.

