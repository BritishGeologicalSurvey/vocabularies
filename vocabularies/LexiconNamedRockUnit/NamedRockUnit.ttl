        "Bruce Upper Sands [Obsolete: use HUGI]"@en ,
        "Fulmar Formation"@en ,
        "Massive Sandstone [Obsolete: use HUGI]"@en ,
        "Sand/Shale Unit [Obsolete: use HUGI]"@en ,
        "Upper Beryl Sand [Obsolete: use HUGI]"@en ,
        "Young Upper Beryl Sandstone [Obsolete: use HUGI]"@en ;
    skos:broader namedrockunit:FLDN ;
    skos:definition "Mudstone, sandstone and siltstone and trace coal and conglomerate. Stratified bedrock. Occurs offshore. Deposited during the Bajocian Age - to - Oxfordian Age (Jurassic Period) (170.9-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HUGI"@en ;
    skos:prefLabel "Hugin Formation"@en ;
