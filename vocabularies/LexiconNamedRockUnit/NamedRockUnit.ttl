namedrockunit:NO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold phase sands and gravels that underlie the Northmoor or First Terrace of BGS Maps. Dominated by clasts of Middle Jurassic limestone, but also containing a small proportion of "Bunter" quartz/quartzite and a varying proportion of flint, the latter increasing downstream below the confluence with the River Ock near Abingdon. Terrace surface up to 3 m above modern alluvial floodplain, with Northmoor deposits extending beneath the alluvium of the latter ('Buried Channel'). Locally includes organic deposits of at least two phases (MIS 5?a and Late Glacial MIS 2). Locally, upper (c. 2 to 3 m ) and lower (c. 1 m) 'facets' have been recognized (1b  and 1a of BGS maps); these do not necessarily relate to the two phases of aggradation suggested by these organic beds. \r
\r
River terrace deposits. Late Pleistocene (MI Stage 5 to 2)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Jurassic bedrock, or very locally, on gravels of Summertown-Radley Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1089 ,
        namedrockunit:H2013 ,
        namedrockunit:H2957 ,
