namedrockunit:RSX
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Sands, sandy gravels, gravels, some being clayey. The gravel component is predominantly subangular flint with subordinate debris of chert, polished quartz grains and larger fragments of pebbly ferruginous sandstone derived from the Lower Cretaceous sequences to the north. Subrounded flint nodules are also present in places. Locally clayey and sandy silt and silty clay mask the sands and gravels, perhaps indicating preservation of overbank or aeolian deposits at the top of the fluvial cycle. \r
\r
The River Rother in Sussex has five aggradations above the alluvium. \r
\r
Pleistocene to Holocene (MIS pre-13 - 1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Incises bedrock or older superficial deposits."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S583 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Each terrace averages 4 m thick, reaching to 8 to 10 m locally."@en ;
    lexicon:hasUpperBoundaryDefinition "At surface or locally overlain by younger deposits including head."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sussex Rother Terrace Deposits [Obsolete: use RSX]"@en ;
    skos:broader namedrockunit:SXCAT ;
    skos:definition "Gravel, sand and sandy gravel with subsidiary clayey gravel and trace sandy silt and silty clay. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:RS1 ,
        namedrockunit:RS2 ,
        namedrockunit:RS3 ,
        namedrockunit:RS4 ,
        namedrockunit:RS5 ;
    skos:notation "RSX"@en ;
    skos:prefLabel "Sussex Rother Formation"@en ;
.

namedrockunit:SALS
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:UINO ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to brown rubbly, fine- to coarse-grained ooidal, peloidal and finely shell-detrital packstone to grainstone (Clypeus Grit Member), generally with very shelly and coarsely shell-detrital ooidal grainstone and packstone (Upper Trigonia Grit Member) at base."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformity: hardground capping various limestone members of Aston Limestone or Birdlip Limestone formations, or correlative disconformity on mudstone or sandstone formations of Lias Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1801 ,
        namedrockunit:H2407 ,
        namedrockunit:UINO ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Typically 10 to 15 m. Type section 13 m. Maximum c. 20 m (Colesbourne area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change from ooidal, peloidal and finely shell-detrital limestone to mudstone (Fuller's Earth Formation) in southwest or into fine- to medium-grained ooidal grainstone (Chipping Norton Limestone Formation) in northeast. Generally transitional, but locally marked by a hardground (Sumbler et al., 2000)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Stroud Formation [Obsolete: use SALS]"@en ,
        "Upper Inferior Oolite [Obsolete: use SALS]"@en ,
        "Upper Ragstones [Obsolete: use SALS]"@en ;
    skos:broader namedrockunit:INO ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CG ,
        namedrockunit:UTG ;
    skos:notation "SALS"@en ;
    skos:prefLabel "Salperton Limestone Formation"@en ;
.

namedrockunit:SAS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises silty and clayey sands, occasional clay ironstones, with cleaner quartz sands at the top. The Roxham Sand Member comprises grey and yellow-green, pyritic, silty sands with an indurated basal pebbly sandstone with phosphatic nodules and derived Kimmeridgian debris. Overlying this member the Runcton Member comprises green, glauconitic, clayey sands with abundant phosphatic nodules. The Mintlyn Member is formed of glauconitic, clayey, grey and green sands with bands and 'doggers' of brown weathering clay-ironstone and seams of phosphatic nodules (picking out erosion surfaces). A prominent band of phosphatic nodules occurs at the base of the Mintlyn Member. The Leziate Member comprises unconsolidated, moderately clean, pale grey (occasionally green, yellow or orange), fine-to-medium-grained, cross-bedded quartz sands with subordinate bands of silt or clay. Pyrite nodules are present and glauconite is locally abundant."@en ;
    lexicon:hasLowerBoundaryDefinition "The boundary is placed at the down-section change from sands, with a pebbly base, to mudstones of the Kimmeridge Clay Formation. An erosion surface separates the two formations."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:SNDS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "South of Gayton, the pebbly sands of the Carstone Formation overstep the silty, clayey and clean sands of the Sandringham Sands Formation, resting progressively on the Roxham and Runcton members, the Mintlyn Member and finally the Leziate Member. In northern Norfolk, the upper boundary is defined by the down-section change from the clayey sands (Dersingham Formation) to unconsolidated, generally clean quartz sands (Leziate Member, Sandringham Sands Formation). Beneath The Wash, the Leziate Member passes into the Claxby Ironstone Formation and the overlying Dersingham Formation passes laterally into the Tealby Formation (Gallois, 1994)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sandringham Sands [Obsolete: use DEB, SAS]"@en ;
    skos:definition "Sand with subsidiary clay, ironstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) - to - Valanginian Age (Cretaceous Period) (149.2-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LZB ,
        namedrockunit:MNB ,
        namedrockunit:RNB ,
        namedrockunit:RURO ,
        namedrockunit:RXB ;
    skos:notation "SAS"@en ;
    skos:prefLabel "Sandringham Sands Formation"@en ;
.

namedrockunit:SCB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone and siltstone with thin beds of non-marine limestone and dolomite; sandstone is subordinate; pattern of sedimentation both upward coarsening and upward fining cycles of non-marine origin."@en ;
    lexicon:hasLowerBoundaryDefinition "The conformable base of the formation lies in a transitional sequence from the Pittenweem Formation and is taken at the top the St. Andrews Castle Marine Band."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1804 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum thickness is about 670m in East Fife."@en ;
    lexicon:hasUpperBoundaryDefinition "The conformable top of the Formation lies in a transitional sequence up into the Pathhead Formation and is taken at the base of the West Braes Marine Band. This is slightly higher in the sequence than in the original definition, having been altered by Browne (1986, fig.2)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sandy Craig Beds [Obsolete: use SCB]"@en ;
    skos:broader namedrockunit:SYG ;
    skos:definition "Mudstone and siltstone with subsidiary basaltic tuff and sandstone and trace calcareous mudstone, coal, dolomitic limestone, limestone, nodular limestone (cornstone) and sapropelite. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BINS ,
        namedrockunit:GRNS ,
        namedrockunit:LYBC ,
        namedrockunit:LYF ,
        namedrockunit:ROAL ;
    skos:notation "SCB"@en ;
    skos:prefLabel "Sandy Craig Formation"@en ;
.

namedrockunit:SCR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:STRW ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Variable lithology comprising: fossiliferous argillaceous limestone (peloidal micrite and wackestone), calcareous mudstone, calcareous siltstone, calcareous medium-grained sandstone, calcareous concretions and ironstone. Peloidal limestones are locally cross-bedded."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable, or disconformable, at the abrupt upward transition from plant debris-rich, mudstone with plant rootlets, or cross-bedded sandstone of the upper part of the Cloughton Formation (Gristhorpe Member) and well laminated calcareous mudstone, or limestone of the Scarborough Formation (Bate, 1965, p.83; Parsons, 1977; Gowland and Riding, 1991; Powell et al., 1992)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GLSR ,
        namedrockunit:H4318 ,
        namedrockunit:SBL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 30 m in the type coastal section at Hundale Point [TA 026 949] Gowland and Riding, 1991); thins westward to between 9-14 m in the Hambleton Hills [SE 477 898] (Powell et al., 1992, p.46); at Yons Nab [TA 085 841] south of Scarborough it is only 3 m thick (Rawson and Wright, 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is disconformable, at the abrupt upward transition from grey shelly mudstone or shelly sandstone of the Scarborough Formation to cross-bedded sandstone with plant fragments of the lower part of the Scalby Formation (Moor Grit Member) (Bate, 1965, p.83; Parsons, 1977; Gowland and Riding, 1991; Powell et al., 1992)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grey Limestone Series [Obsolete: use SCR]"@en ,
        "Scarborough Limestone Series [Obsolete: use SCR]"@en ,
        "Scarborough Limestone [Obsolete: use SCR]"@en ,
        "Strangways Formation"@en ;
    skos:broader namedrockunit:RAG ;
    skos:definition "Calcareous siltstone, calcilutite and shelly sandstone with subsidiary shelly limestone and trace calcareous sandstone and micritic limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BRBY ,
        namedrockunit:CRG ;
    skos:notation "SCR"@en ;
    skos:prefLabel "Scarborough Formation"@en ;
.

namedrockunit:SDCAD
    a skos:Concept ;
    lexicon:hasLithology
