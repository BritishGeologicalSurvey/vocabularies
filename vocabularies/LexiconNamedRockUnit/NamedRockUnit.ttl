namedrockunit:CB
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:CBCA ,
        namedrockunit:LKNB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, medium- to fine-grained, predominantly bioclastic wackestone and packstone with sporadic peloids; generally and characteristically intensely bioturbated and consequently poorly bedded, although better bedded, commonly somewhat arenaceous units occur in places, particularly in the upper part. Generally bluish grey when fresh, but weathers to olive or yellowish brown. Thin argillaceous partings or interbeds of calcareous mudstone may occur."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, disconformable non-sequence: bioclastic limestone resting upon mudstone (and bioclastic ooidal limestones, locally) of the Forest Marble Formation (Wessex Basin and south Midlands), or mudstone of the Blisworth Clay Formation (East Midland Shelf east and north) or mudstone with minor sandstone beds of the Scalby Formation (Cleveland Basin)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1414 ,
        namedrockunit:H2664 ,
        namedrockunit:H2665 ,
        namedrockunit:H753 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c. 10.5 m (Page, 1989); thickest in Wessex Basin but more generally 2 to 4 m from Wiltshire to Yorkshire"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of succeeding Kellaways Formation or Cayton Clay Formation (in the Cleveland Basin); comprising mudstone, commonly shelly at base, resting generally sharply and conformably or non-sequentially on bioclastic limestone of the Cornbrash."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Abbotsbury Cornbrash Formation [Obsolete: use CB]"@en ,
        "Corn Brash [Obsolete: use CB]"@en ,
        "Cornbrash Formation and Cayton Clay Formation (Undifferentiated)"@en ,
        "Cornbrash Limestone Member [Obsolete: use CB]"@en ,
        "Cornbrash [Obsolete: use CB]"@en ,
        "Leckenby Formation"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Limestone with subsidiary calcareous mudstone and calcareous sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LCB ,
        namedrockunit:UCB ;
    skos:notation "CB"@en ;
    skos:prefLabel "Cornbrash Formation"@en ;
