namedrockunit:CDUBH
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The breccia matrices consist of finely comminuted, unbedded sedimentary rocks. Fragments of siltstone and sandstone, from the lower members of the Torridonian succession, form the majority of the clasts. There is little conclusive evidence that the fragments had been affected by thermal metamorphism prior to incorporation in the breccias; rarely, very thin, fine-grained dusty films separate quartz and feldspar grains. A thermal overprint is, however, apparent in breccias and tuffs near to the gabbros and ultrabasic rocks at the eastern end of Cnapan Breaca [NM 395 975]. \r
\r
Several occurrences of fragmental rocks originally identified as tuffisite sheets are now interpreted as tuffs in the Coire Dubh Breccias or interbedded with rhyodacite ash flows (e.g. Dunham, 1968, fig. 1)."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RUSM ;
    skos:definition "Volcaniclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CDUBH"@en ;
    skos:prefLabel "Coire Dubh Breccias"@en ;
.

namedrockunit:CDVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FTUFF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Coed Duon Volcanic Formation comprises around 60m of green, fine-grained felsic tuff with abundant mafic crystal and rhyolitic lithic clasts, locally overlain by around 15m of white-weathering, fine-grained, pink rhyolite."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type area, the Formation rests conformably upon pale grey, thin- to thick-bedded arkosic sandstone of the Ffairfach Grit Formation. The lower boundary is not exposed but is taken at the incoming of green, tuffaceous beds, constrained near the summit of Coed Duon."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Around 75m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Formation is conformably overlain by buff-weathering, thinly interbedded sandstone, siltstone and limestone of the Llandeilo Flags Formation. The upper boundary is not exposed but is taken at the top of the last outcrop of pale rhyolite or tuff."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasYoungestAgeValue 4.6125e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Felsic tuff with subsidiary rhyolite. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage (Ordovician Period) (468-461.25 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "CDVO"@en ;
    skos:prefLabel "Coed Duon Volcanic Formation"@en ;
.

