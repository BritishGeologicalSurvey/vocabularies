    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3 - 7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Fairly abrupt change to sandy clays and clayey sands of the Sandsfoot Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clavellata Beds Formation [Obsolete: use CLAV]"@en ,
        "Trigonia Clavellata Beds [Obsolete: use CLAV]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Ooid-limestone with subsidiary calcareous mudstone and sand and trace limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:ECC ;
    skos:notation "CLAV"@en ;
