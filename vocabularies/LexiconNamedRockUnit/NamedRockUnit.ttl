namedrockunit:KMGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/L"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A glacigenic sequence of till (sandy, gravelly clay with cobbles and boulders) and laminated silt and clay separated by variably continuous lenses or beds of sand and gravel. Erratics are dominated by Carboniferous rocks and Lake District and Irish Sea derived bedrock."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable and locally deeply incised contact with bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4732 ;
