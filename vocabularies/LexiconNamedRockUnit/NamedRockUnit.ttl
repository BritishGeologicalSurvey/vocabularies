namedrockunit:GAC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk), with flints ranging from small nodular at the base through nodular to tabular flints in the middle part of the sequence to massive nodular at the top. The Formation can be divided into four \"Beds\" (A to D) by subdivision on bedding planes. In the North Antrim Basin the Formation includes two well-developed hardgrounds, the North Antrim Hardgrounds (of member? status) and the sequence is therefore incomplete. In the Midland Valley (East Antrim) Basin only limited wavy bedding and scattered green glauconitised pebbles indicate interrupted sedimentation. This area is regarded as the \"standard\"."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is delimited by a prominent weathered-out bedding plane immediately above the Altachuile Breccia (Bed) of the Ballintoy Chalk Formation. Brecciated chalk overlain by a thick limestone unit forming the base of the Glenarm Chalk Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3413 ,
        namedrockunit:H920 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "8.10m at the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is the weathered-out bedding plane that separates chalk with small tabular flints below from conspicuously shelly wavy-bedded chalk at the base of the conformable Garron Chalk Formation, above."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glenarm Chalk Member [Obsolete: use GAC]"@en ,
        "Glenarm Chalk [Obsolete: use GAC]"@en ;
    skos:broader namedrockunit:UWLF ;
    skos:definition "Chalk and limestone with subsidiary flint. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GAC"@en ;
    skos:prefLabel "Glenarm Chalk Formation"@en ;
.

namedrockunit:GAL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Garsdale Limestone Formation comprises dark grey biomicrosparites to porcellanous micrites (wackestone with bands of porcellaneous calcilutite) with interbedded sandstone and siltstone, numerous thin mudstone beds and rare thin coals. Three coal seams, up to 0.07 m thick, occur in the Beckermonds Scar Borehole (see below). Minor fenestral and palaeokarst surfaces occur. The formation contains the equivalent of Garwood's (1913) Bryozoa Band. \r
\r
Shallow marine carbonates (with some intertidal deposits). Late Holkerian to early Asbian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The conformable base of the formation overlies the mid to dark grey limestones of the Fawes Wood Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HTNL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is 41-58 m thick (Dunham and Wilson, 1985)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is conformable beneath the pale to mid grey limestone of the Danny Bridge Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Horton Limestone [Obsolete: use FWL, GAL]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary mudstone, sandstone and siltstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SCSL ;
    skos:notation "GAL"@en ;
    skos:prefLabel "Garsdale Limestone Formation"@en ;
.

