namedrockunit:CMMU
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fissile bluish black \"shales\", locally characterized by white, silty laminations and closely spaced vertical joints, particularly in higher horizons. Siliceous nodules become common in the upper part. The formation is unfossiliferous apart from ?wood fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of bluish black and black mudstones of the Combe Mudstone Formation above the olive green and pale grey mudstones of the underlying Trusham Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CMSH ,
        namedrockunit:H144 ,
        namedrockunit:H2103 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "45m in the Ilsington area, thickening northwards to 90-200m in the Teign valley area."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of interbedded cherts and siliceous mudstones of the overlying Teign Chert Formation above the bluish black and black mudstones of the Combe Mudstone Formation. The boundary is taken at the base of the first bedded chert."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Combe Formation [Obsolete: use CMMU, CMSH]"@en ,
        "Combe Shale Formation [Obsolete: use CMMU]"@en ,
        "Combe Shale [Obsolete: use CMMU]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CMMU"@en ;
    skos:prefLabel "Combe Mudstone Formation"@en ;
.

