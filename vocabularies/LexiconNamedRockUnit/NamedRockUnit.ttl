        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Flaggy, laminated feldspathic psammite and micaceous psammite with minor bands of schistose semipelite; quartzite locally important."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable and transitional with Kincraig Formation but poorly exposed. Marked by change to dominantly psammite."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "500m to 1km."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable transition up into more siliceous and feldspathic psammites of the Glen Spean Subgroup south of the Cairngorm Mountains."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Flaggy psammite, micaceous psammite, psammite and semipelite with subsidiary quartzite and trace calcsilicate-rock. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COYB"@en ;
    skos:prefLabel "Coylumbridge Formation"@en ;
