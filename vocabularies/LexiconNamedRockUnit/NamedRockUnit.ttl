namedrockunit:DECO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pebbly and cobbly, well-rounded, clast-supported conglomerate of lava, psammite, quartzite and feldspar-porphyry in a matrix of poorly-sorted, fine- to medium-grained lithic sandstone, commonly with lenses of trough cross-bedded pebbly sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is placed at the top of a thick succession of andesitic lavas of the Montrose Volcanic Formation where this is conformably and somewhat diachronously overlain by a massive clast-supported conglomerate, above which it passes laterally into, and interfingers with, sandstone of the Tannadice Sandstone Member of the Scone Sandstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 880 m thick in the type area, passing laterally into sandstone of Tannadice Sandstone Member towards the south-west."@en ;
    lexicon:hasUpperBoundaryDefinition "A clast-supported conglomerate conformably, somewhat diachronously and locally interfingered with the base of a red, massive or laminated, poorly-sorted siltstone of the Cromlix Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ATGK ;
    skos:definition "Conglomerate with subsidiary andesite and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DECO"@en ;
    skos:prefLabel "Deep Conglomerate Formation"@en ;
.

