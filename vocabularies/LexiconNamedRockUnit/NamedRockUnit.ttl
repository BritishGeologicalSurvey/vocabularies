namedrockunit:PAL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone and dolostone, fine-grained grainstone and packstone, dark grey to buff, wavy bedded, interbedded with sandstone, siltstone and mudstone. The limestone lacks the common occurrence of corals typical of the overlying Coupland Sike Limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Member coincides with the top of the \"Algal Layer\" (Coldbeck Limestone Formation) in the Ravenstonedale area."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "50-75m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top occurs beneath the more regularly bedded and fossiliferous overlying Coupland Sike Limestone Member. The junction is marked by a 5m interbedded sandstone and mudstone unit that forms a topographical depression."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SCBL ;
    skos:definition "Dolostone and limestone with subsidiary mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Arundian Substage (Carboniferous Period) (346.7-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PAL"@en ;
    skos:prefLabel "Park Hill Limestone Member"@en ;
.

