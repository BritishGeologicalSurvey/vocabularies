namedrockunit:FESP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Graded psammite, laminated psammite and micaceous psammite with bands of semipelite to pelite. Interpreted as an originally turbiditic succession."@en ;
    lexicon:hasLowerBoundaryDefinition "Not interpreted to date but taken as the top of the Ord Ban Subgroup (Sheet 74E), where the semipelite, metacarbonate, calc-silicate, quartzite and amphibolite succession is overlain by interbedded psammite, semipelite and pelite belonging to the Feshiebridge Psammite Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4042 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "possibly 0.5 to 2km"@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of the predominantly semipelite succession at the base of the Falls of Phones Semipelite Formation, above the interbedded psammite and pelite succession of the Feshiebridge Psammite Formation"@en ;
