    skos:broader namedrockunit:MANX ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series (Ordovician Period) (486.5-477.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GLDH"@en ;
