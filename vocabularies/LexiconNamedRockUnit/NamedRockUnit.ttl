namedrockunit:DORA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, poorly-bedded garnet mica semipelite and muscovite-quartz semipelite, poor in biotite but with abundant quartz sweats. Typically weathers darker grey/brown to brown than the older Coire Daingean Formation; semipelites of the Beinn Dorain Formation are commonly steely grey on fresh surfaces and may take on a \"knotted\" appearance where conspicuous garnet is wrapped by phyllosilicates. Garnets are typically 3 to 4mm in diameter and always appear fresh (dark red) compared to the more commonly chloritised garnets in the Coire Daingean Formation. Magnetic susceptibility is twice that of the Coire Daingean semipelite (<0.5 cf. <0.2 mu)."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt change from the alternating muscovite-rich semipelite, psammite and quartzite of the Beinn an Dothaidh Formation to the more uniform garnetiferous semipelite rocks of the Beinn Dorain Semipelite Formation. The uppermost parts of the Beinn an Dothaidh Formation are dominantly quartzite in the area around Beinn a' Chuirn (Allt a'Chuirn Quartzite Member)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasOldestAgeValue 7.2e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Minimum c.130-150m."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasYoungestAgeValue 6.35e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Garnet semipelite. Stratified bedrock. Occurs onshore. Deposited during the Cryogenian Period (Precambrian) (720-635 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DORA"@en ;
    skos:prefLabel "Beinn Dorain Semipelite Formation"@en ;
.

