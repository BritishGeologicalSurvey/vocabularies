namedrockunit:LWF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QWACKE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly sandstone with minor mudstone and quartz-rich greywacke. Basal beds are mainly thin, fine-grained sandstones interbedded with siltstones and mudstone. Bed thickness increases towards the middle of the Formation. Bed thickness decreases through the upper part of the Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The boundary is gradational with the underlying Hope Beck Formation and crops out on the east side of Dodd (NY 171 233). Jackson (1961) used \"the presence of arenites 3 inches or more in thickness\" as the criterion for separating the two units."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GTSK ,
        namedrockunit:H1674 ,
        namedrockunit:H4174 ,
        namedrockunit:REN ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "900m in the northwest Lake District; 450m around Jonah's Gill [NY 190 343]; unknown in faulted inlier at Mungrisdale."@en ;
    lexicon:hasUpperBoundaryDefinition "In a small quarry on Whiteside End [NY 1660 2169] bedding thickness reduces rapidly and the proportion of mudstone increases forming a laminated facies of sandstone and mudstone with sporadic thin beds of quartz-rich greywacke. The top of the Formation is taken at the highest thin sandstone bed in the dominantly sandstone part of the succession."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grits in Skiddaw Slates [Obsolete: use SKG, LWF]"@en ,
        "Loweswater Flags [Obsolete: use LWF]"@en ,
        "Redmain Formation [Obsolete: use LWF]"@en ,
        "Skiddaw Grits [Obsolete: use LWF]"@en ;
    skos:broader namedrockunit:SKG ;
    skos:definition "Quartz-wacke, sandstone and wacke with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LWF"@en ;
    skos:prefLabel "Loweswater Formation"@en ;
