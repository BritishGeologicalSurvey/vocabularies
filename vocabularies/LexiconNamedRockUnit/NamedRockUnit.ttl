namedrockunit:WML
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Wackestones and packstones, pale blue-grey, thin-bedded, bioclastic, fine-to coarse-grained, graded, often erosive-based and containing intraformational lithoclasts, interbedded with similar amounts of pale blue-grey calcareous mudstone, commonly platy and blocky."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is defined at the base of the first pale blue-grey wackestones of the Whitemore Limestone Member overlying conformably the dark grey mudstones of the Phynis Mudstone Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 80 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Whitewell Anticline, taken at the base of the dark grey blocky mudstone interbedded with thin wackestones of the Leagram Mudstone Member, overlying conformably the pale blue-grey wackestones and packstones of the Whitemore Limestone Member. In the Slaidburn Anticline, the limestones of the Whitemore Limestone Member are overlain by non-micaceous, laminated mudstones interbedded with laminated calcisiltites of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HOM ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WML"@en ;
    skos:prefLabel "Whitemore Limestone Member"@en ;
.

namedrockunit:WMLO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A terrace deposit of the Sudbury Formation in the Valley of the Upper Thames upstream of Oxford. The oldest fluvial unit yet identified in the Sudbury Formation of the Upper Thames, although scattered pebbles of Northern Drift type occur at higher elevations (over 300 m OD) in the north Cotswolds. \r
\r
Quartzite and quartz gravel in a clay matrix. It is characterised by a particularly high ratio of quartz to quartzite pebbles and possibly equates with the Westland Green Member downstream (Hey, 1986)."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SBRY ;
    skos:definition "Gravel with subsidiary clay and quartzite. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WMLO"@en ;
    skos:prefLabel "Waterman's Lodge Sand and Gravel Member"@en ;
.

