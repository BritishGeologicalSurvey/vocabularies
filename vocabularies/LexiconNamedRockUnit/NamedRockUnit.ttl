namedrockunit:LUMG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brick-red, fine-grained microgranite with a saccharoidal, quartzo-feldspathic groundmass in which are set larger idiomorphic plagioclase crystals. Plagioclase and lath-shaped chlorite form c.2mm size phenocrysts; the latter are concentrated in the central part of the intrusion, where they comprise up to 15% of the rock."@en ;
    lexicon:hasLowerBoundaryDefinition "Not applicable, but the microgranite occupies a northwest-trending subvertical sheet, up to 9m wide, the actual contacts being obscured by vegetation. It is emplaced into grey, cleaved, thinly bedded to laminated volcaniclastic strata of the Charnian Supergroup (Ives Head Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasOldestAgeValue 4.869e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "c.9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not applicable. (see Lower Boundary discussion.)"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Microgranite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ordovician Period (486.9-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "LUMG"@en ;
    skos:prefLabel "Lubcloud Microgranite"@en ;
.

