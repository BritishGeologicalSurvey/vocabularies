    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not  known."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable with the Overwood Slate Member of the Liddaton Formation. Transition noted by change from grey/green shales of Stourscombe Formation to the greenish grey silty slate of the Overwood Slate Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
