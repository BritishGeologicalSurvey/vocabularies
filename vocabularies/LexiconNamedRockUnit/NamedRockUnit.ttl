namedrockunit:HMTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, reddish brown, matrix-supported sandy clay diamicton, with well dispersed angular to subrounded clasts up to boulder size. The clasts are mainly of red sandstone, Skiddaw Group slate, Borrowdale Volcanic Group rocks, Coal Measure sandstone, coal, limestone, ironstone, dolomite, grey ?Criffel granite, granophyre, granodiorite, quartzite, vein quartz, andesite and shell fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally planar or undulating contact on to older units including the top of the Gutterfoot Sand Member of the Gosforth Glacigenic Formation, the top of the Townhead Boulder Gravel Member, and the top of the Ravenglass Till Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4662 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To c.1.7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Erosional base of the Peel Place Sand and Gravel Member of the Gosforth Glacigenic Formation or overlain by Holocene deposits such as blown sand or peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Boulder Clay [Obsolete: use FWTI, GOGL, HMTI, PKSA, PLBT, RSTI, STPTG]"@en ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HMTI"@en ;
    skos:prefLabel "How Man Till Member"@en ;
.

