namedrockunit:HFFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "One to two bluish grey, weathering yellowish brown, silty, slightly sandy, shelly limestone beds 0.02 to 0.8 m thick, separated by mudstone (0.35m thick in type section). Both limestone and mudstone contain pyritic shells and debris and the limestones include much amorphous pyrite. Fauna includes bivlaves (including common pectiniids and numerous Gryphaea), ammonites, belemnites, ostracods and echinoderms. Forms a weak feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey mudstone with small phosphatic nodules and ammonites, and large limestone nodules of the undifferentiated Foston Member; at 13.11 m depth in type section Fulbeck Airfield Borehole (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3466 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.1 to 1.5 m; 0.52 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey mudstone of the undifferentiated Foston Member; at 12.59 m depth in type section Fulbeck Airfield Borehole (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Highfield Farm Limestone [Obsolete: use HFFL]"@en ;
    skos:broader namedrockunit:FSTL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HFFL"@en ;
    skos:prefLabel "Highfield Farm Limestones Bed"@en ;
.

