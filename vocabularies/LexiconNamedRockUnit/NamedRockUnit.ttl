namedrockunit:LMPL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Lamplugh Formation consists of chalky limestones which are typically white to grey, soft to moderately hard, commonly argillaceous and characteristically chert-bearing. The presence of chert (flint) bands throughout the unit is a characteristic feature."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the Lamplugh Formation is characterized by a downward change from moderately hard, chalky limestones to the harder, clean, micritic limestones of the Herring Formation. There is a corresponding downhole decrease in gamma ray and increase in sonic velocity responses."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Lamplugh Formation ranges up to 200 m (e.g. well 49/25-1)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Lamplugh Formation is marked by a downward change from the chalky limestones of the Jukes Formation into harder, more argillaceous chalks. It is marked by a sharp downward increase in velocity accompanied in some sections by a slight increase in gamma-ray values e.g. 49/24-1. In some wells the mid-part of the Lamplugh Formation is particularly argillaceous (e.g. well 42/29-C01; 53/4-2) giving the log profiles a 'waisted' appearence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KO> ;
    lexicon:hasYoungestAgeValue 8.57e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CK ;
    skos:definition "Limestone with subsidiary chert. Stratified bedrock. Occurs offshore. Deposited during the Turonian Age - to - Coniacian Age (Cretaceous Period) (93.9-85.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LMPL"@en ;
    skos:prefLabel "Lamplugh Formation"@en ;
.

