    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Unknown - at least 15m proved in boreholes around Llandeloy."@en ;
    lexicon:hasUpperBoundaryDefinition "Unknown - unconformably overlain by mudstones and sandstones of the Solva Group (Cambrian)"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
