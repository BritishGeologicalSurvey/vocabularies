        "Brownstones [Obsolete: use BRS]"@en ,
        "Clee Formation [Obsolete: use CFO]"@en ,
        "Clee Group [Obsolete: use CFO, WBK]"@en ,
        "Senni Formation"@en ;
    skos:definition "Obsolete name. Sandstone and siltstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CFO"@en ;
    skos:prefLabel "Clee Sandstone Formation [Obsolete: use SB]"@en ;
