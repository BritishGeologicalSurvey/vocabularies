namedrockunit:PMR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A yellow, cross-bedded sandstone, with subordinate mudstone.  Pebbly sandstone noted at the base of the unit at Bradley Hall Colliery, Standish borehole SD51SE/53."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is believed to be partly erosional.  The base is taken at a sharp, well-defined surface which is erosional in parts, seperating mudstones below the boundary and sandstones and pebbly sandstones above the boundary.  The base is taken at the base of the first sandstone-dominated unit above the higher Florida Coal in the Runcorn [SJ 50 80] and the south Wigan [SD 00 60] areas, and the base of the first sandstone unit above the Pemberton 5' Coal in the North Wigan [SD 60 10] area, and the base of the first sandstone unit above the Bargain Delf Coal at Bradley Hall Colliery (SD 5730 1106)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasOldestAgeValue 3.18e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Up to 61 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the base of the mudstone, coal and fireclay-dominated succession of the Pennine Middle Coal Measures Formation above sandstones of the Pemberton Rock"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasYoungestAgeValue 3.1475e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PMCM ;
    skos:definition "Sandstone with subsidiary mudstone and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Duckmantian Substage (Carboniferous Period) (318-314.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PMR"@en ;
    skos:prefLabel "Pemberton Rock"@en ;
.

namedrockunit:PMSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Partially dolomitised, sandy,skeletal packstone in lower part, and thin-bedded, cross bedded fine-grained calcareous sandstone in upper part.  Represents transgressive shoreface deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp contact, defined by a palaeokarstic surface, between the calcite mudstones and skeletal/peloidal/ooid packstone/grainstones of the underlying Stormy Limestone Formation and the overlying, partially dolomitised, sandy skeletal packstones and calcareous sandstones of the Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1.5 to 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp junction at the top of the calcareous sandstones of the Member and the overlying thick-bedded, fine- to coarse-grained , mottled and pseudobrecciated skeletal packstones of the remainder of the Oxwich Head Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:OHL ;
    skos:definition "Calcareous sandstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PMSA"@en ;
    skos:prefLabel "Pant Mawr Sandstone Member"@en ;
.

