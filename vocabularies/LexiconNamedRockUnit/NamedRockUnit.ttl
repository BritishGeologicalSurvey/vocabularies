    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AP> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Feldspathic gneiss of Strathy [Obsolete: use MSC]"@en ;
    skos:definition "Gneiss and trace calcsilicate-rock, gneissose semipelite, magnetitite, marble, metapyroxenite, ortho-amphibolite, quartz-garnet-magnetite-rock and semipelite. Bedrock. Occurs onshore. Formed during the Proterozoic Eon (Precambrian) (2500-541 Ma BP)."@en ;
