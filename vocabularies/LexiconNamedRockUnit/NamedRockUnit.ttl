        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cream, brown and grey, fine-grained dolostone with grey, fine-grained limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Typically sharp, taken at the incoming of dolostone and limestone above the laminated, bituminous, silty, argillaceous dolostone of the Marl Slate Formation and, where this is absent, either above the aeolian Yellow Sands Formation or unconformably on Carboniferous (usually Coal Measures ) strata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4300 ,
        namedrockunit:LML ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "48m at type locality; ranges from 20 to 40m but, locally up to 73m in east Durham."@en ;
    lexicon:hasUpperBoundaryDefinition "At the incoming of oolitic and pisolitic or equivalent reef dolostone of the Ford Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
