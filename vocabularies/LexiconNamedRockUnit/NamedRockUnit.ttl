    lexicon:hasThicknessDescription "c. 2.5m - 3.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sub horizontal planar unconformable (?locally glacitectonic) contact with the the base of the Fishgarth Wood Till Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
