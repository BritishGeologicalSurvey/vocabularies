namedrockunit:BHHB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pink, aphanitic, flow-banded rhyolite of flinty appearance with platy weathering. In thin section: cryptocrystalline, non-porphyritic, with no sign of fluxion or perlitic structures typical of higher rhyolites. The rhyolite is underlain locally by a thin conglomerate with subangular clasts of sandstone, chert and sporadic basic lava. Conglomerates are also intercalated with the rhyolite. At the top of the rhyolites sedimentary lenses are developed, consisting of bedded grey-green or purple micaceous sandstone with grains of quartz and microgranite, interbedded with conglomerates containing well-rounded greywacke, siltstone, microgranite and quartzite pebbles and angular rhyolite, microgranite, basalt and andesite pebbles derived from older lavas."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable: first appearance of pink flow-banded rhyolite unconformably overlying basalt and andesite flows of Bonaly Volcanic Member and thin conglomerates of the Greywacke Conglomerate Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1355 ,
        namedrockunit:H3849 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasOldestAgeValue 4.227e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "315m maximum."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable: pink flow-banded rhyolite overlain by fine-grained basalt of the Capelaw Volcanic Member in the north. Overlain in the south by micaceous sandstones and conglomerates of the Greywacke Conglomerate Formation, and by andesites and basalts of the Allermuir Volcanic Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bell's Hill and Howden Burn Group [Obsolete: use BHHB, TDH]"@en ,
        "Bell's Hill and Howden Burn Volcanic Formation [Obsolete: use BHHB]"@en ;
    skos:broader namedrockunit:PDH ;
    skos:definition "Rhyolite with subsidiary basaltic-andesite, conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Pridoli Epoch (Silurian Period) - to - Lochkovian Age (Devonian Period) (422.7-412.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHHB"@en ;
    skos:prefLabel "Bell's Hill Volcanic Member"@en ;
.

