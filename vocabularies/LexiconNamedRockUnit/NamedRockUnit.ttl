namedrockunit:PESG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S324 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically comprises a unit of horizontally bedded, red, fine-grained sand with beds of silt, clay, coarse sand and fine gravel, overlain by a more laterally extensive unit of gravel, coarseing upwards and locally cemented. Beds of red and grey diamicton may occur throughout, representing intercalation with underlying and overlying tills. Clasts are mainly limestone and dolostone from the upper divisions of the Zechstein Group (fprmerly Magnesian Limestone), together with Carboniferous lithologies, Cheviot andesite and sparse shell fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, erosional and forming broad depressions on underlying dark grey, stony silty sandy clay diamicton of the Blackhall Till Formation. Lower unit mainly restricted to depressions whereas the upper unit commonly oversteps directly onto the Blackhall Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1116 ,
        namedrockunit:H4253 ,
        namedrockunit:S324 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 22m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally planar, subhorizontal contact with overlying dark brown to purplish brown, stony silty sandy clay diamicton of the Horden Till Formation. Contacts may be sharp or gradational with glacitectonic intercalation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Sands [Obsolete: use PESG, STPTG]"@en ,
        "Peterlee Member [Obsolete: use PESG]"@en ,
        "Peterlee Sands [Obsolete: use PESG]"@en ;
    skos:broader namedrockunit:NSG ;
    skos:definition "Sand with subsidiary gravel and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RHYS ;
    skos:notation "PESG"@en ;
    skos:prefLabel "Peterlee Sand And Gravel Formation"@en ;
