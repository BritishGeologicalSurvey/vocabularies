namedrockunit:BBA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FELSFO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sheets of massive, unbedded, poorly sorted, generally lithic-rich welded lapilli-tuff of andesitic and rhyolitic composition; interbedded volcaniclastic sandstone, siltstone, pumice lapilli-tuff and accretionary lapilli-tuff. Contains the rhyolitic welded lapilli-tuff (Seascale Hall Member) and, in BH RCF1, a rhyolitic lava flow or lava-like tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "At the change from coarse, eutaxitic, fiamme-rich lapilli tuff at the top of the Bleawath Formation to generally lithic-rich sequence above. Various members of the Formation overlap on to the top of the Bleawath Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1967 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "255.55m in Type Section (355.5m in core because of andesite sill); 188m in Sellafield BH No.2; 127m in Sellafield BH No. 4; 45m in Sellafield BH No.5."@en ;
    lexicon:hasUpperBoundaryDefinition "At the upward change from the generally lithic-rich sequence to homogeneous andesitic welded tuff of the Fleming Hall Formation."@en ;
