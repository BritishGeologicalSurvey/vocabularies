namedrockunit:TRCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Maastrichtian chalks have become known informally as the Trimmingham Chalk and are described in glacially deformed 'erratics' (of considerable size) on the coast between Overstrand and Trimmingham. A number of units were given names of informal member status in Johansen and Surlyk (1990). All of the succession was investigated in the Trunch Borehole (TG 23 SE/8) [TG 2933 3455] that was published in the Great Yarmouth Memoir (Arthurton et al., 1994). No firm conclusion has been reached regarding formal nomenclature for these beds since their distribution under a thick Quaternary cover has not been determined. Mortimore et al. (2001) give a comprehensive review of the Trimmingham and Norfolk chalks in Norfolk. It is recommended that reference to these units be made informally using the Trimmingham Chalk term until they can be more formally attributed."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KM> ;
    lexicon:hasOldestAgeValue 7.22e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KM> ;
    lexicon:hasYoungestAgeValue 6.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WHCK ;
    skos:definition "Chalk with subsidiary flint. Stratified bedrock. Occurs onshore. Deposited during the Maastrichtian Age (Cretaceous Period) (72.2-66 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TRCK"@en ;
    skos:prefLabel "Trimmingham Chalk"@en ;
.

