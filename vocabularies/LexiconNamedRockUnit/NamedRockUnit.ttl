    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "250 metres at type section (possibly incomplete due to faulting); increases southwards to approx. 1400 metres around Kildrummy Castle (NJ 455 164); decreases northwards to approx. 100 metres near Boghead (NJ 521 278)."@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional, marked by incoming of rhythmically graded siltstone/sandstone units, disappearance of conglomerate bands, and lightening of colour."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
