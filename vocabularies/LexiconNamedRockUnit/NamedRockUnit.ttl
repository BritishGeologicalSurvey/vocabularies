namedrockunit:HERS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Hermod Sandstone Member consists of clean, very fine to medium grained sandstone displaying distinctive 'blocky' log profiles. Thin intercalations of dark grey fissile mudstone are also present."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Hermod Sandstone Member is taken at a downward change to mudstone, associated with an increase in gamma-ray values and a decrease in sonic velocity. Where the underlying Teal Sandstone Member (Sele unit 1) is thin (e.g. 10/1-1A ), the Hermod Sandstone Member rests on sandy mudstones that probably represent unit S2b (refer to Sele Formation); where the Teal Sandstone Member is thicker (e.g. 10/1-3), only a thin, high-gamma mudstone separates it from the underlying Teal Sandstone Member, possibly reflecting condensation over a mounded Teal Sandstone topography."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "It is generally less than 100 m thick in the UK sector."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Hermod Sandstone Member is taken at a downward change from mudstone to sandstone, associated with a decrease in gamma-ray values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasYoungestAgeValue 3.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SELE ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Eocene Epoch (Palaeogene Period) (56-33.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HERS"@en ;
    skos:prefLabel "Hermod Sandstone Member"@en ;
.

