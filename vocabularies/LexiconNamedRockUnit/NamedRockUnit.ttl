.

namedrockunit:MM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red marl (calcareous mudstone and siltstone) with thin beds of fossiliferous marine limestone and dolomite; locally green; sandy in places especially in top part; local breccias and pebbly beds. (Tonks and others, 1931, p.165; Taylor and others, 1963, p.53)."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable upward change from red sandstones (Collyhurst Sandstone) into red marls; a pebbly bed was included in the base of the Manchester Marls at Stockport by Taylor and others, 1963, p.53."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4196 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "45 - 60m in Manchester; more in Stockport; dies out west of St. Helens."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable upward passage into red sandstones of the Sherwood Sandstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Manchester Marl [Obsolete: use MM]"@en ;
    skos:broader namedrockunit:CCO ;
    skos:definition "Calcareous mudstone with subsidiary breccia, dolostone and limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:FRSA ;
    skos:notation "MM"@en ;
    skos:prefLabel "Manchester Marls Formation"@en ;
.

namedrockunit:MMMF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Variable, typically consisting of conglomerate and/or breccia with clasts derived locally from rocks lying immediately below the unconformable base of these deposits. The matrix generally consists of finer-grained rock fragments or, less commonly, siltstone, sandstone or micritic limestone. Where these deposits overlie Carboniferous limestones, such as in the Bristol and Mendip areas, both the matrix and limestone clasts are commonly dolomitized (\"Dolomitic Conglomerate\"). Individual clasts can range up to several cubic metres in size. Fenestral and algal carbonates interdigitate with conglomerates and breccias in exposures to the south of Cardiff (Tucker, 1977; Waters and Lawrence, 1987)."@en ;
    lexicon:hasLowerBoundaryDefinition "Markedly unconformable, at the abrupt base of conglomerates of the Marginal Facies, which infill a buried topography on Palaeozoic or late Proterozoic rocks of variable lithology."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DCG ,
        namedrockunit:KLIT ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Highly variable due to interdigitating relationship with the Mercia Mudstone Group; ranges from 1m or less at some exposures to over 100m where these deposits fill \"buried valleys\" in the underlying pre-Triassic topography."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable and gradational, interdigitating with reddish-brown mudstone of the Mercia Mudstone Group (or its constituent formations)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dolomitic Conglomerate [Obsolete: use MMMF]"@en ,
        "Dolomitic Conglomerate and Red Marl [Obsolete: use MMMF]"@en ;
    skos:broader namedrockunit:MMG ;
    skos:definition "Breccia and conglomerate with subsidiary dolomitic limestone and limestone and trace sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MMMF"@en ;
    skos:prefLabel "Mercia Mudstone Group (Marginal Facies)"@en ;
.

namedrockunit:MNB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glauconitic, clayey, grey and green sands with bands and \"doggers\" of brown-weathering clay-ironstone and seams of phosphatic nodules (picking out erosion surfaces). A prominent band of phosphatic nodules occurs at the base. Casey and Gallois (1973) stated that the member could be divided into two based on ammonite faunas, a lower \"Hectoroceras Beds\" and an upper division \"in which Surites and allies predominate\"."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where glauconitic, clayey, grey and green sands with bands and \"doggers\" of clay-ironstone and phosphatic nodules (Mintlyn Member) overlies green, glauconitic, clayey sands with abundant phosphatic nodules (Runcton Sand Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4200 ,
        namedrockunit:H4800 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to about 15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the up-sequence change from glauconitic, clayey, grey and green sands with bands and \"doggers\" of brown-weathering clay-ironstone and seams of phosphatic nodules of the member, up into the unconsolidated, moderately clean, pale grey (occasionally green, yellow or orange), fine- to medium-grained, cross-bedded quartz sands with subordinate bands of silt or clay of the overlying Leziate Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Mintlyn Beds [Obsolete: use MNB]"@en ,
        "Mintlyn Sand Member [Obsolete: use MNB]"@en ;
    skos:broader namedrockunit:SAS ;
    skos:definition "Glauconitic sandstone, muddy sandstone and sand with subsidiary ferruginous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Berriasian Age - to - Valanginian Age (Cretaceous Period) (143.1-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MNB"@en ;
    skos:prefLabel "Mintlyn Member"@en ;
.

namedrockunit:MNSP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent
        namedrockunit:ARDR ,
        namedrockunit:TARF ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded thin micaceous psammites and semipelites with subordinate feldspathic and siliceous psammite and quartzite. Quartzite is more common in the basal part of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies Glen Doe Psammite and Loch Laggan Psammite Formations. Marked by gradual increase in semipelite beds in top of psammite formations."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 2km in type area, west of the Corrieyairack Pass."@en ;
    lexicon:hasUpperBoundaryDefinition "With increase in micaceous psammite and feldspathic psammite passes up transitionally into Carn Leac Psammite Formation (Foyers District - Haselock et al, 1982. Sheet 73E) and the Auchivarie Psammite Formation (Glen Roy district - Key et al, 1997. Sheet 63W). See May and Highton (1997)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ardair Semipelite Formation"@en ,
        "Tarff Banded Formation"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Micaceous psammite and semipelite with subsidiary quartzite and trace calcsilicate-rock. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MNSP"@en ;
    skos:prefLabel "Monadhliath Semipelite Formation"@en ;
.

