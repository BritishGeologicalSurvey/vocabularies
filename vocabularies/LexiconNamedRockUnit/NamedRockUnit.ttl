    lexicon:hasThicknessDescription "2.5 - 5.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Pitted top of the member overlain by up to 0.18 metres of multi coloured clays representing disconformable base of succeeding Bundoran Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BAL ;
    skos:definition "Limestone with subsidiary mudstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
