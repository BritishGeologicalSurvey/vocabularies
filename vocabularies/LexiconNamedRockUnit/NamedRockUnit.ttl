namedrockunit:PLLE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The formation consists of red-brown, bioturbated, gritty, argillaceous sandstones and thin heterolithic units that comprise dull green and yellowish green, lenticular siltstones and mudstones interbedded with grey-green sandstones. The heterolithic units display a diverse shallow marine ichnofauna comprising Skolithos, Palaeophycus, Thalassanoides, Teichichnus, Planolites, Arenicolites and Schaubcylindrichnus burrows (pers.comm. Hillier, R D and Waters, R A). \r
\r
Interdigitated with the green heterolithic facies are red, micaceous, predominantly massive fine- to medium-grained argillaceous sandstones, homogeneous siltstones and laminated mudstones, some containing desiccation cracks. Redoximorphic iron oxide mottling is observed, as are discrete ferricrete nodules. Bioturbation includes Skolithos, Planolites and probable Beaconites. The beds have yielded a poor, low-diversity, nearshore, shallow marine fauna including Lingula, gastropods and modiolopsids."""@en ;
    lexicon:hasLowerBoundaryDefinition """The lower boundary of the formation is placed at the conformable junction with the Tilestones Formation (Almond et al., 1993; Wilby, 2005a). Grey-green, highly micaceous sandstones of the topmost Tilestones Formation (Long Quarry Member of Almond et al., 1993) are overlain by coarser sandstones arranged in a stacked upward-coarsening sequence of erosively based beds at the base of the Pont ar llechau Formation. \r
\r
The upper boundary is placed where massive red sandstones at the top of the formation are overlain conformably by red and green mudstones with well developed calcrete nodules and wedge-shaped peds of the Moor Cliffs Formation (Almond et al., 1993; Wilby, 2005a)."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 43 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MIH ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ludlow Epoch - to - Pridoli Epoch (Silurian Period) (426.7-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PLLE"@en ;
    skos:prefLabel "Pont ar llechau Formation"@en ;
.

namedrockunit:PLLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The base of the Formation comprises a 6m-thick bed of grey, pebbly sandstone. This is overlain by dolomitic limestones with two thinner sandstones in a 15m thickness of strata. White to buff, crystalline limestones, ooidal in part, occur above the youngest sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The unconformable base is taken where dolomitic, locally ooidal limestone of the Belvoir Limestone Formation is overlain by grey , pebbly sandstone of the Plunger Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "199m at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken where the white to buff, crystalline limestone of the Plunger Limestone Formation is overlain by grey mudstone, siltstone or sandstone of the Millstone Grit Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolomitic limestone, limestone and pebbly (gravelly) sandstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PLLS"@en ;
    skos:prefLabel "Plungar Limestone Formation"@en ;
.

