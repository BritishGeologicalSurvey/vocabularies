        namedrockunit:LEMU ,
        namedrockunit:SIM ;
    skos:definition "Breccia, halite and mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RSA"@en ;
    skos:prefLabel "Rossall Halite Member"@en ;
.

namedrockunit:RTF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone and siltstone, greenish grey, intercalated with subordinate reddish-brown mudstone; thin beds of varicoloured fine- to medium-grained sandstone, laminated and micaceous, are common throughout. Veins and nodules of gypsum are common locally. A thin calcareous conglomerate occurs locally at the base."@en ;
    lexicon:hasLowerBoundaryDefinition "Slightly unconformable, at an abrupt upward change from red-brown pebbly sandstones of the Sherwood Sandstone Group to the greenish grey mudstones at the base of the Retford Member. In north Nottinghamshire, the Retford Member is separated from the Sherwood Sandstone Group by a tongue of reddish brown mudstone and siltstone that thickens towards the northeast."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1151 ,
        namedrockunit:H3010 ,
        namedrockunit:H3011 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasOldestAgeValue 2.499e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum 21 m in northeast Nottinghamshire, thinning to 6 m south of Ollerton, pinches out at the northern outskirts of Nottingham."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, within a gradational, upward transition from greenish-grey mudstones and siltstones of the Retford Member to the predominantly brown mudstones, siltstones and fine-grained micaceous sandstones of the overlying undifferentiated Tarporley Siltstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Green Beds \"Sensu Stricto\" [Obsolete: use RTF]"@en ,
        "Green Keuper Basement Beds [Obsolete: use RTF]"@en ,
        "Retford Formation [Obsolete: use RTF]"@en ;
    skos:broader namedrockunit:TPSF ;
    skos:definition "Mudstone and siltstone with subsidiary gypsum-stone and sandstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Olenekian Age (Triassic Period) (249.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RTF"@en ;
    skos:prefLabel "Retford Member"@en ;
.

namedrockunit:RTFD
