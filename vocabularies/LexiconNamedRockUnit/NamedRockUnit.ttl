    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kettla Member [Obsolete: use KTLA]"@en ;
    skos:broader namedrockunit:FARO ;
    skos:definition "Tuffaceous-siltstone and tuffite with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Selandian Age (Palaeogene Period) (61.7-59.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
