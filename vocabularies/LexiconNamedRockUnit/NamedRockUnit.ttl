    skos:broader namedrockunit:ISCG ;
    skos:definition "Clay, gravel, mud, sand and silt with subsidiary diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "JURBY"@en ;
    skos:prefLabel "Jurby Formation"@en ;
