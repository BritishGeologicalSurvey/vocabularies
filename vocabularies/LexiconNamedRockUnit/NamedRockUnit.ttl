    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "180m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, passing up into sequence characterised by thin dolomitic limestones (cementstones), sandstones and mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Annandale Sandstone Bed [Obsolete: use ANSA]"@en ,
        "Annandale Sandstone Member [Obsolete: use ANSA]"@en ,
        "Annandale Sandstone [Obsolete: use ANSA]"@en ;
    skos:broader namedrockunit:KICM ;
    skos:definition "Sandstone with subsidiary conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ANSA"@en ;
    skos:prefLabel "Annandale Sandstone Beds"@en ;
.

namedrockunit:ANSH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greyish blue, rusty-weathering mudstones with scattered thin sooty goniatite-bearing mudstones. Scattered siltstones and sandstones (up to 7cm thick) form less than 10% of the Member. The sandstones are commonly medium-grained, quartzitic and feldspathic and thought to be derived from the south. Plant fragments are locally abundant."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of bluish grey micaceous mudstones with scattered thin sandstones and siltstones of the Ashton Mudstone Member above the fossiliferous interbedded cherts, limestones and mudstones (Posidonia Beds) of the Teign Chert Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H17 ,
        namedrockunit:H1950 ,
        namedrockunit:H644 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "210-430m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the gradational incoming of more abundant and relatively thicker sandstones of the overlying Crackington Formation above the mudstones with less than 10% sandstone of the Ashton Mudstone Member."@en ;
