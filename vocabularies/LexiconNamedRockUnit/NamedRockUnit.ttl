namedrockunit:CKT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DALTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DATUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Garnetiferous eutaxitic dacitic lapilli-tuff with thin interbedded laminated garnetiferous tuff locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of garnetiferous, dacitic lapilli-tuff. Unconformable, in type area overlies volcaniclastic breccia and sandstone (Dale Head Member); elsewhere overlies a variety of basaltic, andesitic and dacitic lava."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 60m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by a variety of lavas that range in composition from basaltic andesite to dacite, and locally overlain by valcaniclastic sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BFA ;
    skos:definition "Dacitic lapilli-tuff with subsidiary dacitic tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CKT"@en ;
