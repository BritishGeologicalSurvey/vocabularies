namedrockunit:LLT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLateralEquivalent namedrockunit:LSBN ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHYLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Most of the formation consists of light olive-grey, thinly flaggy, calcareous siltstones with shelly limestones and shale bands, but at Sunnyhill Quarry the basal 2.3 m of the formation are lithologically distinct. They comprise nodular, silty, massive and crinoidal limestones with calcareous siltstones, and resemble the Upper Bringewood Formation. \r
\r
The coquinoid occurrence of fossils is typical of the Lower Leintwardine Formation."""@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the Upper Bringewood Formation (UBB). The base of the formation at Sunnyhill Quarry is defined on faunal rather than lithological criteria, i.e. above the highest occurrences of Kirkidium knightii (J. Sowerby), Strophonella euglypha (Hisinger) and tabulate corals, and therefore at the faunal change from the Mesopholidostrophia laevigata Association to the Sphaerirhynchia wilsoni Association."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasOldestAgeValue 4.25e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be about 30 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Upper Leintwardine Formation (ULT)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SD> ;
    lexicon:hasYoungestAgeValue 4.227e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Leintwardine Formation [Duplicate: use LLT]"@en ;
    skos:definition "Calcareous siltstone and shelly limestone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Ludfordian Age (Silurian Period) (425-422.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "LLT"@en ;
    skos:prefLabel "Lower Leintwardine Formation"@en ;
.

