namedrockunit:ARDT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stony sandy clay diamicton with angular to subrounded clasts up to boulder size; a typical lodgement till. Locally overlying a unit of deformation till derived from the destruction of underlying Linn of Pattack Silt Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on (1) Linn of Pattack Silt Formation, or (2) Pattack Till Formation, or (3) bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "<12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable with units of outwash sand and gravel, morainic deposits or peat, etc."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CGDR ;
    skos:definition "Diamicton with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ARDT"@en ;
    skos:prefLabel "Ardverikie Till Formation"@en ;
.

namedrockunit:ARFS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Green to grey, fine- to medium-grained, laminated or cross laminated sandstone in beds up to 1.7 m thick, with pebble-rich lenses and shelly lags with Lingula fragments and seams up to several centimetres thick, consisting of green mudstone and siltstone with Lingula. All lithologies are seen as rip-up clasts in the basal parts of the sandstone beds. The upper part of the formation comprises coarse-grained, calcareous sandstone, with pedogenic fabrics, and conglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, conformable base of green to grey, fine- to medium-grained sandstone with Lingula, of the Arch Farm Sandstone Formation, above the brown to green-grey medium to coarse-grained sandstone and conglomerate of the Calke Abbey Sandstone Formation; seen as a prominent step on gamma-ray logs."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as 9 m thick in the Ticknall Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of a medium- to coarse-grained pebbly sandstone, overlain by green, slickensided, smectite-rich mudstone with about 4 mm ferruginous concretions of the Arch Farm Sandstone Formation, sharply overlain by pale grey to white calcareous sandstone of the Cloud Hill Dolostone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "ARFS"@en ;
    skos:prefLabel "Arch Farm Sandstone Formation"@en ;
.

