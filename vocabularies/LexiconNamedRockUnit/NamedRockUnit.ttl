    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "About 500m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by siltstones, sandstones and calcareous mudstones of the Dwyfach Formation."@en ;
