    lexicon:hasUpperBoundaryDefinition "The Finavon Conglomerate Member forms a conglomeratic lens within the Tannadice Sandstone Member, which (Armstrong and Paterson, 1970, p.14) considered to be the top of a conglomerate body locally marking the base of the Tannadice Sandstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Auchmithie Conglomerate Member"@en ,
