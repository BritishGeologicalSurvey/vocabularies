namedrockunit:TOHO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A grey, fine-grained, very argillaceous, slightly crinoidal bioclastic \"cementstone\" type of limestone, interpreted to be of marine origin."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a conformable change from marine mudstone underlying the Top Hosie Limestone above a thin coal or seatearth within the Lower Limestone Formation that forms the top of the second Hosie Limestone cycle. It is not uncommon for Second and Top Hosie limestones to be separated only by marine strata, or even to become fused together."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:URKI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Generally between 0.11m and 1.30m, or less, in the Airdrie, Falkirk and Glasgow districts. This limestone fuses with the Second Hosie Limestone in the west Glasgow district and at Wairdlaw [NS 995 731] in the Bathgate Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally seen as a conformable change to marine mudstone that passes up into deltaic arenaceous deposits of the Limestone Coal Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Kinniny Limestone [Obsolete: use TOHO]"@en ;
    skos:broader namedrockunit:LLGS ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage - to - Pendleian Substage (Carboniferous Period) (330.9-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TOHO"@en ;
    skos:prefLabel "Top Hosie Limestone"@en ;
.

