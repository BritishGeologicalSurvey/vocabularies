        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstones with variable amounts of very subordinate thin siltstone, sandstone and limestone beds. Component mudstone formations are characterised either by grey, purple and red, or green and grey green colourations. The mudstone formations locally contain scattered units of thin- to thick-bedded limestone or sandstone. Intertonguing with the grey mudstones are thick, geographically separated formations of thick-bedded to massive shallow water bioclastic and reef limestone, locally capped by condensed nodular limestones and mudstones. Thick units of basaltic lava (spilite), massive and bedded hyaloclastite, and bedded tuff are also present in the Group."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is everywhere tectonic, but the Tamar Group is assumed to overline the Meadfoot Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "In excess of 6700 m on the north Cornish coast; possibly thicker elsewhere."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is rarely seen due to tectonics but taken at the incoming of dark grey to black mudstones and or thin-bedded cherts of the Chudleigh Group above the grey, purple and green mudstones of the Tamar Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone with subsidiary basalt lava, hyaloclastite, limestone, sandstone, siltstone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (410.5-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BTN ,
        namedrockunit:PYL ,
        namedrockunit:RRAM ,
        namedrockunit:SAH ,
        namedrockunit:TPT ,
        namedrockunit:TQL ,
        namedrockunit:TVY ,
        namedrockunit:WWYM ,
        namedrockunit:YF ;
    skos:notation "TAMA"@en ;
    skos:prefLabel "Tamar Group"@en ;
.

namedrockunit:TAPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly psammite, thin-bedded, siliceous to micaceous. Local, thin semipelite beds are muscovite-rich and locally migmatitic. Large quartzite lenses occur, in particular near the base. Tends to become more micaceous to the NE. Psammite is generally fine-grained. Locally well-developed cross-bedding, in places showing herring-bone cross-bedding, and symmetric ripple marks."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Ben Wyvis Pelite Formation (BWYP) along the western boundary, where predominant pelites pass into predominantly psammitic lithologies. Similarly overlies the Achnaconeran Striped Formation (ACHN) and the Achnacarry Formation (ACNS) in the east."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2474 ,
        namedrockunit:H3710 ,
        namedrockunit:LEIP ,
        namedrockunit:QUIO ,
        namedrockunit:UGPS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 2.5 km thick, up to about 5 km."@en ;
    lexicon:hasUpperBoundaryDefinition "Not known. Commonly unconformably overlain by Old red Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Easter Glen Quioch Psammite [Obsolete: use TAPS]"@en ,
        "Loch Eil Psammite Formation [Obsolete: use TAPS]"@en ,
        "Tarvie Psammite [Obsolete: use TAPS]"@en ,
        "Tarvie Psammitic Group [Obsolete: use TAPS]"@en ,
        "Upper Garry Psammite Formation [Obsolete: use TAPS]"@en ;
    skos:broader namedrockunit:LEIL ;
    skos:definition "Micaceous psammite and psammite with subsidiary quartzite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DRMF ,
        namedrockunit:GGQP ,
        namedrockunit:KINQU ,
        namedrockunit:STRCH ;
    skos:notation "TAPS"@en ;
    skos:prefLabel "Tarvie Psammite Formation"@en ;
