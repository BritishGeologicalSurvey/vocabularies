    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Benscliffe Agglomerate [Obsolete: use CMBA, BENS]"@en ,
        "Felsitic agglomerate [Obsolete: use CMBA, BENS]"@en ;
    skos:broader
        namedrockunit:CMBH ,
        namedrockunit:CMCL ;
    skos:definition "Lapilli-tuff and volcaniclastic-breccia with subsidiary tuff and trace tuffaceous-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CMBA"@en ;
    skos:prefLabel "Benscliffe Breccia Member"@en ;
.

namedrockunit:CML
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
