namedrockunit:CRHE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale brown, reddish brown and browish yellow, slightly silty, slightly to very gravelly fine to coarse sand. Gravel is subangular to subrounded and comprises a mixed lithology of sandstone, limestone and quartz with rare igneous clasts. Generally thinly bedded (<20mm). Bedding weakens, becoming disturbed, towards the upper surface, with evidence of cryoturbation. Rare laterally impersistant clay lenses."@en ;
    lexicon:hasLowerBoundaryDefinition "Not observed but interpreted to rest discontinuously over older till and/or may interdigitate laterally with interbedded glaciofluvial and glaciolacustrine sand and clay."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Known to be a minimum of 7m in a temporary excavation at Crockey Hill."@en ;
    lexicon:hasUpperBoundaryDefinition "Exposed at surface. In places overlain by thin aeolian sands."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:VYORK ;
    skos:definition "Gravel and sand with subsidiary silt and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRHE"@en ;
    skos:prefLabel "Crockey Hill Esker Member"@en ;
.

