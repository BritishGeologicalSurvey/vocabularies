namedrockunit:LKV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MSDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Metasandstone, arenite to wacke, pale to dark grey green and dark green ('Green Beds'), commonly orange- to pink-brown weathering. Fine- to very coarse-grained, graded to massive, interbedded with subsidiary semipelite and pelite. Contains locally abundant chlorite and epidote originally of volcanic origin."@en ;
    lexicon:hasLowerBoundaryDefinition "Outgoing of clean arenite and quartz arenite of the Ardnandave Sandstone Formation and the incoming of chloritic and epidotic, greenish silicaclastic sediments."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3526 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "1000m estimated"@en ;
    lexicon:hasUpperBoundaryDefinition "Outgoing of chloritic, greenish rocks and incoming of clean coarse arenites/quartz arenites (Creag Innich Sandstone) or more matrix rich arenites and wackes (Ben Ledi Grit Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Greenbeds [Obsolete: use LKV]"@en ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Metasandstone with subsidiary metasiltstone, pelite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LKV"@en ;
    skos:prefLabel "Loch Katrine Volcaniclastic Formation"@en ;
