    skos:altLabel "Limestones of Langham and Cucklington [Obsolete: use CUO]"@en ;
    skos:broader namedrockunit:STOU ;
    skos:definition "Limestone and ooid-limestone with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CUO"@en ;
    skos:prefLabel "Cucklington Oolite Member"@en ;
.

namedrockunit:CUSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically deltaic and estuarine, commonly very fine- to medium-grained, finely micaceous, mainly flat laminated grey sand with silt and some clay laminae. Scattered pebbles occur up to 2cm size along with rare pebble beds, and there are black sulphidic patches. Coarser deposits including much higher proportions of coarse sand and gravel beds are known in the western areas of occurrence."@en ;
    lexicon:hasLowerBoundaryDefinition "Diachronous transitional base with, and passing laterally into, the Powgavie Clay (Forth Clay Formation), and also the Errol Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1466 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35m known at Culfargie."@en ;
    lexicon:hasUpperBoundaryDefinition "The Culfargie Sand Member has a complex upper boundary with multiple unconformities with younger strata including the Carey Silt Member, Kingston Sand Member and Carse of Gowrie Clay Member (Carse Clay Formation). Also is known at surface as the top deposit of later Devensian raised beach landforms."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Culfargie Beds [Obsolete: use CUSA]"@en ;
    skos:broader namedrockunit:FOCL ;
    skos:definition "Sand with subsidiary gravel and silt and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CUSA"@en ;
    skos:prefLabel "Culfargie Sand Member"@en ;
.

