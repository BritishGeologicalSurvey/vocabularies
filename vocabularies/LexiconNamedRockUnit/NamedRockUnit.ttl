namedrockunit:CLNE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cross-bedded, well-sorted, sub- to well-rounded quartzose sandstone. The lower part of the formation is fine- to medium-grained; the upper part is medium-grained sandstone and is more argillaceous. Thin mudstone drapes occur on cross-bedded surfaces in both units, and fossil wood, including logs, is common or abundant. The contact between the two units is either gradational or marked by a scoured surface."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, burrowed erosion surface with the underlying mudstones of the Kimmeridge Clay Formation. The surface is marked by a pyritic, phosphatic and quartz pebble bed, containing derived Kimmeridgian fossils and lignite."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "5.5 to 7.8m according to Hesselbo et al. (1990), although Owen et al. (1996) recorded up to 12m."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp erosive junction with the overlying coarse-grained, poorly sorted ferruginous sandstone of the Carstone Formation, marked by a concentration of quartz pebbles in the base of the Carstone and large burrows that penetrate the top of the Calne Sands Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Sandstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLNE"@en ;
    skos:prefLabel "Calne Sands Formation"@en ;
.

