namedrockunit:BDTN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold-phase sands and gravels that underlie the Balderton Terrace. Orange-brown sandy gravel dominated by rounded pebbles of \"Bunter\" quartz/quartzite (c.75%) with subordinate subangular flint (c.15%), and rarer Triassic sandstone, etc. Infills a broad sinuous channel extending northeast from Newark towards the Lincoln Gap; terrace surface falls from c.20m above OD (c.10m above the Trent floodplain) to c.11m OD. Sections show intraformational and epigenetic ice wedge casts. Upper part locally includes a thin fluvio-aeolian coversand (Whisby Sand Bed, pre-Ipswichian) and a  rubified paleosol (Hykeham Soil: Ipswichian). Basal part locally includes channel-filling organic silts (Thorpe on the Hill Bed), which yield a temporate flora and fauna assigned to MIS 7. Correlated with the Southrey Sand and Gravel Member (Trent Valley Formation, pre-diversionary River Trent east of Lincoln Gap) and Egginton Common Sand and Gravel Member (Trent Valley Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock and possibly, very locally, on the Skellingthorpe Clay Member of the Wolston Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3833 ,
        namedrockunit:H3834 ,
        namedrockunit:H4450 ,
        namedrockunit:H683 ,
        namedrockunit:ORG ,
        namedrockunit:WHAT ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c.9m; typically c.6 to 8m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Balderton Member [Obsolete: use BDTN]"@en ,
        "Balderton Sand and Gravel [Obsolete: use BDTN]"@en ,
        "Beeston River Deposits [Obsolete: use BDTN]"@en ,
        "Beeston River Terrace Deposits [Obsolete: use BDTN]"@en ,
        "Older river gravel"@en ,
        "Whatton Sand and Gravel [Obsolete: use BDTN]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BDTN"@en ;
    skos:prefLabel "Balderton Sand and Gravel Member"@en ;
.

namedrockunit:BEAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin- to thick-bedded commonly coarse and feldspathic sandstones interbedded with siltstones and dark grey mudstones. Scattered beds of ill-sorted pebble to cobble conglomerate up to 2 m thick contain clasts including chert, lava and limestone as well as derived Dinantian and ?Namurian fossils. Some channels are present."@en ;
    lexicon:hasLowerBoundaryDefinition "The depositional lower boundary is not seen as the base is always faulted. The lower boundary is thought to post-date the D1 deformation phase, with the formation resting unconformably on Dinantian sequences."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CKF ,
        namedrockunit:H3835 ,
        namedrockunit:H3836 ,
        namedrockunit:H4451 ,
        namedrockunit:H4452 ,
        namedrockunit:H47 ;
