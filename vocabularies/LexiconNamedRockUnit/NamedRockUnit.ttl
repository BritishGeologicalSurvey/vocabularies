    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 10 m of gravel underlying the terrace surface."@en ;
    lexicon:hasUpperBoundaryDefinition "The terrace, which is modified by erosion, lies 1-3 m above Kennet Floodplain."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
