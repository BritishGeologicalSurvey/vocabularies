namedrockunit:SBSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and gravel, coarsening upwards from pebbly sand to boulder gravel, dense, composed of angular to subrounded clasts of red (Permian) sandstone, white and yellow (Carboniferous) sandstone and ganister, black (Carboniferous) mudstone and coal, with some Borrowdale Volcanic Group rocks (rhyolite, welded tuff), greywacke sandstone and siltstone, limestone and grey (Criffel) granite. Top of unit commonly cemented by calcite. Palaeocurrents directed between NW and SW."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational, conformable contact with laminated fine-grained sand, silt and clay of the St Bees Silt Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3020 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, undulating, unconformable contact with grey sandy pebbly silt diamicton of the St Bees Till Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "St Bees Sand and Gravel [Obsolete: use SBSG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Gravel, gravelly cobbles and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBSG"@en ;
    skos:prefLabel "St Bees Sand And Gravel Member"@en ;
.

namedrockunit:SBSH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly red siltstones and silty mudstones, with some sandstone, millet-seed sand grains, mudstone breccias and gypsum."@en ;
    lexicon:hasLowerBoundaryDefinition "'The base of the main red clastic sequence', where red mudstones become predominant over the evaporites that characterise the underlying formation (St. Bees Evaporites)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1163 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "62m in type section with range of 0 - 215m in Cumbria generally."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken where sandstone, which characterises the overlying formation (St. Bees Sandstone), becomes predominant over red siltstone and mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "St Bees Shales Formation [Obsolete: use SBSH]"@en ;
    skos:broader namedrockunit:CCO ;
    skos:definition "Mudstone, siltstone and silty mudstone with subsidiary breccia, gypsum-stone, sand and sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBSH"@en ;
    skos:prefLabel "St Bees Shale Formation"@en ;
.

namedrockunit:SBSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly interlaminated calcareous, bluish grey silty clay, reddish brown clay and yellowish brown silt passing upwards into ripple-drift cross laminated sand with much finely disseminated coal. Palaeocurrents mostly directed towards the northwest."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed, but BGS-registered borehole NX91SE5 near the type section indicates that it rests unconformably on stiff, reddish brown diamicton, probably the Lowca Till Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3659 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
