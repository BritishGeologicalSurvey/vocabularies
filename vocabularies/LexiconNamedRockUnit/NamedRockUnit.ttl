namedrockunit:MVF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANDLAV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Andesite, basaltic andesite, other andesitic rocks, volcaniclastic conglomerate and sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, diachronous to some extent. Lower boundary at the base of  the base of the lowest lava of the thick succession of andesitic lavas that separate the conglomerate and sandstone of the Deep Conglomerate Formation (above) and the Catterline Conglomerate Formation (below) in the area to the north of the River North Esk. Oversteps Barras Conglomerate Member, St John's Knap Sandstone Member and the Catterline Conglomerate Formation from north to south."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H410 ,
        namedrockunit:H4807 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 560 m thick in the type area, thinning out towards the west and south-west where it interfingers with lithic and volcaniclastic sandstone."@en ;
    lexicon:hasUpperBoundaryDefinition "At the eroded top of the thick succession of andesitic lavas, in the area to the north of the River North Esk, where these are conformably and somewhat diachronously overlain by the clast-supported Deep Conglomerate Formation, or cross-bedded sandstone of the Scone Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hypersthene Andesite [Obsolete: use MVF]"@en ,
        "Hypersthene Basalt Series [Obsolete: use MVF]"@en ;
    skos:broader namedrockunit:ATGK ;
    skos:definition "Andesite and basaltic-andesite with subsidiary conglomerate and trace andesite lava, basalt and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MVF"@en ;
    skos:prefLabel "Montrose Volcanic Formation"@en ;
.

