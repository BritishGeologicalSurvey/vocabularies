namedrockunit:TRLF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, blue-grey, sparsely bioclastic, crinoidal, fine- to medium-grained containing pellets, micritised bioclasts, oncolites and ooliths, interbedded with dark grey to grey-green shale and brown, medium-grained sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt, but conformable change from deltaic facies, clastic sediments at the top of the underlying Claragh Sandstone Formation to peritidal carbonates and thin shales of the Termon River Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 40m"@en ;
    lexicon:hasUpperBoundaryDefinition "Change from 'clean' peritidal carbonates of the Termon River Limestone Formation, to sandstones and sandy limestones of the Gortnaree Sandstone Member of the Ballyshannon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TYRO ;
    skos:definition "Limestone with subsidiary mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
