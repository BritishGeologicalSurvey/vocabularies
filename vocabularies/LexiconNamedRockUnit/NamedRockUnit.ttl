namedrockunit:KLC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SIMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SISLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SISST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicate mudstone, grey, commonly smooth in basal part (see Previous Names), but more generally silici-silty or silici-sandy, locally with thin beds of siltstone and sandstone, and nodules of argillaceous limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, conformable or non-sequential junction with bioclastic limestone of the underlying Cornbrash Formation overlain by grey mudstone. Commonly a thin bioclastic unit of shell-fragmental, more or less sandy mudstone occurs at the base (where this is more strongly cemented it is included in the Cornbrash Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2267 ,
        namedrockunit:H997 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to perhaps (in south Dorset) c. 50 m; typically c. 20 m in the Wessex Basin, and 2 to 3 m on the East Midlands Shelf."@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional junction; boundary drawn at the base of the lowest substantial sandstone/siltstone unit of the overlying Kellaways Sand Member resting on the predominantly mudstone succession."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kellaways Clay Member plus Cayton Clay Formation [Obsolete: use KLC]"@en ,
        "Kellaways Clay [Obsolete: use KLC]"@en ;
    skos:broader namedrockunit:KLB ;
    skos:definition "Silicate-mudstone with subsidiary calcilutite, silicate-sandstone and silicate-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
