namedrockunit:MAHO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale to dark grey, argillaceous, crinoidal and shelly bioclastic limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a conformable change from a marine mudstone within the Lower Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CPLS ,
        namedrockunit:LVEX ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 0.05 m to 2.2 m thick in the Airdrie, Falkirk and Glasgow districts. This limestone fuses with the Mid Hosie Limestone at Petershill in the Bathgate Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally seen as a change to marine mudstone within the Lower Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chapel Point Limestone [Obsolete: use MAHO]"@en ,
        "Lower Vexhim Limestone [Obsolete: use MAHO]"@en ;
    skos:broader namedrockunit:LLGS ;
    skos:definition "Calcilutite and limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MAHO"@en ;
    skos:prefLabel "Main Hosie Limestone"@en ;
.

namedrockunit:MALP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Siliceous to micaceous psammite, with minor semipelite. For lower parts see Arnisdale Psammite Member (MAAP) and Rubha Ruadh Semipelite Member (MARRS). The upper half of the formation comprises coarse to gritty, thick-bedded (0.5 - 4 m), arkosic psammite. Sedimentary structures are obvious and abundant, including channels with stacked planar and trough cross-bedding with cosets (0.3 -1 m). Abundant soft-sediment deformation structures, locally affecting up to 4 m thick. Towards the top more thinly bedded and finer grained, with an increase in semipelitic beds towards its upper contact with the Morar Schists Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Basal Pelite Formation (MABP) or unconformable typically of the Western Glenelg Gneiss (WGG); unconformity normally highly sheared."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 2000 - 3000 m (estimate, strongly deformed in places)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Morar Schists Formation (MAMS). Relatively sharp boundary with incoming of pelitic beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Psammite with subsidiary pelite and semipelite and trace gneissose pelite, gneissose semipelite, metaconglomerate and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:MAAP ,
        namedrockunit:MARRS ;
    skos:notation "MALP"@en ;
    skos:prefLabel "Lower Morar Psammite Formation"@en ;
.

namedrockunit:MANS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises interbedded white to pale grey sandstone, muddy siltstone and grey to black organic mudstone.  Sandstones are upward fining from coarse to fine-grained and locally very calcareous. They are cross-bedded and current-ripple bedded. The interbedded mudstone is fossiliferous, bioturbated and plant and root horizons occur. The proportion of sandstone to mudstone varies from borehole to borehole. Cores and gamma-ray logs indicate that the formation is composed of two upward fining units, each about 12 m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by a downwards passage from sandstone with interbedded mudstone to varicoloured mudstone and thin sandstone (Golspie Formation). The boundary may be sharp (e.g. Well 11/25-1) or gradational (e.g. Well 12/21-2). There is usually a down-section increase in average gamma values and a decrease in average velocity."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5109 ,
        namedrockunit:H5110 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 60 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downward change from dark, organic-rich, fossiliferous mudstone (Lady's Walk Formation) to sandstone with mudstone interbeds. There is a sharp down-section decrease in average gamma values and an increase in velocity. Where the Lady's Walk Formation is absent (e.g. Well 12/26-1) the boundary is placed at a downward change from upward-coarsening sandstones (Orrin Formation) to sandstones with interbedded mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grant Sand Member [Obsolete: use MANS]"@en ,
        "White Sandstone Unit [Obsolete: use MANS]"@en ;
    skos:broader namedrockunit:DUNR ;
    skos:definition "Muddy siltstone, mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Hettangian Age - to - Sinemurian Age (Jurassic Period) (201.4-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MANS"@en ;
    skos:prefLabel "Mains Formation"@en ;
.

namedrockunit:MARF
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WIDS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Laminated clay; wavy to lenticular-bedded sand interbedded with clay in equal proportions; and fine- to medium-grained sparsely glauconitic sand with laminae and intercalations of clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Earnley Sand Formation. Boundary marked by the sharp upward change from glauconitic sands of the Earnley Sand Formation to the thinly bedded clays and silts with glauconitic sand laminae of the Marsh Farm Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1518 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "12-13.5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Selsey Sand Formation whose base is sharply marked by glauconitic sandy silts with a few flints on a burrowed surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Earnley 'Division' [Obsolete: use MARF, EA]"@en ,
        "Windlesham Formation"@en ;
    skos:broader namedrockunit:BRB ;
    skos:definition "Clay and sand. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MARF"@en ;
    skos:prefLabel "Marsh Farm Formation"@en ;
.

namedrockunit:MASS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, red, fine- to medium-grained, with abundant rounded \"millet seed\" grains. Sandstone is cross-stratified and weakly cemented. Subordinate beds also occur of sandstone and coarse siltstone, brown, fine-grained, micaceous, laminated; these resemble sandstones of the parent Tarporley Siltstone Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, within a gradational, interdigitating transition from the interbedded brown sandstone, siltstone and mudstone of the underlying Tarporley Siltstone Formation (undivided) to the red sandstone with abundant millet seed grains of the Malpas Sandstone Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1683 ,
        namedrockunit:H4181 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 180 m at outcrop in the Malpas area."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, with an abrupt transition to interbedded red mudstone and pink micacesous siltstone of the Bollin Mudstone Member of the Sidmouth Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Malpas Sandstone [Obsolete: use MASS]"@en ,
        "Upper Keuper Sandstone [Obsolete: use MASS, AS]"@en ;
    skos:broader namedrockunit:TPSF ;
    skos:definition "Sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MASS"@en ;
    skos:prefLabel "Malpas Sandstone Member"@en ;
.

namedrockunit:MCPDD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
