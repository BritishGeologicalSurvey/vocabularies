    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 200m in Exeter district; 255m on the coast (Selwood and others, 1984)."@en ;
    lexicon:hasUpperBoundaryDefinition "See definition of lower boundary of Littleham Mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
