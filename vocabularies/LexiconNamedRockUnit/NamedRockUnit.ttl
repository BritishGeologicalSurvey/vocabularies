namedrockunit:ULLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MMRG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OGNAF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ullapool Gneiss is a dark pink to white weathering, variably foliated and poorly layered, medium- to coarse-grained orthogneiss, rich in alkali feldspar. The gneiss has a broadly syenitic to granitic composition. Samples from the type locality typically comprise K-feldspar (perthite and microcline) + plagioclase + guartz + bluish green amphibole, with minor epitode and accessory titanite. The mafic minerals occur in clusters several millimetres across, which commonly gives the rock a pink-green speckled appearance. The felsic gneiss contains some pods of more mafic, amphibole-rich gneiss. The gneissic layering is considerably less well developed than in the typical Scourian Gneiss. Amphibolitic mafic dykes cross-cut the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "The unit always occurs within the Moine Thrust Belt, and the lower structual boundary is always tectonic."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3742 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AR> ;
    lexicon:hasOldestAgeValue 4e+03 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LD> ;
    lexicon:hasThicknessDescription "20m - 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper structural boundary is formed by the Moine Thrust or by the unconformity with overlying Torridon Group sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Logan Rock [Obsolete: use ULLA]"@en ;
    skos:broader namedrockunit:L ;
    skos:definition "Alkali-feldspar orthogneiss and trace gneissose metamafic-rock. Bedrock. Occurs onshore. Formed during the Archean Eon - to - Paleoproterozoic Era (Precambrian) (4000-1600 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ULLA"@en ;
    skos:prefLabel "Ullapool Gneiss"@en ;
.

