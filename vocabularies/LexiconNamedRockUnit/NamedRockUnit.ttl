namedrockunit:CWMF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Mainly calcretised green siltstones, green and pale grey sandstones, some of which are conglomeratic and pebbly, and calcrete-clast intraformational conglomerates. \r
\r
Fluvial sheetflood and channelised sands with floodplain silts subjected to subaerial exposure and carbonate soil formation. \r
\r
Probably late Ludlow to Pridoli."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is an unconformity overstepping progressively on to lower rocks westwards from the Cennen Valley to rest on Ordovician strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 65 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable with green calcretised mudstones that were formerly considered to comprise the same lithostratigraphical unit (the Green Beds), but are now recognised as typical Temeside Mudstone Formation lithologies, as for example in Nant Cwmffrwd [SN 423 173]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MIH ;
    skos:definition "Conglomerate, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ludlow Epoch - to - Pridoli Epoch (Silurian Period) (426.7-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CWMF"@en ;
    skos:prefLabel "Cwmffrwd Formation"@en ;
.

