    lexicon:hasThicknessDescription "To 170m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen at type locality. Passage of wackestones and floatstones of the Raingill Limestone Member into overlying laminated calcisiltites and mudstones of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
