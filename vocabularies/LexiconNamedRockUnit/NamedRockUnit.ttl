    lexicon:hasThicknessDescription "5.6m."@en ;
    lexicon:hasUpperBoundaryDefinition "Up-section change from dark red and grey strongly nodular limestone of the Member into white chalks of the Ferriby Chalk Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
