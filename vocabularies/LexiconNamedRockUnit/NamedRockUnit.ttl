namedrockunit:EMSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold-phase sands and gravels that underlie the Eagle Moor Terrace. Dominated by rounded pebbles of "Bunter" quartz/quartzite with subordinate subangular flint (typically 25% in the Type Area), etc. Clayey and poorly sorted. In type area occurs as hill-top outliers falling from c.36m OD near Newark (c.25m above Trent floodplain) towards the Lincoln Gap, being at c.+32m OD at Eagle Moor and possibly descending more rapidly to the east. Outliers upstream in the Loughborough district 30m+ above Trent floodplain. Correlated with the Martin Sand and Gravel Member (Trent Valley Formation), east of the Lincoln Gap. \r
\r
River terrace deposits. Middle Pleistocene (MI Stage 12 or 10)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock or locally, east of Eagle Moor, on the Skellingthorpe Clay Member of the Wolston Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GSG ,
        namedrockunit:H2172 ,
        namedrockunit:H233 ,
        namedrockunit:H234 ,
        namedrockunit:H3387 ,
        namedrockunit:ORSG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 6 m; typically c. 2 to 3 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eagle Moor Member [Obsolete: use EMSG]"@en ,
        "Eagle Moor Sand and Gravel [Obsolete: use EMSG]"@en ,
        "Glacial sand and gravel [Obsolete]"@en ,
        "Hilton Terrace Deposits [Obsolete: use EMSG]"@en ,
        "Older river sand and gravel"@en ,
        "Upper Hilton Terrace (in part) [Obsolete: use EMSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EMSG"@en ;
    skos:prefLabel "Eagle Moor Sand and Gravel Member"@en ;
