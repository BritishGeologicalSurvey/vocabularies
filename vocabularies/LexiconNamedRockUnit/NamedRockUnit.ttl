    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Usually 25-30 m, but may achieve 58 m locally."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the relatively sharp conformable upward passage from coarse sandstones of the Cardingmill Grit to purple mudstones and siltstones of the Synalds Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carding Mill Grit [Obsolete: use CDDG]"@en ,
        "Cardingmill Grit [Obsolete: use CDDG]"@en ;
    skos:broader namedrockunit:BUGP ;
    skos:definition "Sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
