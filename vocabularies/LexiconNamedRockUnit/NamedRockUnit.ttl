namedrockunit:LGGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDSH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Partially cemented gravel typically containing a high (50-60%) proportion of locally derived limestone and dolomite pebbles of the Zechstein Group (formerly Magnesian Limestone) and a varied suite of far-travelled clasts including Carboniferous lithologies, andesite, granite, gneisse, schist, flint, quartz, quatzite and dolerite, together with unabraded shell fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, erosional, channelled contact with limestones and dolostones of the Zechstein Group (formerly Magnesian Limestone)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1023 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 6m known"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp, subhorizontal, planar to gently undulating contact with dark grey, stiff, sandy silty stony clay diamicton of the Blackhall Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Gravels [Obsolete: use LGGR]"@en ;
    skos:broader namedrockunit:NSG ;
    skos:definition "Gravel with subsidiary sand and trace shell sediment (shells). Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LGGR"@en ;
    skos:prefLabel "Limekiln Gill Gravel Formation"@en ;
.

namedrockunit:LGLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BACOMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BACOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olivine-microphyric basalt lavas (Dalmeny type) with a few flows of clinopyroxene-olivine-microphyric basalt (Hillhouse type). Some clinopyroxene-olivine-macrophyric basalt (ankaramite or Craiglockhart type) intercalated in upper part of sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "The Largs Lava Member overlies the Noddsdale Volcaniclastic Member, as was proved in the Largs Borehole [NS 2158 5936]."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1655 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 130 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Lavas of the Largs Lava Member are more mafic than those of the overlying Greeto Lava Member with the boundary defined by the petrographic change from olivine-microphyric basalts (Dalmeny type) of the Largs Lava Member to the overlying plagioclase-phyric basalts and hawaiites (Jedburgh and Markle types) of the Greeto Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
