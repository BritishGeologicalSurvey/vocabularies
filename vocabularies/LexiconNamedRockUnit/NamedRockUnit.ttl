namedrockunit:GLLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Distinctive olivine-bearing plagioclase-macrophyric basalts (Markle type). Characterised by lava flows with abundant, platy phenocrysts of plagioclase up to 2 5mm long and microphenocrysts of red-brown olivine. A massive flow of plagioclase-microphyric basalt (Jedburgh type) forms the base of the member at Linn Well [2475 6605]. Lavas are interbedded with volcaniclastic sedimentary rocks at the base of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "The Gleniffer Lava Member is underlain by the sedimentary rocks of the Glenburn Volcaniclastic Member to the north and east of Brownside Braes [2485 6605]."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2207 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "The Gleniffer Lava Member is overlain and may be cut out or overlapped, by the mafic basalts of the Sergeantlaw Lava Member around Sergeantlaw [2455 6597] and to the east of Middleton [2445 6579], and to the west of Barcraigs Reservoir [239 657] and Walls Hill [241 659]. The Gleniffer Lava Member may thin to the east ."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gleniffer Lavas [Obsolete: use GLLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Plagioclase-macrophyric basalt and plagioclase-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GLLA"@en ;
    skos:prefLabel "Gleniffer Lava Member"@en ;
.

