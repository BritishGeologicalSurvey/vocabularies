    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Sandstone with subsidiary conglomerate and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
