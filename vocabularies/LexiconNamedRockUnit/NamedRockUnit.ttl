namedrockunit:GRLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Plagioclase-microphyric basaltic to hawaiitic lava (Jedburgh type) with a few flows of plagioclase-macrophyric basaltic to hawaiitic lava (Markle type). At the base of the member in the Kilbirnie Hills thin beds of purple nodular tuff with intercalated fine-grained red marls are developed locally, for example east and south east of Bradshaw [NS 24 53]. A single flow of more-mafic olivine-pyroxene-macrophyric basalt (ankaramite) occurs within the member on the north slope of Castle Hill at Largs [NS 220 589]."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the more-mafic olivine-microphyric basalts (Dalmeny type) of the Largs Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4688 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 110 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the non-porphyritic mugearites and olivine-free plagioclase-macrophyric hawaiites and basaltic hawaiites (Markle type) of the Strathgryfe Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Greeto Lavas [Obsolete: use GRLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Hawaiite and plagioclase-microphyric basalt with subsidiary plagioclase-macrophyric basalt and trace olivine-macrophyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GRLA"@en ;
    skos:prefLabel "Greeto Lava Member"@en ;
.

