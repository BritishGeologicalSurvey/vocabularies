namedrockunit:BBSF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, medium to dark grey, micaceous, calcareous, bioclastic, with thin to thick blue-grey, argillaceous, very fossiliferous limestones, thin calciturbidites and sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable with underlying siltstone/sandstone dominated sequence of the Drumchorick Siltstone Formation and Mullaghmore Sandstone Formation (only in type area)."@en ;
