        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Metasandstone; arenite, locally quartzose and microconglomerate, with minor semipelite abundant locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transition from interbedded semipelite and arenite (Ben Lui Schist Formation) upwards into quartzose arenites. Locally metalimestone (Loch Tay Limestone Formation) is present. Metadolerite sills also intruded along contact zone in type area."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H652 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.1000m maximum (estimated)"@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of chloritic, more matrix-rich greenish to green and commonly rusty weathering arenites and wackes (at the base of the Loch Katrine Volcaniclastic Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ben Ledi Grits [Obsolete: use ARES, CISA, LDBU]"@en ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Metamudstone, metasandstone and quartzite with subsidiary semipelite. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ARES"@en ;
    skos:prefLabel "Ardnandave Sandstone Formation"@en ;
