namedrockunit:UOST
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "This Member records the major Callovian transgression in Europe. Mudstone and siltstones predominate with a low-diversity bivalve fauna. \"Ostrea\" is anomalous as they are not the dominant fossils. Unit is present in the Staffin Bay area of northern Skye, but absent farther south."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp base, dark clay with plant fragments, thin shell beds of Neomiodon and Isognomon, mudstones and shell-rich beds - indicative of a gentle, lagoonal transgression."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "11m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradationally overlain by sandstone of the 'Belemnite Sands'."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STBA ;
    skos:definition "Calcareous mudstone, mudstone and siltstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UOST"@en ;
    skos:prefLabel "Upper Ostrea Member"@en ;
.

