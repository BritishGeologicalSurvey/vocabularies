    lexicon:hasThicknessDescription "Thickness in the type area is 275m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp sedimentary break. Dark grey glauconitic sandstones of the formation are overlain by red mudstone of Purley Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
