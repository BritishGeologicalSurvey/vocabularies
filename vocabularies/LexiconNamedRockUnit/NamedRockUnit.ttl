    lexicon:hasThicknessDescription "600m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally faulted, but evidence locally of angular unconformity with various lithologies of Arenig age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasYoungestAgeValue 4.869e+02 ;
