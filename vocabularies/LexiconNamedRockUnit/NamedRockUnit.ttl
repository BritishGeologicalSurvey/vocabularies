namedrockunit:ULGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clast-supported, crudely bedded, cobble-grade, glaciofluvial gravel with sporadic intercalated sand beds. Clasts are typically rounded-subrounded and imbricated. Structures in the gravel include normal grading and large-scale planar cross beds; sandy units occasionally preserve ripple bedding, silt stringers and evidence of current reworking."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on, and locally oversteps, older glacial units."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">30 m thick at Ullapool."@en ;
    lexicon:hasUpperBoundaryDefinition "Locally overlain by the Allt an t-Srathain Member. More commonly exposed at or near to present day land surface, or sea bed where submerged."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:NWHG ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ULGR"@en ;
    skos:prefLabel "Ullapool Gravel Formation"@en ;
.

