    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "135-300m"@en ;
    lexicon:hasUpperBoundaryDefinition "From Exminster southwards Heavitree Breccia is overlain by and interdigates with the Dawlish Sandstone. North of Exminster Heavitree Breccia is overlain fairly sharply by Dawlish Sandstone. In the Hill Barton area (SX 956 928) thin Heavitree Breccia is overlain fairly sharply by Monkerton Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
