namedrockunit:PECH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Banded glassy cherts and siliceous (cherty) mudstones with subordinate thin siltstone and silicified crinoidal limestone beds, and scattered beds of pebbly quartzose sandstone, arranged in thickening-upwards cycles. Petrographic studies suggest that recrystalised radiolaria tests and rod-shaped sponge spicules are locally abundant in some of the cherts. The Pentre Chert Formation represents an offshore to basinal early Namurian facies deposited across the northern sector of the former Dinantian limestone platform, in a setting isolated from coarser grade siliclastic contamination, but in which sponges and radiolaria where abundant. The formation also exhibits the effects of extensive secondary silicification."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable or disconformable contact between the chert lithologies of the Pentre Chert Formation and mudstones of the Teilia Formation around Prestatyn, or, to the south, with limestones of the Cefn Mawr Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:HAF ,
        namedrockunit:S642 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 180m"@en ;
    lexicon:hasUpperBoundaryDefinition "Chert/mudstone contact taken as the base of the Bowland Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chert Beds [Obsolete: use BHC, PECH, COH, SHWK, WHCH]"@en ,
        "Halkyn Formation [Obsolete: use BSG, CFS, GS, PECH]"@en ;
    skos:broader namedrockunit:CRAV ;
    skos:definition "Chert with subsidiary limestone, mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PECH"@en ;
    skos:prefLabel "Pentre Chert Formation"@en ;
.

