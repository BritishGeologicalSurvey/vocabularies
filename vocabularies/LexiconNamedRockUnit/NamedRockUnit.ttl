namedrockunit:MGSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly subarkosic to arkosic, fine- to coarse-grained, locally granulitic, generally poorly sorted sandstones. Sandstones are mostly structureless. Thin bedded sandstones also occur and exhibit ripple and parallel lamination. Heterogeneous muddy sandstone or sandy mudstones also present and contain sandstone and mudstone clasts, contorted sandstone pipes, contorted beds and balls of sandstone. See De'Ath and Schuyleman (1981) and Richards et al. (1981)."@en ;
    lexicon:hasLowerBoundaryDefinition "A down-section transition from sandstone or interbedded mudstone and sandstone to predominantly mudstone. The boundary is marked by a down-section increase in average gamma ray values and commonly by a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Highly variable up to c. 200 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by a down-section change from high gamma mudstones (Kimmeridge Clay) to sandstones accompanied by a down-section decrease in gamma ray values and increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KC ;
    skos:definition "Sandstone with subsidiary sandy mudstone. Stratified bedrock. Occurs offshore. Deposited during the Kimmeridgian Age - to - Tithonian Age (Jurassic Period) (154.8-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MGSA"@en ;
    skos:prefLabel "Magnus Sandstone Member"@en ;
.

