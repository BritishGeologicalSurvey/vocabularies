        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises the younger of the two pre-Devensian glacial successions identified in the Birmingham area. Predominantly sands and tills, which characteristically lack Scottish and Lake Districts erratics (which characterize the Devensian Stockport Glacigenic Formation), and northern and eastern (e.g. Cretaceous) erratics (which are found in the pre-Devensian Wolston Formation). At the type section it comprises glacigenic reddish-brown and orange sand with clay partings, overlain by reddish brown till with Trias (mainly Bunter quartz/quartzite) and Upper Carboniferous erratics; similar deposits of sand and gravel occur at Nechells. At both localities overlies the organic Quinton Beds (\"Hoxnian\"). Full geographic extent and thus full range of lithology uncertain. Precise age and correlation contentious."@en ;
    lexicon:hasLowerBoundaryDefinition "At type locality and Nechells, overlies the organic Quinton Peat Formation (Hoxnian). More generally, inferred to rest upon Nurseries Glacigenic Formation or Permo-Triassic or Palaeozoic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1097 ,
        namedrockunit:H494 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 8 m at type locality; elsewhere may be represented by up to 50 m of deposits."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or various younger Quaternary deposits (head, fluvial deposits). Remnants may be present inside the Devensian limit beneath the Stockport Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Upper Glacial Series [Obsolete: use RIDG]"@en ,
        "Western Drift [Obsolete: use NURS, RIDG]"@en ;
    skos:broader namedrockunit:ALBI ;
    skos:definition "Diamicton, gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RIDG"@en ;
    skos:prefLabel "Ridgacre Formation"@en ;
.

