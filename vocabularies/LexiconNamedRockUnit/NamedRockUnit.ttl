namedrockunit:MSYT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Extremely dense, moderate to pale reddish brown (Munsell Soil) cobbly sandy clay diamicton, mainly matrix-supported, with clasts predominantly of Borrowdale Volcanic Group lithologies (rhyolite, welded tuff, slate)."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp, undulating to uneven, unconformable contact with bedrock, but locally a sharp, probably planar contact with extremely stiff, reddish brown, gravelly sandy clay diamicton of the Drigg Till Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, draped, unconformable contact with overlying thinly laminated (varved) silt and clay of the Stubble Green Silt Member of the Carleton Silt Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CCGL ;
    skos:definition "Diamicton with subsidiary gravel and trace clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MSYT"@en ;
    skos:prefLabel "Maudsyke Till Formation"@en ;
