        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stratigraphically complex glacigenic sequence of local provenance, including laminated and massive muds with dropstones, interstratified gravel sand and mud, and muddy diamicton."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformably overlies diamictons, sands and gravels (that contain exotic clasts) of the Orrisdale Formation. The unit crops out along the northwest coast of the Isle of Man."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Unrecorded, but diagrams suggest >10m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by peat, organic mud and calcareous marl of the Glen Balleira Formation that infills kettlehole basins."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
