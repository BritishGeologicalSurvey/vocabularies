        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Polymictic conglomerate, sandstone and breccia."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at a sharp, well-defined unconformity.  The base of the unit is taken at the lowermost pebbly sandstone unit overlying a pebble-free sandstone sequence. Rests on Lower Palaeozoic strata of the Lower Comley Sandstone or \"Dolgelly Beds\"."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3112 ,
        namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40.35m maximum proved (incomplete thickness, top not present) from Lilleshall L8 Borehole (SJ71NW/34)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is assumed to be unconformable or transitional. It is taken at the uppermost sandstone below a sandstone and limestone-dominated sequence of the Jackie Parr Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
