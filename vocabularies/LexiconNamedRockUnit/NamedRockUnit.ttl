namedrockunit:CAPT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pelite, locally graphitic at base (John Legg's Well Graphitic Schist Member) and in central-upper part at coast, but less graphitic with rare metalimestone bands inland, passing upward into semipelite, flaggy. Prominent staurolite at Castle Point, and locally kyanite-bearing."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transition from psammite and quartzite, through thin semipelite to graphitic pelite (John Legg's Well Graphitic Schist Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DBPB ,
        namedrockunit:H4514 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.300 to 400m at coast, though there is duplication by folding and thrusting. Inland as far as the south end of Fordyce Hill, only about 100m is present between a major ductile shear zone and the Portsoy basic intrusion. East of Knock Hill [near NJ 550 550] the poorly exposed pelitic rocks cannot be differentiated from those of the Portsoy Limestone Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Transition to thin banded metalimestones and calcareous semipelites (Sandy Pots Limestone Member) at base of Portsoy Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Part Of Portsoy Group [Obsolete: use CAPT]"@en ,
        "Portsoy Group [Obsolete: use CAPT, PTSL]"@en ;
    skos:broader namedrockunit:DBED ;
    skos:definition "Graphitic pelite, pelite and semipelite and trace calcareous pelite, calcareous semipelite, calcsilicate-rock and metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CAPT"@en ;
    skos:prefLabel "Castle Point Pelite Formation"@en ;
