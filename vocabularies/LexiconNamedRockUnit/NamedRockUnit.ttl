    skos:definition "Mudstone and trace limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MAL"@en ;
    skos:prefLabel "Main Limestone Member (Ballycastle, Northern Ireland)"@en ;
.

namedrockunit:MALA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAROCM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Macroporphyritic mafic basalts: olivine-clinopyroxene-plagioclase-macrophyric basalt (Dunsapie type) and olivine-bearing plagioclase-macrophyric basalt (Markle type) with some olivine-clinopyroxene macrophyric basalt (Craiglockhart type or ankaramite)."@en ;
    lexicon:hasLowerBoundaryDefinition "Lavas of the Marshall Moor Lava Member are considerably more mafic than those of the underlying Strathgryfe Lava Member. The abrupt change may imply a significant time interval between the two petrologically distinct volcanic episodes."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4178 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 75 m."@en ;
    lexicon:hasUpperBoundaryDefinition "A distinct and obvious petrographic change distinguishes the macroporphyritic mafic basalts (Dunsapie and Craiglockhart types) of the Marshall Moor Lava Member from the overlying microporphyritic mafic basalts (mainly Dalmeny type) of the Kilbarchan Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Marshal Moor Lavas [Obsolete: use MALA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Olivine-clinopyroxene-plagioclase-macrophyric basalt with subsidiary olivine-clinopyroxene-macrophyric basaltic-rock. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MALA"@en ;
    skos:prefLabel "Marshall Moor Lava Member"@en ;
.

