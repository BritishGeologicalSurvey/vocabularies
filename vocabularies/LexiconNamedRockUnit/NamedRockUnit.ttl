namedrockunit:KNM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unbedded grey micrites arranged as lenticular mounds with bedded cover and off-mound limestones. Limestones of Dartry Formation everywhere comprise dark grey, bedded argillaceous micrites, invariably with bedded blue-black chert (secondary)."@en ;
    lexicon:hasLowerBoundaryDefinition "(1) Completely enclosed by bedded argillaceous limestones of the Dartry Formation. (2) Occurs at base of formation where it is underlain by limestones of the Glencar Formation. (3) Occurs at top of Dartry Formation where it may be overlain by either Meenymore Formation or sandstones of the Glenade Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100 to 130m in type section; 0 to 290m elsewhere."@en ;
    lexicon:hasUpperBoundaryDefinition "See Lower Boundary details."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
