    lexicon:hasLithologyDescription "Interstratified sequence dominated by Sand and Gravel. Subsidiary lithologies: Reddish brown glacial Diamicton(till), Silt and Clay. Lithologically very heterogeneous. Gravel and diamicton dominate at the type section; fine-to medium-grained sand and silt dominate in many surface exposures. These show extensive small-scale normal faulting and some low-angle glacitectonic thrusting."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed, but probably a gradational contact on till of the Gretna Till Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 12m thick at type section; at least 7.4 to 11.3m proved in adjacent boreholes."@en ;
    lexicon:hasUpperBoundaryDefinition "Normally the ground surface; locally overlain by Holocene peat in hollows in the moraine surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KEMO ;
    skos:definition "Diamicton, gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MMO"@en ;
    skos:prefLabel "Marchfield Moraine Member"@en ;
.

