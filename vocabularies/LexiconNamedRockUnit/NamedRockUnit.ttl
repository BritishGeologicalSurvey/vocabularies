    lexicon:hasThicknessDescription "Ranging from 2.4m to 2.9m in East Lothian"@en ;
    lexicon:hasUpperBoundaryDefinition "Usually a conformable change to sandstone within the Lower Limestone Formation, which separates this from the Barns Ness Limestone (now the Mid Hosie Limestone) about 10m above,"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:MAHO ;
