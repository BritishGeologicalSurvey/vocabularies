namedrockunit:TCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Tom Croft Limestone Formation comprises mid to dark grey, poorly bedded biosparites (grainstone containing peloids, shelly debris, crinoid fragments and variable quantities of dolomite grains). The formation includes a macrofauna comparable with that of the Dalton Beds of south Cumbria (see Rose and Dunham 1977) and may include a thin basal unit of limestone breccia with siltstone and quartz pebbles. \r
\r
Shallow marine carbonate. Arundian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is disconformable on the limestone, dolostone, sandstone and siltstone of the Penny Farm Gill Formation, Ravenstonedale Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is 60-80 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation underlies the diachronous Ashfell Sandstone Formation in the Stainmore Trough and the same formation and the Fawes Wood Limestone Formation on the Askrigg Block."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TCL"@en ;
    skos:prefLabel "Tom Croft Limestone Formation"@en ;
.

