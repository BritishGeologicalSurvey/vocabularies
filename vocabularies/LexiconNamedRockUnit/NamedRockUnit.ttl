    lexicon:hasThicknessDescription "Unknown: strongly deformed."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by rocks of the Queyfirth Group (QYFH) (equivalent of Dalradian), separated by a shear zone (Virdibreck Shear Zone)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
