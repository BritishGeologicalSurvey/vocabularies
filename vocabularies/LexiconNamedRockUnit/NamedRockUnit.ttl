namedrockunit:GACH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Locally a 10-20 m thick garnetiferous semipelite unit at the base, followed by tabular trough cross-bedded psammite interbedded with garnetiferous semipelite in fining -upwards sequences. At the top of the formation is another c. 10-20 m thick garnetiferous semipelite with locally thin quartzite."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the remainder of the Altnaharra Psammite Formation (GLPS). Incoming of significant (>2 m) garnet-bearing semipelite layers."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 500 (estimated maximum); thinner to SW and NE."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Glascarnoch Psammite Formation (GLPS). Boundary set above uppermost limit of thick (>2 m) garnet-bearing semipelite units. A discontinuous quartzite bed forms the very top of the Member in some outcrops."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ALPS ;
    skos:definition "Psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GACH"@en ;
    skos:prefLabel "Glen Achall Psammite and Semipelite Member"@en ;
.

namedrockunit:GACO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A poorly sorted, matrix supported, planar bedded, conglomerate with clasts of quartzite, quartz and igneous lithologies."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp contact with the purple and reddish-grey, sublithic sandstone of the undivided Ruchill Flagstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 20 - 25 m between Gartmore House and Shannochill, increasing to 100 m thickness at Lochan Balloch [NN 592 043]."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp contact with the Cromlix Mudstone Formation, which comprises a poorly sorted silty sandstone around Gartartan, commonly with a thin conglomerate bed 30 - 40 m above the junction. North-eastwards, basal Cromlix beds exhibit a transition to a fine-grained, massive, well-sorted sandstone, eg; at Over Shannochil [NS 5428 9930]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RLF ;
    skos:definition "Conglomerate with subsidiary pebbly (gravelly) sandstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GACO"@en ;
    skos:prefLabel "Gartartan Conglomerate Member"@en ;
.

