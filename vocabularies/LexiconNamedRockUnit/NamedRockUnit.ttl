namedrockunit:BYTRC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QTR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCCNG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Bangley Trachytic Member consists of purple and blue-grey trachytic lavas with both feldspar-phyric (sodic plagioclase to sanidine) porphyritic and non-porphyritic types. Individual flows are known to be over 20m thick. Quartz-trachytes are also present. Red, brown and purple trachytic tuff and lapilli tuff with agglomerate and some sedimentary volcaniclastic rocks also are interbedded in units known to be at least 8m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is apparently conformable on the Hailes Lava Member that consists of basaltic lavas and volcaniclastic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3264 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 160m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the siliciclastic sedimentary rocks of the Gullane Formation (Strathclyde Group). The contact is considered unconformable with volcaniclastic conglomerate recorded locally at the base of the overlying formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bangley Member [Obsolete: use BYTRC]"@en ;
    skos:broader namedrockunit:GHV ;
    skos:definition "Quartz-trachyte and trachyte with subsidiary agglomerate, lapilli-tuff and trachytic tuff and trace trachybasalt, volcaniclastic-conglomerate and volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BYTRC"@en ;
    skos:prefLabel "Bangley Trachytic Member"@en ;
.

