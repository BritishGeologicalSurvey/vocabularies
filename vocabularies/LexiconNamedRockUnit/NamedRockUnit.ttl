    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "To 3200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity with overlying Carboniferous strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Binsey Formation [Obsolete: use EVG]"@en ,
        "Eycott Group [Obsolete: use EVG]"@en ,
        "Eycott Lava [Obsolete: use EVG]"@en ,
        "High Ireby Formation [Obsolete: use EVG]"@en ,
        "Undifferentiated part of Borrowdale Volcanic Group [Obsolete: use EVG]"@en ;
    skos:definition "Andesite with subsidiary andesitic lapilli-tuff, andesitic tuff, basaltic-andesite, dacite, lapilli-tuff, pyroclastic-breccia, rhyolitic lapilli-tuff, volcaniclastic rocks (both pyroclastic and reworked volcanic rocks) and volcaniclastic-sandstone and trace volcaniclastic-conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
