namedrockunit:USHP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, siliceous and feldspathic, numerous thin gritty to pebbly psammite layers, rare calc-silicate layers. Sparse, thin garnetiferous gneissose pelite layers. Beds 20-100 cm; cross-bedding common; possibly herring bone cross-beds. Near top, interbedded psammite and pelite - transitional into the Laggan Mor Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Shiaba Pelite Formation (SAPE). Relatively sharp boundary."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 1700 m (estimate - post-deformational thickness)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by Laggan Mor Formation (LAMO). Transitional boundary: increase in interbedded semipelite beds."@en ;
