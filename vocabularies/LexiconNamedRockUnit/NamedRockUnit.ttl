namedrockunit:TRBB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Red, calcretised siltstones with grey to brown massive limestone or dolomite calcretes, sporadic thin sandstones and extraformational and intraformational conglomerates. \r
\r
Ephemeral nonsaline playa lakes (Allen, 1965a). \r
\r
Age not known, but likely to be late Silurian to Early Devonian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is transitional, and placed where the conglomerates of the underlying Bodafon Formation are overlain by red siltstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 165 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at an erosion surface cut in a thick, massive calcrete at the top of the formation on the south side of Traeth yr Ora, where extraformational conglomerate at the base of the Porth-y-Mor Formation is overlain by the calcrete. Note that this is higher than the position cited by Allen (1965a) (Davies, 2005). To the south, the formation is cut out by an unconformity at the base of the Porth-y-Mor Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DULB ;
    skos:definition "Siltstone with subsidiary conglomerate, limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Silurian Period - to - Early Devonian Epoch (Devonian Period) (443.1-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TRBB"@en ;
    skos:prefLabel "Traeth Bach Formation"@en ;
.

