    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bruar Psammite Formation [Obsolete: use GCKP]"@en ;
    skos:broader namedrockunit:GRAM ;
    skos:definition "Micaceous psammite and psammite with subsidiary quartzose psammite and semipelite and trace calcsilicate-rock and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DRMO"@en ;
    skos:prefLabel "Drumochter Succession"@en ;
.

