    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "In the Haddon Fields Borehole the member is 85.5m thick. At Lathkill Dale there is about 5m of lava."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Haddon Fields Borehole basalt of the Lathkill Lodge Lava Member is overlain by pale grey and cherty limestones with some calcilutites, included within the Fallgate Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
