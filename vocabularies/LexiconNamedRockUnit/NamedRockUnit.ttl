namedrockunit:EGTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTNS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red-brown sandy, silty, matrix-supported diamicton with isolated drop-stone cobbles of Moine psammite."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type section, an erosional contact on glaciofluvial outwash of the Main Late Devensian Glaciation; elsewhere mapping indicates unconformable contact on Old Red Sandstone bedrock. The till also interdigitates with the lower parts of the Hempriggs Sand Member locally."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 2.5 m thick at its type section; mapping indicates that the unit may reach 3 to 4 m in thickness locally."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the base of the Hempriggs Sand Member, but the latter may also interdigitate with the East Grange Till Member locally."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRHS ;
    skos:definition "Sandy diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EGTI"@en ;
    skos:prefLabel "East Grange Till Member"@en ;
