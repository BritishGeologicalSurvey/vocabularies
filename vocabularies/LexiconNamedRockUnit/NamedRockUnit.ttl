namedrockunit:BCSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to medium-grained, moderately well sorted sandstones with sporadic, intercalated mudstones that attain a thickness of several metres."@en ;
    lexicon:hasLowerBoundaryDefinition "A downward transition from sandstones to organic-rich mudstones (Kimmeridge Clay Formation, undifferentiated). The boundary is marked by a sharp increase in gamma-ray values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 55 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is normally placed at a downward change from mudstones or marls (Cromer Knoll Group) to sandstones. However, a very thin veneer of mudstone (Kimmeridge Clay) may overlie the uppermost sandstone unit and where this occurs, it has been included within the Birch Sandstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
