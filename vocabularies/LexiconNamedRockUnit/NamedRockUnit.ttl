namedrockunit:INVBR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and black, laminated, bituminous fissile mudstones, some of which approach oil shale composition. Two coals are developed in this succession, including a thin coal developed about 8 m below the top of the formation and a prominent seam, 1 m thick, forming the uppermost bed and termed the Brora Coal (Bed) (BRORC)."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies Bed 1 of the Doll Member (DOLL)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the prominent 1 m thick seam termed the Brora Coal (Bed) (BRORC)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BOCO ;
    skos:definition "Bituminous mudstone with subsidiary coal. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "INVBR"@en ;
    skos:prefLabel "Inverbrora Member"@en ;
.

namedrockunit:INVL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Feldspathic and siliceous psammite and feldspathic quartzite with interbedded layers of semipelite. Minor micaceous psammite locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional boundary, the lower boundary placed where thicker and laterally more extensive psammites become dominant and the semipelites of the underlying Clachaig Semipelite and Psammite Formation become scarce."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 900m"@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional contact where psammites and quartzites are replaced by semipelite-dominated succession of the overlying Appin Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRGS ;
    skos:definition "Micaceous psammite and psammite with subsidiary feldspathic quartzite, gneissose micaceous psammite, gneissose psammite, quartzite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "INVL"@en ;
    skos:prefLabel "Inverlair Psammite Formation"@en ;
.

namedrockunit:INVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFAMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Most of the Inge Volcanics Formation is composed of red and purple weathered tuffs and purple, reddish grey, and occasionally dark green basalts; the latter may include extrusive and intrusive rocks. The tuffs are hard and cindery, and they contain feldspar laths and occasional glassy shards. Grains of chlorite locally give the tuffs a speckled appearance. Well 31/26-3 terminated in 79 m of amygdaloidal basaltic lavas, but individual basalt units are less than 20 m thick in other wells. The basalts contain pyroxene phenocrysts and possible serpentine pseudomorphs of olivine in a feldspar pyroxene groundmass."@en ;
    lexicon:hasLowerBoundaryDefinition "Only three wells have drilled through the base of the Inge Volcanics Formation in the UK sector. Secondarily reddened sandstones and mudstones of possible Carboniferous age have been recorded beneath the volcanics in wells 39/1-1 and 39/2-1, and the Inge Volcanics Formation rests unconformably on Devonian strata in well 30/25b-3. The base of the formation is a sharp wireline-log break in all three wells."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Well 31/26-1 has encountered the thickest section of Lower Permian volcanics so far (349 m) but terminated above their base. The Inge Volcanics Formation thins westwards and southwards from there, being only 51 m thick in well 30/25b-3 and 205 m thick in well 39/2-1. Records from well 211/11b-4 indicate that Early Permian volcanics are at least 77 m thick in parts of the East Shetland Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "Where Lower Permian sandstones and mudstones of the Auk Formation rest on the basal Permian section in Quadrant 31, the top of the Inge Volcanics Formation is defined by the uppermost occurrence of volcanics. The boundary is marked by a conspicuous wireline-log break in most wells, as in 31/26-1. Locally, Upper Permian sediments of the Zechstein Group overstep the Auk Formation to rest on the volcanics, and in such areas the boundary is clearly defined by contrasts in lithology and wireline-log character (e.g. 39/2-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RLG ;
    skos:definition "Basalt and tuff with subsidiary mudstone and tuffaceous-mudstone and trace sandstone. Stratified bedrock. Occurs offshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "INVO"@en ;
    skos:prefLabel "Inge Volcanics Formation"@en ;
.

