namedrockunit:CGA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """White quartz arenite, thin or medium bedded, but locally thick or very thick bedded. In the lower part sandstone is interbedded with laminated siltstone and mudstone, but this passes upwards into thin persistent interbeds of dark grey silty mudstone. The sandstone is massive to weakly graded and slump folding is widely developed. Deposition was from medium concentration turbidity currents (Woodcock et al., 1999). Further description is given by Chadwick et al. (2001, p. 24-25). \r
\r
A sparse, low-diversity acritarch flora is not diagnostic and the probable Arenig age is extrapolated from the overlying Maughold Mudstone and underlying Lonan Sandstone formations."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base is transitional from the underlying Lonan Sandstone Formation with quartz arenite beds becoming increasingly abundant over an interval of several tens of metres within mudstone of Lonan Sandstone Formation type; the base of the Creg Agneash Formation is taken where quartz arenite becomes the dominant lithology."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:AGNG ,
        namedrockunit:H2687 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 180 m and possibly up to 750 m though there may be some repetition by folding."@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional into the overlying Maughold Formation; sandstone beds progressively decrease in number and top is taken at the abrupt change to laminated silty mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Agneash Grit (Manx Slates) [Obsolete: use CGA]"@en ,
        "Maughold Banded Group [Obsolete: use MGD, CGA, CRMR, MHL]"@en ;
    skos:broader namedrockunit:MANX ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CGA"@en ;
    skos:prefLabel "Creg Agneash Sandstone Formation"@en ;
.

