namedrockunit:CUQU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale quartzites, mostly pure; thickly bedded with trough cross-bedding and large channel fills, to flaggy and more planar bedded."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of thick-bedded quartzites (not seen in any of the exposures)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DACQ ;
