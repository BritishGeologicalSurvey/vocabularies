namedrockunit:DRG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRAND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use CRN, DRCR] Conglomerate, clast-supported, with well-rounded boulders, cobbles and pebbles predominantly of lava, psammite and quartzite. Lenses and thicker formations of lithic and volcaniclastic sandstone. Trachybasalt and trachyandesite lavas are interbedded with conglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of Downie Point Conglomerate Member, where thickly-bedded or massive conglomerate overlies pebbly sandstone of Carron Sandstone Formation with apparent conformity. This marks the base of a thick, conglomerate-dominated succession."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H871 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Variable, maximum of 2600m, thinning westwards to less than 1500m. Presumed to be overlapped by younger groups to south-west."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, presumed to pass up conformably into conglomerate of Crawton Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    lexicon:isObsoleteEquivalentOf
        namedrockunit:CRN ,
        namedrockunit:DRCR ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Carron Sandstone Formation"@en ,
        "Dunnottar Conglomerate [Obsolete: use DRG]"@en ,
        "Dunnottar-Crawton Group"@en ;
    skos:definition "Obsolete name. Conglomerate with subsidiary sandstone, trachyandesite and trachybasalt. Stratified bedrock. Occurs onshore. Deposited during the Silurian Period - to - Early Devonian Epoch (Devonian Period) (443.1-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DRG"@en ;
    skos:prefLabel "Dunnottar Group [Obsolete: use CRN, DRCR]"@en ;
.

