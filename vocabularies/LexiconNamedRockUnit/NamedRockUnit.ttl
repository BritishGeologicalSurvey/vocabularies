    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "In excess of 200 m - difficult to estimate due to complex fold patterns."@en ;
    lexicon:hasUpperBoundaryDefinition "Poorly exposed, incoming of well-bedded psammites [turbiditic] of the Loch Laggan Psammite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
