    skos:altLabel
        "Alveley Member"@en ,
        "Halesowen Formation"@en ,
        "Keele Beds [Obsolete: use RWD, ALY, KE]"@en ,
        "Keele Formation [Duplicate 1: use KE]"@en ,
        "Keele Group [Obsolete: use KE]"@en ,
        "Keele Sandstone Series [Obsolete: use KE]"@en ,
        "Meriden Formation [Obsolete: use SAL]"@en ,
        "Salop Formation"@en ;
    skos:definition "Obsolete name. Mudstone and sandstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Westphalian Stage - to - Stephanian Stage (Carboniferous Period) (319-300.5 Ma BP)."@en ;
