    skos:broader namedrockunit:MO ;
    skos:definition "Basalt. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SWB"@en ;
    skos:prefLabel "Shacklow Wood Lava Member"@en ;
.

namedrockunit:SWCL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S968 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Swinley Clay Member consists of several metres thickness of organic laminated clay, which is white, grey, pale purple, brown or yellow in colour, with flasers and laminae of fine-grained sand and silt.\r
In the BGS Bracknell Borehole, the Swinley Clay comprises about 4m of dominantly dark grey to brown organic-rich (lignitic) laminated clays with laminae of fine sand and thin beds of medium-grained sand. Plant debris, including lignite, is common and glauconite is almost absent. The top of the unit has been bleached and oxidised, and has root traces. It appears to represent a soil horizon (King, unpublished report to BGS, 1996)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Swinley Clay Formation is a sharply-defined, probably erosional contact with the underlying non-glauconitic sands of the typical Bagshot Formation (Ellison et al., 2002)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5095 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 8m in the Guildford district (Ellison et al., 2002). The unit varies regionally in thickness, due to its highly erosional basal contact."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Swinley Clay Member is an interburrowed and brecciated surface with root traces, taken to represent an eroded emergent surface, overlain by glauconitic sands, silts and clays of the Windlesham Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Unit of the Middle Bagshot Beds [Obsolete: use SWCL]"@en ,
        "Swinley Member"@en ;
    skos:broader namedrockunit:BGS ;
    skos:definition "Clay and trace sand and silt. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age - to - Lutetian Age (Palaeogene Period) (56-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SWCL"@en ;
    skos:prefLabel "Swinley Clay Member"@en ;
.

namedrockunit:SYCM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:H3938 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FESTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstone, yellow-grey siltstone and yellow weathering, fine- to coarse-grained, (fluvial, fluvio-deltaic and paralic lithofacies). Sandstones are commonly cross-bedded with sharp erosional bases and channel-fill bedforms. Thin coal seams, seatearth mudstone and nodular sideritic ironstone beds are present locally. Plant fragments and plant rootlets are common in some beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable, or disconformable, at the abrupt upward transition from fossiliferous (marine) mudstone and ripple cross-laminated sandstone of the Eller Beck Formation to to cross-stratified, plant debris-rich sandstone, siltstone and mudstone of the Sycarham Member (Cloughton Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LET ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 50m on the North Yorkshire coast between Whitby and Cloughton Wyke [TA 020 950]; 20 to 30m (thinning southwards) on the western margin of the North Yorks Moors and Hambleton Hills (Powell et al., 1992; Frost, 1998)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable, taken at the abrupt transition from sandstone, siltstone and mudstone with plant remains (Sycarham Member) to marine (Lebberston Member) strata comprising pale grey, shelly ooidal limestone (\"Whitwell Oolite\" facies; Howardian Hills [SE 72 65]) or yellow, shelly calcareous sandstone with bivalves (\"Millepore Bed\" facies; Yons Nab [TA 084 844], south of Scarborough)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Estuarine \"Series\" [Obsolete: use CLH, GRF, SWK, EBB, SYCM]"@en ,
        "Middle Deltaic Series [Obsolete: use CLH, GRPE]"@en ;
    skos:broader namedrockunit:CLH ;
    skos:definition "Mudstone, sandstone and siltstone and trace coal, nodular ironstone and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SYCM"@en ;
    skos:prefLabel "Sycarham Member"@en ;
.

namedrockunit:SYCN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Buff, fine-grained, bedded dolostones (dolomitised skeletal packstones)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is gradational, with thinly bedded grey mudstones and skeletal packstones of the underlying Cwmyniscoy Mudstone Formation, interbedded with thin, fine-grained dolostones of the Sychnant Dolomite Formation. The base of the latter is placed at the base of the dolostone overlying the highest grey mudstone bed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4357 ,
        namedrockunit:H4913 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
