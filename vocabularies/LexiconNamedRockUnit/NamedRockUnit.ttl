namedrockunit:BODA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Conglomerates and pebbly sandstones with abundant clasts of the adjacent Precambrian and Ordovician rocks. \r
\r
Basin-margin alluvial fan deposition of gravels sourced from Precambrian and older lower Palaeozoic rocks to the south-west. \r
\r
Age not known, but probably late Silurian to Early Devonian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the formation is an unconformity, where the lowest conglomerate of the Bodafon Formation rests on the underlying lower Palaeozoic or Precambrian rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5245 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3 to 45 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the top of the main conglomerate development, where fine-grained calcareous strata of the Traeth Bach Formation overlie the conglomerates. The boundary is gradational, the conglomerates interfingering with both the Traeth Bach and Porth-y-Mor formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bodafon Beds [Obsolete: use BODA]"@en ;
    skos:broader namedrockunit:DULB ;
