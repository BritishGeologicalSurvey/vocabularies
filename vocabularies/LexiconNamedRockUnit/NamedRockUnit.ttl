namedrockunit:KNHG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELSCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPSCH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded psammite, locally pebbly, semipelite and pelite in graded units. Finer-grained beds metamorphosed to slates, phyllites and mica-schists. Minor calc-silicate pods. Contains andalusite, cordierite and locally staurolite porphyroblasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Change from calcareous semipelite and psammite to non-calcareous psammite-dominated lithologies at top of Whitehills Grit Formation; commonly marked by change to locally coarsely gritty psammite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4132 ,
        namedrockunit:H4133 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.0.5km; relatively little repetition by folding."@en ;
    lexicon:hasUpperBoundaryDefinition "Transition to graded units with greater proportion of semipelite. Psammites only rarely pebbly."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Knock Head Grit [Obsolete: use KNHG]"@en ,
        "Uppermost part of Whitehills Group [Obsolete: use KNHG]"@en ;
    skos:broader namedrockunit:MCD ;
    skos:definition "Psammite with subsidiary schistose semipelite and semipelite and trace calcsilicate-rock, gritty psammite, pelite and schistose pelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KNHG"@en ;
    skos:prefLabel "Knock Head Grit Member"@en ;
.

namedrockunit:KPF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A soft, weakly-cemented, white, feldspathic sandstone, characterised by a marked variation in grain-size between adjacent laminae. The Knox Pulpit Sandstone Formation is probably continuous with the redundant Kemback Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Passes downwards into the Glenvale Sandstone Formation, or the Dura Den Member in the Cupar area. The formation is distinguished from those adjacent by characteristic sedimentary structures."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GKS ,
        namedrockunit:H2273 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 180m thick in the Lomond Hills area."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from the white or cream sandstones of the Knox Pulpit Sandstone Formation to the white, yellow or brown sandstones of the Kinnesswood Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Gargunnock Sandstone [Obsolete: use KPF, SCK]"@en ,
        "Knox Pulpit Formation [Obsolete: use KPF]"@en ;
    skos:broader namedrockunit:SAG ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Late Devonian Epoch (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KPF"@en ;
    skos:prefLabel "Knox Pulpit Sandstone Formation"@en ;
.

namedrockunit:KPSC
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:KUPF ,
        namedrockunit:MLSL ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Kupferschiefer Formation is typically composed of dark grey or dark brown silty, fissile mudstones, which are locally black and carbonaceous. The shales are variably calcareous, and they are commonly micaceous in the Inner Moray Firth. In the Argyll Field, the Kupferschiefer Formation is composed of dark grey dolomitic mudstones that are sapropelic, dolomicritic, well indurated, thinly laminated and subfissile, and contain stringers and veins of pyrite (Bifani, 1985). The formation is characterized by high gamma-ray values, and typically by low velocities, at least in the upper part."@en ;
    lexicon:hasLowerBoundaryDefinition "Whether the Kupferschiefer Formation rests conformably on Lower Permian desert sediments (Auk, Findhorn and Fraserburgh formations), or locally oversteps these onto pre-Permian strata, the base of the highly radioactive mudstones is a sharp wireline-log break in all wells."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is generally less than 3 m thick. Exceptionally, the formation is between 10 m and 15 m thick in parts of the Dutch Bank and East Shetland basins, and it is up to 20 m thick locally in the South Halibut Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "Over the Inner Moray Firth (e.g. 12/29-2), the top of the Kupferschiefer Formation is defined by a sharp downward change from sandstone (Bosies Bank Formation) or, rarely, from anhydrite (Turbot Anhydrite Formation) to mudstone, and is marked by a rapid downward increase in gamma-ray values. Elsewhere in the Northern Permian Basin, its top generally corresponds to a transition from dolomite or dolomitic limestone (Halibut Carbonate Formation) to mudstone. The lithological and wireline-log transitions are typically gradational, with the boundary in most sections being best located at a relatively sharp downward decrease in velocity (e.g. 15/26-1, 21/11-1). The boundary is more clearly transitional where the formation is expanded (e.g. 20/2-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kupferschiefer Formation [Duplicate: use KPSC]"@en ,
        "Marl Slate Formation"@en ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Mudstone. Stratified bedrock. Occurs offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KPSC"@en ;
    skos:prefLabel "Kupferschiefer Formation"@en ;
.

