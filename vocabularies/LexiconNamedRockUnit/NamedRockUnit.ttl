    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLSY"@en ;
    skos:prefLabel "Selsey Sand Formation"@en ;
.

namedrockunit:SLVY
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the fluvial, lacustrine and organic deposits of the River Slea and its tributaries. It includes floodplain alluvium, river terrace deposits, and the Sleaford Sands and Gravels of Berridge et al (1999). The floodplain comprises soft clays, silts and fine sands, with bodies of peat, overlying sands and gravels. The terrace deposits comprise sands, gravelly sands and sandy gravels, deposited by braided rivers in a periglacial environment. The pebbles include much buff ooidal limestone from the Lincolnshire Limestone Formation, and flint, ironstone and sandstone, and are up to c.40mm in diameter."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Middle Pleistocene glacial deposits, and on Jurassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2430 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sleaford Sands and Gravels [Obsolete: use SLVY]"@en ;
    skos:broader namedrockunit:ONCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
