namedrockunit:DOBP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Marine, quartz- and quartzite-rich flint gravel and sand. This member is characterised by c.10 per cent far-travelled material comprising mainly white or colourless quartzose rocks and the presence of Carboniferous and Rhaxella chert."@en ;
    lexicon:hasLowerBoundaryDefinition "Appears to be conformable on sand and gravel of the Norwich Crag Formation. Incoming of significant amounts of quartzose clasts defines lower boundary. The base of the formation is marked by a change from flint-dominated lithologies of the Norwich Crag Formation to an assemblage with Rhaxella chert and white/colourless quartzose clasts. The base of the member also coincides with the appearance of Macoma balthica."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H216 ,
        namedrockunit:WCG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to more than 10 m - maximum thickness unknown."@en ;
    lexicon:hasUpperBoundaryDefinition "At surface or overlain unconformably by Happisburgh Formation (previously known as Corton Formation) glacigenic deposits. Junction marked by change to fine-grained sands or stiff sandy till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bure Valley Beds [Obsolete: use DOBP, WRCG]"@en ,
        "Weybourne Crag [Obsolete: use DOBP, WRCG]"@en ;
    skos:broader namedrockunit:WRCG ;
    skos:definition "Gravel and sand with subsidiary silt and trace shelly silt. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DOBP"@en ;
    skos:prefLabel "Dobb's Plantation Member"@en ;
