namedrockunit:GRWC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Conglomerate of cobbles and boulders up to 250mm diameter but most clasts are less than 70mm,  mostly subrounded, consisting of greywacke, minor chert and quartzite, with a few sandstone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type section, defined as the lowest bed of conglomerate with predominant greywacke clasts overlying the Quarry Arenite Formation. Elsewhere generally unconformable on Lower Palaeozoic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1575 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 25 m to 560 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper surface of the highest bed of greywacke conglomerate below the overlying Swanshaw Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Greywacke Conglomerate [Obsolete: use GRWC]"@en ;
    skos:broader namedrockunit:LNK ;
    skos:definition "Conglomerate with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) - to - Early Devonian Epoch (Devonian Period) (432.9-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GRWC"@en ;
    skos:prefLabel "Greywacke Conglomerate Formation"@en ;
