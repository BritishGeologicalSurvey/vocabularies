namedrockunit:BRNS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, grey-brown weathering, silty, calcareous, fine sandstone, with shelly lenses, scattered mica grains and abundant burrows. Subordinate siltstone and mudstone beds. Fauna includes bivalves (including Pholadomya and Modiolus), forams, ammonites, belemnites and crinoids. Soil developed on outcrop is sandy, but may contain no brash."@en ;
    lexicon:hasLowerBoundaryDefinition "Change from silty mudstone and siltstone of the undifferentiated Charmouth Mudstone Formation into sandstone as above, may be a conglomerate at base; at 171.88m depth in type section Copper Hill Borehole (SK94SE/56)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1391 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1 to 4.5 m; 4.43 m in type section"@en ;
    lexicon:hasUpperBoundaryDefinition "Change from sandstone-dominated beds into mudstone and siltstone of undifferentiated Charmouth Mudstone Formation; at 167.45 m depth in type section Copper Hill Borehole (SK94SE/56)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
