namedrockunit:CMSL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silvery grey, calcareous slates that are commonly silty, with thin (< 0.3 m) grey fine-grained sandstones. Three distintive limestone beds occur within the sequence: Jenny Start Limestone (towards the base; 2 m to 10.5 m thick with an oolitic texture), Combe Martin Beach Limestone (towards the middle; 1.34 m thick - a ferruginous limestone with pyrite) and the David's Stone Limestone (towards the top; 9 m thick, comprising of two beds separated by slates, with locally abundant corals at Broadstrand Beach  [SS 5318 4797]. The top 5 m of the basal slates contain bands and lenses of detrital limestone up to 25 mm thick with crinoid debris."@en ;
    lexicon:hasLowerBoundaryDefinition "10 m above the top of the Holey Limestone (a lateral equivalent of Holwill's (1964) Rillage Limestone). Below the boundary, rocks assigned to the underlying Lester Slates-and-Sandstones, are sandstones and siltstones with abundant Chondrites; the rocks at the base of the Combe Martin Slates are silvery grey, calcareous slates that are commonly silty, with thin (< 0.3 m) grey fine-grained sandstones. Chondrites are less common in the Combe Martin Slates than in the underlying Lester Slates and Sandstones."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:MILFR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasOldestAgeValue 3.853e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "120 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Located 30 m above the top of the David's Stone Limestone (two beds of limestone separated by slates identified at [SS 5703 4742]); the boundary is distinguished by a change from limestones (below) to thickly-bedded sandstone (above) in the Combe Martin Slates."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasYoungestAgeValue 3.711e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Ilfracombe Beds [Obsolete: use CMSL]"@en ;
    skos:broader namedrockunit:IFS ;
    skos:definition "Limestone and slate with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Givetian Age - to - Frasnian Age (Devonian Period) (385.3-371.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CMSL"@en ;
    skos:prefLabel "Combe Martin Slates Member"@en ;
.

