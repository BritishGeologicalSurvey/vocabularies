    lexicon:hasThicknessDescription "320-660 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of the Bryn Sylldy Formation where part ribbon banded mudstones but more frequent silty mudstone is conformably overlain by graptolitic ribbon banded mudstones of the Upper Nantglyn Flags Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SH> ;
