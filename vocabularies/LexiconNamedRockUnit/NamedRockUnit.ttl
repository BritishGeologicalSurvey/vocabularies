namedrockunit:HRSC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Conglomerate, pebbly sandstone and coarse sandstone with a few scattered pebbles. Poorly sorted to unsorted with cobbles and boulders to 0.4 m; more commonly with smaller clasts of well-rounded quartzite, vein quartz, fine-grained acid igneous rocks, chert and greywacke."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of lowest bed of conglomerate above the Gully Redbeds."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:QZT ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "65-70 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Probably transitional upwards into the Quarry Arenite. Top is upper surface of highest conglomerate bed below the Quarry Arenite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Quartzite Conglomerate [Obsolete: use HRSC, MFD]"@en ;
    skos:broader namedrockunit:MKW ;
    skos:definition "Conglomerate, pebbly (gravelly) sandstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) - to - Early Devonian Epoch (Devonian Period) (432.9-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HRSC"@en ;
    skos:prefLabel "Hareshaw Conglomerate Formation"@en ;
.

