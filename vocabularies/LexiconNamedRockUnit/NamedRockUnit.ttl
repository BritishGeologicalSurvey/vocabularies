    lexicon:hasLithologyDescription "Limestone, massive, grey, fractured and veined; dolomitised and silicified over much of outcrop. Locally fossiliferous with a trilobite - brachiopod - gastropod faunal assemblage."@en ;
    lexicon:hasLowerBoundaryDefinition "Limestone is unconformable on largely carbonated and silicafied Lime Hill Serpentinite."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4625 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
