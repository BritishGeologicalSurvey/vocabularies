    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse- to medium-grained well-bedded and bioturbated muddy sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Transgressive boundary and unconformable contact with underlying mudstones and siltstones of the Mawddach Group or Harlech Grits Group."@en ;
