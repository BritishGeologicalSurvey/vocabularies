        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Schistose semipelite to psammite, garnetiferous, with graded bedding. Some layers and lenses of calcareous schists, calcsilicate rocks and quartzite."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of Sron nan Dias Pelite and Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1243 ,
        namedrockunit:H2503 ,
        namedrockunit:H3981 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not known"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of dominantly semipelitic rocks below the dominantly calcareous and graphitic rocks of the overlying Gleann Beag Schist Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Crinan Subgroup Caenlochan Schist [Obsolete: use TUSC]"@en ,
        "Killiecrankie Schist [Obsolete: use DBKR, TUSC]"@en ,
        "Lochaber Subgroup Baddoch Burn Pelite [Obsolete: use TUSC]"@en ;
    skos:broader namedrockunit:DABA ;
    skos:definition "Pelite, psammite and semipelite with subsidiary quartzite and schist. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TUSC"@en ;
    skos:prefLabel "Tulaichean Schist Formation"@en ;
.

namedrockunit:TVG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
