namedrockunit:PAH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey medium-grained sandstone with thin breccia layers in basal 17m: main part in beds 0.2-0.8m thick showing herringbone cross-bedding. Very rare mudstone beds or drapes."@en ;
    lexicon:hasLowerBoundaryDefinition "At base of first bed to show cross bedding and an undulatory top surface. Lower sandstones are massive, with planar or only gently undulatory tops."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3602 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasOldestAgeValue 5.26e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "30 - 56m. 35m in type section (min), 34m in reference section (min)."@en ;
    lexicon:hasUpperBoundaryDefinition "Bedding plane beneath first significant development of mudstone with thin, sharp-based sandstone beds. Mudstone drapes ubiquitous in beds above this."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Park Hill Quartzite [Obsolete: use PAH]"@en ;
    skos:broader namedrockunit:CQ ;
    skos:definition "Sandstone with subsidiary breccia and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PAH"@en ;
    skos:prefLabel "Park Hill Member"@en ;
.

