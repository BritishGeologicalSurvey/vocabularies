namedrockunit:BOSS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine- to medium-grained sand, partly cross-bedded, with lenticular units of rounded flint pebble- and cobble-gravel. Clayey carbonaceous sands toward the top."@en ;
    lexicon:hasLowerBoundaryDefinition "Formation overlies a marine transgressive surface developed on the Branksome Sand. The basal contact is a generally planar erosion surface at the change from interbedded sands and clays (Branksome Sand Formation) up into fine-grained sands of the formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "14m (Isle of Wight) up to 27m in its type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Fine grained sands of the formation are overlain by marine glauconitic clays of the Barton Clay Formation as a combined erosion surface and transgressive surface which can be traced across the Hampshire Basin."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BRB ;
    skos:definition "Sand with subsidiary gravel and silt. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
