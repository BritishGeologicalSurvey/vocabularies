namedrockunit:SEEI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark brown to red-brown, cross-bedded, highly ferruginous sandstone. The sandstone is generally poorly sorted and medium- to very coarse-grained or pebbly. At some localities there are veins of limonite, white chert pebbles and mudstone-rich partings. There is a rich marine macrofossil fauna dominated by brachiopods and molluscs, and including sporadic ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "Known occurrences of the Seend Ironsand unconformably overlie mudstones of the Kimmeridge Clay Formation or finer-grained ferruginous sandstone of the Whitchurch Sand Formation. Possible equivalent strata described by Jukes-Browne (1905) from the Devizes district also unconformably overlie Portland Group sandstones. At Faringdon, strata apparently representing the Seend Ironstone Formation occur within the Faringdon Sand Formation (ie above the older term Faringdon Sponge Beds, now Member). Here the lower boundary of the Seend Ironstone equivalent (the Baulking Sand Member) is marked by the downward facies change from ferruginous sand to coarse, sponge-rich gravels."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3025 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be not more than 12.2m (Jukes-Browne, 1905)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Seend Ironstone is the unconformable base of the Carstone Formation, Gault Formation or Quaternary sediments. Where the cover units are absent, the base of the present day weathered zone marks the top of the formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Iron Sands of Seend [Obsolete: use SEEI]"@en ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Ferruginous sandstone with subsidiary shelly sandstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SEEI"@en ;
    skos:prefLabel "Seend Ironstone Formation"@en ;
.

namedrockunit:SEHA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Eutaxitic and parataxitic rhyodacitic lapilli-tuff containing small abundance of pale acid lithic clasts. Interpreted as a welded ignimbrite sheet."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp base within the Brown Bank Tuff Formation at upward change from andesitic lapilli-tuffs to rhyodacitic lapilli-tuff; pyroclastic breccia at base in Sellafield borehole No.10A.  Seascale Hall Member oversteps other (unnamed) members of the Brown Bank Tuff Formation and in Sellafield borehole No.5 rests on the Bleawath Tuff Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.20 - 140m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by thin, andesitic, lithic rich lapilli-tuff-grade ignimbrite within the Brown Bank Tuff Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
