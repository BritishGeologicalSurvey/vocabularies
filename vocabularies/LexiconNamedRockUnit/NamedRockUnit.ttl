namedrockunit:OALEV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation excompasses the marine, estuarine and terrestrial deposits that were formed in the Oldbury and Avonmouth Levels area during the Holocene transgression. The deposits are dark blue-grey silty clays and silts with subordinate sands and beds of peat, submerged forests and gravel. The deposits rest on a rockhead platform intricately dissected by river valleys, and their upper surface is approximately level at c 4.5 to 7m OD. The river valleys are infilled with gravels and sands that become shelly upwards. Typically two beds of peat are included, up to 0.6m thick; the lower of these forms the lowest unit in the formation except where it rests upon the valley-fill sands and gravels, and was formed c.8500-8000 years BP when a birch forest was inundated by the rising sea. The other formed c 5000-4500 years BP during a slowing down of the rising sea level, and is now found resting horizontally at OD."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Triassic Bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:ESAL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.10 to 13m, increasing to c.21m in buried channels."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Estuarine Alluvium [Obsolete: use TFD]"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay, silt and silty clay with subsidiary gravel, peat and sand. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage - to - Holocene Epoch (Quaternary Period) (.126-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OALEV"@en ;
    skos:prefLabel "Oldbury and Avonmouth Levels Formation"@en ;
.

