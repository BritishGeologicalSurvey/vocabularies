    lexicon:hasThicknessDescription "Greater than 6 km possibly, possibly as much as 9 km."@en ;
    lexicon:hasUpperBoundaryDefinition "Stratigraphic top not exposed. Commonly uncomformably overlain by Old Red Sandstone of Silurian-Devonian age. In the Central Highlands, inferred to be uncomformably overlain by the Grampian Group (Dalradian Supergroup)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
