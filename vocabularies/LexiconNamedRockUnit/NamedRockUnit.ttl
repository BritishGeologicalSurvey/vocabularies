namedrockunit:WFC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Well cemented pebble conglomerate with a sandy matrix. Round to subround clasts include underlying Dent Group lithologies, Ingleton Group, vein quartz and andesite. \r
\r
Ashgill (Hirnantian) based on the Zone 8 fauna from strata immediately overlying the conglomerate. \r
\r
Kneller et al. (1994) speculatively correlated the Wharfe Conglomerate Member directly with similar lithofacies in the upper part of the Ash Gill Mudstone Formation."""@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of conglomerate, resting on an erosion surface within siltstones of the Sowerthwaite Siltstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3758 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasOldestAgeValue 4.452e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the lithology change to overlying well laminated sandy siltstone of the main part of the Sowerthwaite Siltstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OH> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Wharfe Conglomerate [Obsolete: use WFC]"@en ;
    skos:broader namedrockunit:SOW ;
    skos:definition "Conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Hirnantian Age (Ordovician Period) (445.2-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WFC"@en ;
    skos:prefLabel "Wharfe Conglomerate Member"@en ;
