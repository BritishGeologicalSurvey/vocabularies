namedrockunit:NSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A suite of glacial, glaciofluvial, glaciolacustrine and possibly glaciomarine deposits that contain clasts derived predominantly from northeast England (yellow, grey and white sandstones, mudstone, limestone, coal, dolerite), southern Scotland (greywacke sandstone and mudstone, granite, andesite, red sandstone) and offshore (marl, gypsum, chalk). Including clayey diamictons (till), sand, gravel, silt and clay. Deposited by ice sourced mainly in the Scottish Borders and central Scotland that flowed southeastwards along the eastern coast of England (but mainly offshore) as far as north Norfolk."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable, mainly planar contact with units of the North Sea Coast (Albion) Glacigenic Subgroup, or with bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EDUR ,
        namedrockunit:H1095 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or unconformable contact with various units of the Brittania Catchments Group or British Coastal Deposits Group. Lateral interdigitation with units of the North Pennine Glacigenic Subgroup."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "East Durham Till Formation [Obsolete: use NSG]"@en ,
        "North Sea Drift [Obsolete: use NSCA, NSG]"@en ;
    skos:broader namedrockunit:CALI ;
    skos:definition "Diamicton and gravel with subsidiary clay, sand and silt and trace coal. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
