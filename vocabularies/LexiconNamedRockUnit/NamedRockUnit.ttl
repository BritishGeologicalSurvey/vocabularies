namedrockunit:BRKS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Branksome Formation comprises mainly interbedded cross-bedded fine- to coarse-grained sand and heterolithic (mixed grain-size) sediments, with subordinate kaolinitic clay ('pipeclay'), organic-rich clay and rooted lignites, mainly as lenticular units (a complex of white and yellow sands, laminated carbonaceous clays and loams, and thin impure pipe-clays, arranged for the most part in overlapping lenses)."@en ;
    lexicon:hasLowerBoundaryDefinition "On the mainland the formation rests on an erosion surface on the Parkstone Clay Member of the Poole Formation. In the Isle of Wight the formation rests on an erosion surface at the top of the Marsh Farm Formation of the Bracklesham Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BRFR ,
        namedrockunit:BRMR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 70m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper surface is a generally planar erosion surface representing a marine transgression cutting across the finely-interbedded sands and clays of the formation. This surface is overlain by fine-grained, well-sorted sand with bidirectional cross-bedding of the Boscombe Sand Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bournemouth Freshwater Beds [Obsolete: use BRKS]"@en ,
        "Bournemouth Marine Beds [Obsolete: use BRKS]"@en ;
    skos:broader namedrockunit:BRB ;
    skos:definition "Sand with subsidiary clay. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CBBC ;
    skos:notation "BRKS"@en ;
    skos:prefLabel "Branksome Sand Formation"@en ;
.

namedrockunit:BRLL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithology is thinly bedded silty clay with wisps, laminae and bands of silt and, locally, sand. The deposit is generally reddish brown with grey or buff silt and sand. Isolated clasts up to 14cm are present and are considered to be dropstones. The deposit is of a hard to stiff consistency and medium to high plasticity. Thin diamicton bands and patches occur locally, with some graded bedding (turbidity flows) and microfaulting. Laminations are probably varves, and might represent 600 to 1000 years of sedimentation."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity on older Quaternary strata, such as the Baillieston Till Formation, or bedrock, or a glacial deformation boundary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2019 ,
        namedrockunit:H4497 ,
        namedrockunit:H721 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Veneer to more than 15m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity below younger Quaternary strata or, most commonly, a glacial deformation boundary with the overlying glacial diamicton of the Wilderness Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Broomhill Clay Member [Obsolete: use BRLL]"@en ,
        "Broomhill Formation [Obsolete: use BRLL]"@en ,
        "Broomhill Member [Obsolete: use BRLL]"@en ;
    skos:broader namedrockunit:MVG ;
    skos:definition "Clay, silt and silty clay with subsidiary sand and trace diamicton and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRLL"@en ;
    skos:prefLabel "Broomhill Clay Formation"@en ;
.

