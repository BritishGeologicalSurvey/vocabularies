namedrockunit:KELV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithological association of the Strathkelvin Clay and Silt Member of the Kelvin valley is of silty clay with many layers of silt and locally of sand. Interbedded peat is also found. Bands relatively rich in organic detritus also occur. In general the clays are dark brown. The deposits are either of floodplain or lacustrine origin."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity on older Quaternary strata including the Broomhouse Sand and Gravel Formation and Wilderness Till Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H991 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to over 9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity below younger Quaternary strata including the Law Sand and Gravel Member on which it can also rest conformably. The Clippens Peat Formation may underlie and overlie this member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kelvin Formation [Obsolete: use KELV]"@en ;
    skos:broader namedrockunit:CLVY ;
    skos:definition "Clay, silt and silty clay with subsidiary peat and sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KELV"@en ;
    skos:prefLabel "Strathkelvin Clay And Silt Member"@en ;
.

namedrockunit:KENT
