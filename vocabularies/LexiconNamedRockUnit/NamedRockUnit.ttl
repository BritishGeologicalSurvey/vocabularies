namedrockunit:EDG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Trough cross-bedded feldspathic, medium- to coarse-grained sandstone, typically thickly bedded. Ganister palaeosols are present in the upper part of the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Base taken where the predominantly sandstone sequence of the Eldroth Grit overlies siltstones of the Kirkbeck Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2168 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasOldestAgeValue 3.22e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "30m (Bentham area); 50-60m (Settle district)."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the highest sandstone of the Eldroth Grit, commonly containing rootlets, overlain by mudstone or siltstone of the Millstone Grit Group (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasYoungestAgeValue 3.215e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Eldroth Grit Formation [Obsolete: use EDG]"@en ;
    skos:broader namedrockunit:HEBD ;
    skos:definition "Sandstone with subsidiary mudstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Kinderscoutian Substage (Carboniferous Period) (322-321.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EDG"@en ;
    skos:prefLabel "Eldroth Grit"@en ;
.

