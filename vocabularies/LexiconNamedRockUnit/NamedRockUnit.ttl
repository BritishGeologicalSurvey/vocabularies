namedrockunit:TBXSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A clayey gravel and yellowish brown sand, with subrounded to well-rounded pebbles of psammite, meta-wacke and quartzite, with some gneiss and slate, the latter two rock types being strongly weathered."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, erosional, undulating contact with very compact, yellowish brown sandy clay diamicton of the Bellscamphie Till Formation, containing clasts of psammite, meta-wacke and quartzite derived from the west."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "12 m."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp, planar, unconformable contact with an unnamed brown till, containing clasts of psammite, meta-wacke and quartzite derived from the west, or with dark grey pebbly clay diamicton of the Pitlurg Farm Till Member, with sparse erratics and fossils derived from Jurassic strata beneath the Moray Firth to the north-west."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:EGAG ;
    skos:definition "Gravel with subsidiary clay, sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TBXSG"@en ;
    skos:prefLabel "Tillybrex Sand and Gravel Formation"@en ;
.

