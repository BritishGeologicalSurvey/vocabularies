namedrockunit:DMG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S261 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red, brown and yellow, commonly ochreous, matrix-supported flinty gravel with lenses of coarse sand. Most deposits are poorly sorted and clay-rich.Sand and gravel, clayey brown and yellow; Late Glacial to Postglacial. [Generic description: 1:50 k map margins]."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, irregular and erosional upon various Anglian age Quaternary deposits that include the Oadby Till."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Variable, generally from 1 - 3m but up to 7.8m proven where channelised."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present-day land surface. The deposit may locally be covered by recent deposits such as head or alluvium. The Dunsmore Gravel is thought to grade laterally into the 'Fifth Terrace' of the river Avon."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Flinty Gravel"@en ;
    skos:broader namedrockunit:WOLS ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage (Quaternary Period) (.48-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DMG"@en ;
    skos:prefLabel "Dunsmore Gravel Member"@en ;
.

namedrockunit:DMLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Denny Muir Lava Member consists mostly of massive lavas of plagioclase-macrophyric basalt or trachybasalt (hawaiite) (of 'Markle' type), trachybasalt and rare basaltic trachyandesite (mugearite). The lavas are essentially continuous with those of the Kilsyth Hills Lava Member which lie to the west of the Tak-ma-doon Fault. The basal lava east of Darrach Hill [NS 754 827] is composite, with mingled components of plagioclase-macrophyric and plagioclase-microphyric basalt or trachybasalt (of 'Markle' and 'Jedburgh' types respectively). The lavas were thought by Craig (1980) to have been derived from the Waterhead Centre ('Waterhead Central Volcanic Complex')."@en ;
    lexicon:hasLowerBoundaryDefinition "To the north and east, the base, locally a composite lava, is conformable or disconformable on the underlying plagioclase-microphyric trachybasalt lavas of the upper north and upper south Campsie lavas (Campsie Lava Member) but towards the south-west, where these lavas are absent, the member rests directly on plagioclase-microphyric basaltic trachyandesite and/or trachybasalt, of the Tappetknowe Lava Member, suggesting that the boundary is an unconformity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2760 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 85 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Denny Muir Lava Member occupies summit areas across its outcrop and the top of the member has been eroded."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Denny Muir Lavas [Obsolete: use DMLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and hawaiite with subsidiary mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DMLA"@en ;
    skos:prefLabel "Denny Muir Lava Member"@en ;
.

