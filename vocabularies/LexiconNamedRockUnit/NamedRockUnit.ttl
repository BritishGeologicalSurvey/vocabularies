namedrockunit:CATP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The formation comprises turbiditic siltstones interbedded with beds and sequences of lithic greywacke sandstone which constitute between 20 and 40 per cent of the succession. The sandstone is fine to medium grained in beds generally 5 to 150 cm thick, but exceptionally up to 5 m. A 4 m thick conglomerate is recorded in Melmerby Beck (Arthurton and Wadge, 1981). \r
\r
Macrofossils have not been found, but the acritarch microflora indicate a latest Tremadoc age (Cooper and Molyneux, 1990)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base is not exposed."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 1000 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The contact with the younger Kirkland Mudstone Formation is faulted."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasYoungestAgeValue 4.771e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SKG ;
    skos:definition "Siltstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series (Ordovician Period) (486.5-477.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CATP"@en ;
    skos:prefLabel "Catterpallot Formation"@en ;
