namedrockunit:GPM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamicton, mainly clast-supported, gravelly, sandy, silty, and matrix-rich gravel. Poorly consolidated, formed of angular to subangular fragments of weathered psammite and porphyry, mainly less than 64mm in diameter with some cobbles and boulders, yellowish brown overall."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies bedrock or is in unconformable contact on the Ailleag Diamicton Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 8m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or overlain locally by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CGDR ;
    skos:definition "Gravel with subsidiary sand and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GPM"@en ;
    skos:prefLabel "Gaick Plateau Moraine Formation"@en ;
.

namedrockunit:GPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Purple and red sandstone, cross-bedded with pebbly horizons. Warren et al., cite the Gloddaeth Purple Sandstone to be of Dinantian age, however, unpublished palynomorph assemblages obtained from a road cutting in the late 1980's by the Robertson Group, and which include the taxa Dictyotriletes birecticulatus and Endosporites globiformis, indicate an age no older than upper Westphalian A. The well preserved natuer of the assemblage suggested to the Robertson's palynologists that it had not been re-worked. Further investiation may allow the rank and parentage of the Gloddaeth Purple Sandstone to be revised. The possibility that it represents an early local facies of the Warwickshire Group cannot be discounted."@en ;
    lexicon:hasLowerBoundaryDefinition "An unconformable contact with red and purple sandstone resting on massive to pseudobrecciated and locally dolomitised limestones of the Loggerheads Limestone Formation (Clwyd Limestone Group)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Over 23 thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, presumed to be red and purple sandstone overlain by unconformable red Permo-Triassic sandstones of the Sherwood Sandstone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CW> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PCM ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Westphalian Stage (Carboniferous Period) (319-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GPS"@en ;
    skos:prefLabel "Gloddaeth Purple Sandstone Formation"@en ;
.

