namedrockunit:HPSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Happisburgh Sand Member consists of yellowish brown and yellow-orange stratrified sands. The sands exhibit a range of bedding structures including planar and trough cross-bedding, ripples, horizontal bedding, channel structures and sporadic horizons of convolute bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "The transition from the laminated silts and clays of the Ostend Clay Member (also part of the Happisburgh Formation) to the sandy facies of the Happisburgh Sand Member is erosional and marked by a thin gravel lag."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4712 ,
        namedrockunit:H963 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Varies between 6 and 8m"@en ;
    lexicon:hasUpperBoundaryDefinition "The transition from the sandy Happisburgh Sand Member to the diamicton facies of the Corton Till Member is erosional."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Happisburgh Sands [Obsolete: use HPSA]"@en ,
