    lexicon:hasThicknessDescription "About 1200 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, -see lower boundary details."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Manx Slate Series [Obsolete: use NBY, CRMR, DALBY, MANX]"@en ,
        "Manx Slates [Obsolete: use DALBY, MANX, NBY]"@en ;
    skos:broader namedrockunit:WIN ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) (432.9-426.7 Ma BP)."@en ;
