    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MCPAD ;
    skos:definition "Trace basalt, dolerite, felsite, mugearite, olivine-clinopyroxene-macrophyric basaltic-rock, olivine-macrophyric basalt, plagioclase-macrophyric basaltic-rock, plagioclase-microphyric basaltic-rock and trachyte. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
