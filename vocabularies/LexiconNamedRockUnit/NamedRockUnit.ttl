namedrockunit:OH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Oldhaven Member typically consists of cross-bedded, laminated or bioturbated, fine-grained glauconitic sand, some silty, sandy silts and sandy clayey silts with thin clay beds, some of which are cemented to form argillaceous limestone. There is a shelly marine fauna in shell beds or lenses, with some fish teeth. Black well-rounded flint gravel occurs at the base. Lenses or thin beds of calcareous shelly sandstone are present locally. Occurrences in the west of the London Basin, corresponding to King's (1981) Tilehurst Member, are generally finer-grained, have more bioturbation and a more diverse fauna. \r
\r
Knox (1983) reported common disseminated volcanic ash in the Oldhaven Member in north Kent and south-west Essex, from which he inferred correlation with ash-bearing deposits of the Harwich Formation in north-east Essex. \r
\r
The sequence at Herne Bay is described in detail by Ward (1978) and by Daley (1999)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Oldhaven Member is sharp, locally erosive and generally planar. It rests on the Blackheath Member where that unit exists but more generally on the Lambeth Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1608 ,
        namedrockunit:S967 ,
        namedrockunit:WLOH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to about 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Oldhaven Member is overlain by the Swanscombe Member or by clayey silts and silty clays of the London Clay Formation, which include a basal gravel bed and much less glauconite. King (1981) observes that the Tilehurst Member is similar in lithology to the Swanscombe Member, but that where the units coexist there is a discontinuity between them usually marked by a gravel bed, and that the fauna differs."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Herne Bay Member [Obsolete: use OH]"@en ,
        "Oldhaven Beds [Obsolete: use OH]"@en ,
        "Woolwich Beds-Oldhaven Beds [Obsolete: use OH, WL]"@en ;
    skos:broader namedrockunit:HWH ;
    skos:definition "Sand and silt with subsidiary clay and trace calcilutite. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OH"@en ;
    skos:prefLabel "Oldhaven Member"@en ;
.

namedrockunit:OMS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use HEY, SELF] Fine- to coarse-grained (generally medium-) cross bedded and flat bedded sandstones, generally friable.  In West Cumbria sandstones are aeolian, but offshore the Ormskirk Sandstone is dominated by fluvial sandstones, with aeolian interbeds. Details of lithology in the type area are not known, other than a description of 'coarse sandstone'."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Reference Section (Sellafield Bh 13B), it is taken where aeolian sandstones overlie a thick fluvial sandstone sequence assigned to the Calder Sandstone. Geophysically, it is marked by a rapid upward decrease in gamma-ray values and an increase in sonic interval transit times."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1104 ,
        namedrockunit:LKS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "176.42m+ onshore in Cumbria. Average 250m elsewhere. Up to 275m offshore."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen onshore in West Cumbria, offshore it is overlain by the Mercia Mudstone Group. Awaits formal definition offshore in East Irish Sea Basin."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf
        namedrockunit:HEY ,
        namedrockunit:SELF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Helsby Sandstone Formation"@en ,
        "Lower Keuper Sandstone [Obsolete: use OMS]"@en ,
        "Ormskirk Sandstone [Obsolete: use OMS]"@en ,
        "Sellafield Member"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary silicate-claystone and siltstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OMS"@en ;
    skos:prefLabel "Ormskirk Sandstone Formation [Obsolete: use HEY, SELF]"@en ;
.

namedrockunit:OS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use HEY] Fine- to medium-grained sandstone, weathering to sand near surface. Sandstones locally micaceous and cross-bedded. Thin units of hard intraformational conglomerate; lenticular beds of reddish brown clay or mudstone locally; calcretes at some horizons. Lenticular pebble bed units mapped in the Exeter district."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests sharply on ventifact bed at top of Budleigh Salterton Pebble Beds, in area between coast and Hill Head (Uffculme). Base difficult to identify in Taunton district owing to upward passage from conglomerate to sandstone (Edmonds and Williams, 1985)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3599 ,
        namedrockunit:H3792 ,
        namedrockunit:H437 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Coast and Exeter district: c.160m. Taunton district: 30 to 60m"@en ;
    lexicon:hasUpperBoundaryDefinition "In coastal exposures (SY 110 8663), transitional into overlying Mercia Mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasYoungestAgeValue 2.37e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:HEY ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
