namedrockunit:CMVC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A clast supported conglomerate, with some bimodal sorting seen as generally massive volcanic clasts near the base of the unit, giving way to quartzite and psammite upwards and south-westwards along strike. Subsidiary sandstones include the Bofrishlie Burn Sandstone member, located below the basaltic Balleich Lava Member."@en ;
    lexicon:hasLowerBoundaryDefinition "A faulted contact to the north-east of Aberfoyle."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H148 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 1200 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A pronounced diachronous transitional contact with the conglomeratic or sandstone facies of the Ruchill Flagstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Volcanic Conglomerates [Obsolete: use CMVC]"@en ;
    skos:broader namedrockunit:ATGK ;
    skos:definition "Conglomerate with subsidiary basalt and sandstone and trace pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BALH ,
        namedrockunit:BBSA ;
    skos:notation "CMVC"@en ;
    skos:prefLabel "Craig of Monievreckie Conglomerate Formation"@en ;
.

