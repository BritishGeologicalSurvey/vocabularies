    skos:altLabel
        "Cromlix Mudstone Formation"@en ,
        "Edzell Mudstones [Obsolete: use EDM]"@en ;
    skos:definition "Obsolete name. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EDM"@en ;
