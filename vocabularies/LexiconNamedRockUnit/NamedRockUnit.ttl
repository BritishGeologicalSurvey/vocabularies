    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum exposed is 3.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed but by analogy with its lateral equivalent, the Gortnaree Sandstone Member, it probably grades upwards gradually into argillaceous and bioclastic packstones of the normal Ballyshannon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
