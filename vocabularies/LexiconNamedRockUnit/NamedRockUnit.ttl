namedrockunit:LAGS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to coarse-grained poorly sorted sandstones and conglomerates."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable on the Gribun Chalk Formation but the formation is considered to be absent in Mull and Morvern by Mortimore, Wood and Gallois (2001). This member is the basal unit of the Strathaird Limestone Formation according to Braley (1990)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3.0m at Laig Gorge, Eigg."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is disconformable (at an erosion surface above a coarse very poorly sorted conglomerate) with the grey micritic limestones of the remainder of the Strathaird Limestone Formation (the Laig Gorge Limestone Member) at Strathaird on Skye and at a burrowed surface with the same limestones at Laig Gorge on Eigg."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasYoungestAgeValue 8.94e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STRL ;
    skos:definition "Conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Turonian Age (Cretaceous Period) (93.9-89.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LAGS"@en ;
    skos:prefLabel "Laig Gorge Sandstone Member"@en ;
