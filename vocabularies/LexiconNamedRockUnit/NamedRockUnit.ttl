        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basal quartzose conglomerate and calcareous sandstone overlain by maroon sandy limestones with siltstone layers, hardground surfaces and stromatolites. Shelly faunas locally abundant."@en ;
    lexicon:hasLowerBoundaryDefinition "At base of the grey quartzose conglomerate or, where absent, the lower maroon carbonate-cemented sandstone. Sharpness of contact suggests a disconformity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasOldestAgeValue 5.26e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1.5-2m in general area; 1.8m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp hardground surface, on which rests basal grey, glauconitic sandstone of Woodlands Member; a thin mudstone drape occurs locally."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CQ ;
    skos:definition "Calcareous sandstone, conglomerate and limestone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HFMB"@en ;
    skos:prefLabel "Home Farm Member"@en ;
.

