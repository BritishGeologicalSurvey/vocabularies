    lexicon:hasThicknessDescription "Unknown."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by semipelite correlated with the Coire nan Laogh Semipelite Formation which in turn is overlain by the Loch Laggan Psammite Formation. Boundary with the semipelite is inferred to be an unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
