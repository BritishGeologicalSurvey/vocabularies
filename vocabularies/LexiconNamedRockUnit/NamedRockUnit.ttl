namedrockunit:PAPA
    a skos:Concept ;
    lexicon:hasLithologyDescription "The term Papa Group was introduced by Ritchie et al. (1996) for all Triassic continental clastic deposits within the West Orkney, Solan and West Shetland basins and along the Westray Ridge and Solan Bank High, that lie above Zechstein Group and unconformably below Jurassic and younger strata. The Papa Group comprises the Foula, Shoal High and Otter Bank formations."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "The Papa Group attains a maximum, unbottomed drilled thickness of 1512 m within the West Shetland Basin. In the Møre Basin, the laterally equivalent Heron Group has a proven drilled thickness of 572 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Stratified bedrock. Occurs offshore. Deposited during the Permian Period - to - Triassic Period (298.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FOUL ,
        namedrockunit:OTBA ,
        namedrockunit:SHHI ;
    skos:notation "PAPA"@en ;
    skos:prefLabel "Papa Group"@en ;
.

namedrockunit:PBB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
