namedrockunit:CRSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey fossiliferous, clayey silt with sand grains and local rock fragments and a peat layer up to 0.1 m near top."@en ;
    lexicon:hasLowerBoundaryDefinition "Placed at base of Bed A3 in an augerhole section proved at Colwall, Hereford and Worcester, where it overlies red-brown clays (Bed A2) of the White House Silts. (Barclay et al., 1992)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasOldestAgeValue 4.23e-01 ;
