namedrockunit:DCIG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CSSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pebbly schistose grits, schistose grits, greywackes, black and green slates. Black slates occur with sporadic seams of dark lime and grit. Conglomerate also occurs. (Innellan Group = stratigraphic equivalent of the Dunoon Phyllites)."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of semi-pelitic wacke of the Innellan Group where it rests conformably on psammitic wacke of the Bullrock Greywacke."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "1000m approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at unconformable upward change from conglomerate and semi-pelitic wacke of the Innellan Group to probable Upper Old Red Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Coarse silicate-sandstone, slate and wacke with subsidiary conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "DCIG"@en ;
    skos:prefLabel "Innellan Group"@en ;
.

