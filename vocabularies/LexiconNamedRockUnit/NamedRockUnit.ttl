namedrockunit:HIO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithologyDescription """[Obsolete: use CIGSS] Name introduced by Gillespie et al. (2011) for all components of the Caledonian Supersuite (CIGSS) that occur within the Northern Highlands and Grampian Highlands regions and formed broadly in association with the Grampian Event. This is the older (Ordovician) of the two main tectonothermal events of the Caledonian Orogeny in Scotland. \r
\r
Term not currently used by BGS."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HSO ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasOldestAgeValue 4.869e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/S> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CIGSS ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Caledonian Supersuite"@en ,
        "Highlands Older Suite [Obsolete: use HIO]"@en ;
    skos:definition "Obsolete name. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ordovician Period (486.9-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HIO"@en ;
    skos:prefLabel "Scottish Highlands Ordovician Suite [Obsolete: use CIGSS]"@en ;
.

