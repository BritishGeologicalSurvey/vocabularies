namedrockunit:POCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Buff-coloured lime-packstones and lime-wackestones with conspicuous black nodular chert, and locally on the Isle of Purbeck, horizons of tabular chert. Correlative shell-rich intervals occur at the base of the member on the Isle of Portland (Basal Shell Bed) and in the middle of the member on the Isle of Purbeck (Bed J and J'), and consequently the base of the member on Portland is an unconformity. Ooids appear towards the top of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "On the Isle of Purbeck, the lower boundary is the conformable upward facies change from fine-grained dolomitic limestone of the underlying Portland Sand Formation, to the chert-bearing wackestones and packstones of the Portland Chert Member. On the Isle of Portland, the lower boundary is an unconformity, underlain by dolomitic mudstone of the topmost Portland Sand Formation and overlain by a shell-rich limestone of the basal Portland Chert Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CHTS ,
        namedrockunit:H1127 ,
        namedrockunit:H5242 ,
        namedrockunit:H5243 ,
        namedrockunit:H5244 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "22.6 m on the Isle of Purbeck; 17.7 m on the Isle of Portland (Wimbledon, 1980)"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Portland Chert Member is the upward facies change from chert-bearing lime-wackestones and packstones to massive ooid-grainstones of the Portland Freestone Member. The facies change is sharp on the Isle of Portland, and identified as an unconformity by Coe (1996). On the Isle of Purbeck the facies change is conformable, the correlative surface of the unconformity seen on the Isle of Portland occurring some distance above the base of the Portland Freestone Member (Coe, 1996)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basal Shell Bed [Obsolete: use POCH]"@en ,
        "Cherty Beds [Obsolete: use POCH]"@en ,
        "Cherty Series [Obsolete: use POCH]"@en ,
        "Dungy Head and Dancing Ledge members (Isle of Purbeck) [Obsolete: use POCH]"@en ,
        "Portland Cherty Member [Obsolete: use POCH]"@en ;
    skos:broader namedrockunit:POST ;
    skos:definition "Limestone with subsidiary chert and ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "POCH"@en ;
    skos:prefLabel "Portland Chert Member"@en ;
.

namedrockunit:POWSG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand with subsidiary beds of gravel. Dominantly pale olive-brown and pale pinkish brown quartzose and felsitic medium to coarse sand. Typically horizontally stratified with some planar and trough cross beds indicating transport towards the west. The gravel component diminishes upwards and is typically of pebble-cobble grade. Angularity varies significantly from rounded to angular. Clast lithologies are dominated by felsite, with smaller quantities of quartzite, psammite, hornfels and red and grey granites. Interpretated as a periglacial fluvial deposit (possibly glaciofluvial in part)."@en ;
    lexicon:hasLowerBoundaryDefinition "In Kirkhill quarry (infilled) southeast face A and east face at the base of the unit rests unconformably on unweathered felsite bedrock. In southeast face B the formation in part both overlies and interdigitates with felsitic rubble of the Kirkton Gelifluctate bed. To the southwest at Leys quarry (disused), northeast face, a sand and gravel body interpreted to be the Pitscow Sand and Gravel Formation, unconformably overlies the Denend Gravel Formation. Here the Pitscow Formation rests in a -2m deep erosive channel feature."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2983 ,
        namedrockunit:H2984 ,
        namedrockunit:H4272 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "At both Kirkhill Quarry (infilled) southeast face A and east face, and Leys Quarry (disused), northeast face, the upper boundary of the unit is gradational, undulatory boundary with the overlying bleached, podzolic Kirkhill Palaeosol Bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kirkhill Basal Sand/Kirkhill Gravel [Obsolete: use POWSG]"@en ,
        "Kirkhill Lower Sand and Gravel/Kirkhill Gravel [Obsolete: use POWSG]"@en ,
        "Pitscow Member [Obsolete: use POWSG]"@en ;
    skos:broader namedrockunit:EGAG ;
    skos:definition "Sand with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:KHLPS ,
        namedrockunit:KTNGF ;
    skos:notation "POWSG"@en ;
    skos:prefLabel "Pitscow Sand and Gravel Formation"@en ;
.

