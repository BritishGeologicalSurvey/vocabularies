        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greenish-grey siltstones with bands of prominent limestone nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional on mudstones of the underlying Coalbrookdale Formation. Base taken beneath first bed of coalesced limestone nodules."@en ;
