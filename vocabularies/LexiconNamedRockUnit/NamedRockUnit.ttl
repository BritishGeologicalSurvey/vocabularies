namedrockunit:BNF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey and black mudstones with variably abundant very thin beds and laminae of cross laminated and graded siltstone and sandstone. The mudstones contain scattered sideritic, carbonaceous silty sandstone and argillaceous limestone nodules, containing goniatites. A thin fossiliferous limestone is present at or very near the top of the formation. Volcanic material locally occurs as lenses of sheared vesicular lava and tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "The depositional lower boundary is not seen as the lower boundary is everywhere tectonic."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2003 ,
        namedrockunit:H3231 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "21 m+ on the coast in the Boscastle/Tintagel area; poorly constrained as a result of deformation."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the sharp contact of tuffs, lavas and agglomerates of the overlying Tintagel Volcanic Formation with the mudstones and thin siltstones of the Barras Nose Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Barras Nose Beds [Obsolete: use BNF]"@en ,
        "Lower Blue-Black Slates [Obsolete: use BNF]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone and trace lava, limestone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BNF"@en ;
    skos:prefLabel "Barras Nose Formation"@en ;
.

namedrockunit:BNMS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
