namedrockunit:KGCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Mainly gravels characterised by quartz and quartzite from the Triassic, Carboniferous and Devonian rocks of the West Midlands, Welsh Borderland and possibly south-western Pennines, and by felsic volcanic rocks from northern Wales. The members comprise bodies of cross-bedded and massive, moderately sorted sand and gravel. The upper part of the gravels which dominate the subgroup are commonly affected by pedogenesis. The Valley Farm Soil is a rubified and clay-enriched horizon affecting the top 1.0 - 1.5 m and indicating warm interglacial conditions. The Barham Arctic Structure Soil is a complex pedogenic horizon affecting the topmost 1.0 - 1.5 m of the subgroup and of the Valley Farm Soil (Rose and Allen 1977; Rose et al., 1985). \r
\r
Pleistocene (MIS ?61 - 13)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock (Cretaceous - Palaeogene) and Crag Group. The deposits are generally entrenched into bedrock with a difference in surface elevation of at least 5 m. Differentiation from the Crag Group can be difficult where the latter is reworked, and the distinction must be made on the basis of sedimentological structures: the Crag Group is of shallow marine to estuarine origin, the Kesgrave Catchment Subgroup is fluvial."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GSG ,
        namedrockunit:H3284 ,
        namedrockunit:KES ,
        namedrockunit:KGSG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "About 21.3 m aggregate thickness with individual terrace aggradations typically 5 - 12 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by mid-Pleistocene glacigenic deposits. The upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the over-lying beds is usually helpful. The uppermost 1.0 - 1.5 m of the subgroup is commonly marked by the pedogenic Valley Farm Soil and/or the Barham Arctic Structure Soil."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Essex White Ballast [Obsolete: use KGCA]"@en ,
        "Glacial sand and gravel [Obsolete]"@en ,
        "Kesgrave Formation [Obsolete: use KGCA]"@en ,
        "Kesgrave Sands and Gravels [Obsolete: use KGCA]"@en ;
    skos:broader namedrockunit:DUNW ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CCHR ,
        namedrockunit:SBRY ;
    skos:notation "KGCA"@en ;
    skos:prefLabel "Kesgrave Catchment Subgroup"@en ;
.

