namedrockunit:SHEN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lenticular beds of a pale brown, phosphatic limestone with scattered polished goethite ooliths (Owen 1972; Smart, 1997). It may be slightly limonitic and glauconitic. Brachiopods common."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where a thin, gritty ironstone (\"carstone\") overlying silty beds at the top of the Woburn Sands Formation passes up into a sandy mudstone associated with lenticular beds of a pale brown phosphatic limestone with scattered polished goethite ooliths (Shenley Limestone Member) (Owen, 1972; Smart, 1997)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H521 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to c. 0.1m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken where phosphatic limestone of the Shenley Limestone Member is overlain by a 1.2m-thick fissile, red mudstone informally called \"Red Clay\" or the \"Cirripede Bed\" of the Gault Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Shenley Limestone Bed [Obsolete: use SHEN]"@en ;
    skos:broader namedrockunit:MHPS ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHEN"@en ;
    skos:prefLabel "Shenley Limestone Member"@en ;
.

