    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 7m; average 3m. A thickness of 4.8m is recorded in the BGS Stanmore Common borehole (TQ19SE102)."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain in places by till of the (Anglian) Lowestoft Formation, but generally at surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasYoungestAgeValue 7.8e-01 ;
