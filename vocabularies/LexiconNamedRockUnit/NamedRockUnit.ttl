namedrockunit:LHLA
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Langhill Lava Member consists of four lavas of typically fine-grained, platy-jointed basaltic-trachyandesite (mugearite) with a total thickness of 35 m. The only exposures are in the River Carron [NS 773 845], 500 m north-east of Langhill. The lowest lava is relatively coarse grained and is about 15 m thick, with well-developed columnar jointing. The other lavas are very fine grained and intensely jointed. One at least of these has an autobrecciated base, consisting of buckled and disrupted tabular blocks of the lava."@en ;
    lexicon:hasLowerBoundaryDefinition "The member overlies plagioclase-microphyric trachybasalt of the Campsie Lava Member, but the nature of the contact is unknown."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2902 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Langhill Lava Member is overlain by the Gargunnock Hills Lava Member, but the nature of the contact is unknown. The lithological change is to mostly plagioclase-macrophyric basalt or hawaiite (of 'Markle type') with some microporphyritic basalts (of 'Jedburgh' and 'Dalmeny' types)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Langhill Lavas [Obsolete: use LHLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LHLA"@en ;
    skos:prefLabel "Langhill Lava Member"@en ;
.

