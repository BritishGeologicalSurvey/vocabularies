namedrockunit:WHINS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCQGB"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A  locally pegmatitic quartz-dolerite, with finer grained 'chilled' contact rock. Sills are typically columnar jointed, and comprise up to three leaves are present in places. The component sills and associated dykes cut strata up to and including those of Carboniferous, Duckmantian (Westphalian B) age, and derived pebbles are reworked into breccias of Early Permian age. Radiometric dates (K-Ar, Ar-Ar and U-Pb) are in the range of 301-294 Ma. The large volume of literature on this sill-complex is listed, referred to and discussed in Stephenson et al., 2003."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp intrusive contact of the component sills, where they are in contact with sedimentary strata below."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WHSI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CMIL> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasThicknessDescription "Individual leaves average a thickness of about 30m; the thickest individual leaf is 73 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp intrusive contact with the strata overlying the sill."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whin Sill [Obsolete: use GWHIN, WHINS]"@en ;
    skos:broader namedrockunit:LCTS ;
    skos:definition "Dolerite and quartz-microgabbro. Bedrock. Occurs onshore. Formed during the Late Mississippian Epoch (Carboniferous Period) - to - Cisuralian Epoch (Permian Period) (330.3-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GWHIN ,
        namedrockunit:LWHIN ;
    skos:notation "WHINS"@en ;
    skos:prefLabel "Whin Sill Complex"@en ;
.

