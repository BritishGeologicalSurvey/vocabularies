namedrockunit:HFD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded yellow silty fine-grained sand, cemented in parts ('Harford Sands'), grey and brown mudstone, shelly and sandy in parts ('Snowshill Clay' and 'Naunton Clay') and variably sandy and ooidal limestone ('Tilestone'). The succession is characterised by rapid lateral facies transitions and a mix of fully marine and quasi-non-marine facies."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change or passage from peloidal and ooidal packstones and grainstones (Scottsquar Member) to lithologies as described in Lithological Description. Locally a non-sequence marked by a hardground (Buckman, J, 1901; Cave, R and Penn, I E, 1972)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H313 ,
        namedrockunit:H314 ,
        namedrockunit:H3464 ,
        namedrockunit:H3465 ,
        namedrockunit:H956 ,
        namedrockunit:SHC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 14m. Type section (Harford Cutting); 3.05m+ (Parsons, C F, 1976). Thickens northward."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp contact, generally a hardground, overlain by Aston Limestone Formation, or hardground overlain by Salperton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
