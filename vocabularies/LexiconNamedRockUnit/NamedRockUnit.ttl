    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "About 100 metres thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from dark shales of the Shale Group to brown, green and yellow sandstones and quartzites of the Farewell Rock."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
