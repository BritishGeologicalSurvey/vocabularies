namedrockunit:PELC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S94 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish-brown to dark brown silty clay containing well dispersed pebbles ad cobbles (locally abundant), and commonly, small, buff to grey, grotesquely shaped calcareous concretions towards the base of the weathering zone. Clasts mainly of Carboniferous lithologies (sandstone, mudstone, limestone, coal). Typically has closely spaced, subvertical, prismatic jointing that formed during dry periglacial conditions."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a planar, subhorizontal to undulating, gradational, glaciotectonic boundary with underlying dark grey, laminated silt and clay of the Tyne-Wear Glaciolacustrine Formation, or on brown or purplish brown, stony silty sandy clay diamicton of the Wear Till Formation. Locally rests on bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H444 ,
        namedrockunit:S198 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Generally 1-2m, but reaching 4.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Pelaw Clay [Obsolete: use PELC]"@en ,
        "Pelaw Member"@en ,
        "Upper Clays [Obsolete: use PELC]"@en ;
    skos:broader namedrockunit:TYWE ;
    skos:definition "Clay with subsidiary silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PELC"@en ;
    skos:prefLabel "Pelaw Clay Member"@en ;
.

namedrockunit:PEP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent namedrockunit:UPB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Calcarenites and calcirudites (rich in bioclastic material) interbedded with carbonaceous clays. The base is defined by thickly-bedded, limestones containing fragmented shells (Upper Broken Shell Limestone Bed). This passes (and fines) upwards into a biomicrite and carbonaceous mud-dominated sequence with glauconite-rich beds, which, in the west, are commonly rich in detrital quartz (Unio Bed, Upper \"Cypris\" Clays and Shales Beds). The limestones in this part of the Member contain abundant Unio and Viviparus."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by the first upward occurrence of thickly- bedded, coarse biosparite limestones (i.e. the base of the Broken Shell Limestone Bed) resting on muds and finer-grained biosparites or micrites at the top of the Stair Hole Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H445 ,
        namedrockunit:UPB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 7 and 17 m in Dorset."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is marked by the last occurrence of significant limestone beds (containing Unio and Viviparus) beneath monotonous sandy mudstones of the Wealden Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Friar Waddon Member [Obsolete: use PEP]"@en ,
        "Upper Purbeck Beds [Obsolete: use PEP]"@en ;
    skos:broader namedrockunit:DURN ;
    skos:definition "Limestone and mudstone with subsidiary carbonaceous mudstone and trace glauconitic mudstone and sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Berriasian Age (Cretaceous Period) (143.1-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PEP"@en ;
