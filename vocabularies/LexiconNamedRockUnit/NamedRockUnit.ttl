        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey siltstones and sandstones with rare ironstones near the base. Top marked by coarse-grained quartzose pebbly sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable and gradational from mainly coarse-grained sandstones of the underlying Bronllwyd Grit Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasOldestAgeValue 4.99e+02 ;
