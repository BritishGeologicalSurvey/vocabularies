namedrockunit:SLLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Slackdown Lava Member consists of a varied assemblage of predominant trachybasalt, with plagioclase-macrophyric basalt lavas ('of 'Markle' type) and microporphyritic basalt lavas (of 'Jedburgh' type)."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal basaltic-trachyandesite (mugearite) of the member unconformably overlies sedimentary rocks, including sandstone, siltstone and mudstone of the Clyde Sandstone Formation, of the Inverclyde Group."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2427 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "30-79 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Slackdown Lava Member is overlain, conformably or disconformably by the Baston Burn Lava Member. The lithological change is from trachybasalt to plagioclase-macrophyric basalt (of 'Markle' type), except in the north-western Gargunnock HIlls, where the uppermost Slackdown Lava Member is represented by plagioclase-microphyric basalt (of Jedburgh' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basal Group [Obsolete: use SLLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and trachybasalt with subsidiary mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLLA"@en ;
    skos:prefLabel "Slackdown Lava Member"@en ;
.

namedrockunit:SLN
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S336 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation is mainly sandstone with some interbedded mudstones. The sandstone is friable, fine- to coarse-grained, grey, cross-bedded and slightly micaceous. The mudstones are buff, purple and red-brown mottled. Locally, at the base of the formation is a loosely cemented, poorly sorted conglomerate about 10 m thick. The conglomerate has a red-brown sandy matrix and subrounded clasts of igneous rocks, quartzite, sandstone and limestone up to 15 cm diameter."@en ;
    lexicon:hasLowerBoundaryDefinition "The grey sandstone of the Stallion Hill Sandstone Formation rests unconformably upon the red mudstones of the Raglan Mudstone Formation (RG)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 80 m. Thinning to 0 within 2 km to northwest; cut out by faulting within 0.5 km to east of type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "There is a conformable passage from the grey sandstone of the Stallion Hill Sandstone Formation into the overlying grey mudstone with subordinate sandstone, seatearth and coal of the Grovesend Formation (GDB)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Trenchard Group [Obsolete: use TRGP]"@en ;
    skos:broader namedrockunit:WAWK ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage - to - Asturian Substage (Carboniferous Period) (314.75-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLN"@en ;
    skos:prefLabel "Stallion Hill Sandstone Formation"@en ;
.

namedrockunit:SLO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALVPW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAREN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, porphyritic and aphyric hyaloclastites and porphyritic and aphyric massive basalt lavas, distinguished by large (to 2cm) bladed plagioclase phenocrysts."@en ;
    lexicon:hasLowerBoundaryDefinition "Succeeds Pinbain Lava Formation (PIN). Distinguished by incoming of hyaloclastite and basalt lava with large bladed plagioclase phenocrysts."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2428 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.285m"@en ;
    lexicon:hasUpperBoundaryDefinition "Succeeded by Brandy Craig Lava Formation (BCG). Distinguished by the incoming of reddened horizons - suggestive of subaerial weathering."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Slockenray Formation [Obsolete: use SLO]"@en ;
    skos:broader namedrockunit:BCN ;
    skos:definition "Hyaloclastite and pillowed basalt lava with subsidiary conglomerate and lithic-arenite. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLO"@en ;
    skos:prefLabel "Slockenray Hyaloclastite And Lava Formation"@en ;
.

namedrockunit:SLOM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Striped Loams comprise laminated and thinly-bedded fine-grained sands, silts, clayey sands and clays. The occurrence at Loam Pit Hill contains fossil seeds and leaves (Curry, 1958, p. 71) in the 'Lewisham Leaf Bed' (Cooper, 1976a) and (Pitcher, 1967, fig. 3). As seen in the Charlton Pit, this comprises alternations of fine-grained sand and clay, with lignite. The name derives from sparse leaf impressions. \r
\r
Estuarine and other marginal marine environments. \r
\r
Early Eocene (earliest Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Striped Loams is a sharply-defined contact that marks a change in lithology from shelly clay, sandy clay and muddy limestone of the underlying Upper Shelly Clay to laminated and thinly-bedded fine-grained sands, silts, clayey sands and clays of the Striped Loams."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3130 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to about 9 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Striped Loams is a sharply-defined contact between laminated and thinly-bedded fine-grained sands, silts, clayey sands and clays of the Woolwich Formation with glauconite-bearing sands, silts or clays with a basal rounded flint gravel bed and a marine fauna, or sandy flint gravels of the Harwich Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Striped Sands [Obsolete: use SLOM]"@en ;
    skos:broader namedrockunit:WL ;
    skos:definition "Clay, sand and silt. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLOM"@en ;
    skos:prefLabel "Striped Loams (Woolwich Formation)"@en ;
.

namedrockunit:SLR
    a skos:Concept ;
