namedrockunit:YCAT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Yare Catchments Subgroup encompasses all the fluvial, lacustrine and organic deposits of the rivers which occupy the catchment area of the River Yare and its tributaries, and also the other minor rivers that flow into the North Sea along the coast of Norfolk. Floodplain alluvium comprises soft silts and clays, commonly with beds of peat and a basal bed of sand and gravel. River terrace deposits are largely sand and gravel. The gravels are dominantly composed of subrounded to angular flint, including large cobbles, also rounded pebbles of quartz and quartzite, northern British erratics of glacial derivation, and a little chalk. Peat is a minor component, and minor marine deposits are included where they are intercalated in dominantly fluvial formations."@en ;
    lexicon:hasLowerBoundaryDefinition "Formations of the Yare Valley Subgroup rest unconformably on glacial and periglacial deposits and upon Crag Group, London Clay Formation and Chalk Group bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "c.18m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface, or overlain by deposits of the Breydon Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BLYV ,
        namedrockunit:BURV ,
        namedrockunit:WAVV ,
        namedrockunit:YV ;
    skos:notation "YCAT"@en ;
    skos:prefLabel "Yare Catchments Subgroup"@en ;
.

namedrockunit:YRL
    a skos:Concept ;
