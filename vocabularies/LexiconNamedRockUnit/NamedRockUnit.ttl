namedrockunit:CHUI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "10 to 30cm-thick layers of quartzite, commonly ribbed in appearance; muscovitic semipelite typically accounts for less than 10% of the lithology, The base is gradational with the underlying part of the Beinn an Dothaidh Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is gradational with the underlying part of the Beinn an Dothaidh Formation, with an upwards change to quartzite as the dominant lithology."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasOldestAgeValue 7.2e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c 200m thickness is observed in the Allt a'Chuirn section but is greatly thickened by the effects of folding, estimated stratigraphical thickness is in the order of 30 to 50m."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt change to the more uniform garnetiferous semipelite rocks of the Beinn Dorain Semipelite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasYoungestAgeValue 6.35e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DOTH ;
    skos:definition "Quartzite with subsidiary semipelite. Stratified bedrock. Occurs onshore. Deposited during the Cryogenian Period (Precambrian) (720-635 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHUI"@en ;
    skos:prefLabel "Allt A'Chuirn Quartzite Member"@en ;
.

