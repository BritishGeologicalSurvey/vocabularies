namedrockunit:SKRS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thick-bedded, clean, poorly consolidated, fine to medium grained, locally coarse-grained sandstone, with sparse glauconite. Sporadic thin calcite-cemented layers are present in some sections. Thin beds of grey to grey-green, variably silty mudstone also occur. Gamma-ray profiles are typically uniform; sonic log signatures are more variable, especially where cemented layers are present (e.g. 16/7a-9)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Skroo Sandstone Member is taken at a downward change from sandstone to grey-green or variegated Horda mudstone, associated with an increase in gamma-ray values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Thicknesses are highly variable, reaching a maximum of about 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Skroo Sandstone Member is taken at a downward change from grey-green or grey-red Horda mudstone to sandstone, associated with a decrease in gamma-ray values and an increase in velocity. A high gamma spike is present at, or shortly above, the boundary in some sections (e.g. 16/17-8A)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HORD ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Early Eocene (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKRS"@en ;
    skos:prefLabel "Skroo Sandstone Member"@en ;
.

namedrockunit:SKS
    a skos:Concept ;
