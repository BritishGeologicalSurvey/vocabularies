namedrockunit:SGLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRAND"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Nonporphyritic lavas (mugearites) and olivine-free plagioclase-macrophyric hawaiitic lavas (Markle type), in roughly equal proportions and commonly in composite flows. Also thin olivine-pyroxene-macrophyric basalt (ankaramitic) lavas and olivine-bearing plagioclase-macrophyric basalts (Markle type) in the upper part of the member. Boreholes near Clovenstone [NS 333 616] show individual flows are between 3 m and 20 m thick, with an average of about 10 m. In the boreholes, the flows are almost invariably separated by boles, up to one metre thick, which are rarely seen at outcrop. Most flows contain layers of fresh, massive lava, amygdaloidal lava and hydrothermally altered, autobrecciated, slaggy material. The altered and slaggy material  is commonly soft, friable and in some cases makes up 90 per cent of the flow. \r
\r
To the south of the Murishiel Fault, upper and lower parts to the Strathgryfe Lava Member are separated by the lavas and volcaniclastic deposits of the Misty Law Trachytic Member (Paterson et al., 1990)."""@en ;
    lexicon:hasLowerBoundaryDefinition "From Cloch Point [NS 20 75] and Dunrod Hill [NS 24 72] to Port Glasgow [NS 32 74] the Strathgryfe Lava Member rests disconformably upon sedimentary rock of the underlying Clyde Sandstone Formation. To the south and south east, from Loch Thom [NS 25 71] to Largs [NS 20 59], the Strathgryfe Lava Member is conformably underlain by earlier lavas and tuffs of the Clyde Plateau Volcanic Formation. In that area, east of the Largs Fault-zone, the underlying Greeto Lava Member consists dominantly of flows of plagioclase-microphyric basalt (Jedburgh type). To the south, in the Kilbirnie Hills, the Strathgryfe Lava Member extends southwards beyond the limit of the Greeto Lavas and rests unconformably on the Kelly Burn Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4879 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 750 m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Renfrewshire Hills, the dominantly olivine-free lavas (mugearite and hawaiite) of the upper parts of the Strathgryfe Lava Member are overlain by the more-mafic olivine-bearing basalts (Dunsapie and Craiglockhart types) of the Marshall Moor Lava Member. The change is abrupt and could imply a significant time interval between the two volcanic episodes. To the south, on the south-eastern edge of the Kilbirnie Hills, the thinning Strathgrye Lava Member is overlain directly by volcaniclastic sedimentary rocks of the Kirkwood Formation and sedimentary rocks of the Lower Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Strathgryfe Lavas, Upper Strathgryfe Lavas, Lower Strathgyrfe Lavas [Obsolete: use SGLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Hawaiite and mugearite with subsidiary plagioclase-macrophyric basalt and trachyandesite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SGLA"@en ;
    skos:prefLabel "Strathgryfe Lava Member"@en ;
.

namedrockunit:SGM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-grained, granular dolostones, pale to dark grey in colour, although commonly pale cream coloured. Chert nodules and layers are common near the base. Towards the top there are bands of pink and cream limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the dark grey, chert-rich dolostones of the Sailmhor Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1814 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 180 m thick, measured as 60 m thick at Balnakiel Bay."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by dolomitic limestones of the Balnakiel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sangomore Group [Obsolete: use SGM]"@en ;
    skos:broader namedrockunit:DNG ;
    skos:definition "Dolomitic limestone, dolostone and limestone with subsidiary breccia and chert. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series - to - Arenig Series (Ordovician Period) (486.5-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SGM"@en ;
    skos:prefLabel "Sangomore Formation"@en ;
.

