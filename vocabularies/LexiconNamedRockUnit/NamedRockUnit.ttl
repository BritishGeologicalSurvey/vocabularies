namedrockunit:ORRIS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stratigraphically complex sequence of stratified coarse-grained diamictons, sands and gravels. It is dominated by material derived from offshore within the Irish Sea basin. The Formation includes tills that are thought to have been formed subglacially or by glaciomarine deposition, and some of sands and gravels show extensive flow folding."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies the glacially tectonically deformed complex of diamictons, gravels and shelly sands of the Shellag Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to at least 60m"@en ;
    lexicon:hasUpperBoundaryDefinition "At the base of the stratigraphically complex sequence of laminated and massive muds with dropstones, gravel, sand and muddy diamicton comprising the Jurby Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ISCG ;
    skos:definition "Diamicton, gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ORRIS"@en ;
    skos:prefLabel "Orrisdale Formation"@en ;
.

namedrockunit:ORRN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale to dark grey, argillaceous siltstone, coarsening upwards into fine-grained, bioturbated, carbonaceous, kaolinitic sandstone and massive, fine to medium-grained (occasionally coarse), silica cemented sandstone with occasional cross-bedding. Gamma log character suggests that there are two major upward coarsening sandstone units overlain by thin, persistent, fossiliferous mudstone that is, in turn, capped by a major cross-bedded sandstone unit. Thin coals and rootlet horizons occur."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the base of the lower, upward-coarsening siltstone-sandstone unit. There is a minor, but distinct, downward increase in mud content at the boundary with Lady's Walk Formation, reflected in the downward increase in gamma values. In Well 12/26-1, where the Orrin Formation rests unconformably on either the Mains Formation or a remnant of the Lady's Walk Formation, there is a downward change from sandstone to mudstone and a sharp down-section increase in gamma values."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 60 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is marked by a downwards change from interbedded mudstones, sandstones and coal (Brora Coal Formation) to predominantly clean mudstones and a down-section decrease in gamma values and an increase in velocity. The Orrin Formation has a more uniform wireline-log response compared to the overlying Brora Coal Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DUNR ;
    skos:definition "Sandstone and siltstone and trace coal. Stratified bedrock. Occurs offshore. Deposited during the Pliensbachian Age - to - Toarcian Age (Jurassic Period) (192.9-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ORRN"@en ;
    skos:prefLabel "Orrin Formation"@en ;
.

