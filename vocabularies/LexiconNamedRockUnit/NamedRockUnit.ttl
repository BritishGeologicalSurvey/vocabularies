namedrockunit:IRE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use KENT] Pale to dark grey, massive or thickly bedded limestone, commonly pervasively recrystallised with bedding planes which are either stylotitic or totally obscured; dolomitisation and haematite staining common in the south of the inlier with the limestone becoming cavernous and mottled brown in colour."@en ;
    lexicon:hasLowerBoundaryDefinition "In Millom Park, it is a member within the Kirkley Bank Formation where it overlies volcaniclastic sandstone of the Low Scales Member; the base of the Ireleth Member is taken at the base of the limestone. Elsewhere the member overlies locally the Skiddaw Group and Borrowdale Volcanic Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1614 ,
        namedrockunit:H2866 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasOldestAgeValue 4.4925e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 30 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the base of a sequence of calcareous siltstone within the main part of the Kirkley Bank Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasYoungestAgeValue 4.4875e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KENT ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "High Haume Limestone [Obsolete: use IRE]"@en ,
        "Ireleth Limestone [Obsolete: use IRE]"@en ,
        "Kentmere Limestone Member"@en ;
    skos:definition "Obsolete name. Limestone. Stratified bedrock. Occurs onshore. Deposited during the Cautleyan Stage (Ordovician Period) (449.25-448.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IRE"@en ;
    skos:prefLabel "Ireleth Member [Obsolete: use KENT]"@en ;
.

