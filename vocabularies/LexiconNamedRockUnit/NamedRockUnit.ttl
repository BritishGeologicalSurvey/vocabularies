namedrockunit:DRTM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the Plymouth region, the Dartmouth Group is divided into the Whitsand Bay Formation and the Bin Down Formation; this is an intercalation towards the top of the Whitsand Bay Formation. The Whitsand Bay Formation comprises reddish purple mudstone and silty mudstone (beds commonly up to 2 m thick), green silty mudstone to muddy siltstone (with bedding units of between 5 to 10 m thick), green to mauve siltstone (in massive beds up to 6 m thick that are predominantly structureless but have local lenses and laminae), grey-green with some purple sandstone (beds up to 0.8 m thick with local conglomerate above erosional bases) and off-white to pale green quartzite (isolated beds up to 0.5 m thick, with some grading and low-angle cross lamination). The Bin Down Formation includes grey to dark grey cleaved mudstone, grey siltstone (laminated in place) and pale grey quartzitic sandstone. Interbedded with these sedimentary rocks are basaltic lavas and volcaniclastic beds including tuff and hyaloclastite."@en ;
    lexicon:hasLowerBoundaryDefinition "This is a thrust-fault contact; this unit forms the hanging walls of two thrusts to the west of the  Cawsand Fault. The thrusts are dextrally displaced by the Portnadler, Portwrinkle and Rame Faults, and place the Dartmouth Group on top of the Bovisand Formation of the Meadfoot Group. In the field, the lower boundary of the Dartmouth Group is distinguished by an abrupt transition from grey slaty mudstone with thin interbeds of grey-green siltstone and fine-grained sandstone of the Meadfoot Group at the fault plane, up into reddish purple mudstone and green silty mudstone to muddy siltstone of the Dartmouth Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DTMS ,
        namedrockunit:H2157 ,
        namedrockunit:H2766 ,
        namedrockunit:H2767 ,
        namedrockunit:H4624 ,
        namedrockunit:WSA ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 3300 m."@en ;
    lexicon:hasUpperBoundaryDefinition "This is a transitional boundary with the overlying Bovisand Formation of the Meadfoot Group. The contact is seen at Tregantle Cliffs [SX 388 526], where the uppermost strata of the Whitsand Bay Formation of the Dartmouth Group comprise interbedded red and green slaty mudstone with sporadic thin quartzose sandstone beds and grey slaty mudstone; this sequence is succeeded by rocks of the overlying Bovisand Formation, which  comprise  bioturbated grey mudstone with sandstone laminae, thin beds and load casts and black phosphatic nodules. Near Oldhouse Cove [SX 367 536] the contact is expressed as an upward passage into grey slaty mudstone with thin interbeds of grey-green siltstone and fine sandstone, with dark grey mudstone becoming predominant over an interval of 20 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:WTD ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dartmouth Beds [Obsolete: use DRTM]"@en ,
        "Dartmouth Slates [Obsolete: use BIN, DRTM, WTD]"@en ,
        "Scobbiscombe Sandstones [Obsolete: use DRTM]"@en ,
        "The Wembury Siltstones [Obsolete: use DRTM]"@en ,
        "Warren Sandstones [Obsolete: use DRTM]"@en ,
        "Whitsand Bay Formation"@en ,
        "Yealm Formation [Obsolete: use DRTM]"@en ;
    skos:definition "Mudstone, sandstone and siltstone and trace hyaloclastite, lava and tuff. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BIN ,
        namedrockunit:WTD ;
    skos:notation "DRTM"@en ;
    skos:prefLabel "Dartmouth Group"@en ;
.

namedrockunit:DUNL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:DARW ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Siltstones and mudstones, sometimes sandy, together with minor quantities of sandstone. The group is defined as containing the following formations: \r
Amundsen Formation; \r
Burton Formation; \r
Cook Formation; \r
Darwin Formation; \r
Drake Formation; \r
Speke Formation."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at the base of the Amundsen Formation, which is placed at a downward change from mudstones to sandstones (Nansen Formation) and a downward decrease in gamma values."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5188 ,
        namedrockunit:H5189 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "North Viking Graben: up to c. 1000 m. East Shetland Basin: a few metres to +250 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by the top of the Drake Formation. This is placed at a downward change from sandstones (Broom Formation) to mudstones and a downward increase in gamma values. Locally there is a downward change from micaceous mudstones (of the Rannoch Formation) to poorly micaceous mudstones accompanied by a decrease in gamma values and increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Darwin Formation"@en ,
        "Dunlin Shale Unit [Obsolete: use DUNL]"@en ,
        "Dunlin Silt Unit [Obsolete: use DUNL]"@en ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Hettangian Age - to - Aalenian Age (Jurassic Period) (201.4-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AMND ,
        namedrockunit:BURT ,
        namedrockunit:COOK ,
        namedrockunit:DARW ,
        namedrockunit:DRKE ,
        namedrockunit:SPEK ;
    skos:notation "DUNL"@en ;
    skos:prefLabel "Dunlin Group"@en ;
