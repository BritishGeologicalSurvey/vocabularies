    skos:broader namedrockunit:BLPL ;
    skos:definition "Mudstone, sand and sandstone with subsidiary limestone and ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HFD"@en ;
    skos:prefLabel "Harford Member"@en ;
