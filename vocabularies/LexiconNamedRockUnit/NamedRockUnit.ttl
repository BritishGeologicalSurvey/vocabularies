    lexicon:hasLithologyDescription "Consists largely of olivine-basalt except for a feldspar-phyric basaltic flow on Beinn Airein [NM 403 792] and an impersistent feldspar-phyric olivine-basalt on Eilean nan Each [NM 393 894]. The member occupies most of Muck, and gives rise to the strong trap topography of the island. The highest of three members of the Eigg Lava Formation (EIGL) on Muck."@en ;
    lexicon:hasLowerBoundaryDefinition "Preceded by the Port An t-Seilich Member (PATS)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Emeleus (1997, fig. 40) shows a thickness of c. 90 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The member is the highest part of the lava succession on Muck."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:EIGL ;
    skos:definition "Olivine-basalt with subsidiary feldspar-phyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BAAS"@en ;
    skos:prefLabel "Beinn Airein-An Stac Member"@en ;
