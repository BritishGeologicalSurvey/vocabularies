namedrockunit:CLK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, fine-grained limestones with interbedded mudstones and flaggy dolomites characterised by abundance of algal macrostructures including stromatolites and oncolites. Overlying Park Hill Limestone is more bioclastic, contains productoid brachiopods, is more dolomitic and lacks abundance of algal macrostructures. The upper part of underlying Stone Gill Limestone has thick-bedded porcellanous limestones and thin-bedded dolomites with 'Camarotoechia proava'."@en ;
    lexicon:hasLowerBoundaryDefinition "At base of 'Spongiostroma Band' of Turner, 1950. (Stone Gill, Ravenstonedale)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "52 metres strata visible in continuous section in Stone Gill but Turner (1950,p.30) estimated that a further 31 metres are cut out by faulting. Maintains a thickness of about 50 metres across NY60NE and NY60NW as far as Gaisgill, then thins westward to 20 metres at west edge of NY60NW."@en ;
    lexicon:hasUpperBoundaryDefinition "At top of Algal Nodular Beds under Coldbeck Bridge. (Stone Gill, Ravenstonedale)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Dolostone, limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLK"@en ;
    skos:prefLabel "Coldbeck Limestone Formation"@en ;
