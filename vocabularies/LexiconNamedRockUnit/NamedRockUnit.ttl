namedrockunit:ABO
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:CLD ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, pale grey, ooidal grainstone with some fine-grained micritic and dolomitic interbeds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at the sharp junction between a thin dolostone underlying the lowermost ooidal grainstone of the Abercriban Oolite Subgroup and the top of the grey mudstones forming the uppermost part of the Cwmynyscoy Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1942 ,
        namedrockunit:H3786 ,
        namedrockunit:H3787 ,
        namedrockunit:H629 ,
        namedrockunit:PDOL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 30m in the Chwar Pant-y-rhiw area [c.SO 200 157]."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at a palaeokarstic surface, below which the ooidal grainstone at the top of the Abercriban Oolite Subgroup becomes increasingly disordered upwards and irregular ooidal limestone masses become separated by grey-green mudstone films. The palaeokarstic surface marks a regionally developed unconformity, overlain by micritic to grainstone limestones of the Llanelly Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Abercriban Oolite Formation [Obsolete: use ABO]"@en ,
        "Abercriban Oolite Group [Obsolete: use ABO]"@en ,
        "Abercriban Oolite [Obsolete: use ABO]"@en ,
        "Clydach Valley Subgroup"@en ,
        "Oolite Group (part) [Obsolete: use ABO]"@en ,
        "Pendine Oolite [Obsolete: use ABO]"@en ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Ooid-limestone with subsidiary dolostone and micritic limestone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage - to - Chadian Substage (Carboniferous Period) (359.3-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PDC ;
    skos:notation "ABO"@en ;
    skos:prefLabel "Abercriban Oolite Subgroup"@en ;
