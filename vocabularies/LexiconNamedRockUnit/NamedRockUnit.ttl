    lexicon:hasLithologyDescription "Variably interbedded sandy micaceous planty siltstones and fine-grained sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp between fossiliferous fissile clayey blue-grey mudstones with limestone nodules and thin sideritic lenses of Caton Shale below and siltstones with sandstones of the Barncroft Beck Beds above. Coincident with the base of the Claughton Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1963 ,
        namedrockunit:S502 ;
