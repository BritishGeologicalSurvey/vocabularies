namedrockunit:MGF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cross-bedded, lithic arenite, 'Pennant' sandstone in the lower part, and an upper part with thick grey fissile mudstone beds interbedded with sandstone and sparse coal seams (Kellaway and Welch, 1993). The sandstone weathers to a distinctive red to purple colour. \r
\r
The sandstones formed in channels and floodplains within a broad alluvial tract, with palaeocurrents toward the north and north-west (Cleal and Thomas, 1996). \r
\r
A poor record of Alethopteris serlii Subzone macroflora is listed by Cleal (1997) suggesting a late Bolsovian age."""@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the lowermost lithic arenite 'Pennant' sandstone of the Mangotsfield Member, resting sharply upon the Mangotsfield Coal, present at the top of the Downend Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1692 ,
        namedrockunit:H4793 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to c. 580 m at Iron Acton [ST 67 84] to Engine Common [ST 70 84]; 450 m proved in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of member is taken at the top of the Rudge Vein Coal in the Somerset Coalfield; top of the High Vein Coal in the Bristol Coalfield; top of the Avonmouth No. 2 Coal in the Severn Coalfield. Overlain by grey mudstone of the Farrington Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasYoungestAgeValue 3.1e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Mangotsfield Formation [Obsolete: use MGF]"@en ,
        "Mangotsfield Group [Obsolete: use MGF]"@en ;
    skos:broader namedrockunit:PES ;
    skos:definition "Lithic-arenite and mudstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage (Carboniferous Period) (314.75-310 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FCCS ,
        namedrockunit:MDCO ,
        namedrockunit:TCLC ;
    skos:notation "MGF"@en ;
    skos:prefLabel "Mangotsfield Member"@en ;
