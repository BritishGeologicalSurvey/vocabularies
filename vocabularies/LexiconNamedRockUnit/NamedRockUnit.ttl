    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "30 to 1100m (excluding intrusive igneous rocks)."@en ;
    lexicon:hasUpperBoundaryDefinition "Usually marked by dacitic lapilli-tuff of the overlying Lincomb Tarns Tuff Formation [andesitic sills may intervene locally] or in the Kentmere area by the Kentmere Pike Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
