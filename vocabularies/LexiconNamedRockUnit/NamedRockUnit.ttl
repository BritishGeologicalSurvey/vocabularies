    lexicon:hasThicknessDescription "To 5.48m. (18 ft.) in the Durham Province."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the overlying dolostones and limestones of the Raisby Formation in the Durham Province or the equivalent Cadeby Formation in the Yorkshire Province."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kupferschiefer Formation"@en ,
        "Lower Permian Marl"@en ,
        "Marl Slate [Obsolete: use MLSL]"@en ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Dolostone and trace calcareous mudstone and mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MLSL"@en ;
