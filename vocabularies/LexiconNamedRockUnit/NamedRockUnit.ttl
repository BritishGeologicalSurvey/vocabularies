namedrockunit:BTYH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pink-grey psammite, gneissose, locally migmatitic, interlayered on cm-m scale with gneissose semipelite and pelite. Abundant quartzo-feldspathic segregations. At the structural base locally a c. 300 m thick sillimanite-bearing gneissose pelite unit. No sedimentary structures preserved. Abundant thin amphibolite lenses."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable upon Lewisian Gneiss inlier (L); unconformity highly sheared. In many places, base is cut and deformed by the Torrisdale thrust."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription " c. 1000-2000 m (post-deformational thickness)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unknown: cut by Swordly thrust."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Gneissose pelite, gneissose psammite and migmatitic psammite with subsidiary migmatitic semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:INAV ;
    skos:notation "BTYH"@en ;
    skos:prefLabel "Bettyhill Formation"@en ;
.

