namedrockunit:UMB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "An amygdaloidal olivine basalt with calcite and chlorite infilling vesicles. At the type locality the lava is brown-weathered with a flow banding and degraded lava blocks up to 0.6 m diameter. In Miller's Dale, where the member is thickest, the member was subdivided into a 5.2 m thick tuff with a thin amygdaloidal basalt, overlain by a 30 m thick lava, at least in part comprising non-vesicular, holocrystalline basalt with spheroidal weathering (Walters and Ineson, 1981)."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type section, basalt of the Upper Miller's Dale Lava Member rests upon dark grey, thinly bedded, fine-grained limestone of the Miller's Dale Limestone Formation. Outside of the Miller's Dale area the Member rests disconformably upon pale grey limestones of the Bee Low Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2518 ,
        namedrockunit:H3745 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to about 35 m thick in Miller's Dale (SK 140 730), decreasing markedly to the east toward the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "At the type locality, an irregular upper surface of the lava is overlain by grey, fine-grained, irregularly bedded limestones of the Monsal Dale Limestone Formation, including rounded and decomposed fragments of lava immediately above the boundary."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Upper Miller's Dale Lava [Obsolete: use UMB]"@en ,
        "Upper Millers Dale Basalt [Obsolete: use UMB]"@en ;
    skos:broader namedrockunit:MO ;
    skos:definition "Basalt with subsidiary tuff. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UMB"@en ;
    skos:prefLabel "Upper Miller's Dale Lava Member"@en ;
.

