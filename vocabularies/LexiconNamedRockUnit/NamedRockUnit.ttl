    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "300 - 500m (estimated 300+m in Sheet 55W); not mapped separately in Sheet 55E, but transition to Ben Ledi Grit or equivalent probably occurs 300 - 500m above base of Southern Highland Group, close to main 'Green Beds' unit."@en ;
    lexicon:hasUpperBoundaryDefinition "Change from dominantly semipelitic rocks to dominantly psammitic rocks (not seen in Sheet 55W). In parts of the outcrop outwith Sheet 55W, the change coincides with the main volcaniclastic unit."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pitlochry Schist [Obsolete: use DCPS]"@en ;
    skos:broader namedrockunit:SOHI ;
