namedrockunit:HST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, calcareous, generally fine-grained, micaceous, locally well laminated, pale grey to greenish/olive grey. Contains clayey partings and lignite fragments and rootlet traces. Frequently shows internal slumping and deformation. Informally subdivided by an interposed mudstone, south of Christ's Hospital [TQ 148 285] in the Horsham area."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is conformable at the change from mudstones and silty mudstone of the lowest part of the Weald Clay Formation into the fine-grained calcareous sandstone of the Horsham Stone. This horizon is known to be closely underlain by a significant but unnamed clay ironstone seam. Within the Warninglid Borehole TQ22NW/1 [TQ 2488 2701] this change is marked by the change from greenish grey mudstone up into ripple marked sandstone with lignite laminae and mud-flake conglomerate."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1604 ,
        namedrockunit:H967 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 1 and 2m generally, but up to 9m in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is conformable at the change from fine-grained calcareous sandstone of the member into mudstone of the Weald Clay Formation. Up-section change from thinly bedded, ripple marked, calcareous sandstone, locally lignitic (Horsham Stone Member, Weald Clay Formation) into silty clays, locally sandy immediately above the Horsham Stone Member (Weald Clay Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasYoungestAgeValue 1.265e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Horsham Stone [Obsolete: use HST]"@en ,
        "Weald Clay Bed 1 (A and B) [Obsolete: use HST]"@en ;
    skos:broader namedrockunit:WC ;
    skos:definition "Calcareous sandstone, limestone and sandstone with subsidiary clay and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hauterivian Age (Cretaceous Period) (132.6-126.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HST"@en ;
    skos:prefLabel "Horsham Stone Member"@en ;
.

