    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "7m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of black shaly mudstones with limestones and minor cherts (Bailey's Beds), forming the upper part of the Bampton Limestone Formation, above the blocky cherts with few limestones of the Kersdown Chert Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
