namedrockunit:CDGR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cobble gravel with a sandy, silty,clayey matrix, clast-supported, very dense, containing clasts mainly of Devonian sandstones and siltstones, with some granite and psammite. Strong weathering profile developed with pelitic schist clasts decomposed."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, undulating, erosional, unconformable contact with stony sandy clayey diamicton of the Suidheig Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3285 ,
        namedrockunit:S755 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational contact with white clayey gravel of the Rehiran Cryoturbate Member of the Dalcharn Palaeosol Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Craig an Daimh Member [Obsolete: use CDGR]"@en ,
        "Dalcharn Gravel Formation [Obsolete: use CDGR]"@en ;
    skos:broader namedrockunit:IAG ;
    skos:definition "Gravel with subsidiary sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CDGR"@en ;
    skos:prefLabel "Craig an Daimh Gravel Formation"@en ;
.

namedrockunit:CDPL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:S385 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GDFO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GNP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGNA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "An asymmetrically zoned intrusive body with an inner zone of medium- to coarse-grained porphyritic granite and an outer zone of foliated granodiorite. Both zones are intruded by thin aplite veins. A series of microdiorite dykes are linked genetically to the intrusion of the pluton."@en ;
    lexicon:hasLowerBoundaryDefinition "Intrusive margin of the pluton against surrounding contact metamorphosed rock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3287 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/P> ;
    lexicon:hasThicknessDescription "Modelling of gravity data indicates that it extends to a depth of 9km. (Lintern, B C and Floyd, J D. 2000; Bott and Masson Smith, 1960)."@en ;
    lexicon:hasUpperBoundaryDefinition "Not applicable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Criffel Granite, Criffel and Dalbeattie (Granite) Mass [Obsolete: use CDPL]"@en ,
        "Criffel-Dalbeattie Granodiorite Complex"@en ;
    skos:broader namedrockunit:GALGR ;
    skos:definition "Porphyritic granite with subsidiary foliated granodiorite and trace aplitic microgranite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CDPL"@en ;
    skos:prefLabel "Criffel-Dalbeattie Pluton"@en ;
.

namedrockunit:CECL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale bluish grey mudstone, chocolate brown at the base. Bed 3 is a chocolate brown mudstone, gritty at base overlain by pale blue sandy mudstone with fragments of pyritised wood, bivalves and clay-ironstone nodules. Bed 5, of brown mudstone with a cementstone at its base, is overlain by the major part of the member that comprises pale bluish, grey poorly-laminated mudstone with irregular small nodules and red clay-ironstone nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable at the boundary between hard, greenish, calcareous, coarse-grained sandstone (Simpson, 1985 Bed 2; the Perna Member) and the slightly gritty base of chocolate-brown mudstone (Simpson, 1985 Bed 3 of this member)"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2555 ,
        namedrockunit:H2678 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "18 to 19m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is placed (Simpson, 1985) at the base of his Bed 7, which is identified by the upward change from pale grey, poorly-laminated mudstone (of Bed 6) into pale blue grey mudstone with small brown nodules (Lower Lobster Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Atherfield Clay [Obsolete: use AC, CECL]"@en ,
        "Atherfield Clay sensu Fitton (1847, p. 296 part of Bed 3) [Obsolete: use CECL]"@en ;
    skos:broader namedrockunit:AC ;
    skos:definition "Mudstone and sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CECL"@en ;
    skos:prefLabel "Chale Clay Member"@en ;
.

namedrockunit:CEDN
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S866 ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Breccia formed of limestone and dolostone together with sparse clasts of red mudstone filling subvertical karstic fissures in the limestone and dolostones of the Zechstein Group (formerly Magnesian Limestone) (Francis, 1970). Two distinct units occur. The lower \"unfossiliferous fissure fills\" are likely to be either Mesozoic or early Palaeogene in age as they are similar to evaporite dissolution breccias that occur elsewhere within the Permian limestones. The upper \"fossiliferous fissure fills\" contain clay, in addition to limestone debris, that has yielded assemblages of partially pyritized organic material including peat, seeds, tree trunks, ostrocods, mammalian bones and freshwater molluscs. The remains of over 100 species of plant have been identified from lower parts. Of this \"Castle Eden Flora\" 64% of the species no longer grow in Britain, or are extinct. This flora suggests an Early Pleistocene age, which is supported by the identification of Mammuthus meridionalis, an elephant that was common in Europe in the Early Pleistocene up to the Cromerian. Sparse glacial erratics of supposed Scandinavian origin have been found in fissure fill deposits south of Limekiln Gill [NZ 4776 3813]."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with underlying fractured limestones and dolostones of the Zechstein Group (formerly Magnesian Limestone). The fissures are generally linear, vary from 1 to 7 m wide and extend down to 25 m vertically through the limestone cliffs from rockhead, locally along faults. Other fissure fills are cylindrical in shape. Fissure walls commonly bear subvertical slickensides resulting from compaction and many of the fragments are striated and polished."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H762 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/MZ> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Channelled erosional, unconformable contact with overlying limestone-rich gravel of the Limekiln Gill Gravel Formation or planar subhorizontal, unconformable contact with dark grey stony sandy silty clay diamicton of the Blackhall Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QC> ;
    lexicon:hasYoungestAgeValue 4.8e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blackhall Colliery Formation"@en ,
        "Durham Fissure Fillings [Obsolete: use CEDN]"@en ;
    skos:broader namedrockunit:GBG ;
    skos:definition "Breccia. Stratified superficial deposits. Occurs onshore. Formed during the Mesozoic Era () - to - Cromerian Stage (Quaternary Period) (251.9-.48 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CEDN"@en ;
    skos:prefLabel "Castle Eden Fissure-fill Formation"@en ;
.

