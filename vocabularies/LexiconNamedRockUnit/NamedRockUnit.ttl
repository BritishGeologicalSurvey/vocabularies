namedrockunit:UCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine-grained, calcareous, spicule-rich, bioturbated, massive, ammonitiferous (Spaunton Sandstone Member) overlain in the west and centre of the Cleveland Basin by sandstone, very fine-grained, calcareous, spicule-rich, bedded to flaggy (Snape Sandstone Member); in the east and centre underlain by grey calcareous mudstone and flaggy clayey sandstone (Newbridge Member); succession passes south and west from the base upwards into calcareous mudstone (Langton Clay Member) overlain by spicular silty fine-grained limestone interbedded with calcareous sandstone or mudstone (North Grimston Cementstone Member) with shelly clayey sandstone (Limekiln Member) locally at the base"@en ;
    lexicon:hasLowerBoundaryDefinition "Non-sequence: rubbly coralliferous shelly limestone (Coral Rag Member) or where absent, ooidal limestone (Malton Oolite Member, both of Coralline Oolite Formation) sharply overlain by silty mudstone and fine-grained sandstone (Newbridge Member) or fine-grained calcareous sandstone (Spaunton Sandstone Member) or interbedded unfossiliferous fine-grained limestone and calcareous sandstone and mudstone (North Grimston Cementstone Member) or mudstone (Langton Clay Member) or sandstone (Limekiln Member), all of Upper Calcareous Grit Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1171 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Typically 14 to 24m (Arkell, 1933, p.421), 9m (Harome Borehole), 22m (Brown Moor Borehole, SE86SW/4 [81266 62043] ), possibly up to 33m (BGS Sheet 54 Scarborough)"@en ;
    lexicon:hasUpperBoundaryDefinition "Locally conformable but more widely non-sequential or unconformable: fine-grained sandstone, spicule-rich and/or calcareous, passing up or sharply overlain by grey silty mudstone (Ampthill Clay Formation). In the south, fine-grained limestone (North Grimston Cementstone Member) or calcareous mudstone (Langton Clay Member) sharply overlain by grey silty mudstone (Ampthill Clay Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Calcareous Grit [Obsolete: use UCG, SDT]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Calcareous sandstone and siltstone with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LNGC ,
        namedrockunit:NGRC ;
    skos:notation "UCG"@en ;
    skos:prefLabel "Upper Calcareous Grit Formation"@en ;
.

namedrockunit:UCK
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:MUCK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """White chalks (microporous coccolithic limestone) with beds of flint, nodular chalks, hardgrounds and marl seams. Note: No type section has been established. See Chalk Rock for stratotypes of base of Upper Chalk. \r
\r
Name remains in informal use but generally regarded as obsolete onshore."""@en ;
    lexicon:hasLowerBoundaryDefinition "At base of Chalk Rock, a hard basal unit. (Conventionally also taken at base of Holaster planus Zone)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4948 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 60 m preserved in the Hitchin district, more than 300 m in parts of Norfolk."@en ;
    lexicon:hasUpperBoundaryDefinition "In mainland Britain this is an unconformity overlain by post-Cretaceous formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KM> ;
    lexicon:hasYoungestAgeValue 6.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chalk, Undivided, Upper (Now Upper Chalk Formation) [Obsolete: use UCK]"@en ,
        "Middle Chalk Formation and Upper Chalk Formation (Undifferentiated)"@en ;
    skos:broader namedrockunit:CK ;
    skos:definition "Chalk with subsidiary calcareous mudstone and flint. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Turonian Age - to - Maastrichtian Age (Cretaceous Period) (93.9-66 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:TSCH ;
    skos:notation "UCK"@en ;
    skos:prefLabel "Upper Chalk Formation"@en ;
.

namedrockunit:UDSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:DLBS ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine grained banded grey and buff slates; tough, with well eveloped cleavage. Feint iron-oxide spotting; elsewhere, cleavage planes are spotted by pyrite, chalcopyrite and pyrrhotite. Locally slates are weathered greenish grey; at some localities later crenulation cleavages are seen to cross the slaty cleavage."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable with the underlying Lower Delabole Slates; a sequence of dark grey slates which are seen to underlie the Upper Delabole Slates (greenish grey slates) in the Old Delabole Slate Quarry."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3996 ,
        namedrockunit:SLBD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Not exposed, but possibly is a conformable contact with the overlying Woolgarden Slates: a sequence of coarse-grained chloritoid-chlorite-mica-quartz slates with alternating bands of saccharoidal textured quartz and chlorite sericite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Delabole Member"@en ,
        "Delabole Slates [Obsolete: use UDSL, TVY, DLBS, TSL]"@en ,
        "Slaughterbridge Beds [Obsolete: use UDSL]"@en ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Late Devonian Epoch (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "UDSL"@en ;
    skos:prefLabel "Upper Delabole Slates"@en ;
.

namedrockunit:UGSD
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:UGS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use UGS] Unconsolidated non-calcareous sands (with glauconite), chert and cherty sandstone, thin clay seams and shell beds. A few calcite-cemented sandstones and limestones in the Bovey Basin, especially at Wolborough [SX 855 700]. Locally gravelly. Divided into four members. NOTE: Callum Sands with Cherts Member (sand with cherts, 6.7m); Ashcombe Gravels Member (sandy quartz gravels and coarse gravelly quartz sands, 5.3m); Woodlands Sands Member (glauconitic clayey sands, shell beds, sands with siliceous concretions, 4.1m); Telegraph Hill Sands Member (green glauconitic sands, 5.3m)."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Haldon Hills the sands of the unit rest unconformably on breccias of the Permian Exeter Group. In the Bovey Basin they rest variably on Devonian, Carboniferous and Permian rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1299 ,
        namedrockunit:H4417 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 76m (Haldon Hills); c.20m (Bovey Basin)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Upper Greensand Formation is overlain in the Haldon Hills by the Tower Wood Gravel with a sandy flint-free bed up to 12.5cm thick with well-rounded quartz and schorl pebbles at the junction (Pickard, 1949). In the Bovey Basin the unit is generally overlain by the Aller Gravel (Edwards, 1973), but Tower Wood Gravel locally intervenes (Brunsden and others, 1976)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:UGS ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Haldon Sands Formation [Obsolete: use ACGR, CUSC, UGSD, WLSS]"@en ,
        "Haldon Sands [Obsolete: use UGSD, ACGR, CUSC, THSS, WLSS]"@en ,
        "Upper Greensand Formation"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary chert, clay and limestone. Stratified bedrock. Occurs onshore. Deposited during the Albian Age - to - Cenomanian Age (Cretaceous Period) (113.2-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UGSD"@en ;
    skos:prefLabel "Upper Greensand Formation (Devon) [Obsolete: use UGS]"@en ;
.

