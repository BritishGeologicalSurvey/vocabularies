namedrockunit:CAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:BTLS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale to dark grey, fine-grained, crinoidal, bioclastic, limestone, interpreted to be of marine origin, generally with two or more leaves separated by about 30cm partitions of mudstone, one leaf of \"calmy\" type being off-white, fine-grained and massive with a conchoidal fracture. The name is not geographical in origin, but instead indicates a \"hard, pale grey or fawn, fine-grained, muddy limestone with a conchoidal fracture\"."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a change from a marine mudstone which has the Edmondia punctatella Band at its base with the Upper Hirst Coal beneath in the Clackmannan basin within the Upper Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H105 ,
        namedrockunit:H106 ,
        namedrockunit:H2045 ,
        namedrockunit:H3267 ,
        namedrockunit:H3268 ,
        namedrockunit:H746 ,
        namedrockunit:H747 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 0.5m to 4.5m in the Airdrie, Falkirk and Glasgow districts, and 15m in shelf settings in Ayrshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly seen as a change to a thick marine mudstone, that passes up into deltaic arenaceous deposits within the Upper Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
