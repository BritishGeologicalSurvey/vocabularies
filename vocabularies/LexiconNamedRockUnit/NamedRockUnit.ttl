namedrockunit:MOSSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/N> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LIGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Muckle Ossa Sandstone is characteristically green to dark green, occasionally black, fine-to-coarse grained, poorly sorted, generally friable but partly calcite cemented, muddy, glauconitic and bioclastic, with sporadic gravel clasts. The bioclasts include molluscs, bivalves and corals. Subordinate interbedded lithologies include dark green mudstones and sandy siltstones (e.g. 77/07), sandy limestones (e.g. 77/09) and lignites (e.g. 202/8-1)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is the composite erosion surface of the shelf unconformity which truncates Palaeogene and older strata and was, at least in part, formed in association with the latest Oligocene/earliest Miocene unconformity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NM> ;
    lexicon:hasOldestAgeValue 2.304e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/NM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "The Muckle Ossa Sandstone is preserved as an eroded, fairly uniform, sheet deposit, locally up to 150 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is everywhere marked by an angular unconformity. This is a composite boundary, marked by the intra-Neogene unconformity over most of the shelf, but where this is absent it is truncated by the glacial unconformity."@en ;
