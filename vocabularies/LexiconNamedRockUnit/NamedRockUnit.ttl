    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "194m+ (uncorrected for structural dip or borehole deviation from the vertical). Thickness includes a 49.3m-thick sill."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen in its original form as the formation is unconformably overlain by Carboniferous strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Yottenfews Formation [Obsolete: use YOT]"@en ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Lapilli-tuff and tuff and trace volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
