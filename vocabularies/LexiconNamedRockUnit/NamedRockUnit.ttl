namedrockunit:CSLL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of several (seven at type section) thin (typically 0.1 m) limestone units separated by mudstone beds. The limestone beds are shelly, pale grey, weathering pale brown, with abundant coarse sand-grade shell debris. Fauna includes forams, serpulids, gastropods, bivalves and echinoderms. The lower part forms a positive feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey, calcareous mudstone of the undifferentiated Granby Member; at 76.26 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H824 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1.5 to 2 m; 1.92 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey, calcareous mudstone of the undifferentiated Granby Member; at 76.34 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasYoungestAgeValue 1.995e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cross Lane Limestone [Obsolete: use CSLL]"@en ;
    skos:broader namedrockunit:GRBL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hettangian Age (Jurassic Period) (201.4-199.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CSLL"@en ;
    skos:prefLabel "Cross Lane Limestones Bed"@en ;
.

