        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mixed psammite, semipelite and pelite, with rare beds of calc-silicate rock.In the Balnagowan Hill - Queen's Hill area, discrete units of psammite and pelite can be mapped out."@en ;
    lexicon:hasLowerBoundaryDefinition "On Sheet 65E, top of Balnacraig Metabasite Formation (Easdale Subgroup); not seen on sheets 66W, 66E, 76W and 76E."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4854 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Approximately 1700m in northern Sheet 65E, but this may be an overestimate, due to tectonic thickening."@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of dominantly calcareous material at the base of the Deeside Limestone Formation (Sheet 66W) / Water of Tanar Limestone Formation (Sheet 65E) (Tayvallich Subgroup)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
