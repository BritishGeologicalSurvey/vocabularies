namedrockunit:RDLI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Ooid-ironstone in grainstone texture, greenish-brown, brown and purplish, cross-bedded, with bioclastic lenses and laminae and subordinate sideritic mudstone beds; ooids are of berthierine (chamosite) with pores filled with siderite and calcite cement; basal phosphatised pebble bed."@en ;
    lexicon:hasLowerBoundaryDefinition "Non-sequence/disconformity: ooid-ironstone with basal pebble bed sharply overlying yellow-weathering fine-grained sandstone and siltstone of the Low Baring Member (Young, 1994) of the Blea Wyke Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2996 ,
        namedrockunit:H3635 ,
        namedrockunit:H4291 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Generally up to 4m, very locally (Hollins Mines: Kitching's and Garbutt's deposits) possibly up to 25m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity: ferruginous coarse-grained sandstone with lignite fragments and calcareous bioclasts and a basal ooidal ironstone bed with phosphatised gravel-grade clasts (Low House Sandstone Member of Dogger Formation) overlying ooid-ironstone beds of Rosedale Ironstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Rosedale East Ironstone [Obsolete: use RDLI]"@en ,
        "Sheriff Pit Oolite [Obsolete: use RDLI]"@en ,
        "Stanch Bullen Ironstone [Obsolete: use RDLI]"@en ;
    skos:broader namedrockunit:BW ;
    skos:definition "Ooid-ironstone with subsidiary ferruginous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RDLI"@en ;
    skos:prefLabel "Rosedale Ironstone Member"@en ;
