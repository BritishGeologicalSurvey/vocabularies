namedrockunit:ISP
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A greyish, clast-supported, pebble conglomerate with mainly fine-grained greywacke sandstone pebbles and cobbles but also clasts of chert, siltstone, granular sandstone, limestone and granite and with thin intercalations and lenses of greyish medium- and coarse-grained sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Pebble conglomerates of at least 1m thickness sharply overlying red-brown fine- and medium-grained sandstone, towards the top of the Swanshaw Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1617 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Pebble conglomerates are conformably succeeded by greyish medium- and fine-grained sandstones, towards the top of the Swanshaw Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
