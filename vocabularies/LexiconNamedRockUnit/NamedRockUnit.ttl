namedrockunit:MDVS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent
        namedrockunit:BEDN ,
        namedrockunit:H426 ,
        namedrockunit:RNUM ,
        namedrockunit:SAH ,
        namedrockunit:TVS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very variable over the area of outcrop, and within local areas. The cleaved mudstones (shales) are generally light to dark grey in colour with a greenish tinge in many districts, and everywhere weathering buff or buff-green. Commonly calcareous, especially in the upper part; absence of micaceous shales and sandy shales dintinguish them from the Lower Devonian shales. At Hope's Nose (near Torquay), a thickness of approximately 61 m of shales are seen above Lower Devonian grits and thin-bedded limestones at the top of the cliff. At Mudstone Sands, south of Berry Head, 60m of shales are overlain by limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Commonly a thrust contact with a variety of other Devonian and Carboniferous rock types."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly a thrust boundary, juxtaposing the mudstones against other Devonian and Carboniferous rock types. Seen at some localities to be overlain by limestone; transition is gradual with calcareous mudstones common towards the top of the sequence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bedruthan Formation"@en ,
        "Nordon Slate Formation [Obsolete: use NOSL]"@en ,
        "Rosenum Formation [Obsolete: use SAH]"@en ,
        "Saltash Formation"@en ,
        "Trevose Slate Formation [Obsolete: use SAH]"@en ;
    skos:definition "Calcareous mudstone and mudstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Mid Devonian Epoch (Devonian Period) (394.3-378.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "MDVS"@en ;
    skos:prefLabel "Middle Devonian Slates"@en ;
.

