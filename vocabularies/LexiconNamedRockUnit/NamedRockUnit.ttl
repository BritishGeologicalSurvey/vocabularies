    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Minimum thickness (from NM 3698 9106 to NM 3659 9172) of 175m. (Stratigraphical top is nowhere visible; in the type locality the stratigraphical base and top are not visible)."@en ;
    lexicon:hasUpperBoundaryDefinition "Top: not seen (nor defined) on Rhum."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
