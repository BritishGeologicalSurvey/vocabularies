namedrockunit:CEO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive to thick-bedded, locally cross-bedded ooid grainstones. Palaeokarstic surface at the top. Locally overlain by a thin clay palaeosol. Dolomitized along the southeast crop of the South Wales Coalfield.  Interpreted to have been deposited in a barrier environment."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational junction with the underlying skeletal, peloidal and oolitic packstone/grainstones of the underlying High Tor Limestone Formation. Base taken at incoming of a predominantly oolitic grainstone sequence."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "13m in the northern Vale of Glamorgan, thickening southwards to 40m in the central part of the Vale of Glamorgan."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at top of the clay palaeosol capping the Formation, or the top of the underlying palaeokarstic surface if the clay is absent.  The palaeosol/palaeokarst is sharply overlain by a bed of grey calcareous mudstone, overlain by thin- to medium-bedded, fine- to coarse-grained crinoidal skeletal packstones of the Argoed Limestone Member of the Cornelly Oolite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CNLL ;
    skos:definition "Ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CEO"@en ;
    skos:prefLabel "Cefnyrhendy Oolite Member"@en ;
.

