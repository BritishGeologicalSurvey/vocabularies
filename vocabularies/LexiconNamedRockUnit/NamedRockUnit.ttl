namedrockunit:ROAD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale grey to off-white or brownish, more or less clayey or sandy shell fragmental, bioturbated wackestone and packstone, characteristically containing Kallirhynchia sharpi (Muir-Wood) and other brachiopods and bivalves such as mussels and oysters with thin marls and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the described limestones, overlying mudstones of the Rutland Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1143 ,
        namedrockunit:H1791 ,
        namedrockunit:H3004 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically about 1m thick in the type area, elsewhere from about 3m, foe example the 2.51 m recorded by Torrens, 1967, to 2.99 m measured by Cripps,1986, at the type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp boundary with beds of limestone, marl or mudstone lacking K sharpi,commonly a marl or mudstone bed at this level which may prove a reliable marker compared to the mudstone at the base of the Ardley Member of the White Limestone in Oxon."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kallirhyncia Sharpi Beds [Obsolete: use ROAD]"@en ,
        "Rhynconella Zone [Obsolete: use ROAD]"@en ,
        "Sharpi Beds [Obsolete: use ROAD]"@en ;
    skos:broader namedrockunit:BWL ;
    skos:definition "Limestone with subsidiary calcareous mudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ROAD"@en ;
    skos:prefLabel "Roade Member"@en ;
.

namedrockunit:ROBA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey rubbly limestones: in lower part (Witchellia Grit) yellowish, shelly, sandy, ooidal and ironshot with brachiopods and rare ammonites including Witchellia; in middle part (Bourguetia Beds) very shelly with bivalves and gastropods including Bourguetia saemanni (Oppel); in upper part (Phillipsiana Beds) hard, sandy and shelly with brachiopods, including 'Terebratula' phillipsiana (Walker)."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change, locally a hardground, from ooidal and peloidal limestone (Notgrove Member) into limestone of Witchellia Grit as described in lithology."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1792 ,
        namedrockunit:H3644 ,
        namedrockunit:H497 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Type section very approximately 8.5m."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformity/hardground: limestone as in lithology overlain by Salperton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cleeve Hill Beds [Obsolete: use ROBA]"@en ,
        "Middle Ragstones [Obsolete: use ROBA]"@en ,
        "Phillipsiana Beds, Bourguetia Beds and Witchellia Grit [Obsolete: use ROBA]"@en ;
    skos:broader namedrockunit:ASLS ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ROBA"@en ;
    skos:prefLabel "Rolling Bank Member"@en ;
.

namedrockunit:ROH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy, bioturbated, ooidal-mudstones and very fine-grained, very clayey, bioturbated, partly ooidal sands. Calcite-cemented, ooidal ironstones occur locally. At Hunstanton, sandy, phosphatic ironstone nodule horizons contain shelly fossils. In Lincolnshire, the formation has been informally divided into 'Upper Roach' and 'Lower Roach', separated by an indurated calcareous cemented, ooidal sandstone known as 'Roach Stone'. Boreholes at Hunstanton, Skegness and The Wash show a rhythmic succession of interburrowed and interbedded clay, \"chamosite\" mud, chamosite ooids, quartz sand and small pebbles of quartz and ironstone. In Northern Lincolnshire it comprises ferruginous, sandy limestone and ferruginous, ooidal mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "In northern Lincolnshire, near Brigg, ooidal and ferruginous mudstones, sandstones and limestones (Roach Formation) rest unconformably on friable ferruginous limestone of the Tealby Limestone Formation. In southern Lincolnshire, the base is a minor erosion surface where the ooidal and pebbly mudstones and very fine sandstones (Roach Formation) rest on the smooth, fossiliferous clays (Upper Tealby Clay Member of the Tealby Formation). In Norfolk, the erosion surface separates the Roach Formation from the underlying interbedded, fine-grained sands, ferruginous sandstones, silts and clays (Dersingham Formation) or mudstones (Snettisham Clay Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:FBB ,
        namedrockunit:H500 ,
        namedrockunit:RST ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasOldestAgeValue 1.265e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.22m."@en ;
    lexicon:hasUpperBoundaryDefinition "In Norfolk the upper boundary is marked by an erosion surface separating the very pebbly, ooidal clay at the base of the overlying Carstone Formation, from the fine-grained clayey sand of the Roach Formation. Burrows extend down about 30cm into the top of the Roach Formation. Boreholes at Skegness and beneath The Wash prove the junction between grey and dark grey mudstone with Prodeshayesites bodei and iridescent fragments of other ammonites (Skegness Clay) and the ooidal mudstones of the underlying Roach Formation. Farther north, pale grey, fossiliferous, calcareous mudstones (Sutterby Formation) are separated from the ooidal mudstones of the Roach Formation by an erosion surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Fulletby Beds [Obsolete: use ROH]"@en ,
        "Roach (Stone) [Obsolete: use ROH]"@en ,
        "Roach Stone [Obsolete: use ROH]"@en ;
    skos:definition "Calcareous mudstone, mudstone and sandstone with subsidiary ferruginous limestone and sandy limestone and trace ironstone. Stratified bedrock. Occurs onshore. Deposited during the Barremian Age (Cretaceous Period) (126.5-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "ROH"@en ;
    skos:prefLabel "Roach Formation"@en ;
.

