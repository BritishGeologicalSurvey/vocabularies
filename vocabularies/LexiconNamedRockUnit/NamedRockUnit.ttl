namedrockunit:ALDTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravelly clayey sand and diamicton (till), greenish grey (5GY 6/1), stiff, massive to crudely-horizontally bedded, with broken rounded pebbles and cobbles of flint and quartzite reworked from the Buchan Ridge Gravels Formation, together with sparse mica schist, granite, mafic igneous and red sandstone clasts. The matrix is kaolinitic quartz sand. The lithology of the till varies laterally with the underlying bedrock. It thickens to the south and east of the Moss of Cruden, where it includes red granite and has a weak NW-SE clast fabric. The till locally incorporates large masses of weathered brown sand with sparse quartzite clasts of unknown derivation and origin."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, interdigitating glacitectonic boundary with compressed peat and organic sand of the Berryley Peat Bed or with a local unit of Head named informally as the Hardslacks Gelifluctate Bed; or an apparently gradational contact with dark grey diamicton of the Camp Fauld Till Formation; or on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "<10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with red clayey diamicton of the Logie-Buchan Glacigenic Subgroup, or head deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WHGL ;
    skos:definition "Diamicton with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ALDTI"@en ;
    skos:prefLabel "Aldie Till Member"@en ;
.

