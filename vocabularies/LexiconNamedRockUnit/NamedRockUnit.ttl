    lexicon:hasLithologyDescription "Sandstone, pale to mid grey, very calcareous, fine- to medium-grained, small bioclast fragments, bioturbated, and limestones, blue-grey, oolitic, crinoidal, very sandy, scattered quartz pebbles."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt change from peritidal micrites and shales of Termon River Limestone Formation to thick beds of crinoidal calcareous sandstone/sandy packstone of Bin Mountain Sandstone Formation. Conformable."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H70 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "80 - 100m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, apparently gradual change from calcareous sandstones and sandy grainstones of Bin Mountain Sandstone Formation to dark blue-grey fossiliferous sandy packstones and packstones of Ballyshannon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
