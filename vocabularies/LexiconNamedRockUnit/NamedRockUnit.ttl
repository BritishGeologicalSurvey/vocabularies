namedrockunit:BUC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly limestone, both bedded and massive; locally pink and concretionary. Towards the base the limestones contain fragments of quartzite and crystals of barytes. Towards the top of the formation it includes thin beds of red mudstone and sandstone, some of which are calcareous."@en ;
    lexicon:hasLowerBoundaryDefinition "The unconformity with the Cullen Quartzite Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2032 ,
        namedrockunit:H3880 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
