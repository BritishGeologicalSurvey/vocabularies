    lexicon:hasThicknessDescription "c. 2,400m on coast, c. 1,250m seen inland"@en ;
    lexicon:hasUpperBoundaryDefinition "At top of flaggy quartzites where overlain by flaggy micaceous psammites and semipelites of the Findlater Flag Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
