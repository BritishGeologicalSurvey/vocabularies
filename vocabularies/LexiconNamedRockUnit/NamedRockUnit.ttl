namedrockunit:DBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Danny Bridge Limestone Formation consists of pale to mid grey biosparites and biopelsparites (mainly wackestone, with packstone and minor grainstone), and subordinate mudstone in 10 regularly spaced interbeds. Palaeokarst surfaces overlain by bentonitic clays, palaeosols and calcareous laminated crusts are common and the formation displays a characteristically stepped landscape. \r
\r
Shallow marine carbonates (emergent at times). Late Asbian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is conformable on the dark grey limestone of the Garsdale Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is 102-168 m thick, the greatest thickness being on the southern margin of the Askrigg Block (see Dunham and Wilson, 1985)."@en ;
    lexicon:hasUpperBoundaryDefinition "The cross-bedded, regressive sandstones of the Wintertarn Sandstone Member (WTRS), marking the base of the Tyne Limestone Formation, Yoredale Group, overlie the top of the Danny Bridge Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone and trace mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GNWL ,
        namedrockunit:HGEL ;
    skos:notation "DBL"@en ;
    skos:prefLabel "Danny Bridge Limestone Formation"@en ;
.

