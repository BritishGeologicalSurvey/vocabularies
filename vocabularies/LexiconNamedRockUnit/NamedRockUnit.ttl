namedrockunit:FAEOL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fluvio-aeolian deposits are loess-like, usually structureless deposits of primarily aeolian silt or very fine-grained sand which has been moved, redeposited and/or modified in situ by various secondary processes (for example, fluvial, colluvial, pedogenic processes). Deposits may be variably sandy or clayey, but retain a dominant particle size within the coarse silt to very fine-grained sand range."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BRK ,
        namedrockunit:HEB ,
        namedrockunit:HEBO ,
        namedrockunit:HEBY ,
        namedrockunit:RIB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brickearth [Obsolete: use FAEOL]"@en ,
        "Head brickearth [Obsolete: use FAEOL]"@en ,
        "Head brickearth, older [Obsolete: use FAEOL]"@en ,
        "Head brickearth, younger [Obsolete: use FAEOL]"@en ,
        "River brickearth [Obsolete: use FAEOL]"@en ;
    skos:broader namedrockunit:AEOLD ;
    skos:definition "Sand and silt. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FAEOL"@en ;
    skos:prefLabel "Fluvio-aeolian deposits"@en ;
.

namedrockunit:FH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Varies from muds and silty muds to sands and gravelly sands. The former muddy lithologies tend to occur mainly in the lower part of the sequence. NOTE: In this area (56 deg north, 3 deg west + 56 deg north, 4 deg west) it has been possible to subdivide the formation into two members. Unfortunately, although this unit can be extended over a wide area of the west central North Sea, it has not been possible to subdivide the unit elsewhere without present knowledge."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Tay-Forth area (1:250,000 Sheet 56 deg. north, 4 deg. west) the Forth Formation generally rests unconformably on the St Abbs/Wee Bankie Formations or rockhead. Locally it may rest conformably on the St Abbs Formation. Further east in the Marr Bank/Devil's Hole areas (56 deg. north, 2 deg. west, + 56 deg.) the unit may form an infill to deep erosive channels hence resting unconformably on the pre-existing sediments."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2800 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasOldestAgeValue 2.4e-02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Varies from < 5 metres - 60 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of unit is unconformably overlain by seabed sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS001> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Forth Beds [Obsolete: use FH]"@en ;
    skos:broader namedrockunit:REAP ;
    skos:definition "Clay and sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 2 - to - Marine Isotope Stage 1 (Quaternary Period) (.024-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FHA ,
        namedrockunit:FHF ,
        namedrockunit:FHG ,
        namedrockunit:FHW ;
    skos:notation "FH"@en ;
    skos:prefLabel "Forth Formation"@en ;
.

namedrockunit:FLDN
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WSTS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstones, mudstones and coals of the defining formations (listed here in alphabetical order): Beatrice Formation (including the Carr and Louise members); Brora Coal Formation; Hugin Formation; Pentland Formation (including the Rattray Volcanics, Ron Volcanics and Stroma members)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower group boundary is defined by the base of the Pentland Formation, which unconformably overlies Permian, Triassic and Lower Jurassic sediments. Where it overlies Permian sediments, the base is marked by a downward change from coal-bearing sediments and/or volcanics to evaporite-bearing sediments; where it overlies the Triassic, the boundary is marked by a transition from grey coal-bearing sediments and/or volcanics to brick-red siltstones and sandstones; where it overlies Lower Jurassic strata, the boundary is marked by a downward transition from interbedded sandstones, siltstones and coals to predominantly grey siltstones with minor sandstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasUpperBoundaryDefinition "The upper group boundary is variable in the northern North Sea, but is normally marked by the upward transition from sandstones or interbedded sandstones, siltstone and coal to mudstones and siltstones of the overlying Heather Formation (Humber Group). The top of the Fladen Group is generally the top of the Hugin Formation, but in the Central Graben, either the Pentland Formation or Beatrice formation underlies the Heather Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "West Sole Group"@en ;
    skos:definition "Mudstone and sandstone with subsidiary agglomerate, basalt, coal and tuff. Stratified bedrock. Occurs offshore. Deposited during the Aalenian Age - to - Oxfordian Age (Jurassic Period) (174.7-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BETR ,
        namedrockunit:BOCO ,
        namedrockunit:HUGI ,
        namedrockunit:PNTL ;
    skos:notation "FLDN"@en ;
    skos:prefLabel "Fladen Group"@en ;
.

namedrockunit:FLMR
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:HUGI ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation consists predominantly of olive-grey to pale grey, fine- to medium-grained, occasionally pebbly, generally arkosic, glauconitic sandstone. It is often argillaceous or carbonate cemented. In some areas it is massive with few sedimentary structures, but in others it becomes argillaceous and strongly bioturbated with a number of different burrow types. 'Raxella' spicules and bioclastic debris are locally common."@en ;
    lexicon:hasLowerBoundaryDefinition "The formation rests on a variety of Triassic and Devonian deposits. The lower boundary in the Fulmar Field is a change from grey sandstone to Triassic red-beds comprising mudstone or silty sandstone and gamma and velocity values increase. In the Fischer Bank Basin the boundary is placed at a downward change from marine sandstone (Fulmar Formation) to paralic, coal bearing sediments (Pentland Formation). In the Kittiwake Field the sandstone of the Fulmar Formation rests on Triassic sandstone; the boundary is difficult to recognise from log responses and colour change. In the Glamis Field, the formation rests on Devonian strata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5101 ,
        namedrockunit:H5102 ,
        namedrockunit:H5103 ,
        namedrockunit:H5104 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Usually 60-110 m, but up to 366 m in the Fulmar Field. It thins southward onto the Mid North Sea High."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a downward transition from mudstone (Heather or Kimmeridge Clay formations) to sandstone. It is characterised by a down-section decrease in gamma values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Angus Sands [Obsolete: use FLMR, HUGI]"@en ,
        "Frigate Formation [Obsolete: use FLMR]"@en ,
        "Fulmar Sands [Obsolete: use FLMR]"@en ,
        "Hugin Formation"@en ,
        "Puffin Formation [Obsolete: use FLMR]"@en ;
    skos:broader namedrockunit:HMBG ;
    skos:definition "Sandstone. Stratified bedrock. Occurs offshore. Deposited during the Callovian Age - to - Tithonian Age (Jurassic Period) (165.3-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FLMR"@en ;
    skos:prefLabel "Fulmar Formation"@en ;
.

namedrockunit:FML
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:SPRO ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dolomite that comprises three distinct facies: shelf-edge reef that separates a broad belt of back-reef and lagoonal beds to the west from a belt of fore-reef talus aprons and off-reef beds to the east."@en ;
    lexicon:hasLowerBoundaryDefinition "The incoming of oolitic and pisolitic or reef equivalent dolostone above the fine-grained dolostone of the Raisby Formation. Boundary is transgressive, overlapping older Permian formations to lie unconformably on Carboniferous rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H911 ,
        namedrockunit:MMGL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "1 - 150m, generally 100 - 120m"@en ;
    lexicon:hasUpperBoundaryDefinition "Either the sharp, conformable base of the overlying anhydrites of the Hartlepool Anhydrite Formation or the reddish-brown mudstone and siltstone of the Edlington Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ford (Magnesian Limestone) Formation [Obsolete: use FML]"@en ,
        "Middle Magnesian Limestone [Obsolete: use FML]"@en ,
        "Sprotbrough Member"@en ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Dolostone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FMLP ,
        namedrockunit:FMLS ;
    skos:notation "FML"@en ;
    skos:prefLabel "Ford Formation"@en ;
.

namedrockunit:FOEV
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:S887 ,
        namedrockunit:SEHR ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thick and varied sequence of evaporites including anhydrite and halite, with some gypsum and dolostone. Passes laterally into Seaham Residue at outcrop in Durham, and into part of Edlington Formation in Yorkshire outcrop."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Durham province: contact (gradational transition) with the underlying Roker Formation (including the Concretionary Limestone Member) dolostone, marked by the incoming of evaporite rocks. In the Yorkshire province: contact with the top of the Kirkham Abbey Formation dolostone, the incoming of evaporite rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:FOE ,
        namedrockunit:H257 ,
        namedrockunit:PDE ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "396 m in type section; thins to small residue at outcrop."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at base of Brotherton Formation (Yorkshire province) or Seaham Formation (Durham province), marked by the incoming of limestone. Stated as base of Upper Magnesian Limestone in Smith, et al., 1974."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Fordon Evaporite [Obsolete: use FOEV]"@en ,
        "Fordon Evaporites [Obsolete: use FOEV]"@en ,
        "Lower Evaporites, Lower Evaporite Group, also Fordon Evaporite(s) [Obsolete: use FOEV]"@en ,
        "Lower Evaporites."@en ,
        "Seaham Residue"@en ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Anhydrite-stone and halite with subsidiary dolostone and gypsum-stone and trace mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FOEV"@en ;
    skos:prefLabel "Fordon Evaporite Formation"@en ;
.

