namedrockunit:RDCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Conglomerate, typically coarse in massive thick and very thick beds; reddish coloured; subangular to subrounded clasts of pebble to boulder size set in a clay-rich sandstone matrix; matrix supported to clast supported. Clasts predominantly of andesite, derived from the Cheviot Volcanic Formation, but also rare clasts of Silurian mudstone and greywacke sandstone, Cheviot Granite. Minor intercalations of mudstone and sandstone, and sandstone and siltstone at the top."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen, but thought to overlie rocks of the Cheviot Volcanic Formation unconformably."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 170m seen."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, but believed to be overlain by rocks of the Ballagan Formation (formerly the \"Cementstone Group\") of Northumberland."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:INV ;
    skos:definition "Conglomerate with subsidiary sandstone and siltstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RDCO"@en ;
    skos:prefLabel "Roddam Dene Conglomerate Formation"@en ;
.

