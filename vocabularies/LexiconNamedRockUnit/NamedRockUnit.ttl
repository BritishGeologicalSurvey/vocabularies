    lexicon:hasThicknessDescription "More than 30 m, neither lower or upper boundaries are seen."@en ;
    lexicon:hasUpperBoundaryDefinition "The Corrie Lava Member is fault-bounded and the upper boundary is not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
