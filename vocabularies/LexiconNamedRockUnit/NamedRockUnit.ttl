    lexicon:hasThicknessDescription "To 25m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but units of this Subgroup locally interfinger with units of the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
