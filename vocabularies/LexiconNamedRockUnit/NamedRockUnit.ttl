    lexicon:hasLithologyDescription "Mostly dark metacarbonate rock and psammite with some graphitic pelite and garnet calcareous schist passing up into graphitic pelite with thin beds of metacarbonate rock."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of dominantly calcareous and graphitic rocks. Stratigraphic boundary with the underlying dominantly semipelitic Tulaichean Schist Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3417 ,
        namedrockunit:H4666 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
