namedrockunit:GRC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to greenish grey mudstones, commonly very silty with subordinate thin beds of siltstone, nodular clay ironstone and shelly limestone. Rootlet horizons and plant-rich beds common. Over part of its outcrop the member is divided by a bed of calcareous sandstone, the Cuckfield Stone Bed, into the informally named lower and upper Grinstead Clay. In places, the Cuckfield Stone Bed cuts out the lower Grinstead Clay entirely and rests on the Ardingly Sandstone Member."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the member is sharply marked by the Top Lower Tunbridge Wells Pebble Bed or by a minor erosion surface. Where this bed is recognised there is a marked change from the massive fine-grained sandstone of the Ardingly Sandstone Member to the mudstones of the Grinstead Clay Member. Where the Cuckfield Stone Bed cuts out the lower Grinstead Clay the boundary is less clear with the finely trough cross-bedded (characteristically \"festoon-bedded\") fine-grained sandstone of the Cuckfield Stone Bed resting on the massive Ardingly Sandstone Member at a sharp erosive contact."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3441 ,
        namedrockunit:H939 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum of 26.9m in the Horsham area, thinner elsewhere to as little as 6.1m near Leigh to the northwest."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the sharp change from mudstones to siltstones and silty fine-grained sandstones of the informally named upper Tunbridge Wells Sand. The top of the Grinstead Clay commonly weathers to a red clay at, and emphasising, this boundary and the reddening can extend down through the whole unit to the top of the Cuckfield Stone Bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grinstead Clay Formation [Obsolete: use GRC]"@en ,
        "Grinstead Clay [Obsolete: use GRC]"@en ;
    skos:broader namedrockunit:TWS ;
    skos:definition "Mudstone with subsidiary limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age (Cretaceous Period) (137.7-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CKST ,
        namedrockunit:LGRC ,
        namedrockunit:UGRC ;
    skos:notation "GRC"@en ;
    skos:prefLabel "Grinstead Clay Member"@en ;
.

namedrockunit:GRF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent
        namedrockunit:LET ,
        namedrockunit:WROT ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LIGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstones, sandy mudstones and argillaceous siltstone-sandstone, which is commonly ferruginous, and containing generally abundant plant debris, interpreted as both non-marine and marine facies, comprising several shallowing-upwards,delta-type rhythms with typically a tripartite succession comprising: a generally pale, locally carbonate-cemented and commonly ferruginous more or less argillaceous sand or sandstone at the base, which may have a rootleted seatearth at the top, overlain in the type area at least, by a median unit of marine shaly sandy mudstone designated the Stainby Member, which farther to the south is represented by a dark carbonaceous shaly clay, named the \"Coaly Bed\", which may be equivalent, overlain by an upper, possibly rhythmic succession of alternating sand or sandstone with mudstone or sandy mudstone that may be rootletted in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp erosional, or in some places apparently transitional boundary, with ferruginous sandstone or ironstone of the Northampton Sand Formation, the top of which may be rootletted, or where the latter is absent, grey mudstone of the Whitby Mudstone Formation, with a localised conglomeratic bed of reworked Northampton Sand pebbles at the base."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2215 ,
        namedrockunit:LET ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From typically about 2m to 5m in the type area, and extremely variable, locally ranging up to 15m in channels, for example, 13.6m measured in the Copper Hill Borehole [SK 9787 4265] near Ancaster."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp or apparently transitional and somewhat arbitrary interpreted boundary with limestones of the Lincolnshire Limestone Formation. which may be very sandy at the base, distinguished from the Grantham Formation by the presence of shell debris and peloids."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Estuarine \"Series\" [Obsolete: use CLH, GRF, SWK, EBB, SYCM]"@en ,
        "Lower Estuarine Beds [Obsolete: use GRF]"@en ,
        "Wroot Formation"@en ;
    skos:broader namedrockunit:INO ;
    skos:definition "Mudstone, sandstone and siltstone and trace coal, ironstone, lignite and limestone. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:STAI ;
    skos:notation "GRF"@en ;
    skos:prefLabel "Grantham Formation"@en ;
.

namedrockunit:GRIB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicified chalk. Reworked chalk and conglomerate as (?) debris flow. Flinty in part."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the Coire Riabhach Phosphatic Formation or the Lochaline White Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CHM ,
        namedrockunit:H1574 ,
