namedrockunit:SE1AC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A reddish brown clayey gravel, overlain by interbedded reddish brown silty sand, silt and clay, which in turn, is overlain by a grey pebbly sand. Unit name and code refers to three separate outliers each of which may be a part of SE1, though no vertical succession A-C is implied."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, undulating erosional contact, mainly on reddish brown, clayey, sandstone-rich diamicton of the Gretna Till formation, or elsewhere, upon bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
