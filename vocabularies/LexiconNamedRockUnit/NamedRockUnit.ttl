namedrockunit:SPYCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A dark bluish grey to yellowish-red, commonly laminated clay containing well-dispersed clasts and lenses of sand, gravel and diamicton, and low diversity, high-Arctic microfossils, indicative of a glaciomarine environment."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, unconformable, undulating contact with underlying deposits of either glaciofluvial sand and gravel, or brown, gravelly clayey sand, and gravelly sandy clay diamictons, interpreted as till."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1840 ,
        namedrockunit:H539 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp, planar, erosional, unconformable contact with late-glacial raised beach deposits, or at the present ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Late-glacial raised beach and estuarine alluvium [Obsolete: use SPYCL]"@en ,
        "Spynie Clay Formation [Obsolete: use SPYCL]"@en ;
    skos:broader namedrockunit:ERRCL ;
    skos:definition "Clay with subsidiary sand and trace diamicton and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SPYCL"@en ;
    skos:prefLabel "Spynie Clay Member"@en ;
.

namedrockunit:SRCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In addition to alluvium of the present day floodplain and river terrace deposits, the Strathendrick Formation includes a wide range of lithologies encompassing pebbles, fine to coarse gravel, cobbles and boulders in a sandy matrix and coarse- to fine-grained sand, silt and clay. Beds rich in organic remains occur as well as peat (in the floodplain deposits)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity on older Quaternary deposits and bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Veneer to several metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Normally the land surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CLYCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ENDR ,
        namedrockunit:KILK ;
    skos:notation "SRCK"@en ;
    skos:prefLabel "Strathendrick Formation"@en ;
.

namedrockunit:SSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Moderately to well-sorted, fine-grained sand with peat layers in the lower part. Sand grains are dominated by rounded to sub-rounded quartz grains. The formation is divisible into an upper \"white\" sand and a lower \"brown\" sand that is olive grey and brown. The sediments are interpreted as coastal blown sands, possibly a coastal facies of the Seacombe Sand Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Variably overlies sediments of the Caledonia Glacigenic Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2446 ,
        namedrockunit:H2447 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "<1 to 5m."@en ;
    lexicon:hasUpperBoundaryDefinition "Either the ground surface or basal surface of overlying peat deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Shirdly Hill Formation [Obsolete: use SSA]"@en ,
        "Shirdly Hill Sand [Obsolete: use SSA]"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Sand with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SSA"@en ;
    skos:prefLabel "Shirdley Hill Sand Formation"@en ;
.

namedrockunit:STB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/NODL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCIR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey to green slate; nodular and lenticular limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable with the Bealbury Formation. The contact would be distinguished in the field by a gradual transition from the green and blue-grey shale and siltstone with purple shale of the Bealbury Formation to the dark grey to green slate with lenticular limestone of the Stourscombe Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2450 ,
        namedrockunit:H3516 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
