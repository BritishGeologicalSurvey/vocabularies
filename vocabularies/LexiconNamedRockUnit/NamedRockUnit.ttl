namedrockunit:VBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Angular and subangular fragments of sandstone, slate and quartz in a sandy matrix whose grains are mostly angular, but locally rounded.  Locally rounded fragments are found including Carboniferous limestone. The breccias are generally well cemented.  Interbedded sandstones are present up to 1m thick. The Breccias generally form a distinct scarp feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the Wiveliscombe Sandstones. Boundary marked by lithology change form mainly sandstone to include breccia."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3111 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "20-40m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Littleham Mudstone. Boundary marked by change in lithology to mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Breccio-Conglomerate [Obsolete: use VBR]"@en ;
    skos:broader namedrockunit:AYB ;
    skos:definition "Breccia with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
