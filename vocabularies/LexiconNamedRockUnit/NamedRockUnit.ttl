    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kelhead Breccia Member"@en ,
        "Rougholme Point Conglomerate"@en ;
    skos:broader namedrockunit:APY ;
    skos:definition "Breccia with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) - to - Early Triassic Epoch (Triassic Period) (298.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:KHBR ,
        namedrockunit:MOSI ;
    skos:notation "BK"@en ;
    skos:prefLabel "Brockram"@en ;
