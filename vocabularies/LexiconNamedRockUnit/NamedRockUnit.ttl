namedrockunit:NOC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstone and sandy mudstone, containing scattered ooids, interbedded with about eight limestone horizons. The limestones are variously iron-rich, ooidal, sandy and bioclastic, and there is a distinctive white-weathering shelly micrite, with extensive borings, near the base of the succession. Locally abundant bivalves."@en ;
    lexicon:hasLowerBoundaryDefinition "Base is a gradational boundary with medium-grained calcareous sandstone of the uppermost 1.5m of the Nothe Grit (=Preston Grit Member of Wright, 1986) passing to sandy mudstone of the basal Nothe Clay Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "12m at Osmington; 13.5m at Rodwell (Sandsfoot)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is a gradational boundary marked by an increase in quartz sand in the mudstones of the topmost part of the Nothe Clay Member, passing into the argillaceous sandstone of the Bencliff Grit Member. Crushed specimens of the bivalve Modiolus are common at this horizon."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RECF ;
    skos:definition "Limestone and mudstone with subsidiary sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NOC"@en ;
    skos:prefLabel "Nothe Clay Member"@en ;
.

namedrockunit:NOCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Upper Campanian chalks are informally designated as the 'Norwich Chalk' as much of the succession has been long studied in numerous pits around Norwich. Peake and Hancock (1961, 1970) split this succession into a number of named units that were tentatively delimited during the survey of the Norwich Sheet 161 and published as a diagram within the memoir (Cox et al., 1989). The units were given names of informal member status in Johansen and Surlyk (1990). All of the succession was investigated in the Trunch Borehole (TG 23 SE/8) [TG 2933 3455] that was published in the Great Yarmouth Memoir (Arthurton et al., 1994). No firm conclusion has been reached regarding formal nomenclature for these beds since their distribution under a thick Quaternary cover has not been determined. Mortimore et al. (2001) give a comprehensive review of the Trimmingham and Norwich chalks in Norfolk. It is recommended that reference to these units be made informally using the 'Norwich Chalk' term until they can be more formally attributed."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WHCK ;
    skos:definition "Chalk. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NOCK"@en ;
    skos:prefLabel "Norwich Chalk"@en ;
.

