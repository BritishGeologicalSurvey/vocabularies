namedrockunit:RUTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Runton Till Member consists of a dark grey to greyish brown matrix-supported diamicton that contains highly attenuated lenses and laminations of sand, chalk and reworked inclusions of older and more chalky till (Walcott Till Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "The Runton Till Member rests unconformably upon preglacial marine deposits of the Wroxham Crag Formation. The boundary is sharp and planar and in places resembles a surface of decollement. The boundary is represented by a lithological change from sands and gravels to diamicton."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1155 ,
        namedrockunit:H2606 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 9m at stratotype locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The Runton Till Member exhibits a gradational upper boundary with the Bacton Green Till, with a transition from massive, highly consolidated diamicton, to stratified diamicton."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Laminated diamicton [Obsolete: use RUTI]"@en ,
        "Third Cromer Till [Obsolete: use RUTI, BGTI]"@en ;
    skos:broader namedrockunit:SMCL ;
    skos:definition "Diamicton with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RUTI"@en ;
    skos:prefLabel "Runton Till Member"@en ;
.

namedrockunit:RWC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale to dark grey mudstone, variably calcareous, with locally numerous, fine calcareous laminae. The upper part of the member is reddish silty mudstone with siltstone lenses and is characterised by red-weathering, lens-shaped sideritic concretions. Poorly fossiliferous, with echinoids, bivalves and rare ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, non-sequential boundary, marked by the upward change from ferruginous, bioturbated sandstone or sandy mudstone of the underlying Sandsfoot Grit, or ferruginous oolite of the Westbury Ironstone Member (Wilts), to grey, calcareous mudstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1156 ,
        namedrockunit:H4869 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Dorset coast: 3.5-5m at outcrop, up to 18m in boreholes at Kimmeridge. Inland Dorset: up to 9m. Westbury, Wilts: 6.3m."@en ;
    lexicon:hasUpperBoundaryDefinition "Either: Sharp change up from reddish mudstone with siderite nodules of Ringstead Clay into shelly, ferru-ooidal calcareous mudstone or limestone (Osmington Mills Ironstone Member, including Ringstead Coral Bed), or: Non sequence; overlain by dark grey mudstone (Kimmeridge Clay Formation), with basal bed of very dark grey shelly bioturbated mudstone with ferruginous ooids and phosphatic pebbles (Inconstans Bed)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ringstead Waxy Clay Member [Obsolete: use RWC]"@en ,
        "Ringstead Waxy Clays [Obsolete: use RWC]"@en ;
    skos:broader namedrockunit:SDT ;
    skos:definition "Calcareous mudstone and mudstone and trace ferruginous sandstone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RWC"@en ;
    skos:prefLabel "Ringstead Clay Member"@en ;
.

namedrockunit:RWD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:SAL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use SAL] Brick-red mudstones, poorly-micaceous, usually calcareous, with sandstones and limestones."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of sequence of brick-red mudstone, poorly-micaceous, usually calcareous, with sandstone and limestone, over usually more variegated mudstone, lithic and micaceous sandstone typical of Keele Formation (red facies of Halesowen Formation). Base drawn where Radwood lithologies predominate over Keele lithologies in an interbedded transition."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1947 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasOldestAgeValue 3.075e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "900m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by Triassic rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SAL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Keele Beds [Obsolete: use RWD, ALY, KE]"@en ,
        "Salop Formation"@en ;
    skos:definition "Obsolete name. Mudstone with subsidiary limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Stephanian Stage (Carboniferous Period) (307.5-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RWD"@en ;
    skos:prefLabel "Radwood Formation [Obsolete: use SAL]"@en ;
.

