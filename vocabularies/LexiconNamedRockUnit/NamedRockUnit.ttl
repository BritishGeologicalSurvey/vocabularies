namedrockunit:RMBDD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravel and sand, commonly silty. Gravel typically cobble grade, poorly sorted, clast supported with subangular to rounded clasts. Sand mainly medium-grained."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable, generally planar, shelving contact on various older superficial deposits, most commonly till."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2395 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface, or sharp, undulating, conformable contact with younger superficial deposits, peat and blown sand."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Raised beach deposits of late-glacial age [Obsolete: use RBDLG, RMBDD]"@en ;
    skos:broader namedrockunit:RBDU ;
    skos:definition "Gravel with subsidiary sand and trace silt. Superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RMBDD"@en ;
    skos:prefLabel "Raised marine beach deposits, late Devensian"@en ;
.

namedrockunit:RMDF1
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """See RMDF Raised marine deposits of Holocene age. Raised marine deposits of Holocene age, 1 is older than Raised marine deposits of Holocene age in the same map area. \r
\r
Mainly sand and gravel underlying shelving raised shoreface (beach) features, but commonly passing landwards, and downwards, into interbedded sand,silt, clay and organic mud underlying flat-lying ground."""@en ;
    lexicon:hasLowerBoundaryDefinition "Mainly uncomformable on till or bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5258 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasThicknessDescription "up to 25m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Raised marine deposits of Flandrian age, 1 [Obsolete: use RMDF1]"@en ;
    skos:broader namedrockunit:RMDF ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RMDF1"@en ;
    skos:prefLabel "Raised marine deposits of Holocene age, 1"@en ;
.

