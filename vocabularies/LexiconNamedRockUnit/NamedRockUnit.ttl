namedrockunit:BOCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clayey silt, clay and sand, mid to dark grey, bedded and thinly laminated in places, with dark sulphide patches and fine mica; very soft to soft consistency and medium to low plasticity, isolated clasts up to 3cm (presumed dropstones), some graded units, sulphide patches, rare marine shells and plant remains."@en ;
    lexicon:hasLowerBoundaryDefinition "The Ballock Clay Member of the Clyde Clay Formation rests with angular unconformity on older Quaternary sediments or bedrock. It normally rests on the Inverleven Gravel Member of the Clyde Clay Formation or possibly on the Wilderness Till Formation (WITI) of the Caledonia Glacigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1375 ,
        namedrockunit:H2005 ,
        namedrockunit:H71 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 40m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Balloch Clay Member of the Clyde Clay Formation is overlain unconformably by younger Quaternary sediments, normally the Clydebank Clay Formation of the British Coastal Deposits Group but will include buried deposits belonging to the deglacial phase at the end of the Loch Lomond Stadial."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
