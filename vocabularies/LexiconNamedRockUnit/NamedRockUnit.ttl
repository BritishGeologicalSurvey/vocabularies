    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by siltstones, mudstones and oolitic ironstones of the Trygarn Formation. The boundary, which is possibly a disconformity or non-sequence, is defined by the first oolitic ironstone bed within the Trygarn Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
