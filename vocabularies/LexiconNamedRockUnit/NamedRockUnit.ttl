namedrockunit:HAAV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Floodplain alluvium and river terrace deposits. The floodplain alluvium comprises overbank deposits of mottled dark grey and orange organic silt, silty clay and clayey sand, tgether with peat, overlying sand and gravel. Fourteen river terraces are preserved. The river terrace deposits comprise very sandy gravels. The clasts are sub-angular to sub-rounded, poorly sorted up to 5cm in diameter, dominantly flint, with a little Upper Greensand chert, \"sarsen\" stone, vein quartz, Jurassic limestone, and well-rounded flints from the Palaeogene, in a matrix of clayey sand. Deposits of the higher terraces are cryoturbated."@en ;
    lexicon:hasLowerBoundaryDefinition "The fluvial deposits rest unconformably on Palaeogene and Cretaceous strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 8m, including up to 4m of alluvial overbank deposits."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNTCA ;
    skos:definition "Gravel, sand and silt with subsidiary clay and peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HAAV"@en ;
    skos:prefLabel "Hampshire Avon Formation"@en ;
.

