namedrockunit:MGW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:GFDD ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and gravel, coarsening upwards from pale brown fine-grained sand, with low-angle cross stratificationand ripple-drift cross lamination, to pebbly sand disposed in planar deltaic foresets (dip towards the south), and capped by gravel deltaic topsets. Clasts comprise local Lake District igneous and metamorphic rock-types together with some red and yellow sandstone, and coal. Forming flat-topped plateaux some 20m above the surrounding, poorly drained ground underlain by the Holmeside Clay Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, undulating, erosional boundary with underlying moderate to reddish brown thinly interbedded clay and silt of the Holmeside Clay Member of the Aikbank Farm Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Either not overlain, or partially overlain by Flandrian peat or alluvial deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glaciofluvial deltaic (and/or subaqueous fan) deposits"@en ;
    skos:broader namedrockunit:AIK ;
    skos:definition "Sand with subsidiary gravel and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MGW"@en ;
    skos:prefLabel "Mainsgate Wood Sand And Gravel Member"@en ;
.

namedrockunit:MHSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy gravel, yellowish brown with orange staining, with angular to well rounded clasts up to cobble size mainly of yellow, red and white sandstone, black fissile mudstone and coal. Sand mainly coarse-grained with shell fragments. Horizontal to trough cross stratification with palaeocurrent towards the north. Locally passes upwards into granule gravel and sand with 10-15mm thick laminae of silt."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, erosional contact on bedrock or very compact, fissile, dusky yellowish brown to dark olive grey, gravelly sandy silty clayey diamicton (lodgement till) containing angular to well-rounded clasts up to cobble size of yellow and white sandstone, dolerite, porphyritic lavas, limestone, coal, greywacke sandstone, 'haggis' rock, vein quartz, jasper, flint, granitic gneiss, numerous shell fragments and metamorphic rock of possible Scandinavian origin (Warren House Till Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H396 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, planar contact with dark olive grey, very stiff, gravelly sandy silty clayey diamicton with angular well rounded clasts up to boulder size mainly of yellow and white sandstones, greywacke sandstone, porphyritic lava and shell fragments (Blackhall Till Formation?)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basal Gravels [Obsolete: use MHSG]"@en ;
    skos:broader namedrockunit:NPEG ;
    skos:definition "Gravel with subsidiary sand and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MHSG"@en ;
    skos:prefLabel "Maiden's Hall Sand And Gravel Formation"@en ;
.

namedrockunit:MHVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
