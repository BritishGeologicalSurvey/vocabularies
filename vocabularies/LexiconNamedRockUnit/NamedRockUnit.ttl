namedrockunit:DASA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A greenish grey, fine- to coarse-grained, lithic sandstone, commonly with rip-up mudstone clasts, characterised by beds locally rich in plant remains."@en ;
    lexicon:hasLowerBoundaryDefinition "A transitional contact, showing interbedding with the Cromlix Mudstone Formation, eg. in the Brocklin Falls Conglomerate Member in the Burn of Mar [NS 442 909], and locally a sharp contact, such as in Kelty Water [NS 5016 9503]."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H189 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 1500 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A transitional contact with the Buchlyvie Sandstone Member of the Teith Sandstone Formation, which is reddish grey, unfossiliferous and contains red siltstone and mudstone interbeds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Grey Sandstone Facies [Obsolete: use DASA]"@en ;
    skos:broader namedrockunit:THF ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone and siltstone and trace conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DASA"@en ;
    skos:prefLabel "Dalmary Sandstone Member"@en ;
.

