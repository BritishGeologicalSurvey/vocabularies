        "Middle Bampton Cherts [Obsolete: use KSDC, BPLM]"@en ;
    skos:broader namedrockunit:BPLM ;
    skos:definition "Chert with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KSDC"@en ;
    skos:prefLabel "Kersdown Chert Member"@en ;
.

namedrockunit:KT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:BIRV ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Kelso Volcanic Formation comprises effusive alkali olivine-basalts either associated with tuffs or with sedimentary strata (volcaniclastic-sandstone). Up to 12 basalt, basaltic hawaiite and hawaiite lavas are intercalated with thin tuffs and sedimentary rocks consisting of sandstones and siltstones. The lower flows are mostly feldspar phyric in contrast to the upper ones which contain olivine and clinopyroxene phenocrysts. The rocks are pervasively altered. The lavas were extruded during the main initial phase of extensional faulting associated with development of the Northumberland Trough."@en ;
    lexicon:hasLowerBoundaryDefinition "The olivine basalts of the Kelso Volcanic Formation conformably overlie sandstone of the Kinneswood Formation (Inverclyde Group)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2275 ,
        namedrockunit:H4139 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 120 m, thinning northwards."@en ;
    lexicon:hasUpperBoundaryDefinition "The olivine basalts of the Kelso Volcanic Formation are conformably overlain by \"cementstone\"-bearing strata comprising interbedded sandstone, siltstone and ferroan dolomite of the Ballagan Formation (Inverclyde Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Birrenswark Volcanic Formation"@en ,
        "Kelso Lavas [Obsolete: use KT]"@en ,
        "Kelso Traps [Obsolete: use KT]"@en ;
    skos:broader namedrockunit:INV ;
    skos:definition "Hawaiite and olivine-basalt with subsidiary siltstone, tuff and volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KT"@en ;
    skos:prefLabel "Kelso Volcanic Formation"@en ;
.

