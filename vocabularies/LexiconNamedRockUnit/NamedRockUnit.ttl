    lexicon:hasThicknessDescription "From c.200m at the northern margin of the Lancaster district to c.475m on Longridge Fell, and an average of 457m in the Clitheroe district."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the point in the sandstone succession where cross-bedded sandstones of the Warley Wise Grit become evident."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
