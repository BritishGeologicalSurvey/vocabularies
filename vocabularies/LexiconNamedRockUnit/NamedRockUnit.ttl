namedrockunit:RCG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Coarse-grained, poorly sorted, cross-bedded, abundantly shelly sands (in East Anglia). Dark green and glauconitic when unoxidised, but typically oxidised to yellow or reddish brown with ferruginous concretions (iron pan). Basal bed of rounded flint pebbles. Offshore, fine- to medium-grained, muddy, calcareous, glauconitic sands. \r
\r
Shallow marine deposit. \r
\r
Piacenzian (Waltonian) to Thurnian (MIS ?103 - 82)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on the Coralline Crag Formation, Palaeogene formations and Chalk Group bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2389 ,
        namedrockunit:H2993 ,
        namedrockunit:H484 ,
        namedrockunit:H485 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/NC> ;
    lexicon:hasOldestAgeValue 3.6e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription """70 m maximum offshore (Flemish Bight Sheet). \r
\r
Onshore commonly to 20 m but thicker in coastal areas of east Norfolk and Suffolk and within the Stradbroke Trough, locally reaching c. 40 to 45 m."""@en ;
    lexicon:hasUpperBoundaryDefinition """Onshore overlain unconformably by sands of the Norwich Crag Formation, which are less coarse-grained, better sorted, less shelly and generally paler in colour. \r
\r
Offshore overlain unconformably by early Pleistocene or Holocene sediments."""@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QT> ;
    lexicon:hasYoungestAgeValue 2.12e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Crag [Obsolete: use RCG]"@en ,
        "Red Crag Member [Obsolete: use RCG]"@en ,
        "Red Crag Series [Obsolete: use RCG]"@en ,
        "Red Crag [Obsolete: use RCG]"@en ;
    skos:broader namedrockunit:CRAG ;
    skos:definition "Sand with subsidiary gravel and trace clay, gravelly sand and silt. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Piacenzian Age (Neogene Period) - to - Thurnian Stage (Quaternary Period) (3.6-2.12 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:NEHE ,
        namedrockunit:SZWL ,
        namedrockunit:THOPN ;
    skos:notation "RCG"@en ;
    skos:prefLabel "Red Crag Formation"@en ;
