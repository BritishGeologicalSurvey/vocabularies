namedrockunit:FCYSD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Intensely bioturbated fine-grained muddy sandstone in several fining-upward cycles, rich in ammonites and bivalves, that culminate in a massive sandy siltstone. Dinoflagellate cysts are abundant (Riding, 2005)."@en ;
