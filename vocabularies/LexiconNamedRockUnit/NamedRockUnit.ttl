namedrockunit:TREGN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Peat with silt; the margins of the formation are more silt-rich."@en ;
    lexicon:hasLowerBoundaryDefinition "Defined by the base of bed 3 (Hibbert and Switsur, 1976) where peats replace Late Devensian muds and lacustrine clay. Corylus is first represented continuously in the profile, and a C14 date of 9750+/-220 (11 6000 cal) BP was obtained. Locally unconformably overlies Late Devensian head deposits (Godwin and Mitchell, 1938) and Plynlimon Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:PEAT ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface, locally unconformably overlain by deposits of the Teifi Valley Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Peat"@en ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Peat and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TREGN"@en ;
    skos:prefLabel "Tregaron Formation"@en ;
