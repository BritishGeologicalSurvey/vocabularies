namedrockunit:PTN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fossiliferous grey calcareous mudstone and siltstone with fine- to medium- to coarse-grained sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable and gradational with the underlying mudstones and sandstones of the Bodwrog Member. It is the presence of the latter that has allowed the Plastirion Member to be named thus. Where the Bodwrog Member is absent, the Plastirion Member overlies the Allt Fawr Rhyolitic Tuff Formation and forms the whole of the Dwyfach Formation. It is for this reason that it should be more aptly regarded as \"Dwyfach Formation (undivided)\"."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1777 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OL> ;
    lexicon:hasOldestAgeValue 4.53833e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100 to 120m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by andesitic tuffs of the Penmaen Formation. The boundary is generally sharp but probably conformable, and is heralded by a marked coarsening at the very top of the Plastirion Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OS> ;
    lexicon:hasYoungestAgeValue 4.51875e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Llanbedrog Mudstone [Obsolete: use PTN]"@en ;
    skos:broader namedrockunit:DWF ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Longvillian Substage - to - Woolstonian Substage (Ordovician Period) (453.833-451.875 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PTN"@en ;
    skos:prefLabel "Plastirion Member"@en ;
.

