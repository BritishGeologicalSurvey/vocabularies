namedrockunit:BLO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive medium-grained, ooidal grainstone and crinoidal dolostone."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Clydach Valley, the base is a sharp, palaeokarstic surface cut in dolostones of the Pantydarren Formation, overlain by basal ooidal grainstones of the Blaen Onnen Oolite Formation. At the type locality, the base is placed at the base of massive ooidal grainstones that overlie a prominent 0.3 to 0.5m-thick rubbly bed of radiating fibrous calcite nodules."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BLOO ,
        namedrockunit:H3227 ,
        namedrockunit:H3858 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
