namedrockunit:HAA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bedded and nodular anhydrite, interbedded with grey dolostone, mid-to-dark grey mudstone or calcareous mudstone, and massive to nodular limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Not proved in the Hathern No.1 Borehole, but probably an angular unconformity resting upon pre-Carboniferous rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1582 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 97m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined at the top of the highest anyhydrite or mudstone unit, and is overlain in the Hathern No.1 Borehole by thickly-bedded, grey, brown and black, fine-grained limestone with shaly beds, identified as the Milldale Limestone Formation. Anhydrites, possibly belonging to the Hathern Anhydrite Formation, are overlain by mudstone, siltstone and thin limestone beds of the Long Eaton Formation in the Long Eaton No. 1 Borehole (SK43SE/161) [SK 4640 3166]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hathern Anhydrite Series [Obsolete: use HAA]"@en ;
    skos:definition "Dolostone with subsidiary anhydrite-stone, limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "HAA"@en ;
    skos:prefLabel "Hathern Anhydrite Formation"@en ;
.

