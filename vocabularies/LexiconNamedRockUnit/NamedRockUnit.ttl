namedrockunit:DLI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly calc-silicate rock, ranging from calcareous psammite to hornblende-zoisite-schist, but containing layers up to 10m thick of fine-grained crystalline limestone with disseminated sulphides."@en ;
    lexicon:hasLowerBoundaryDefinition "Incoming of dominantly calcareous lithologies at the top of the Queen's Hill Formation. This is usually sharp, with only rare calc-silicate layers in the Queen's Hill Formation rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DBDS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Varies from 30m to 100m; probably thickens eastwards from Pollagach Burn to Mains of Midstrath."@en ;
    lexicon:hasUpperBoundaryDefinition "Change to dominant psammite, often slightly calcareous, with minor layers of calc-silicate rock and semipelite, at base of Tarfside Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Deeside Limestone [Obsolete: use DLI]"@en ;
    skos:broader namedrockunit:DBTV ;
    skos:definition "Calcsilicate-rock with subsidiary limestone, psammite and schist and trace metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DLI"@en ;
    skos:prefLabel "Deeside Limestone Formation"@en ;
.

namedrockunit:DLLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAALK"^^xsd:anyURI ,
