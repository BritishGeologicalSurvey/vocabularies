namedrockunit:PL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:PLPB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Upper part predominantly limestone (micrites, wackestones, packstones and grainstones) including good freestones; lower part predominantly argillaceous, dolomitic sandstones/sands; some mudstones/shales, and thin beds or nodular layers of micrite."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type area traditionally, but not unanimously, taken at the base of the Massive Bed, which also marks the Portlandian/Kimmeridgian stage boundary. In other areas taken at upward change from silty/sandy mudstones (Kimmeridge Clay) to argillaceous sandstones/siltstones (possibly marked by a spring-line) or, where non-sequential, at the base of the Upper Lydite Bed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4258 ,
        namedrockunit:H4259 ,
        namedrockunit:H948 ,
        namedrockunit:PLND ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "To c.75 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The most practical definition is at the top of the highest, massive marine limestone of the Portland Stone. In the type area, the overlying beds are thin algal limestones and palaeosols (`Dirt Beds') of the Purbeck Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Portland Beds [Obsolete: use HADD, PL, PLND]"@en ,
        "Portland Formation (Wiltshire, Oxfordshire and Buckinghamshire) [Obsolete: use PL]"@en ,
        "Portland Group and Purbeck Limestone Group (Undifferentiated)"@en ,
        "Portland Rocks [Obsolete: use PL]"@en ,
        "Portland Strata [Obsolete: use PL]"@en ;
    skos:definition "Limestone, sand and sandstone with subsidiary calcareous sandstone, chert and mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:POSA ,
        namedrockunit:POST ,
        namedrockunit:WAR ;
    skos:notation "PL"@en ;
    skos:prefLabel "Portland Group"@en ;
.

namedrockunit:PLT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstones and siltstones with thin- to thick-bedded, locally calcareous sandstones and beds and lenses of limestone. Sandstones are thickest and predominate in the lower half of the formation, whereas mudstones predominate in the upper half. Rich shelly neritic fauna occurs in the mudstones and limestones."@en ;
    lexicon:hasLowerBoundaryDefinition "At the coast, the lower boundary is taken at the incoming of interbedded mudstones, siltstones and sandstones of the Pilton Mudstone Formation above a prominent slumped unit overlain by cross-bedded, medium-grained sandstones of the underlying Baggy Sandstone Formation. Inland, the boundary is taken above the highest, sugary, buff-brown, fine- to medium-grained feldspathic and micaceous sandstone, typical of the Baggy Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1121 ,
        namedrockunit:H1760 ,
        namedrockunit:H3812 ,
        namedrockunit:H456 ,
        namedrockunit:LPN ,
        namedrockunit:PNSH ,
        namedrockunit:UPN ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Between Brushford and Wellington the upper boundary is taken at the incoming of hard black finely laminated rarely fossiliferous cherty mudstones of the Doddiscombe Formation above the soft medium to dark grey mudstones with scattered very thin fossiliferous limestones, siltstones and sandstones of the underlying Pilton Mudstone Formation. West of South Molton, the upper boundary is taken at the gradational incoming of dark grey to black rarely fossiliferous, slightly siliceous, finely laminated mudstones of the overlying Doddiscombe Formation (Unit D of the Pilton Beds of Prentice, 1960), above the fossiliferous mudstones with thin sandstones and siltstones of the underlying Pilton Mudstone Formation. The Doddiscombe Formation has not been mapped by BGS west of South Molton, instead it has been included in the Pilton Mudstone Formation and/or the Coddon Hill Chert Formation; further work is needed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ,
        "Lower Pilton Beds [Obsolete: use PLT]"@en ,
        "Pilton Beds [Obsolete: use PLT]"@en ,
        "Pilton Shales Formation [Obsolete: use PLT]"@en ,
        "Pilton Shales Group [Obsolete: use PLT]"@en ,
        "Pilton Shales [Obsolete: use PLT]"@en ,
        "Upper Pilton Beds [Obsolete: use PLT]"@en ;
    skos:broader namedrockunit:EXM ;
    skos:definition "Mudstone with subsidiary limestone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CODS ;
    skos:notation "PLT"@en ;
    skos:prefLabel "Pilton Mudstone Formation"@en ;
.

namedrockunit:PLYNT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent
        namedrockunit:S438 ,
        namedrockunit:S933 ,
        namedrockunit:S934 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Generally stiff, blue-grey, stony, sandy and silty clay and clayey gravel, characteristically containing clasts of Lower Palaeozoic rocks (derived from the Cambrian Mountains). Subordinate stratified sand and gravel are locally present. Colour and dominant clast composition are variable and generally reflect the local bedrock geology; in central and west Wales it is generally grey and the clasts are exclusively Lower Palaeozoic. In Broughton Bay it contains shell fragments (Bowen, 1999)."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally unconformable on bedrock or regolith/head (e.g. Davies et al., 1997). At Broughton Bay it unconformably overlies Ipswichian raised beach gravels and head (Campbell and Bowen, 1989, 52-54) assigned to the Pennard Formation by Bowen (1999)"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3232 ,
        namedrockunit:H4636 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Highly variable, locally in excess of 30m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or contact with overlying peat, head (Severn and Avon and West Wales catchments subgroups), Kenfig Formation or Ynyslas Formation (British Coastal Deposits Group). Near Llanrhystud it is overlain by the Lleyn Till Member of the St Asaph Glacigenic Formation (McMillan et al., in prep.)(Lleyn Formation of Campbell and Bowen, 1999; Davies et al., 1997) and in the Shropshire lowlands by the Shrewsbury Glacigenic Formation (Thomas, 1989)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Central Wales Drift [Obsolete: use ELTI, MNTI, PLYNT]"@en ,
        "Elenid Formation [Obsolete: use ELTI, WALES]"@en ,
        "Llanmadoc Member"@en ,
        "Merion Formation"@en ,
        "Welsh till [Obsolete: use MNTI, PLYNT, BNOCK]"@en ;
    skos:broader namedrockunit:WALES ;
    skos:definition "Diamicton with subsidiary gravel and sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ELTI ,
        namedrockunit:MNTI ,
        namedrockunit:RBNTI ;
    skos:notation "PLYNT"@en ;
    skos:prefLabel "Plynlimon Glacigenic Formation"@en ;
.

namedrockunit:RAG
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WSTS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMPIS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fluvial, fluvio-deltaic and paralic mudstone, siltstone and sandstone, intercalated with relatively thin marine units comprising calcareous sandstone, calcareous mudstone, calcareous siltstone, limestone and ironstone. Thin coal seams and seatearth mudstones occur in the paralic lithofacies."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the base of the Saltwick Formation where sandstone, siltstone or mudstone, commonly with plant fragments, rest unconformably or disconformably on the heterolithic, marine, Dogger Formation (ferruginous sandstone; ironstone; limestone; calcareous mudstone) or, where the Dogger Formation is absent, on grey, shelly mudstone or siltstone of the Lias Group."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4283 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Generally about 240 m thick on the North Yorkshire coast (Ravenscar to Scarborough) thinning westward to 114 m in the Hambleton Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the unconformable or disconformable upward passage from sandstones, siltstones and mudstones, commonly with plant fragments, of the Scalby Formation to calcareous, bioturbated mudstone and nodular, shelly limestone of the Cornbrash Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Jurassic Series [Obsolete: use RAG]"@en ,
        "West Sole Group"@en ;
    skos:definition "Mudstone, sandstone and siltstone with subsidiary calcareous sandstone, calcareous siltstone, ferruginous sandstone, micritic limestone and ooid-ironstone and trace carbonaceous mudstone, coal, ooid-limestone, pisoid-limestone and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age - to - Bathonian Age (Jurassic Period) (174.7-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CLH ,
        namedrockunit:EBB ,
        namedrockunit:SCR ,
        namedrockunit:SCY ,
        namedrockunit:SKCH ,
        namedrockunit:SWK ;
    skos:notation "RAG"@en ;
    skos:prefLabel "Ravenscar Group"@en ;
.

