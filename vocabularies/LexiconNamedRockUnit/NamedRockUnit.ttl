namedrockunit:WST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower part (known informally as the Lower Westleigh Limestone) comprises thin-bedded, platy, fine-grained (mud and silt grade), commonly partly silicified limestones. Shaly mudstone interbeds are sparsely developed. Upper part (known informally as the Upper Westleigh Limestone) comprises thin to massive beds of coarse, locally conglomeratic, bioclastic/ooidal/pelloidal calcarenite interbedded with subordinate mudstones and calcilutites. Silicification is locally present. The Lower Westleigh Limestone is present only around Westleigh; to the north it passes into the Upper Westleigh Limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Around Westleigh the lower boundary is taken at the incoming of thin-bedded fine-grained limestones of the (lower) Westleigh Limestone Formation above the black, hard cherty mudstones of the underlying Doddiscombe Formation. To the north it is taken at the incoming of thin to thick bedded coarse calcarenites and mudstones of the (upper) Westleigh Limestone Formation above the black hard cherty mudstones of the underlying Doddiscombe Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2540 ,
        namedrockunit:H3771 ,
        namedrockunit:LWST ,
        namedrockunit:UWST ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not known but probably c. 100 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of dark grey unfossiliferous finely laminated silty mudstones with scattered siltstones of the overlying Dowhill Mudstone Formation above the highest limestone bed of the Westleigh Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Westleigh Limestone [Obsolete: use WST]"@en ,
        "Upper Westleigh Limestone [Obsolete: use WST]"@en ,
        "Westleigh Limestone Group [Obsolete: use WST]"@en ,
        "Westleigh Limestones [Obsolete: use WST]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Limestone with subsidiary mudstone and siliceous limestone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WST"@en ;
    skos:prefLabel "Westleigh Limestone Formation"@en ;
.

