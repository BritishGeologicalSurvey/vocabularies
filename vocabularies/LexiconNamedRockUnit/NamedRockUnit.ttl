        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use CLWYD] \r
\r
Predominantly limestones with bands of carbonaceous mudstone. Lowest beds contain cherts and dolomites and dolomitic limestone."""@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Dyserth Group where cyclic brown limestone conformably rests upon arenaceous limestone of the Basement Beds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "500 metres approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of brown grey and white limestones of the Dyserth Group unconformably overlain by darker fine-grained limestones of the Teila Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CLWYD ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Clwyd Limestone Group"@en ;
    skos:definition "Obsolete name. Limestone with subsidiary chert, dolomitic limestone, dolostone and mudstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DYL"@en ;
    skos:prefLabel "Dyserth Limestone Group [Obsolete: use CLWYD]"@en ;
