namedrockunit:RES
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pebbly sandstone, conglomerates especially near the base, fine- to medium- sandstone, siltstone and mudstone, typically red-brown with minor green mottling.The formation is broadly upward fining, with individual beds internally upward fining too, the cycles average 6.7 m thick, and diminish in thickness upwards. Carbonate concretions of calcrete may be present at the top of some cycles."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen, but probably unconformable upon pre-Carboniferous strata."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4295 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as 170.3 m thick in the Caldon Low Borehole, although the base is not proved."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable passage, with the base of the overlying Rue Hill Dolomite Formation taken at the base of the lowest dolostone bed containing bioclasts, and underlain by reddish-brown pebbly sandstone of the Redhouse Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Redhouse Sandstones [Obsolete: use RES]"@en ;
    skos:definition "Sandstone with subsidiary conglomerate and trace mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "RES"@en ;
    skos:prefLabel "Redhouse Sandstone Formation"@en ;
.

