    lexicon:hasThicknessDescription "0 - 400m (excluding penecontemporaneous sills)."@en ;
    lexicon:hasUpperBoundaryDefinition "Contact with overlying Lickle Formation (dacitic and rhyolitic tuff) and locally intervening intrusive basaltic andesite and andesite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
