        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy diamicton, red-brown with clasts predominantly of Devonian rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable: on pre Late Devensian deposits or bedrock."@en ;
