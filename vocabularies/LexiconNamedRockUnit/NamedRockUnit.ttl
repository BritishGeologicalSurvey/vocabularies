namedrockunit:CPW
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower three or four flows are fine-grained basalt, with pyroxene andesite occuring in north east. Upper flow is biotite dacite or biotite rhyolite, pale pink or lilac, silicified and kaolinitised, with large feldspar and biotite phenocrysts."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: where fine-grained basalt overlies pink flow-banded rhyolites of the Bell's Hill Volcanic Member."@en ;
    lexicon:hasObsoleteEquivalent
