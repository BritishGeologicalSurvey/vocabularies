    skos:altLabel "Trimingham Sand and Clay Member [Obsolete: use TRIMC, TRIMS]"@en ;
    skos:broader namedrockunit:SMCL ;
    skos:definition "Clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TRIMC"@en ;
