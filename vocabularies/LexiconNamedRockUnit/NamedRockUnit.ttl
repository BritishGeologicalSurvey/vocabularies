    skos:altLabel
        "Glaciolacustrine deposits"@en ,
        "Llechryd Member [Obsolete: use TFICL]"@en ;
    skos:broader namedrockunit:ISCG ;
    skos:definition "Clay and silt with subsidiary diamicton and sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TFICL"@en ;
    skos:prefLabel "Teifi Clay Formation"@en ;
