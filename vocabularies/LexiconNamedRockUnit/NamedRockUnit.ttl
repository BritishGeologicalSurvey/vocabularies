        "Main Third Grit [Obsolete: use FLB]"@en ,
        "Midgley Grit"@en ,
        "Revidge Grit [Obsolete: use FLB]"@en ;
    skos:broader namedrockunit:MARSD ;
    skos:definition "Sandstone with subsidiary mudstone and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Marsdenian Substage (Carboniferous Period) (321.5-320 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FLB"@en ;
