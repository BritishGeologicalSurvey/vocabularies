namedrockunit:LVBM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to coarse sandstone with beds of pebbly sandstone and conglomerate and occassional thin beds or lenses of olive green siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The unit conformably overlies conglomerates of the Ousdale Arkose Formation, and unconformably overlies (onlaps) the psammites and pelites of the Glenfinnan Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickness of the unit is poorly constrained due to the irregular topography of the unconformity surface with the metamorphic rocks of the Glenfinnan Group, and an absence of exposure of the higher parts of the unit in the Inner Beauly Firth. The thickness may range from tens of meters to over 200m."@en ;
    lexicon:hasUpperBoundaryDefinition "The unit is interpreted to conformably underlie the Raddery Sandstone Formation but the contact is not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:OA ;
    skos:definition "Sandstone with subsidiary conglomerate and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LVBM"@en ;
    skos:prefLabel "Lovat Bridge Sandstone Member"@en ;
