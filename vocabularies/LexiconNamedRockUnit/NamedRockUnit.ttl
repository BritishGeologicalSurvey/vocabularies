    skos:altLabel "Garron Point Actinolitic Schists [Obsolete: use GART]"@en ;
    skos:broader namedrockunit:CCFL ;
    skos:definition "Calcareous semipelite and semipelite with subsidiary psammite and trace metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GART"@en ;
    skos:prefLabel "Garron Point Tremolitic Flag Member"@en ;
