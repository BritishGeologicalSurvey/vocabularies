namedrockunit:BLOC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithologyDescription """Blockfield refers to an in situ, or nearly in situ, accumulation of frost-shattered rock blocks of different sizes and shapes on level or gently sloping mountain surfaces, derived from subjacent bedrock. The formation of blockfield is dependant on rock lithology and structure. Frost-susceptable, foliated rocks (for example schists) will break down to finer grained detritus (regolith). Blockfields sensu stricto are openwork and are characterised by the absence of soil accumulations. Obsolete: felsenmeer. \r
\r
Variable lithology."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:FMEER ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Felsenmeer [Obsolete: use BLOC]"@en ;
    skos:broader namedrockunit:RDEPS ;
    skos:definition "Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BLOC"@en ;
    skos:prefLabel "Blockfield"@en ;
.

