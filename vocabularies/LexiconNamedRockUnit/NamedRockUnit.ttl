    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SIMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicate mudstone, medium grey, weakly calcareous, slightly pyritous, shelly, with sporadic beds of argillaceous limestone nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Arbitrary boundary drawn at the top of highest substantial sandstone or sandy mudstone of underlying Kellaways Formation, above which the succession is predominantly mudstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H406 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 - 19 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Arbitrary boundary within upward transition from grey mudstone to predominantly brownish grey, generally more fissile and organic-rich (\"bituminous\") mudstone of overlying Peterborough Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Mohuns Park Member [Obsolete: use MPMU]"@en ,
        "Peterborough Member"@en ;
    skos:broader namedrockunit:PET ;
    skos:definition "Shelly mudstone and silicate-mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MPMU"@en ;
    skos:prefLabel "Mohuns Park Mudstone Bed"@en ;
.

namedrockunit:MRF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded limestones and calcareous sandstones. Limestone components compare with those of the underlying Cefn Mawr Limestone Formation and include both thick-bedded to massive pale grey limestones [packstones and grainstones], and sequences of thinly interbedded dark grey limestone [packstones and wackstones] and mudstone arranged in shoaling upwards cycles with the calcareous sandstones typically forming the upper parts of the cycles. The sandstones include oolitic units composed of radial fibrous ooids with sand-grain cores. Chert beds and nodules are common at some levels, and coral biostromes are present locally. The Minera Formation records late Brigantian, mixed carbonate-siliciclastic shallow marine deposition at a time of increased supply of siliciclastic detritus to the North Wales Dinantian platform. Each cycle represents a shoaling upwards sequence formed in response to transgressive and regressive movements in sea level. The diagnostic calcareous sandstones principally record the progradation of nearshore siliciclastic facies over transgressive off-shore limestone facies. Many regressions culminated in emergence of the platform surface, but, since sandstones commonly occupy the tops of the cycles, calcrete and karstic dissolution features, which are a common feature in the Cefn Mawr Limestone Formation, are only poorly developed in the Minera Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the lowest, laterally extensive and mappable sandstone above the Cefn Mawr Limestone Formation, but diachronous as the formation passes laterally into the Cefn Mawr Limestone Formation in North Flintshire."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4203 ,
        namedrockunit:H4804 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.50m in the type area, thickening to 180m north of the Bala Lineament."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of the highest laterally extensive and mappable limestone beneath thick, sandstone dominated sequences of the Cefn-y-fedw Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Arenaceous Limestone [Obsolete: use MRF]"@en ,
        "Sandy Limestone: Arenaceous Limestone; Sandy Passage Beds [Obsolete: use MRF]"@en ;
    skos:broader namedrockunit:CLWYD ;
    skos:definition "Limestone and sandstone with subsidiary mudstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MRF"@en ;
    skos:prefLabel "Minera Formation"@en ;
.

namedrockunit:MRG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:S83 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QAREN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Moor Grit Member is dominated in coastal exposures by grey, medium- to coarse-grained, occasionally pebbly, trough cross-bedded sandstone, with thin siltstone and mudstone beds; plant fragments and fossil wood casts are common . Inland, in the Hambleton Hills (Powell et al., 1992) it consists of grey to white, fine-grained, orthoquartzitic sandstone, with low-angle cross stratification and planar bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is disconformable or unconformable, at the abrupt upward transition from grey, shelly mudstone or shelly sandstone of the Scarborough Formation to grey, cross-bedded and planar laminated sandstone with occasional plant fragments of the Moor Grit Member (Nami and Leeder, 1978; Gowland and Riding, 1991; Powell et al., 1992). The base is often a scoured, erosional surface."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1711 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 8 to 12 m thick on the North Yorkshire coast (Hemingway, 1974); 8 - 15 m in the Hambleton Hills in the west of the outcrop (Powell et al., 1992); in the Howardian Hills it thins southwards to about 1 m thick (J Ford, pers. comm. 2008)"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable or disconformable, at the boundary between white or grey, fine- to medium-grained cross-bedded sandstone (Moor Grit Member), and predominantly level-bedded siltstone, mudstone or thin, cross laminated sandstone with plant fragments of the Long Nab Member (Nami and Leeder, 1979)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cross-Bedded Series [Obsolete: use MRG]"@en ,
        "Moor Grit"@en ;
    skos:broader namedrockunit:SCY ;
