    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Moorcock Flags [Obsolete: use MOCS]"@en ,
        "Moorcock Sandstones Member [Obsolete: use MOCS]"@en ;
    skos:broader namedrockunit:CLAU ;
    skos:definition "Sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MOCS"@en ;
    skos:prefLabel "Moorcock Sandstone"@en ;
.

namedrockunit:MOGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SNDG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glauconitic calcareous sandstone, white to pale greenish. Some gritty beds and calcareous inclusions up to cobble size. Conspicuously shelly (mainly oysters) in parts."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable on various Jurassic and Triassic strata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GSM ,
        namedrockunit:H1706 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0.3 to 13.4m, according to Rawson et al. (1978)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is at a [?]conformable contact with the overlying Lochaline White Sandstone Formation. However Braley (1990) and Lowden et al. (1992) regarded the Lochaline White Sandstone Formation as a member within this formation and considered the upper boundary as unconformable with the Gribun Chalk Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cenomanian Greensand [Obsolete: use MOGR]"@en ,
        "Greensand of Morvern [Obsolete: use MOGR]"@en ;
    skos:broader namedrockunit:IHEB ;
    skos:definition "Glauconitic sand and glauconitic sandstone with subsidiary sandstone and sandy limestone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MOGR"@en ;
    skos:prefLabel "Morvern Greensand Formation"@en ;
.

namedrockunit:MOGS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCHGR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPGR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Semipelitic and pelitic schist, commonly graphitic, with calc-silicate lenses and metalimestone in lowermost part."@en ;
    lexicon:hasLowerBoundaryDefinition "At the top of the Pitlurg Formation where interbedded thin limestones, calc-silicate beds and semipelites and psammites pass up into either graphitic schist or massive limestone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 970m, including any thickening due to folding in the type section; thinned and thickened considerably by deformation elsewhere."@en ;
    lexicon:hasUpperBoundaryDefinition "At the base of the Corriehabbie Quartzite Formation where the schists pass up into flaggy psammites, phyllites and quartzite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DABH ;
    skos:definition "Graphitic schist and pelite with subsidiary calcsilicate-rock and metalimestone and trace graphitic pelite and graphitic semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DUFF ,
        namedrockunit:SNDL ;
    skos:notation "MOGS"@en ;
    skos:prefLabel "Mortlach Graphitic Schist Formation"@en ;
.

namedrockunit:MOI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically a subangular conglomerate with locally-derived clasts in a red, sandy mudstone matrix. Buff sandstones interbedded with mudstones constitute a distal facies."@en ;
    lexicon:hasLowerBoundaryDefinition "An irregular unconformity surface on rocks of Precambrian to Palaeozoic age."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1070 ,
        namedrockunit:MOB ;
