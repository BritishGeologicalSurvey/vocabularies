namedrockunit:EDTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, reddish brown, very sandy, silty clayey diamicton with clasts mainly derived from the Vale of Eden (mostly brown 'Penrith' and red 'St Bees' sandstones, but including Carboniferous limestone and yellow sandstones), the Lake District (including andasitic lavas and welded tuffs) and the Alston Block (sandstone and grit) but also with sparse granodiorite, granite and wacke sandstones from the Galloway Hills of Scotland."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp, unconformable contact with bedrock, but commonly a gradational unconformable contact with weathered/decomposed sandstone. Boreholes reveal a locally sharp unconformable contact with sand and gravel which in turn overlies bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S643 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 20 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally at surface or overlain unconformably by a variety of Holocene sediments including peat and alluvium. Locally unconformably overlain by sand and gravel of the glaciofluvial Baronwood Sand and Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Eden Member [Obsolete: use EDTI]"@en ;
    skos:broader namedrockunit:GYTI ;
    skos:definition "Clay with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EDTI"@en ;
    skos:prefLabel "Edenside Till Member"@en ;
.

namedrockunit:EDW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone and siltstone, red-brown and greenish grey, with beds of indurated, variably dolomitic siltstone and very fine-grained sandstone common in the lower half; finely disseminated gypsum common in upper half."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at the abrupt or rapid upward transition from interbedded green mudstone and pale grey fine-grained sandstone of the Cotgrave Sandstone Member to reddish brown structureless mudstone at the base of the Edwalton Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H228 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasOldestAgeValue 2.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35 to 45 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the abrupt upward transition from structureless, reddish brown and greenish grey mottled, gypsiferous mudstone at the top of the Edwalton Member to the lowest fine to medium-grained sandstone bed of the Arden Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Edwalton Formation [Obsolete: use EDW]"@en ;
    skos:broader namedrockunit:SIM ;
