    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "c. 70-100m in the Lancaster area; about 250m in the Garstang district (former Park Wood Sandstone Member)."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp transition the sandstone-dominated Dure Clough Sandstones to grey micaceous siltstones with few thin sandstones (commonly less than 0.1m) of the Roeburndale Member (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dure Clough Sandstones Member [Obsolete: use DUCS]"@en ,
        "Park Wood Sandstone [Obsolete: use DUCS]"@en ,
        "Park Wood Sandstones [Obsolete: use DUCS]"@en ;
