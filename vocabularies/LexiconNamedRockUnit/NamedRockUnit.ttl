    lexicon:hasThicknessDescription "c. 8 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:FIB ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LFIB"@en ;
    skos:prefLabel "Lower Fittleworth Member"@en ;
.

namedrockunit:LFION
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OPHW"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The base of the member consists of up to 50 m of coarse fluviatile conglomerates. Gritty sandstones in the lowest exposures at Maternity Hollow [NG 3473 0063] contain thin, carbonised logs up to 1 m in length. Individual flows are about 7 to 10 m in thickness but this is difficult to estimate as exposure is poor. The massive, columnar flow centres form the edges of peat-covered shelves. The lower lavas are olivine-basalts with microphenocrysts of plagioclase. Higher flows, in the steep valley about 200 m north-east and east of Orval, are basaltic hawaiites. These flows lie on an eroded surface of weathered granophyre (Black, 1952b). \r
\r
The lowest of four members of the Canna Lava Formation on Rum."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lavas and conglomerates of the Lower Fionchra Member fill former valleys in an early Tertiary land surface eroded in Torridon Group (TC) sandstones and members of the Rum Central Complex (RUMC). East of Fionchra the conglomerates were deposited in the bottom of a V-shaped valley which was further filled by a succession of lava flows. The valley is cut off to the east by the NNW-trending fault at Maternity Hollow. A former valley wall is seen in knolls about 600 m north-east of Fionchra summit."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Emeleus (1997, fig. 40) shows a thickness of c. 140 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CNAL ;
    skos:definition "Olivine-phyric hawaiite with subsidiary conglomerate and trace olivine-basalt. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LFION"@en ;
    skos:prefLabel "Lower Fionchra Member"@en ;
.

