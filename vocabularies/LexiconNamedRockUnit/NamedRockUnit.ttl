namedrockunit:TSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:BREN ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greenish-grey slates. Local thin lenticular interbeds of bioclastic limestone and dolomite beds up to 0.15 m thick, with sandstone, siltstone and rare tuff beds. Slate and siltstone are interlaminated in places; within the aureole of the Bodmin granite this gave rise to distinctively banded slates ('Woolgarden Phyllites'). Rust-spotting generated by the oxidation of pyrite and spotting caused by low-grade metamorphism are extensively developed: orthoclase and chloritoid minerals are locally present and may be sufficiently large as to coarsen the texture of the slate. Towards the top of the Formation, a lenticular body of well cleaved, fine-grained bluish grey slate which is hard, close-textured and with a silky lustre: this is the Delabole Member within the Tredorn Slate Formation, which crops out in an arcuate outcrop around the Davidstow Anticline to the north of Camelford [SX 1060 8362]."@en ;
    lexicon:hasLowerBoundaryDefinition "Thrust boundary with the Trevose Slate or Jacket's Point Formation; normal faulted contact with the granite. Along the thrust contant between Trevose Slate and Tredorn Slate Formation, the contact would be recognised in the field by an abrupt change from the grey and dark grey laminae in silty mudstone with locally paler laminae (Trevose Slate Formation) to the greenish-grey slates with thin local limestone, sandstone, siltstone or tuff beds of the Tredorn Slate Formation (as described in lithology section above). Along the thrust boundary between the Jacket's Point Fornation and the Tredorn Slate Formation, the contact would be recognised in the field by an abrupt change from featureless mid-grey/green mudstone with local fine lamination and sheet or lenticular sandstone bodies (Jacket's Point Formation) to greenish-grey slates with thin local limestone, siltstone or tuff beds of the Tredorn Slate Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2506 ,
        namedrockunit:H3996 ,
        namedrockunit:H4939 ,
        namedrockunit:H4940 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Between 500 - 800 m structural thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "Faulted contact with either Barras Nose Formation or Tintagel Volcanic Formation. In both cases, an abrupt contact between the Tredorn Slate Formation (greenish grey slates with thin local limestone, siltstone or tuff beds) and the adjacent lithology would be identified."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brendon Formation"@en ,
        "Delabole Slates [Obsolete: use UDSL, TVY, DLBS, TSL]"@en ,
        "Tredorn Beds [Obsolete: use TSL, TVY]"@en ,
        "Tredorn Phyllites [Obsolete: use TSL, TVY]"@en ,
        "Woolgarden Phyllite [Obsolete: use TVY, TSL]"@en ;
    skos:definition "Slate with subsidiary limestone, sandstone and siltstone and trace tuff. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DLBS ;
    skos:notation "TSL"@en ;
    skos:prefLabel "Tredorn Slate Formation"@en ;
.

namedrockunit:TYWE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S346 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Laminated greyish brown to brownish grey, silty clay and micaceous clayey silt with subordinate beds and laminae of fine-grained sand, pebbly clay diamicton and gravel. Complex interdigitation of units is common, especially towards the coast. Dropstones are common and worm traces can be seen locally on partings. The complex sequence was deposited in several lake basins including Glacial Lake Wear and Glacial Lake Edderacres where it tends to fine upwards and southwards with fine-grained units successively overlapping coarser ones northwards."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally in irregular, draped, conformable contact with underlying dark grey, stony sandy silty clay diamicton of the Wear Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EDAC ,
        namedrockunit:H1882 ,
        namedrockunit:H1883 ,
        namedrockunit:H3101 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 60 m within buried channels."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a planar, subhorizontal to undulating, gradational, glaciotectonic boundary with overlying reddish-brown to dark brown pebbly silty clay of the Pelaw Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Durham Complex [Obsolete: use TYWE]"@en ,
        "Durham Member"@en ,
        "Edder Acres Formation [Obsolete: use TYWE]"@en ,
        "Middle Sands, Gravels and Clays [Obsolete: use TYWE]"@en ,
        "Tyne-Wear Complex [Obsolete: use TYWE]"@en ;
    skos:broader namedrockunit:NPEG ;
    skos:definition "Silt with subsidiary clay and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PELC ;
    skos:notation "TYWE"@en ;
    skos:prefLabel "Tyne and Wear Glaciolacustrine Formation"@en ;
.

namedrockunit:ULL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:HIL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, overwhelmingly dominated by high-energy ooidal and shell fragmental grainstones, but includes secondarily recrystallized and micritized lithologies."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformable, commonly channelled contact between dominantly calcilutite, packstone and wackestone limestones of the Lower Lincolnshire Limestone Member, or (locally in the south) mudstone, sandstone and ironstone of the underlying Grantham Formation or Northampton Sand Formation, overlain by the ooidal and bioclastic grainstones of the Upper Lincolnshire Limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CVO ,
        namedrockunit:H3107 ,
        namedrockunit:H4707 ,
        namedrockunit:HIL ,
        namedrockunit:S254 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To c. 15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformable, commonly markedly eroded and karstified contact between ooidal and bioclastic grainstone of the Upper Lincolnshire Limestone and the non-calcareous non-marine sandstones, siltstones and mudstones of the overlying Rutland Formation. Near the northern limit only, disconformable contact between ooidal and bioclastic grainstone of the Upper Lincolnshire Limestone and ferruginous sandy calcareous sediments of the Hunstanton Formation (Cretaceous, Chalk Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cave Oolite [Obsolete: use ULL]"@en ,
        "Hibaldstow Beds [Obsolete: use ULL]"@en ,
        "Hibaldstow Limestone [Obsolete: use ULL]"@en ,
        "Hibaldstow Limestones Member [Obsolete: use HIL, ULL]"@en ,
        "Upper Lincolnshire Limestone [Obsolete: use ULL]"@en ;
    skos:broader namedrockunit:LL ;
    skos:definition "Limestone and ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ULL"@en ;
