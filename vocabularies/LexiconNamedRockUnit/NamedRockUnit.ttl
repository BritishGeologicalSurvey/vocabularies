namedrockunit:UBV
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PYGA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Spilitic pillow lavas with subordinate pyroclastic bands to the east and central parts of the Cader Idris Range and dominantly pyroclastic rocks to the west. (Correlative of Upper Basic Volcanic Group = Pen-y-Gader Group)."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of Upper Basic Volcanic Group where it rests conformably on pyroclastics of the Llyn-y-Gader Mudstones Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Approx. 120 to 150 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from spilitic lavas, mudstone, ash and chert of the Upper Basic Volcanic Group to mudstones of the Llyn Cau Mudstones Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pen y Gader Group [Obsolete: use PGA]"@en ;
    skos:definition "Lava and pyroclastic-rock. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage - to - Caradoc Series (Ordovician Period) (468-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "UBV"@en ;
    skos:prefLabel "Upper Basic Volcanic Group"@en ;
.

namedrockunit:UCB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "\"A variable sequence of sandy limestones, calcareous sands and calcarenitic limestones\" (Page, 1989). \"Sparsely sandy peloidal biomicrite overlying fine-grained calcareous sandstone and sandy biomicrite\" (Bristow, 1999)."@en ;
    lexicon:hasLowerBoundaryDefinition "Quasi-conformable to non-sequential contact with limestones of the underlying Lower Cornbrash (Upper Bathonian) or mudstone of the the Blisworth Clay Formation (East Midland Shelf east and north), or with the mudstone with minor sandstone beds of the Scalby Formation (Cleveland Basin), overlain by limestone of the Upper Cornbrash."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1884 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 7 m; thickest in the Wessex Basin, and (probably) absent in much of the south Midlands."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the succeeding Kellaways Formation or Cayton Clay Formation (in the Cleveland Basin); comprising mudstone, commonly shelly at its base, resting generally sharply and conformably or non-sequentially on the limestone of the Cornbrash."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fleet Member [Obsolete: use UCB]"@en ;
    skos:broader namedrockunit:CB ;
    skos:definition "Limestone and sandy limestone with subsidiary calcareous mudstone, calcareous sandstone and ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UCB"@en ;
    skos:prefLabel "Upper Cornbrash Member"@en ;
.

