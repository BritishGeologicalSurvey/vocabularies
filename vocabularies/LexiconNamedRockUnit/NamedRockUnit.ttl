    skos:narrower namedrockunit:CULI ;
    skos:notation "OTPS"@en ;
    skos:prefLabel "Otterswick Psammite Formation"@en ;
.

namedrockunit:OULT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Composed of horizontally laminated pale grey sandy silts and grey clays with sporadic isolated pale grey sand lenses."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal contact of the Oulton Clay Member with the underlying Lowestoft Till Member is sharp, and represented by an abrupt transition from clay-rich till, to laminated silts and clays."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4238 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum thickness of 2.2 m observed at stratotype."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper contact of the Oulton Clay Member with the overlying Pleasure Gardens Till Member is diffuse and represented by the interdigitation of beds of silt and clay with lenses of chalky till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Oulton Beds [Obsolete: use OULT]"@en ;
    skos:broader namedrockunit:LOFT ;
    skos:definition "Clay and sandy silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage (Quaternary Period) (.48-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OULT"@en ;
    skos:prefLabel "Oulton Clay Member"@en ;
.

namedrockunit:OV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFASST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey, laminated siltstones and tuffaceous fine-grained sandstones; channels of sedimentary breccia composed of platy siltstone clasts at base. Formation is intruded by sills of Eycott Volcanic Group age."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity with Skiddaw Group rocks below. (Angular discordance seen in places)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4239 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.8m at type section; up to 10m elsewhere; absent in some areas."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by conglomerate or by basaltic andesite and andesite lavas and sills forming main part of the Eycott Volcanic Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Overwater Formation [Obsolete: use OV]"@en ;
    skos:broader namedrockunit:EVG ;
    skos:definition "Siltstone and tuffaceous-sandstone with subsidiary breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OV"@en ;
    skos:prefLabel "Overwater Siltstone Formation"@en ;
.

namedrockunit:OVLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATRAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Overton Lava Member consists of at least one plagioclase-macrophyric basalt lava (of 'Markle' type) overlying a basaltic-trachyandesite lava (mugearite). Several lavas, including trachybasalt, may be present and the best exposures are in the faulted River Carron section, to the north-west of Nicholswalls [NS 764 843] and in the Overton Burn, east of Overton [NS 772 834]. No source for the lavas has been identified."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal basaltic-trachyandesite (mugearite) lava of the member is conformable or disconformable in the north on the trachybasalt lavas of the undivided lower north and south Campsie lavas (Campsie Lava Member). Elsewhere the base is not seen."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4240 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Overton Lava Member in the east is overlain conformably or disconformably by the undivided upper north and south Campsie lavas (Campsie Lava Member), and in the north, the member is overlain specifically by the upper north Campsie lavas. The transition is from plagioclase-macrophyric basalt lava to plagioclase-microphyric trachybasalt and some basalt lavas (basalt to hawaiite of 'Jedburgh' type) with scoriaceous agglomerates and tuffs."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Overton Lavas [Obsolete: use OVLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt, basaltic-trachyandesite and trachybasalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OVLA"@en ;
    skos:prefLabel "Overton Lava Member"@en ;
.

namedrockunit:OVS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of the unit is about 36m thick, and is dominated by grey, fine-grained, thin-bedded or partly concretionary sandstone. There are also intervals of mudstone, up to 3.32m thick, commonly with calcareous concretions and uncommon beds of concretionary limestone or dolomitic limestone (cementstone). The upper part, which is about 20m thick, largely comprises of pale grey, mostly fine-grained sandstone with clasts of carbonate. Unlike the lower part of the member, sandstones with concretions and mudstones are uncommon."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable and overlies strata of the Ballagan Formation, that are characterised by grey mudstone and dolomitic limestone (cementstone). In the Barnhill Borehole, the base of the member is picked at the top of an interval dominated by grey mudstone with gypsum veins, at 161.48m depth, and overlain by a sequence dominated by thick intervals of sandstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3600 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "56.6m at the Type Section."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is sharp and picked at a marked change from grey sandstone and mudstone to grey tuff, with volcanic lapillae of the overlying Clyde Plateau Volcanic Formation at 104.89m depth in the Barnhill Borehole. Correlation with the Greenock district, demonstrates that the base of the Clyde Plateau Volcanic Formation is unconformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Overtoun Sandstone Formation [Obsolete: use OVS]"@en ;
    skos:broader namedrockunit:CYD ;
    skos:definition "Sandstone with subsidiary limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OVS"@en ;
    skos:prefLabel "Overtoun Sandstone Member"@en ;
.

namedrockunit:OWSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded grey burrowed, and dark-grey or greenish grey pyritic, mudstone. Beds of siltstone and sandstone increase in upper part."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional passage, with decreasing proportion of bioturbated, erosionally-truncated beds in upper part."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2356 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasOldestAgeValue 4.99e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "300m in general: 87m minimum in Merevale No.1 borehole; 158m minimum in Merevale No.3 borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional passage into the Moor Wood Sandstone Formation by increase in silty and sandy beds and decrease in dark-grey, pyritic and carbonaceous material."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasYoungestAgeValue 4.869e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Outwoods Shales [Obsolete: use OWSH]"@en ;
    skos:broader namedrockunit:SSH ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Merioneth Series (Cambrian Period) (499-486.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OWSH"@en ;
    skos:prefLabel "Outwoods Shale Formation"@en ;
.

namedrockunit:OXT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ;
