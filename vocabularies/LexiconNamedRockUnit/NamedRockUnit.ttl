namedrockunit:BELB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bright red friable sandstone, with thin layers composed of well-rounded and polished grains of quartz, interbedded with beds of breccia. Clasts within the  breccia are of vein quartz, quartzite and mica-schist. The sandstone may contain facetted pebbles [of dreikanter type]. Cross-bedding [false-bedding] is a conspicuous feature of the sandstone, which is interpreted as an aeolian sand-dune deposit. Greyish-white sandstone with a calcareous cement is noted at Muasdale [NR675 395]."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies Dalradian metasedimentary rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:UORS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The proven minimum thickness of the formation exposed in the roadside cliff at Bellochantuy is 6m [18ft] [Pringle, 1952]. However, this is considered only to be the edge of strata that extend under the sea and are continuous with other exposures of the Formation along the Kintyre coast [Pringle, 1952]."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlying rocks no longer preserved."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Old Red Sandstone [Obsolete: use ORSU]"@en ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Sandstone with subsidiary breccia and trace calcareous sandstone. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BELB"@en ;
    skos:prefLabel "Bellochantuy Bay Formation"@en ;
.

