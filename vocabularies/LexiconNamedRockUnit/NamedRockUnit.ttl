    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 800m in Sheet 55W (most thinning is tectonic)."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp (<10m) change from fine-grained quartzite of Shiehallion Quartzite Formation to dark, layered semipelite and thin-bedded psammite containing 8cm layers of fine-grained garnet-amphibolite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
