    lexicon:hasThicknessDescription "About 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen but presumed to be conformable with sedimentary rocks of the Fell Sandstone Formation. Overlain by sedimentary strata, mainly sandstones of the Fell Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
