namedrockunit:HAMU
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Hake Mudstone Member is easily distinguished within the Turbot Anhydrite Formation by its high-gamma, low-velocity, and low-resistivity, blocky log responses. The member is generally composed of grey, greenish grey, yellow or reddish brown mudstone, but locally includes one or more thin beds of white or pale grey anhydritic dolomite or sandstone. Its mudstones are variably dolomitic, anhydritic and micaceous, and they are locally carbonaceous. Where present, dolomite beds contain laminae of clay and nodular anhydrite. In parts of the Outer Moray Firth, the member is composed entirely of fine or medium grained, argillaceous sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Hake Mudstone Member is defined by a downward transition from terrigenous sediments to anhydrite or, in some sections, from dolomite to anhydrite. These transitions are marked by a sharp downward decrease in gamma-ray values and increase in velocity and resistivity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The member is generally between 4 and 15 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Hake Mudstone Member is defined by a downward change from anhydrite to mudstone or, locally, argillaceous sandstone, marked by a sharp downward increase in gamma-ray values and decrease in velocity and resistivity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TBAN ;
    skos:definition "Mudstone with subsidiary dolostone and sandstone and trace anhydrite-stone. Stratified bedrock. Occurs offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HAMU"@en ;
    skos:prefLabel "Hake Mudstone Member"@en ;
.

