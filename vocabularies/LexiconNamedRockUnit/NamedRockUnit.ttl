namedrockunit:CLHS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Siltstone, grey, sandy, micaceous, calcareous with rhythmic layers of fine-grained red-brown weathering, sandstone to 1cm; sporadic to common layers of sandy calcisiltite; rare to common Sanguinolites and bellerophontids. NOTE: This is a distinct/unique lithology within the Roeburndale Formation. The formation consists of delta slope siltstones with sandstones. There were previously three known marine bands with goniatite/bivalve faunas. The Close Hill Siltstone is a fourth new marine band. "@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational to grey planty siltstones with common planty micaceous fine- to medium-grained sandstones over 10cm. (Delta slope deposits)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4551 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "c. 60m"@en ;
    lexicon:hasUpperBoundaryDefinition "As lower boundary."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Close Hill Siltstone Member [Obsolete: use CLHS]"@en ;
    skos:broader namedrockunit:RBL ;
    skos:definition "Siltstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLHS"@en ;
    skos:prefLabel "Close Hill Siltstone"@en ;
