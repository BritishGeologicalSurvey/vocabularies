namedrockunit:GYCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent
        namedrockunit:FYCK ,
        namedrockunit:LCK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clayey ('marly') chalk without flint. The Lower part comprises limestone/marl 'couplets' equivalent to the West Melbury Marly Chalk Formation in the Southern Province. The upper part is distinctly less 'marly' with notable calc-arenite beds and is equivalent to the Zig Zag Chalk Formation of the Southern Province. The Ferriby Formation of the Northern Province is the lateral equivalent of the Grey Chalk Subgroup and comprises grey, soft, marly, flint-free chalk, typically weathering buff in exposures; locally includes pinkish bands; some harder, gritty, shell-debris-rich beds, and thin discrete marl seams."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable, set at the burrowed erosion surface marking the base of the Cenomanian. In the Southern Province this marks the distinct change from chalk-free to chalk-rich sediment. In the Northern Province the boundary is at an erosion surface between the Ferriby and Hunstanton formations."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4056 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Variable, generally between 45 and 90 m in the Southern Province. Is equivalent to the 30 m or so of the Ferriby Chalk Formation of the Northern Province."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable at the highest bedding plane beneath the lowest bed of the Plenus Marls Member of the Holywell Nodular Chalk Formation in the Southern Province and the Welton Chalk Formation in the Northern Province. (Note that the Plenus Marls Member is now considered as part of the overlying subgroup, thus providing a consistent datum throughout the Chalk Group of England and the North Sea)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ferriby Chalk Formation"@en ,
        "Lower Chalk Formation"@en ,
        "Lower Chalk [Obsolete: use FYCK, GYCK]"@en ;
    skos:broader namedrockunit:CK ;
    skos:definition "Chalk with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BRHD ,
        namedrockunit:FYCK ,
        namedrockunit:WMCH ,
        namedrockunit:WZCK ,
        namedrockunit:ZZCH ;
    skos:notation "GYCK"@en ;
    skos:prefLabel "Grey Chalk Subgroup"@en ;
.

