namedrockunit:AMNGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravel. Interpreted as glaciofluvial outwash. Grey, pebble to boulder grade. Clast-supported with a medium to coarse quartzose sand matrix. Clasts are subrounded to rounded and composed mainly of quartzite (probably reworked from underlying gravel deposits and Devonian conglomerates) - other lithologies are rare. The gravels are crudely horizontally bedded with local sand interbeds displaying horizontal stratification. Clast imbrication measurements indicates palaeocurrents flowing towards the south."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the formation is a scoured, undulatory erosion surface (amplitude about 1.0m) on reddish brown diamicton of the Byth Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1948 ,
        namedrockunit:H1949 ,
        namedrockunit:H3166 ,
        namedrockunit:H4430 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "The formation either occurs at the present ground surface or is overlain by Holocene peat or alluvial sediments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Auchmeddon Gravel Formation [Obsolete: use AMNGR]"@en ,
        "Auchmeddon Gravel [Obsolete: use AMNGR]"@en ,
        "Auchmeddon Member [Obsolete: use AMNGR]"@en ,
        "Glacial meltwater deposits [Obsolete: use GFDU]"@en ;
    skos:broader namedrockunit:BLSG ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMNGR"@en ;
    skos:prefLabel "Auchmeddon Gravel Member"@en ;
.

namedrockunit:AP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly a calcareous siltstone, although it occurs in graded units that range from a fine-grained sandstone with shelly lag accumulations at the base, to a bioturbated and fine-grained top. Cross-bedding is widespread, and there are rare interbeds of concretionary limestone. The unit is interpreted as a series of storm surge deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests with a marked lithological change either on the rhyolitic ignimbrite of the Yarlside Volcanic Formation, or on the concretionary limestone of the Kentmere Member (Kirkley Bank Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:APB ,
        namedrockunit:H1309 ,
        namedrockunit:S240 ,
