namedrockunit:WATCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLateralEquivalent namedrockunit:WLI ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Thin to thickly bedded pale and medium grey, calcareous mudstones with variable shell content, with lenticular or nodular beds of muddy limestone. Subordinate lithologies include porcellanous limestone, calcareous sandstone and siltstone.\r
\r
"""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is an erosion surface where calcareous mudstone infills an irregular surface at the top of off-white, porcellanous limestones of the White Lias Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5077 ,
        namedrockunit:H5078 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasOldestAgeValue 2.057e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation ranges in thickness at outcrop from 0 to 0.5 m in Somerset and is around 2 m thick on the south Glamorgan coast. The thickest development is 4.8 m in the St Fagan's Borehole [ST1169 7813] (ST17NW/276)."@en ;
    lexicon:hasUpperBoundaryDefinition "This is taken at the sharp upward change from pale grey, calcareous mudstone to laminated, fissile, brownish grey, organic-rich mudstones with common fish scales of the Blue Lias Formation (this is probably the Wilmecote Limestone Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Watchet Beds [Obsolete: use WATCH]"@en ,
        "Watchet Member [Obsolete: use WATCH]"@en ,
        "White Lias Formation"@en ;
    skos:broader namedrockunit:PNG ;
    skos:definition "Mudstone with subsidiary limestone and trace sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Rhaetian Age (Triassic Period) (205.7-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WATCH"@en ;
    skos:prefLabel "Watchet Mudstone Formation"@en ;
.

namedrockunit:WATI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower boundary of the Walcott Till Member consists of an olive grey to olive brown silt-rich matrix-supported diamicton that is largely massive in structure. It has a moderate matrix calcium carbonate content of c.36% and contains an abundance of chalk and flint clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the Walcott Till Member is irregular and erosional and lies upon either sandy Wroxham Crag Formation sediments or on laminated silts and clays of the Happisburgh Glacigenic Formation. Commonly these underlying sediments exhibit evidence of shearing. [See also the Stratotype information.]"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CMTU ,
        namedrockunit:H4958 ,
        namedrockunit:H4959 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "A maximum of 2.2m has been observed."@en ;
    lexicon:hasUpperBoundaryDefinition "The diamicton is generally overlain by the outwash sands of the Mundesley Sand Member. The junction between the two units is commonly sharp and erosional."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cromer Till (Upper Member) [Obsolete: use WATI]"@en ,
        "Second Cromer Till [Obsolete: use WATI]"@en ,
        "Walcott Diamicton [Obsolete: use WATI]"@en ;
    skos:broader namedrockunit:LOFT ;
    skos:definition "Diamicton with subsidiary clay and silt and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage (Quaternary Period) (.48-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WATI"@en ;
    skos:prefLabel "Walcott Till Member"@en ;
.

