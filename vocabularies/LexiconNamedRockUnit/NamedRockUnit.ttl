    lexicon:hasThicknessDescription "c.670 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of the Lightspout Formation to the overlying purple shaly mudstone and siltstone with bands of coarse purplish grey sandstone of the Huckster Conglomerate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
