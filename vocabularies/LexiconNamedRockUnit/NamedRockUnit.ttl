    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELTU"@en ;
    skos:prefLabel "Lower Elton Formation, Middle Elton Formation And Upper Elton Formation (Undifferentiated)"@en ;
.

namedrockunit:ELV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Firm to stiff, rarely soft, mottled reddish brown (5YR 4/3) and grey (GLEY 2 3/1) thinly laminated clay. Sporadically interlaminated with silt and fine reddish brown sand. Commonly fissured. Gypsum, in the form of opaque, tabular selenite is found locally within the laminated clay below a depth of 2.5m. Crystal size is typically 15 to 35mm along the longest axis."@en ;
    lexicon:hasLowerBoundaryDefinition "Not observed. In most places the Elvington Glaciolacustrine Formation will overlie tills of the Vale of York Formation as proved in borehole SE64NE/10, where 4.6m of soft grey brown clay is recorded resting on \"brown boulder clay\" (glacial till)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2783 ,
        namedrockunit:H2784 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Minimum thickness of 4.2m proved in borehole (SE64NE/17)(SE6838 4634) but generally exceeds 5m in thickness. 4.6m proved in borehole SE64NE/10."@en ;
    lexicon:hasUpperBoundaryDefinition "An outcrop overlain by aeolian or fluvial sand or clayey sand. The contact is sharp where proven in auger bores."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Elvington Glacial Lake Formation [Obsolete: use ELV]"@en ,
        "Silts and clays of the Vale of York [Obsolete: use ELV]"@en ;
    skos:broader namedrockunit:NPEG ;
    skos:definition "Clay with subsidiary sand and silt. Stratified superficial deposits. Occurs offshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELV"@en ;
    skos:prefLabel "Elvington Glaciolacustrine Formation"@en ;
.

namedrockunit:ELWK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Varied lithologies including ill-sorted gravel, red sand and red sandy diamicton with clasts of limestone and dolostone of the Zechstein Group (formerly Magnesian Limestone), Carboniferous lithologies (sandstone, limestone) and Cheviot andesite. Forming linear ridges and mounds with kettleholes."@en ;
    lexicon:hasLowerBoundaryDefinition "Uneven, unconformable contact on bedrock or dark brown stony sandy silty clay diamicton of the Wear Till Formation. Lateral unconformable contact with reddish brown stony sandy silty clay diamicton of the Horden Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DOD ,
        namedrockunit:H3385 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To about 12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Elwick Member [Obsolete: use ELWK]"@en ,
        "Morainic drift [Obsolete]"@en ;
    skos:broader namedrockunit:HNTI ;
    skos:definition "Gravel with subsidiary sand and trace diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELWK"@en ;
    skos:prefLabel "Elwick Moraine Member"@en ;
.

