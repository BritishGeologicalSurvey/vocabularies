namedrockunit:YM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine or medium-grained grey-green sands, typically non-calcareous, with variable clay lamination and local intercalations of reworked peat. Characteristic chaotic reflector configuration in seismic profiles, presumed mainly fluviatile, with possible shallow marine incursions."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies early Pleistocene Westkapelle Ground, Smith's knoll, Ijmuiden Ground or Winterton Shoal Formations."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS062> ;
    lexicon:hasOldestAgeValue 1.8e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 100 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by Middle and Upper Pleistocene formations, and subcrops below Holocene sands in parts of British Sector."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS013> ;
    lexicon:hasYoungestAgeValue 5e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DUNW ;
    skos:definition "Clay and sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 62 - to - Marine Isotope Stage 13 (Quaternary Period) (1.8-.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:ALK ;
    skos:notation "YM"@en ;
    skos:prefLabel "Yarmouth Roads Formation"@en ;
