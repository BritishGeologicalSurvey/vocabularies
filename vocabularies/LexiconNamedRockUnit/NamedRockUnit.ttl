        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMIF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCHM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCHQZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPSCH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Locally arkosic quartzofeldspathic psammite in units 100-1000m thick, with subsidiary semipelite to pelite units. Quartzite units occur locally towards the top of the succession. Amphibolite and calcsilicate rock are rare. Succession from Grampian Group into Lochaber Subgroup continuous in some areas, e.g. Schiehallion, Banffshire, but in Glen Spean there may be a modified unconformity at the base of the Leven Schist."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1572 ,
        namedrockunit:H938 ,
        namedrockunit:MD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 5km in any one area; total thickness estimated at 9km."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally sharp transition from uniform psammite, generally flaggy, with thin quartzite and semipelite units of underlying Grampian Group, to better sorted psammite or quartzite and semipelite or pelite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eilde Flags [Obsolete: use GRAM]"@en ,
        "Grampian Division [Obsolete: use GRAM]"@en ,
        "Struan Flags [Obsolete: use GRAM]"@en ;
    skos:broader namedrockunit:DALN ;
    skos:definition "Psammite with subsidiary pelite, quartzite and semipelite and trace amphibolite, calcsilicate-rock, flaggy micaceous psammite, gneissose semipelite, graphitic pelite, marble, metadolostone, metalimestone, mica schist, micaceous psammite, quartz schist and schistose semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
