    lexicon:hasLithologyDescription "Mudstone, reddish brown and grey, dolomitic, with thick units of bedded halite and common anhydrite."@en ;
    lexicon:hasLowerBoundaryDefinition "Slightly unconformable, at abrupt upward change from sandstone of the Bacton Group to red-brown dolomitic mudstone with evaporites of the overlying Haisborough Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "To 900m (Johnson et al., 1994)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at an abrupt upward change from red-brown and grey-green mudstones of the Haisborough Group to the dark grey mudstones and grey fine-grained sandstone of the overlying Penarth Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TN> ;
