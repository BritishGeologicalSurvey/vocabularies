namedrockunit:CRNV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Cringate Volcaniclastic Member consists of variably stratified volcaniclastic sedimentary rocks and/or tuffs. An exposure in the north-east bank of the Endrick Water at [NS 6800 8750] shows poorly stratified dull red tuff or volcaniclastic sedimentary rock with persistent beds of red mudstone, interspersed with lenticular masses, up to 1.5 m thick, of unsorted lava fragments set in a matrix of greenish clay. Some fragments are scoriaceous with small irregular amygdales filled with chlorite or carbonate minerals. The matrix includes carbonate minerals but also contains some grains of quartz and feldspar."@en ;
    lexicon:hasLowerBoundaryDefinition "Seen only in the Endrick Water at [NS 6807 8742], where the Cringate Volcaniclastic Member overlies highly decomposed microporphyritic basalt, thought to be roughly equivalent to middle parts of the Spout of Ballochleam Lava Member (Francis et al., 1970)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3959 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 45 m"@en ;
    lexicon:hasUpperBoundaryDefinition "Seen only in a left-bank tributary of the Endrick Water at [NS 6858 8756], where about 40 m of tuff or volcaniclastic sedimentary rock is overlain by 6m of microporphyritic basalt that forms a waterfall (Francis et al., 1970). The basalt is probably one of the highest lavas of the Spout of Ballochleam Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cringate Interbasaltic Beds [Obsolete: use CRNV]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Tuff, volcaniclastic-mudstone and volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRNV"@en ;
    skos:prefLabel "Cringate Volcaniclastic Member"@en ;
.

