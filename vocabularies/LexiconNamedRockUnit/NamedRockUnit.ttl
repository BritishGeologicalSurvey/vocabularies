namedrockunit:HBEL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Packstones, wackestones and floatstones, with a variety of thick, thin, wavy, and nodular bedding, interbedded with subordinate grainstones, limestone lithoclasts, possible 'in situ' Waulsortian limestones and thin mudstones. Silicification and dolomitisation common, with slumps and gravity slides present locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Park Laithe Borehole (SD 9629 5813) showed an unconformable relationship with the underlying Clitheroe Limestone Formation (Thornton Limestone Member)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 130m"@en ;
    lexicon:hasUpperBoundaryDefinition "In the Eshton-Hetton Anticline, the Hetton Beck Limestone is overlain by various lithologies including wackstones, laminated calcisiltites, mudstones and boulder beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HOM ;
