    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:HWH ,
        namedrockunit:LC ;
    skos:notation "THAM"@en ;
    skos:prefLabel "Thames Group"@en ;
.

namedrockunit:THGR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Represents the deposits of the third terrace of the Kennet valley on BGS maps. Gravel, variably sandy and clayey."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp erosional base on Cretaceous-Tertiary bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:VLGR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "It comprises 3-4 m of gravel underlying the terrace surface at Thatcham."@en ;
    lexicon:hasUpperBoundaryDefinition "The terrace, which is modified by erosion, is about 8-10 m above the Kennet Floodplain."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Valley Gravel [Obsolete]"@en ;
