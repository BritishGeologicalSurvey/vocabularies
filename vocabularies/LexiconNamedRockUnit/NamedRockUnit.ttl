namedrockunit:BROBC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bituminous sandy siltstone with mudstone intercalations; five fining-upwards cycles have been recognised (Arkell, 1933; Sykes, 1975)."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Glauconitic Sandstone Member (GLCSA)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by a change up from the bituminous sandy siltstone with mudstone intercalations of the Brora Brick Clay Member (BROBC) to the coarse siltstone to silty fine-grained sandstone of the Fascally Siltstone Member (FCYSI) of the Clynekirkton Sandstone Formation (CYK). The boundary is conformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SSTV ;
    skos:definition "Siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BROBC"@en ;
    skos:prefLabel "Brora Brick Clay Member"@en ;
.

