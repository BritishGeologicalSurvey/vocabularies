namedrockunit:RSL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use RRAM] Purple slightly micaceous slates with crinoid debris and other fossil fragments (including bivalves, clymenids and rare trilobites and ostracods), green slates and black siliceous slates. A prominent horizon of calcareous laminated siltstone is present at the top of the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Not defined."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not defined."@en ;
    lexicon:hasUpperBoundaryDefinition "The Rora Slate is only known within the Liverton Unit (i.e. the thickness of rock that is bounded by the Bickington Thrust to the south, and the Silverbrook Thrust to the north). Conformable with the overlying Lower Culm cherts on the northern slopes of Ramshorn Down [SX 7924 7378]; elsewhere it is mostly faulted against the Culm Measures. Across the conformable contact, a transition would be seen from the slightly micaceous slates of varying colours of the Rora Slate (described in the lithology section) to the bedded siliceous rocks and slates with local interbedded pyroclastic rocks of the Mount Ararat Chert."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:RRAM ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Rora Mudstone Formation"@en ;
    skos:definition "Obsolete name. Slate with subsidiary calcareous siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RSL"@en ;
    skos:prefLabel "Rora Slate Formation [Obsolete: use RRAM]"@en ;
.

