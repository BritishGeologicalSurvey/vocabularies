namedrockunit:WGGV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BLV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Poorly sorted boulder and cobble gravel, matrix-rich, with poorly developed sub-horizontal stratification and thin interbeds of brown silt and red silty diamicton present in some exposures. Clasts are generally angular to subrounded and comprise locally derived igneous rocks from the Borrowdale Volcanic Group and metamorphic rocks. The gravel forms narrow kame terraces within the Bleng Valley area."@en ;
    lexicon:hasLowerBoundaryDefinition "Erosional contact on the Scale Beck Till Member or the Bark Butts Silt Member of the Blengdale Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0.9-1.4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but locally overlain by Holocene alluvium of the Ehen Alluvial Formation or peat of the Blelham Peat Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BLGL ;
    skos:definition "Gravel and gravelly cobbly boulders and trace diamicton and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WGGV"@en ;
    skos:prefLabel "Whin Garth Gravel Member"@en ;
.

