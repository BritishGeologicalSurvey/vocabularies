namedrockunit:CRMR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Dark grey mudstone, with laminae of pale siltstone and thin- to medium-bedded quartz arenite sandstone; contains distinctive laminae of manganiferous ironstone. \r
\r
The formation was deposited from low-concentration turbidity flows and as chemical precipitates into oxygenated bottom water conditions (Chadwick et al., 2001, p. 28-29). \r
\r
The mid Arenig pseudoornatum acritarch Biozone is indicated from samples obtained from near the base of the formation. However, samples from Creggan Moar have yielded taxa tentatively taken as indicative of the late Arenig hamata-rarirrugulata Biozone (Chadwick et al., 2001)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Creggan Moar Mudstone Formation is conformable on the Glen Rushen Mudstone Formation, with the base taken at the incoming of sandstone and manganiferous beds."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GLMC ,
        namedrockunit:H2687 ,
        namedrockunit:H3975 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Not proved as the formation is faulted against the Niarbyl Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glion Cam Formation [Obsolete: use CRMR, GLDH]"@en ,
        "Manx Slate Series [Obsolete: use NBY, CRMR, DALBY, MANX]"@en ,
        "Maughold Banded Group [Obsolete: use MGD, CGA, CRMR, MHL]"@en ;
    skos:broader namedrockunit:MANX ;
    skos:definition "Mudstone with subsidiary ironstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRMR"@en ;
    skos:prefLabel "Creggan Moar Mudstone Formation"@en ;
.

namedrockunit:CRMS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Sandstone, white, cross bedded, with pebbly bands (beds) in places. Locally, interbedded with mudstone and rare intercalations of volcanic detritus. Strata within the member were described by Tait (1973) as fine-grained, buffweathering quartz arenite with conglomerate lenses that consist mainly of mudstone intraclasts. \r
\r
Tait (1973) interpreted the sandstone member as the deposits of a meandering river system. \r
\r
Visean (?Asbian-Brigantian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the Craigmaddie Muir Sandstone Member is mapped on Craigmaddie Muir [NS 5820 7652] and Muirhouse Muir [NS 5723 7785] and placed where sandstones without interbeds of conglomerate are observed at outcrop (BGS, 1987b; see also BGS, 1987c). The underlying Douglas Muir Quartz-Conglomerate Member is typically conglomerate with sandstone interbeds and, toward the top of the member, sandstone with pebbles or conglomerate beds. The lower boundary of the Craigmaddie Muir Sandstone Member had previously been mapped slightly lower in the sequence by Tait (1973) who noted it to be gradational containing 'lenses of conglomerate of similar composition' to the underlying Douglas Muir Quartz-Conglomerate Member near the base."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1459 ,
        namedrockunit:H3957 ,
        namedrockunit:H4569 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 170 and 180 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Craigmaddie Muir Sandstone is placed at the base of the Balmore Marine Band (Hall et al., 1998, fig. 9). This is at a higher position than that of Clough et al. (1925, fig. 2) who placed it at the top of the main sequence of sandstones about 45 m below the Craigenglen Beds, but at a lower position than Tait (1973) who placed the boundary beneath the Balgrochan Beds. Tait's (1973) informal division 'lower Craigmaddie Muir Sandstone Member' equates with the Craigmaddie Muir Sandstone Member as presented here."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Craigmaddie Muir Sandstones [Obsolete: use CRMS]"@en ,
        "Craigmaddie Sandstone Formation [Obsolete: use CRMS]"@en ,
        "Craigmaddie Sandstones [Obsolete: use CRMS]"@en ;
    skos:broader namedrockunit:LWM ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRMS"@en ;
    skos:prefLabel "Craigmaddie Muir Sandstone Member"@en ;
.

namedrockunit:CRNE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
