namedrockunit:REL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive or irregularly bedded skeletal limestones (packstones and grainstones), commonly sandy, with abundant chert nodules. The formation comprises a series of shoaling upwards cycles capped by palaeokarstic surfaces commonly overlain by beds of sandstone infilling karstic pipes, or by channel-filling sequences of conglomerate, sandstone and silty mudstone. The Red Wharf Limestone Formation records late Brigantian, mixed carbonate-siliciclastic shallow marine deposition at a time of increased supply of siliciclastic detritus to the North Wales Dinantian platform. Each cycle represents a shoaling upwards sequence formed in response to transgressive and regressive movements in sea level.  Many regressions culminated in emergence of the platform surface and the formation of karstic dissolution feartures and of channels that were filled by fluvial conglomerates and sandstone and estuarine mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed, but assumed to be a contact between massive sandy limestones with abundant chert nodules and lithologically more varied limestone sequence of the underlying Cefn Mawr Limestone Formation.  The contact is likely to be taken at a palaeokarstic surface developed at the top of the uppermost Cefn Mawr Limestone cycle."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DWIC ,
        namedrockunit:H1787 ,
        namedrockunit:H2392 ,
        namedrockunit:SUL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.55m"@en ;
    lexicon:hasUpperBoundaryDefinition "In its type section, the Red Wharf Limestone Formation is overlain by a 6m-thick unit of bedded cherts, which was previously included in the Formation as the Castell Mawr Chert Member, but which may now be viewed as a local representive of the Pentre Chert Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dinorwic Formation [Obsolete: use REL]"@en ,
        "Red Wharf Cherty Limestone [Obsolete: use REL]"@en ,
        "Red Wharf Limestone [Obsolete: use REL]"@en ,
        "Summit Limestone Formation [Obsolete: use REL]"@en ;
    skos:broader namedrockunit:CLWYD ;
    skos:definition "Chert and limestone with subsidiary conglomerate, mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "REL"@en ;
    skos:prefLabel "Red Wharf Limestone Formation"@en ;
.

namedrockunit:RESID
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/L"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typical deposits include the Clay-with-flints Formation of southern Britain and the Buchan Gravels Formation of north-eastern Scotland. Clay-with-flints lithologies include reddish brown clay with large unworn flint cobbles, yellow fine-to-medium-grained sand, reddish brown clayey silt and sandy clay. Buchan Gravels lithologies include well-rounded gravel and cobbles of quartzite and flint with sand, silt and kaolinitic clay."@en ;
    lexicon:hasLowerBoundaryDefinition "Irregular and unconformable contact with bedrock of Neogene age or older. In the case of Clay-with-flints, dissolution of underlying chalk has resulted in local development of pipes and hollows that are infilled with the residual deposits."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Clay-with-flints Formation: 2 - 10 m; Buchan Gravels Formation: greate than 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or overlain unconformably by Quaternary deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QC> ;
    lexicon:hasYoungestAgeValue 4.8e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GBG ;
    skos:definition "Clay, cobbles, gravel and sand with subsidiary silt. Stratified superficial deposits. Occurs onshore. Formed during the Paleogene Period - to - Cromerian Stage (Quaternary Period) (66-.48 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BUG ,
        namedrockunit:CHGR ,
        namedrockunit:CWF ,
        namedrockunit:LNM ;
    skos:notation "RESID"@en ;
    skos:prefLabel "Residual Deposits Group"@en ;
.

namedrockunit:RGTB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent namedrockunit:S328 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member is a heterogeneous succession of coarse-grained pebbly sands, very glauconitic clayey pebbly sands, glauconitic pebbly and sandy clays, calcareously cemented pebble beds and coarse-grained pebbly sands with many polished limonite pebbles."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the top of the Hythe Formation and is marked by the incoming of pebbles (including pebbles of polished limonite), usually set in a slightly clayey, glauconitic sandy matrix."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4297 ,
        namedrockunit:H492 ,
        namedrockunit:S328 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4 to 46m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable at the base of the Pulborough Sandrock Member, marked by the top of a glauconitic pebbly sandy clay where present and elsewhere at the change from pebbly sands to the fine-grained, well-sorted Pulborough Sandrock Member (but note scattered coarse grains occur in the basal metre or so of the Sandrock)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Rogate Beds [Obsolete: use RGTB]"@en ,
        "Sandgate Beds (Undifferentiated) [Obsolete: use RGTB]"@en ,
        "Selham Ironshot Sands [Obsolete: use SIS, RGTB]"@en ;
    skos:broader namedrockunit:SAB ;
    skos:definition "Pebbly (gravelly) sandstone and sand with subsidiary clay, conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RGTB"@en ;
    skos:prefLabel "Rogate Member"@en ;
.

