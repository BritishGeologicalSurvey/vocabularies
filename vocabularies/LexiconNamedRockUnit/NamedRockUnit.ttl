namedrockunit:TRR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, calcilutite, pale grey, bioturbated, silici-muddy, poorly fossiliferous; passing up into whitish grey, less silici-muddy calcilutite. Lenses of ooidal limestone occur in places, at the base (Hen's Cliff Oolite of Arkell and Donovan, 1952) and in the upper part. Subordinate calcareous mudstone beds occur in places. Passes laterally by interdigitation southwards into the predominantly mudstone sequence of the Fuller's Earth Formation, and by increase in ooid content northeastwards into the Athelstan Oolite Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp change up from grey mainly calcareous mudstone of the Fuller's Earth Formation (locally known as theHawkesbury Clay) or, where absent, erosive non-sequence, with a sharp upward change from bioclastic limestone of the Dodington Ash Rock Member (Fuller's Earth Formation) into fine-grained limestone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4937 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to about 17 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Rapid passage up from calcilutite with ooidal limestone lenses into massive ooid-limestones of the Athelstan Oolite Formation or, locally, where that formation is absent, well-bedded ooid-limestone of the Chalfield Oolite Formation, or in the south, a sharp upward change into grey mudstone of the Lansdown Clay (Fuller's Earth Formation), locally (seen in Biddestone borehole) a non-sequence with a hardground."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tresham Rock [Obsolete: use TRR]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Limestone and ooid-limestone with subsidiary calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TRR"@en ;
    skos:prefLabel "Tresham Rock Formation"@en ;
.

