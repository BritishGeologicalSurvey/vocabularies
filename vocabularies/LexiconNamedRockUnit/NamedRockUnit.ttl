    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BEL"@en ;
    skos:prefLabel "Bembridge Limestone Formation"@en ;
.

namedrockunit:BELA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olivine-microphyric basalts (Dalmeny type). Red boles are common between flows and interbedded chocolate-coloured marls are present. Large parts of the flows are extensively altered and decomposed. South of Roebank Glen [2353 6554] a flow of plagioclase-macrophyric basalt (Markle type) outcrops within the member."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the Markle- and Dunsapie-type basalts of the Fereneze Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3840 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 90 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by volcaniclastic sedimentary rocks of the Kirkwood Formation wherever the top of the member crops out."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
