namedrockunit:PB
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PLPB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/NCSLTR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded mudstones, limestones and evaporites of marginal freshwater, brackish and marine origin; detrital quartz occurs in parts. The group (Purbeck Beds), was traditionally divided into Lower, Middle and Upper units (\"beds\") with a key marker, the Cinder Bed placed within the middle part of the Middle Purbeck Beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the first occurrence of finely laminated, ostracod-rich limestones above the more massive, shelly limestones of the Portland Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1114 ,
        namedrockunit:H1115 ,
        namedrockunit:H2229 ,
        namedrockunit:H4243 ,
        namedrockunit:H441 ,
        namedrockunit:H4830 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "45 to 120 m in south Dorset. 77 to 186 m in the Weald. Succession incomplete in the Vale of Wardour."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the last occurrence of significant limestone before monotonous Wealdon Group sandy mudstones. Highest limestone is rich in Viviparus and Unio."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Portland Group and Purbeck Limestone Group (Undifferentiated)"@en ,
        "Purbeck Beds [Obsolete: use PB]"@en ,
        "Purbeck Formation [Obsolete: use PB]"@en ,
        "Purbeck Limestone Formation [Obsolete: use PB, HADD]"@en ,
        "Purbeck Stone [Obsolete: use PB]"@en ,
        "Purbeck Strata [Obsolete: use PB]"@en ,
        "Purbeck [Obsolete: use PB]"@en ;
    skos:definition "Limestone and mudstone with subsidiary gypsum-stone and non-carbonate salt-rock. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Tithonian Age (Jurassic Period) - to - Berriasian Age (Cretaceous Period) (149.2-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
