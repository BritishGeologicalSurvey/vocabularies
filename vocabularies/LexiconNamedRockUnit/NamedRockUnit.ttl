namedrockunit:CWFL
    a skos:Concept ;
    lexicon:hasLithologyDescription "Clay-with-flints is a reddish brown, stiff, clay containing abundant clasts of orange-brown stained nodular and broken flints, commonly associated with deposits of sand, sandy clay, silt, loam and pebbles that have been mixed with the clay by solution, cryoturbation and solifluction. Clay-with-flints as applied by BGS is a product of the solution of the chalk and the incorporation of residual material from Palaeogene deposits, mainly the Reading Formation. It occurs mainly in southern England resting on, and in places filling, solution pipes in the chalk."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CWF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Clay-with-flints Formation"@en ;
    skos:broader namedrockunit:RDEPS ;
    skos:definition "Superficial deposits. Occurs onshore. Formed during the Paleogene Period - to - Pleistocene Epoch (Quaternary Period) (66-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CWFL"@en ;
    skos:prefLabel "Clay-with-flints"@en ;
.

