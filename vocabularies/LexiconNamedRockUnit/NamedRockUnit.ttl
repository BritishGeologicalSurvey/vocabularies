namedrockunit:CGCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk), with common Inoceramus fragments (up to 20%) and many small burrow-fill flints scattered throughout. The upper part contains several horizons of green-coated pebbles that coalesce towards the basin margins to form a single conspicuous hardground with rolled and mineralized fossils, most notably belemnites and echinoid steinkerns. Glauconitic in its marginal overlap facies, where the uppermost beds/surfaces are attenuated, gritty, glauconitic and algal-topped (stromatolitic)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the point in the succession where there is a sudden increase in Inoceramus fragments. At Creggan this occurs 0.23m above the Oweynamuck Flint Band within the top of the Cloghastucan Chalk Formation. The formation oversteps older beds and is itself overstepped by younger beds over structural highs."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2688 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3.45m at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the highest of several green-coated chalk pebble beds within the Inoceramus-rich limestone. This unit is termed the Bendoo Pebble Bed (of ?member status) in the North Antrim Basin. Overlain by the Boheeshane Chalk Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Creggan Chalk Member [Obsolete: use CGCK]"@en ;
    skos:broader namedrockunit:UWLF ;
    skos:definition "Chalk with subsidiary flint and limestone. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CGCK"@en ;
    skos:prefLabel "Creggan Chalk Formation"@en ;
.

namedrockunit:CGD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greywackes (beds dominantly less than 0.5 metres thick) with interbedded mudstones including some red mudstone beds. Includes few thicker massive arenite beds to east. Distinguished from 'underlying' Kirkmaiden Formation by presence of red mudstone beds. Distinguished from overlying Riccarton Group by presence of red mudstone beds and absence of dark grey finely laminated siltstone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "'Lower' (i.e. Northern boundary) - gradational from Kirkmaiden Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3920 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c 4000 metres section of vertical strata but some folding and locally intense faulting renders accurate assessment of stratigraphical thickness impossible."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper - faulted contact with Riccarton Group at Burrow Head (NX 4528 3414)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carghidown Beds [Obsolete: use CGD]"@en ;
    skos:broader namedrockunit:HWK ;
    skos:definition "Mudstone and wacke. Stratified bedrock. Occurs onshore. Deposited during the Llandovery Epoch (Silurian Period) (443.1-432.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CGD"@en ;
    skos:prefLabel "Carghidown Formation"@en ;
.

