        namedrockunit:TCAF ,
        namedrockunit:TCAM ,
        namedrockunit:TCAR ,
        namedrockunit:TCAS ,
        namedrockunit:TCCW ,
        namedrockunit:TCLU ;
    skos:notation "TCA"@en ;
    skos:prefLabel "Applecross Formation"@en ;
