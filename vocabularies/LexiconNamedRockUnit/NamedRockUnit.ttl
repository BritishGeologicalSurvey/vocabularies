namedrockunit:COOK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically, dominantly grey siltstones and silty mudstones with streaks of very fine-grained and well sorted sandstones at some levels, calcite cemented locally. Occasional thin beds of very fine- to coarse-grained, argillaceous, micaceous and chloritic sandstone occur locally (e.g. Well 3/4-8)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is typically defined by a downward change from siltstone (Cook Formation) to mudstone (Burton Formation) and a distinct down-section increase in gamma values and decrease in velocity. However, locally, where the Cook Formation is less silty or where the Burton Formation is more sandy, log signatures in the boundary interval are not clear."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5175 ,
        namedrockunit:H5182 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 80 m, but may be absent on structural highs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a downward change from mudstones (Drake Formation) to siltstones with subordinate sandstones (Cook Formation) and a down-section decrease in gamma values and, generally, an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cook Sub-Unit [Obsolete: use COOK]"@en ,
        "Dunlin Siltstone Member [Obsolete: use AMND, BURT, COOK]"@en ;
    skos:broader namedrockunit:DUNL ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Pliensbachian Age - to - Toarcian Age (Jurassic Period) (192.9-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COOK"@en ;
    skos:prefLabel "Cook Formation"@en ;
