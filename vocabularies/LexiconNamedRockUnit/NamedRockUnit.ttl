namedrockunit:POHY
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALTF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALVPW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly tuffs, with fragments of glassy and devitirified olivine basalt and also accretionary lapilli. The tuffs are interspersed with thin amygdaloidal basalt flows and pillowed basalts. Interflow sediments are sporadically present as typically plant-bearing volcaniclastic sandstones and siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "This is the earliest of the Paleocene volcanic formations and is typically unconformable on the underlying Jurassic strata. Plant-bearing beds are also common at this juncture."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2981 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Beinn Edra Formation in northeastern Skye and by the slightly younger Ramasaig Formation farther west."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Palagonitic Tuffs and Plant Beds [Obsolete: use POHY]"@en ;
    skos:broader namedrockunit:SKYL ;
    skos:definition "Basaltic lapilli-tuff, basaltic tuff, hyaloclastite, lava, pillowed basalt lava, sedimentary rock based on grain size or crystal size and tuff with subsidiary volcaniclastic-sandstone, volcaniclastic-sedimentary-rock and volcaniclastic-siltstone. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "POHY"@en ;
    skos:prefLabel "Portree Hyaloclastite Formation"@en ;
.

