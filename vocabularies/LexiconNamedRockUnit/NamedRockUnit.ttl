namedrockunit:KHBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A coarse-grained, poorly sorted, limestone breccia, mostly derived from local Carboniferous Limestone, with minor sandstone. The Kelhead Breccia is considered to be a local representative of the Brockram within the Annan sub-basin of the Carlisle Basin. Although Holliday et al. (2001) included thin (<4m) basal breccias of the Annan sub-basin within the Eden Shales Formation, it is recommended that the significantly thicker and lithologically distinctive Kelhead Breccia be assigned as a member of the Brockram."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on strata of the Tyne Limestone Formation of Carboniferous age, or Early Palaeozoic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BK ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "15 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Locally unconformably overlain by strata of the Eden Shales Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Brockram"@en ;
    skos:broader namedrockunit:BK ;
    skos:definition "Limestone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KHBR"@en ;
    skos:prefLabel "Kelhead Breccia Member"@en ;
.

