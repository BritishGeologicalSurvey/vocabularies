namedrockunit:WRMS
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S974 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine to fine-grained, locally clayey, sands. Pebble beds composed of well rounded black flints occur at least at two levels."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary is taken at the base of a prominent scarp developed on the underlying clays of the West Park Farm Member. The contact is commonly marked by powerful springs. The contact is at the base of erosional channel sands cutting into the underlying West Park Farm Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-6m but up to 15m known."@en ;
    lexicon:hasUpperBoundaryDefinition "An upward change from sand to silty and sandy bioturbated, olive-grey clay, interbedded with clayey fine to very fine-grained silty sand (considered as the Tilehurst Member, King, in press)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
