namedrockunit:CBM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly interbedded grey and green grey peloidal and bioclastic micrites, wackestones and packstones, and cryptalgal laminites. Dolomitisation is locally common; on the southeast and east crop of the South Wales Coalfield and in the Chepstow area, the formation is predominantly dolomitised."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is taken at the sharp erosional contact between the mudstone/clay palaeosol at the top of the Gully Oolite Formation and the overlying thinly bedded calcite mudstones and mudstones of the formation. A conglomeratic lag is locally present at the base of the Caswell Bay Mudstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "15m on the south crop of the South Wales Coalfield, thinning southwards to a feather edge in the central Vale of Glamorgan, southwest Gower and southwest Pembrokeshire."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is taken at the sharp erosional contact between the thinly bedded calcite mudstones and mudstones of the formation and the overlying coarse peloidal and skeletal packstones/grainstones forming the lower part of the overlying High Tor Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Calcite-mudstone and mudstone with subsidiary dolomite-mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBM"@en ;
    skos:prefLabel "Caswell Bay Mudstone Formation"@en ;
.

