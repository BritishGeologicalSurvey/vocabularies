    lexicon:hasThicknessDescription "Up to 230 m thick in the Radstock Syncline and 275 m thick in the Coalpit Heath Syncline."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the grey mottled mudstone of the Barren Red Member is overlain by the base of the Nine-Inch Vein Coal of the grey mudstone-dominated Radstock Member in the Somerset Coalfield."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
