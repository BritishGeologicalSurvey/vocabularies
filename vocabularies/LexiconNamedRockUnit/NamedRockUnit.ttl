    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum proved thickness of c.10 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Placed at junction of red till and overlying grey to yellow-brown stony clay solifluction/gelifluction deposits of Colwall Gelifluctate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
