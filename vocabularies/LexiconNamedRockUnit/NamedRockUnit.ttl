namedrockunit:AHM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Intertidal and tidal-flat facies with halite pseudomorphs within sandstones, siltstones and mudstones comprise the majority of the succession. Bimodal palaeocurrents, symmetrical ripples, flaser and wavy bedforms are common. Trace fossils are also commonly found."@en ;
    lexicon:hasLowerBoundaryDefinition "Iron stained-sandstones at the top of the Lag a Bheith Formation, are overlain abruptly by the Auchenhew Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:AHB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
