namedrockunit:HDST
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:SCY ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation is dominantly composed of mudstones, with interbedded siltstone and sandstone beds. Mudstones are variegated, grey-green, purple, red or yellow-brown and poorly calcareous to non-calcareous. Sandstones are poorly cemented, fine- to coarse-grained and grey-brown. Carbonaceous material is common in some beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is marked by a downward change from dominantly mudstones to dominantly sandstones (Strangways Formation). The boundary coincides with a sharp down-section decrease in gamma-ray values and increase in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Very variable in thickness depending on the structural setting of the well section studied."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is usually characterised by a downward change from limestone (at the base of the Leckenby Formation, equivalent to the Cornbrash onshore) to mudstone dominated sediments. It usually coincides with the base of a low gamma/high velocity spike. Below the spike the wireline logs show consistently high gamma values and low velocity, characteristic of the Hudleston Formation. Locally, where the limestone is absent, the upper boundary is placed at a downward change from sandstone to variegated mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Scalby Formation"@en ;
    skos:broader namedrockunit:WSTS ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HDST"@en ;
    skos:prefLabel "Hudleston Formation"@en ;
.

