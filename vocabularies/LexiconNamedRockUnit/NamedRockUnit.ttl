    lexicon:hasThicknessDescription "c.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Upward change fron a dominantly marly sequence to micritic limestones of the \"Middle Purbeck\"."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
