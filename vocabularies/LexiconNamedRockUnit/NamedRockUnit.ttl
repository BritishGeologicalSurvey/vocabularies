    lexicon:hasThicknessDescription "0 to 5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable contact between coralliferous limestone of the knoll-reef and overlying mudstones of the Kirton Cementstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:LLL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
