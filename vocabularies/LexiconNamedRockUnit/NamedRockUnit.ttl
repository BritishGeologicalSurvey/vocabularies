        "Permian sandstone [Obsolete: use CS]"@en ;
    skos:broader namedrockunit:APY ;
    skos:definition "Sand and sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CS"@en ;
    skos:prefLabel "Collyhurst Sandstone Formation"@en ;
