namedrockunit:LSYS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PHNOD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower Spilsby Sandstone Member. Coarse-grained, pebbly, glauconitic sands and sandstones with calcareous 'doggers' and occasional phosphatic nodules towards the top, this unit equates with the lower part of Swinnerton's (1937) 'Glauconitic Sands'. The base of the member comprises thin grey sandstone with phosphatic nodules (the Basement Beds of Swinnerton, 1937, and Beds A and D of Swinnerton, 1935)."@en ;
    lexicon:hasLowerBoundaryDefinition "A down-section change from grey sandstone with phosphatic nodules (the 'Basement Beds' of the lower Spilsby Sandstone Member) to mudstone (Kimmeridge Clay)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4171 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "The top is taken where coarse-grained, pebbly, glauconitic sands and sandstones with calcareous \"doggers\" and sporadic phosphatic nodules towards the top (Lower Spilsby Sandstone) are overlain by medium-grained, buff and green sands with sparse calcareous \"doggers\" and a basal bed of phosphatic nodules and small (generally chert) pebbles of the Upper Spilsby Sandstone. An erosion surface separates the two units."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Spilsby Sandstone [Obsolete: use LSYS]"@en ;
    skos:broader namedrockunit:SYS ;
    skos:definition "Sandstone and trace nodular phosphorite. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LSYS"@en ;
    skos:prefLabel "Lower Spilsby Sandstone Member"@en ;
.

namedrockunit:LT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "At the type locality the member is dominated by a volcanic breccia (agglomerate) with clasts, including some limestone, up to 13 cm diameter (Stevenson and Gaunt, 1971). In the Longstone Edge boreholes (e.g. SK 2144 7367) the member comprises one to three leaves of grey and green banded tuff with some limestone grains. The thickest development in these boreholes is associated with a well-sorted tuff, with coarser bands of fine lapilli (Aitkenhead et al., 1985). In the Eyam Borehole the member is a 1.1 m thick, fine-grained, grey-green, pyritic tuff (Dunham, 1973)."@en ;
    lexicon:hasLowerBoundaryDefinition "The tuff at the base of the member is underlain by dark to medium grey limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3541 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Maximum thickness of in excess of 30 m to the north-east of Litton."@en ;
    lexicon:hasUpperBoundaryDefinition "The tuff at the top of the member is overlain by dark grey cherty limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Litton Tuff [Obsolete: use LT]"@en ;
    skos:broader namedrockunit:MO ;
    skos:definition "Tuff with subsidiary agglomerate. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LT"@en ;
    skos:prefLabel "Litton Tuff Member"@en ;
.

