namedrockunit:KNIUC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin, impersistent but highly correlateable coal in the Glasgow-Stirling region. This coal is the highest of three in between the Black Metals to Knightswood Gas Coal and is often associated with thick Lingula beds, often washed out."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies \"cyclothems\" between Black Metals and Knott Rider Coal within the Limestone Coal Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.1m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Knightswood Gas Coal within the Limestone Coal Formation. Up to 8m of Lingula-rich, fissile mudstone is often present between these beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LSC ;
    skos:definition "Coal. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
