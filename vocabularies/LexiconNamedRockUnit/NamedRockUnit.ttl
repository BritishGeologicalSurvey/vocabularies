namedrockunit:PASA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly bedded, pale to medium grey-brown, fine- to medium-grained, quartzose, variably dolomitic and moderately sorted sandstones. Interbedded dark grey mudstones present. Wire-line log responses are erratic."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is defined by a down-section change from sandstone with interbedded mudstone to dominantly mudstone (Kimmeridge Clay Formation). There is a change from the erratic wireline log responses to a more uniform response."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to c. 150 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by a down-section change from mudstone (Kimmeridge Clay Formation) to sandstone with interbedded mudstone. The boundary is marked by a down-section decrease in gamma-ray values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasYoungestAgeValue 1.492e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KC ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Kimmeridgian Age (Jurassic Period) (154.8-149.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PASA"@en ;
    skos:prefLabel "Ptarmigan Sandstone Member"@en ;
