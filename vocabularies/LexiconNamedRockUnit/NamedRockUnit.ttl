        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use TCH] \r
\r
Black glassy chert with thin shale interbeds. Elsewhere the chert beds include thin to thick pale grey siltstone laminae. Black siliceous slaty mudstone structurally below the chert contains rare limestone lenses."""@en ;
    lexicon:hasLowerBoundaryDefinition "Faulted out."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2953 ,
        namedrockunit:H77 ;
