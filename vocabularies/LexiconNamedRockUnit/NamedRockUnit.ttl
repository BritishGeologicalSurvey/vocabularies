namedrockunit:CAE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Rhyolitic tuff intercalated with flow-banded rhyolite and some thin flows of pale pink, porphyritic dacite or rhyolite."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: where pyroxene andesites, olivine basalts and locally basic tuff and breccia of the Allermuir Volcanic Member are overlain by rhyolitic tuff and flow banded rhyolite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3266 ,
        namedrockunit:H4513 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasOldestAgeValue 4.227e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 300m on Castlelaw Hill"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable: where rhyolitic tuff and flow-banded rhyolite are overlain by Woodhouselee Volcanic Member: pale lilac or pink trachytes and andesites with phenocrysts of biotite and alkali feldspar. Boundary not always distinct; some interbedding of the two members takes place."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Caerketton Group [Obsolete: use CAE]"@en ,
        "Caerketton Volcanic Group [Obsolete: use CAE]"@en ;
