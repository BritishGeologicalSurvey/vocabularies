    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription " c. 250 m (post-deformational thickness)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unknown: cut by Torrisdale thrust."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Druim Chuibhe Psammite Formation [Obsolete: use KLPS]"@en ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Migmatitic micaceous psammite and migmatitic psammite and trace gneissose semipelite and migmatitic pelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KLPS"@en ;
    skos:prefLabel "Klibreck Psammite Formation"@en ;
