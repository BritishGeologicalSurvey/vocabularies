namedrockunit:HUN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Poorly-sorted matrix-supported conglomerate and very coarse-grained pebbly sandstone; there is a large proportion of locally-derived subrounded to angular clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Carboniferous rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2249 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0-15m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, where sandstone or conglomerate with many locally-derived clasts give way to conglomerate or sandstone with few such clasts (Hawksmoor Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cheadle Breccias [Obsolete: use HUN]"@en ;
    skos:broader namedrockunit:SSG ;
    skos:definition "Conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Guadalupian Epoch (Permian Period) - to - Early Triassic Epoch (Triassic Period) (274.4-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HUN"@en ;
    skos:prefLabel "Huntley Formation"@en ;
.

namedrockunit:HUNT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Well sorted, red-brown, medium- to coarse-grained pebbly sandstones and quartz pebble conglomerates with some mudstone interbeds. The pebbles are predominantly of vein quartz, with rare quartzite, jasper and silicified igneous rocks. Bedding traces are rare, but conglomerate units can be locally seen to be cross-bedded and to fill shallow channels (Allen, 1971)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at the base of lowest quartz pebble conglomerate, at the sharp, disconformable (or unconformable) junction with underlying red-brown sandstones of the Brownstones Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:QC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the top of the highest quartz pebble conglomerate bed, where it is overlain by pale yellow and green sandstones of the Tintern Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Quartz Conglomerate Formation (Forest of Dean) [Obsolete: use HUNT]"@en ;
    skos:broader namedrockunit:POB ;
    skos:definition "Conglomerate and pebbly (gravelly) sand with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HUNT"@en ;
    skos:prefLabel "Huntsham Hill Conglomerate Formation"@en ;
.

