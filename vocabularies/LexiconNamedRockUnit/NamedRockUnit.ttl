namedrockunit:CSCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CH"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use CLOCL] \r
\r
Silty clay with sparse well rounded, high sphericity pebbles of psammite and quartzite, containing in situ high-boreal shells/microfauna."""@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with Drummore Gravel below."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4.9 at type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, generally marked by colour change, olive-grey to pale yellowish-brown (Clava Sand Member) above."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CLOCL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Clava Lodge Clay Member"@en ;
    skos:definition "Obsolete name. Clay with subsidiary shelly clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CSCL"@en ;
    skos:prefLabel "Clava Shelly Clay Member [Obsolete: use CLOCL]"@en ;
.

