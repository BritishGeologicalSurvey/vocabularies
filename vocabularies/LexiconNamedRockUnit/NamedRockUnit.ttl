namedrockunit:CLY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red cross-laminated, micaecous fine-grained sandstone. Grains mostly of subrounded quartz, a significant minority of grains with a high degree of sphericity are probably of aeolian origin. Locally, at Bennane Lea [NX 091 858], the sandstone is pebbly and referred to the Bennane Lea Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Stratigraphical boundary with the underlying Park End Breccia Formation is concealed but inferred to be conformable. At Bennane Lea the base of the Formation is unconformable and oversteps onto Early Ordovician igneous rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The minimum preserved thickness of the Formation exceeds 500m, as exposed along the coast between Ballantrae and Bennane Lea."@en ;
    lexicon:hasUpperBoundaryDefinition "The extent of the Corseclays Formation is delimited by erosion and the upper boundary of the Formation is not seen. It is not known if younger Permian or Triassic strata overlie the Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:BNL ;
    skos:notation "CLY"@en ;
    skos:prefLabel "Corseclays Sandstone Formation"@en ;
.

