    lexicon:hasLithologyDescription "Semipelite and pelite, the pelitic lithologies graphitic in lower part and calcareous in upper part, with pebbly quartzite developed in part of succession over wide areas; volcaniclastic formation locally present at top of subgroup."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt transition from quartzite to graphitic pelite (Jura, Easdale) or mixed semipelite, pelite and psammite (Perthshire)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 3km"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of Farragon Volcanic Formation in Perthshire; base of Crinan Grit or Upper Erins Quartzite in Argyll."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
