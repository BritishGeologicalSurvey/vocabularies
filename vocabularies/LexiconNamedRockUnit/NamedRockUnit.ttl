    lexicon:hasThicknessDescription "Up to about 1500m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "At base of Kinnesswood Formation (incoming of common pedogenic carbonate); boundary normally transitional, locally unconformable in west of Midland Valley, marking base of Inverclyde Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
