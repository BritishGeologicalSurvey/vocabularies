        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A medium to thickly bedded, brownish grey, medium- to coarse-grained, sandstone and pebbly sandstone, which is massive to cross-bedded; beds of siltstone occur throughout and coals are locally developed.The unit is interpreted as a delta top sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp upward change in a conformable succession from predominantly grey mudstone to sandstone - base of first pebbly sandstone bed above the Pendle Grit Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:ALMG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "40 to 165 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upward change in a conformable succession from sandstone to predominantly mudstone - top of last coarse or pebbly sandstone below the synsedimentary slumped siltstones and sandstones of the Roeburndale Member and the Cravenoceras cowlingense Marine Band."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Almscliff Grit [Obsolete: use WWG]"@en ,
        "Brennand Grit"@en ,
        "Grassington Grit [Obsolete: use PENDL]"@en ,
        "Upper Howgate Edge Grit"@en ;
    skos:broader namedrockunit:PENDL ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone and siltstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WWG"@en ;
    skos:prefLabel "Warley Wise Grit"@en ;
