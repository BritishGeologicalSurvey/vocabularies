namedrockunit:TGW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower part comprises thin- to thick-bedded skeletal, peloidal, ooidal and sandy grainstones and packstones with subordinate grey mudstones, calcite mudstones, calcretes and ironstones. Upper part comprises thin- to medium-bedded skeletal packstones and grey mudstones. The lower part represents deposition in ooidal shoal, embayment and peritidal environments. The upper part represents deposition on a storm-influenced, open marine, nearshore shelf."@en ;
    lexicon:hasLowerBoundaryDefinition "A thin unit [3 to 4m] of red, sparsely shelly, calcareous sandstones, sandy limestones, and mudstones with calcrete caps the red fluvial sandstones of the underlying Quartz Conglomerate Group. The sharp base of the Tongwynlais Formation is taken at the top of this thin unit at the incoming of restricted marine or peritidal, green or grey mudstones, micrites, calcisiltites and skeletal packstones/grainstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 50m in the south of the Vale of Glamorgan, thinning northwards to a feather edge in the Risca area on the east crop of the South Wales Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "Interbedded thin- to medium-bedded grey skeletal packstones and mudstones forming the upper part of the Tongwynlais Formation thicken upwards and pass up quickly, but gradationally, into the medium- to thick-bedded ooidal and skeletal grainstones of the Castell Coch Limestone Formation. The top of the Tongwynlais Formation is taken at the top of the last mudstone bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:AVO ;
    skos:definition "Limestone with subsidiary mudstone and trace calcrete and ironstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TGW"@en ;
    skos:prefLabel "Tongwynlais Formation"@en ;
.

