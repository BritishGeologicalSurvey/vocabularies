namedrockunit:GEIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alkali olivine-basalt intercalated with sedimentary rocks. A basal reddish-brown conglomeratic sandstone, with clasts up to about cobble size, and red to reddish-brown fine-grained sandstone is overlain by a sequence of basalt lavas [Pringle and Bailey, 1944]. Each lave flow is less than 2m thick [Upton et al., 1987] and amygdaloidal; some flows have slaggy tops. Reddish sandstone is present as isolated lenses. Sandstone, calcareous sandstone and sandy limestone may overlie and infill fissures within the lavas [Pringle and Bailey, 1944]. The thicker lava flows occur towards the base of the succession, average flow thickness decreases upwards with increasing amount of sedimentary intercalations.  The basalts are sparsely microphyric with phenocrysts mostly of olivine, plagioclase and augite [Upton et al., 1987]."@en ;
    lexicon:hasLowerBoundaryDefinition "Conglomeratic sandstone at the base of the Formation, approximately 7m thick [Pringle and Bailey, 1944], is inferred to overlie Dalradian rocks unconformably [Upton et al., 1987]."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H279 ,
        namedrockunit:H3425 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">120m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlying rocks no longer preserved."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carboniferous Lavas [Obsolete: use GEIL]"@en ,
        "Lower Old Red Sandstone Lavas [Obsolete: use PDH, GEIL]"@en ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Basalt with subsidiary pebbly (gravelly) sandstone and trace limestone and sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GEIL"@en ;
    skos:prefLabel "Glas Eilean Lava Formation"@en ;
.

namedrockunit:GES
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominant semipelite, but with considerable psammite and pelite. Psammites micaceous but fairly massive, rarely gritty. Greenish feldspathic semipelite with high magnetic susceptibility and associated micaceous psammites locally abundant near the base of the Formation. Beds of white quartzite with specks of green mica occur, particularly near the top of the Formation. Calc-silicate rocks are extremely rare."@en ;
    lexicon:hasLowerBoundaryDefinition "First incoming of dark, greenish, biotitic and feldspathic semipelite with layers showing high magnetic susceptibility at top of Tarfside Psammite Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DCGE ,
        namedrockunit:H280 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Apparently 2500m thick in Greenburn - Colmeallie area (NO5578 to NO5977), but this figure is probably inflated by tectonic thickening."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational transition with incoming of muscovite-staurolite-schist and increase in proportion of gritty psammite and decrease in proportion of greenish feldpathic semipelite at base of overlying Glen Lethnot Grit Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glen Effock (Pelite) Group [Obsolete: use GES]"@en ,
        "Glen Effock Schists [Obsolete: use GES]"@en ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Semipelite with subsidiary pelite, psammite and quartzite and trace calcsilicate-rock and gritty psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GES"@en ;
    skos:prefLabel "Glen Effock Schist Formation"@en ;
.

