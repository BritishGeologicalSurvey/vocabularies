namedrockunit:HFA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member is an alternation of fine, argillaceous sands and sandstones overlain by siltstones and, at the top of the succession, claystone in a sequence of five fining-upward cycles."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where olive-grey or brownish grey siltstone of the Atherfield Clay Formation is overlain by grey, argillaceous, fine-grained sandstone of the member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 12.7m thick at the type site and 12.5m in the Thakeham Borehole (TQ11NW/17)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken where claystone at the top of the highest cycle of the Hoes Farm Borehole is separated, at a burrowed erosion surface, from glauconitic, calcareously cemented, indurated, fine- to medium-grained sandstone, with phosphatic nodules at the base, of the undivided upper part of the Hythe Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HY ;
    skos:definition "Muddy sandstone, sandstone and siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HFA"@en ;
    skos:prefLabel "Hoes Farm Member"@en ;
.

