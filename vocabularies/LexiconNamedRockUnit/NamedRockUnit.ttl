namedrockunit:DUFF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mid to dark grey, fine- to coarse-grained limestone with some dolostone; pelitic in places, but generally pure."@en ;
    lexicon:hasLowerBoundaryDefinition "At the top of the underlying calcareous phyllites and semipelites, with thin limestone laminae of the Pitlurg Formation, where they give way to uniform limestone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Very variable; laterally impersistent. Thickened by folding in part. In Glenrinnes c. 150m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "At the top of the limestone where it gives way to pelites and semipelites of the Mortlach Graphitic Schist."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MOGS ;
    skos:definition "Metalimestone with subsidiary dolomitic limestone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DUFF"@en ;
    skos:prefLabel "Dufftown Limestone Member"@en ;
