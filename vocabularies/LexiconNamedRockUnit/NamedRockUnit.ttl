namedrockunit:BOB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Breccia, reddish-brown, silty and sandy, with pebbles of sandstone, slate, shale, hornfels, acid lava, vein-quartz and quartz porphyry. Middle Devonian limestone clasts present at Solland (SS 615 021) and Westacott (SS 685 022). (Hutchins, 1958). Lamprophyres and basalts present near north Tawton, on southern side of trough."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests directly on Upper Carboniferous Bude Formation, from Lower Creedy (SS 843 027) westwards to western edge of Exeter district, although thin Cadbury Breccia may locally intervene. East of Bradley Farm (SS 855 023) apparently overlies Cadbury Breccia."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BWCG ,
        namedrockunit:H1374 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 140 (Crediton area). 430m (Bow). 380m (north Tawton). 180m+ (Sampford Chapple). 150m+ (Hatherleigh-Exbourne)."@en ;
    lexicon:hasUpperBoundaryDefinition "Passes gradationally up into the Knowle Sandstone Formation by gradual increase in the proportion of breccia."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bow Beds [Obsolete: use BOB]"@en ,
        "Bow Conglomerates [Obsolete: use BOB]"@en ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Breccia. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BOB"@en ;
    skos:prefLabel "Bow Breccia Formation"@en ;
.

namedrockunit:BOBC
