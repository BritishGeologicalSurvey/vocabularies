namedrockunit:WHE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstones, mudstones, sandy limestones and shales. Conglomerate lenses. See also the definitions of the constituent (Southshore, Threemile, Penwhapple, Myoch, Mill and Shalloch) formations."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Ardwell Farm Formation, part of the Ardwell Subgroup."@en ;
