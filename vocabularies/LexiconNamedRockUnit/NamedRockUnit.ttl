namedrockunit:GHLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATRAT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Gargunnock Hills Lava Member consists predominantly of plagioclase-macrophyric basalt (of 'Markle' type) and composite lavas, with subordinate plagioclase-microphyric basalt (of 'Jedburgh' type) and rare basaltic-trachyandesite (mugearite) lavas. Some lavas have weathered tops (dark red 'boles' with nodules of decomposed, slaggy basalt)."@en ;
    lexicon:hasLowerBoundaryDefinition "In the northern Gargunnock Hills, the basal plagioclase-macrophyric basalt of the member lies, apparently disconformably on trachybasalts of the Lees Hill Lava Member. In the northern Touch Hills, the Gargunnock Hills Lava Member interdigitates with the Lees Hill Lava Member and lies, probably disconformably, on microporphyritic basalts (of 'Jedburgh' type) of the Spout of Ballochleam Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4062 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "91 m in the east, to more than 150 m in the west, where the top of the member is eroded."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Gargunnock Hills and north-western Touch Hills, the member occupies the highest ground and its top is eroded. However, in the north-eastern and eastern Touch Hills, the member is overlain by the Black Mount Lava Member. The change in lithology is from plagioclase-macrophyric basalt to plagioclase-microphyric basalts and subordinate basaltic trachyandesite (mugearite)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gargunnock Hills Group [Obsolete: use GHLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and trace basaltic-trachyandesite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GHLA"@en ;
    skos:prefLabel "Gargunnock Hills Lava Member"@en ;
.

