namedrockunit:PUBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TALCR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Muscovite-chlorite-talc schist with included fragments of carbonate, psammite and siliceous semipelite; with a melange-type appearance. Fragments have a variety of shapes from rounded/flattened to angular and range in size from 5-30cm up to 8m. Irregular bodies of crystalline quartz locally developed - ?metachert."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp change from the typical psammite, micaceous psammite and garnetiferous semipelite of the Auchlyne Formation to schistose muscovite-chlorite-talc calcsilicate- rock with included fragments."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "10-20m?"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upward change from melange-type lithology back to the typical psammite, micaceous psammite and garnetiferous semipelite of the Auchlyne Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:AULY ;
    skos:definition "Talc-rock with subsidiary metachert. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
