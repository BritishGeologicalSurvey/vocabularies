namedrockunit:LGHL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thickly bedded, massive, pale grey shelly limestones (packstones and grainstones), locally mottled and pseudobrecciated, arranged in shoaling upwards cycles capped by calcretes, hummocky palaeokarstic surfaces and associated thin bentonitic clay seams (palaeosols) and rare coals. Locally dolomitised and with scattered chert nodules. The Loggerheads Limestone Formation records late Asbian platform carbonate deposition on the North Wales Dinantian shelf. Each cyclic sequence records a shoaling upwards unit developed in response to transgressive and regressive movements in sea level. Many regressions culminated in emergence of the platform surface and the formation of calcrete and karstic dissolution features. During these periods of emergence, wind blown volcanic ash accumulated on the platform surface to form thin bentonitic soils."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of highest porcellanous limestone of underlying Leete Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ELF ,
        namedrockunit:H2900 ,
        namedrockunit:LNDL ,
        namedrockunit:MDWL ,
        namedrockunit:ORL ,
        namedrockunit:PEL ,
        namedrockunit:S419 ,
        namedrockunit:S670 ,
        namedrockunit:S73 ,
        namedrockunit:TREB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 275m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of lowest sequence of thinly interbedded dark-grey limestones and mudstones of overlying Cefn Mawr Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eglwyseg Limestone Formation [Obsolete: use LGHL]"@en ,
        "Eglwyseg Limestone [Obsolete: use LGHL]"@en ,
        "Great Orme Limestone Formation [Obsolete: use LGHL]"@en ,
        "Great Orme Limestone [Obsolete: use LGHL]"@en ,
        "Llandulas Limestone Formation [Obsolete: use LGHL]"@en ,
        "Llandulas Limestone [Obsolete: use LGHL]"@en ,
        "Middle White Limestone [Obsolete: use LGHL]"@en ,
        "Penmon Limestone Formation [Obsolete: use LGHL]"@en ,
        "Treborth Formation [Obsolete: use LGHL]"@en ,
        "White Limestone, Middle [Obsolete: use LGHL]"@en ;
    skos:broader namedrockunit:CLWYD ;
    skos:definition "Limestone with subsidiary dolomitic limestone and mudstone and trace chert and coal. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
