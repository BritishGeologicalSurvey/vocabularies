namedrockunit:FRN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Black pyritic mudstones with abundant phosphate nodules. Ooliths common in nodules - less common in matrix. Localised developments of pure oolitic ironstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the Llyn y Gafr Volcanic Formation in the east of the outcrop where the boundary is sharp but poorly exposed. Unconformable contact to west, greatest at Llwyngwril, where it overlies the Allt Llwyd Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2192 ,
        namedrockunit:H2193 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Mostly about 25m in thickness but locally ranges up to 180m thick at western end of outcrop. Some rapid lateral variations in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable transition from black nodular mudstones to paler mudstones of the Ty'r Gawen Mudstone Formation lacking in nodules. Contact not seen but makes a distinct feature or hollow."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Oolitic Ironstone [Obsolete: use FRN]"@en ,
        "Oolitic and Nodular Beds [Obsolete: use FRN]"@en ;
    skos:broader namedrockunit:TYGN ;
    skos:definition "Ironstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FRN"@en ;
    skos:prefLabel "Fron Newydd Member"@en ;
.

namedrockunit:FRS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises a number of heavily bioturbated coarsening-upward units each comprising dark grey sandy muds or muddy sands passing up into fine- to medium-grained grey to green glauconitic sands. Weak cementation occurs at the top of many of the units producing discontinuous calcareous, phosphatic or pyritic concretions that are generally fossiliferous. The middle of the formation contains plant debris. Eleven units (IV to XV) described as \"members\" are informally identified within the succession. Full lithological descriptions for each of these informal members are given in Insole et al. (1998, pp. 65-68). The succession at Chale Bay is divided into eleven units considered to be of member status in Insole et al. (1998) and whose numbering follows on from the members as defined by Fitton (1847, \"Groups\" I, II and III) of the preceding Atherfield Clay Formation. The \"members\" of Insole et al. (1998) are difficult to recognise and trace laterally away from the type site of Chale Bay and must therefore be regarded as informal terms. The \"members\", in ascending order, are Member IV, Member V, Member VI, Whale Chine Member, Member VIII, Ladder Chine Member, Member X, Member XI, Old Walpen Chine Member, New Walpen Chine Member, Member XIV and Member XV."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by a short transition from silty clays of the Upper Atherfield Clay Formation (the Upper Lobster Member) up into ferruginous sands and sandstones with concretions."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2194 ,
        namedrockunit:H4051 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 161m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary has been defined in a number of ways. Fitton (1847) and Casey (1961) placed the boundary at the top of their \"Group XV\" (equivalent to Member XV), where coarsening-upward estuarine silty mudstones pass up into interlaminated black clays and white sands (of their Ferruginous Sands) and are overlain by the white, quartzose sands of the Sandrock Formation. This boundary (Fitton, 1847; Casey, 1961) is a scoured erosion surface separating the estuarine mudstones from marine sandstones with a highly burrowed and indurated top. It marks a sequence boundary and is the current definition of the base of the succeeding unit (Sandrock Formation) (Insole et al., 1998; Ruffell and Wach, 1998). Wach and Ruffell (1990) placed the boundary within Member XV where the estuarine silty mudstone passes up into the interlaminated black clays and white sands. They regarded this unit as a transitional bed of estuarine mudstone passing up into the estuarine sands of the Sandrock Formation. The underlying ferruginous, glauconitic sands and sandstones are essentially marine."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ferruginous Sand [Obsolete: use FRS]"@en ,
        "Ferruginous Sands [Obsolete: use FRS]"@en ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Glauconitic sandstone, sand, sandstone and sandy mudstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FRS"@en ;
    skos:prefLabel "Ferruginous Sands Formation"@en ;
.

