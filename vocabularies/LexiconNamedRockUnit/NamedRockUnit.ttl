    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "2nd Terrace Of River Cam"@en ;
    skos:broader namedrockunit:CAMV ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace shells. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKAV"@en ;
    skos:prefLabel "Sidgwick Avenue Member"@en ;
