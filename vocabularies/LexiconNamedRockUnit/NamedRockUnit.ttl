    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Gravel, sand and silty clay with subsidiary clay and silt and trace peat. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "TFRB"@en ;
    skos:prefLabel "Tidal Flat and Raised Beach Deposits (Undifferentiated)"@en ;
.

