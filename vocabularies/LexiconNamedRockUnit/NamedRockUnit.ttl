namedrockunit:YW
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, purple and green, coarse-grained volcaniclastic sandstones with subordinate mudstones and siltstones, and beds of conglomerate. The suffix 'Western Longmynd' is superfluous and it is also preferable not to ascribe a geographical extent to this division, given the uncertainties over its relationship to the Stretton Group that underlies it; i.e. whether the boundary is unconmformable or not . It is possible that the term will become obsolete in the future, depending on the degree of acceptance of the stratigraphy proposed by Pauley (1990). However the term 'Wentnor Group' is currently used and understood widely, and it is suggested that it is retained as an informal name."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the change from purple and green shaly mudstones and sandstones of the Portway Formation of the Stretton Group, into the more massive coarse purplish sandstones of the Bayston Formation of the Wentnor Group.  It has been argued that the boundary is an unconformity by Greig et al. (1968), although there is no obvious angular discordance at this level.  However, Pauley (1990) considered that no such unconformity exists, and the succession was one of prograding alluvial facies."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2547 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "1800 m - 3600 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Wentnor Series [Obsolete: use YW]"@en ;
    skos:broader namedrockunit:LO ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BAGP ,
        namedrockunit:BRGP ,
        namedrockunit:STRI ;
    skos:notation "YW"@en ;
    skos:prefLabel "Wentnor Group"@en ;
.

