namedrockunit:EANHY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey or white anhydrite interbedded with limestones, shales, siltstones and sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition """The base of the member is not seen, but seismic interpretation indicates the presence of 'several thousands of feet' of\r
conformable strata below the succession in some parts of the Solway Basin (see Ward, 1997, p. 283)."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "More than 1153 m (base not seen)."@en ;
    lexicon:hasUpperBoundaryDefinition """The top of the member is taken where numerous beds of anhydrite interbedded with limestones, shales, siltstones\r
and sandstones give way to strata with variously algal, oolitic, peloidal, shelly, crinoidal and serpulid limestones, which may represent the Main Algal Member of the Lyne Formation. However, this has not been positively identified."""@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LYNE ;
    skos:definition "Anhydrite-stone, limestone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EANHY"@en ;
    skos:prefLabel "Easton Anhydrite Member"@en ;
