        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red and green mottled mudstones, sandstones, conglomerates and basal breccias.  The Penbedw Formation represents localised accumulations of terrestrial scree and alluvial deposits in palaeovalleys and embayments along the margin of the North Wales Dinantian platform"@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on cleaved and folded Silurian mudstones,siltstones and sandstones."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BED ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable contact with limestones of the Foel Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Beds Formation [Obsolete: use FANT, FRFA, LGY, MEST, PANT, PDW]"@en ;
    skos:definition "Breccia, conglomerate, mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "PDW"@en ;
    skos:prefLabel "Penbedw Formation"@en ;
