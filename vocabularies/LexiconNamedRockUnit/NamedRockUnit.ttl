        "Raisby (Magnesian Limestone) Formation [Obsolete: use RML]"@en ,
        "Wetherby Member"@en ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Dolostone with subsidiary limestone and trace anhydrite-stone and gypsum-stone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RML"@en ;
    skos:prefLabel "Raisby Formation"@en ;
