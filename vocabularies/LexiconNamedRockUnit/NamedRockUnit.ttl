        "Cloughton Formation"@en ,
        "Ellerick Formation"@en ,
        "Glentham Formation [Obsolete: use BWL, BWC, RLD]"@en ,
        "Lincolnshire Limestone Formation"@en ,
        "Pentland Formation"@en ,
        "Scarborough Formation"@en ,
        "Werkendam Shale Formation"@en ;
    skos:broader namedrockunit:WSTS ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace limestone. Stratified bedrock. Occurs offshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STRW"@en ;
    skos:prefLabel "Strangways Formation"@en ;
