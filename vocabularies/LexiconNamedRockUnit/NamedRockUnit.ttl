    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface, or sharp, undulating, unconformable contact of diamicton with overlying dark brown laminated clay of the Whinneyhill Coppice Clay Member of the Aikbank Farm Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
