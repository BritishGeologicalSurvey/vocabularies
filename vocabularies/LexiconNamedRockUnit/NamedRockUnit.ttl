namedrockunit:BYTIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravelly, slightly clayey, silty sand diamicton. Interpreted as a subglacial till. Dark reddish brown, weakly calcareous, matrix supported. Clast lithologies are dominated by quartzite, psammitic metasedimentary rocks and red Devonian sandstones and shale. Clasts are typically subangular to subrounded and Devonian shale lithologies are striated. Clast fabrics indicate glacial transport from the west. Interpreted as a subglacial till."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the unit is sharp, planar, subhorizontal unconformity on gravels of the Howe of Byth Gravel Formation. To the west of the Howe of Byth quarry the Byth Till has been observed sharply unconformable on Devonian red sandstones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1412 ,
        namedrockunit:H2658 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the formation is a sharp, undulatory (relief up to 1m) erosional unconformity overlain by the Auchmeddon Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blyth Member [Obsolete: use BYTIL]"@en ,
        "Byth Till [Obsolete: use BYTIL]"@en ;
    skos:broader namedrockunit:EGD ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CRTI ;
    skos:notation "BYTIL"@en ;
    skos:prefLabel "Byth Till Formation"@en ;
.

namedrockunit:CADR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithological assemblages consist of mainly framework-supported bouldery gravel and sand, and coarse- to fine-grained, locally pebbly, sand with silt. In a geotechnical sense, the deposits are usually dense to very dense. Much of the gravel is thickly bedded and trough cross-bedded in sets up to 3m thick. These interfinger with sands. The sands are trough cross-bedded, ripple-laminated and horizontally laminated."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity on bedrock or on older unnamed Quaternary strata or the Baillieston Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H102 ,
        namedrockunit:H2042 ,
        namedrockunit:H3894 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From a veneer to more than 45m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity or glacial deformation boundary below younger Quaternary till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cadder Clay Member [Obsolete: use CADR]"@en ,
        "Cadder Formation [Obsolete: use CADR]"@en ,
        "Cadder Sand Formation [Obsolete: use CADR]"@en ;
    skos:broader namedrockunit:MVG ;
    skos:definition "Gravel and sand with subsidiary silt and trace clay and diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CADR"@en ;
    skos:prefLabel "Cadder Sand and Gravel Formation"@en ;
.

namedrockunit:CADY
