namedrockunit:HSLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Hailes Lava Member consists of dark grey, feldspar-phyric olivine-basalts (\"Markle type\") with sparse to abundant, large or small feldspar phenocrysts, non-porphyritic basalts and pale purple-grey, platy jointed mugearites. Thicknesses of flows are up to 17m. The feldspar-phyric basalts characterize this unit of about six flows."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is conformable or locally unconformable on the East Linton Lava Member (olivine, clinopyroxene and locally plagioclase-phyric basaltic lavas; ankaramites and basaltic hawaiites) or locally unconformable on the North Berwick Pyroclastic Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2855 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 70m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the Bangley Trachytic Member. The contact is conformable and locally unconformable. The change is from olivine-basalt and mugearite lava flows to trachytic lava flows with trachytic tuff and lapilli tuffs."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hailes Member [Obsolete: use HSLA]"@en ;
    skos:broader namedrockunit:GHV ;
    skos:definition "Mugearite and olivine-basalt with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HSLA"@en ;
    skos:prefLabel "Hailes Lava Member"@en ;
.

