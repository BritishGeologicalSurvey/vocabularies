    lexicon:hasThicknessDescription "c.140-230m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of pyroclastic flow deposit, usually overlain by volcaniclastic sandstone, which separates it from the overlying pyroclastic flow deposit (Barrow Tuff Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
