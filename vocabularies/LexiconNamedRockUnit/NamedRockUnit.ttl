namedrockunit:BLLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:FANK ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale to dark grey, crinoidal, bioclastic, earthy to hard limestone, interpreted to be of marine origin, with thicker occurrences comprising calcareous mudstone and lime mudstone beds, thinly bedded above and massive below. In the Glasgow area, the lower leaf of the limestone is a brownish grey ostracodal limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally seen as a conformable change from marine mudstone underlying the Blackhall Limestone above a thin coal or seatearth within the Lower Limestone Formation, that forms the top of the Inchinnan Limestone cycle."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CNMA ,
        namedrockunit:DOLS ,
        namedrockunit:DWLS ,
        namedrockunit:MSKL ,
        namedrockunit:MUSKL ,
        namedrockunit:NOGL ,
        namedrockunit:TAR ,
        namedrockunit:USKL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 0.45m to 3.70m in the Airdrie, Falkirk and Glasgow districts, whereas in interpreted on-shelf settings such as around Midlothian, it can be 15m to 18m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally seen as a conformable change to thick marine mudstone containing the Neilson Shell Bed fauna that passes up into deltaic arenaceous deposits of the Lower Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Charlestown Main Limestone [Obsolete: use BLLS]"@en ,
        "Dockra Limestone [Obsolete: use BLLS]"@en ,
        "Douglas Wee Limestone [Obsolete: use BLLS]"@en ,
        "Fankerton Limestone"@en ,
        "Middle Skateraw Limestone [Obsolete: use BLLS]"@en ,
        "Middle Skateraw Limestone and Upper Skateraw Limestone (undifferentiated) [Obsolete: use BLLS]"@en ,
        "North Greens Limestone [Obsolete: use BLLS]"@en ,
