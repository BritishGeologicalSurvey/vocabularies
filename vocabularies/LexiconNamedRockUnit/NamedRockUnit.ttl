    lexicon:hasThicknessDescription "To at least 290m"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
