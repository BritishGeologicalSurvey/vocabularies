namedrockunit:SEVN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fluvial terrace and alluvial deposits of the River Severn and tributaries excluding the Avon (see Warwickshire Avon Valley Formation) and possibly others, pending review. Mainly sand, gravel and mud; divided into six \"terrace\" members (Spring Hill, Bushley Green, Kidderminster Station, Holt Heath, Worcester, Power House members), plus Holocene alluvium (Elmore Member of Bowen, 1999) and with local named organic deposits. Includes contemporaneous head, colluvium and soil deposits. Gravels are principally composed of Palaeozoic, Triassic and (mainly below Avon confluence at Tewkesbury) Jurassic material from the local bedrock of the catchment, with an admixture of glacial material from the Anglian Wolston Formation, etc. and, in the younger terraces, a substantial admixture of \"Irish Sea\" glacial material from the Devensian Stockport Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base on pre-Quaternary bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to c. 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SACA ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
