namedrockunit:K1U
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:S663 ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Rarely present but correlatable thin coal. Locally indistinct and commonly replaced by sandstone. Correlation value is defined as its underlying association with the 60cm Kilsyth No.1 Blackband Coal, which is widely worked."@en ;
    lexicon:hasLowerBoundaryDefinition "Kilsyth No 1 Blackband Under Coal overlies the Berryhills Limestone and a thin seat earth within the Limestone Coal Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.13m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by a \"cyclothem\" containing the 60cm thick Kilsyth No.1 Blackband Coal within the Limestone Coal Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bank Coal"@en ;
    skos:broader namedrockunit:LSC ;
    skos:definition "Coal. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
