namedrockunit:RUCSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Runton Cliffs Sand and Gravel Member is composed of planar cross-bedded, rippled, channelised and horizontally-bedded yellow to olive brown sands with sporadic beds of massive or cross-bedded gravel. The flint gravel content (c.82%) is low compared to other outwash lithofacies in north Norfolk, but it contains a high content (c.3-4%) of far travelled erratics including Carboniferous limestone, micaceous schist, quartz-schist, granodiorite, felsic porphyry and andesite."@en ;
    lexicon:hasLowerBoundaryDefinition "The Runton Cliffs Sand and Gravel Member rests upon the upper surface of the Bacton Green Till Member. The contact is abrupt and scoured and marked by a lithological change from till to sand and gravel. An additional geometric complexity is that the deposit has been loaded (gravitationally) into the Bacton Green Till Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the deposit is truncated by the ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SMCL ;
    skos:definition "Sand with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RUCSG"@en ;
    skos:prefLabel "Runton Cliffs Sand And Gravel Member"@en ;
.

