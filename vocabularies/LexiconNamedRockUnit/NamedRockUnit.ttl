namedrockunit:CSO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Soft to firm, highly to moderately silty clay with sporadic shell fragments and pebbles. Geotechnical strength lower than underlying Ferder Formation, also less sandy. Less pebbles/shells and more streaky and laminated in appearance than the overlying Sperus Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Apparently conformable boundary with Ferder Formation within map area."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS003> ;
    lexicon:hasOldestAgeValue 5.9e-02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10 metres in Borehole 78/9 but thickens to 45 metres to the plateau edge and thicker in the northern part of the Norwegian Trench area."@en ;
    lexicon:hasUpperBoundaryDefinition "Top boundary unconformable with thin sand Holocene sedimentation at the sea bed, or apparently conformable with the overlying Sperus Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:REAP ;
    skos:definition "Clay and silty clay with subsidiary shelly clay. Stratified superficial deposits. Occurs offshore. Formed during the Marine Isotope Stage 3 - to - Marine Isotope Stage 2 (Quaternary Period) (.059-.0139 Ma BP)."@en ;
