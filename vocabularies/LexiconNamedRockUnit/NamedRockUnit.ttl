    skos:altLabel
        "Boyne Limestone [Obsolete: use BOYL]"@en ,
        "Whitehills Group [Obsolete: use BOYL]"@en ;
    skos:broader namedrockunit:DBTV ;
    skos:definition "Calcsilicate-rock, metalimestone and semipelite with subsidiary pelite and psammite and trace quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BOCL ,
        namedrockunit:OLHL ,
        namedrockunit:WHYL ;
    skos:notation "BOYL"@en ;
    skos:prefLabel "Boyne Limestone Formation"@en ;
