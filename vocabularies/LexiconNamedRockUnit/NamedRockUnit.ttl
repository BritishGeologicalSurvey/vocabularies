namedrockunit:LDTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S488 ;
    lexicon:hasLithologyDescription "Generally stiff, structureless, stony, sandy and silty diamict and clayey gravel, characteristically containing abundant Old Red Sandstone clasts (derived from Black Mountain, Fforest Fawr and the Brecon Beacons) and very few Lower Palaeozoic clasts. Subordinate stratified sand and gravel are locally present. Colour and dominant clast composition are variable and generally reflect the local bedrock geology."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type locality it unconformably overlies Early Devensian Head deposits or Ipswichian Raised Beach deposits of the Pennard Formation (of Bowen, 1999); elsewhere it is generally unconformable on bedrock or regolith (Barclay et al, 2005)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4481 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Highly variable, locally up to 25m (Waters and Lawrence, 1987)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or contact with overlying Late Glacial organic deposits infilling kettleholes (see Bowen, 2005, p.155) (Britannia Catchments Group), or the Kenfig Formation or Wentlooge Level Formation (British Coastal Deposits Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Brecknockshire Drift [Obsolete: use BNOCK, LDTI]"@en ,
        "Langland Member"@en ;
    skos:broader namedrockunit:BNOCK ;
    skos:definition "Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LDTI"@en ;
    skos:prefLabel "Langland Till Member"@en ;
.

namedrockunit:LEBB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMPIS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHFEST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Heterolithic marine lithologies best described as three informal lithofacies (below). In the west of the Cleveland Basin it is represented by the \"Whitwell Oolite\", which consists of pale grey, shelly ooidal cross-bedded limestone with bivalves, gastropods, bryozoa and coral fragments, interbedded with yellow fine- to medium-grained, calcareous cross-bedded sandstone and grey calcareous mudstone. In the east of the Cleveland Basin it is represented, in ascending order, by the \"Millepore Bed\", which consists of yellow, fine- to medium-grained calcareous sandstone passing up to shelly ooidal, cross-bedded limestone and siderite mudstone; shelly fauna includes abundant bryozoa, Haploecia (=Millepora) straminea, and the overlying \"Yons Nab Beds\", consisting of grey, calcareous mudstone and yellow fine- to medium-grained calcareous sandstone and pale grey, sideritic mudstone; abundant shelly fauna includes crinoid ossicles, bivalves and ostracods, together with plant fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable, taken at the abrupt transition from sandstone, siltstone and mudstone with plant remains (Sycarham Member; Cloughton Formation) to marine strata comprising pale grey, shelly ooidal limestone (\"Whitwell Oolite\" lithofacies; Howardian Hills [SE 72 65]) or yellow, shelly calcareous sandstone with bivalves (\"Millepore Bed\" lithofacies; Yons Nab [TA 084 844], south of Scarborough)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2895 ,
        namedrockunit:H3518 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 9m in the Howardian Hills [SE 734 672] (\"Whitwell Oolite\"); c. 11m in the Fordon Borehole [TA 058 758]; 8m  on the Yorkshire coast at Yons Nab [TA 084 844]; thinning to 1.5m in the Hambleton Hills at Hood Hill [SE 500 812]. Not traceable, probably absent, in the north of the Cleveland Basin."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable or disconformable, taken at the abrupt transition from marine strata, comprising pale grey, shelly ooidal limestone (\"Whitwell Oolite\" lithofacies; Howardian Hills [SE 72 65]) or yellow, shelly calcareous sandstone with bivalves (\"Yons Nab Bed\" lithofacies at Yons Nab [TA 084 844]), south of Scarborough or calcareous mudstone at Cloughton Wyke [TA 021 958] or sideritic mudstone at Common Cliff [NZ 993 008], south of Ravenscar, to non-marine, yellow, medium- to coarse-grained, cross-bedded sandstone, mudstone and siltstone, commonly with plant fragments, of the Gristhorpe Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cayton Bay Formation [Obsolete: use LEBB]"@en ,
        "Millepore Series [Obsolete: use LEBB]"@en ;
    skos:broader namedrockunit:CLH ;
    skos:definition "Trace calcareous mudstone, calcareous sandstone, calcareous siltstone, ooid-limestone, pisoid-limestone and shelly ironstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LEBB"@en ;
    skos:prefLabel "Lebberston Member"@en ;
.

namedrockunit:LEN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Micritic limestone with a shelly and argillaceous base and an extensively bioturbated and argillaceous top. Contains abundant Sphaeroidothyris lenthayensis."@en ;
    lexicon:hasLowerBoundaryDefinition "Transition from shell-detrital mudstone to shelly argillaceous limestone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2288 ,
        namedrockunit:H2897 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 - c.1 m; 0.32 m in Purse Caundle Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Transition to calcareous mudstone from argillaceous limestone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
