namedrockunit:SGBK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLateralEquivalent namedrockunit:TPSF ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The dominant lithology is pale red-brown and greenish grey sandstones. The sandstones are finer grained than in the underlying Finstall Member and large-scale cross-bedding is virtually absent. Interbedded red-brown and grey-green mudstones and siltstones are more common than in the Finstall Member. The sequence shows repeated fining-upward cycles, from sandstone to mudstone; intraformational conglomerates occur throughout. Sedimentary structures include ripple marks, flute casts, slump structures, mud cracks and convolute bedding. Micaceous bedding planes are common. In the type section, bioturbation, plant remains and Euestheria have been found in the lower c.15m, and acritarchs and pseudomorphs after halite occur above that level."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken above the highest significant (>1 m) bed of sandstone with large scale cross bedding of the underlying Finstall Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3089 ,
        namedrockunit:H3236 ,
        namedrockunit:H4008 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickest known sequence is 24.4 m, in the Sugarbrook No.3 Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the top of the highest significant grey sandstone bed, above which red mudstones and siltstones of the MMG predominate over sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Passage Beds [Obsolete: use BOOC, SGBK, CLGB, MCH, UND, YED, MYS]"@en ,
        "Tarporley Siltstone Formation"@en ,
        "Waterstones Group [Obsolete: use TPSF, SGBK, HEY]"@en ,
        "Waterstones [Obsolete: use DST, HEY, SGBK, TPSF]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SGBK"@en ;
    skos:prefLabel "Sugarbrook Member"@en ;
.

