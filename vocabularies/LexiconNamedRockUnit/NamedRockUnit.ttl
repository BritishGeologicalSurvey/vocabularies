namedrockunit:FJEV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "This formation has been encountered only in Well 22/5b-5, in the UK Sector of the Central North Sea, where grey mudstones pass upwards into sandstones. In the type section, in Denmark, the formation comprises grey and dark grey, calcareous mudstones with frequent beds of argillaceous limestone and sporadic fine-grained sandstones. Offshore in the type well (N7/9-1 of the Norwegian Sector), Deegan and Scull (1977) described dark grey to grey brown mudstones grading up into siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "In North Sea Well 22/5b-5 the lower boundary is marked by a downward transition from grey mudstones to white sandstones interbedded with red-brown calcareous mudstones (Triassic)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "16 m in North Sea Well 22/5b-5."@en ;
    lexicon:hasUpperBoundaryDefinition "In North Sea Well 22/5b-5 the top of the formation is a sharp downward change from mudstones (Cromer Knoll Group) to sandstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Hettangian Age - to - Sinemurian Age (Jurassic Period) (201.4-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "FJEV"@en ;
    skos:prefLabel "Fjerritslev Formation"@en ;
.

