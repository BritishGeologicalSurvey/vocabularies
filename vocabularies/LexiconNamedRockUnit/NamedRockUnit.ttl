namedrockunit:TLB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded calcareous mudstones and dark grey, tabular-bedded, argillaceous limestones containing a pectinoid bivalve and goniatite fauna. The Teilia Formation represents a basinal, turbiditic and hemipelagic marine mudstone facies, which onlapped the northern margin (including knoll reefs) of the North Wales Dinantian platform during the Brigantian."@en ;
    lexicon:hasLowerBoundaryDefinition "Entry of thicker mudstones and dark limestones above conformable contact with thin-bedded limestones of the Prestatyn Limestone Formation; locally rests on\"knoll reef\" limestones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BL ,
        namedrockunit:H2486 ,
        namedrockunit:H572 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 90m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable contact with bedded cherts of the Pentre Chert Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Black (Aberdo) Limestone [Obsolete: use TLB]"@en ,
        "Black Limestone [Obsolete: use TLB]"@en ,
        "Teilia Beds [Obsolete: use TLB]"@en ;
    skos:broader namedrockunit:CRAV ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TLB"@en ;
    skos:prefLabel "Teilia Formation"@en ;
