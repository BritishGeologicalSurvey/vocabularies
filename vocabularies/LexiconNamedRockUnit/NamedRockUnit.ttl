namedrockunit:DDDN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sequence of grey mudstone beds with numerous ovoid, grey, ochreous-weathering, argillaceous limestone nodules 0.05 to 0.2 m in diameter, which are conspicuous in the soil. Some nodules are rich in small bivalves (Modiolus), and with gastropods. May include thin, silty, shelly, ferruginous limestone beds at base. Forms a strong feature with a dip slope in places."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from bluish grey, shaly mudstone of undifferentiated Beckingham Member; at 40.56 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
