    lexicon:isObsoleteEquivalentOf namedrockunit:NPEG ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Esker [Obsolete: use EK]"@en ,
        "North Pennine Glacigenic Subgroup"@en ;
    skos:broader namedrockunit:GFIC ;
    skos:definition "Gravel and sand. Superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EK"@en ;
    skos:prefLabel "Esker deposits"@en ;
.

