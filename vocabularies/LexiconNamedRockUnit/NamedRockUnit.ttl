        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDSTGR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone with horizons of chert, overlain by chert-free, clayey, laminated sandstone with cross-bedded lenses. Thin green clay-rich horizons occur in the basal part of the member, associated with glauconitic and pebbly sandstone. Tourmaline-rich sandstones locally form the highest part of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "Contact with the underlying Ashcombe Gravels Member, marked by the upward facies change from pebbly sands and gravels (Ashcombe Gravels Member) to sandstones with cherts (Cullum Sand-with-Cherts Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1299 ,
        namedrockunit:H4417 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "6.71m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with overlying Eocene flint-rich gravels"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Haldon Sands Formation [Obsolete: use ACGR, CUSC, UGSD, WLSS]"@en ,
        "Haldon Sands [Obsolete: use UGSD, ACGR, CUSC, THSS, WLSS]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Chert and sandstone with subsidiary muddy sandstone and trace gritty sandstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CUSC"@en ;
    skos:prefLabel "Culham Sands with Cherts Member"@en ;
