    lexicon:hasThicknessDescription "To 16m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Park Farm Clay Member is succeeded by the Lawns House Farm Sand Member, The contact with the Lawns House Farm Sand Member is typically sharp."@en ;
