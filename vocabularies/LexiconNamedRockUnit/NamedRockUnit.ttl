namedrockunit:TAM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Soft to firm, to stiff, moderately to slightly plastic, pebbly and shelly, sandy, silty clay. Sand partings common, gravel also present. General till-like texture and moraine-like distribution. Underlain by a more uniform and geotechnically weaker clay unit.Lithologically variable, sandy, pebbly clay, shelly; overconsolidated - [generic description: Geol Soc Lond Special Publication Report 4, 2nd edition]."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary apparently conformable or disconformable on the Sperus Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasOldestAgeValue 2.4e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 50 metres from seismic section."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary is an erosional, partly winnowed surface, mantled by thin holocene sedimentation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QMIS002> ;
    lexicon:hasYoungestAgeValue 1.39e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:REAP ;
    skos:definition "Clay, gravel and sand. Stratified bedrock. Occurs offshore. Deposited during the Marine Isotope Stage 2 (Quaternary Period) (.024-.0139 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TAM"@en ;
    skos:prefLabel "Tampen Formation"@en ;
.

