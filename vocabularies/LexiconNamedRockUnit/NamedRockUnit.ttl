namedrockunit:RRAM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises purple, green and greyish green mudstones. Scattered siliceous and calcareous nodules are developed at some levels. A prominent 10 m thick unit of buff weathering calcareous laminated siltstone, capped by 2 m of interbedded grey silty mudstones and siliceous black mudstones, is present at the top of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is not seen. May possibly overlie the Tavy Formation (TVY) but further work is needed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2402 ,
        namedrockunit:H2403 ,
        namedrockunit:H3646 ,
        namedrockunit:RSL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Uncertain but probably not more than 200 m exposed."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the sharp incoming of the black mudstones of the 'Ararat Slate' (Teign Chert Formation) (TCH) above the buff weathering calcareous laminated siltstones capped by 2 m of interbedded grey silty mudstones and siliceous black mudstones at the top of the underlying Rora Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Islington Slates [Obsolete: use RRAM]"@en ,
        "Liverton Slates [Obsolete: use RRAM]"@en ,
        "Rora Slate Formation [Obsolete: use RRAM]"@en ,
        "Rora Slate [Obsolete: use RRAM]"@en ;
    skos:broader namedrockunit:TAMA ;
    skos:definition "Mudstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RRAM"@en ;
    skos:prefLabel "Rora Mudstone Formation"@en ;
.

