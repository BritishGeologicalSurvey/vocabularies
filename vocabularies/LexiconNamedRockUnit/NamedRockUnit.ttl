    skos:broader namedrockunit:MXGL ;
    skos:definition "Boulders, cobbly boulders and gravelly cobbles with subsidiary diamicton, gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SNAEF"@en ;
    skos:prefLabel "Snaefell Formation"@en ;
