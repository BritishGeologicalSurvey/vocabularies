    lexicon:hasYoungestAgeValue 4.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Raglan Mudstone Formation [Obsolete: use MOCL]"@en ,
        "Temeside Mudstone Formation"@en ;
    skos:broader namedrockunit:MIH ;
    skos:definition "Mudstone, siliciclastic argillaceous rock, siltstone and silty mudstone with subsidiary calcrete, limestone, micaceous sandstone, sandstone and tuff. Bedrock. Occurs onshore. Formed during the Pridoli Epoch (Silurian Period) (422.7-419 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TSRG"@en ;
    skos:prefLabel "Temeside Mudstone Formation and Raglan Mudstone Formation (Undifferentiated)"@en ;
