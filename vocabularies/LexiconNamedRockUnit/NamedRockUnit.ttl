namedrockunit:CLLW
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SNDG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale green to grey coarse-grained unconsolidated sands with some glauconite. Becomes whitish and poorly glauconitic in the Carrickfergus district."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is disconformable at an erosional surface upon the Island Magee Siltstones Formation. This is placed at the change from grey siltstones and marls of the Island Magee Siltstones up into the pale green or grey glauconitic coarse-grained sands of this formation."@en ;
    lexicon:hasObsoleteEquivalent
