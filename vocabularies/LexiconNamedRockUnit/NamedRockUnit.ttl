namedrockunit:RIDCO
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ridge Conglomerate Unit consists of dark grey, fine grained, calcareous, micaceous sandstone with grey, angular to rounded, pebble to boulder-sized clasts of Devonian sandstone, shale and Lewisian crystalline basement (e.g. Haszeldine et al., 1987)."@en ;
    lexicon:hasLowerBoundaryDefinition "The transition between the Ridge Conglomerate Unit and the underlying Kimmeridge Clay Formation mudstones is represented by a marked downward increase in gamma-ray log values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasUpperBoundaryDefinition "On wireline logs, the top of the unit is marked by a downward decrease in gamma-ray log values and an increase in velocity, as typical Kimmeridge Clay Formation mudstones grade to sandstones, conglomerates and breccias."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasYoungestAgeValue 1.377e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KC ;
    skos:definition "Conglomerate. Stratified bedrock. Occurs offshore. Deposited during the Kimmeridgian Age (Jurassic Period) - to - Berriasian Age (Cretaceous Period) (154.8-137.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RIDCO"@en ;
    skos:prefLabel "Ridge Conglomerate Unit"@en ;
.

