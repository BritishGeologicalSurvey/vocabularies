namedrockunit:YA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very silty mudstones with abundant siltstone laminae and scattered thin beds of sandstone. Units of thick-bedded sandstone locally present. Slump folding and destratification commonly present."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp incoming of mudstones with siltstone laminae and no burrows, above burrow mottled mudstones of the Nantmel Formation. Locally rests sharply on top of Doldowlod Conglomerate Member of Nantmel Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasOldestAgeValue 4.4975e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 1200 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Either gradational and taken at incoming of sandstone dominant sequence of Scrach Formation, or sharp, where overlain by mudstones lacking silt laminae of the Cwmere Formation or Tycwtta Mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Silty mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ashgill Series (Ordovician Period) (449.75-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DCM ;
    skos:notation "YA"@en ;
    skos:prefLabel "Yr Allt Formation"@en ;
