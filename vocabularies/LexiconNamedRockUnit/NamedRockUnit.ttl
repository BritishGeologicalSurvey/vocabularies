namedrockunit:BGL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:PGA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FTUFF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MFLAVA"^^xsd:anyURI ,
