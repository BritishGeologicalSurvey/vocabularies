namedrockunit:BIDM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fluviatile gravel with sand: contains thin fossiliferous clay layers with a temperate molluscan fauna. Numerous artifacts of Acheulian type have also been recorded."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly chanelled base, resting on bedrock surface."@en ;
