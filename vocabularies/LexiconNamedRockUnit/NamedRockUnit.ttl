namedrockunit:GDLL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Scar-forming, mid to pale grey limestone, well bedded, varying from thick to very thick-bedded. Variations include fine- and medium-grained (more rarely coarse-grained) bioclastic calcarenite packstones, wackestones and subordinate grainstones, with thin conglomerates adjacent to the Middle Craven Fault. The wackestones and packstones commonly show pseudobrecciation and the grainstones are cross-bedded. Undulating palaeokarstic surfaces are present, commonly overlain by thin mudstone \"clays\" (bentonites). Topographically, the member forms conspicuous stepped scar features and prominent limestone pavements."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at a conspicuous bedding plane at the base of the scar-forming pale grey, well-bedded limestone of the Gordale Limestone Member above the pale grey massive limestone of the Cove Limestone Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:KDL ,
        namedrockunit:KIL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "94m thick in its type section at Gordale Scar, elsewhere a thickness of 70-75m is typical."@en ;
    lexicon:hasUpperBoundaryDefinition "The conformable upper boundary is drawn at the upward passage from pale grey limestones of the Gordale Limestone Member to darker grey limestone of the Lower Hawes Limestone at the base of the Alston Formation, Yoredale Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kingsdale Limestone [Obsolete: use GDLL]"@en ,
        "Kingsdale Limestones [Obsolete: use GDLL]"@en ;
    skos:broader namedrockunit:MALM ;
    skos:definition "Limestone and trace clay and conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GDLL"@en ;
    skos:prefLabel "Gordale Limestone Member"@en ;
.

