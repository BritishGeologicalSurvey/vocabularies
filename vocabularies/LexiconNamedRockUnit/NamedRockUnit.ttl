namedrockunit:MARR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:TENBY ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fissile dark grey siliceous mudstones and cherts (Aberkenfig Formation); grey, commonly fossiliferous mudstones (Bishopston Formation); quartzitic sandstones and conglomerates (Twrch Sandstone Formation), occupying the basal half of the Group on the northeastern crops and eastern crops of the South Wales Coalfield, and quartzitic sandstones (Telpyn Point Sandstone Formation) occupying the highest part of the Group locally."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the base of 35m of dark grey fissile mudstones with thin cherts and siliceous mudstones (Aberkenfig Formation), which gradationally overlie the interbedded dark grey argillaceous limestones and mudstones of the Oystermouth Formation. In the type section at Ragwen Point the base is not seen."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3919 ,
        namedrockunit:TENBY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "20m on the east crop of the South Wales Coalfield to 750m in Gower."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is taken at the base of the Subcrenatum Marine Band, where mudstones or sandstones are overlain by fossiliferous marine mudstones containing the index goniatite Gastrioceras subcrenatum (as for the base of the Coal Measures Group, as defined by Stubblefield and Trotter, 1957)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Millstone Grit Series [Obsolete: use CFS, CKN, MARR, MORRI]"@en ,
        "Tenby Group [Obsolete: use MARR]"@en ;
    skos:definition "Mudstone and sandstone with subsidiary chert, conglomerate and siltstone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Namurian Stage (Carboniferous Period) (330.3-319 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
