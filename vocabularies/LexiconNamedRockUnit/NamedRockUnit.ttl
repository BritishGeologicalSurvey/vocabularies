namedrockunit:MACD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MSDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Rocks of the Carghidown and Ross Formations (Hawick Group) and Siluro - Devonian minor intrusions are metamorphosed to biotite- or hornblende-diopside hornfels within the thermal metamorphic aureole of the Criffel-Dalbeattie Pluton."@en ;
    lexicon:hasLowerBoundaryDefinition "Outer boundary of the aureole is gradational but mapped at the first occurrence of rocks of mauvish-brown colour that are indurated by growth of biotite."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5074 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Mapped as between 1 and 3.2km in width."@en ;
    lexicon:hasUpperBoundaryDefinition "Margin of the Criffel-Dalbeattie Pluton."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Metamorphic aureole around the Criffel-Dalbeattie Pluton [Obsolete: use MACD]"@en ;
    skos:definition "Metasandstone with subsidiary metamudstone and trace metacrystalline-igneous rock [obsolete code: use mcir]. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Devonian Period (419-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "MACD"@en ;
    skos:prefLabel "Metamorphic Aureole, Criffel-Dalbeattie Pluton"@en ;
.

namedrockunit:MADD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Marine deltaic deposits comprise a coarsening upward sequence of sediments laid down in a prograding delta at the fluvial-marine boundary as the fluvial current velocity is dissipated. The deposits comprise sand, silt and clay. Deltas can be subdivided into fluvial-, wave- and tidal-dominated depositional environments each of which has a characteristic morphology. Progradation gives rise to topset, foreset and bottomset beds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MDU ;
    skos:definition "Clay, sand and silt. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RMDD ;
    skos:notation "MADD"@en ;
    skos:prefLabel "Marine deltaic deposits"@en ;
.

namedrockunit:MAF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
