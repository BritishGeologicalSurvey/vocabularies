    lexicon:hasThicknessDescription "To 80m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the abrupt change to bedded volcaniclastic sandstone of the main part of the Mardale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cawdale Member [Obsolete: use CAWD]"@en ;
    skos:broader namedrockunit:MRL ;
    skos:definition "Tuff and tuff-breccia with subsidiary pyroclastic-breccia and trace volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CAWD"@en ;
