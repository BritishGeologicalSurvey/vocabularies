namedrockunit:FRIS
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thick-bedded, clean, poorly consolidated, fine, to medium grained, locally coarse-grained sandstone, with sparse glauconite and carbonaceous particles. Sporadic thin calcite-cemented layers are present in most sections, as are thin beds of grey to grey-green, variably silty mudstone. Gamma-ray log profiles are typically 'blocky' (e.g. 10/1-1 A), but are locally serrated (e.g. 3/30a-3)."@en ;
    lexicon:hasLowerBoundaryDefinition "The Frigg Sandstone Member is underlain by a thin unit of grey-green or variegated Horda mudstone that separates it from the underlying dark grey mudstones of the Balder Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Thicknesses are highly variable, and exceed 300 m in places."@en ;
    lexicon:hasUpperBoundaryDefinition "The Frigg Sandstone Member is overlain by grey-green or grey-red Horda Formation mudstone. A distinct high-gamma spike is present at, or shortly above, the boundary in many sections (e.g. 3/30a-3)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HORD ;
    skos:definition "Sandstone. Stratified bedrock. Occurs offshore. Deposited during the Early Eocene (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FRIS"@en ;
    skos:prefLabel "Frigg Sandstone Member"@en ;
.

