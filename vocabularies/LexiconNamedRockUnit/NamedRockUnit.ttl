namedrockunit:MQF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HFMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Much of the outcrop occurs in the metamorphic aureole of the Dartmoor Granite with dark brown hornfelsed mudstone. The Formation comprises black shaly mudstones with variably abundant (locally exceeding 50%) thin beds (up to 15cm) and laminae of white and reddish brown quartzite. Radiolaria are abundant in the quartzites in the upper part of the Formation. A 26 to 61m-thick unit of thin-bedded to massive, locally cross bedded \"keratophyric\" tuffs and agglomerates is present in the upper part of the Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of black mudstones with abundant thin beds and laminae of quartzite above the dark brown hornfelsed mudstones with scattered thin beds and lenses of pale green feldspathic siltstone of the underlying Meldon-Slate-with-Lenticles Formation. The Meldon-Slate-with-Lenticles Formation exhibits early ?D1 isoclines deformed by later more open D2 structures. As the Meldon Shale and Quartzite Formation exhibits only open folds, it is possible that the boundary between the two formations is a thrust. Further investigation is needed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2327 ,
        namedrockunit:H2945 ,
        namedrockunit:H3562 ,
        namedrockunit:H77 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "126 to 161m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of internally structureless black argillaceous limestone beds, with subordinate black cherts and siliceous mudstones and mudstones of the overlying Teign Chert Formation above the thin-bedded mudstones and quartzites of the Meldon Shale and Quartzite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Culm Measures [Obsolete: use BPLM, MQF, NCH, TEVY, WCH]"@en ,
        "Lower Shale and Quartzite Group [Obsolete: use MQF]"@en ,
        "Upper Shale and Quartzite Group [Obsolete: use MQF]"@en ,
        "Volcanic Group [Obsolete: use MQF]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Mudstone and quartzite with subsidiary agglomerate, hornfelsed mudstone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MQF"@en ;
    skos:prefLabel "Meldon Shale and Quartzite Formation"@en ;
.

namedrockunit:MRD
    a skos:Concept ;
