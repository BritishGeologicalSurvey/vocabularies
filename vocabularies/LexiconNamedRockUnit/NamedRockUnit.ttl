namedrockunit:WRCG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises a sheet of interbedded gravels, sands, silts and clays. The gravels are dominated by flint (up to c.80%) and by quartz and quartzite (up to c.60%), with far-travelled minor lithogies including Carboniferous chert, Rhaxella chert, Greensand chert, Spilsby Sandstone and felsic volcanic rocks from North Wales. The deposits are interpreted as estuarine and near-shore marine."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformable on the Norwich Crag, from which it can be distinguished by the generally coarser and less well sorted nature of the sediments and by the presence of significant quantities of quartz, quartzite and far-travelled clasts in the gravels. The formation cuts down through the Norwich Crag northwards and comes to rest on Chalk Group bedrock in north Norfolk."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H216 ,
        namedrockunit:H3143 ,
        namedrockunit:WCG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QV> ;
    lexicon:hasOldestAgeValue 2e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Widely overlain by Mid Pleistocene glacial deposits, less widely by deposits of the Bytham Valley Subgroup and the Cromer Forest-bed Formation. It is distinguished from the latter units by sedimenrary, etc, features related to its marine origin."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QC> ;
    lexicon:hasYoungestAgeValue 4.8e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bure Valley Beds [Obsolete: use DOBP, WRCG]"@en ,
        "Cromer Forest Bed Series [Obsolete: use WRCG]"@en ,
        "Weybourne Crag [Obsolete: use DOBP, WRCG]"@en ;
    skos:broader namedrockunit:CRAG ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Pre-Pastonian/Baventian Stage - to - Cromerian Stage (Quaternary Period) (2-.48 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DOBP ,
        namedrockunit:HOWH ,
        namedrockunit:MUND ,
        namedrockunit:RUNTO ;
    skos:notation "WRCG"@en ;
    skos:prefLabel "Wroxham Crag Formation"@en ;
