    lexicon:hasThicknessDescription "Up to c.10 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Placed at top of sand or gravel, where overlain by White House Silts or Coddington Till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
