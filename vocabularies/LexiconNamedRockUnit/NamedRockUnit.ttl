namedrockunit:RHD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey, thinly bedded, very fine-grained dolostone, with subordinate beds of dark grey limestone comprising calcilutite and calcisiltite, mudstone,  in which fenestral cavities are common, breccias and several thin beds of coarse-grained quartzitic sandstone. The variably bedded argillaceous limestone or dolostone, has a marine fauna of crinoids and brachiopods, alternating with dolostone containing penecontemporaneous breccias, sparse gastropods, serpulid and ostracod fauna."@en ;
    lexicon:hasLowerBoundaryDefinition "The top of a red-brown sandstone, pebbly sandstone and conglomerate of the Redhouse Sandstone Formation, displaying a sharp passage into grey dolostone of the overlying Rue Hill Dolomite Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1789 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as 84.47 m thick in the Caldon Low Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "A conformable passage into medium grey biosparites or dark grey cherty micrites of the Milldale Limestone Formation, with the boundary at the top of unfossiliferous porcellaneous dolostone above the highest occurrence of the ostracod-gastropod fauna."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rue Hill Dolomites [Obsolete: use RHD]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolostone with subsidiary limestone and mudstone and trace sandstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage - to - Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RHD"@en ;
    skos:prefLabel "Rue Hill Dolomite Formation"@en ;
.

