    skos:definition "Calcilutite with subsidiary mudstone and silty mudstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WAB"@en ;
    skos:prefLabel "Wattonensis Limestone Member"@en ;
