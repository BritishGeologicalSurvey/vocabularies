        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded schistose semipelite and micaceous psammite in roughly equal proportions"@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional with underlying micaceous psammites of the Loch Laggan Psammite Formation.Marked by increase in semipelite and thin-banded micaceous psammite content."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "770m in type area."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp to transitional with thinly bedded feldspathic and micaceous psammites of the Creag Meagaidh Psammite Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
