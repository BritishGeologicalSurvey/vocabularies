    lexicon:hasOldestAgeValue 4.452e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Thickness in the southern Lake District is 40 to 120 m, whereas up to 140 m are present in the Howgill Fells, but only 35 m in the Craven inliers."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by the base of the overlying Brathay Mudstone Formation (Tranearth Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
