namedrockunit:THNC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithologyDescription "The code was originated for use in describing Quaternary Domains in the Sellafield (Cumbria) area. To avoid potential confusion it should be used only for similar purposes in future. See also THN and THNX. Note that on the related Quaternary Domains map, this category was described as: \"Thin till on rock (generally <5m), Overlying sedimentary cover, ie Carboniferous, Permo-Trias\"."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:THN ;
    skos:definition "Superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THNC"@en ;
    skos:prefLabel "Till, thin, overlying sedimentary cover [see descriptions for limitations of use]"@en ;
.

namedrockunit:THNX
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithologyDescription "The code was originated for use in describing Quaternary Domains in the Sellafield (Cumbria) area. To avoid potential confusion it should be used only for similar purposes in future. See also THN and THNC. Note that on the related Quaternary Domains map, this category was described as: \"Thin till on rock (generally <5m), Overlying pre-Carboniferous rocks, mostly igneous and metamorphic\"."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
