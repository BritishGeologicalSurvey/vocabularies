namedrockunit:BRYS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive, grey Waulsortian reefs, comprising dolomitised carbonate mudstone with locally abundant spar-filled fenestrae (stromatactoid structure) and sparse crinoid debris. Reefs are locally overlain by and pass into a flank facies comprising thin-bedded dark limestones and dolomites with cherts and thin mudstones. Stratigraphic position of flank facies uncertain and requires further investigation."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at gradational boundary between medium- to thick-bedded crinoidal argillaceous packstones with chert nodules and shaly partings of the underlying Black Rock Limestone Subgroup, and the dolomitized reef limestones of the Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "80 m at type section in south Pembrokshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at junction of massive dolomitised reef limestones of the Formation and the overlying dark limestones with thin mudstones and cherts of the Linney Head Formation. Where the top of the Formation is in flank facies, the boundary is imprecise but taken at the increase in chert content at the base of the Linney Head Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Dolostone with subsidiary limestone and mudstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRYS"@en ;
    skos:prefLabel "Berry Slade Formation"@en ;
.

