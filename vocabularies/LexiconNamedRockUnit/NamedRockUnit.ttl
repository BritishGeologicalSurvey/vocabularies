namedrockunit:SKDL
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Skiddaw Lava Member consists predominantly of plagioclase-macrophyric basalt (of 'Markle' type) and composite lavas with some plagioclase-microphyric basalt (of 'Jedburgh' type). In the east of the outcrop [NS 6572 9122], the member includes a composite lava composed of massive, rounded bodies mostly of macroporphyritic basalt, but also includng near the centre of the lava some transitional plagioclase-microphyric to olivine-microphyric basalts, in a matrix of slaggy, highly vesicular microporphyritic basalt."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal basalt of the member unconformably overlies sedimentary rocks, including sandstone, siltstone and mudstone of the Clyde Sandstone Formation, of the Inverclyde Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-37 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Skiddaw Lava Member is overlain unconformably by the Slackgun Volcaniclastic Member. The lithological change is from transitional plagioclase-macrophyric to plagioclase-microphyric basalt lava or composite basalt lava to a dull red 'bole' reflecting prolonged weathering of the lavas below."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKDL"@en ;
    skos:prefLabel "Skiddaw Lava Member"@en ;
.

