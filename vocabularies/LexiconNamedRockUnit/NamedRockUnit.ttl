    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 120 m; maximum thickness at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "Typically, conformable passage from the succession of lithoclast breccias and boulder beds, packstones, floatstones, grainstones into the overlying dark grey mudstones of the Phynis Mudstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Salthill Cap Beds [Obsolete: use LMKL]"@en ,
        "Thornley Reef Conglomerate [Obsolete: use LMKL]"@en ;
    skos:broader namedrockunit:HOM ;
