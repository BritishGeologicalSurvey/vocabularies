    lexicon:hasThicknessDescription "Maximum thickness is about 220m in East Fife"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is at the base of the Hurlet Limestone (base of Lower Limestone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
