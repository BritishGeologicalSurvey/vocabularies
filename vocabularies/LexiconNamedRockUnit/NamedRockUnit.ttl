    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "5m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at an irregular palaeokarstic surface cut in buff dolostone of the Formation, overlain by pale grey ooidal grainstones of the Pwll-y-Cwm Oolite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bed 1 [Obsolete: use SYCN]"@en ,
        "Pwll-Y-Cwm Oolite [Obsolete: use SYCN]"@en ;
    skos:broader namedrockunit:CLD ;
    skos:definition "Dolostone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SYCN"@en ;
    skos:prefLabel "Sychnant Dolomite Formation"@en ;
.

