    lexicon:hasThicknessDescription "0.6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, glacitectonic contact with stiff, stony sand/clay diamicton of the overlying Athais Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Allt Odhar Peat Formation [Obsolete: use AOPT]"@en ,
        "Odhar Peat Formation [Obsolete: use AOPT]"@en ;
    skos:broader namedrockunit:MBP ;
    skos:definition "Peat with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AOPT"@en ;
    skos:prefLabel "Allt Odhar Peat Member"@en ;
