    lexicon:hasThicknessDescription "180.90 m in Byley borehole (SJ 76 NW/7)."@en ;
    lexicon:hasUpperBoundaryDefinition "Top of highest substantial laminated greenish grey and reddish brown bed in this formation; base of Wych Mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasYoungestAgeValue 2.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
