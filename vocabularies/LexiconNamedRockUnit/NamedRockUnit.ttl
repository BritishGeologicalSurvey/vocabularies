namedrockunit:STPL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, thick-bedded skeletal and oolitic limestones; scattered cherts and silicified fossils; local dolomitisation. Dark grey, thinner-bedded limestones are common in the lower part. Pale grey oncolitic limestones and calcite mudstones are common in the uppermost part. Deposited in front barrier, barrier and back barrier settings."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the gradational boundary between the dark grey interbedded wackestones and mudstones of the underlying Pen-y-holt Limestone Formation and the pale grey thick-bedded skeletal and oolitic limestones of the Formation. Boundary taken at base of first oolitic limestone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "260m at type locality in southwest Pembrokeshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the outgoing of pale grey calcite mudstones of the Formation and the incoming of mottled [pseudobrecciated] skeletal packstones and palaeokarstic surfaces of the overlying Oxwich Head Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Limestone with subsidiary dolomitic limestone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Holkerian Substage (Carboniferous Period) (344.5-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STPL"@en ;
    skos:prefLabel "Stackpole Limestone Formation"@en ;
.

