namedrockunit:BCHN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithology is a thinly bedded silt clay with many laminae and thin bands of silt and locally of sand. The deposits are brown, brownish grey and reddish brown, and are conspicuously colour banded, the banding being emphasised by the grey clay units. The consistency varies from soft to stiff and the deposits is of medium to high plasticity."@en ;
    lexicon:hasLowerBoundaryDefinition "The Buchanan Clay Member of the Clydebank Clay Formation rests with angular conformity on older Quaternary sediments. It is known to rest on the Gartocharn Till Formation (GATI) of the Caledonia Glacigenic Group (Midland Valley Glacigenic Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H675 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 7m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Buchanan Clay Member of the Clydebank Clay Formation is overlain conformably by younger Quaternary sediments of the Kilmaronock Silt Formation of the Britannia Catchments Group (Clyde Catchments Subgroup)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Buchanan Formation [Obsolete: use BCHN]"@en ;
    skos:broader namedrockunit:CBCL ;
