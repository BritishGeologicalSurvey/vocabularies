namedrockunit:KG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to very coarse-grained sandstone with shale pellets, feldspathic, massive or cross-bedded and frequently pebbly sandstone, shales and sandy shales, siltstone and sandstone with shale. Can be subdivided into the Lower and Upper Kinderscout grits throughout most of Yorkshire, where the Butterly Marine Band occurs between the sandstone leaves."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the lowermost thick sandstone of the Kinderscout Grit, which rests with an unconformable base upon a mudstone/siltstone dominated succession of the Millstone Grit Group (undivided) or Grindslow Shales of Derbyshire."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1590 ,
        namedrockunit:H3495 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasOldestAgeValue 3.22e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Approximately 170 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from sandstone of the Kinderscout Grit to a marine band containing Bilinguites gracilis of the Marsden Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasYoungestAgeValue 3.215e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kinderscout Grit Group [Obsolete: use HEBD, KG]"@en ,
        "Kinderscout Grit Series [Obsolete: use KG]"@en ;
    skos:broader namedrockunit:HEBD ;
    skos:definition "Mudstone, pebbly (gravelly) sandstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Kinderscoutian Substage (Carboniferous Period) (322-321.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KG"@en ;
    skos:prefLabel "Kinderscout Grit"@en ;
.

