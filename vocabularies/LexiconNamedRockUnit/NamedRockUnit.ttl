        "Holt Heath Sand and Gravel [Obsolete: use HHSG]"@en ,
        "Main Terrace [Obsolete: use HOHE, MNT]"@en ,
        "Third Terrace (River Severn) [Obsolete: use MNT]"@en ;
    skos:definition "Obsolete name. Gravel with subsidiary sand and silt. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage - to - Devensian Stage (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MNT"@en ;
    skos:prefLabel "Main Terrace Deposits (River Severn) [Obsolete: use HOHE]"@en ;
