    lexicon:hasThicknessDescription "Up to 150m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable upward transition to dark grey Black Rock Limestone (or lateral equivalents).  (Crinoidal bioclastic limestones and dolomites)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
