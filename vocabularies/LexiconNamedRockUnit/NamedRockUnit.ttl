    lexicon:hasThicknessDescription "0 to 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "Passage upwards into the Wildmoor Sandstone Formation, the upper boundary being placed arbitrarily above the highest pebble bed in the sequence."@en ;
