    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Brook Formation [Obsolete: use SKCAT]"@en ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel, sand, silt and silty clay with subsidiary clay and trace peat and tufa. Stratified superficial deposits. Occurs onshore. Formed during the Cromerian Stage - to - Holocene Epoch (Quaternary Period) (.86-0 Ma BP)."@en ;
