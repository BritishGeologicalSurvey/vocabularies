namedrockunit:NSAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Striped/banded semipelite and pelite, part calcareous, with numerous limestone bands. Calc-silicate lenticles common in north. Thin dolomite bands also. South of River Don flaggy semipelites and micaceous psammites dominant and carbonate rare."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transition downwards to banded psammite-semipelite sequence (Ladder Hills Formation); south of River Don overlies Tornahaish Formation semipelite with carbonate."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum 1310m. Probably duplicated by folding - more likely thickness c. 500m."@en ;
    lexicon:hasUpperBoundaryDefinition "Lower limit of quartzite of Kymah Quartzite Formation or gradation to banded psammite-semipelite sequence (+ volcaniclastic horizons) of Ladder Hills Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DBIS ;
    skos:definition "Pelite and semipelite with subsidiary calcsilicate-rock, dolostone and limestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NSAL"@en ;
    skos:prefLabel "Nochty Semipelite And Limestone Formation"@en ;
.

