namedrockunit:WHS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "White, buff, yellow, orange and red to dark brown, generally unconsolidated fine- to medium-grained sand, with seams and irregular masses of limonite-cemented sandstone and rare siliceous or calcareous concretions, localized beds of grey to white silt and clay or mudstone, and rare ooidal limonitic ironstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is an unconformable contact with sands of the Whitchurch Sand Formation resting on limestone, calcareous sandstone or calcareous mudstones of the Haddenham Formation (formerly the Purbeck Limestone Formation) or on fossiliferous limestones or calcareous sandstones of the Portland Group, or rarely on mudstones or siltstones of the Kimmeridge Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1024 ,
        namedrockunit:H1274 ,
        namedrockunit:H2533 ,
        namedrockunit:H3762 ,
        namedrockunit:H4974 ,
        namedrockunit:SHS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 20m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is a discordant contact between the sands of the formation and overlying coarse gritty sandstones of the Lower Greensand Group, or calcareous mudstones of the Gault Formation. Mostly occurs as outliers without any succeeding strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Greensand [Obsolete: use WBS, LGS, WHS]"@en ,
        "Portland Purbeck [Obsolete: use WHS]"@en ,
        "Shotover Ironsands [Obsolete: use WHS]"@en ,
        "Shotover Sands [Obsolete: use WHS]"@en ,
        "Shotover Sands/Shotover Iron Sands [Obsolete: use WHS]"@en ,
        "Whitchurch Sands [Obsolete: use WHS]"@en ;
    skos:broader namedrockunit:W ;
    skos:definition "Sand with subsidiary mudstone and sandstone and trace ooid-ironstone. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age (Cretaceous Period) (137.7-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WHS"@en ;
    skos:prefLabel "Whitchurch Sands Formation"@en ;
.

namedrockunit:WIDS
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:EA ,
        namedrockunit:MARF ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The typical lithologies of the Windlesham Formation are bioturbated dark green to brown, fine- to medium-grained sands with sand-sized glauconite grains, silts and white, yellow or brown clay, overlain by organic dark grey clay with lenticles of fine sand, and then by glauconitic sand and sandy clayey silt. There are occasional layers of flint gravel, and a prominent gravel bed occurs at the top. Teeth and bones of marine vertebrates occur as do marine bivalve molluscs, although occurrences above the water table generally have been decalcified (Curry, 1958; Hawkins, 1954). \r
\r
Marine: inner shelf ranging up to marginal. \r
\r
Eocene (early to mid Lutetian) (King, in prep.)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Windlesham Formation is taken at an interburrowed omission surface on the top of the Swinley Clay Member, or on sands of the Bagshot Formation, marking an upwards change from a dominantly sandy sequence without glauconite to a darker-coloured sandy sequence with glauconite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BGBM ,
        namedrockunit:H2010 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 25 m (Ellison and Williamson, 1999)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Windlesham Formation is marked by the upwards change from dark-coloured sand and sandy, clayey silt to fairly homogeneous, yellow-brown silty fine-grained sands of the Camberley Sand Formation, probably at an omission surface (King, in prep.)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bracklesham Beds [Obsolete: use WIDS, BRB]"@en ,
        "Earnley Sand Formation"@en ,
        "Marsh Farm Formation"@en ,
        "Middle Bagshot Beds [Obsolete: use WIDS]"@en ;
    skos:broader namedrockunit:BRB ;
    skos:definition "Clay, sand and silt with subsidiary gravel. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:STHP ,
        namedrockunit:SUSA ;
    skos:notation "WIDS"@en ;
    skos:prefLabel "Windlesham Formation"@en ;
.

namedrockunit:WLSF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLateralEquivalent
        namedrockunit:BNS ,
        namedrockunit:SBS ,
        namedrockunit:SMBA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the Cheshire Basin and northwards into Cumbria, the formation comprises red-brown to brick-red, fine- to medium-grained, generally pebble-free, cross-bedded sandstones, with sporadic siltstones. The sand grains are well rounded and indicate an aeolian origin; in Cumbria, they are coarse- to very coarse-grained. There are thin units of fluvial sandstones that have subangular to subrounded sand grains and more common beds of mudstone. Southwards, these pass into bright orange-red to dark brick-red, generally silty or argillaceous, fine- to medium-grained, micaceous sandstones with subordinate siltstone and mudstone beds. The sand grains are subangular to subrounded and pebbles are rare."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary, at the top of a sequence dominated by pebbly sandstones and conglomerates of the Chester Formation, is transitional. It may be taken at the highest occurrence of pebbles, either as a conglomerate or a pebbly sandstone. In Cumbria it is sharp and is taken at the upward change to typical aeolian sandstones from typical fluvial sandstones, which are finer grained and better cemented."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CSA ,
        namedrockunit:UMS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasOldestAgeValue 2.499e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Thicknesses are variable across the country. In Cumbria the Sellafield boreholes proved 469 to 529 m. In the West Midlands and the Worcester Basin it is up to 284 m thick. In the Cheshire Basin, in the Knutsford Borehole, pebbles indicative of the Chester Formation were encountered at 1870 to 1878 m depth, giving a thickness of about 920 m for the Wilmslow Sandstone; this includes 325 m of strata below the 'Top Silicified Zone' which, in the EISB and regions 8 and 9, has been used to mark the base of the Wilmslow Sandstone Formation (Jackson et al., 1987)."@en ;
    lexicon:hasUpperBoundaryDefinition "It is overlain unconformably by the Helsby Sandstone Formation. In Cumbria, it is placed at the top of a thick (40 to 50 m) fluvial sandstone unit that is well-cemented and overlain by coarser, less well-cemented aeolian sandstones of the Helsby Sandstone Formation. It is not a formational boundary with characteristic features on borehole geophysical logs."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bunter Sandstone Formation"@en ,
        "Calder Sandstone Formation [Obsolete: use WLSF]"@en ,
        "Smith Bank Formation"@en ,
        "St Bees Sandstone Member"@en ,
        "Upper Mottled Sandstone [Obsolete: use THUN, WLSF, WRS]"@en ;
    skos:broader namedrockunit:SSG ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Olenekian Age (Triassic Period) (249.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WRS ;
    skos:notation "WLSF"@en ;
    skos:prefLabel "Wilmslow Sandstone Formation"@en ;
.

namedrockunit:WLT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pale, yellowish grey, to grey-weathered, garnetiferous, massive silicic tuff and eutaxitic lapilli tuff, with subordinate foliated vitrophyric tuff, and bedded units of lithic-rich tuff and lapilli-tuff. Lithologically distinctive units have member status."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the abrupt change to silicic pyroclastic rocks from andesite of the Birker Formation or the volcaniclastic rocks of the Scalehow Formation."@en ;
