namedrockunit:CARM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Within the Carmichael Inlier, comprises interbedded fine- and medium-grained red-brown to grey green sandstones, subordinate siltstones, mudstones and conglomerates containing mainly quartzite, quartz, chert and igneous pebbles; greyish olive mudstones common towards the base with thin interbeds of fossiliferous siltstone and sandstone. The base is cut out by the Carmichael Fault, but part of the Group is repeated to the south of the fault in the Eastfield Inlier"@en ;
    lexicon:hasLowerBoundaryDefinition "Faulted out by the Carmichael Fault"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2052 ,
        namedrockunit:H3273 ,
        namedrockunit:H3901 ,
        namedrockunit:H4515 ,
        namedrockunit:H749 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "c.1000m"@en ;
    lexicon:hasUpperBoundaryDefinition "The incoming of the predominantly greywacke pebble bearing conglomerate belonging to the Greywacke Conglomerate Formation overlying fine- and medium- grained sandstones, siltstones and mudstones forming the Carmichael Group"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Carmichael Burn Group [Obsolete: use CARM, CMBN]"@en ,
        "Eastgate Formation [Obsolete: use CARM, EGT, WGAT]"@en ,
        "Fence Conglomerate [Obsolete: use WGAT, CARM, FEN]"@en ,
        "Kirkhill Conglomerate [Obsolete: use CARM]"@en ,
        "Newside Arenite [Obsolete: use NWA, CARM, WGAT]"@en ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Llandovery Epoch - to - Wenlock Epoch (Silurian Period) (443.1-426.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
