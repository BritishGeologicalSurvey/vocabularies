namedrockunit:HYMU
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Hard dark blue-grey or bluish green-grey, generally mottled, silty shales and mudstones. Calcareous bands and nodules, and calcareous shales and mudstones occur near the top, together with a calcareous siltstone (locally yielding trilobite and pelagic ostracod faunas). Within the metamorphic aureole of the Dartmoor Granite, calc-flints and hornfels are developed and siliceous nodules are characteristic of the lower parts of the Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3484 ,
        namedrockunit:H4719 ,
        namedrockunit:HYSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "250m+"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the gradational incoming of grey and green micaceous shales of the overlying Trusham Mudstone Formation above the dark blue or bluish green mottled shales and calcareous beds of the Hyner Mudstone Formation. Commonly this boundary cannot be detected in the metamorphic aureole of the Dartmoor Granite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hyner Formation [Obsolete: use HYMU, HYSH]"@en ,
        "Hyner Shale Formation [Obsolete: use HYMU]"@en ,
        "Hyner Shale [Obsolete: use HYMU, HYSH]"@en ;
    skos:definition "Mudstone with subsidiary calcareous mudstone and trace siltstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (371.1-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "HYMU"@en ;
    skos:prefLabel "Hyner Mudstone Formation"@en ;
.

