namedrockunit:GVCS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, pale orange-brown, medium-grained, in part coarse-grained, micaceous, thick-bedded; mostly apparently massive, though with some cross bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "Lower boundary is sharp and erosional, with sandstone resting either on grey, micaceous, sandy, siltstones overlying Eumorphoceras ferrimontanum Marine Band, or on mudstone of the marine band itself."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2222 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 5m, but variable."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper boundary is seen only in right tributary to Sapling Clough  [SD627 564] on Brennand Fell, where top 0.5m of the Member is micaceous and laminated with large lenticuler ferruginous concretions and grades rapidly upwards into grey micaceous sandy siltstones of the Roeburndale Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gavells Clough Sandstone Member [Obsolete: use GVCS]"@en ;
    skos:broader namedrockunit:RBL ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GVCS"@en ;
    skos:prefLabel "Gavells Clough Sandstone"@en ;
.

namedrockunit:GVLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Garvald Lava Member consists, from the top down, of plagioclase-microphyric basalts or trachybasalts (basalts or hawaiites of 'Jedburgh' type), an olivine-augite-plagioclase-macrophyric trachybasalt (hawaiite of 'Dunsapie' type), a prominently exposed microporphyritic basaltic trachyandesite (mugearite), two plagioclase-macrophyric trachybasalts (hawaiite of 'Markle' type), and a plagioclase-microphyric trachybasalt (hawaiite of 'Jedburgh' type) with pillow structures, indicating subaqueous emplacement. The source is thought to be local, either a neck exposed in the River Carron, north-east of Northshields [NS 779 840] or some other obscured source (Craig, 1980)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is not seen, due to faulting."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H298 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "More than 50 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Garvald Lava Member is overlain with angular unconformity by the Kirkwood Formation of the Strathclyde Group. In the Garvald Burn section [NS 781 838], the lithological change is from plagioclase-microphyric basalt or trachybasalt to volcaniclastic conglomerates and sandstones, which rest on progressively older lavas of the Garvald Lava Member towards the south."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Garvald Lavas [Obsolete: use GVLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Hawaiite with subsidiary basalt and mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GVLA"@en ;
    skos:prefLabel "Garvald Lava Member"@en ;
.

