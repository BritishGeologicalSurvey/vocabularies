    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not defined."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp incoming of coarse silty mudstones with silt laminae or slumped mudstones, above burrowed mottled mudstones of the Doldowlod Conglomerate (Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Camlo Hill Group [Obsolete: use NTM]"@en ;
    skos:definition "Silty mudstone with subsidiary conglomerate, mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Ashgill Series (Ordovician Period) (449.75-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
