namedrockunit:FHMS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish-brown, ferruginous, cross-bedded, shell-fragmental, medium- to coarse-grained, clean sandstone. There are scattered pebbles, bands of conglomeratic grit and minor horizons of mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with the underlying Baulking Sand Member, marked by the upward facies change from the predominantly mudstone facies of the upper part of the Baulking Sand Member, to the ferruginous sandy facies of the Fernham Sand Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H248 ,
        namedrockunit:H2801 ,
        namedrockunit:H3402 ,
        namedrockunit:H3403 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 24 m in the Furze Hill Borehole SU29SE/16 [2905 9281] (Poole et al., 1971)."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen. The Fernham Sand Member occurs as hill-cappings in the Baulking area. The top of the member is locally defined by the depth of the present-day weathered zone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Division 4 (sands with chert and ironstone) [Obsolete: use FHMS]"@en ,
        "Ferruginous Sands and Sandstones [Obsolete: use FHMS]"@en ,
        "Furze Hill Sandstone Formation [Obsolete: use FHMS]"@en ,
        "Red Sands of Uffington [Obsolete: use FHMS]"@en ;
    skos:broader namedrockunit:FDNS ;
    skos:definition "Ferruginous sandstone and shelly sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FHMS"@en ;
    skos:prefLabel "Fernham Sand Member"@en ;
.

namedrockunit:FLH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANDTFF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Andesitic tuff and lapilli-tuff (eutaxitic to parataxitic). At least three welded ignimbrite sheets, locally separated by thin beds of sandstone. Side Farm Member comprises poorly sorted beds of lapilli-tuff and pyroclastic breccia."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the sequence of homogeneous, thick, generally lithic - poorly welded tuffs, above the Brown Bank Ignimbrite Formation, which is composed of thinner sheets of lithic-rich andesite and rhyolitic lapilli tuff. Locally a coarse lithic-rich lag-breccia occurs at the base of the lowest member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3406 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "403m in type section; 506m in Sellafield BH No.4 (NY00SE/29). Thicknesses are incomplete and uncorrected for dip, as boreholes deviated from vertical."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen, but mapped at the change from densely welded tuff to a mixed sequence of lithic-rich tuff and parataxitic tuff of the Loweray Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fleming Hall Formation [Obsolete: use FLH]"@en ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Andesitic tuff and lapilli-tuff with subsidiary breccia and trace volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LOFA ,
        namedrockunit:SIFA ,
        namedrockunit:TOEF ;
    skos:notation "FLH"@en ;
    skos:prefLabel "Fleming Hall Tuff Formation"@en ;
.

namedrockunit:FO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CSSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In Sussex, Kent and Surrey the formation comprises medium- and coarse-grained, well-sorted cross-bedded sands and weakly cemented sandstones; elsewhere includes calcareous sandstones. There are no formal divisions in the Weald, but equivalent beds in the west are termed the Child Okeford Sand Member and the Bedchester Sands Member."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is the contact of sand or sandstone of the formation with underlying silty clay or clayey silt of the Marehill Clay Member (Sandgate Formation) or with a heterogeneous succession of clays, silts and sands (Sandgate Formation, undifferentiated). This boundary can be diffuse in places but is generally marked by a colour change."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1545 ,
        namedrockunit:H2190 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Between 0.5 and 80 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is generally placed at the upward disappearance of sand at the base of the Gault Formation. In places the top is at the base of a thin pebbly sandy clay condensed succession at the base of the Gault Formation. In Sussex the top of the formation is at the base of the \"Iron Grit\" (a hard, pebbly, limonitic, coarse-grained sandstone) (see Casey, 1961)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Folkestone Beds [Obsolete: use FO]"@en ,
        "Folkestone Sands [Obsolete: use FO]"@en ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Sand and sandstone with subsidiary calcareous sandstone and trace clay, coarse silicate-sandstone and gravel. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age - to - Albian Age (Cretaceous Period) (121.4-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BEDS ,
        namedrockunit:CHOS ;
    skos:notation "FO"@en ;
    skos:prefLabel "Folkestone Formation"@en ;
.

namedrockunit:FOTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamicton, sandy, silty and clayey, typically dark grey to olive grey and grey brown, often weathered and mottled in the upper parts to orange, brown and yellow, cobble and boulder sized-clasts include Devonian flagstones, Jurassic and Lower Cretaceaous mudstones, siltstones, sandstones and shell fragments together with Moine metamorphic and Caledonian igneous rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock."@en ;
