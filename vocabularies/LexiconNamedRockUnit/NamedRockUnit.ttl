    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SKG ;
    skos:definition "Mudstone, sandstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tremadoc Series - to - Arenig Series (Ordovician Period) (486.5-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GGM ,
        namedrockunit:RNM ;
    skos:notation "BUF"@en ;
    skos:prefLabel "Buttermere Formation"@en ;
