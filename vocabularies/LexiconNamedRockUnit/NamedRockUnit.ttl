namedrockunit:ERSK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The typical lithology is of very silty clay with sand and silt laminae and bands. The deposit is generally brownish grey of greyish brown and contains sulphide. The sand and silt is ripple-laminated in places. Isolated cobbles and gravel are present, and organic debris is also to be found. The deposit is of firm to soft consistency and medium plasticity."@en ;
    lexicon:hasLowerBoundaryDefinition "The Erskine Clay Member of the Clydebank Clay Formation rests with angular unconformity on older Quaternary sediments or on bedrock. It is known to rest unconformably on the Inverleven Gravel Member of the Clyde Clay Formation and possible disconformably on the Endrick Sand Member of the Strathendrick Formation (Clyde Catchments Subgroup)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H893 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Erskine Clay Member of the Clydebank Clay Formation is overlain by younger Quaternary sediments, normally the Gourock Sand Member. It is also exposed at the surface in the lower Clyde valley."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Erskine Formation [Obsolete: use ERSK]"@en ;
    skos:broader namedrockunit:CBCL ;
    skos:definition "Clay, silt and silty clay with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ERSK"@en ;
    skos:prefLabel "Erskine Clay Member"@en ;
.

namedrockunit:EVSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale yellowish brown fine- to medium-grained quartzose sand, which coarsens upwards into pebbly sand and then into gravel. Coal debris is a common component and microfaults, shears and cracks (lined with reddish brown silt and clay) are characteristic of its upper few metres. It forms part of the infill of the buried valleys of the Ehen, Calder and lower Uldale. Cross-lamination within the sand indicates that it was deposited by southward directed braided outwash streams on sandur, probably during the deglaciation of the main Late Devensian ice sheet."@en ;
    lexicon:hasLowerBoundaryDefinition "At its type site a gradational contact on to the Ehen Valley Silt Member of the Seascale Glacigenic Formation. Elsewhere it overlies either the Catgill Wood Sand and Gravel Member, which is typified by rounded cobbles of red (Permian) and yellow (Carboniferous) sandstone, or the Low Wath Till Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H122 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically between 9.0 and 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally unconformably overlain by diamictons of the Roythersyke Till Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Sands and Gravels [Obsolete: use GFSA, SEAG, CGWD, LOGG, PLSG, PFS, EVSI, THBG, EVSG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Sand with subsidiary gravel and trace silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EVSG"@en ;
    skos:prefLabel "Ehen Valley Sand And Gravel Member"@en ;
.

namedrockunit:EVSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine-grained sand, silt and clay, greyish brown to dark grey, typically fines downwards and contains much finely disseminated coal debris; generally thickly laminated. Thin diamictons present in thick silt sequences recorded in boreholes. It forms part of the infill of the buried valleys of the Ehen Calder and Lower Uldale and was laid down principally in a glaciolacustrine environment, probably during the deglaciation of the main Late Devensian ice sheet."@en ;
    lexicon:hasLowerBoundaryDefinition "At its type site conformable on the Catgill Wood Sand and Gravel Member of the Seascale Glacigenic Formation, elsewhere conformable with diamictons of the Low Wath Till Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H122 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "8.7m exposed at its type section; 21.25m thick in reference section (Nirex borehole QBH 21; BGS registered borehole NY01SW 602)."@en ;
    lexicon:hasUpperBoundaryDefinition "At its type site a gradational contact into the Ehen Valley Sand and Gravel Member of the Seascale Glacigenic Formation. Elsewhere it is conformably overlain by diamictons of the Rothersyke Till Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Sands and Gravels [Obsolete: use GFSA, SEAG, CGWD, LOGG, PLSG, PFS, EVSI, THBG, EVSG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Silt with subsidiary sand and trace diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EVSI"@en ;
    skos:prefLabel "Ehen Valley Silt Member"@en ;
.

