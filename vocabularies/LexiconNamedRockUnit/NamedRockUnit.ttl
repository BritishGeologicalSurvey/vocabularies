    lexicon:hasThicknessDescription "Up to 0.3 m; 0.12 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into bluish grey, shaly mudstone of the undifferentiated Beckingham Member; at 38.50 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
