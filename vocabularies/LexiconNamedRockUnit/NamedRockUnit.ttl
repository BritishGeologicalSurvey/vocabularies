namedrockunit:FYL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:S156 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, dark grey, argillaceous, becoming grey compact towards base. In the south, fine-grained with thin evenly bedded mudstone parting with many fossils. In the north, becoming increasingly crinoidal and locally characterised by coarse crinoidal debris. Intercalated thin unit (to 2.1m) of black fossiliferous calcareous mudstone, which divides the member into two parts. Styolitic particularly near base (Johnson et al, 1996). On Dun Fell the limestone has yielded goniatites indicating the P2b biozone (Johnson and Dunham, 1963)."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp base of limestone overlying measures within the Alston Formation; directly underlain by burrowed, current and ripple-bedded, medium-grained sandstone; a thin coal is present in places."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3412 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
