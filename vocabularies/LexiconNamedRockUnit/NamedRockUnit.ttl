        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly calcareous siltstone and calcareous mudstone, with nodules, beds and members of mostly impure limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the calcareous siltstone succession or volcanogenic sedimentary succession (Low Scales Beck Member) that rests directly on the underlying Borrowdale Volcanic Group succession."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4728 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasOldestAgeValue 4.4925e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "120-150m (Rose and Dunham, 1977 - see bibliography)"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of calcareous siltstone succession that is succeeded by either nodular bedded, micritic limestone of the Broughton Moor Formation or rhyolitic tuff that forms the High Haume Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OU> ;
    lexicon:hasYoungestAgeValue 4.4875e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "High Haume Mudstone [Obsolete: use KKB]"@en ;
    skos:broader namedrockunit:DNT ;
    skos:definition "Calcareous mudstone and calcareous siltstone with subsidiary limestone and trace sandstone. Stratified bedrock. Occurs onshore. Deposited during the Cautleyan Stage (Ordovician Period) (449.25-448.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AP ,
        namedrockunit:KENT ;
    skos:notation "KKB"@en ;
    skos:prefLabel "Kirkley Bank Formation"@en ;
.

namedrockunit:KLMD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mostly dark grey mudstone with ironstone, sporadic shelly marine bands, and also siltstone, medium-grained rooty grey sandstone and coal. The strata occur in upward-coarsening cycles, some capped by thin coal beds. The member includes the Dalry Clayband Ironstone, a grey argillaceous ironstone, and the Johnstone Shell Bed mudstone, with a marine brachiopod and bivalve fauna."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the top of the Top Hosie Limestone, the highest group of thin limestones characterized by the presence of Posidonia corrugata."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1625 ,
        namedrockunit:H2759 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the lithological change from mudstone of the Kilbirnie Mudstone Member to the overlying dominantly sandstone-bearing cyclical sequences of the parent Limestone Coal Formation. The upper boundary is diachronous."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kilbirnie Mudstone Formation [Obsolete: use KLMD]"@en ,
        "Limestone Coal Group [Obsolete: use DLST, LSC, KLMD]"@en ;
    skos:broader namedrockunit:LSC ;
    skos:definition "Mudstone with subsidiary ironstone and trace coal, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DYCI ;
    skos:notation "KLMD"@en ;
    skos:prefLabel "Kilbirnie Mudstone Member"@en ;
.

namedrockunit:KLSL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark to medium light grey, thick to thin-bedded, bioclastic limestone with mudstone beds and partings.."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of dark grey limestones with mudstone partings of the Scaleber Force Limestone Member (of the Kilnsey Formation) where it rests sharply and conformably on paler grainstone of the Chapel House Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1626 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 224m in boreholes south of the Middle Craven Fault. The Formation thins rapidly northwards to 53m in the Kilnsey area."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from mid dark-grey limestone of the Scalebar Quarry Limestone Member (of the Kilnsey Formation) into pale grey limestone of the Cove Limestone Member, Malham Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kilnsey Limestone [Obsolete: use SQLM, KLSL]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Holkerian Substage (Carboniferous Period) (344.5-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:SFLM ,
        namedrockunit:SQLM ;
    skos:notation "KLSL"@en ;
    skos:prefLabel "Kilnsey Formation"@en ;
.

namedrockunit:KMR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DALTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A dacitic lapilli-tuff, with flow joints, localised breccia and some interbeds of tuff, lapilli-tuff and volcaniclastic sandstone. It is laterally impersistent, possibly filling hollows in an erosion surface, interpreted as a densely welded, rheomorphic high-grade ignimbrite."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the abupt change from volcaniclastic sedimentary rocks of the Seathwaite Fell Sandstone Formation to dacitic lapilli-tuff indicating an erosion surface, which is usually obscured by later, syn-BVG andesite intrusions."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2218 ,
        namedrockunit:H2270 ,
        namedrockunit:H943 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 350m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by eutaxitic lapilli-tuff of the Lincomb Tarns Tuff Fomration, but the relationships are obscured by later syn-BVG andesite intrusions."@en ;
