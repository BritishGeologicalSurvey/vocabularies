        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alluvial, pedogenesis and floodplain deposits (interpreted as cyclothems, Emeleus, 1997) are recorded in distinct red beds of fining upwards, arenaceous sediments, interbedded with cornstones. Not shown on 50K maps."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt transition to 'red beds' above the conglomerates of the Shellesder Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "40m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top underlies cross-stratified conglomerates of the Sgoarishal Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
