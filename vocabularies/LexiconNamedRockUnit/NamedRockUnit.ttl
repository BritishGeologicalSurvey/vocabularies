    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1 to 5 m (4.5 m in Cropwell Bridge Borehole, SK63NE/28)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the abrupt or rapid upward transition from interbedded green mudstone and pale grey fine-grained sandstone of the Cotgrave Sandstone Member to reddish brown structureless mudstone at the base of the Edwalton Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
