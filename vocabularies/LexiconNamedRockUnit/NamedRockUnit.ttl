namedrockunit:RSR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pinkish weathered, crystal-poor, flow-banded, flow-folded rhyolite with autobreccia at its base and top. It is interpreted as a coulee-type lava and is connected to an underlying intrusion."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the rhyolite or its autobreccia overlying volcaniclastic rocks of the main part of the Lingmell Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 130m"@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the base of overlying volcaniclastic rocks; in the west of the outcrop by pyroclastic rocks of the Lingmell Formation, but in the central and eastern parts of the outcrop by volcaniclastic sedimentary rocks of the Seathwaite Fell Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LME ;
