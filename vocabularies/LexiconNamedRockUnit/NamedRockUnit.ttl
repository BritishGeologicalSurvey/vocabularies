namedrockunit:ETSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold-phase sands and gravels that underlie the Etwall Terrace. Intensely cryoturbated, decalcified poorly sorted sand and gravel, dominated by rounded pebbles of "Bunter" quartz/quartzite (typically c.80%) with subordinate subangular flint (up to c.20%), Carboniferous chert, sandstone, etc. Fragmentary terrace surface appears to be c.20m above the Trent floodplain in the type area. The upper part locally includes a rubified palaeosol (Hykeham Soil; Ipswichian). The Member is correlated with the Ockbrook Sand and Gravel Member (Trent Valley Formation) and Knighton Sand and Gravel Member (Soar Valley Formation). \r
\r
River terrace deposits. Middle Pleistocene (MI Stage 8). The chronology is based in its position above the Eggington Common Member and below the assumed Eagle Moor Member."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2176 ,
        namedrockunit:H238 ,
        namedrockunit:H4642 ,
        namedrockunit:H896 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 3 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Etwall Member [Obsolete: use ETSG]"@en ,
        "Etwall Sand and Gravel [Obsolete: use ETSG]"@en ,
        "Hilton Gravel [Obsolete: use ETSG]"@en ,
        "Upper Hilton Terrace [Obsolete: use ETSG, OKSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ETSG"@en ;
    skos:prefLabel "Etwall Sand and Gravel Member"@en ;
