    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 2 to 6m. Type section; 5.3 to 5.6m. Maximum c.10m (Northleach area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward transition from limestones as in lithological description into ooidal shell-detrital grainstone (Crickley Member), or hardground overlain by Salperton Limestone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
