namedrockunit:NGT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:NOGR ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, grey to yellow to brown, fine-grained, sub-rounded grains, fairly well-sorted, argillaceous, in thick beds, with pervasive bioturbation (including Thalassinoides and Rhizocorallium). A bed with abundant sponge spicules forms a prominent calcareous cemented unit near the middle of the member. Large calcareous concretions (up to 1m) are common in many beds. Oysters, ammonites and serpulids occur in the sandstone. The uppermost part of the member (sensu BGS) is a 1.5m-thick bed of shelly, calcareous, medium-grained sandstone (Preston Grit Member of Wright, 1986), which is separated from the underlying succession by a sharp erosion surface, interpreted as a minor unconformity by Coe (1995)."@en ;
    lexicon:hasLowerBoundaryDefinition "The sharp, probably non-sequential, boundary with the underlying Oxford Clay Formation. This is marked by the upward change from the mudstone of the Oxford Clay to the sandstone of the Nothe Grit Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1084 ,
        namedrockunit:NTH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "10.5m (including the Preston Grit Member of Wright, 1986."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational boundary, over several centimetres, from calcareous sandstone of the uppermost Nothe Grit (= topmost Preston Grit Member of Wright, 1986) to sandy mudstone of the overlying Nothe Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
