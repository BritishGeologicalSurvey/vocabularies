namedrockunit:MNHD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly river terrace sand and gravel, Brickearth silt and alluvial floodplain silt, silty clay and sand. The formation includes interbedded units (representing Interglacials) of locally fossiliferous silty sand, silt, together with organic clay, tufa and peat. River terrace deposits of the middle and lower Thames contain gravel clasts mainly composed of flint, vein quartz and local bedrock lithologies including chert. The terrace deposits are depicted on British Geological Survey maps using numbered terrace symbols. Modern British Geological Survey maps also show the terrace deposits as named units which are here interpreted as members of the Maidenhead Formation. The main terrace deposit members are the Black Park Gravel, Boyn Hill Gravel, Lynch Hill Gravel, Hackney Gravel, Taplow Gravel, Kempton Park Gravel, Shepperton Gravel and Staines Alluvium. Brickearth silt beds include the Enfield Silt, Roding Silt, Langley Silt, Dartford Silt, Crayford Silt and Ilford Silt."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on glacigenic deposits of the Anglian stage or on older Pleistocene strata or bedrock. Individual terrace deposit members rest unconformably on older Pleistocene strata or bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H400 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Single terrace aggradations range from 3 to 12m. Interglacial beds (eg Trafalgar Square Beds) up to 12m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Thames Formation [Obsolete: use MNHD]"@en ;
    skos:broader namedrockunit:THCAT ;
    skos:definition "Gravel and sand with subsidiary silt and trace clay, peat and tufa. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
