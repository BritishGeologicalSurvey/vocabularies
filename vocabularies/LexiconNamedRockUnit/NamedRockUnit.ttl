namedrockunit:SQAR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey and brown medium- to coarse-grained peloid, ooid and shell fragment packstone and grainstone ('Upper Freestone'), with beds and lenses of grey to white, commonly highly fossiliferous marl/carbonate mudstone ('Oolite Marl'). These occur throughout the succession, though particularly in the lower part. Fauna dominated by brachiopods; characteristic fossils include the plicate terebratulid brachiopod Plectothyris."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change from ooid grainstone (Cleeve Cloud Member) to marl or limestone as described in lithology; junction marked by hardground."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3045 ,
        namedrockunit:H3046 ,
        namedrockunit:H3047 ,
        namedrockunit:H3691 ,
        namedrockunit:OOM ,
        namedrockunit:UFR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 5 to 10m. Type section; 2.4m (Mudge, D C, 1978a) to 3.6m (Baker, P G, 1981). Maximum c.30m (Colesbourne area)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward rapid transition to Harford Member generally by increasing sand and decreasing calcareous content, or: hardground overlain by Aston Limestone Formation or Salperton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasYoungestAgeValue 1.709e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Combined Oolite Marl and Upper Freestone [Obsolete: use SQAR]"@en ,
        "Oolite Marl Member [Obsolete: use SQAR]"@en ,
        "Oolite Marl Series [Obsolete: use SQAR]"@en ,
        "Oolite Marl [Obsolete: use SQAR]"@en ,
        "Scottsquar Hill Limestone Member [Obsolete: use SQAR]"@en ,
        "Upper Freestone [Obsolete: use SQAR]"@en ;
    skos:broader namedrockunit:BLPL ;
    skos:definition "Calcareous mudstone and limestone with subsidiary mudstone and trace sand. Stratified bedrock. Occurs onshore. Deposited during the Aalenian Age (Jurassic Period) (174.7-170.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SQAR"@en ;
    skos:prefLabel "Scottsquar Member"@en ;
.

