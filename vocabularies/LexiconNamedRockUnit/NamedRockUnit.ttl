namedrockunit:BKGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S617 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/L"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine- to coarse-grained gravel, cobbles and boulders (one recorded to be at least 1.8m across in an old excavation at Bo'ness), subangular to rounded with some striated, locally in a matrix that varies from loose sand to firm clayey sandy silt. Clasts of mainly locally-derived Carboniferous and Devonian lithogies. The deposit is poorly sorted. It is considered to have been deposited by ice-rafting of materials during the Loch Lomond Stadial."@en ;
    lexicon:hasLowerBoundaryDefinition "Markedly erosive base cut into the various members of the Forth Clay Formation, Wilderness Till Formation and bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1358 ,
        namedrockunit:H4468 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to at least 3.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by the early Holocene transgressive estuarine sand, silt and clay of the Letham Silt Member and also younger units including the Carse of Stirling Clay Member and later Claret Clay Member (Carse Clay Formation)."@en ;
