namedrockunit:ECG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lower part of the member is a white or grey, soft, friable calcite-cemented sandstone, rich in shell fragments. The quartz grains are subangular to moderately well-rounded. The upper part of the member is less bioclastic and includes very coarse-grained sandstone formed of polished rounded quartz grains in a matrix of finer sand, with calcite cement. Scattered glauconite occurs in the upper part, but is usually insufficient to colour the rock. Locally, lumps of chert occur in the member (e.g. Thorncombe, Dorset). The top of the member is a phosphatised hardground (possibly equivalent to the Small Cove Hardground). Records of Cenomanian ammonites (Kennedy, 1970) might be from burrow infills at the base of the overlying Grey Chalk Subgroup."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is a sharp contact between cemented calcareous shelly sandstone of the member with the underlying glauconitic fine- to medium-grained sand of the Boyne Hollow Chert Member (Upper Greensand Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H883 ,
        namedrockunit:S880 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 3m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary occurs at the top of the phosphatised Small Cove Hardground at the junction with the overlying glauconitic, calcarenite of the  Glauconitic Marl Member of the Grey Chalk Subgroup."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Calcareous Grit [Obsolete: use ECG]"@en ,
        "Eggardon Grit [Obsolete: use ECG]"@en ;
    skos:broader namedrockunit:UGS ;
    skos:definition "Calcareous sandstone, sandstone and shelly sandstone with subsidiary glauconitic sandstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Albian Age (Cretaceous Period) (113.2-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ECG"@en ;
    skos:prefLabel "Eggardon Grit Member"@en ;
.

