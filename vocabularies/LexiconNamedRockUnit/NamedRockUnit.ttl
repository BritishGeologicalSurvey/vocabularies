    lexicon:hasLithologyDescription """Sandstones with minor mudstones that have been placed into five formations: \r
Broom Formation; \r
Etive Formation; \r
Ness Formation; \r
Rannoch Formation; \r
Tarbert Formation."""@en ;
    lexicon:hasLowerBoundaryDefinition "Defined by the base of the Broom Formation where there is a downward change from sandstones to mudstones (of the Drake Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5177 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Up to 300 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the upper boundary of the Tarbert Formation where there is a down-section change from siltstones (Heather Formation) to sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Brent Formation [Obsolete: use BRNT]"@en ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Aalenian Age - to - Bathonian Age (Jurassic Period) (174.7-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BROM ,
        namedrockunit:ETVE ,
        namedrockunit:NESS ,
        namedrockunit:RANN ,
        namedrockunit:TARB ;
    skos:notation "BRNT"@en ;
    skos:prefLabel "Brent Group"@en ;
