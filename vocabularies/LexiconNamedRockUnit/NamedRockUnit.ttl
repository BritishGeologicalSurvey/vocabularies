namedrockunit:KPAN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Keuper Anhydrite Member comprises red, red-brown and grey-green mudstones with numerous beds of white to grey, transparent, crystalline anhydrite and some interbedded dolomite and siltstone. The member typically shows lower gamma-ray values and higher velocities than the overlying and underlying Triton Formation mudstones. The gamma-ray and velocity logs also display greater ranges in value and are more spikey in character."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Keuper Anhydrite Member is placed at the base of the main concentration of anhydrite interbeds in the Triton Formation. It is characterized by a marked downhole increase in gamma-ray values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TN> ;
    lexicon:hasOldestAgeValue 2.273e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The member varies in thickness from about 30 m, to the north of the Sole Pit Basin, to over 115 m in that basin."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Keuper Anhydrite Member is defined by a downward change from red-brown mudstones with some grey-green interbeds to a unit of similar mudstones with numerous interbeds of anhydrite and some thin dolomites and siltstones. The boundary corresponds to a downward decrease in gamma-ray values, compared with the overlying mudstones; an increase in velocity may be apparent at the same level."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TN> ;
    lexicon:hasYoungestAgeValue 2.057e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TTHY ;
    skos:definition "Anhydrite-stone and mudstone with subsidiary dolostone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Norian Age (Triassic Period) (227.3-205.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KPAN"@en ;
    skos:prefLabel "Keuper Anhydrite Member"@en ;
.

namedrockunit:KPB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and dark grey laminated mudstones and silty mudstones. A few calcareous nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp base on greywacke/siltstone sequence of the Castle Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Transition to greenish grey silty mudstone of the Blaeberry Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PRH ;
    skos:definition "Mudstone with subsidiary silty mudstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) (432.9-426.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KPB"@en ;
    skos:prefLabel "Kip Burn Formation"@en ;
.

namedrockunit:KPHA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALIST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Keuper Halite Member comprises halite, in beds up to 20 m thick, with interbeds of red-brown mudstone and anhydritic mudstone; halite constitutes up to 80% of the member in the Sole Pit Basin (Cameron et al., 1992). The member typically shows predominantly low gamma-ray values and high velocities, and the mainly parallel-sided log signature representative of halite; narrow peaks of high gamma-ray and lower velocity values correspond to mudstone interbeds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Keuper Halite Member is placed at the base of the main concentration of bedded halite within the Dudgeon Formation. It is characterized by an abrupt downward increase in gamma-ray values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasOldestAgeValue 2.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The member exceeds 150 m in the southern part of the Sole Pit Basin (Cameron et al., 1992), with over 200 m present in Block 49/26, but elsewhere varies mostly between 30 and 100 m in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Keuper Halite Member corresponds to the top of the Dudgeon Formation and is placed at a downward change from red-brown mudstones, with thin dolomite and anhydrite beds, of the Triton Formation, to halite. The boundary is marked by an abrupt downward decrease in gamma-ray values and a slight increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DGSL ;
    skos:definition "Halite-stone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Carnian Age (Triassic Period) (237-227.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KPHA"@en ;
    skos:prefLabel "Keuper Halite Member"@en ;
.

