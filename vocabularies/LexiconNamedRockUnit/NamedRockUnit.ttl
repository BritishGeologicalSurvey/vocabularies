namedrockunit:ASGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZSVB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SV"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A mixed assemblage of morainic and proglacial deposits. The morainic deposits occur both onshore and offshore and principally comprise heterogeneous clast-rich diamictons and interbedded gravels. The diamictons are commonly weak- to well-consolidated, grey to red-brown, up to boulder grade, clast-to-matrix supported, with a silty-sandy matrix composition, and mainly massive. They contain a diverse suite of clast lithologies, including Lewisian gneiss, Torridon Group sandstone, Eriboll Formation sandstone (quartzite), Moine Supergroup psammite, Durness Group limestone, Canisp porphy, Borralan syenite and other minor igneous rocks. The till is typically autochthonous, being largely derived from the underlying bedrock, however it may also contain reworked glaciofluvial and/or morainic deposits of Devensian age or older. Gently dipping stratified gravel units and debris-flow related deformation structures are commonly observed. Offshore, contemporary water-lain deposits include massive, grey and grey-brown colour-laminated clay and silty clay, containing sporadic gravel clast and in situ shelly material."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact on bedrock or Loch Broom Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ASTI ,
        namedrockunit:LLNN ,
        namedrockunit:SGTI ,
        namedrockunit:TRTI ,
        namedrockunit:UPTI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Locally up to 100 m thick offshore; mostly <10 m onshore."@en ;
    lexicon:hasUpperBoundaryDefinition "Onshore it is overlain locally by Holocene peat or fluvial deposits; offshore, it commonly occurs at or near to sea bed (below a Holocene lag), though it is overlain by the Annat Bay and Summer Isles formations in the deeper-water basins."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Allt Sgiathaig Till Member [Obsolete: use ASGL]"@en ,
        "Assynt Till Formation [Obsolete: use ASGL]"@en ,
        "Loch Lurgainn Till Member [Obsolete: use ASGL]"@en ,
        "Traligill Till Member [Obsolete: use ASGL]"@en ,
        "Unapool Till Member [Obsolete: use ASGL]"@en ;
    skos:broader namedrockunit:NWHG ;
    skos:definition "Bouldery gravelly sandy silty clay and diamicton with subsidiary gravelly sand and silty clay. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
