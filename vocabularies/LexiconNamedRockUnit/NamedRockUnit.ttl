        "Monadhliath Semipelite Formation"@en ,
        "Tarff Banded Formation"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Micaceous psammite with subsidiary calcsilicate-rock, psammite and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ARDR"@en ;
    skos:prefLabel "Ardair Semipelite Formation"@en ;
