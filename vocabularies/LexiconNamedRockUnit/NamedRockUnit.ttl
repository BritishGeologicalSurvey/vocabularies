namedrockunit:LKVY
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Formation encompasses the fluvial, lacustrine and organic deposits of the River Lark and its tributaries. Five terraces are identified. The terrace deposits comprise well bedded to rather poorly bedded sands and sandy gravels, deposited by braided rivers in a preglacial environment. The pebbles are dominantly angular to rounded flints up to about 100mm across, with a few glacial erratics. The three higher terraces are cryoturbated. The floodplain alluvium comprises silts, clays and fine sands, with bodies of peat, overlying sands and gravels."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Mid Pleistocene glacial deposits and on bedrock (Kimmeridge Clay to Chalk Group)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.14m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ONCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CAVM ,
        namedrockunit:ERIS ,
        namedrockunit:FHAM ,
        namedrockunit:KFRD ,
        namedrockunit:LFRD ,
        namedrockunit:SKLM ;
    skos:notation "LKVY"@en ;
    skos:prefLabel "Lark Valley Formation"@en ;
.

