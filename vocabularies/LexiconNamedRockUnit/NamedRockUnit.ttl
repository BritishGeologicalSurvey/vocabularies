    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "135 m thick at Dinckley [SD 6884 3564], and 100 m thick at Clayton-le-Dale [SD 6726 3322]."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of a sandstone-dominated unit of the Pendle Grit Member above the highest prominent pebbly sandstone unit within a pebbly-sandstone dominated sequence of the Copster Green Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PG ;
