namedrockunit:SCBL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Scandal Beck Limestone Formation largely comprises dark grey, fine- to medium-grained, variable but commonly quite thin-bedded, packstone. Interbeds of sandstone, siltstone or mudstone between these fossiliferous limestones are common. \r
\r
Millward et al. (2003) considered the depositional environment to be a deep water carbonate ramp. \r
\r
Chadian to early Arundian?"""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is conformable on the the Algal Nodular Beds at the top of Coldbeck Limestone Formation, the latter comprising well bedded limestones with mudstone partings, and flaggy dolostones with algal macrostructures."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2411 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The formation is about 120 m thick at Ravenstonedale, thinning to the north-east and south-west. It is about 50 m thick in the Appleby district."@en ;
    lexicon:hasUpperBoundaryDefinition "A succession of sandstones, oolitic limestones and layers of quartz pebbles, the Brownber Formation (BNBF), conformably overlies the Scandal Beck Limestone Formation in Ravenstonedale."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Scandal Beck Limestone [Obsolete: use SCBL]"@en ;
    skos:broader namedrockunit:GSCL ;
