namedrockunit:MIDA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Bedded and nodular anhydrite interbedded with dark grey mudstone and thin beds of dolostone. A thin grey-green and red sandstone marks the base of the formation, with dark grey dolostone and thin dolomitic mudstone beds dominant in the lower part of the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, with grey-green and red sandstone of the Middleton Dale Anhydrite Formation overlying grey and purple mudstone of Ordovician age."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as 73.6 m thick in the Eyam Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharply unconformable, and defined as the base of the lowermost thick, dark grey dolostone bed of the Woo Dale limestone Formation, overlying anhydrite of the Middleton Dale Anhydrite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Anhydrite-stone with subsidiary dolostone and mudstone and trace sandstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "MIDA"@en ;
    skos:prefLabel "Middleton Dale Anhydrite Formation"@en ;
