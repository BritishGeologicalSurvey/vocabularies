namedrockunit:CBTIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly brown/dark brown, very stiff, weakly calcareous, matrix supported, gravelly slightly clayey silty sand diamicton. Clast lithologies are dominated by quartzite/psammite and red brown Devonian sandstones, with less common pelitic/semipelitic metasediments, felsite, grey granite and mafic igneous rocks. Clasts are typically subangular - subrounded (with the pelitic metasedimentary rocks commonly striated). Clast fabrics indicate glacial transport from the northwest. Interpreted as a subglacial till."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, planar, unconformity on Devonian red-brown pebbly sandstones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H114 ,
        namedrockunit:H4525 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 0.7m observed"@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp, planar, subhorizontal surface overlain by periglacial diamictons of the Crossbrae Gelifluctate Bed. The Crossbrae Till Formation is believed to be locally overlain by the Crossbrae Farm Peat Bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Diamicton [Obsolete: use CBTIL]"@en ,
        "Till with northwest-southeast fabric [Obsolete: use CBTIL]"@en ;
    skos:broader namedrockunit:EGAG ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CBGEL ;
    skos:notation "CBTIL"@en ;
    skos:prefLabel "Crossbrae Till Formation"@en ;
.

namedrockunit:CCFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSAM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSPL"^^xsd:anyURI ,
