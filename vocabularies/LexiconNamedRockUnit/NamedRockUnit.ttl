namedrockunit:CXF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent
        namedrockunit:LKMU ,
        namedrockunit:S43 ,
        namedrockunit:SXS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Characteristically soft, bright red to dull brownish-red, maroon or purplish-brown, with green reduction spots in the north-eastern Midland Valley, generally massive but often thinly laminated, poorly-sorted, fine-grained silty sandstones, sandy siltstones, siltstones and mudstones, which lithologies may be locally interbedded with thin lenses of medium to coarse-grained pebbly sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, locally diachronous or interfingered base of red, massive or laminated and poorly-sorted, siltstone or mudstone, overlying fine- to medium-grained cross-bedded sandstone or conglomerate of the Arbuthnott-Garvock Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EDM ,
        namedrockunit:H2133 ,
        namedrockunit:LKMU ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 240 m to 1200 m, passing laterally into the Teith Sandstone Formation (or former Edzell Sandstone Formation) towards the northwest."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable and gradational, generally diachronous, interfingering with and passing up into the Teith Sandstone Formation (or former Edzell Sandstone Formation) with increasing abundance of sandstone lithologies."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cromlix Formation [Obsolete: use CXF]"@en ,
