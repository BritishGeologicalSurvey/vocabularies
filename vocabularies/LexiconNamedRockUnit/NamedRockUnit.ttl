namedrockunit:LYIN
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to coarse-grained biotite-muscovite granite, with either large single/twinned perthitic orthoclase crystals, albite-oligoclase, interstitial quartz and quartz-feldspar intergrowths (type G1) or large phenocrysts of feldspar and smaller phenocrysts (up to 4 mm across) of bipyramidal quartz, plates of intergrown biotite and muscovite with perthite and albite (type G2). The memoir also records the presence of bodies of syenite and a suite of basic dykes."@en ;
    lexicon:hasLowerBoundaryDefinition "Not known."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Not known."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasYoungestAgeValue 3.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ATLAN ;
    skos:definition "Granite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Eocene Epoch (Palaeogene Period) (56-33.9 Ma BP)."@en ;
