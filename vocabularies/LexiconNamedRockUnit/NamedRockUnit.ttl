namedrockunit:WSG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use CRAV, CLL] \r
\r
Predominantly calcareous mudstones, interbedded with limestones (commonly pale grey and coarsely bioclastic in the lower part), subordinate siltstones, limestone breccias and conglomerates, and sandstone. Bioturbation and soft sediment deformation are common, the latter mainly in the middle and upper part of the group."""@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain by the Chatburn Limestone Formation (formerly Group)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WRSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "To 1700m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Bowland Shale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CRAV ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Craven Group"@en ,
        "Worston Shales [Obsolete: use HOM, WSG]"@en ;
    skos:definition "Obsolete name. Calcareous mudstone and limestone with subsidiary breccia, conglomerate, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Asbian Substage (Carboniferous Period) (346.7-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WSG"@en ;
    skos:prefLabel "Worston Shale Group [Obsolete: use CRAV]"@en ;
.

