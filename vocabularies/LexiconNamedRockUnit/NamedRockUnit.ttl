namedrockunit:CUCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Soft white chalk, relatively marl free, with flint seams. Flints are generally large and, in the upper part, tabular."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable. As defined in Mortimore (1986), the base of the Culver Chalk lies low in the quadrata Zone, at the Castle Hill Marl. Well-developed marls commonly occur for several metres above the Castle Hill Marls, up to and including the Pepper Box Marls, which are now taken as the base."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H829 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "65 to 75 m and exceptionally 90 m but can be significantly less where synsedimentary channelling occurs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable at the Portsdown Marl (Mortimore, 1986) of the overlying Portsdown Chalk Formation. This marl separates very soft chalks with large potstone flints and some stylolitic surfaces from soft white chalks with regularly-spaced, well-developed thin marl beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Culver Chalk Member [Obsolete: use CUCK]"@en ;
    skos:broader namedrockunit:WHCK ;
    skos:definition "Chalk with subsidiary flint and trace calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:SPCH ,
        namedrockunit:TACH ;
    skos:notation "CUCK"@en ;
    skos:prefLabel "Culver Chalk Formation"@en ;
.

