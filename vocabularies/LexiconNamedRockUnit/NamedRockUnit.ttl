namedrockunit:DBCN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse-grained quartzite present in Argyll at base of subgroup; upper part of subgroup in Argyll and whole of subgroup elsewhere formed of interbedded semipelite and pelite with minor psammite - this facies denotes the commencement of deep-water turbiditic sedimentation. Gritty psammite and semipelite near top in Glen Dochart - Kikin."@en ;
    lexicon:hasLowerBoundaryDefinition "Incoming of coarse pebbly quartzite or psammite at base of Crinan Grit or Upper Erins Quartzite (Argyll); change from calcareous pelite or volcaniclastic rocks to non-calcareous turbiditic semipelite, pelite and psammite (Perthshire to Banffshire)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "1.5-3km"@en ;
    lexicon:hasUpperBoundaryDefinition "Bottom of lowest limestone bed in Loch Tay Limestone Formation where present; from Glen Clova to Deeside change from dominant semipelite to psammite or quartzite with calcareous beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ARGY ;
    skos:definition "Pelite, psammite, quartzite and semipelite with subsidiary calcsilicate-rock and limestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
