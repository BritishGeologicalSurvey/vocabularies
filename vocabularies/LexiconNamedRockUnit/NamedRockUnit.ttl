namedrockunit:PDL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey, fine- to coarse-grained, bioclastic, commonly graded, erosive-based and bioturbated cherty packstones, interbedded with wackestone, sporadic intraformational and extraformational limestone conglomerate, and especially in the lower part, dark to pale olive- and blue-grey mudstone (Rad Brook Mudstone Member). Locally dolomitized, especially in the packstones, and rare sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type section, the base is defined at the base of the first grey mudstone bed lying above the pale olive and blue-grey nodule-bearing wackestones that characterize the Hodderense Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S873 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 300m"@en ;
    lexicon:hasUpperBoundaryDefinition "The junction with the overlying Bowland Shale Formation is marked by the absence of bioturbation, and by a colour change from pale olive- and blue-grey, to dark blue and black, as mudstones and interbedded limestones become fetid and petroliferous. This colour change commonly corresponds to the entry of limestone breccias."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Pendleside Limestone [Obsolete: use PDL]"@en ;
    skos:broader namedrockunit:CRAV ;
    skos:definition "Limestone and mudstone with subsidiary breccia and trace sandstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:RKM ;
    skos:notation "PDL"@en ;
    skos:prefLabel "Pendleside Limestone Formation"@en ;
.

namedrockunit:PDO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, massive ooidal limestone, lenticular sandstone, rubbly limestone and shelly mudstone, locally with coal streaks and seatearth, at top."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at the junction of pale grey, massive ooidal limestone of the Penderyn Oolite Member with calcereous sandstone of the underlying Honeycombed Sandstone Member, or with the dark grey, bituminous skeletal/peloidal grainstones/packstones/wackestones of the Dowlais Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1756 ,
        namedrockunit:H4247 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "13m at type locality, 25 to 33m elsewhere."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at the top of ooidal limestone or at the top of lenticular sandstone and mudstone of the Member, above which dark grey, cyclic shelly and crinoidal grainstones of the undivided part of the Oxwich Head Limestone Formation enter."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Light Oolite [Obsolete: use PDO]"@en ,
        "Llandyfan Limestone [Obsolete: use OHL, PDO]"@en ;
    skos:broader namedrockunit:OHL ;
    skos:definition "Ooid-limestone with subsidiary mudstone and sandstone and trace coal and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PDO"@en ;
    skos:prefLabel "Penderyn Oolite Member"@en ;
.

