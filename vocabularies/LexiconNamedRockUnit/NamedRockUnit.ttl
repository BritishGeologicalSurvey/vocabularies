    lexicon:hasThicknessDescription "Approximately 20 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is not exposed, but is presumed to be at the upward change from a dominantly limestone/medium grey mudstone sequence to the dark grey mudstones of the Charmouth Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
