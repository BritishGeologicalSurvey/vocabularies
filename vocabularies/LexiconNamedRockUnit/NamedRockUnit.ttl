    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Fell Sandstone Formation"@en ;
    skos:definition "Obsolete name. Mudstone and sandstone with subsidiary calcareous sandstone, coal and limestone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage - to - Asbian Substage (Carboniferous Period) (343-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
