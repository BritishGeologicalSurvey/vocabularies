        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly semipelite, muscovite-rich, typically with andalusite, but with mappable units of poorly-sorted, gritty psammite becoming dominant towards the top; also contains a mappable unit of strongly magnetic pelite."@en ;
    lexicon:hasLowerBoundaryDefinition "Transition from mixed psammite, semipelite and pelite without gritty units to more uniform semipelite with gritty units: overlies Craigievar Formation (right way up)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum of c.4000m to the east of the Rhynie Devonian outlier, but only 800-1000m west of the outlier."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen: cut off by Insch and Boganclogh intrusions."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Psammite and semipelite with subsidiary pelite and trace calcsilicate-rock, gritty psammite and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SUH"@en ;
    skos:prefLabel "Suie Hill Formation"@en ;
