    lexicon:hasUpperBoundaryDefinition "Conformable below Roseland Breccia Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grampound Grit [Obsolete: use CRNE, GRAD, RDBR, TRSA]"@en ,
        "Upper Gramscatho Beds [Obsolete: use CRNE]"@en ,
        "Upper Gramscathos [Obsolete: use CRNE]"@en ;
    skos:broader namedrockunit:GRO ;
    skos:definition "Sandstone with subsidiary breccia, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age - to - Givetian Age (Devonian Period) (394.3-378.9 Ma BP)."@en ;
