namedrockunit:SA
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S331 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and red mottled clay, white sandy clay and white, brown and red sands. The sands contain a range of minerals that indicate the sediments were derived locally; these include haematite, tourmaline, zircon, rutile, cyanite, andalusite, topaz and cassiterite. The beds also contain blocks of conglomerate containing rolled pebbles of quartz and cleaved mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the erosion surface of cleaved mudstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasOldestAgeValue 3.39e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable; up to 5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Present day erosion surface; locally covered by Head deposits of up to 1.2 m thickness."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasYoungestAgeValue 2.304e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "St Agnes Beds"@en ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Oligocene Epoch (Palaeogene Period) (33.9-23.04 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SA"@en ;
    skos:prefLabel "St Agnes Formation"@en ;
.

