namedrockunit:TMMU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olive green, soapy \"shales\" exhibiting a conchoidal fracture and pale grey \"shales\" with calcareous micaceous laminae. The small bivalve Sanguinolites? ellipticus is locally abundant in the upper part of the Formation. Sparse shelly benthos and pelagic ostracods are locally present."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the gradational incoming of pale grey and green micaceous shales of the Trusham Mudstone Formation above the dark blue-grey or bluish green-grey mottled shales and calcareous beds of the underlying Hyner Mudstone Formation. Commonly this boundary cannot be detected in the metamorphic aureole of the Dartmoor Granite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2490 ,
        namedrockunit:H3728 ,
        namedrockunit:TMSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "65 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of bluish black and black mudstones of the overlying Combe Mudstone Formation above the olive green and pale grey mudstones of the Trusham Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Trusham Formation [Obsolete: use TMMU, TMSH]"@en ,
        "Trusham Shale Formation [Obsolete: use TMMU]"@en ,
        "Trusham Shale [Obsolete: use TMMU]"@en ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "TMMU"@en ;
    skos:prefLabel "Trusham Mudstone Formation"@en ;
