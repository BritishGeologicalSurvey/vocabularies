namedrockunit:COVO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATHL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basalt, olivine-phyric, tholeiitic; several sheets of intensely fractured dark blue-grey rock, each passing up into highly amygdaloidal, scoriaceous and pillow-like tops, which contain infills of overlying sedimentary rock. Upper part of formation is intercalated with dark grey and greenish grey sandstone and argillaceous dolostone (\"cementstone\") of the overlying Ballagan Formation. Interpreted as lavas."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the broadly conformable base of the lowest basalt sheet that sharply overlies a sequence of red and grey flaggy sandstones with ochreous brown spots, interbedded with purple, red lilac and green mudstone containing ochreous concretions, and thin concretionary carbonate (cornstone) beds (Lower Freestone Beds of Taylor et al, 1971), possibly part of the Kinnesswood Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H158 ,
        namedrockunit:H159 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 24m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of overlying interbedded sandstone, mudstone and argillaceous dolostone sequence of the Ballagan Formation (formerly Cementstone Group); the upper contact is intercalated."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cottonshope Basalts [Obsolete: use COVO]"@en ,
        "Cottonshope Lavas [Obsolete: use COVO]"@en ;
    skos:broader namedrockunit:INV ;
    skos:definition "Basalt, olivine-phyric basalt and tholeiitic basalt. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COVO"@en ;
    skos:prefLabel "Cottonshope Volcanic Formation"@en ;
.

