namedrockunit:NYGD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Crystal-lithic tuffs with variable characteristics, locally strongly welded towards the top."@en ;
    lexicon:hasLowerBoundaryDefinition "Oxidised and reddened top of the rhyodacite lavas of the Foel Ddu Rhyodacite Formtion."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
