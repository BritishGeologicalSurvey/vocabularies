namedrockunit:FLUS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Flugga Sandstone Member consists of clean, very fine to medium sandstone displaying distinctive 'blocky' log profiles. Thin intercalations of dark grey, fissile mudstone are also present."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Flugga Sandstone Member is taken at a downward change from sandstone to mudstone, associated with an increase in gamma-ray values and decrease in velocity. Where the Skadan Sandstone Member is present, the two sandstone units are normally separated by the persistent S2a mudstone (refer to Sele Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Reaches more than 270 m thick in 16/1-1."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Flugga Sandstone Member is taken at a downward change from mudstone to sandstone, associated with a decrease in gamma-ray values and, in some sections, an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasYoungestAgeValue 3.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SELE ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Eocene Epoch (Palaeogene Period) (56-33.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FLUS"@en ;
    skos:prefLabel "Flugga Sandstone Member"@en ;
