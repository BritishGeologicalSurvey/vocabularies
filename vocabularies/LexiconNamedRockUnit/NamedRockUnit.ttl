namedrockunit:NCPY
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member consists of pyroclastic material deposited largely in tephra cones, as ashfall tuffs and lapilli tuffs and reworked volcaniclastic sedimentary rocks derived from the erosion of coallescing tephra cones. Typically, finely stratified tuffs pass upwards into coarse, unstratified spatter deposits and agglomerates. The lower agglomerates are composed largely of accidental and accessory material, including large blocks (up to 2 m) of basalt, smaller lava fragments and rare sandstone boulders. Higher agglomerates tend to be composed of essential tephra and scoria bombs in an upward progression that is typical of tephra cones. Impersistent tongues and lenses of highly vesicular basaltic lava occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Inverclyde Group strata of the Clyde Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1082 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Unspecified and probably highly variable. Since fragmental rocks that form subaerial tephra cones are indistinguishable from those occupying necks, it is possible that some of the tephra is actually neck agglomerate."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain conformably or locally disconformably by the Campsie Lava Member of the Clyde Plateau Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "North Campsie Tephra Deposits (Associated with the North Campsie Linear Vent System) [Obsolete: use NCPY]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Agglomerate, lapilli-tuff and tuff with subsidiary volcaniclastic-sandstone and volcaniclastic-siltstone and trace basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NCPY"@en ;
    skos:prefLabel "North Campsie Pyroclastic Member"@en ;
.

