namedrockunit:TDC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk) with flint bands. Divided into five \"Beds\" (A to E). Abundant belemnites in lower \"Bed\" A and by an acme of crinoid debris in \"Bed\" C. Elsewhere asteroid and crinoid debris common."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower bounday is conformable, on the Ballymagarry Chalk Formation, at a bedding plane immediately below the thick continuous tabulate Long Gilbert Flint Band where this exists. Or at the same bedding plane marking the faunal change from the Ballymagarry Chalk Formation fauna."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3719 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KM> ;
