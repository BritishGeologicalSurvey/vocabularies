namedrockunit:THLA
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Touch House Lava Member consists only of plagioclase-macrophyric basalt or trachybasalt lavas (basalt to hawaiite of 'Markle' type) and only the lowest part of the member is well exposed, near the edge of the low-lying fertile land between Touch Home Farm [NS 7518 9331] and Touch House [NS 7535 9276]."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal plagioclase-macrophyric basalt lava of the member is apparently conformable, or disconformable, on the underlying plagioclase-microphyric basalt of the Black Mount Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4923 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Uncertain"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the member is not exposed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Touch House Group [Obsolete: use THLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THLA"@en ;
    skos:prefLabel "Touch House Lava Member"@en ;
.

namedrockunit:THMU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use KRM] \r
\r
Mudstone and siltstone, interlaminated, with rhythmic alternation between reddish brown and greenish grey intervals. Halite occurs at base and top."""@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at the gradational upward transition from predominantly structureless reddish brown mudstones (Sidmouth Mudstone Formation, undifferentiated) to the laminated reddish brown and greenish grey mudstones of the Thornton Mudstone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2880 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "71 m to 112 m (Wilson and Evans, 1990)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the gradational upward transition from the laminated reddish brown and greenish grey mudstones of the Thornton Mudstone Member to the halite of the Preesall Halite Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KRM ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Kirkham Mudstone Member"@en ,
        "Thornton Mudstone [Obsolete: use KRM, THMU]"@en ;
    skos:definition "Obsolete name. Mudstone and siltstone with subsidiary halite. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THMU"@en ;
    skos:prefLabel "Thornton Mudstone Member [Obsolete: use KRM]"@en ;
.

namedrockunit:THQ
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pink to maroon, medium- to fine-grained glauconitic sandstone. Subordinate mudstone beds and near-ubiquitous mudstone drapes. Tabular-planar and compound cross-bedding common. Summary of typical lithologies in Type Section:(i) Sandstone, maroon, fine, glauconitic and micaceous. Smooth, flat-topped beds, parallel-sided with horizontal lamination. Many bed tops bioturbated (56m). (ii) Sandstone, pink to maroon, glauconitic. Undulatory, smooth-topped beds with mudstone drapes. Compound cross-bedding with highly lenticular bed forms (39m). (iii) Sandstone, maroon to pinkish grey, glauconitic. Parallel-sided, smooth-topped beds with horizontal or gently dipping lamination; mudstone beds locally constitute 50% of succession (10.5m). (iv) Sandstone, maroon to pale pink, glauconitic. In thick tabular-planar cross-bedded sets, showing unimodal current directions, or in lenticular compound cross-bedded sets. Ubiquitous mudstone drapes (39m). (v) Sandstone, grey, coarse to pebbly. In lenticular, thick beds with tabular-planar cross-bedding showing bimodal current directions. Mudstone interbeds are lenticular, locally to 0.7m thick (7.5m). (vi) Horizontally laminated sandstone, mudstone dominant at base (5.3m)."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of beds with abundant mudstone-draped top surfaces. Sandstones beneath (of Park Hill Member) predominantly grey, with herringbone cross-bedding in main part."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3725 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasOldestAgeValue 5.26e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "157m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of variegated fine-grained sandstone and siltstone beds of Jees Member. Bimodal cross-bedding and trough cross-bedding becomes well-developed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EC> ;
    lexicon:hasYoungestAgeValue 5.08e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tuttle Hill Quartzite [Obsolete: use THQ]"@en ;
    skos:broader namedrockunit:CQ ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Comley Series (Cambrian Period) (526-508 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THQ"@en ;
    skos:prefLabel "Tuttle Hill Member"@en ;
.

