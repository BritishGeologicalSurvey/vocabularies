    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, moderately clean, pale grey (occasionally green, yellow or orange), fine- to medium-grained, cross-bedded quartz sands with subordinate bands of silt or clay. Pyrite nodules are present and glauconite is locally abundant."@en ;
    lexicon:hasLowerBoundaryDefinition "Down-section change from unconsolidated, moderately clean, pale grey (occasionally green, yellow or orange), fine- to medium-grained, cross-bedded quartz sands with subordinate bands of silt or clay (Leziate Member) to glauconitic, clayey, grey and green sands with bands and 'doggers' of brown weathering clay-ironstone and seams of phosphatic nodules (Mintlyn Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1678 ,
        namedrockunit:H2931 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the King's Lynn district, the upper boundary is defined by a down-section change from thinly-bedded, fine-grained, silty sands and sandstones (Dersingham Formation) to unconsolidated, moderately clean, pale grey, (occasionally green, yellow or orange), fine- to medium-grained, cross-bedded quartz sands with subordinate bands of silt or clay. Locally, medium to dark grey clay (? Snettisham Clay) rests on the sands of Leziate Member (Gallois, 1994). In the Gayton-Marham area, pebbly, ferruginous sandstones (Carstone Formation) overstep the unconsolidated, moderately clean, pale grey Leziate Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Leziate Beds [Obsolete: use LZB]"@en ,
        "Leziate Sand Member [Obsolete: use LZB]"@en ;
    skos:broader namedrockunit:SAS ;
    skos:definition "Sand with subsidiary clay, glauconitic sandstone and silt. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age (Cretaceous Period) (137.7-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LZB"@en ;
    skos:prefLabel "Leziate Member"@en ;
.

namedrockunit:MAAP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically buff to pink fine-grained massive thick-bedded (>1 m) but fine grained psammite. Typically brown to orange-brown. Commonly strongly recrystallised: sedimentary structures are rare and ill-defined and any intrabed laminations are typically wispy."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Basal Pelite Formation (MABP) or unconformable typically of the Western Glenelg Gneiss (WGG); unconformity normally highly sheared."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5240 ,
        namedrockunit:H5241 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 1000 m (estimate; unit is deformed)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Rubha Ruadh Semipelite Member (MARRS); transitional contact of interbedded psammite and semipelite, indicating a broad fining upwards trend."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Armisdale Psammite [Obsolete: use MAAP]"@en ,
        "Main Striped Group [Obsolete: use MAAP]"@en ;
    skos:broader namedrockunit:MALP ;
    skos:definition "Psammite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MAAP"@en ;
    skos:prefLabel "Arnisdale Psammite Member"@en ;
.

namedrockunit:MACA
    a skos:Concept ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5018 ;
