namedrockunit:BGN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstones and siltstones, with nodules and beds of ferroan dolomite (cementstones), the beds generally less than 0.3m thick. Gypsum and, to a much lesser extent, anhydrite and pseudomorphs after halite occur. Desiccation cracks are common and the rocks commonly show evidence of brecciation during diagenesis. Both these features are associated with reddening of the strata. Where present, the restricted fauna is characterised by the bivalve Modiolus latus, but ostracods are more abundant. Thin sandstones are present in many areas, and thick localised sandstones are also now included in the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen in type section; elsewhere transitional on cornstone-bearing sandstones of Kinnesswood Formation (as at a depth of 224.8m in British Geological Survey East Dron Borehole (NO11NW/24; NO1360 1572))."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BNCF ,
        namedrockunit:CMST ,
        namedrockunit:LBG ,
        namedrockunit:LBO ,
        namedrockunit:TYN ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 900m (maximum) in the West Lothian area, and up to 250m in the Northern England Province."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is drawn at the top of the highest unit of mudstone and cementstone in any particular area. The Clyde Sandstone Formation usually overlies the Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ballagan Cementstone Formation [Obsolete: use BGN]"@en ,
        "Border Group, Lower [Obsolete: use BGN, LYNE]"@en ,
        "Cementstone Group [Obsolete: use INV, BGN, CMNT]"@en ,
        "Lower Border Group [Obsolete: use BGN, LYNE]"@en ,
        "Tyninghame Formation [Obsolete: use BGN]"@en ;
    skos:broader namedrockunit:INV ;
    skos:definition "Calcareous mudstone, mudstone and siltstone with subsidiary basaltic tuff, calcilutite, conglomerate, dolomitic limestone, dolostone, gypsum-stone, limestone and sandstone and trace anhydrite-stone and coal. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage - to - Chadian Substage (Carboniferous Period) (359.3-344.5 Ma BP)."@en ;
