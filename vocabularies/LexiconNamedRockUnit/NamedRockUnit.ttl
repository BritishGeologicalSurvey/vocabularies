namedrockunit:PFD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Penny Farm Gill Formation comprises interbedded limestone, dolostone, sandstone and siltstone, commonly rhythmically bedded. \r
\r
The strata were deposited within a shallow marine, intertidal and supratidal environment, marginal to the more open marine conditions in the Stainmore Trough at the time."""@en ;
    lexicon:hasLowerBoundaryDefinition "The formation overlies contiguously the conglomeratic Marsett Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4837 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "According to Dunham and Wilson (1985) the formation is 50.6 m thick in the Penny Farm Gill inlier, and about 56 m thick in the Raydale Borehole (see above)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Penny Farm Gill Formation is marked locally by a nodular dolostone bed with rhizoliths that is indicative of emergence (Burgess, 1986). The biosparites of the Tom Croft Limestone Formation (Great Scar Limestone Group) disconformably overlie the formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Penny Farm Gill Dolomite Formation [Obsolete: use PFD]"@en ;
    skos:broader namedrockunit:RVS ;
    skos:definition "Dolomitic limestone and dolostone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Holkerian Substage (Carboniferous Period) (346.7-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PFD"@en ;
    skos:prefLabel "Penny Farm Gill Formation"@en ;
.

namedrockunit:PFIUC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin, impersistent but easily recognisable coal seam in the Glasgow-Stirling region. Occasionally found in Kilsyth and Stirling area. Forsyth, 1962, states that: \"when absent as coal, a prominent seat earth is found and the overlying shale (fissile mudstone) is thicker than found with adjacent coals\"."@en ;
    lexicon:hasLowerBoundaryDefinition "Thin coal or seat earth bed overlies Ashfield Coking Coal within Limestone Coal Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:FINUC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.1m"@en ;
    lexicon:hasUpperBoundaryDefinition "Possil Fourteen Inch Under Coal is overlain by thin \"cyclothem\" containing Possil Fourteen Inch Coal (PFI), Limestone Coal Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fourteen Inch Under Coal [Obsolete: use PFIUC]"@en ;
    skos:broader namedrockunit:LSC ;
    skos:definition "Coal. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PFIUC"@en ;
    skos:prefLabel "Possil Fourteen Inch Under Coal (Glasgow Area; Central Coalfield)"@en ;
.

namedrockunit:PFOEL
    a skos:Concept ;
    lexicon:hasLithology
