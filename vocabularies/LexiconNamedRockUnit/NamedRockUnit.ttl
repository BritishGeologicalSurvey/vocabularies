namedrockunit:SCOMD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDOLR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use SCOUR] Includes the majority of the dykes of the Scourie Dyke Swarm. The metadolerites form dykes of a variety of thicknesses, typically with a roughly northwest-southeast trend. The dykes have a primary mineralogy of plagioclase - clinopyroxene - titanomagnetite together with variable amounts of orthopyroxene, hornblende, biotite and quartz, although most have been metamorphosed at amphibolite facies, with replacement of much of the primary mineralogy. Cross-cutting relationships are rare, but the subswarm probably includes dykes representing more than one phase of intrusion."@en ;
    lexicon:hasLowerBoundaryDefinition "Contacts are cross-cutting, and modified by subsequent metamorphism."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UW> ;
    lexicon:hasThicknessDescription "From about 50 cm to 50 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "N/A."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SCOUR ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Scourie Dyke Swarm"@en ;
