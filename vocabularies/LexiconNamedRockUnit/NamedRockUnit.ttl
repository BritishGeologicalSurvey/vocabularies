namedrockunit:TWVA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alluvial, alluvial fan and river terrace gravel, sand, silt and clay. The gravel comprises predominantly Ordovician and Silurian wacke sandstone with Devonian and Carboniferous sandstone, siltstone and a range of basaltic igneous rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp, undulating, erosional contact, mainly on diamictons of the Norham Till Formation (Borders Glacigenic Subgroup) or, in the middle and upper reaches of the Tweed valley, till and glaciofluvial deposits of the Southern Uplands Glacigenic Subgroup."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "At the present ground surface or, locally,covered by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TWEED ;
    skos:definition "Gravel, sand and silt with subsidiary clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TWVA"@en ;
    skos:prefLabel "Tweed Valley Formation"@en ;
