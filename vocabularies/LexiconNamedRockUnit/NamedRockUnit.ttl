    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally less than 2m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp; upward passage into late Permian mudstones (Marl Slate), dolostone or dolomitic siltstone (Cadeby Formation) or sandstone (Lenton Sandstone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basal Breccia [Obsolete: use PBB]"@en ,
        "Basal Permian Breccia [Obsolete: use PBB, YWS]"@en ;
    skos:broader namedrockunit:RLG ;
    skos:definition "Conglomerate with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PBB"@en ;
    skos:prefLabel "Permian Basal Breccia"@en ;
.

