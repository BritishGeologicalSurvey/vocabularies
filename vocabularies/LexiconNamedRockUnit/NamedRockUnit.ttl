    skos:altLabel
        "Crathie Point Calcareous Flag Member [Obsolete: use CRPT]"@en ,
        "Middle Portion of Crathie Point Calcareous Group [Obsolete: use CRPT]"@en ;
    skos:broader namedrockunit:CCFL ;
    skos:definition "Calcsilicate-rock, metalimestone and semipelite with subsidiary gneissose semipelite and psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRPT"@en ;
    skos:prefLabel "Crathie Point Calc-Silicate Member"@en ;
