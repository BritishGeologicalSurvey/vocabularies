namedrockunit:LEWTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S72 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Compact greyish brown, matrix-supported diamicton with cobble to boulder sized subangular clasts mainly of Lewisian gneiss lithogies in a silty sand matrix. Generally becomes more gravelly towards the base, with angular clasts, and interstratified with sand in the uppermost metre or so, where boulders up to 2m in diameter are common. Forms gently undulating sheets."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on broken or striated rock surface."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1651 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 6m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally capped by peat or alluvium deposits. Unconformably overlain by brown, matrix-supported, clast-rich diamicton of the Ruaival Diamicton Formation (Head) on St Kilda."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dun Member"@en ,
        "Ruaival Drift [Obsolete: use LEWTI]"@en ;
    skos:broader namedrockunit:WISG ;
    skos:definition "Diamicton with subsidiary gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LEWTI"@en ;
    skos:prefLabel "Lewis Till Formation"@en ;
.

namedrockunit:LEYST
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Non-calcareous, matrix supported, gravelly, slightly clayey, silty sand diamicton. Dominantly pale olive-brown and olive-brown (upper interval shows extensive yellowish brown and strong brown mottling). Non-calcareous, matrix supported, gravelly, slightly clayey silty sand. Clast types include quartzites, psammitic and pelitic metasedimentary rocks, felsite, mafic igneous rocks and grey granite. The lower intervals contain lenses and small rafts of kaolinised metasedimentary rocks and grussified mafic igneous rocks. Interpreted as a subglacial till."@en ;
    lexicon:hasLowerBoundaryDefinition "As seen in geological test pits either sharply unconformable, planar, boundary on weathered bedrock or gradational glaciotectonised, boundary (over c.0.4m) showing incorporation of lenses and small rafts of weathered metasedimentary or mafic igneous rock types."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1652 ,
        namedrockunit:H4757 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 2.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "As seen in geological test pits sharp, planar, erosive upper boundary with overlying felsite-rich gravels of the Denend Gravel Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Leys Member [Obsolete: use LEYST]"@en ,
        "Leys Till [Obsolete: use LEYST]"@en ;
    skos:broader namedrockunit:EGAG ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Wolstonian Stage (Quaternary Period) (.48-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LEYST"@en ;
    skos:prefLabel "Leys Till Formation"@en ;
.

namedrockunit:LFC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A coarse conglomerate with clasts up to 1m, but more commonly in the 10-50 cm range, consisting mainly of gritty sandstone but with rare serpentinite, chert and 'epidiorite'. The sandy matrix and sporadic sandstone interbeds are strongly cleaved."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen, as the formation is a fault-bounded slice within the Highland Boundary Fault system."@en ;
