    lexicon:hasThicknessDescription "To 9m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is the unconformity with the Middle Devonian conglomerate (Spey Conglomerate Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DM> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
