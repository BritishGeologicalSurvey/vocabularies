namedrockunit:FHL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, medium-bedded skeletal limestones with thick-bedded, locally cross-bedded, commonly ooidal limestones at base. Units of interbedded dolomite mudstone, dolomite siltstone and mudstone punctuate the succession. Deposited as a transgressive barrier and offshore shelf sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp erosive contact of the massive to thick-bedded pale grey skeletal and ooidal limestones of the Flatholm Limestone Member and the thin- to medium-bedded dolomite and calcite mudstones and mudstones of the underlying Caswell Bay Mudstone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "31 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the uppermost unit of the interbedded dolomite mudstone, dolomite siltstone and mudstone of the Member, which is overlain by massive to thick-bedded pale grey skeletal and ooidal limestones of the remaining part of the High Tor Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HTL ;
    skos:definition "Limestone with subsidiary dolomitic silicate-mudstone and dolomitic siltstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FHL"@en ;
    skos:prefLabel "Flat Holm Limestone Member"@en ;
