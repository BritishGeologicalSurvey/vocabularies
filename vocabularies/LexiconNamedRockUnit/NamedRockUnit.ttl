    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "32m in type area; c.43m in Walsall Borehole (Butler, 1937)"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of `Rubery Shale', where buff, grey and purple 'shales' with `fucoids' overlie predominantly sandstone beds of the `Rubery Sandstone' (Wills and others, 1925)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasYoungestAgeValue 4.329e+02 ;
