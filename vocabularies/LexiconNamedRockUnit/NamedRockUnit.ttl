    lexicon:hasThicknessDescription "c. 290 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from the Catsbit Limestone Formation of the Upper Liddesdale Group to the overlying Millstone Grit Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
