namedrockunit:LNF
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:NGF ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use NGF] Alternations of bands of fossiliferous mudstone and laminated muddy siltstone with subordinate thin lenticular bands of calcareous siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Lower Nantglyn Flags where massive dark blue/grey mudstones with siltstone bands rests conformably upon the fossiliferous beds of grey sandstone of the Llanddoged Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SS> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
