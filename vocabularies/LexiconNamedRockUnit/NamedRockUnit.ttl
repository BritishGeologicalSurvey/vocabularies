namedrockunit:CHAI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMQZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "20 to 40cm-scale tabular to lenticular bedded grey to pinkish brown quartzite and quartzose psammite. Banded ribbed quartzite and semipelite unit comprising 5 to 10cm-scale interbeds of semipelite. The uppermost part of formation is more thinly bedded (3 to 5cm), and flaggy, comprising white-grey quartzite with minor biotitic quartzite and dark semipelite, and is probably about 5 to 10m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Abrupt change to white-weathering pinkish-brown quartzose psammite and quartzite from the preceding psammite to quartzose psammite of the Auch Gleann Psammite Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasOldestAgeValue 7.2e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Ranges from 10 - 20m up to c.250m thick, thicker typically in the southern part of the outcrops mapped to date. Approximately 90m thick at Beinn a'Chaisteil."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt change to the calcareous garnet-mica semipelite and muscovite-quartz semipelite marking the base of the Coire Daingean Semipelite Formation or to the massive garnet-mica semipelite and muscovite-quartz semipelite where the calcareous facies is not developed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasYoungestAgeValue 6.35e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Quartzite and quartzose psammite with subsidiary semipelite. Stratified bedrock. Occurs onshore. Deposited during the Cryogenian Period (Precambrian) (720-635 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHAI"@en ;
    skos:prefLabel "Beinn A'Chaisteil Quartzite Formation"@en ;
.

namedrockunit:CHAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HBSCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMQZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "5 to 10m-scale bedded/banded, pale brown quartzite to quartzose psammite with cm-scale schistose quartz, muscovite, +/- biotite semipelite interbeds. Approximately 70:30 psammite/quartzite to semipelite. Quartzite/quartzose psammite beds are thicker (20 to 40cm) in lower part (semipelite less than 3cm-thick layers and less than 20%) of the formation; hornblende schist layers (30 to 40cm thick) are conspicuous."@en ;
    lexicon:hasLowerBoundaryDefinition "The change from calcareous \"pitted\" psammites and semipelites of underlying Ben Lawers Schist Formation appears sharp (in the Allt Challum section) with abrupt loss of any calcareous component and a decrease in the semipelite content, which is typically 50% or more in the Ben Lawers Schist Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional/gradational change upwards with increasing semipelite proportion into the Ben Lui Schist Formation. Upper limit taken where conspicuous quartzose psammite layers are <20%."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DBCN ;
    skos:definition "Quartzite and quartzose psammite with subsidiary hornblende schist and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHAL"@en ;
    skos:prefLabel "Ben Challum Quartzite Formation"@en ;
.

