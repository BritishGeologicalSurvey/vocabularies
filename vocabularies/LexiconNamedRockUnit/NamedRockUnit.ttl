namedrockunit:HM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly red, green and grey clays, silts and sands with a fauna of freshwater molluscs, silty clays are locally laminated and carbonaceous. Includes thin blue and black clays with a marine influence."@en ;
    lexicon:hasLowerBoundaryDefinition "Marked by the base of a 0.5m thick carbonaceous black clay with rootlets, locally known as the 'Black Band'. The basal contact is an omission surface, overlying a paleosol at the top of the Bembridge Marls Member (Hooker et al., 2004)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5236 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GI> ;
    lexicon:hasOldestAgeValue 3.77e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Between 58m and 69m on the eastern and western sides of the Isle of Wight respectively. King (in press) gives a total of 78m for this member in the cliffs and on the foreshore between Bouldnor and Hamstead Ledge, Isle of Wight."@en ;
    lexicon:hasUpperBoundaryDefinition "Top is a sharp but apparently conformable (King, in press) contact beneath the shelly brown clays of the Cranmore Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GR> ;
    lexicon:hasYoungestAgeValue 2.73e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Hamstead Beds [Obsolete: use HM]"@en ;
    skos:broader namedrockunit:BOUL ;
    skos:definition "Clay with subsidiary silty sand. Stratified bedrock. Occurs onshore. Deposited during the Priabonian Age - to - Rupelian Age (Palaeogene Period) (37.7-27.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HM"@en ;
    skos:prefLabel "Hamstead Member"@en ;
.

namedrockunit:HMFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of three limestone units separated by mudstone beds. Each unit may comprise up to four limestone beds, the lowest (Bed X of Brandon et al, 1990) is shelly and rubbly and includes bivalves and ammonites, the uppermost is bioclastic and pyritic packstone/grainstone, shelly, pale grey, weathering pale brown, with abundant coarse sand-grade shell debris, and a fauna including serpulids, gastropods, bivalves and echinoid spines, and also the trace fossil Kulindrichnus. The uppermost limestone forms a strong positive feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey, calcareous mudstone with rare thin limestones of undifferentiated Barnby Member; at 87.35 m depth in type section Fulbeck Airfield Borehole (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3472 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "4.5 to 5 m; 4.59 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey, calcareous mudstone of undifferentiated Granby Member; at 82.76 m depth in type section Fulbeck Airfield Borehole (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasYoungestAgeValue 1.995e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Holm Farm Limestone [Obsolete: use HMFL]"@en ;
    skos:broader namedrockunit:GRBL ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hettangian Age (Jurassic Period) (201.4-199.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HMFL"@en ;
    skos:prefLabel "Holm Farm Limestones Bed"@en ;
.

