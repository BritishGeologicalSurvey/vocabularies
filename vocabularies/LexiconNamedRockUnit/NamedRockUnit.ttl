        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin bedded limestone turbidites (packstones and wackestones), occurring as fining-upwards graded beds, with mudstone interbeds; local thick-bedded units of resedimented fine-grained limestone (grainstones) and isolated rolled blocks of knoll reef limestone; scattered chert nodules.The formation formed as an apron of late Asbian limestone turbidites, resedimented carbonate detritus and fallen blocks of \"reef\" limestone derived from the adjacent North Wales Clwyd Limestone Group platform."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed, but presumed to be a conformable contact between thicker bedded limestones (packstones and grainstones) of the underlying Llanarmon Limestone Formation and thinner bedded Prestatyn Limestone facies."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Over 120m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable contact with interbedded mudstones and dark argillaceous limestones of the Teilia Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CRAV ;
    skos:definition "Limestone with subsidiary mudstone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PRL"@en ;
    skos:prefLabel "Prestatyn Limestone Formation"@en ;
