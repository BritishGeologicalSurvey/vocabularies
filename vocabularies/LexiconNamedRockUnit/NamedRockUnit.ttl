namedrockunit:MCMS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AROC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CANL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CBFEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FESTC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHFEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, siltstone and mudstone in repeated cycles that most commonly coarsen upwards but also fine upwards locally, with seatclay or seatearth and coal at the top. The mudstone and siltstone are usually grey to black, while the sandstone is fine- to medium-grained and off-white. Coal seams are common and many exceed 0.3m in thickness."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the Vanderbeckei (Queenslie) Marine Band."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2313 ,
        namedrockunit:H392 ,
        namedrockunit:MCM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasOldestAgeValue 3.18e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 330m"@en ;
    lexicon:hasUpperBoundaryDefinition "The conformable and transitional boundary from the Scottish Middle Coal Measures Formation to the Scottish Upper Coal Measures Formation is drawn at the base of the Aegiranum (Skipsey's) Marine Band. The original definition (MacGregor, 1960) placed the boundary at the top of this marine band. The revision was made by Forsyth et al (1996)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CB> ;
    lexicon:hasYoungestAgeValue 3.1475e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Coal Measures (Scotland) [Obsolete: use MCMS]"@en ,
