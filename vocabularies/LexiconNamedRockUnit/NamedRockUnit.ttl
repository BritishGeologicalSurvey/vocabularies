    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tidal channel deposits [Obsolete: use TRD]"@en ;
    skos:broader namedrockunit:ITD ;
    skos:definition "Clay, sand, sandy silty clay and silt with subsidiary gravel and peat. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
