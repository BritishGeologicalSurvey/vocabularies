        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use CGU, CYLF] Rhyolitic and acid-keratophyric lavas and tuffs with sporadic slates. (Correlative of Upper Acid Volcanic Group = Craig-y-Llam Group)."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at base of lavas and tuffs of Upper Acid Volcanic Group where they rest conformably on the Llyn Cau Mudstones Group of Llandeilo age."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:CYLL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Approx. 270-450 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from ash beds of the Upper Acid Volcanic Group to the Talyllyn Mudstones of Caradoc age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
