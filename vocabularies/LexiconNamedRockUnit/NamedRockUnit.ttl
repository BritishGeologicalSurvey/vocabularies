        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use HOHE] \r
\r
Gravel, composed of Triassic derived quartzites, flints, Scottish Lake district erratics; local material including Malvernian Jurassic rocks. It includes a local basal fossil bed of silts and sands.Sand and gravel, locally with lenses of silt, clay or peat. [Generic description]."""@en ;
    lexicon:hasLowerBoundaryDefinition "Where river deposits rest on bedrock, glacial or older terrace deposits."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1599 ,
        namedrockunit:H1704 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "The present day terrace surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:HOHE ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
