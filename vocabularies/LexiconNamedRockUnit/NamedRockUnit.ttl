    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 20 m (south Lincolnshire)."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformable, commonly channelled contact between calcilutites, wackestones and packstones below and the high energy ooidal limestones of the overlying Upper Lincolnshire Limestone Member. Near the northern limit only, disconformable contact with ferruginous sandy calcareous sediments of the Hunstanton Formation (Cretaceous)."@en ;
