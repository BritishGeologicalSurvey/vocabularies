namedrockunit:COT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GYPST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine- to medium-grained dolomitic, pale greenish grey, interbedded with mudstone and siltstone, dark greenish-grey. Common gypsum nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at the abrupt base of the lowest pale grey sandstone bed of the Cotgrave Sandstone Member where it overlies the red-brown mudstone of the underlying Gunthorpe Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1453 ,
        namedrockunit:H1454 ,
        namedrockunit:H2716 ,
        namedrockunit:H4566 ;
