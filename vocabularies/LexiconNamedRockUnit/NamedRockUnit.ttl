namedrockunit:ARBI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamict of red-brown silty, clayey, stoney sand with distictive colour-mottled patches of sand that are intensely weathered lithic clasts that appear dark green, yellow, white, orange in colour. Also partly weathered lithic clasts and unweathered clasts that are matrix-supported in the sand matrix. Unweathered clasts are angular to rounded and lithologies include schist, quartz, white coarse-grained sandstone, red medium-grained sandstone, mafic rock, red-brown sandstone and purple sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies sand, reddish-brown, pebbly and compact or unconformably overlies bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0.32m to 1.3m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by diamict of the Mill of Forest Till without the distinctive colour-mottled weathered clasts, or unconformably overlain by recent deposits of alluvium or soil."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MFT ;
    skos:definition "Sand with subsidiary gravel and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ARBI"@en ;
    skos:prefLabel "Arbikie Diamicton Member"@en ;
.

