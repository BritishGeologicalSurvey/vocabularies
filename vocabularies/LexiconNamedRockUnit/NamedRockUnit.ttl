    lexicon:hasThicknessDescription "110 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of a 2m-thick unnamed purple and pale grey tuff bed, about 21m below the top of Synalds Formation. Overlain by purple mudstones and siltstones of the Synalds Formation (undivided)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
