namedrockunit:LDOMI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FELS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HBT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCDI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFIST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basalt, dolerite and gabbro; dacite, garnetiferous dacite, rhyolite; andesite and hybridised andesite; intrusive breccia; microdiorite; porphyritic horneblende diorite and microdiorite; hornblendite."@en ;
    lexicon:hasLowerBoundaryDefinition "Dykes, plugs and other minor intrusions in the Lake District of known and inferred Ordovician age, including two formal lithodemic units, the Embleton microdiorite intrusions (EMBL) and the Bassenthwaite diorite intrusions (BADIN)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasOldestAgeValue 4.869e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/S> ;
    lexicon:hasThicknessDescription "Not defined."@en ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CIGSS ;
    skos:definition "Andesite, basalt, dacite, diorite, dolerite, felsite, gabbro, microdiorite and rhyolite with subsidiary hornblendite and trace breccia and tuffisite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ordovician Period (486.9-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BADIN ,
        namedrockunit:EMBL ;
    skos:notation "LDOMI"@en ;
    skos:prefLabel "Lake District Ordovician Minor Intrusion Suite"@en ;
