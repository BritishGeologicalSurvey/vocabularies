namedrockunit:NEPT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Neptune Formation consists predominantly of fine- to medium-grained, clear and pale coloured sandstone interbedded with thin mudstones. The sandstones are locally calcareous and glauconitic. The thickest sandstone is 23 m, and like most of the sand units has a sharp top and base characterised by an abrupt rise in gamma-ray values and a drop in sonic velocity. The mudstones are medium to dark brown or grey. In the upper part of the unit, individual sandstones tend to be less than 5 m thick, separated by mudstones less than 2 m thick. Below 4244 m (13925 ft) the gamma-ray response from the sandstones is higher and more irregular than the cleaner sandstones in the upper part of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "In the type well, the Neptune Formation rests unconformably on the Triassic Foula Formation. This is characterised by a higher sonic velocity and a more uniform, but higher, gamma-ray value."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription " 159 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Neptune Formation is defined by a downward change from the grey mudstones of the Cruiser Formation into interbedded sandstones and mudstones. This is accompanied by a downward decrease in gamma-ray values and an increase in sonic velocity. Occasional gamma-ray spikes in the mudstones are higher than values recorded in the overlying Cruiser Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CRKN ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Hauterivian Age - to - Aptian Age (Cretaceous Period) (132.6-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NEPT"@en ;
    skos:prefLabel "Neptune Formation"@en ;
.

