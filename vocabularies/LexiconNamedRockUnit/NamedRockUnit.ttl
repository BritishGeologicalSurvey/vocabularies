namedrockunit:WALES
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Suite of glacial, glaciofluvial and glaciolacustrine deposits including sandy diamictons (till), sand, gravel, silt and clay. The sediments were deposited by, or are the deglaciation products of, ice that emanated from the Welsh mountains and radiated across Wales and the Welsh Border. The till deposits vary in colour and clast content reflecting local bedrock. Constituent formations include the Brecknockshire Till Formation containing clasts derived predominantly from the Devonian (Black Mountain, Fforest Fawr and Brecon Beacons) and Carboniferous sources (sedimentary rocks of the South Wales Coalfield), the Plynlimon Till Formation and Shrewsbury Glacigenic Formation containing Lower Palaeozoic clasts of the Cambrian Mountains and the Eryri Till Formation with Lower Palaeozoic volcanic clasts derived from Snowdonia. The till formations contain subordinate stratified sand and gravel. The principal centres of ice build-up were the Cambrian Mountains."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, unconformable contact with bedrock. Locally on Head of Ipswichian or early Devensian age or on units of the Irish Sea Coast Glacigenic Subgroup (e.g. Stockport Glacigenic Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2914 ,
        namedrockunit:H3114 ,
        namedrockunit:H4482 ,
        namedrockunit:S926 ,
        namedrockunit:S933 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable contact with units of the Britannia Catchments Group (West Wales Catchments Subgroup and Cheshire-North Wales Catchments Subgroup) and the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
