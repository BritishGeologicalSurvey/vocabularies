    lexicon:hasThicknessDescription "c. 1600 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at conformable upward passage from the Ward Hill Sandstone to siltstone and mudstone of the Furse Argillaceous Beds at the base of the Observatory Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
