    lexicon:hasThicknessDescription "To 1.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp unconformable, planar to gently undulating contact with pinkish brown shelly clayey diamicton of the Eglinton Shelly Till Member at 11.10m above OD."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
