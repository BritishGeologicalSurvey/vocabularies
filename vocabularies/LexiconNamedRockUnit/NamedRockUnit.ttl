        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the Tay valley catchment, especially the Tay and its major tributaries, the formation consists of a wide range of lithologies encompassing pebbles, fine to coarse gravel, cobbles and boulders in a sandy matrix and coarse- to fine-grained sand, silt and clay. Peat and beds rich in organic remains occur in the floodplain deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies older Quaternary deposits and bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3051 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From a veneer to several metres."@en ;
    lexicon:hasUpperBoundaryDefinition "Normally the land surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fluvial alluvium [Obsolete: use STAY]"@en ;
    skos:broader namedrockunit:TAYCA ;
    skos:definition "Gravel and sand with subsidiary boulders, clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STAY"@en ;
    skos:prefLabel "Strathtay Formation"@en ;
