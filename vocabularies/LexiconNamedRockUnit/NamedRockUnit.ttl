namedrockunit:SBS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLateralEquivalent namedrockunit:WLSF ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red-brown, very fine- to medium-grained, commonly micaceous sandstones, generally cross bedded, some parallel lamination; mudstone clasts locally common, subordinate thin beds of greenish grey sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the lowest main/significant sandstone in the beds transitional with the underlying St Bees Shale Formation. The base is sharply marked on the gamma-ray log; an abrupt change from a highly serrated signature in the lowermost St Bees Sandstone to a much more subdued signature with higher values in the St Bees Shales."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1162 ,
        namedrockunit:H4316 ,
        namedrockunit:H5239 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "340 - 627m proved in UK NIREX Sellafield boreholes."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp upward change from generally fine-grained, well cemented sandstones, with features typical of fluvial deposition, to coarser, more friable sandstones with common well rounded aeolian grains (Calder Sandstone Formation). Marked also by an abrupt decrease in gamma ray values and increase in sonic interval transit time."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower St Bees Sandstone [Obsolete: use SBS]"@en ,
        "St Bees Sandstone Formation [Obsolete: use SBS]"@en ,
        "St Bees Sandstone [Obsolete: use SBS, CHES]"@en ,
        "Wilmslow Sandstone Formation"@en ;
    skos:broader namedrockunit:CHES ;
    skos:definition "Sandstone with subsidiary mudstone, silicate-claystone and siltstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBS"@en ;
    skos:prefLabel "St Bees Sandstone Member"@en ;
.

