namedrockunit:WGAT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QWACKE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly pale olive-grey to brownish grey sandstones and dark greenish grey to pale red subgreywackes with local greenish grey or brownish grey conglomerate beds and members, up to 60m thick, containing variable contents of igneous, chert, quartz and quartzite pebbles in a coarse-grained sandstone matrix. Includes the Fence Conglomerate, Newside Arenite, Kirk Hill Conglomerate and Eastgate Sandstone members."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp incoming of conglomerate belonging to the Fence Conglomerate Member of the Westgate Formation above the predominantly mudstone member of the Carmichael Burn Formation"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2875 ,
        namedrockunit:H3273 ,
        namedrockunit:H3901 ,
        namedrockunit:H749 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.847 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the predominantly sandstone succession belonging to the Eastgate Sandstone Member of the Westgate Formation below the incoming greywacke-pebble bearing conglomerate of the Greywacke Conglomerate Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eastgate Formation [Obsolete: use CARM, EGT, WGAT]"@en ,
