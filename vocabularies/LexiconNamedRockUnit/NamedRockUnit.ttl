        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Anhydrite and/or gypsum, with subordinate dolomite and siltstone, interbedded in cyclical sequences."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the point where the \"basal breccia\" or brockram passes up into grey carbonate-rich siltstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
