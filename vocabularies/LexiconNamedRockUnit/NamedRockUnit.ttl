namedrockunit:BYCS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Red, to deep purple or purplish brown, cross-bedded, micaceous, medium- to coarse-grained sandstone, with subsidiary mudstone and siltstone interbeds, and thin palaeosols. \r
\r
The unit was deposited from a major braided river system that flowed from the north-east. The reddening was either primary or early diagenetic. \r
\r
Bolsovian (Westphalian C) to Asturian (Westphalian D)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary, at the base of the lowest major reddened channel sandstone unit, is unconformable cutting down to the interbedded mudstones, siltstones, and sandstones, with coal seams, of the Pennine Middle Coal Measures Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2654 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Greater than 100 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary with the mudstone dominated Millyeat Member, is at the top of the highest major channel sandstone unit in the Bransty Cliff Sandstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whitehaven Sandstone [Obsolete: use BYCS]"@en ;
    skos:broader namedrockunit:WS ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage - to - Asturian Substage (Carboniferous Period) (314.75-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BYCS"@en ;
    skos:prefLabel "Bransty Cliff Sandstone Member"@en ;
.

