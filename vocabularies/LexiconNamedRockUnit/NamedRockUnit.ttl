namedrockunit:DALO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alternating units of psammite to quartzite and semipelite to pelite; in places becoming calcareous near the top of the Subgroup. Many of the finer-grained lithologies are flaggy, but in some places this may be a tectonic effect. Succession from Grampian Group into Lochaber Subgroup continuous in some areas, e.g. Schiehallion, Banffshire, but in Glen Spean there may be a tectonically modified unconformity at the base of the Leven Schist."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp transition from underlying Grampian Group, from monotonous psammites, generally flaggy, with thin quartzite and semipelite units to better sorted psammite or quartzite and semipelite or pelite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2738 ,
        namedrockunit:H3976 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Variable locally 1500m where untectonised (Lochaber, Banffshire); in Schiehallion district thickness reduced to about 80m, but full succession can still be recognised."@en ;
    lexicon:hasUpperBoundaryDefinition "Incoming of more calcareous sediment, and more graphite in the pelitic and semipelitic rocks, indicating a decrease in the amount of input clastic material."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eilde, Binnein and Glen Coe Quartzites [Obsolete: use DALO]"@en ,
        "Lochaber (Transition) Subgroup [Obsolete: use DALO]"@en ;
    skos:broader namedrockunit:APP ;
    skos:definition "Pelite, psammite, quartzite and semipelite and trace calcareous pelite and calcsilicate-rock. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
