namedrockunit:TASP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red to black mudstone. Lower half is interbedded, with thin beds of siltstone, fine sandstone and rare limestone. Upper half is entirely massive mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the Stac Fada Member (TASF). Marked by incoming of first red mudstone. Locally directly overlying the Lewisian Gneiss (L) on palaeo-highs (e.g. Enard Bay)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasOldestAgeValue 1.2e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100 m (maximum - thins south of Stoer)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the Meall Dearg Formation (TAD). Incoming of red sandstone, with erosive base."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasYoungestAgeValue 1e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TAS ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Stenian Period (Precambrian) (1200-1000 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TASP"@en ;
    skos:prefLabel "Poll a' Mhuilt Member"@en ;
.

namedrockunit:TAT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basal cobble-boulder conglomerate, followed by pebbly, coarse sandstone and medium- fine cross-bedded sandstone, with local beds of red mudstone, red muddy sandstone with dessication cracks, ripple laminations and rare calcareous beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Lewisian Gneiss Complex (L). The unconformity is sharp without weathering. The landscape on which the Clachtoll Formation was deposited was hilly, with palaeo-valley several 100 m deep."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasOldestAgeValue 1.2e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0-190 m (highly variable)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by Bay of Stoer Formation (TAS). The contact is defined as an erosion surface overlain by pebbly red sandstones of the Bay of Stoer Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AI> ;
    lexicon:hasYoungestAgeValue 1e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:TA ;
    skos:definition "Sandstone and trace breccia. Stratified bedrock. Occurs onshore. Deposited during the Stenian Period (Precambrian) (1200-1000 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TAT"@en ;
    skos:prefLabel "Clachtoll Formation"@en ;
.

namedrockunit:TAVA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the fluvial, lacustrine and organic deposits of the River Tamar and its tributaries. It includes floodplain alluvium and the deposits of eight terraces. The floodplain alluvium comprises soft poorly sorted clays, silts and fine-grained sands, with bodies of peat, overlying sands and gravels. The terrace deposits dominantly comprise silty and sandy pebbly clays but include sands and gravels, and silts. The clays are largely derived from Upper Carboniferous and Devonian mudstone bedrock. Gravels are dominantly formed of rounded pebbles up to 50mm diameter of Upper Carboniferous sandstone but also include vein quartz and Lower Carboniferous and Devonian limestone and chert. Tin ore (cassiterite) occurs in the deposits near the Bodmin Granite."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock of Carboniferous and Devonian age, and on intrusive igneous rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c.10m"@en ;
    lexicon:hasUpperBoundaryDefinition "At the land surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CCAT ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TAVA"@en ;
    skos:prefLabel "Tamar Valley Formation"@en ;
.

