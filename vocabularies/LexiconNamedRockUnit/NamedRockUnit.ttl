namedrockunit:CHAP
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone with an abundance of calcrete development in the form of massive limestones, tubules and large concretions, and interbedded intraformational calcrete-clast conglomerates at the type locality (Williams et al., 1982); elsewhere, it comprises similarly white, rubbly limestone, or a group of limestones, generally culminating in one or more thick, massive limestone(s) at or near the top of the member."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is gradational, and placed where red mudstones become increasingly calcretised and pass into the lowermost of a thick sequence of stacked calcrete horizons."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BFLS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SO> ;
    lexicon:hasOldestAgeValue 4.227e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Thickness is variable, ranging from 5.7 m to over 30 m on Caldey Island. Elsewhere, it is up to about 12 m."@en ;
    lexicon:hasUpperBoundaryDefinition "In south Pembrokeshire, the upper boundary is placed at the sharp, conformable junction of the basal sandstone of the Conigar Pit Sandstone Member of the Freshwater West Formation, where it overlies the topmost calcrete of the Chapel Point Limestone Member. Elsewhere, the upper boundary is placed at the sharp, conformable junction between the topmost, well developed calcrete of the member and the overlying sandstone at the base of the Freshwater West Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bishop's Frome Limestone Member [Obsolete: use CHAP]"@en ;
    skos:broader namedrockunit:MOCL ;
    skos:definition "Calcrete and mudstone with subsidiary conglomerate and limestone. Stratified bedrock. Occurs onshore. Deposited during the Pridoli Epoch (Silurian Period) - to - Lochkovian Age (Devonian Period) (422.7-412.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHAP"@en ;
    skos:prefLabel "Chapel Point Limestone Member"@en ;
.

namedrockunit:CHAR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly lime-muddy, shelly, shell-detrital limestones and some ooid-grainstones and ooidal limestones (limestone 60-80% of the formation); subordinate shelly, shell-detrital calcareous mudstone with subordinate silicate mudstone; entire fossils abundant."@en ;
    lexicon:hasLowerBoundaryDefinition "Well-defined by the sharp change up into limestone beds from dark bluish grey mudstone of the Sharp's Hill Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:SHHB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Generally 3 to 5m. 3-3.6m at the type section. 4.2-4.8m in boreholes near Stonesfield, Oxon, about 3km south-east of type section.  4.83m in Stonesfield Borehole No 3 (reference section)."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined throughout by base of the undifferentiated Taynton Limestone Formation, which comprises mainly non-muddy, commonly cross-bedded, shell-detrital ooid-grainstones and ooidal limestones in which entire fossils are rare."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sharp's Hill Formation"@en ;
    skos:broader namedrockunit:TY ;
    skos:definition "Calcareous mudstone and limestone with subsidiary ooid-limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHAR"@en ;
    skos:prefLabel "Charlbury Limestone Member"@en ;
.

