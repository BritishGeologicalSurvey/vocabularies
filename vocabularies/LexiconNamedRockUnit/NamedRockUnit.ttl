    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "5 to 15 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp upward change in a conformable succession from sandstone to predominantly mudstone - top of last sandstone bed below the Wandley Gill Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasYoungestAgeValue 3.215e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
