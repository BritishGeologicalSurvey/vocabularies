namedrockunit:CRN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A fine- to coarse-grained locally pebbly lithic sandstone with lenses of conglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "Grey, laminated sandy siltstone of the Cowie Harbour Siltstone Member conformably overlain by a thick sequence of red, fine- to medium-grained, trough cross-bedded and horizontally-laminated sandstone"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DRG ,
        namedrockunit:H166 ,
        namedrockunit:H3330 ,
        namedrockunit:H3958 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SW> ;
    lexicon:hasOldestAgeValue 4.329e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Measured as between 1200 m to 1800 m thick in the type area, and broadly consistent across unit extent, it is presumed to lap onto basement of the Highland Border Complex and probable Dalradian rocks, and also to be overlapped by younger groups."@en ;
    lexicon:hasUpperBoundaryDefinition "At the base of a thickly-bedded or massive conglomerate of the Downie Point Conglomerate Member of the Dunnothar Castle Conglomerate Formation overlies planar bedded or cross-bedded pebbly sandstone"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasYoungestAgeValue 4.227e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
