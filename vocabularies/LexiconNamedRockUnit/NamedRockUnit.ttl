namedrockunit:FOF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Heterolith of dark-grey, peloidal limestones, shelly, oncolitic and locally oolitic limestones, porecllanous limestones, and fossil plant-bearing calcareous siltstones and calcareous sandstones.  Limestones locally dolomitised. The oldest exposed parts of the Clwyd Limestone Group, the Foel Formation records peritidal deposition during the onset of the Dinantian transgression of North Wales."@en ;
    lexicon:hasLowerBoundaryDefinition "Locally conformably overlies reddened \"Basement Beds\" (Ffernant Formation or Penbedw Formation); but elsewhere rests unconformably on Silurian rocks of the Clwydian Range (Nantglyn Flags Formation and Elwy Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LBRL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 88m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable contact with thicker-bedded limestones of the Llanarmon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
