    lexicon:hasThicknessDescription "To 550m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top of dominantly graphitic rocks below the overlying dominantly quartzite succession of the Creag Leacach Quartzite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
