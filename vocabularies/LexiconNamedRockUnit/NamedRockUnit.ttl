namedrockunit:PERT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold phase sands and gravels that underlie the Avon Fifth Terrace of Tomlinson (1925) and of BGS Maps (sheets 199, 200 and 216). Dominated by clasts of 'Bunter' quartz/quartzite lithologies with subordinate flint. Terrace surface some 40 m above modern Avon alluvial floodplain at type locality, where it includes the organic Allesborough Bed (the Pershore Fossil Bed of Maddy at al., 1991) at base, which is  assigned to MIS 9. Probably equates with Frog Hall Member of the upstream Avon/Leam, and with Bushley Green Member of the Severn Valley Formation. \r
\r
River terrace deposits. Mid Pleistocene (MI Stage 9 to 8)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base on Lower Jurassic or Triassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2366 ,
        namedrockunit:H2973 ,
        namedrockunit:H3609 ,
        namedrockunit:H4250 ,
        namedrockunit:H446 ,
        namedrockunit:H447 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 7 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Avon Fifth Terrace (Deposits) [Obsolete: use PERT]"@en ,
        "Fifth Terrace (Deposits) [Obsolete: use PERT]"@en ,
        "Fifth or Pershore Terrace (Deposits) [Obsolete: use PERT]"@en ,
        "No 5 Terrace (Deposits) [Obsolete: use PERT]"@en ,
        "Pershore Member [Obsolete: use PERT]"@en ,
        "Pershore Terrace Deposits (Warwickshire Avon) [Obsolete: use PERT]"@en ;
    skos:broader namedrockunit:AVON ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PERT"@en ;
    skos:prefLabel "Pershore Sand and Gravel Member"@en ;
