namedrockunit:STT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A green tuff containing beds of coarse lapilli in a calcareous cement. To the east of Grangemill (SK 244 578) the tuffs interdigitate with limestone in the Bottom Leys Farm Borehole (SK25NE/41) (SK 2587 5795). In the latter, the tuffs include medium-to coarse-grained, angular to subrounded fragments of mudstone and limestone in a fine-grained grey to dark grey or green matrix."@en ;
    lexicon:hasLowerBoundaryDefinition "The tuffs of the Shothouse Spring Tuff Member rest upon thickly bedded limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1209 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Unknown in the type area. Seen as 3 leaves, in ascending order 6.90, 0.32 and 4.93 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The tuffs of the Shothouse Spring Tuff Member are overlain by thickly bedded limestones of the Monsal Dale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Shothouse Spring Tuff [Obsolete: use STT]"@en ;
    skos:broader namedrockunit:MO ;
    skos:definition "Tuff with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STT"@en ;
    skos:prefLabel "Shothouse Spring Tuff Member"@en ;
.

namedrockunit:STTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:ANSR ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CSZVB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale brown to mid grey, poorly sorted, clay-rich, matrix-supported diamicton with boulders. The till shows good evidence of subglacial deposition; namely edge-rounded and bullet-shaped striated clasts set within a stiff, highly consolidated muddy matrix. In places the diamict exhibits a strong subhorizontal fissility, is overconsolidated, and was most likely deposited by subglacial lodgement processes. Clasts are predominantly Moine Supergroup rocks, with minor amounts of Eriboll sandstone (quartzite). Sporadic clasts of Torridon Group sandstone, Lewisian gneiss and various local igneous rocks are also present. The till may also contain reworked glaciofluvial and/or morainic deposits of Devensian age or older."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock, predominantly Moine Supergroup psammite."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Variable; 0.5-8 m (maximum observed thickness), probably > 10 m locally."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain locally by Holocene (Flandrian) deposits, typically peat or (glacio)fluvial gravel."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Allt an t-Srathain Member [Duplicate: use STTI]"@en ;
    skos:broader namedrockunit:ASGL ;
    skos:definition "Bouldery gravelly silty sandy clay and diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STTI"@en ;
    skos:prefLabel "Allt an t-Strathain Till Member"@en ;
.

