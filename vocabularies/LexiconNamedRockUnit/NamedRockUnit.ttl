namedrockunit:SNSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent
        namedrockunit:S826 ,
        namedrockunit:YSH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greenish grey, laminated mudstones and siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Uncertain, formerly taken at the base of the Helmeth Grit Member (Greig et al, 1968), although more recent work (Pauley, 1990) suggests that the latter forms part of the apparently underlying Ragleth Tuff Formation.  Alternatively, it may underlie or form part of the Ragleth Tuff. The boundary between the Helmeth Grit Member and the Stretton Shale Formation has been variously interpreted as conformable (Greig et al, 1968 and other authors) or unconformable (Pauley, 1990)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3041 ,
        namedrockunit:H3687 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Over 900m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally taken at the relatively sharp, conformable contact with the base of the Buxton Rock Member, the lowest division of the Burway Formation.  However the transition from the mudstone dominated Stretton Shale Formation into the sandstone dominated Burway Formation takes place over several metres."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Stretton Shale Formation [Duplicate: use SNSH]"@en ,
        "Stretton Shale Group [Obsolete: use SNSH]"@en ,
        "Stretton Shale [Obsolete: use SNSH]"@en ,
        "Watling Shales; Brockhurst Shales"@en ;
    skos:broader namedrockunit:YST ;
    skos:definition "Mudstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SNSH"@en ;
    skos:prefLabel "Stretton Shale Formation"@en ;
