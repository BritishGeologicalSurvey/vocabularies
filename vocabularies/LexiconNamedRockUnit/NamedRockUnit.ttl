namedrockunit:BVR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ASH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown to white, dolmitic, locally ooidal limestone with rare thin volcanic rock beds of 'green ash'."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is inferred to be an unconformity (Riley, 1992), with the grey, buff or brown, dolomitic limestones of the Milldale Limestone Formation overlain by brown to white dolmitic, locally ooidal limestones of the Belvoir Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "120m thick in the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is inferred to be an unconformity (Riley, 1992), with the dolomitic, locally ooidal limestones of the Belvoir Limestone Formation overlain by a grey, pebbly sandstone present at the base of the overlying Plunger Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolomitic limestone and limestone with subsidiary ooid-limestone and trace ash. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BVR"@en ;
    skos:prefLabel "Belvoir Limestone Formation"@en ;
