    lexicon:hasLithologyDescription "Dark red sandy, silty clayey diamicton containing clasts of gravel to cobble grade (1-10 cm). Semi-consolidated, matrix-supported. Clasts are subrounded to subangular consisting of sandstone, quartz and a hard, red mudstone, and have no apparent preferred orientation."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of till not seen at type section, but probably rests on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasOldestAgeValue 2.6e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 4 m."@en ;
    lexicon:hasUpperBoundaryDefinition "At surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasYoungestAgeValue 1.47e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BDRGL ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Dimlington Stadial (Quaternary Period) (.026-.0147 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NMTI"@en ;
    skos:prefLabel "Norham Till Formation"@en ;
