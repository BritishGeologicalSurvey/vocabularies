    lexicon:hasThicknessDescription "31.1 - 37.8m at Wren's Nest, Dudley."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the limestone-dominated Upper Quarried Limestone Member, overlying limestone with grey calcareous mudstone partings."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SH> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
