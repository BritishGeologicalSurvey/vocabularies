        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded units of semipelite with graphitic pelite, beds of crystalline metalimestone, quartzite and minor dolomite. Distinctive kyanite after andalusite in graphitic pelite of basal Sandy Pots Limestone Member. Some pebbly quartzite and psammite."@en ;
    lexicon:hasLowerBoundaryDefinition "First limestone bed above Castle Point Pelite Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DBPB ,
        namedrockunit:H472 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Probably c.200m+, but much disrupted by Portsoy basic intrusion and movement along Portsoy Shear Zone."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen at type section: upper part cut out by Portsoy basic intrusion and Portsoy Shear Zone. Screens and rafts of semipelite and metalimestone in basic body."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Portsoy Group [Obsolete: use CAPT, PTSL]"@en ,
        "Upper part of Portsoy Group [Obsolete: use PTSL]"@en ;
    skos:broader namedrockunit:DBED ;
    skos:definition "Metalimestone and semipelite with subsidiary calcsilicate-rock, graphitic pelite, psammite and quartzite and trace dolostone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PTSL"@en ;
    skos:prefLabel "Portsoy Limestone Formation"@en ;
