namedrockunit:RUBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GNGNS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PGGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises granite, which is commonly foliated; granite gneiss and pegmatitic veins and pods. The granite is generally pink, coarse-grained and fairly homogenous, consisting of K-feldspar, plagioclase (oligoclase), quartz, minor biotite and accessory titanite and epidote. Intrusions belonging to this suite occur as WNW-ESE sheets in a zone along the Laxford Front, and have been variably deformed during the Laxfordian event at about 1750 Ma."@en ;
    lexicon:hasLowerBoundaryDefinition "The Rubha Ruadh Granite is intrusive into the Inchard Gneiss."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1154 ,
        namedrockunit:H2257 ,
        namedrockunit:H3651 ,
        namedrockunit:H3652 ,
        namedrockunit:H3653 ,
        namedrockunit:LAX ,
        namedrockunit:LLX ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LD> ;
    lexicon:hasThicknessDescription "From 1m to about 200m"@en ;
    lexicon:hasUpperBoundaryDefinition "N/a"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Laxfordian (in part Rhiconich Group) [Obsolete: use ICGN, RUBR]"@en ,
        "Laxfordian Granite Vein Complex [Obsolete: use RUBR]"@en ,
        "Laxfordian Granite Vein-Complex (within Lewisian Complex) [Obsolete: use RUBR]"@en ,
        "Laxfordian [Obsolete: use RUBR, ICGN]"@en ,
        "Loch Stack Granite [Obsolete: use RUBR]"@en ,
        "Rubha Ruadh Granites [Obsolete: use RUBR]"@en ,
        "Rudha Ruadh Granite-Gneiss [Obsolete: use RUBR]"@en ;
    skos:broader namedrockunit:L ;
    skos:definition "Granite with subsidiary gneissose granite and pegmatitic granite. Bedrock. Occurs onshore. Formed during the Paleoproterozoic Era (Precambrian) (2500-1600 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
