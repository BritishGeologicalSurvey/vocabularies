    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "c.200m at the type section, thins eastwards to less than 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the incoming of calcareous siltstones of the Middle Coldwell Beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SH> ;
    lexicon:hasYoungestAgeValue 4.267e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BKR ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Birk Riggs Formation"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Homerian Age (Silurian Period) (430.6-426.7 Ma BP)."@en ;
