    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "240 to 500m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable upper contact with overlying late Cambrian,Tremadoc or basal Arenig strata, (Dolgellau, Dol-cyn-afon or Allt Llwyd formations). The base of the overlying Arenig is characterized locally by sandstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
    lexicon:hasYoungestAgeValue 4.869e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MWG ;
    skos:definition "Sandstone and siltstone with subsidiary pebbly (gravelly) sandstone and trace ironstone. Stratified bedrock. Occurs onshore. Deposited during the Merioneth Series (Cambrian Period) (499-486.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CGR ;
    skos:notation "MAF"@en ;
    skos:prefLabel "Marchlyn Formation"@en ;
