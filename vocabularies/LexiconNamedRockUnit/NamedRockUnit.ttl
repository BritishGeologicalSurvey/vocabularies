namedrockunit:HBO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly ooidal limestones, with subordinate skeletal, peloidal and oncolitic limestones and calcite mudstones. Mainly dolomitised on the southeast and east crop of the South Wales Coalfield."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Subgroup is gradational and taken at the incoming of a predominantly oolitic grainstone sequence, locally with units of calcite mudstone, above the skeletal packstones or skeletal/peloidal/oolitic packstone/grainstones of the underlying High Tor Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CDGP ,
        namedrockunit:DL ,
        namedrockunit:H3459 ,
        namedrockunit:H3460 ,
        namedrockunit:H4087 ,
        namedrockunit:H874 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "245m in central Vale of Glamorgan thinning northwards to a feather edge in the Forest of Dean."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Vale of Glamorgan the top is taken at the sharp contact, defined by a palaeokarstic surface, between the heterolithic lithologies of the Subgroup and the overlying partially dolomitised sandy skeletal packstones and the calcareous sandstones of the Pant Mawr Sandstone Member [Oxwich Head Limestone Formation]. In the Gower and Pembrokeshire it is taken at the palaeokarstic surface separating the heterolithic lithologies of the Subgroup from the mottled and pseudobrecciated skeletal packstones of the overlying Oxwich Head Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clifton Down Group [Obsolete: use BO, HBO, PEMB]"@en ,
        "Drybrook Limestone Formation [Obsolete: use HBO]"@en ,
        "Drybrook Limestone [Obsolete: use DS, HBO]"@en ,
        "Hunts Bay Group [Obsolete: use HBO]"@en ,
        "Hunts Bay Oolite Formation [Obsolete: use HBO]"@en ,
        "Hunts Bay Oolite Group [Obsolete: use HBO]"@en ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Ooid-limestone with subsidiary calcite-mudstone and dolomitic limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Holkerian Substage (Carboniferous Period) (344.5-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CNLL ,
        namedrockunit:STYL ;
    skos:notation "HBO"@en ;
    skos:prefLabel "Hunts Bay Oolite Subgroup"@en ;
.

namedrockunit:HVBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown, mainly fine-grained, breccia; clasts (mainly less than 8cm, some 30cm+) of Culm sandstone, vein quartz, hornfels lava, granite, and potassium feldspar (Murchisonite). Well cemented locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies Alphington Breccia; defined by marked increase in amount of Murchisonite feldspar. Basal beds form a prominent scarp over the less well cemented Alphington Breccia."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EXBR ,
        namedrockunit:H1607 ,
        namedrockunit:H2251 ,
        namedrockunit:H2252 ,
