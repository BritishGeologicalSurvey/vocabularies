namedrockunit:YORKM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLAM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CSVLB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCVLB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glacial till comprising sandy clay, clayey sand and clay with erratic pebbles, cobbles and boulders mainly of Carboniferous sandstone and limestone. The Member also includes local deposits of sand and gravel plus local deposits of clay and laminated clay incorporated into the sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock, or pre-existing superficial deposits such as fluvial and glacial deposits."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4989 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 50m"@en ;
    lexicon:hasUpperBoundaryDefinition "The present land surface, which forms an elongated moraine ridge, or unconformable contact with overlying deposits to north and south including the Alne Glaciolacustrine Formation and the Elvington Glaciolacustrine Formation respectively."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "York Moraine [Obsolete: use YORKM]"@en ;
    skos:broader namedrockunit:VYORK ;
    skos:definition "Bouldery cobbly gravelly clayey sand and bouldery cobbly gravelly sandy clay with subsidiary gravel and sand and trace laminated clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "YORKM"@en ;
    skos:prefLabel "York Moraine Member"@en ;
