namedrockunit:BAVON
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The formation encompasses the fluvial, lacustrine and organic deposits of the Bristol Avon river. It includes floodplain alluvium and deposits of three river terraces. The floodplain alluvium comprises soft clays, silts and fine sands, with bodies of peat, all overlying sands and gravels. The terrace deposits include gravels, sands, silts and clays; the gravel clasts are dominantly local Jurassic limestones, Triassic sandstones and Carboniferous limestone, but also include some glacially-derived erratics from northwest England and the Welsh Borders. \r
\r
Anglian to Holocene (MIS 12 - 1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Jurassic, Triassic and Carboniferous bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SACA ;
    skos:definition "Clay, sand and silt with subsidiary gravel and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BA1T2 ,
        namedrockunit:BAV1 ,
        namedrockunit:BAV2 ,
        namedrockunit:BAV3 ;
    skos:notation "BAVON"@en ;
    skos:prefLabel "Bristol Avon Valley Formation"@en ;
.

namedrockunit:BBKS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A brick-red, trough cross-bedded, medium- to coarse-grained sandstone, with siltstone interbeds containing large abundant well-rounded sand grains with haematite pellicles interpreted to be of aeolian provenance."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable upon the top of the Shap Wells Conglomerate Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1332 ,
        namedrockunit:H3819 ,
        namedrockunit:H671 ,
        namedrockunit:SHPC ;
