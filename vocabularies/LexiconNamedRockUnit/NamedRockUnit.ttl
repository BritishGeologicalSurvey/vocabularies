namedrockunit:COMM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Commodore Formation consists of white to light grey, calcareous, fine- to medium-grained sandstones, interbedded with thin grey mudstones and white to pale grey limestones. The sandstones are locally coarse and may contain intraformational pebbles, glauconite and comminuted shell fragments (Meadows et al. 1987)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Commodore Formation is normally marked by a sharp downward change from sandstones into grey mudstones of the Cruiser Formation. This is marked by an abrupt rise in gamma-ray values and a drop in sonic velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasOldestAgeValue 1.132e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "In the type well it is 312.5 m thick, reducing to less than 40 m in 205/10-2B, 206/5-1 and 208/26-1. Its westerly limit is unknown, although it proved to be absent in 214/29-1Z. The thickest section (947 m) is recorded in 206/11-1. Further south the unit thins rapidly."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Commodore Formation is usually marked by a downward change from the interbedded limestones, mudstones and thin sandstones of the Svarte Formation into more uniform sandstones. It is marked on wireline logs by a drop to lower gamma-ray values, and a small increase in sonic velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CRKN ;
    skos:definition "Sandstone with subsidiary limestone and mudstone. Stratified bedrock. Occurs offshore. Deposited during the Albian Age - to - Cenomanian Age (Cretaceous Period) (113.2-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PHOEB ;
    skos:notation "COMM"@en ;
    skos:prefLabel "Commodore Formation"@en ;
.

