    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "c.60m, sheet like bodies."@en ;
    lexicon:hasUpperBoundaryDefinition "None."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "North Charnwood Diorites [Obsolete: use NCHD]"@en ;
    skos:definition "Diorite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "NCHD"@en ;
    skos:prefLabel "North Charnwood Diorite"@en ;
