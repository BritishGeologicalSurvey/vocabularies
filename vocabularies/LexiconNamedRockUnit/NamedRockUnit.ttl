namedrockunit:CAMV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses the fluvial, lacustrine and organic deposits of the River Cam and its tributaries. Four terraces are known. The terrace deposits comprise well bedded to rather poorly bedded sands and sandy gravels, deposited by a braided river in a periglacial environment. The pebbles are dominantly rounded chalk and rounded to angular flint, with a few glacial erratics. The three higher terraces are cryoturbated. Alluvial fan deposits comprise poorly sorted flinty chalky sand and gravel, with boulders of basalt and quartzite. The floodplain alluvium comprises silts, clays and fine sands, with bodies of peat, overlying sands and gravels."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Middle Pleistocene glacial deposits and on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.13m"@en ;
    lexicon:hasUpperBoundaryDefinition "Land surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ONCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BABY ,
        namedrockunit:BPIT ,
        namedrockunit:BSTA ,
        namedrockunit:HNRD ,
        namedrockunit:HURD ,
        namedrockunit:LWIB ,
        namedrockunit:SKAV ;
    skos:notation "CAMV"@en ;
    skos:prefLabel "Cam Valley Formation"@en ;
.

namedrockunit:CBG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PHOST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Glauconitic marl: Thin but distinctive condensed basement bed of pale greenish grey marl rich in phosphatic nodules (so called \"coprolites\") at base. Much dark green glauconite as sand-sized grains, disseminated or concentrated in pods and layers giving a sandy texture and hence name \"greensand\". Rare erratic pebbles at base. (Hawkes, 1943)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is a disconformity at a sharp contact; commonly burrowed on underlying grey Gault clay; glauconitic burrow infillings to 0.3m below junction."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CAMG ,
        namedrockunit:H113 ,
        namedrockunit:H2056 ,
        namedrockunit:H3279 ,
        namedrockunit:H3904 ,
        namedrockunit:H4494 ,
        namedrockunit:H4521 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 0.1 to 1.0m. Locally thicker developments infilling hollows on top of the Gault. 0.5 to 0.7m at Arlesey Brickpit [TL 188 347]. (Hopson, 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the rapid upward transition to \"Chalk Marl\", West Melbury Marly Chalk Formation or Lower Chalk lacking distinctive glauconite grains and nodule concentrations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cambridge Bed [Obsolete: use CBG]"@en ,
        "Cambridge Greensand [Obsolete: use CBG]"@en ,
        "Chloritic Marl [Obsolete: use BRHD, CBG, GLML]"@en ,
        "Coprolite Bed [Obsolete: use CBG]"@en ,
        "Glauconitic Marl [Obsolete: use CBG]"@en ,
        "Nodule Bed [Obsolete: use CBG]"@en ,
        "Phosphate Bed [Obsolete: use CBG]"@en ;
    skos:broader namedrockunit:WMCH ;
    skos:definition "Calcareous mudstone and glauconitic mudstone with subsidiary phosphorite. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBG"@en ;
    skos:prefLabel "Cambridge Greensand Member"@en ;
.

namedrockunit:CDE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Calders Member comprises a succession of black to grey mudstones, grey siltstones and white, grey and pink sandstones with thin beds of grey argillaceous limestones and dolostone (cementstone), and algal-rich black to grey oil-shales with some lapilli-tuff beds. The strata are not disposed in readily recognisable sedimentary cycles, and almost all are of lacustrine and fluvial origins. The member includes the Dalmahoy Oil-Shale, Hailes Sandstone (with a maximum thickness of about 57m that was much worked in the past for dimension stone, and the Pumpherston Oil-Shale. A regionally persistent but thin (<1 m thick) algal dolostone has been recognised at Hopetoun and Queensferry."@en ;
    lexicon:hasLowerBoundaryDefinition "The Redhall (Humbie) Marine Band defines the base of the member, the lowest of the Macgregor Marine Bands. This bed is up to 0.3m thick and in Edinburgh is contained within at least 13.8 m of generally tough, black and dark grey mudstones, the lowest 9m of which form the top of the underlying Gullane Formation (Chisholm and Brand, 1994, p.100) and assigned to the currently undefined Wardie Shales Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The average thickness is 290m (Cameron and McAdam, 1978, fig.2), but it is estimated to reach 350m west of Edinburgh."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined as the base of the Burdiehouse Limestone (Mitchell and Mykura, 1962, p.67). This distinctive limestone, at the base of the overlying Hopetoun Member, is a lacustrine deposit, 6 - 9m thick, containing abundant fossilised ostracod, plant and fish remains and rare algal oncoliths."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:WLO ;
    skos:definition "Mudstone and sandstone with subsidiary basaltic tuff, calcilutite, sapropelite and tuff. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DYSH ,
        namedrockunit:HSS ,
        namedrockunit:HUSB ,
        namedrockunit:PMSH ,
        namedrockunit:PNSB ,
        namedrockunit:QCS ,
        namedrockunit:RDH ;
    skos:notation "CDE"@en ;
    skos:prefLabel "Calders Member"@en ;
.

