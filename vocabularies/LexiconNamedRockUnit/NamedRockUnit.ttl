    lexicon:hasThicknessDescription "25 to 35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the ferruginous siltstones, sandstones and ironstones of the Trygarn Formation, the boundary being taken at the top of the highest coarse clastic bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OF> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
