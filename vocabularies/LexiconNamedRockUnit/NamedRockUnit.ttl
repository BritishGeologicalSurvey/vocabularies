namedrockunit:STFA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A lower member comprises thinly interbedded laminated dolostones, dolomitic-siliciclastic siltstone, mudstone and laminated anhydrite. This is overlain by interbedded sandstone, siltstone, mudstone and thin limestone. The sandstones are arkosic, pale grey, fine-grained, micaceous and carbonaceous. Limestones are dark grey micrites with subordinate packstones and wackestones.The upper member comprises interbedded limestone, siltstone and mudstone, lithologically similar to the middle member, but lacking sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen, but possibly an angular unconformity above Lower Palaeozoic sandstone, siltstone and mudstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 165m"@en ;
    lexicon:hasUpperBoundaryDefinition "A deeply fissured top surface marking a significant non-sequence, overlain by conglomerates of the Chapel House Limestone Formation and underlain by limestone, siltstone and mudstone of the Stockdale Farm Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Dolostone, limestone, sandstone and siltstone with subsidiary anhydrite-stone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Chadian Substage (Carboniferous Period) (359.3-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "STFA"@en ;
    skos:prefLabel "Stockdale Farm Formation"@en ;
.

