namedrockunit:DRSH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Fissile, thinly bedded and laminated, grey to black calcareous mudstone and siltstone, with an abundant shelly fauna. Locally, pervasively bleached adjacent to intrusions. \r
\r
The depositional environment was on an open shelf with conditions suitable for the abundant marine fauna. \r
\r
The formation contains a Longvillian fauna of trilobites and brachiopods (Dean, 1963)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Neither the base nor top of the formation are proved because the outcrops are either faulted or in contact with intrusive igneous rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1516 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OL> ;
    lexicon:hasOldestAgeValue 4.53833e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/OL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 200 m seen, but full thickness unknown."@en ;
    lexicon:hasUpperBoundaryDefinition "Neither the base nor top of the formation are proved because the outcrops are either faulted or in contact with intrusive igneous rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OL> ;
    lexicon:hasYoungestAgeValue 4.525e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Drygill Shales [Obsolete: use DRSH]"@en ;
    skos:broader namedrockunit:DNT ;
    skos:definition "Calcareous mudstone and calcareous siltstone. Stratified bedrock. Occurs onshore. Deposited during the Longvillian Substage (Ordovician Period) (453.833-452.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DRSH"@en ;
    skos:prefLabel "Drygill Mudstone Formation"@en ;
.

