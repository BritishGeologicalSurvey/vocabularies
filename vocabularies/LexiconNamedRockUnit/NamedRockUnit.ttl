namedrockunit:LMB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olivine basalt, usually very amygdaloidal with calcite-zeolite-and chlorite-filled vesicles. The central parts of flows may be non-vesicular. The lava is typically very weathered. Intervening beds of clay, tuff and limestone are locally present."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Lower Miller's Dale Lava Member, evident at Tideswell Dale (SK 154 740), is rubbly, resting directly upon about 1 m of red clay with columnar or prismatic structures up  to 6 cm in diameter, possibly weathered basalt, believed to rest upon thermally altered limestone of the Bee Low Limestone Formation.(Waters, 2003)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3530 ,
        namedrockunit:H4166 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 30 m thick at Wormhill (SK 123 741), decreasing in thickness rapidly to the north."@en ;
    lexicon:hasUpperBoundaryDefinition "Vesicular lava of the Lower Miller's Dale Lava Member is overlain by limestone of the Miller's Dale Limestone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Miller's Dale Basalt [Obsolete: use LMB]"@en ,
        "Lower Miller's Dale Lava [Obsolete: use LMB]"@en ;
    skos:broader namedrockunit:BLL ;
    skos:definition "Basalt with subsidiary limestone and tuff. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LMB"@en ;
    skos:prefLabel "Lower Miller's Dale Lava Member"@en ;
.

