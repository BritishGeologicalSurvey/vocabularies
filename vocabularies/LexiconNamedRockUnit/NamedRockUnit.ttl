    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 14m"@en ;
    lexicon:hasUpperBoundaryDefinition "In the Clydach Valley the top is a sharp junction, where fine-grained dolostones of the Coed Ffyddlwn Formation overlie the topmost ooidal grainstones of the Blaen Onnen Oolite Formation. At the type locality, the top is an irregular palaeokarstic surface unconformably overlain by green clay forming the base of the Llanelly Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
