namedrockunit:PRIS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent
        namedrockunit:S198 ,
        namedrockunit:S935 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Generally a dull brown or reddish brown, sandy silty clay with well dispersed fine pebbles and sparse ironstone nodules. The Prismatic Clay derives its name from the closely spaced, subvertical, prismatic jointing that formed during dry periglacial conditions."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a planar, subhorizontal to undulating gradational boundary with dark brown or purplish brown, stony silty sandy clay diamicton of the Horden Till Formation. Where thin deposits of sand and gravel intervene locally, the Prismatic Clay forms pipes and load structures into the underlying sand and gravel. Locally conformably overlies reddish brown sandy silty clay formerly assigned to the Pelaw Clay by Smith (1994), but containing chalk and flint."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2985 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Generally about 0.5m but up to 1.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface. Locally concealed by blown sand."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Pelew Clay"@en ,
        "Prismatic Clay [Obsolete: use PRIS]"@en ,
        "Upper Clays [Obsolete: use PELC]"@en ;
    skos:broader namedrockunit:HNTI ;
    skos:definition "Silt with subsidiary clay and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PRIS"@en ;
    skos:prefLabel "Prismatic Clay Member"@en ;
.

namedrockunit:PRNA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDSTGR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey brown to dark blue, sandy, mudstone with bivalves, overlain by greenish, calcareous, coarse-grained sandstone. The beds are fossiliferous throughout and the lower Bed 1 of Simpson (1985) includes basal coarse-grained quartz 'grit' with bone fragments, fish teeth, phosphatic nodules and rolled ammonites (the Atherfield Bone-Bed of Simpson)."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformable contact between the grey rhythmically-bedded sandstones and mudstones of the underlying Shepherd's Chine Member (Vectis Formation) and the fossiliferous coarse-grained quartz grit of the Atherfield Bone-Bed (Simpson, 1985, Bed 1) at the base of the Perna Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1773 ,
        namedrockunit:H2380 ,
        namedrockunit:H468 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1.8m at the type site."@en ;
    lexicon:hasUpperBoundaryDefinition "Boundary at the upward change from coarse-grained greenish sandstone (Simpson, 1985, Bed 2) into chocolate brown to pale bluish grey mudstone (Simpson, 1985, Bed 3) of the Chale Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Perna Beds Member [Obsolete: use PRNA]"@en ,
        "The Perna Bed [Obsolete: use PRNA]"@en ,
        "The Perna Mulleti Bed [Obsolete: use PRNA]"@en ;
    skos:broader namedrockunit:AC ;
    skos:definition "Calcareous sandstone, mudstone and sandy mudstone with subsidiary gritty sandstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PRNA"@en ;
    skos:prefLabel "Perna Member"@en ;
.

