    lexicon:hasThicknessDescription "155m in type section (120m - bh4; 150m in RCF3)"@en ;
    lexicon:hasUpperBoundaryDefinition "At sharp upward change to pyroclastic breccia of the Sides Farm Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
