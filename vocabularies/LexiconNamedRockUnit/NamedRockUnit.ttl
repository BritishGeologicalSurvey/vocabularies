        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/UMR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pelites, dark-grey, graphitic in parts, commonly andalusite-bearing, phyllitic to slaty. Bands of metabasalt and ultramafic rock, particularly in lower part."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of thick persistent unit of greywacke grit at the top of interbedded grits and metavolcanic rocks characteristic of the lower part of the Blackwater Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "900m (based on outcrop width of 1km, with no allowance for probable folding)."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of overlying thick quartzite (the Grumack Hill Quartzite Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BLWR ;
    skos:definition "Pelite with subsidiary metamorphic rock [obsolete code: use +#met] and ultramafic-rock and trace graphitic pelite, gritty psammite and metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COPE"@en ;
    skos:prefLabel "Corinacy Pelite Member"@en ;
