namedrockunit:LDYW
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:LAWA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises dark to medium grey, calcareous, micaceous, shelly mudstone. Upward-fining sandstone-siltstone units, with burrowed bases, occur."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by a downward change from dark, fossiliferous mudstone to white to pale grey sandstones with interbedded mudstone (Mains Formation), and a marked down-section decrease in average gamma-ray values and an increase in velocity."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5107 ,
        namedrockunit:H5108 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed between an upward-coarsening siltstone-sandstone unit (Orrin Formation) and mudstone (Lady's Walk Formation). The boundary corresponds to the top of a low velocity spike. Where the Orrin Formation is absent, the upper boundary is placed at a downward change from sandstone (Beatrice Formation) to shelly mudstone, or sandstone and mudstone (Brora Coal Formation) to shelly mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dronach Shale Member [Obsolete: use LDYW]"@en ,
        "Lady's Walk Shale Member [See also LDYW]"@en ,
        "Lady's Walk Shale Unit [Obsolete: use LDYW]"@en ;
    skos:broader namedrockunit:DUNR ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LDYW"@en ;
    skos:prefLabel "Lady's Walk Formation [See also LAWA]"@en ;
.

