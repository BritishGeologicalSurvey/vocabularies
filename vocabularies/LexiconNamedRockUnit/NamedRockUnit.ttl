namedrockunit:GCTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly dark reddish brown (Munsell Soil) pebbly silt diamicton with interbeds of subglacially sheared pebbly sand, silt and clay. The diamicton contains clasts of igneous and metamorphic rock types from the Lake District together with some red sandstone and coal."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally sharp, planar, glacitectonic, unconformable contact with dark brown clay of the Whinneyhill Coppice Clay Member of the Aikbank Farm Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, unconformable contact with overlying reddish brown clay and silt of the Holmeside Clay Member of the Aikbank Farm Glacigenic Formation. Taken at the top of the uppermost bed of diamicton in the sequence."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:AIK ;
    skos:definition "Clay, diamicton and silt with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GCTI"@en ;
    skos:prefLabel "Green Croft Till Member"@en ;
