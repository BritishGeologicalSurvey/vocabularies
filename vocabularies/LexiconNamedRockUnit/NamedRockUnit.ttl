    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The unit comprises soft grey mudstones and silty mudstones the top of which commonly weathers to a red colour. In some areas the Cuckfield Stone Bed occurs at the base."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is an up-section change from fine-grained, silty, cross-bedded, buff sandstone with local thin mudstones and limestones (Cuckfield Stone Member) up into mudstones (Upper Grinstead Clay unit) that commonly have a marked basal pebble bed (Cuckfield Pebble Bed)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasOldestAgeValue 1.377e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 12.2m proved."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at the up-section conformable change from mudstones (Upper Grinstead Clay unit) up into the silt and sand rhythms of the upper unit of the Tunbridge Wells Sand Formation. The top of the Grinstead Clay unit is commonly red stained, which helps to emphasise the contact."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRC ;
    skos:definition "Mudstone. Stratified bedrock. Occurs onshore. Deposited during the Valanginian Age (Cretaceous Period) (137.7-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UGRC"@en ;
    skos:prefLabel "Upper Grinstead Clay"@en ;
.

