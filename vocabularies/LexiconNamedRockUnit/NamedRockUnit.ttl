namedrockunit:TCAM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HFMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HFSDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HFSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cyclically interbedded \"siltstones\" and fine- to medium-grained cross-bedded sandstones (the \"siltstones\" actually consisting of siltstone and very fine- to fine-grained sandstone with subordinate mudstone); the fine- to medium-grained cross-bedded sandstone beds increase in abundance towards the top of the Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Upon the Diabaig Formation (TCD). Base [NM 4205 9722]: at the lowest thickly-bedded (>2 m), cross-bedded and/or convoluted fine- to medium-grained sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1221 ,
        namedrockunit:H1222 ,
        namedrockunit:TCAL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "415m. in type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Scresort Sandstone member (TCAS). Top [NM 4108 9751]: the incoming of thickly-bedded, cross-stratified and/or convoluted coarse-grained sandstone (arkose) bed containing 'exotic' pebbles characteristic of the Applecross Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bagh Na H-Uamha Shale [Obsolete: use TCDL, TCAM]"@en ,
        "Leac-Strearnan Member [Obsolete: use TCA, TCAM]"@en ,
        "Rudha Na Roinne Grit [Obsolete: use TCAS, TCAM]"@en ;
    skos:broader namedrockunit:TCA ;
    skos:definition "Sandstone and siltstone with subsidiary mudstone and trace hornfelsed mudstone, hornfelsed sandstone and hornfelsed siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TCAM"@en ;
    skos:prefLabel "Allt Mor Na H-Uamha Member"@en ;
.

