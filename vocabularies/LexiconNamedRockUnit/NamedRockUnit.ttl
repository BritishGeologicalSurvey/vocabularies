namedrockunit:MBLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse pelitic gneiss, garnetiferous, locally migmatitic, with gneissose semipelite and psammite. Quartzite occurs locally. Calcsilicate bands are common within psammite."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Resipol Striped Formation (RESI) south of Moidart. Further north: either the base is cut by the Sgurr beag Thrust, or overlies conformably the Reidh Psammite (REP), or occurs directly unconformably (sheared) on Lewisianoid crystalline basement."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Highly variable, possibly up to 2-3 km."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Beinn An Tuim Striped Formation (BTU), likely conformable, or directly by Loch Eil Group (LEIL)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GLEN ;
    skos:definition "Gneissose pelite with subsidiary gneissose psammite and gneissose semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:BNGS ;
    skos:notation "MBLA"@en ;
    skos:prefLabel "Lochailort Pelite Formation"@en ;
