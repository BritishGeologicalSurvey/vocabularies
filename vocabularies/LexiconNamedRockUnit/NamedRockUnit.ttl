namedrockunit:MARRS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly interbedded psammite, semipelite and pelite, with a general upward increase in pelitic material. Garnets are rare to absent and calc-silicate rocks are absent. Locally, quartz pebble conglomerate with a semipelitic matrix."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably upon the Arnisdale Psammite Member (MAAP). Gradational contact, marked by increasing semipelite beds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 200-300 m (estimate, strongly deformed): thins to north and south."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the remainder of the Lower Morar Psammite Formation (MALP) (previously termed 'Barrisdale Psammite').  Sharp incoming of psammite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MALP ;
    skos:definition "Pelite, psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MARRS"@en ;
    skos:prefLabel "Rubha Ruadh Semipelite Member"@en ;
