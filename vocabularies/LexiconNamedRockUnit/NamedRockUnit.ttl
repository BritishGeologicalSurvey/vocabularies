    skos:altLabel "Bell Pit [Duplicate: use WMBP]"@en ;
    skos:broader namedrockunit:WMU ;
    skos:definition "Void. Artifical (anthropogenic) deposits and excavations. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
