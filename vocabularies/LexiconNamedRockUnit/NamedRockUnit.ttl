    lexicon:hasLithologyDescription "Fine-grained silty sands, calcareous sandstones and clayey silts and siltstones, commonly thinly or ripple bedded, may show pronounced bioturbation."@en ;
    lexicon:hasLowerBoundaryDefinition "An upward transition from mudstone and silty mudstone of the West Walton Formation to coarser grained predominantly arenaceous sediments."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H101 ,
        namedrockunit:LCR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
