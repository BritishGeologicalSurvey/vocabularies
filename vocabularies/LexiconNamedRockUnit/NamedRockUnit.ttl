namedrockunit:DWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Tabular, thick-bedded, mid- to dark grey, fetid, bituminous, fossiliferous, peloidal grainstone, packstone and wackestone limestones with dark grey shale interbeds; minor dark grey, micritic limestones and pale grey ooidal limestones and some local basal sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at a regional unconformity, the basal limestone of the Dowlais Formation overstepping the underlying formations westwards on the north crop of the South Wales Coalfield, from the Llanelly Formation (green and red-mottled clay) in the east to the Avon Group (thinly bedded fissile mudstones and limestones) in the west."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CYL ,
        namedrockunit:GHL ,
        namedrockunit:H3379 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To about 120m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at the conformable junction of the dark grey limestones of the Dowlais Formation with the overlying pale grey ooidal limestones of the Penderyn Oolite Member of the Oxwich Head Limestone Formation. From the type area eastwards, the formation is truncated by a pre-Namurian unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cil-yr-ychen Limestone [Obsolete: use DWL]"@en ,
        "Greenhall Limestone [Obsolete: use DWL]"@en ,
        "Upper Seminula Zone (S2) Limestone [Obsolete: use DWL]"@en ;
    skos:broader namedrockunit:PEMB ;
