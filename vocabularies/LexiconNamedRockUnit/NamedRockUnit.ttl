    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 4 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable, at the abrupt transition from deformed mudstone and sandstone of the Seaton Carew Member to red-brown \"blocky\" mudstone of the undifferentiated Sidmouth Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TO> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Keuper Basement Beds [Obsolete: use STCF]"@en ,
        "Seaton Carew Formation [Obsolete: use STCF]"@en ;
    skos:broader namedrockunit:SIM ;
    skos:definition "Mudstone and sandstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Olenekian Age (Triassic Period) (249.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
