namedrockunit:BRLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Briton's Lane Formation consists of several coarse-grained sand and gravel outwash lithofacies that truncate and drape pre-existing sediments in the Cromer and Mundesley districts. No in-situ till deposits have been identified to date, but thrust slabs of till have been recognised at several localities."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the formation is erosional, and sands and gravels truncate earlier deposits of the Sheringham Cliffs Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CMT ,
        namedrockunit:OVSD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Maximum thickness of the formation is estimated to be in the region of 50m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Briton's Lane Formation forms the uppermost stratigraphical units in northern Norfolk. However, sporadic palaeosols can be observed within the upper part of the deposit such as at Briton's Lane."@en ;
