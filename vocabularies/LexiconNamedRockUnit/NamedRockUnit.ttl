namedrockunit:CRRS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red and purple, fine- to medium-grained, sandy limestone (grainstone) and calcareous sandstone with scattered quartz pebbles and lenses of coarse shell material. Lower part is bioturbated and mottled; upper 2m are cross-stratified. The sandstone forms the upper part of a Brigantian shoaling-upwards cycle and formed in a shallow water, upper shoreface setting. The Craig Rofft Sandstone is currently shown on Sheet 94 within the Great Orme Limestone, a redundant Asbian formation now superceded by the Loggerheads Limestone Formation. However, unpublished foraminiferal dating by BGS has shown that limestones underlying the limestone member are Brigantian in age. These limestones therefore equate with the Cefn Mawr Limestone Formation and their lithology (dark grey packstones) confirms that they should be included in that formation, as must the Craig Rofft Sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Base not exposed, but should be taken at entry of sandy limestones and calcareous sandstones above underlying sand-free limestones of the Cefn Mawr Limestone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4 to 5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Undulating upper surface of calcareous sandstone beneath a thin, impersistent, calcretised porellanous limestone bed exposed in Craig Rofft Quarry."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CFML ;
    skos:definition "Limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CRRS"@en ;
    skos:prefLabel "Craig Rofft Sandstone Member"@en ;
.

