    lexicon:hasThicknessDescription "To 5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or commonly a sharp, undulating, unconformable contact with sand and gravel of the St Bees Sand and Gravel Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
