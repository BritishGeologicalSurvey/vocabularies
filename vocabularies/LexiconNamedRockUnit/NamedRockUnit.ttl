namedrockunit:SKEA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, pale grey to blue-grey, medium-grained, calcareous, sparsely bioturbated, fossiliferous. Proximally is a channel (palaeovalley) fill conglomerate with mainly metamorphic clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable distally, resting on soft multi-coloured clays that lie on top surface of Ballyshannon Limestone Formation. Proximally, lower contact is deeply erosional into underlying limestone formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - 4.5m (measured), probably 10 - 12m in area of main palaeovalley conglomerate fill."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt change, in distal location, from sandstone up into conformable silty mudstones, shales and thin sandstones of normal Bundoran Shale. Proximally, top of member is not exposed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BUNS ;
    skos:definition "Sandstone with subsidiary conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKEA"@en ;
    skos:prefLabel "Skea Sandstone Member"@en ;
.

