    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to at least 350m"@en ;
    lexicon:hasUpperBoundaryDefinition "Fining upwards into heterolithic alternating shales, siltstones and thin sandstones; succeeded abruptly and conformably by either peritidal carbonates of Termon River Limestone Formation or sandstones of Bin Mountain Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Claragh Sandstone Group [Obsolete: use CLSG]"@en ;
    skos:broader namedrockunit:TYRO ;
    skos:definition "Sandstone with subsidiary conglomerate and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLSG"@en ;
    skos:prefLabel "Claragh Sandstone Formation"@en ;
.

