    skos:broader
        namedrockunit:RMD ,
        namedrockunit:TFD ;
    skos:definition "Silty clay with subsidiary gravel and sand and trace clay, peat and silt. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:RTFF1 ,
