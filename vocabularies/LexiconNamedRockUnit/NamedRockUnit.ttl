namedrockunit:WOCR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamicton and gravel that form moraines, fluted hummocks and terraces laid down in the uplands of the central part of the Lake District by corrie glaciers and their associated meltwaters during the Loch Lomond Stadial. Two members are recognised: The Wolf Crags Till Member is a yellowish brown sandy diamicton, with clasts of Borrowdale Volcanic Group and Skiddaw Group rocks, and subordinate numbers of clasts of Threlkeld Microgranite. The Wolf Crags Gravel Member forms a series of terraces in the Mosedale Beck valley. It is composed of coarse gravel (with clasts up to 1m diameter) with subordinate amounts of finer gravel and sand. It contains clasts of Borrowdale Volcanic Group rocks and Threlkeld Microgranite."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock or disconformable on the Threlkeld Till Formation of the central Cumbria Glacigenic Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.15m at the type site."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but locally overlain by Holocene peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CCGL ;
    skos:definition "Boulders, diamicton and gravelly cobbles with subsidiary gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WOCR"@en ;
    skos:prefLabel "Wolf Crags Formation"@en ;
.

