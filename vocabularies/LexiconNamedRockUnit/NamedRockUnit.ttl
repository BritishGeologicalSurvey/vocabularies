namedrockunit:RLF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to reddish grey, fine- and medium- to locally coarse-grained sandstones with thin interbeds of mudstone and siltstone and the locally impersistent Inchmurrin, Callander Craig and Gartartan conglomeratic members."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Callander-Crieff area, taken as the top of the Craig of Monievreckie Conglomerate, which is the volcanic conglomerate of Frances, Forsyth, Read and Armstrong, 1970, south-west of Aberfoyle the Ruchill Formation is faulted against Dalradian and Highland Border Complex rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3640 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Between 400m and 1750 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "In the Callender-Crieff area, the top is taken at the base of the Cromlix Mudstone Formation, which is strongly diachronous, whereas in the Aberfoyle area, the Ruchill Flagstone Formation is locally overlain by the Shannochil Sandstone Member of the Cromlix Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ruchill Formation [Obsolete: use RLF]"@en ;
    skos:broader namedrockunit:ATGK ;
    skos:definition "Conglomerate, sandstone and siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CCCO ,
        namedrockunit:GACO ,
        namedrockunit:IMC ;
    skos:notation "RLF"@en ;
    skos:prefLabel "Ruchill Flagstone Formation"@en ;
.

