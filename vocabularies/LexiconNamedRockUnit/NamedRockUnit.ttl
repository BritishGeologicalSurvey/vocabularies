namedrockunit:UFION
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFASST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """At the base of the member, a succession (0 to 30 m thick) of conglomerates and tuffaceous sandstones with thin plant-bearing silty horizons crops out in stream sections on the north side of Fionchra. The plant remains include delicate leaf and stem impressions (see also Tomkeieff and Blackburn, 1942). \r
\r
Up to 60 m of hyaloclastite breccia with scattered pillow structures overlies the sedimentary rocks. At Coire na Loigh, the breccias pass downward into several metres of strongly columnar-jointed lava which rests with a thin (1-4 mm) tachylitic selvedge on conglomerate. The structure resembles those in hyaloclastite sheet flows described from Iceland (Bergh and Sigvaldason, 1991). \r
\r
The breccia is succeeded by up to 80 m of tholeiitic basaltic andesite flows. \r
\r
The second of four members of the Canna Lava Formation on Rum."""@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Torridon Group (TC) sandstone with a landscape unconformity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Emeleus (1997, fig. 40) shows a thickness of c. 70 m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CNAL ;
    skos:definition "Basaltic-andesite with subsidiary conglomerate, hyaloclastite and tuffaceous-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UFION"@en ;
    skos:prefLabel "Upper Fionchra Member"@en ;
.

