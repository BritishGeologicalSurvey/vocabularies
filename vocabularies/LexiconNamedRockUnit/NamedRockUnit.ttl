namedrockunit:HLGS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:ADS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Hallaig Sandstone Member is composed of moderately well-cemented medium to fine sand. Three cycles of grading were interpreted; from bioturbated sandstones with thin siltstones at the base to cross-stratified sandstones at the top of the unit. Hasselbo et al. (1988, 1999) and Hesselbo and Coe (2000)  include this Member within their redefined Pabay Shale Formation, which has not been accepted by the British Geological Survey. It was originally the highest sandstone within the Broadford Beds and hence is now the highest Member within the Ardnish Formation, as defined by Morton (1999)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unseen."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H632 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "?50m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain (locally) by Pabay Shale Formation - see Morton, 1999, and reply by Hesselbo et al."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ardnish Formation"@en ,
        "Hallaig Sandstone [Obsolete: use ADS, HLGS]"@en ;
    skos:broader namedrockunit:ADS ;
    skos:definition "Sandstone and siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HLGS"@en ;
    skos:prefLabel "Hallaig Sandstone Member"@en ;
.

namedrockunit:HLSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown clayey silt above and below grey clayey silt with thin sand laminae developed in the lower brown clay. Locally the deposits have been glacitectonically folded and sheared. Pollen include Pinus and Picea and indicate a boreal forest. Coleopteran assemblage indicates a temperate climate. The archaeological material consists of cores, flakes and flake tools."@en ;
    lexicon:hasLowerBoundaryDefinition "In glacitectonic contact with chalky lodgement till (Mildenhall Lower Diamicton of Cook et al. p59-69 in Lewis et al., 1991)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1595 ,
        namedrockunit:H1596 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 5 m (Cook et al. p59-69 in Lewis et al.,1991)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by glaciofluvial outwash sand and gravel (Mildenhall Upper Sands and Gravels of Cook et al. p59-69 in Lewis et al., 1991)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "High Lodge Clayey Silts and High Lodge Sands [Obsolete: use HLSI]"@en ,
        "High Lodge Member [Obsolete: use HLSI]"@en ;
    skos:broader namedrockunit:SMSG ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HLSI"@en ;
    skos:prefLabel "High Lodge Silt Member"@en ;
.

namedrockunit:HLV
    a skos:Concept ;
