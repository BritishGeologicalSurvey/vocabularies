namedrockunit:LWTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stony sandy clay diamicton, matrix-supported, massive, very stiff, weak red, dark greyish brown to yellowish brown, with sand (? as lenses) locally. Typical lodgement till, with angular to subrounded clasts up to boulder size. Clasts derived from the northwest of the Lake District (olive brown ?Latterbarrow Sandstone, slate, limestone and granophyre) but locally dominated by clasts of the underlying red sandstone bedrock."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen at its type or reference sections but assumed to be unconformable on bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2079 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.1.8m exposed at type section, but up to 20m thick in adjacent boreholes."@en ;
    lexicon:hasUpperBoundaryDefinition "At its type section it is unconformably overlain by glaciofluvial gravel and at its reference section (at Rothersyke Scar river cliff) it is overlain by the Catgill Wood Sand and Gravel Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Boulder Clay [Obsolete: use CHAK, STIL, SEAG, RVTI, LWTI, STPTG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Diamicton with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LWTI"@en ;
    skos:prefLabel "Low Wath Till Member"@en ;
