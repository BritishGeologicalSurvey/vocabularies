namedrockunit:OB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:ULSH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin- to medium-bedded dark grey argillaceous limestones and mudstones. Chert nodules and beds, and silicified limestones common. Interbedded argillaceous limestones and mudstones commonly deeply weathered to decalcified rottenstone and pale grey, white and yellow clay. In western Gower and south Pembrokeshire, units of medium- to thick-bedded skeletal packstones and oolitic limestone with cherts occur in the lower part of the Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the palaeokarstic surface seperating the thick-bedded mottled and pseudobrecciated skeletal packstones of the Oxwich Head Limestone Formation and the overlying thin- to medium-bedded argillaceous limestones, cherts and mudstones of the Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BULL ,
        namedrockunit:H1736 ,
        namedrockunit:H431 ,
        namedrockunit:H4820 ,
        namedrockunit:ULSH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "61m on the Gower, thinning northwards to a feather edge on the northwestern crop of the South Wales Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the last limestone in the gradational junction between the interbedded limestones and mudstones of the Formation and the overlying thin-bedded banded cherts and mudstones and silaceous mudstones of the Aberkenfig Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Black Lias [Obsolete: use OB]"@en ,
        "Bullslaughter Limestone Formation [Obsolete: use OB]"@en ,
        "Oystermouth Beds [Obsolete: use OB]"@en ,
        "Rottonstone Beds [Obsolete: use OB]"@en ,
        "Upper Limestone Shales [Obsolete: use OB]"@en ;
    skos:broader namedrockunit:PEMB ;
    skos:definition "Limestone and mudstone with subsidiary chert and siliceous limestone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "OB"@en ;
    skos:prefLabel "Oystermouth Formation"@en ;
.

namedrockunit:ONCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ouse-Nene Catchments Subgroup encompasses all the fluvial, lacustrine and organic deposits of the rivers that occupy the catchment area of the rivers Ouse and Nene and their tributaries. Floodplain alluvium comprises soft silts and clays, commonly with beds of peat and a basal bed of sand and gravel. River terrace deposits are largely sand and gravel, the constituents of the gravel components reflecting the source rocks in each catchment. Lacustrine deposits are dominantly soft silts and clays. Minor marine deposits are included where they are intercalated in dominantly fluvial formations."@en ;
    lexicon:hasLowerBoundaryDefinition "Formations of the Ouse-Nene Catchments Subgroup rest with marked unconformity on Middle Pleistocene glacial deposits and on Cretaceous and Jurassic bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To c.14m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Holocene Epoch (Quaternary Period) (.78-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CAMV ,
        namedrockunit:LKVY ,
        namedrockunit:NARC ,
        namedrockunit:NENE ,
        namedrockunit:OUSE ,
        namedrockunit:SLVY ;
    skos:notation "ONCA"@en ;
    skos:prefLabel "Ouse-Nene Catchments Subgroup"@en ;
.

