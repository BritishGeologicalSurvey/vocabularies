    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SG> ;
    lexicon:hasThicknessDescription "Up to 200 m in onshore Britain."@en ;
    lexicon:hasUpperBoundaryDefinition "The ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Drift deposits [Obsolete: use GBG]"@en ,
        "Great Britain Glacigenic Supergroup [Obsolete: use GBG]"@en ;
    skos:definition "Clay, diamicton, gravel, peat, sand and silt. Stratified superficial deposits. Occurs both onshore and offshore. Formed during the Paleogene Period - to - Quaternary Period (66-0 Ma BP)."@en ;
