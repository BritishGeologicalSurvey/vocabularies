namedrockunit:STHP
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Stanners Hill Pebble Bed consists of cross-bedded glauconitic gravelly sand and gravel. The gravel is mainly composed of flint but some is made of quartz or of Lower Cretaceous chert (Dewey and Bromehead, 1915, p.55). \r
\r
The Stanners Hill Pebble Bed appears to be a localised marine channel-fill between the top of the Windlesham Formation (WIDS) and the Camberley Sand Formation (CMBS)."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5093 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "The Stanners Hill Pebble Bed is up to about 4 m thick."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GL> ;
    lexicon:hasYoungestAgeValue 4.1e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Pebble Bed (of the Upper Bagshot Beds) [Obsolete: use STHP]"@en ;
    skos:broader namedrockunit:WIDS ;
    skos:definition "Gravel and sand. Stratified bedrock. Occurs onshore. Deposited during the Lutetian Age (Palaeogene Period) (48.1-41 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STHP"@en ;
    skos:prefLabel "Stanners Hill Pebble Bed"@en ;
.

