        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use BGN] \r
\r
Pale sandstones interbedded with grey, green, purple or brown siltstones and mudstones. Bands of dolomite/limestone (cementstone) and nodular carbonate (cornstone) are distributed irregularly through the sequence."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base is drawn at the incoming of significant thicknesses of grey mudstone and cementstone in or above a sandstone-cornstone sequence."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "800m estimated in Edinburgh, 384m+ at East Linton; 209m at Birnieknowes and 263m at Spilmersford."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is drawn at the incoming of common seatrock, coal, sideritic ironstone, black mudstone or marine bands; or where the sequence becomes dominated by volcanic rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:BGN ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Ballagan Formation"@en ;
    skos:definition "Obsolete name. Mudstone, sandstone and siltstone and trace calcilutite and nodular limestone (cornstone). Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TYN"@en ;
    skos:prefLabel "Tyninghame Formation [Obsolete: use BGN]"@en ;
.

