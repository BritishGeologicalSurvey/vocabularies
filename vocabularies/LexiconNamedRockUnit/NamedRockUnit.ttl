namedrockunit:DUCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/NCSLTR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Conglomerate, sandstone and mudstone, mainly red-brown with pale green and mottled layers. Large clasts (pebbles up to 15cm) are well rounded, commonly with thin ferruginous skins. Clast lithologies all occur locally and include Borrowdale Volcanic Group andesite, tuff and rhyolite, Silurian \"grit\" and \"greywacke\" and Eskdale Granite and Ennerdale granophyric microgranite."@en ;
    lexicon:hasLowerBoundaryDefinition "At base of conglomerate sequence unconformable on the top of the Lower Palaeozoic basement."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 191m"@en ;
    lexicon:hasUpperBoundaryDefinition "There is an upward change from conglomerate beds to grey, red and green marine mudstone and limestone with subordinate thin conglomerate beds. The junction may be sharply gradational or possibly an onlap surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:MASA ;
    skos:definition "Conglomerate with subsidiary mudstone, sandstone and siltstone and trace non-carbonate salt-rock. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DUCO"@en ;
    skos:prefLabel "Duddon Conglomerate Member"@en ;
.

