    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 300 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Faulted contact only with the Ladyport Formation, which is distinguished by a change from a siltstone/sandstone-dominated facies to a mudstone-dominated facies in the Ladyport."@en ;
