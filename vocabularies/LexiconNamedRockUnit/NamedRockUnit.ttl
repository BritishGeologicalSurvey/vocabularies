namedrockunit:HRGS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically medium- to fine-grained sand pale yellow to pale orange in colour, in cross-stratified units. Sands display soft-sediment deformation and glaciotectonic deformation structures. Some discontinuous silt partings are commonly present in the fine-grained sand units. Thin discontinous beds (typically 5 to 10 cm thick) of sandy pale brown diamicton are present in the upper parts of the unit at some localities."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen; mapping indicates erosional contact on Till (Finglack Till Formation), Glaciofluvial outwash of the Main Late Devensian Glaciation, laid down prior to the Elgin Oscillation and Old Red Sandstone bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Composite sections indicate a typical thickness of  5-10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the Milton Hill Silt Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GRHS ;
    skos:definition "Sand with subsidiary silt and trace diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HRGS"@en ;
    skos:prefLabel "Hempriggs Sand Member"@en ;
.

