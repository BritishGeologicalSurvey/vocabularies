    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.230m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the Pendle Grit Formation. In the normally gradational upwards coarsening sequence this is taken at the point where sandstone becomes predominant over mudstone/siltstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
