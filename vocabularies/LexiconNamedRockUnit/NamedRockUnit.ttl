    skos:broader namedrockunit:WB ;
    skos:definition "Lapilli-tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WRT"@en ;
    skos:prefLabel "Wrayslack Tuff Member"@en ;
