namedrockunit:MT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:S434 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thinly to medium-bedded, upward-fining turbiditic cycles of grey-brown, very fine-to fine-grained, massive and laminated, micaceous sandstone overlain by grey, laminated siltstone and dark grey mudstone; bases of sandstones show a variety of sole marks and some trace fossils"@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp upward change in a conformable succession from predominatly grey mudstone to sandstone. The base of the first sandstone bed above the Reticuloceras reticulatum Marine Band."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasOldestAgeValue 3.22e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 135 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp upward change in a conformable succession from sandstone to predominantly mudstone. The top of the last fine-grained sandstone bed immediately below the first massive, coarse-grained sandstone of the overlying Shale Grit."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CK> ;
    lexicon:hasYoungestAgeValue 3.215e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mam Tor Sandstones"@en ;
    skos:broader namedrockunit:HEBD ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Kinderscoutian Substage (Carboniferous Period) (322-321.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MT"@en ;
    skos:prefLabel "Mam Tor Beds"@en ;
.

