    lexicon:hasThicknessDescription "To 750m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the Creag Dhubh Psammite Formation, where a predominantly schistose semipelite belonging to the Torr na Truim Semipelite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Moine Series [Obsolete: use FESP, FPHS, OSHP, TTRS]"@en ;
    skos:broader namedrockunit:GRCO ;
    skos:definition "Gneissose semipelite and schistose semipelite with subsidiary micaceous psammite, psammite and quartzose semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
