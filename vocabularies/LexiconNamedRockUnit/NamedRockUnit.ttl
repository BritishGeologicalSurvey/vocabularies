namedrockunit:BRLG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and white cross-bedded sandstones with thin lenticular beds of grey mudstone and carbonised plant debris (Paterson and Hall, 1986; BGS, 1990). In the northern part of the Leapmoor Plantation [NS 221 715], it consists of white and cream, trough cross-stratified sandstone with thin lenticular beds of grey siltstone and abundant coalified wood fragments (Paterson et al., 1990)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is not seen, but is mapped in Broadlee Glen [NS 2258 7134] and distinguished from underlying strata of the undivided Clyde Sandstone Formation by plant debris and beds of grey mudstone in the Broadlee Glen Sandstone Member (BGS, 1990). Paterson and Hall (1986) presumed that the unseen base of the Broadlee Glen Sandstone Member is transitional on white sandstones and red-brown mudstones of the Gourock Sandstone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H83 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Greater than 100 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Top not seen, presumed overlain by Clyde Plateau Volcanic Formation (Paterson and Hall, 1986)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Broadlee Glen Sandstones Formation [Obsolete: use BRLG]"@en ;
    skos:broader namedrockunit:CYD ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRLG"@en ;
    skos:prefLabel "Broadlee Glen Sandstone Member"@en ;
.

