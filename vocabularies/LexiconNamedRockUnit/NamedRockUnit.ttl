namedrockunit:GAGO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded sandstones and red-brown mudstones. The sandstones in the basal part are pale grey-green quartzites; those in the upper part are grey-green, soft, friable, richly micaceous and feldspathic."@en ;
    lexicon:hasLowerBoundaryDefinition "Erosion surface cut in conglomerates of the Craig-y-cwm Formation, overlain by pale yellow to white micaceous sandstone [Lovell, 1978]."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to a maximum of 20 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp junction between overlying limestone of the Castell Coch Limestone of the Lower Limestone Shale Group and the topmost sandstones of the Garn-gofen Formation. A thin but persistent conglomerate marks the base of the Castell Coch Limestone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sandstones and Marls [Obsolete: use GAGO]"@en ;
    skos:broader namedrockunit:POB ;
    skos:definition "Sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age - to - Famennian Age (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GAGO"@en ;
