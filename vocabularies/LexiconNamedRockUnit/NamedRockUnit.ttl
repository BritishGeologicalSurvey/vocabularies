namedrockunit:DHI
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFWE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Tuff, creamy white, grey to pinkish grey, formerly ignimbritic, silicic welded ash-flow, with streaky poorly banded matrix, quartz phenocrysts and vlvanogenic lithic and crystal fragments now completely replaced by cryptocrystalline silica; clasts, exclusively of flint nodules reworked by erosion from Cretaceous chalk."@en ;
    lexicon:hasLowerBoundaryDefinition "Welded tuff (as described under Lithology) disconformably overlies the karstified chalk surface of the Late Cretaceous Ulster White Limestone Formation. The upper few centimetres of the chalk are faintly stained yellow in some areas. Locally the base of the tuff oversteps onto Triassic, Carboniferous and Dalradian \"basement\" rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0.6 to 1.1m"@en ;
    lexicon:hasUpperBoundaryDefinition "The welded tuff of the Donald's Hill Ignimbrite Formation is overlain by basalt lave flows of the Antrim Lave Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ALR ;
    skos:definition "Welded-eutaxitic tuff. Stratified bedrock. Occurs onshore. Deposited during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DHI"@en ;
    skos:prefLabel "Donald's Hill Ignimbrite Formation"@en ;
.

