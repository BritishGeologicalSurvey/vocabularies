    skos:altLabel
        "Lower Tealby Clay (of The Tealby Series) [Obsolete: use LTC]"@en ,
        "Lower Tealby Clay Member [Obsolete: use LTC]"@en ;
    skos:broader namedrockunit:TBF ;
    skos:definition "Clay with subsidiary silty clay. Bedrock. Occurs onshore. Formed during the Hauterivian Age (Cretaceous Period) (132.6-126.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LTC"@en ;
    skos:prefLabel "Lower Tealby Clay"@en ;
