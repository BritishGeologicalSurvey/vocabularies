namedrockunit:ORVD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Normally soft to firm, consolidated, compressible silty clay, but can contain layers of silt, sand, peat and a basal gravel. A stronger, desiccated surface zone may be present; older than \"Alluvium\" in the same map area. [Generic description]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:FLUV ;
    skos:definition "Sand with subsidiary clay and gravel and trace peat. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ORG ,
        namedrockunit:ORSG ;
    skos:notation "ORVD"@en ;
    skos:prefLabel "Older river deposits"@en ;
.

namedrockunit:ORW
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ASH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Orwell Member commences in glauconitic fine-grained sands (Unit A) with well-rounded flint gravel and faunal debris at the base, conformably overlain by bioturbated silty sands and sandy clayey silts with shell fragments and discontinuous laminae of dark grey-black claystone (Unit B). The upper part of the member (Unit C) is characterised by tuffaceous sandy silt with laminae of fine-grained sand. The tephra layers are discontinuous. Microscopic tuffaceous material is disseminated through Units B and C (Jolley, 1996; King, 1981; Knox and Ellison, 1979). King (in prep.) describes more varied lithofacies from this part of the sequence. \r
\r
Marine: inner to mid shelf. \r
\r
Early Eocene (early Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The basal pebble bed of the Orwell Member rests disconformably on sands of the Reading Formation or on the Ormesby Clay Member, on an undulating erosion surface."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HAC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Unit A is typically up to about 1 m thick; Unit B up to about 1.75 m; Unit C up to about 2.5 m (Jolley, 1996). King (in prep.) suggests that channel-filling sands and gravels up to 10 m thick in the Harwich area can be correlated with his Ipswich Member."@en ;
    lexicon:hasUpperBoundaryDefinition "The sandy silts and fine-grained sands of the upper part of the Orwell Member give way at a sharply defined disconformity to clayey silts and silty clays at the base of the Wrabness Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hales Clay Member [Obsolete: use ORW, UPR]"@en ;
    skos:broader namedrockunit:HWH ;
    skos:definition "Sand and silt with subsidiary ash and clay. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SUFP ;
    skos:notation "ORW"@en ;
    skos:prefLabel "Orwell Member"@en ;
.

