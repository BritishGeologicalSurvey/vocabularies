namedrockunit:GRGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey and brown hard, rubbly, shelly, coarsely shell-detrital, bioturbated, variably sandy peloid grainstones, packstones and wackestones with thin mudstone, sandstone and marl beds; bioturbated, some ferruginous peloids; characteristic fauna includes abundant Gryphaea spp and belemnites in upper part, and colonial worm Sarcinella and brachiopod Lobothyris buckmani (Davidson) in lower part."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward transition from less sandy, more finely shell-detrital and more ironshot limestones with Aulacothyris meriani (Oppel) (Lower Trigonia Grit Member) into limestone as described in lithology with L. buckmani."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2833 ,
        namedrockunit:H3443 ,
        namedrockunit:H4071 ,
        namedrockunit:H4686 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 3 to 5m, maximum 7m. Type section (Leckhampton Hill); 6.6m (Richardson, L, 1906)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward transition into sparsely shelly peloidal and ooidal grainstones (Notgrove Member), or hardground overlain by Salperton Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Gryphaea Bed [Obsolete: use GRGR]"@en ,
        "Gryphaea Grit [Obsolete: use GRGR]"@en ,
        "Gryphite Grit [Obsolete: use GRGR]"@en ,
        "Gryphite Grit and Buckmani Grit [Obsolete: use GRGR]"@en ;
    skos:broader namedrockunit:ASLS ;
    skos:definition "Limestone with subsidiary calcareous mudstone, mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GRGR"@en ;
    skos:prefLabel "Gryphite Grit Member"@en ;
.

namedrockunit:GRHS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S654 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTNS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand dominated sequence (Hempriggs Sand Member), capped by red brown sandy silt (Milton Hill Silt Member) and locally overlying a sandy silty matrix-supported diamicton (East Grange Till Member) or contorted silt and sand. The sand is typically medium- to fine-grained pale yellow to pale orange in colour, in cross-stratified units."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen; mapping indicates erosional contact on till (Finglack Till Formation), glaciofluvial outwash of the Main Late Devensian Glaciation, laid down prior to the Elgin Oscillation and Old Red Sandstone bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Composite sections indicate a typical thickness >10m; the land forms indicate a thickness of >20 m locally. (see type localities of component members of the Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but locally unconformably overlain by sandy Late Devensian raised beach deposits or sandy Holocene raised marine deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Not Formally Named Previously"@en ;
    skos:broader namedrockunit:BCD ;
    skos:definition "Sand with subsidiary sandy diamicton and sandy silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:EGTI ,
        namedrockunit:HRGS ,
        namedrockunit:MHSI ;
    skos:notation "GRHS"@en ;
    skos:prefLabel "Grange Hill Sand Formation"@en ;
.

namedrockunit:GS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-grained, feldspathic and micaceous sandstones, cross-stratified on a variety of scales, with conglomerate-lined scours and intercalated siltstone and mudstone beds.  Intertongues with Craven Group mudstones in its lower part and Pennine Lower Coal Measures Formation in its upper part. The Gwespyr Sandstone records the entry and southwards advance of a northerly derived \"Millstone Grit\" deltaic facies into the North Wales area."@en ;
    lexicon:hasLowerBoundaryDefinition "Entry of feldspathic sandstones above the Cancelloceras cancellatum Marine Band in north Flintshire and the Cancelloceras cumbriense Marine Band in south Flintshire and the Wrexham area."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:AQG ,
        namedrockunit:H2834 ,
        namedrockunit:HAF ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasOldestAgeValue 3.2e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "To 260m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of thin sequence of mudstones and seatearths immediately underlying the Llwyneinion Half Yard Coal."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Aqueduct Grit [Obsolete: use GS]"@en ,
        "Gwespyr Sandstone Formation [Obsolete: use GS]"@en ,
        "Halkyn Formation [Obsolete: use BSG, CFS, GS, PECH]"@en ;
    skos:broader
        namedrockunit:MG ,
        namedrockunit:PCM ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Yeadonian Substage - to - Langsettian Substage (Carboniferous Period) (320-318 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GS"@en ;
    skos:prefLabel "Gwespyr Sandstone"@en ;
.

namedrockunit:GWYN
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Gwynedd Supergroup was introduced by Woodcock (1990), whose conception was of an Ordovician megasequence bounded by basin-wide unconformities, one approximating to the base of the Arenig Series, the other to the base of the Ashgill. The Arenig to Caradoc sequence which unconformably overlies the Tremadoc Series is mainly composed of silty mudstones and siltstones, with local, impersistent sandstone intercalations, and throughout the area it is overlain by black graptolitic mudstones of the Nod Glas Formation and its equivalents. Within this sedimentary sequence several major volcanic divisions are emplaced. In approximate upward succession they are the Rhobell, Aran, Llewelyn, Snowdon and Llanbedrog Volcanic groups. The local intercalation of these groups, together with their wedging-out laterally, cause many problems in correlation, in the hierarchical status of individual formations, their terminology and synonymy."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies Tremadoc rocks."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasOldestAgeValue 4.771e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SG> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Siltstone and silty mudstone with subsidiary sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series - to - Caradoc Series (Ordovician Period) (477.1-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LIG ,
        namedrockunit:LLV ,
        namedrockunit:RHG ,
        namedrockunit:SV ;
    skos:notation "GWYN"@en ;
    skos:prefLabel "Gwynedd Supergroup"@en ;
.

