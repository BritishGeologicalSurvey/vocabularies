namedrockunit:MODS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Monadh Dubh sandstone Formation consists of 4 members, but was shown as one unit on the 50k maps. From the base these members are Shellesder, A'Mharagach, Sgaorishal and Allt Dubh. \r
\r
The base of the unit lies directly on the Torridonian and comprises coarse, continental-derived conglomerates. Gradually the succession fines upwards and the top 25 m (two members) are dominated by fine sand and lacustrine carbonate rocks with ostracods."""@en ;
    lexicon:hasLowerBoundaryDefinition "Direct, unconformable contact on Torridonian sandstones."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "82 m+"@en ;
    lexicon:hasUpperBoundaryDefinition "Jurassic transgression - change from continental derived sediments - not seen?"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasYoungestAgeValue 2.014e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:NRS ;
    skos:definition "Conglomerate, limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ALTDU ,
        namedrockunit:AMHAR ,
        namedrockunit:SGAOR ,
        namedrockunit:SHDER ;
    skos:notation "MODS"@en ;
    skos:prefLabel "Monadh Dubh Sandstone Formation"@en ;
.

