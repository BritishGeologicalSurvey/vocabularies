namedrockunit:FAR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:MDVL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFAMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin, sharp and erosively based, dark grey, commonly foetid crinoidal packstone intercalated with calcareous mudstone or argillaceous, fine-grained wackestone. In type area, 50m of grey-green, basaltic tuffaceous mudstone is present at the top."@en ;
