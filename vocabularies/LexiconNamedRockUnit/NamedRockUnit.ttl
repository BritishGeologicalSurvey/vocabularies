    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mostly firm, pale grey to off-white blocky chalk with a lower part characterised by rhythmic alternations of marls and marly chalks with firm white chalk. Thin gritty, silty chalk beds act as markers in the sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable in full sequences. The lower boundary is placed at the erosional contact at the base of the \"Cast Bed\" (Southern Province) or the Totternhoe Stone (Transitional Province) in southern England. The former is the direct equivalent of Bed C1 of Gale (1995). The formation oversteps onto older formations over the Mid-Dorset Swell where the preceding West Melbury Marly Chalk Formation is absent. The basal unit here is termed the Cenomanian Basement Bed (Drummond, 1970)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GECK ,
        namedrockunit:H2551 ,
        namedrockunit:H4415 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally in the range 35 to 50m in the Southern Province with the most expanded sequences (up to 75m exceptionally) in the area of West Sussex, East Hampshire and the Isle of Wight. Thins markedly to the west and is at its least over the Mid-Dorset Swell where as little as 10m may be preserved."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper surface is conformable and is redefined as the bedding plane beneath the lowest of the marls in the Plenus Marls Member in the overlying Holywell Nodular Chalk Formation. (Note that the Plenus Marls Member is now considered as part of the overlying formation, thus providing a consistent datum throughout the Chalk Group of England and the North Sea)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "East Wear Bay and Abbots Cliff Formations [Obsolete: use ZZCH]"@en ,
        "Grey Chalk Member [Obsolete: use ZZCH]"@en ,
        "Zig Zag Chalk Member [Obsolete: use ZZCH]"@en ;
    skos:broader namedrockunit:GYCK ;
    skos:definition "Calcareous mudstone and chalk. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CASB ,
        namedrockunit:TTST ;
    skos:notation "ZZCH"@en ;
    skos:prefLabel "Zig Zag Chalk Formation"@en ;
