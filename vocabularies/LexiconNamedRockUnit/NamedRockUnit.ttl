.

namedrockunit:SKU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Succession of mottled red and grey-green silty mudstone sporadically rich in small (2-10cm in diameter) calcareous septarian concretions.  Green-weathering lenticular siltstones are common and thin, lenticular fining-upwards calcareous sandstones are developed in Trotternish. The sparse fossils are all freshwater, and comprise bivalves (e.g. Unio), gastropods (e.g. Viviparus), fish teeth and plant fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is gradational and is defined by the base of mottled red and grey-green mudstones, and the range top of ostracod-bearing calcareous mudstones and fissile mudstones of the underlying Kilmaluag Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3680 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "A composite of the two partial type sections gives a thickness of about 15 to 16m in Trotternish. Thicknesses quoted for Strathaird vary from 10 to 11m (Harris and Hudson, 1980; Harris, 1992) to 16 to 18m (Hudson, 1962; Hudson and Harris, 1979). The formation might be present in Waternish, but has not been recognized on Raasay, Eigg or Muck (Harris and Hudson, 1980, fig.3; Emeleus, 1997)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is sharply-defined, and is marked by the change from mottled red and grey-green mudstones to dark, shelly fissile mudstones (Upper Ostrea Member, Staffin Bay Formation) in Trotternish and a non-sequence overlain by sandstone (Carn Mor Sandstone Member, Staffin Bay Formation) in Strathaird. The formation is unconformably overlain by extrusive rocks of the Paleocene Skye Lava Group in places."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mottled Clays [Obsolete: use SKU]"@en ;
    skos:broader namedrockunit:GEST ;
    skos:definition "Mudstone and siltstone with subsidiary sandstone and trace nodular limestone (cornstone). Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SKU"@en ;
    skos:prefLabel "Skudiburgh Formation"@en ;
.

namedrockunit:SLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BACOMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olivine-microphyric basalt (Dalmeny type) and olivine-clinopyroxene-plagioclase-macrophyric basalt (Dunsapie type). In the closure of the Beith anticline the basal flow of the member is a distinctive clinopyroxene-olivine-macrophyric basalt (ankaramite or Craiglockhart type). In Boylestone Quarry [NS 495 597] hydrothermal veins and cavities contain a wide variety of minerals including calcite, analcime, prehnite, heulandite, bowlingite, thompsonite and natrolite. Native copper, cuprite and malachite are also found."@en ;
    lexicon:hasLowerBoundaryDefinition "The Sergeantlaw Lava Member overlies the plagioclase-macrophyric basalts (Markle type) of the Gleniffer Lava Member. South of Wester Gavin [NS 380 589] the mafic basalts of the Sergeantlaw Lava Member appear to rest upon volcaniclastic sediments and it is possible that in this area the underlying Glenliffer Lava Member has been overlapped. To the north of Harelaw Reservoir [NS 485 590] the Sergeantlaw Lava Member appears to cut out or overlap most of the Gleniffer Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3681 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Not stated."@en ;
    lexicon:hasUpperBoundaryDefinition "Resting upon the Sergeantlaw Lava Member and forming a broad dip slope outcrop south of Muirdykes [NS 395 591] are the plagioclase-macrophyric basalts (Markle type) and olivine-clinopyroxene-plagioclase basalts (Dunsapie type) of the Fereneze Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sergeantlaw Lavas [Obsolete: use SLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Clinopyroxene-olivine-macrophyric basalt, olivine-clinopyroxene-plagioclase-macrophyric basalt and olivine-microphyric basalt and trace mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SLA"@en ;
    skos:prefLabel "Sergeantlaw Lava Member"@en ;
.

namedrockunit:SLAT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:NIN ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
