    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "2 - 5m (2.73m in the type quarry; 3.86m in the East Stour Borehole - ST82SW/9)."@en ;
    lexicon:hasUpperBoundaryDefinition "Fairly abrupt change from limestone to mudstone, locally oolitic, of the Hinton St. Mary Clay. Where the Hinton St. Mary Clay is absent, the limestones pass up fairly abruptly into the Sturminster Pisolite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
