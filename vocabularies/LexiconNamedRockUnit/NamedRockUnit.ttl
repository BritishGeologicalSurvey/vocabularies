namedrockunit:PA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone-dominant gravels occurring at the base of the Wolston Glacigenic Formation. The unit includes bodies of purplish clay (cf. Moreton Member (MTON)), and has an interfingering relationship with evident outwash gravels. It is probably a composite deposit of scree/head gravels partly reworked by outwash during ice advance. The gravels have yielded a molar of mammoth (Richardson and Sandford, 1960)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4829 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Paxford Gravel [Obsolete: use PA]"@en ;
    skos:broader namedrockunit:WOLS ;
    skos:definition "Gravel. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PA"@en ;
    skos:prefLabel "Paxford Gravel Member"@en ;
.

