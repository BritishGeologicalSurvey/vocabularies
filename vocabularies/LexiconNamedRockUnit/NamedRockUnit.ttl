namedrockunit:DNPS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy, pebbly, clayey silt (diamicton), very dense, crudely laminated, fissile, olive grey, with wisps of white silty pebbly sand, disseminated peaty material and charcoal. Pebbles are bleached white. Containing pollen of Interglacial aspect. Passing down into clayey, sandy, silty gravel (diamicton), matrix-supported, very dense, very pale grey to white, with disseminated black charcoal and peaty material. Gravel similar in composition to that occurring in Craig an Daimh Gravel Formation below, but bleached white or pale yellow."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational contact over 20 to 50 cm with weathered, clayey cobble gravel of the Craig an Daimh Gravel Formation below."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2762 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasOldestAgeValue 4.23e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "1.6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, gently undulating, unconformable contact with stony sandy clay diamicton of the Athias Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Dalcharn Biogenic Formation [Obsolete: use DNPS]"@en ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Hoxnian Stage - to - Ipswichian Stage (Quaternary Period) (.423-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DMBG ,
        namedrockunit:RECR ;
    skos:notation "DNPS"@en ;
    skos:prefLabel "Dalcharn Palaeosol Formation"@en ;
.

namedrockunit:DOUL
