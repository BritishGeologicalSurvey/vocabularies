namedrockunit:TEIFI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, stratified gravel, sands, silts and clays forming the alluvial deposits of the River Teifi (Afon Teifi) and its tributaries. Includes contemporaneous head, colluvium and pedogenic deposits within the catchment area. Clasts principally consist of local Lower Palaeozoic turbidites but, west of a line approximately running between Talgarreg [SN 4267 5096] and Pentrecagel [SN 3385 4030] a substantial mixture of \"Irish Sea\" material derived from the Lleyn Formation can be present. Aggradational river terraces and major alluvial fans are dominated by pebble cobble gravels and medium- to coarse-grained sand, the modern floodplain is dominated by silt and clay, and locally includes lenses of peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable and locally channelised on bedrock, Devensian head deposits and Late Devensian glacigenic deposits (particularly the Plynlimon Till Formation and, west of Llanysul [SN 4190 4043], the Teifi Clay Formation and Lleyn Till Formation). In Tregaron Bog it overlies the Tregaron Formation. Interdigitates in a complex manner with Tidal Flood Deposits (Gwynllwg Formation of Bowen, 1999) in the estuary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALF ,
        namedrockunit:ALV ,
        namedrockunit:HEAD ,
        namedrockunit:LDE ,
        namedrockunit:RTD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally 4 to 5m, but ranging up to 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface, or, locally, overlain by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial fan deposits"@en ,
        "Alluvium"@en ,
        "Head"@en ,
        "Lacustrine deposits"@en ,
        "River terrace deposits"@en ;
    skos:broader namedrockunit:WWACA ;
    skos:definition "Clay, gravel, sand and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TEIFI"@en ;
