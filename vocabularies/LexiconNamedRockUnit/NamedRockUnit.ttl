    lexicon:hasLithologyDescription "Subaerial lava flows with breccias, conglomerates, quartzites and red clayrocks. Mafic to felsic, including felsite, albite-trachyte, keratophyre, skomerite, marloesite, mugearite and olivine basalt."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of the Skomer Volcanic Group (which is never seen) where it unconformably overlies Ordovician rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CGT ,
        namedrockunit:H3703 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SA> ;
    lexicon:hasOldestAgeValue 4.405e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/SA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "1000 metres approx."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of the Skomer Volcanic Group where it is unconformably overlain by upper Llandovery shales and sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SA> ;
    lexicon:hasYoungestAgeValue 4.386e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Conglomerate \"Series\" [Obsolete: use SVG]"@en ,
        "Skomer Volcanic Series [Obsolete: use SVG]"@en ;
    skos:definition "Breccia, conglomerate, mafic igneous-rock, mudstone and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Aeronian Age (Silurian Period) (440.5-438.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SVG"@en ;
    skos:prefLabel "Skomer Volcanic Group"@en ;
.

namedrockunit:SWDEN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ORMUD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Weakly organic sands. Greyish brown, silty, fine-medium-coarse grained, weakly stratified, containing rare granules and pebbles of weathered felsite and charcoal fragments. A seam of black to dark brown, laminated, organic mud (0.01-0.05m) occurs at the base of the unit and drapes the eroded surface of the underlying Kirkhill Palaeosol Bed. A C 14 date of >47, 360 BP (SRR-2416) has been obtained from the organic mud. Palynological analysis indicates that the bed contains recylcled arboreal pollen (probably derived from earlier soil horizons) together with the pollen of grasses and heather suggesting that the bed was formed under cool climatic conditions in an open treeless environment. Interpreted as slope wash deposits derived from contemporaneous surface soils."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal boundary of the bed is a sharp undulatory erosion surface with an amplitude of up to 0.2m developed on white sand of the Kirkhill Palaeosol Bed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2465 ,
        namedrockunit:H553 ,
        namedrockunit:H554 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 0.7m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the bed is typically gradational over c.0.05m with the overlying Camphill Gelifluctate Bed. On the margins of the channels/basins cut into bedrock seen in Kirkhill Quarry (infilled), units up to the Rottenhill Till Formation may rest conformably on the Swinedon Sand Bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Kirkhill Organic Deposits [Obsolete: use SWDEN]"@en ,
        "Kirkhill Organic Layer [Obsolete: use SWDEN]"@en ,
        "Swinedon Member [Obsolete: use SWDEN]"@en ;
    skos:broader namedrockunit:WLSG ;
    skos:definition "Sand and trace organic mud. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SWDEN"@en ;
    skos:prefLabel "Swineden Sand Bed"@en ;
.

