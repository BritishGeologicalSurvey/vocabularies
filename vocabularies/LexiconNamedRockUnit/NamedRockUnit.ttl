namedrockunit:RBL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly grey, sandy, micaceous, shaly siltstones with bunches of interbedded, generally fine-grained, sharp-soled sandstone lenses locally developed; includes three thin marine bands; rare clean quartzitic sandstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Base is top surface of the Brennand Grit, where present. This is typically a sandstone rootlet bed (ganister), overlain sharply by siltstone and fine-grained sandstone of the Roeburndale Member. Where the Brennand Grit is absent, gradational above the Pendle Grit Member, with boundary where siltstones of the Roeburndale Member become predominant above massive turbiditic sandstones of the Pendle Grit Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4285 ,
        namedrockunit:H481 ,
        namedrockunit:LRBG ,
        namedrockunit:NRBG ,
        namedrockunit:RBG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.600-700m"@en ;
    lexicon:hasUpperBoundaryDefinition "(nb previously defined at the base of the Caton Shale Formation).The base of the sandstone of the Ward's Stone Sandstone is typically sharp and erosional, and rests upon siltstones and fine-grained sandstones of the Roeburndale Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Roeburndale Grit [Obsolete: use RBL]"@en ,
        "Roeburndale Formation [Obsolete: use RBL, SILS]"@en ,
        "Roeburndale Grit Group [Obsolete: use RBL]"@en ,
        "Roeburndale Grit [Obsolete: use RBL, WRST]"@en ,
        "Upper Roeburndale Grit [Obsolete: use RBL]"@en ;
    skos:broader namedrockunit:SILS ;
    skos:definition "Siltstone with subsidiary sandstone and silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
