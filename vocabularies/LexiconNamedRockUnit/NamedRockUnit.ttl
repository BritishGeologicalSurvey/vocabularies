namedrockunit:BK
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:RHP ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Matrix and clast-supported breccias; clasts range from small pebble to cobble; the matrix is variously clay, silt and/or sand. The clasts reflect the local source rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp and irregular unconformable contact with older rocks, usually Dinantian, Westphalian or Ordovician (Borrowdale Volcanic Group). Geophysically the base is usually sharp, marked by a decrease in gamma-ray values and sonic interval transit times. This is most marked in West Cumbria where Brockram overlies the Carboniferous Limestone (Dinantian)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Very variable, up to 160 m."@en ;
    lexicon:hasUpperBoundaryDefinition "May be sharp or transitional in West Cumbria. Sharp contact with overlying dolomite or dolomitic mudstones of the St Bees Evaporite Formation is marked by a rapid decrease in gamma-ray values and a less marked decrease in sonic interval transit times."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KHBR ;
