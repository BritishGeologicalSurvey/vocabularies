    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Unknown. Minimum thickness 120 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The depositional upper boundary is not seen but probably tectonic."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CN> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
