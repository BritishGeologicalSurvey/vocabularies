namedrockunit:DABLS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Dab Limestone Unit consists of white, light grey, brown, cream to buff, firm to hard, fine- to medium-grained, glauconitic, pyritic, silty and sandy limestones with thin interbeds of light to dark grey, firm to hard, calcareous, micromicaceous and carbonaceous mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "In the West Shetland Basin, the Whiting Sandstone Unit (e.g. 206/10a-l) and the Dab Limestone Unit (e.g. 206/8-4) rest unconformably on the Clair Group and Victory Formation, respectively."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KO> ;
    lexicon:hasOldestAgeValue 8.94e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasUpperBoundaryDefinition "On wireline logs the top of the unit is represented by a marked downward decrease in the gamma-ray log values and an increase in the velocity as Kyrre Formation mudstones grade to Dab Limestone Unit limestones and mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KO> ;
    lexicon:hasYoungestAgeValue 8.57e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KYRE ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Coniacian Age (Cretaceous Period) (89.4-85.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DABLS"@en ;
    skos:prefLabel "Dab Limestone Unit"@en ;
.

