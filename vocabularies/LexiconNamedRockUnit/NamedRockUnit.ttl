    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coal, with a high clastic content, containing thick dirt partings where it splits in two, in the east of the subcrop."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of the coal, resting on mainly grey mudstone of the underlying undivided Radstock Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1056 ,
        namedrockunit:H3549 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "A thin coal, from about 36 cm around Timsbury [366862 158 974], to 66 cm thick in the west of the Somerset Coalfield, near where it dips below the sub-Triassic outcrop, and also around Radstock [367195 153 272] in the south of the coalfield. To the east of the coal basin, the seam splits in two, and attains a combined thickness of about 75cm."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the coal, overlain by a hard mudstone and sandstone both of the undivided Radstock Member. Elsewhere the unit is capped by a shale roof."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Coal (Somerset) [Obsolete: use MLEC, MDDC]"@en ,
        "Middle Vein [Obsolete: use MLEC, MDDC]"@en ,
        "No.5 Vein [Obsolete: use NO5C]"@en ,
        "Pensford No.2 Coal (Bristol Area)"@en ;
    skos:broader namedrockunit:RAD ;
    skos:definition "Coal. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage (Carboniferous Period) (310-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MDDC"@en ;
