        namedrockunit:SUTH ;
    skos:definition "Bituminous mudstone, mudstone and sandstone with subsidiary coal. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
