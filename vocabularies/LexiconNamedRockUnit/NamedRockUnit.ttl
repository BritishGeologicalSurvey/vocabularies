namedrockunit:LLEYN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stiff, generally ill-sorted, massive to crudely stratified, variably pebbly, sandy clay, characteristically containing exotic clasts and shell fragments. Subordinate clayey gravels and stratified sand and gravel are locally present. Colour and dominant clast composition variable and generally reflect the local bedrock geology; in Ceredigion and Pembrokeshire it is generally green-grey with abundant Lower Palaeozoic rock clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Base not seen at type locality, but could potentially overlie pre-Late Devensian deposits (Young et al.,2002); locally the formation overlies bedrock and Devensian head deposits (Gibbons and McCarroll, 1993). In Ceredigion and Pembrokeshire the base is unconformable on bedrock, head and regolith (Hambrey et al., 2001); near Llanrhystud it is on the Plynlimon Till Formation (Campbell and Bowen, 1989; Davies et al., 1997) or Plynlimon Glacigenic Formation (McMillan et al., in prep. 2009). Along Liverpool and Conwy bays the base overlies bedrock and, locally, tills of Welsh origin (Warren et al., 1984)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3528 ,
        namedrockunit:S201 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Highly variable: locally more than 17m in the Cardigan district (Maddison et al., 1994); more than 60m in the Dee Valley (Davies et al., 2004); and more than 30m on the Lleyn Peninsula (Gibbons and McCarroll, 1993)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or unconformable contact with West Wales or Cheshire-North Wales catchment subgroups. However, at the eastern end of the type section the upper boundary is defined by contact with till of the overlying Eryri Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Irish Sea till [Obsolete: use SAGL, LLEYN]"@en ,
        "St Asaph Formation [Obsolete: use LLEYN]"@en ;
    skos:broader namedrockunit:SAGL ;
    skos:definition "Diamicton with subsidiary gravel and sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LLEYN"@en ;
    skos:prefLabel "Lleyn Till Member"@en ;
.

