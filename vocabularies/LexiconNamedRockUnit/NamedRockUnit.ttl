namedrockunit:LCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, fine-grained, quartzose, spiculitic, bedded, variably calcareous as hard beds or rows of sphaeroidal nodules ('doggers' or 'ball beds'), some beds highly bioturbated, diverse fauna notably of ammonites and bivalves; locally finer-grained sandstone beds, sponge spicule-rich beds ('chert') and ooidal limestone beds are developed (see Supplementary Information)"@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational: passage up from silty mudstone (Weymouth Member, Oxford Clay Formation) by increasing siltiness and fine sand, including sponge spicules, necessarily arbitrary."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4752 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "40 to 60m in Tabular Hills, 20-21m at Scarborough, 16m+ at Cayton Bay, thins west and south."@en ;
    lexicon:hasUpperBoundaryDefinition "Non-sequence: generally well-cemented calcareous fine-grained sandstone, locally spicule-rich, sharply overlain by softer fine- to medium-grained calcareous sandstone (basal Yedmandale Member or Birdsall Calcareous Grit Member of Coralline Oolite Formation) or sandy ooidal limestone (Hambleton Oolite Member of Coralline Oolite Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Calcareous Grit, Lower [Obsolete: use LCG]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Calcareous sandstone and silty sandstone with subsidiary limestone and trace chert. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:OSTD ;
    skos:notation "LCG"@en ;
    skos:prefLabel "Lower Calcareous Grit Formation"@en ;
.

