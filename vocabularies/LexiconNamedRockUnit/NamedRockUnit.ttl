    lexicon:hasThicknessDescription "2.4m (average)"@en ;
    lexicon:hasUpperBoundaryDefinition "At surface or overlain by floodplain gravel"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
