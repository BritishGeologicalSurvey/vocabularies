namedrockunit:PZS
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S817 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/NODL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cleaved purple mudstones in which bedding is picked out by pale green and grey beds and laminae, and by thin sandstone (some graded bedding, load structures and rare cross-lamination) and laminated siltstone horizons. Thicker beds of green mudstone occur in association with dark grey mudstone which is sporadically fossiliferous. Thin chlorite-rich tuffaceous mudstone beds seen in coastal exposures. Local occurrence of small dolomitised limestone nodules in beds up to 3 m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional with the underlying Harbour Cove Slate Formation. The boundary is placed where the colour changes from dominatly grey-green (Harbour Slate Formation) to purple (Polzeath Formation). In coastal sections, the base of the Formation is faulted."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H475 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 320 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable with the overlying Gravel Caverns Conglomerates at Pentire Haven [SW 9333 7973]. In the field this tranistion is observed as a gradational change from cleaved purple mudstone with pale green and grey beds and laminae to conglomerate beds (up to 2 m) with interbedded grey-green mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Polzeath Slates"@en ,
        "Upper Devonian Purple and Green Slates [Obsolete: use PZS]"@en ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone and trace nodules (undifferentiated) and tuff. Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age - to - Famennian Age (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "PZS"@en ;
    skos:prefLabel "Polzeath Slate Formation"@en ;
.

namedrockunit:QCG
