namedrockunit:BHGR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unbedded, abraded flint gravels with subordinate clay bodies and sand beds. Flint fragments are up to 0.3m diameter, fragments of vein quartz, schorl (rock composed of tourmaline and quartz), quartzite and thermally-altered Carboniferous shale and chert are also present. This unit is interpreted to have been deposited in a fluvial environment; analysis of the clay matrix by Hamblin (1973) indicated incorporation of material reworked from the Tower Wood Gravel, and from Upper Palaeozoic rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "The Buller's Hill Gravel, flint-rich gravels (as described in the lithology description) succeed the Tower Wood Gravel - a deposit of unbedded closely-packed unabraded flints in a matrix of clay and some sand. The boundary is marked by an unconformity and a variation in colour, with the overlying Buller's Hill Gravel being pale brown or pale grey, but typically darker than the underlying Tower Wood Gravel."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1354 ,
        namedrockunit:H1984 ,
        namedrockunit:H2607 ,
        namedrockunit:H3157 ,
        namedrockunit:H3848 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GT> ;
    lexicon:hasOldestAgeValue 5.92e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 21 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Buller's Hill Gravel is in part removed by erosion, forming the modern land surface; elsewhere the flint-rich gravel of the Buller's Hill Gravel is succeeded by recent Head deposits of mixed lithology."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GB> ;
    lexicon:hasYoungestAgeValue 3.77e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bovey Beds [Obsolete: use AGR, BHGR]"@en ,
        "Buller's Hill Gravel Formation [Obsolete: use BHGR]"@en ,
        "Buller's Hill Gravel [Obsolete: use BHGR]"@en ,
        "Haldon Gravels [Obsolete: use BHGR]"@en ,
        "Tertiary Beds [Obsolete: use BHGR]"@en ;
    skos:broader namedrockunit:HGR ;
    skos:definition "Gravel with subsidiary clay and sand. Stratified bedrock. Occurs onshore. Deposited during the Thanetian Age - to - Bartonian Age (Palaeogene Period) (59.2-37.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHGR"@en ;
    skos:prefLabel "Buller's Hill Gravel Member"@en ;
