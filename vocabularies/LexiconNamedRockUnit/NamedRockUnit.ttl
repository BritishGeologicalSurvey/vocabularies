namedrockunit:TURK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SARCST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, typically an ooidal and bioclastic grainstone, with rare claystone partings, dolomitic, grey, stylolitic, well-sorted, fossiliferous, relict cross-bedding, wave ripples and hummocky cross-bedding. Interpreted as a transgressive, high energy, shallow marine facies deposited on a carbonate ramp."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Turkeyland Member is poorly defined. It rests directly on conglomerates of the Langness Conglomerate Formation on the foreshore of the Langness Peninsula [SC 2820 6607] although exposures are discontinuous and poorly exposed. It was formerly exposed at the now infilled Turkeyland Quarry [SC 2950 6940] where it was recorded by Dickson et al. (1987) as resting directly on conglomerates of the Langness Conglomerate Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "18 to 25m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the field the top of the Turkeyland Member is poorly exposed on the foreshore at Derbyhaven [SC 2835 6653] where it is overlain by the Sandwick Member. The boundary is gradational, taken at the change from limestone(Turkeyland Member) to limestone with interbedded claystones (Sandwick Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DBH ;
    skos:definition "Limestone and trace silicate-claystone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TURK"@en ;
    skos:prefLabel "Turkeyland Member"@en ;
.

