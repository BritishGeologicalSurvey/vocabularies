namedrockunit:BOOC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clasts of very glauconitic shelly sandstone, up to cobble size, commonly with a phosphatic rind, together with phosphatised shells (bivalves and ammonites) in a matrix of sandy glauconitic chalk. The derived fauna is Latest Albian; the indigenous fauna is Early Cenomanian."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable, locally strongly erosive and burrowed, overlying the Shaftesbury Sandstone Member.The boundary is marked by the change from weakly glauconitic sandstone up into green strongly glauconitic sandy calcareous mudstone (\"marl\")."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3236 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 to 1m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the disconformable contact with a phosphatic pebble bed at the base of the Zig Zag Chalk Formation or the West Melbury Marly Chalk Formation (at the base of the Chalk Basement Bed of Kennedy, 1970)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Passage Beds [Obsolete: use BOOC, SGBK, CLGB, MCH, UND, YED, MYS]"@en ;
    skos:broader namedrockunit:WMCH ;
    skos:definition "Chalk and conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BOOC"@en ;
    skos:prefLabel "Bookham Conglomerate Bed"@en ;
.

namedrockunit:BOOL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, with interbedded subordinate claystone and siltstone at the top. Limestones vary from grainstone to packstone with bioherms of wackestone. Locally dolomitic. Limestones are typically grey and contain crinoids, brachiopods and corals. Large bioherms have been described up to 5m in height and 10m in width (Dickson et al.1987). Represents carbonate platform edge deposits."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is poorly defined. The base is thought to be diachronous; it is partly coeval with the Bowland Shale Formation and was subsequently overstepped by it (Chadwick et al.2001). At Sea Mount in Castletown Bay [SC2590 6990] the Balladoole Formation rests directly on the Hodderense Limestone Formation (the former Sea Mount Member of Dickson et al.1987)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2007 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.90m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is poorly defined. The Bowland Shale Formation oversteps the Balladoole Formation at outcrop in a foreshore exposure north-east of Spring Cottage [SC2440 6790]. Here the Balladoole Formation comprises unbedded lime mud mounds.The overlying Bowland Shale Formation comprises detrital carbonates, with interbedded grey mudstones and debris beds, including erosively based graded packstone beds."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Poyllvaaish Limestones of Lewis (1930) [Obsolete: use BOOL]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary claystone, dolomitic limestone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage (Carboniferous Period) (337-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BOOL"@en ;
    skos:prefLabel "Balladoole Formation"@en ;
.

