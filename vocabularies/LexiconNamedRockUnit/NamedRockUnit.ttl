namedrockunit:LAGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to coarse-grained poorly sorted sandstones and conglomerates of the Laig Gorge Sandstone Member are overlain by sandy and micritic limestones of this member."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is at a burrowed contact with the Laig Gorge Sandstone Member on Eigg, but is considered absent in successions of the Inner Hebrides Group in Mull and Morvern by Mortimore, Wood and Gallois (2001). This member is equivalent to the Strathaird Limestone Formation of Braley (1990) and Lowden et al. (1992). See note in supplementary information."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4142 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasOldestAgeValue 9.39e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "3.0m at Laig Gorge, Eigg, and about 1.6m on Skye."@en ;
    lexicon:hasUpperBoundaryDefinition "At Strathaird on Skye the upper boundary of the member is disconformable at an erosion surface above which a coarse, poorly sorted, silicified chalk and flint conglomerate of the Clach Alasdair Conglomerate Member is found. At Laig Gorge on Eigg the boundary is a sharp contact with a basalt but the limestone appears unbaked."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KT> ;
    lexicon:hasYoungestAgeValue 8.94e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Laig Limestone Formation [Obsolete: use LAGL]"@en ;
    skos:broader namedrockunit:STRL ;
    skos:definition "Limestone with subsidiary conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Turonian Age (Cretaceous Period) (93.9-89.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LAGL"@en ;
    skos:prefLabel "Laig Gorge Limestone Member"@en ;
.

