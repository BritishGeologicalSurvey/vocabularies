        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded pink quartzofeldspathic psammite and grey micaceous grey psammite. Parallel bedded psammite layers 10-20cm thick develop plane parallel internal lamination defined by alternations of more micaceous and quartzofeldspathic layers at a mm scale. Similar scale but undulose bedded forms also present with rare preservation of hummocky cross stratification. Subsidiary 50-100cm-thick massive beds may have a lenticular form and may be indicative of channel or sand-wave macroforms. Semipelite to pelite comprises a very minor part of the Formation but forms in layers up to 15m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3810 ,
        namedrockunit:H660 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasOldestAgeValue 7.2e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">1000m."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt change to white weathering pinkish-brown quartzose psammite and quartzite of the succeeding Beinn a' Chaisteil Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AC> ;
    lexicon:hasYoungestAgeValue 6.35e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grampian Group (Undivided) [Obsolete: use AUGL]"@en ,
        "Moine [Obsolete: use AUGL]"@en ;
    skos:broader namedrockunit:GRGS ;
    skos:definition "Psammite with subsidiary pelite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Cryogenian Period (Precambrian) (720-635 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AUGL"@en ;
    skos:prefLabel "Auch Gleann Psammite Formation"@en ;
.

namedrockunit:AULY
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GHSCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TALCR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, micaceous psammite and garnetiferous semipelite, with minor calcsilicate, calcareous garnetiferous semipelite and garnet-hornblende schist, the latter of possible volcaniclastic origin. Psammite dominates in the upper part of the formation, semipelite dominates in the lower part. Locally, muscovite-chlorite-talc schist with included fragments of carbonate, psammite and siliceous semipelite comprises a distinctive unit with a melange-like appearance within the Formation (Pubil Melange Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "Upper limit of the calcareous semipelite (typically pale green, phengite, chlorite schist) of the Ben Lawers Schist Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DBSB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0-400m?"@en ;
    lexicon:hasUpperBoundaryDefinition "Transitional change upwards to schistose muscovite-biotite-garnet semipelite of the Ben Lui Schist Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sron Bheag Schist [Obsolete: use AULY]"@en ;
    skos:broader namedrockunit:DBED ;
    skos:definition "Psammite and semipelite with subsidiary calcareous semipelite, calcsilicate-rock, garnet semipelite, garnet-hornblende schist, micaceous psammite and talc-rock. Stratified bedrock. Occurs onshore. Deposited during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PUBL ;
    skos:notation "AULY"@en ;
    skos:prefLabel "Auchlyne Formation"@en ;
.

