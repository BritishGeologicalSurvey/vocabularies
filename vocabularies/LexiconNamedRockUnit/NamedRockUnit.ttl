namedrockunit:RMIS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """See RMD Raised marine and coastal zone deposits. \r
\r
Composite deposit: 'Raised Marine Intertidal Deposits': variable lithology - gravel through to clay, may be rich in organic matter; from the marine intertidal coastal zone, but now above the level of the present shoreline as a result of earth movement or a general fall in sea level. 'Raised Subtidal Deposits': also a variable lithology - any deposit laid down in the subtidal zone ie. below mean low water, but now above the level of the present shoreline as a result of earth movement or a general fall in sea level. [Generic description]."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:RMD ;
    skos:definition "Sand with subsidiary clay and gravel. Superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RMIS"@en ;
    skos:prefLabel "Raised marine intertidal and subtidal deposits"@en ;
.

