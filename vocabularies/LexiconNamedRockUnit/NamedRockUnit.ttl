namedrockunit:HHLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Holehead Lava Member consists mainly of plagioclase-macrophyric basalts and trachybasalts (basalts to hawaiites of 'Markle' type), characterised by the presence of variable amounts of generally relatively small plagioclase macrophenocrysts. In addition, one lava of transitional trachybasalt to mugearite composition is exposed in the middle of  lava sequence. The flows tend to be relatively thin with slaggy tops and locally rubbly bases. The lavas were thought by Craig (1980) to have been derived from the Waterhead Centre ('Waterhead Central Volcanic Complex')."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal plagioclase-macrophyric basalt, and or trachybasalt (hawaiite), is conformable or disconformable on basaltic-trachyandesite (mugearite) of the Fin Glen Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2237 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "More than 100 m, top eroded."@en ;
    lexicon:hasUpperBoundaryDefinition "The Holehead Lava Member occupies summit areas across its outcrop and the top of the member has been eroded."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Holehead Lavas [Obsolete: use HHLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Hawaiite and olivine-basalt with subsidiary mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HHLA"@en ;
    skos:prefLabel "Holehead Lava Member"@en ;
.

