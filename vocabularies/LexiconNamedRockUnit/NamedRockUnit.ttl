namedrockunit:FRC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicate-mudstone, grey, blue grey and olive-grey, calcareous in parts, with minor generally fine-grained limestone units. Highly fossiliferous and/or bioturbated at some levels. A unit of between five and twenty 0.1 m-thick muddy, shelly, bioturbated limestone beds interbedded with 0.3 m-thick mudstone beds is developed at the base and termed the Wattonensis Limestone Member, which is poorly developed around Frome, but thickens south to the Dorset coast and offshore. Above it in Dorset, oyster-rich mudstone beds are developed at two levels."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Wattonensis Limestone Member, a thin unit (3 to 4 m) of interbedded limestone and mudstone, resting on calcareous mudstone of the Fuller's Earth Formation. Base defined by an increase in shell-detritus in the calcareous mudstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2180 ,
        namedrockunit:H5116 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "20 to 50 m in Wiltshire and Somerset, 45 to 70 m in Dorset (see Bristow et al., 1995)."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the Boueti Bed (Forest Marble Formation) a thin shell-fragmental muddy limestone with abundant Goniorhynchia boueti overlying silicate mudstone of the Frome Clay Formation, which may contain burrows."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Fuller's Earth [Obsolete: use FRC, FE]"@en ,
        "Upper Fuller's Earth [Obsolete: use FRC]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Calcareous mudstone with subsidiary calcilutite, mudstone and shelly mudstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WAB ;
    skos:notation "FRC"@en ;
    skos:prefLabel "Frome Clay Formation"@en ;
.

namedrockunit:FRLI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A buff to dark grey, bioclastic, sandy grainstone to packstone and fenestral lime mudstone, displaying tabular or cross bedding, containing stromatolites and Lithostrotion, Syringopora and Siphonodendron coral colonies."@en ;
    lexicon:hasLowerBoundaryDefinition """The lower boundary is generally marked by a disconformity at the top of the underlying Courceyan age Marsett Formation (formerly Basal Beds (Cumbria) Formation), or locally, the Cockermouth Volcanic Formation. The disconformity surface may be identified in borehole records, but in outcrop in West Cumbria, the boundary is conveniently taken at the sharp change from conglomerate, sandstone, mudstone or basalt lava to cross-bedded calc-arenite and limestone. The disconformity represents a depositional hiatus spanning the Chadian and Arundian stages, except in a single instance in the Sellafield area where a few metres of late Chadian strata are preserved below the formation base (Sellafield Borehole No.3, Barclay et al., 1994).\r
In places along the northern margin of the Lakeland fells (Eastwood et al., 1968) the formation oversteps the Marsett Formation and directly overlies Lower Palaeozoic Skiddaw Group or Borrowdale Volcanic Group rocks, and as such, the lower boundary is the base Carboniferous unconformity."""@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H915 ,
        namedrockunit:OG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 50m to 100m"@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the limestone beds with a Holkerian fauna, or the base of the limestone beds containing a late Asbian fauna. In addition, the top of the beds of mudstone interbedded with calcrete and palaeokarstic limestone (Sixth Shale Member of the West Cumbria orefield) boundary picked in the Sellafield Borehole No.3 (Barclay et al., 1994), corresponds to a prominent palaeokarstic surface, and in the Uldale area [NY 2560 3700], the top of the Formation is a palaeosol containing a thin coal seam (Eastwood et al., 1968)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Orton Group [Obsolete: use FRLI]"@en ,
        "Seventh Limestone [Obsolete: use FRLI]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone, mudstone, sandstone and siltstone with subsidiary calcareous sandstone and trace calcrete and coal. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage (Carboniferous Period) (343-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LM7 ;
    skos:notation "FRLI"@en ;
    skos:prefLabel "Frizington Limestone Formation"@en ;
.

namedrockunit:FSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cross-bedded pebbly sands and highly fossiliferous gravels comprising predominantly the remains of calcareous sponges, but also including common brachiopods, echinoderms and bryozoa. Bored mudstone and limestone clasts and phosphatised fossils, derived from underlying Kimmeridge Clay and Corallian Group strata, occur at the base of the member and at higher levels within the succession. Two subdivisions, comprising lower 'yellow gravel' and upper (iron-oxide stained) 'red gravel', have previously been recognised, separated by a non-sequence. According to Poole et al. (1971), cross-bedding diminishes upwards from the 'yellow gravel' into the 'red gravel', and there is a change in current direction as indicated by apparent dips."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, channelled, at the basal contact of the 'yellow gravel' with underlying Kimmeridge Clay mudstones, or locally, Corallian Group limestones."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H263 ,
        namedrockunit:H4659 ,
        namedrockunit:H916 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the member is the upward facies change from gravelly, fossiliferous sandstone to non-pebbly, poorly fossiliferous sandstone and mudstone containing horizons of chert and ironstone of the Baulking Sand Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Faringdon Sponge Gravels [Obsolete: use FSG]"@en ,
        "Sands and gravels of Faringdon [Obsolete: use FSG]"@en ,
        "The Sponge Gravels of Farringdon [Obsolete: use FSG]"@en ;
    skos:broader namedrockunit:FDNS ;
    skos:definition "Gravel. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FSG"@en ;
    skos:prefLabel "Faringdon Sponge Gravel Member"@en ;
.

namedrockunit:FSLCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTNP"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy, clayey, silty sand diamicton, brown. Interpreted as a truncated gleyed brown earth soil profile developed under temperate climate conditions. The truncated palaeosol bed represents the pedogenically modified upper c. 0.80 m of the Rottenhill Till Formation. Pedogenic development is indicated by the following properties: the upper 0.70 m of the deposit has a strong brown colour in contrast to the lower part of the deposit which is yellowish brown. It also displays coarse mottles of yellowish red and greyish brown to brown due to Fe oxide segregation. Mafic igneous and granite clasts have been converted to gruss in situ and clay minerals show alteration from illite to mica-smectite up profile. Disrupted void argillans (evidence of clay translocation and subsequent disruption) and erect pebbles have been recorded in thin section, indicating that the palaeosol has superimposed cold climate soil features."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the palaeosol bed is gradational (over c. 0.10 m) between the pedogenically modified diamicton and the relatively unaltered diamicton of the Rottenhill Till Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2807 ,
        namedrockunit:H4660 ,
        namedrockunit:H4661 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 0.80 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is a subhorizontal, planar, erosion surface overlain by gravelly sandy diamicton of the Corsend Gelifluctate Bed. The upper horizon of the palaeosol bed (not preserved) was eroded at some point prior to deposition of the gelifluctate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Backfolds Palaeosol [Obsolete: use FSLCK]"@en ,
        "Kirkhill Upper Buried Soil [Obsolete: use FSLCK]"@en ,
        "Upper buried soil [Obsolete: use FSLCK]"@en ;
    skos:broader namedrockunit:ROTIL ;
    skos:definition "Pedogenically-altered diamicton with subsidiary diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage (Quaternary Period) (.126-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FSLCK"@en ;
    skos:prefLabel "Fernieslack Palaeosol Bed"@en ;
.

