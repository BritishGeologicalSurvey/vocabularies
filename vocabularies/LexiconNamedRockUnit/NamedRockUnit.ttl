    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to more than 15m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Longhaugh Sand and Gravel Member of the Clydebank Clay Formation is overlain by younger Quaternary sediments belonging to the same Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Longhaugh Formation [Obsolete: use LUGH]"@en ;
    skos:broader namedrockunit:CBCL ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LUGH"@en ;
    skos:prefLabel "Longhaugh Sand And Gravel Member"@en ;
