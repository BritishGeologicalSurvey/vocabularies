    lexicon:hasThicknessDescription "0.6m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, gently undulating, unconformable contact with stony sandy clay diamicton of the Athais Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
