namedrockunit:THOR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:WARP ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Greyish brown soft, locally fissured, laminated silt and clay. The top metre of this member commonly contains a higher percentage of silt and sand, is reddish yellow to grey colour-mottled and the laminated structure has been destroyed by periglacial and soil processes. This unit can contain gravel dropstones and glaciotectonic structures, particularly near the Escrick Moraine."@en ;
    lexicon:hasLowerBoundaryDefinition "The Thorganby Clay Member is shown in boreholes and sections to rest directly on the Lawns House Farm Member. The contact can be sharp or gradational with interbedded sand, silt and clay layers. The Thorganby Clay Member only occurs where the Lawns House Farm Sand Member is present. Outside of this area, the equivalent clay is part of the undivided Hemingbrough Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1229 ,
        namedrockunit:H4703 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1 to 3.5m. (Proved in auger holes)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Thorganby Clay Member is typically exposed at surface, or concealed beneath the Breighton Sand Formation. The upper boundary may not be preserved where Skipwith Peat Bed has formed directly on silted up or dried up lake bed. Where the base of the overlying Breighton Sand Formation is represented by sandy facies, the upper boundary is typically sharp and erosive. In most places the upper boundary is disturbed by periglacial and soil processes."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Sand of 25 Foot Drift [Obsolete: use HEM, THOR]"@en ,
        "Silt and clay of the 25 Foot Drift [Obsolete: use HEM, THOR]"@en ,
        "Warp"@en ;
    skos:broader namedrockunit:HEM ;
    skos:definition "Clay and silt with subsidiary sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THOR"@en ;
    skos:prefLabel "Thorganby Clay Member"@en ;
.

