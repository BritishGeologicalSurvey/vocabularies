        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Semipelite, flaggy, calcareous and minor micaceous psammite, green with tremolitic amphibole porphyroblasts prominent in most exposures. Upper part locally contains thin, lenticular bands of metalimestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Transition from dominantly bluish and purplish grey calcareous flaggy semipelite to dominantly greenish grey tremolitic lithologies."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H275 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
