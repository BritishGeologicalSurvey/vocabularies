namedrockunit:SMOG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MOLGB"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Sionascaig Meta-olivine-gabbro Subswarm comprised the Fe-rich members of the Scourie Dyke Swarm. The dykes of the Subswarm are most abundant within the Lewisian Gneiss Complex in the Assynt region, where they are found to the south of the Canisp Shear Zone. Typically they have a broadly E-W trend. The dykes of the Subswarm are typically coarse-grained and texturally heterogeneous. They have the primary mineralogy olivine - clinopyroxene - orthopyroxene - plagioclase - kaersutite - biotite - Fe-Ti oxide. The plagioclases are typically heavily altered so that they appear black in hand-specimen, and this led to these dykes originally being mapped as ultramafic. The dykes of the Sionascaig Meta-olivine-gabbro Subswarm appear to post-date all but a few late metadolerites of the Scourie Dyke Swarm."@en ;
    lexicon:hasLowerBoundaryDefinition "N/a"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:AMOG ,
        namedrockunit:H2435 ,
        namedrockunit:H4888 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UW> ;
    lexicon:hasThicknessDescription "1m - 100m"@en ;
    lexicon:hasUpperBoundaryDefinition "N/a"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AL> ;
    lexicon:hasYoungestAgeValue 1.6e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Assynt Meta-Olivine Gabbro Subswarm [Obsolete: use SMOG]"@en ,
        "Assynt Meta-Olivine Subswarm [Obsolete: use SMOG]"@en ,
        "Olivine gabbro dykes of the Scourie Dyke Swarm [Obsolete: use SMOG]"@en ;
    skos:broader namedrockunit:SCOUR ;
    skos:definition "Meta-olivine-gabbro. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Paleoproterozoic Era (Precambrian) (2500-1600 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SMOG"@en ;
    skos:prefLabel "Sionascaig Meta-Olivine-Gabbro Subswarm"@en ;
