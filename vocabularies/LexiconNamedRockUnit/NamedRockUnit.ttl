namedrockunit:GAPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use REP] \r
\r
Buff to pale brown and pink, flaggy, siliceous and feldspathic psammite with micaceous partings, some heavy mineral bands and numerous streaky lenticles displaying quartzofeldspathic segregations."""@en ;
    lexicon:hasLowerBoundaryDefinition "Located at the Sgurr Beag Thrust Plane, which is commonly interdigitated with Lewisianoid tectonic slices. This formation is structurely the lowest Moine group unit in the Sgurr Beag Nappe."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H274 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AP> ;
    lexicon:hasOldestAgeValue 2.5e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not recorded."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by the western edge of the Ben Wyvis Pelite Formation, with the appearance of predominantly pelitic rocks to the east. The boundary has probably been significantly tectonically modified."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AP> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:REP ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Ben Wyvis Psammite [Obsolete: use GAPS]"@en ,
        "Reidh Psammite Formation"@en ;
    skos:definition "Obsolete name. Psammite. Stratified bedrock. Occurs onshore. Deposited during the Proterozoic Eon (Precambrian) (2500-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GAPS"@en ;
    skos:prefLabel "Garve Psammite Formation [Obsolete: use REP]"@en ;
.

namedrockunit:GART
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSPL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
