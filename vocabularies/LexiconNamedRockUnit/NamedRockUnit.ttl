    lexicon:hasThicknessDescription "At least 1300m."@en ;
    lexicon:hasUpperBoundaryDefinition "Faulted out; Bovisand Formation thrust over the Staddon Formation for much of the area."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
