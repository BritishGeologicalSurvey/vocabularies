    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - 105m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by aphyric andesite within the Birker Fell Andesite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Bampton Conglomerate [Obsolete: use LTY]"@en ;
    skos:broader namedrockunit:BFA ;
    skos:definition "Volcaniclastic-breccia and volcaniclastic-conglomerate with subsidiary volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LTY"@en ;
    skos:prefLabel "Lanty Crag Breccia Member"@en ;
