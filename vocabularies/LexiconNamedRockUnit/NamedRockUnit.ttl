    lexicon:hasThicknessDescription "To 24.7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally sharp, planar, glacitectonic, unconformable contact with dark reddish brown pebbly silty clay diamicton of the Green Croft Till Member of the Aikbank Farm Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
