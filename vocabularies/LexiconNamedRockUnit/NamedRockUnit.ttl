namedrockunit:BEL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestones and clayey limestones intercalated with lime-rich muds and clays. Includes impersistent peloidal limestones and calcretes."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal contact is gradational or sharp and erosive into principally silts and clays within the members of the underlying Headon Hill Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2595 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GI> ;
    lexicon:hasOldestAgeValue 3.77e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 9m."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational or sharp contact with clays and silts of the Bembridge Marls Member (Bouldnor Formation). As originally defined (Insole and Daley, 1985) the formation included about 2m of lime-rich clays and clay above the highest limestone. These are now assigned to the overlying Bembridge Marls Member (Bouldnor Formation) by Daley and Edwards (1990)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GR> ;
    lexicon:hasYoungestAgeValue 2.73e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
