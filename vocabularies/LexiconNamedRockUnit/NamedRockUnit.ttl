namedrockunit:THBG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BLV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Clast-supported, very poorly sorted boulder gravel, with clasts up to >2.5m in diameter. Clasts are generally angular to subrounded and mainly comprise red Permian sandstone, yellow and white Coal Measure sandstones, black Coal Measure mudstone, together with some coal, green Borrowdale Volcanic Group lavas, grey Criffel granite, ironstone, greywacke and limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Steep erosional (channelled) base against well bedded units of the St Bees Sand and Gravel Member of the Seascale Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H122 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Planar unconformable base of the How Man Till Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Middle Sands and Gravels [Obsolete: use GFSA, SEAG, CGWD, LOGG, PLSG, PFS, EVSI, THBG, EVSG]"@en ;
    skos:broader namedrockunit:SEAG ;
    skos:definition "Gravelly cobbly boulders with subsidiary gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THBG"@en ;
    skos:prefLabel "Townhead Boulder Gravel Member"@en ;
.

