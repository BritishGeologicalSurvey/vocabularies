    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 250 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by mudstones of the Ty'r Gawen Mudstone Formation in the Cadair Idris district, where it also passes laterally into the Pen y Gadair Volcanic Formation. In the northeastern part of this district it is overlain by the felsic tuffs of the Craig Cau Formation, with possible disconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basic Volcanic Group [Obsolete: use BGL]"@en ,
