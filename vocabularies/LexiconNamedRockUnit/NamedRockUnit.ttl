namedrockunit:CERD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:WHM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Cerdic Formation comprises dominantly dark grey marine mudstones with sporadic, thin argillaceous limestones. Where the formation is most complete, it passes upwards into fine-grained sandstones and siltstones at the top (Phillips Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by a downwards change from mudstones to silty, sandy and occasionally ferruginous and oolitic limestone (Ida Formation). The boundary coincides with a marked downwards increase in velocity and a decrease in gamma values."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 120 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is erosional. It is usually marked by a downwards change from clastic facies (Wroot Formation) to mudstones, with a corresponding sharp downwards increase in gamma values and decrease in velocity. Where the upper part of the Cerdic formation is more complete, and the Phillips Member is present, the boundary is placed at a downwards change from paralic sandstones (Wroot Formation) to shallow marine sandstones and siltstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whitby Mudstone Formation"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Mudstone with subsidiary limestone and trace sandstone. Stratified bedrock. Occurs offshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PHLP ;
    skos:notation "CERD"@en ;
    skos:prefLabel "Cerdic Formation"@en ;
.

