    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 160 m thick, in the Lomond Hills area."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from red or purple, pebbly sandstones of the Burnside Formation, to the brown, yellow, red, purple or cream sandstones of the Glenvale Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
