namedrockunit:HRO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A grey, medium- to coarse-grained, thinly to thickly bedded, crinoidal limestone, interpreted to have a turbiditic origin.  Individual beds show slumping at the base, are massive bedded above and the tops may be ripple cross-laminated."@en ;
    lexicon:hasLowerBoundaryDefinition "A sharp upward change in a conformable succession from predominantly grey mudstone to limestone. The base of the first limestone bed above the Harlow Hill Sandstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "20m"@en ;
    lexicon:hasUpperBoundaryDefinition "A sharp upward change in a conformable succession from limestone to predominantly mudstone. The top of the last limestone bed below the Cravenoceras malhamense (E1c1) Marine Band."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
