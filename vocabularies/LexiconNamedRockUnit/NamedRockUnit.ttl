namedrockunit:BSSK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Siltstones and sandstones with a diverse bivalve fauna, belemnites and rare ammonites. A plesiosaur has also been found. The sandstones are commonly bioturbated, with local, small-scale cross-bedding and flaser bedding. One interpretation of the Member is that it was a migrating offshore sand bar, transgressing over the coastal lagoons described by 'Upper Ostrea Member'."@en ;
    lexicon:hasLowerBoundaryDefinition "Marine siltstones and sandstones replace the marine-brackish mudstones of the Upper Ostrea Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasOldestAgeValue 1.653e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp boundary, overlain by bituminous fissile mudstones of the Dunans Shale Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STBA ;
    skos:definition "Sandstone, siltstone and silty sandstone and trace carbonaceous argillaceous sandstone. Stratified bedrock. Occurs onshore. Deposited during the Callovian Age (Jurassic Period) (165.3-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BSSK"@en ;
    skos:prefLabel "Belemnite Sands Member"@en ;
.

namedrockunit:BSSS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Thin interbedded and laminated reddish brown and yellowish brown fine- to medium-grained sand, silt and clay with sparse gravel. Disseminated coal fragments present throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, undulating, draped, unconformable contact with reddish brown stony clay diamicton of the Holmrook Till Member of the Blengdale Glacigenic Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
