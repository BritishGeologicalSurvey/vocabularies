namedrockunit:CLC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (chalk), with an overall \"gritty\" texture and with some flint bands (mainly small and \"spindle-shaped\") most notably the coalescing nodular flint course termed the Oweynamuck Flint Band (of bed status defined at the eastern bluff in White Park Bay [D 029 448]). Beds of green-coated chalk pebbles at some levels. Common brachials and calyx plates of Marsupites."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type site the lower boundary is at a prominent bedding plane immediately above a wavy bedded unit at the top of the underlying Galboly Chalk Formation. Outside the type area the basal contact is disconformable and the junction is marked by an erosion surface with glauconitised chalk pebbles, which includes rolled sponge pseudomorphs."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1439 ,
        namedrockunit:H3306 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasOldestAgeValue 8.57e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Thin succession of 2.33m thickness at its type-site. Absent over structural highs and overlapped by the succeeding member."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the top of a thin (0.15m) wavy bedded unit underlying Creggan Chalk Formation chalks rich in Inoceramus debris. The wavy bedded unit contains a marked increase in Inoceramus compared to the rest of the Cloghastucan Chalk Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KS> ;
    lexicon:hasYoungestAgeValue 8.37e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cloghastucan Chalk Member [Obsolete: use CLC]"@en ,
        "Marsupites White Limestone [Obsolete: use CLC]"@en ;
    skos:broader namedrockunit:UWLF ;
    skos:definition "Chalk with subsidiary flint and limestone. Stratified bedrock. Occurs onshore. Deposited during the Santonian Age (Cretaceous Period) (85.7-83.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLC"@en ;
    skos:prefLabel "Cloghastucan Chalk Formation"@en ;
.

