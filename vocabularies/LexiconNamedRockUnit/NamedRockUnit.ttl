namedrockunit:HWCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Variably sandy grey to brown mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Basal contact may be erosional. In Wiltshire, sharp change up from yellow to grey fine to medium sand, sandstone and muddy sandstone (Hazelbury Bryan Formation) or in Oxfordshire change up from bedded shelly ooidal limestone (Highworth Limestone Member) or sandy ooidal limestone (Pusey Flags Member) into mudstone or sandy mudstone of the Highworth Clay Member. In reference section Faringdon Borehole (SU39SW/1), the base is at 6.71 m."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "2 to 3 m in type area, 1.2 m at Lamb and Flag Quarry, c. 3.7 m at Wootton Bassett."@en ;
    lexicon:hasUpperBoundaryDefinition "Passage up from grey to brown mudstone or sandy mudstone into sand or sandstone with ooids (Highworth Grit Member) in Oxfordshire. Non-sequence overlain by shelly, shell detrital ooidal limestone of the Stanford Formation (Calne Freestone) in Wiltshire."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Mudstone and sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HWCL"@en ;
    skos:prefLabel "Highworth Clay Member"@en ;
.

namedrockunit:HWGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Cross-bedded yellow, orange and white sand and sandstone, sparsely ooidal, with pebbles, very rare ammonites, passing down into clayey sand. Sandy ooidal limestone locally developed."@en ;
    lexicon:hasLowerBoundaryDefinition "Base is marked by an upward passage from grey to brown variably sandy mudstone (Highworth Clay Member) or from sandy ooidal limestone (Pusey Flags Member) into sand or sandstone with ooids of the Highworth Grit Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "2 to 3 m in the type area, 1.2 m at Lamb and Flag Quarry, c. 3.7 m at Westbury and Wootton Bassett."@en ;
    lexicon:hasUpperBoundaryDefinition "Top is a non-sequence, may be bored or eroded. Change up from sand and sandstone of the Highworth Grit Member into bedded bioclastic or ooidal limestones of the Stanford Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Sand and sandstone with subsidiary calcareous sandstone and sandy limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HWGR"@en ;
    skos:prefLabel "Highworth Grit Member"@en ;
