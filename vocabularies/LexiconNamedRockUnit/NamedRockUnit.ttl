namedrockunit:CWMU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use KRM] \r
\r
Mudstone, reddish-brown, structureless, interbedded with silty mudstone, greenish grey, laminated, mudstone breccias, halite and gypsum are common towards the base."""@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, at gradational upward transition from the halite of the underlying Preesall Halite Member to the predominantly greenish grey laminated mudstone at the base of the Coat Walls Mudstone Member."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasOldestAgeValue 2.415e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 130 m in the Blackpool district, Lancashire (Wilson and Evans, 1990)."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational and conformable transition from the laminated, reddish brown and greenish grey mudstone of the Coat Walls Mudstone Member to the dominantly reddish-brown, structureless mudstones of the Breckells Mudstone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TD> ;
    lexicon:hasYoungestAgeValue 2.37e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:KRM ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Kirkham Mudstone Member"@en ;
    skos:definition "Obsolete name. Mudstone with subsidiary breccia, halite and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ladinian Age (Triassic Period) (241.5-237 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CWMU"@en ;
    skos:prefLabel "Coat Walls Mudstone Member [Obsolete: use KRM]"@en ;
