namedrockunit:NWS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation consists of red-purple extraformational conglomerates (40.7%) with a wide range of exotic pebbles, red-purple very fine- to very coarse grained sandstones (35.1%), and sandy, coarse-grained siltstones (24.1%), principally arranged in 1 to 10m-thick, fining-upward units, with a few coarsening upward sequences up to 7m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is a gradational boundary with the underlying Lawrenny Cliff Formation and placed where red-purple beds succeed the green beds of the underlying Lawrenny Cliff Formation. The actual junction is nowhere exposed."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:COB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "320 to 400+m"@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is not seen, the Formation being unconformably overlain by strata of the Avon Group (formerlt \"Lower Limestone Shales\") of Early Carboniferous age. This junction is seen on the shore on the east side of the Carew River [SN 03852 04105] southsoutheast of New Shipping Point. It is a scour surface with up to 2cm relief cut in medium- to coarse grained purple sandstone overlain by a bed of quartz grit up to 4cm thick with shell fragments."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cosheston Subgroup"@en ;
    skos:broader namedrockunit:COB ;
    skos:definition "Conglomerate and sandstone with subsidiary siltstone. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NWS"@en ;
    skos:prefLabel "New Shipping Formation"@en ;
.

