    lexicon:hasLithologyDescription "Silty, sandy, stony clay diamicton (\"lodgement till\"), very stiff, dark grey, containing clasts of mainly local Westphalian lithologies (sandstone, mudstone, limestone, coal), and dolerite. Locally enclosing deformed sheets of sand up to 7.5m thick."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, irregular contact with bedrock, with relief amplitude of 7.5m, part controlled by faults in the bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4771 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 7.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, undulose contact with overlying clay-rich gravel or clayey sand of the Lawthorn Diamicton Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Littlestone Member"@en ,
        "Unit A [Obsolete: use LSTI]"@en ;
    skos:broader namedrockunit:MVG ;
    skos:definition "Diamicton and gravel with subsidiary sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage - to - Devensian Stage (Quaternary Period) (.362-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LTND ;
    skos:notation "LSTI"@en ;
    skos:prefLabel "Littlestone Till Formation"@en ;
