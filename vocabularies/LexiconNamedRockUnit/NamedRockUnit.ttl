namedrockunit:OSB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Green, olive and red calcareous clays and lime-rich muds with discontinuous beds of concretionary limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Underlain at a sharp contact by the brown and grey thin-bedded clays with shell beds of the Fishbourne Member of the Headon Hill Formation on the Isle of Wight."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5237 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GI> ;
