namedrockunit:MKHA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALIST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Muschelkalk Halite Member comprises halite with thin interbeds of red-brown mudstone and anhydrite. The member typically shows low gamma-ray values and high velocities and a mainly parallel-sided log signature representive of halite; narrow peaks of high gamma-ray and lower velocity values correspond to mudstone interbeds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Muschelkalk Halite Member is placed at the downward change from halite to red-brown mudstones, with beds of dolomite and some anhydrite, in the upper part of the Dowsing Formation. The boundary is marked by an abrupt downward increase in gamma-ray values and a decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The member is commonly between 30 and 60 m in thickness but exceeds 60 m in the southern part of the Sole Pit Basin and several other areas, principally adjacent to the Cleaver Bank High (Cameron et al., 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Muschelkalk Halite Member is placed at the downward change from red-brown mudstones, with beds of dolomite and some anhydrite, to halite in the upper part of the Dowsing Formation. The boundary is marked by an abrupt downward decrease in gamma-ray values and a slight increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DWDL ;
    skos:definition "Halite-stone with subsidiary anhydrite-stone and mudstone. Stratified bedrock. Occurs offshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MKHA"@en ;
    skos:prefLabel "Muschelkalk Halite Member"@en ;
.

