namedrockunit:NSF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Based on borehole and historical outcrop descriptions it consists of fine to very coarse ferruginous, glauconitic, quartzose  sands and fine-medium gravels, both partly well-cemented."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the Kimmeridge Clay Formation (KC) or Portland Group (PL)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 m to at least 20 m based on borehole records. The thickest development is located immediately east of the Culham Campus site (formerly UKAEA)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by the Gault Formation (GLT)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KA> ;
    lexicon:hasYoungestAgeValue 1.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LGS ;
    skos:definition "Gravel and sand. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age - to - Albian Age (Cretaceous Period) (121.4-100.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NSF"@en ;
    skos:prefLabel "Nuneham Sand Formation - Proposed"@en ;
.

namedrockunit:NSFS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine-grained sandstone (quartz arenite), well-sorted, thinly planar bedded and laminated, cross-bedded and ripple cross-laminated in places, with wave and current ripples. In the Steeton [SE04SW] and Cowling [SD94SE] areas the sandstone is medium-grained, medium-bedded and feldspathic."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is gradational. with an upward coarsening succession of dark grey silty mudstone and grey siltstone with thin beds of sandstone that become more common upwards. The base of the Nesfield Sandstone is placed where sandstone becomes predominant over siltstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 20m: thickest near Addingham [SE 09 05]."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp transition from Nesfield Sandstone quartz arenite to overlying dark grey mudstone with up to three marine bands, the Nuculoceras nuculum marine bands (E2C 2-4) between 10 and 20m above the top of the sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SILS ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NSFS"@en ;
    skos:prefLabel "Nesfield Sandstone"@en ;
