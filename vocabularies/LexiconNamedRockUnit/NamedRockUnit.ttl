namedrockunit:SBLA
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "About five flows of plagioclase-macrophyric basalt (Markle type)."@en ;
    lexicon:hasLowerBoundaryDefinition "Where the Saughen Braes Lava Member is fully developed in the north-east of the area, it is underlain by the Burncrooks Volcaniclastic Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3019 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-40 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Saughen Braes Lava Member interdigitates with the Auchineden Lava Member and in places underlies it (for example around [NS 443 772]). To the west of Lang Craigs [NS 430 760] the member is completely replaced by the Auchineden Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Saughen Braes Lavas [Obsolete: use SBLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Plagioclase-macrophyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBLA"@en ;
    skos:prefLabel "Saughen Braes Lava Member"@en ;
.

namedrockunit:SBM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation, which is poorly exposed, comprises thin, pale grey calcareous mudstone. It is usually strongly bioturbated and contains a rich and diverse macrofauna, including ammonites, belemnites, bivalves, brachiopods, rare echinoids and corals, together with coccoliths, foraminifera and ostracods."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken at the erosion surface immediately below a phosphatic nodule horizon. In the type section the base is marked by an upward change from sandstones (Roach Formation) up into pale grey, fossiliferous, calcareous clay. In southern Lincolnshire and beneath The Wash, there is an upward change from grey to dark grey, sparsely fossiliferous, clay with iridescent ammonite fragments (Skegness Clay Formation) into pale grey, fossiliferous, calcareous mudstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1802 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c.3.14m in boreholes, but 1 to 2m at outcrop in the type area."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is placed at an erosion surface where there is a upward change from calcareous mudstones of the formation into sandstones of the Carstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sutterby Marl [Obsolete: use SBM]"@en ;
    skos:definition "Calcareous mudstone and mudstone with subsidiary shelly mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "SBM"@en ;
    skos:prefLabel "Sutterby Marl Formation"@en ;
.

namedrockunit:SBPT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Organic mud passing upwards into interbedded organic sand, gravel and compressed peat containing twigs of hazel and pine."@en ;
    lexicon:hasLowerBoundaryDefinition "Not observed, but lying stratigraphically above yellowish brown, sandstone-rich diamicton."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2410 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "At least 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp, planar, unconformable contact, or intercalated glacitectonic junction with overlying yellowish brown, sandstone-rich diamicton correlated with the Gillcambon Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Scandal Beck Formation [Obsolete: use SBPT]"@en ;
    skos:broader namedrockunit:GCBTI ;
    skos:definition "Clay, peat and silt with subsidiary gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SBPT"@en ;
    skos:prefLabel "Scandal Beck Peat Bed"@en ;
.

