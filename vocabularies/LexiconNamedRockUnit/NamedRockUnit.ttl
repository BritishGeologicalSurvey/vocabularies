namedrockunit:UBCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLateralEquivalent namedrockunit:BFCO ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mostly a cobble conglomerate, containing clasts of basic or intermediate lavas, vein quartz, quartzite and other metamorphic rocks with lenses of pebbly sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the youngest body of 'mixed conglomerate' on Uamh Bheag, north-east of Callander, which interdigitates partly with the Teith Sandstone and partly with the Cromix Mudstone formations."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2511 ,
        namedrockunit:H3102 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
