namedrockunit:PPSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Well bedded cross-stratified gravel and sand that typically forms upward coarsening sequences. Clasts are generally rounded to well rounded and comprise a mixture of Permo-Triassic and Carboniferous rocks, as well as igneous and metamorphic rocks derived from the Lake District. Deposit fines downwards into horizontally bedded sand with horizontal and climbing ripple lamination."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally conformable on the Fishgarth Wood Till Member of the Gosforth Glacigenic Formation in the Drigg Hall Carleton area; on the How Man Till Member between St Bees and Braystones and on the Rothersyke Till Member in the Ehenside area."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformably overlain by Holocene deposits such as Blown Sand and by Late Glacial to Holocene peats near its type site."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Gravel and sand with subsidiary silt and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PPSG"@en ;
    skos:prefLabel "Peel Place Sand And Gravel Member"@en ;
.

