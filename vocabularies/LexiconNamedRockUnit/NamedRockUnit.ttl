namedrockunit:CMPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basal part: interbedded micaceous psammite and semipelite-pelite beds, with upwards increase in psammite component. Central part: gritty or pebbly arkosic psammite, with beds 0.5 - 2 m thick, with cm-scale semipelite beds. Trough cross-bedding and water escape structures common. Upper part: similar to the lower part."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlies the Vach Pelite Formation, where predominantly pelitic lithologies pass into predominaintly psammitic lithologies."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1447 ,
        namedrockunit:H4558 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 2500-3000 m (estimate); thinning to the east."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Diebidale Pelite Formation, where predominainlty psammitic lithologies pass into predominantly pelitic lithologies. The upper boundary is locally obscured by the Sgurr Beag Thrust, the Carn Chunneag-Inchbae Granite Gneiss, or the Old Red Sandstone unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Upper Psammite [Obsolete: use CMPS]"@en ,
        "Upper Quartzite [Obsolete: use CMPS]"@en ;
    skos:broader namedrockunit:MORR ;
    skos:definition "Psammite with subsidiary pebbly psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CMPS"@en ;
    skos:prefLabel "Crom Psammite Formation"@en ;
