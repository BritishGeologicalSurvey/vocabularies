namedrockunit:LAHI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Micaceous and feldspathic psammites, semipelites and thin bands of pelite, the latter locally graphitic. Typically flaggy and commonly graded. Tuffaceous and rare metavolcanic beds. 'Boulder Bed' lithology with associated lenticular dolomite beds. Calc-silicate lenses in part. Quartzite bands."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid transition from semipelite and pelite of the Glenfiddich Pelite Formation to micaceous and feldspathic psammite-dominated sequence."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 1000m+. Probable duplication by folding in the Ladder Hills area."@en ;
    lexicon:hasUpperBoundaryDefinition "Grades laterally and upwards into a semipelite/dark pelite/limestone sequence in Nochty Water-Upper Glenbuchat area. Elsewhere overlain by feldspathic quartzite and orthoquartzite of the Kymah Quartzite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DBIS ;
    skos:definition "Psammite and semipelite with subsidiary pelite and trace calcsilicate-rock, dolostone, lava and tuff. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LAHI"@en ;
    skos:prefLabel "Ladder Hills Formation"@en ;
