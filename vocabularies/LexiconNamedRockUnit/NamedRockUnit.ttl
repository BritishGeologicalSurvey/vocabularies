        "Glacial sand and gravel [Obsolete]"@en ,
        "Older river sand and gravel"@en ,
        "River Terrace Deposits, Undifferentiated [Obsolete: use FULB]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FULB"@en ;
    skos:prefLabel "Fulbeck Sand and Gravel Member"@en ;
