namedrockunit:CUS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/L"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded silty clay, sandy silt, and silty sand, forming upward coarsening flat-lying units; generally moderate reddish brown to brown or greyish brown. Sandy silts and silty clays are typically thinly bedded in finely-laminated to massive beds; silty sands display planar lamination, ripple lamination and small-scale tabular cross-bedding. Rounded greywacke drop-stone cobbles disrupt the lamination in silt and clay units at the Partial Type Section."@en ;
    lexicon:hasLowerBoundaryDefinition "Either overlies bedrock or red-brown diamicton of the Gretna Till Formation. Base of unit is not exposed at the Partial Type Section."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasOldestAgeValue 2.6e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Typically 3-5 m, but greater than 10 m proved in boreholes south of Canonbie."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the Kilblane Sand and Gravel Formation at the Partial Type Section; overlain by red-brown diamicton of the Gretna Till Formation in the Reference Section."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasYoungestAgeValue 1.47e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ISCG ;
    skos:definition "Silt with subsidiary sand and silty clay and trace cobbles. Stratified superficial deposits. Occurs onshore. Formed during the Dimlington Stadial (Quaternary Period) (.026-.0147 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CUS"@en ;
    skos:prefLabel "Cullivait Silts Formation"@en ;
.

