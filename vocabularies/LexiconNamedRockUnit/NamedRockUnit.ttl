    lexicon:hasLithologyDescription "Sandstone and pebbly sandstone, part-reddened, medium-to-coarse-grained, micaceous, with well-defined soft hematic partings, and subordinate mudstone.  A basal pebbly sandstone may be present, comprising clasts of mudstone and ironstone up to 2 feet in diameter."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at a well-defined erosional surface.  The base is taken at the base of the first sandstone unit above the Wigan 4 foot Coal, or where this is absent, the base of the first sandstone unit overlying the Wigan 5 foot Coal."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 21m to 46m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the base of a mudstone-dominated succession of the Pennine Lower Coal Measures Formation above the sandstone of the Ravenhead Rock."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PLCM ;
    skos:definition "Sandstone with subsidiary mudstone and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Langsettian Substage (Carboniferous Period) (319-318 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RHR"@en ;
    skos:prefLabel "Ravenhead Rock"@en ;
