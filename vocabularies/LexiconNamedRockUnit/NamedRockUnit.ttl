        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Poorly sorted, feldspathic, gritty psammite with calcareous cement dominant in North Esk section, but grey-blue slates dominate in Margie Burn. North Esk section contains a 2m limestone (\"Margie Limestone\") at NO 5685 7330. Basal conglomerate with metabasalt clasts to 0.3m (\"Green Conglomerate\") at NO 5875 7315."@en ;
    lexicon:hasLowerBoundaryDefinition "\"Green Conglomerate\" in North Esk section is unconformable on metabasalts of the North Esk Formation. All other contacts are faulted."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DCBM ,
        namedrockunit:H4781 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Southern belt in North Esk section is 500m wide. Exposed thickness in North Esk probably no more than 300m."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen: contacts faulted."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OA> ;
    lexicon:hasYoungestAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Black Shale and Margie Grit [Obsolete: use MARG]"@en ,
        "Margie Series [Obsolete: use MARG]"@en ;
    skos:broader namedrockunit:HBX ;
    skos:definition "Psammite and slate with subsidiary conglomerate and limestone and trace gritty psammite, metalimestone and pelite. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series - to - Ashgill Series (Ordovician Period) (458.2-443.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DCML ;
    skos:notation "MARG"@en ;
    skos:prefLabel "Margie Formation"@en ;
