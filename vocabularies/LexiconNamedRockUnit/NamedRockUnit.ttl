    lexicon:hasThicknessDescription "Unknown in detail, 500 to 1200 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable and gradational up into sandstones and mudstones of the Ffestiniog Flags Formation, with change in mudstone colour from pale to dark grey."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/EM> ;
