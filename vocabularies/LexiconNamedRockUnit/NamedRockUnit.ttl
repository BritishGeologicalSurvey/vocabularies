    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
