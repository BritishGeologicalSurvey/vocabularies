namedrockunit:BOHI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Bowland High Group (platform and ramp carbonate facies) comprises the Chatburn Limestone and Clitheroe Limestone formations, located within a restricted area of the Craven Basin. Lateral continuity with the Great Scar Limestone Group of the Askrigg Block cannot be demonstrated, and as a result a distinct group name has been proposed. \r
\r
Pale to dark grey, packstone and wackestone with subordinate grainstones, partings and thin beds of calcareous mudstone and calcareous siltstone. Mudmound reef (Waulsortian) limestones are present in the upper part of the group. \r
\r
The depositional environment of the shallow shelf platform carbonate subfacies is a tropical shallow marine environment. \r
\r
The depositional environment of the ramp carbonate subfacies is on the ramps that generally develop during the early stage of platform carbonate evolution. They represent deposits upon gently inclined shallow marine slopes that may be marginal to platforms. \r
\r
Tournaisian to Chadian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the group has not been proved."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "The Bowland High Group has a minimum thickness of about 2300 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The group is overlain unconformably by the Craven Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carboniferous Limestone [Obsolete: use CL, PKLM, CLWYD, PEMB, BOHI, HOHI, TRLI]"@en ;
    skos:broader namedrockunit:CL ;
    skos:definition "Limestone with subsidiary calcareous mudstone and mudmound limestone and trace calcareous siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Chadian Substage (Carboniferous Period) (359.3-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CHL ,
        namedrockunit:CLL ;
    skos:notation "BOHI"@en ;
    skos:prefLabel "Bowland High Group"@en ;
.

