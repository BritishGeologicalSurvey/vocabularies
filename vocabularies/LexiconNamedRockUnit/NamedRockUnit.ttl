    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LD> ;
    lexicon:hasThicknessDescription "Up to 1 km in width."@en ;
    lexicon:hasUpperBoundaryDefinition "On the eastern boundary, the rocks to the east of the slide zone belong to the Dalradian of the East Mainland succession (Unst and Fetlar Succession).  There is no lithological discordance at the junction, but it is marked by a continuous and rapid increase in the intensity of the schistosity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasYoungestAgeValue 4.869e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Hascosay Slide [Obsolete: use HSZM]"@en ;
    skos:definition "Amphibolite, blastomylonite and mylonite and trace serpentinite. Bedrock. Occurs onshore. Formed during the Cambrian Period (541-486.9 Ma BP)."@en ;
