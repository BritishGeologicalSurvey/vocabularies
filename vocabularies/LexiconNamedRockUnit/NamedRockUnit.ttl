        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Breakish Formation comprises blue-grey micritic limestone and dark calcareous mudstones within the lower half of the unit. The upper half of the unit consists of bioclastic limestones, ooidal limestone and nodular limestones. Ammonites are rare within the succession, but bivalve and gastropod fragments are common. Bioturbation of the sediments is locally intense. Coral beds exist near Broadford."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity - diachronous transgression at start of Jurassic."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1345 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 65 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Abrupt lithology change to sandstone and siltstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blue Lias Formation (Hebrides) and Breakish Formation, Interdigitated"@en ,
        "Broadford Beds Formation [Obsolete: use ADS, BRKH]"@en ,
        "Camas Malag Formation"@en ,
        "Lower Broadford Beds [Obsolete: use BFB, BRKH]"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Limestone and mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Hettangian Age - to - Sinemurian Age (Jurassic Period) (201.4-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LUSA ;
    skos:notation "BRKH"@en ;
    skos:prefLabel "Breakish Formation"@en ;
