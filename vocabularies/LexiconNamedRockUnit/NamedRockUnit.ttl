namedrockunit:KBLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BACOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Microporphyritic mafic basalts, commonly hard, fresh and blue: olivine-microphyric basalt (Dalmeny type) with rare flows of clinopyroxine-olivine-microphyric basalt (Hillhouse type). Around Castle Semple and at Gladstone a few isolated flows of olivine-pyroxene-macrophyric basalt (ankaramitic or Craiglockhart type)."@en ;
    lexicon:hasLowerBoundaryDefinition "A distinct petrographic change from macroporphyric mafic basalts (Dunsapie and Craiglockhart types) of the underlying Marshall Moor Lava Member to the microporphyric mafic basalts (mainly Dalmeny type) of the overlying Kilbarchan Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4724 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 75 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Kilbarchan Lava Member is overlain across an erosional boundary by volcaniclastic sedimentary rocks of the Kirkwood Formation which contain detrital material from the underlying lavas."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kilbarchan Lavas [Obsolete: use KBLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Olivine-microphyric basalt with subsidiary clinopyroxene-olivine-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KBLA"@en ;
    skos:prefLabel "Kilbarchan Lava Member"@en ;
.

namedrockunit:KBN
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, grey-ochreous mostly medium-grained, dune-bedded, cross-stratified with \"pin-stripe\" lamination. Well sorted, non-pebbly, mica very rare."@en ;
    lexicon:hasLowerBoundaryDefinition "Interpreted to be disconformable at the base of the lowest sandstone with aeolian characteristics lying above pebbly, more poorly sorted (water-laid) sandstones/siltstones of Kidderminster Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5137 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c. 15-30m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable at base of lowest siltstone/mudstone of the overlying Maer Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kibblestone Formation [Obsolete: use KBN]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KBN"@en ;
    skos:prefLabel "Kibblestone Member"@en ;
.

namedrockunit:KBSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S797 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and gravel, with cobbles and pebbles predominantly of Permo-Triassic sandstone and Lower Palaeozoic sedimentary and volcanic rocks in a matrix of medium- to coarse-grained sand; typically pale yellow to reddish brown. Greywacke and granitic clasts are common in subordinate amounts. Esker deposits are typically poorly sorted, cobbly and bouldery, well-bedded with high-angle cross-bedding. Some interbeds of coarse sand. Fluted kame and kettle deposits are typically moderately sorted, thickly bedded, cobbly, commonly in upward-fining steeply tabular cross-bedded or trough cross-bedded units. Glaciofluvial Sheet deposits are typically thickly bedded well-sorted gravels, with interbeds of coarse- to medium-grained sand. Commonly horizontally bedded, but tabular high-angle cross-bedded units common. The upper surface is commonly involuted and beds of laminated and rippled sandy silt and clay with dropstone cobbles are present locally, indicating the presence of temporary glacial lakes."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on older glacigenic sediments, such as till of the Gretna Till or Langholm Till formations, or sandy and silty glaciolacustrine deposits of the Cullivait Silt Formation; locally rests directly on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable, typically 3-10m, esker deposits may be > 15m thick, the worked spreads of ice-contact deposits may exceed 10m in thickness locally; kame terrace deposits and sandar are typically 2-8m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Locally overlain by Holocene alluvial and raised marine deposits, and peat. Some exposures in sheet deposits are capped by gravelly friable pale brown to reddish brown diamicton (supraglacial flow till) typically 0.3-0.6m in thickness). Involutions and possible frost-wedge casts are present in the upper parts of terraced and kame-terrace deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Nithsdale Kames"@en ;
    skos:broader namedrockunit:ISCG ;
    skos:definition "Gravel and sand with subsidiary boulders, clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KBSG"@en ;
    skos:prefLabel "Kilblane Sand And Gravel Formation"@en ;
.

namedrockunit:KBSI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded silt, clay and fine-grained sand, yellowish brown to dark grey. Local ferruginous nodules. Glaciolacustrine. Very locally interbedded with, or overlain by, thin diamicton (Carnhash Till Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "Lies on bedrock (Middle Old Red Sandstone) or older Quaternary deposits (Crovie Till Formation or Whitehills Glacigenic Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H338 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface, or overlain by younger deposits of Holocene/Flandrian age (peat, alluvium, etc)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Coastal deposits of Banffshire [Obsolete: use KBSI]"@en ;
    skos:broader namedrockunit:BCD ;
    skos:definition "Clay, sand and silt and trace diamicton and gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KBSI"@en ;
    skos:prefLabel "Kirk Burn Silt Formation"@en ;
