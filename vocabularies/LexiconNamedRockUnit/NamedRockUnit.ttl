namedrockunit:HURC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A bright banded coal, containing vitrinite with some inertinite (including fusinite = mineral charcoal); commonly recorded as pyritous and dirty but with good coking properties."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally identified by a grey, rooted seatearth or seatclay just above the non-marine Baldernock Limestone, almost at the top of the Lawmuir Formation in the Glasgow area, or almost at the top of the West Lothian Oil-shale Formation in West Lothian (no Baldernock Limestone). Considered as a conformable contact and defined as the lithological change from the underlying strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Varies from a few centimetres, to 2.4m (south of Blackburn in West Lothian) to 1.32m in the Milngavie No.1 Borehole [BGS Registered No.NS57SE/39, NGR NS 5501 7335] in the Glasgow district. Known to be 1.6m thick in the Bathgate area of West Lothian, encountered at a depth of 152.3m in Murrayfield No.1 Borehole, BGS Registered No.NS96NE/276, NGR NS 9875 6554."@en ;
    lexicon:hasUpperBoundaryDefinition "Usually seen as a change to mudstone, locally Lingula-bearing or marine, underlying the Hurlet Limestone, that forms the base of the Lower Limestone Formation. Noteworthy, is the presence in some areas (eg Lennoxtown northeast of Glasgow) of the marine Alum Shale bed (1-2m thick) in this interval. Considered as a conformable contact and defined as the lithological change to the overlying strata."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        namedrockunit:LWM ,
        namedrockunit:WLO ;
    skos:definition "Coal with subsidiary seat-earth sandstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HURC"@en ;
    skos:prefLabel "Hurlet Coal"@en ;
.

