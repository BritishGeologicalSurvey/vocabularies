    lexicon:hasThicknessDescription "Highly variable. 1 - 45 m recorded."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally not preserved, but where present it is an unconformity upon which rests Quaternary till (boulder clay)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/N> ;
    lexicon:hasYoungestAgeValue 2.58e+00 ;
