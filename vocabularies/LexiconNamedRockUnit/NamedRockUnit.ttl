        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MFTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey or black graptolitic mudstones interbedded with felsic acid and mafic tuffs and tuffites in places; sandstones and conglomerates occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies the felsic tuffs and tuffites of the Offrwm Volcanic Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1346 ,
        namedrockunit:H2721 ,
        namedrockunit:H3325 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 350m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by the felsic tuffs and conglomerate of the Brithion Formation in the north of the Cadair Idris district, and by pillowed basaltic lavas and mafic tuffs of the Llyn y Gafr Volcanic Formation elsewhere within the district."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasYoungestAgeValue 4.6125e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bifidus Slates [Obsolete: use CREN, BFDS]"@en ,
        "Crogenen Slates [Obsolete: use CREN]"@en ,
        "Moelyn Slates [Obsolete: use CREN]"@en ;
    skos:broader namedrockunit:AVG ;
    skos:definition "Mudstone with subsidiary felsic tuff, mafic tuff and tuffite and trace conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage (Ordovician Period) (468-461.25 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BYN ,
        namedrockunit:CFH ;
    skos:notation "CREN"@en ;
    skos:prefLabel "Cregennen Formation"@en ;
