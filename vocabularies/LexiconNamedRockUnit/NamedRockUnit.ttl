    lexicon:hasThicknessDescription "About 500 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "In stratigraphical contact with the Glen Rushen Formation, which is marked by a change from amudstone/sandstone facies to a mudstone-dominated facies."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Maughold Banded Group and Sulby Slump Breccia [Obsolete: use IBK]"@en ;
    skos:broader namedrockunit:MANX ;
    skos:definition "Mudstone with subsidiary pebbly (gravelly) sandstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arenig Series (Ordovician Period) (477.1-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IBK"@en ;
    skos:prefLabel "Injebreck Formation"@en ;
