    lexicon:hasLithologyDescription "Stratified, unconsolidated, fine- to medium-grained, quartz sand with shell debris."@en ;
    lexicon:hasLowerBoundaryDefinition "Commonly unconformable on Flandrian or Late Devensian superficial deposits. In the type area it overlies Flandrian storm beach gravels in the west and peat in the east; locally, it overlies bedrock (Godwin, 1943)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BSA ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Exceptionally to 10.5m in the type area, but generally less and in accordance with the topographic expression of dune forms (Cave and Hains, 1986)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but locally, contact with overlying Flandrian deposits. In the type area the formation is locally overlain by Tidal Flat Deposits (British Coastal Deposits Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
