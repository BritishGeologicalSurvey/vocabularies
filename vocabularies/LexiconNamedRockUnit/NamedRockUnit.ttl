namedrockunit:SOCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Somerset Catchment Subgroup encompasses all the fluvial, lacustrine and organic deposits of the rivers whose catchments fall between the Mendip, Quantock and Blackdown hills. The deposits comprise gravels, sands, silts, clays and peats. Floodplain alluvium comprises soft silts and clays, commonly with beds of peat and a basal bed of sand and gravel. River terrace deposits are largely sands and gravels. The gravels are composed of locally-derived rocks, variously Devonian sandstones, Carbonifeous sandstones and limestones, Triassic sandstones, Jurassic limestones and Cretaceous chert and flint. Minor marine deposits may be included where they are intercalated in dominantly fluvial formations. \r
\r
Anglian to Holocene (MIS 12 - 1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Formations of the Somerset Catchments Subgroup rest unconformably on bedrock varying in age from Devonian to Cretaceous."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "About 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface, or locally overlain by clays, silts and peats of the Somerset Levels Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel, sand and silt with subsidiary clay and peat and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:PARRV ;
    skos:notation "SOCA"@en ;
    skos:prefLabel "Somerset Catchments Subgroup"@en ;
.

