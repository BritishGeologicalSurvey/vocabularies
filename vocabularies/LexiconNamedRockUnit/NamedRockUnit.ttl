    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Tarporley Siltstone Formation"@en ,
        "Waterstones [Obsolete: use DST, HEY, SGBK, TPSF]"@en ;
    skos:definition "Obsolete name. Mudstone, sandstone and siltstone and trace halite. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age (Triassic Period) (246.7-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DST"@en ;
    skos:prefLabel "Denstone Formation [Obsolete: use TPSF]"@en ;
