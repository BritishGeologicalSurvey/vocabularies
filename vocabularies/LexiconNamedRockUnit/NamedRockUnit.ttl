    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coal, although where the deposit splits into two seams, it is separated into two by by a band of seatearth around Old Mills Colliery [364500, 155500], whereas further away from the divide this, becomes 12 m of hard mudstone and fireclay, near Greyfield Colliery [364000, 158700]."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the bed is taken at the base of the coal resting upon about 9 m of hard mudstone of the underlying undivided Farrington Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1056 ,
        namedrockunit:H3549 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "A thin coal, about 46 cm thick at Dunkerton in the northeast of the Somerset Coalfield, to 71 cm thick at Farrington in the southwest of the coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the coal is overlain by sandstone, which forms a hard roof, of the Middle Vein Greys. Elsewhere a planty shale developed between the coal and the sandstone of the surrounding Farrington Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bromley No. 4"@en ,
        "Middle Coal (Somerset) [Obsolete: use MLEC, MDDC]"@en ,
        "Middle Vein [Obsolete: use MLEC, MDDC]"@en ,
        "No.5 Vein [Obsolete: use NO5C]"@en ,
        "Smith's Vein"@en ;
    skos:broader namedrockunit:FRF ;
    skos:definition "Mudstone and seat-earth mudstone with subsidiary coal. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage (Carboniferous Period) (310-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MLEC"@en ;
    skos:prefLabel "Middle Coal (Farrington Member, Somerset)"@en ;
.

namedrockunit:MORA
    a skos:Concept ;
    lexicon:hasLithologyDescription "The Moray Group is characterized by grey to grey-brown, carbonaceous, pyritic mudstones and siltstones that contrast with the greenish mudstones of the overlying Stronsay Group and the underlying Montrose Group. The group is also characterized by a relatively sharp transition between a 'shelf' succession dominated by sandstone and siltstone, with subordinate lignite, and a 'basinal' succession dominated by mudstone. The shelf succession is assigned to the Dornoch Formation and the basinal succession to the Sele Formation and the Balder Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Moray Group is marked by a downward change from grey to grey-brown, carbonaceous, pyritic mudstones and siltstones to greenish mudstones of the Montrose Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "The Moray Group reaches thicknesses of over 500 m in Outer Moray Firth Basin thinning to less than 30 m in the southern Central North Sea."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Moray Group is marked by a downward change from greenish mudstones of the Stronsay Group to grey to grey-brown, carbonaceous pyritic mudstones and siltstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasYoungestAgeValue 3.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Stratified bedrock. Occurs offshore. Deposited during the Paleocene Epoch - to - Eocene Epoch (Palaeogene Period) (66-33.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BALD ,
        namedrockunit:DORN ,
        namedrockunit:FLET ,
        namedrockunit:LMBT ,
        namedrockunit:SELE ;
    skos:notation "MORA"@en ;
    skos:prefLabel "Moray Group"@en ;
.

namedrockunit:MULG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mudstone, dark grey, bituminous and pyritic, with common layers of grey calcareous concretions, ovoid and spherical and ranging up to 4.5 m in diameter, particularly in the lower third (the Jet Rock) which also hosts the horizon bearing the black, highly compressed fossil wood (jet); similar concretions are also present at the top of the upper third (Bituminous Shales); fossils including ammonites and belemnites common throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable: base of bituminous mudstone with large concretions resting upon non-bituminous shaly mudstone (Grey Shale Member). Bed 33 on Bed 32 at Hawsker Bottoms and Port Mulgrave (bed numbers of Howarth, 1955)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1713 ,
        namedrockunit:H2331 ,
        namedrockunit:H336 ,
        namedrockunit:H4209 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "31m thick on the Yorkshire coast, thins west and south to between 23 and 25m (Brown Moor and Felixkirk boreholes)(Gaunt et al., 1980; Powell et al., 1992)."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable: base of non-bituminous grey shaly mudstone (Alum Shale Member) resting upon dark grey bituminous mudstone with a double layer of sideritic concretions (Ovatum Bed). Bed 49 on Bed 48 at Hawsker Bottoms and Whitby (bed numbers of Howarth, 1955)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Jet Rock Formation [Obsolete: use MULG]"@en ,
        "Jet Rock Member [Obsolete: use MULG, JRB]"@en ,
        "Jet Rock Series [Obsolete: use MULG]"@en ,
        "Jet Rock plus Bituminous Shales [Obsolete: use MULG]"@en ;
    skos:broader namedrockunit:WHM ;
    skos:definition "Bituminous mudstone and mudstone with subsidiary carbonaceous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:JRB ;
    skos:notation "MULG"@en ;
    skos:prefLabel "Mulgrave Shale Member"@en ;
.

namedrockunit:NEATH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unconsolidated, stratified gravels, sands, silts and clays forming the alluvial deposits of the River Neath (Afon Nedd) and its tributaries. Includes contemporaneous head, colluvium and pedogenic deposits within the catchment area. Clasts consist exclusively of Old Red Sandstone and Carboniferous limestone, sandstone and coal sourced either directly from the bedrock or via the reworking of Late Devensian glacigenic deposits (e.g. Brecknockshire Formation). Aggradational river terraces and major alluvial fans are dominated by pebble cobble gravels and medium- to coarse-grained sand (Strahan et al., 1932); the modern floodplain is dominated by silt and clay, or poorly sorted gravel (Barclay et al., 1988, p.39). Locally the deposits include lenses of peat."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable and locally channelised, predominantly on bedrock and Late Devensian head and glacigenic deposits (e.g. Brecknockshire Formation). Interdigitates in a complex manner with Tidal Flat Deposits (Gwynllwg Formation of Bowen, 1999) in the estuary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALF ,
        namedrockunit:ALV ,
        namedrockunit:HEAD ,
        namedrockunit:LDE ,
        namedrockunit:RTD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally to around 10m; 6m of (fluvial) gravel over 15m (?glaciofluvial) sand were recorded in a borehole near Resolven at [SN 8346 0313] (Strahan et al., 1932)."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the present ground surface or, locally, overlain by peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alluvial fan deposits"@en ,
        "Alluvium"@en ,
        "Head"@en ,
        "Lacustrine deposits"@en ,
        "River terrace deposits"@en ;
    skos:broader namedrockunit:WWACA ;
    skos:definition "Clay, gravel, sand and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "NEATH"@en ;
    skos:prefLabel "Neath Valley Formation"@en ;
.

namedrockunit:NEDP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GREIS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Includes all granite plutonic intrusions of Early Devonian age in Northern England, including the exposed Shap Pluton (SHAP), the Skiddaw Pluton (SKID) and the concealed Weardale and Crummock Water intrusions. The Shap Pluton is the type pluton for this Suite. \r
\r
This unit and the Galloway Subsuite (GALGR) encompass intrusions that occur to the south and north respectively of the Iapetus Suture trace."""@en ;
    lexicon:hasLowerBoundaryDefinition "Not defined."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/S> ;
    lexicon:hasUpperBoundaryDefinition "Not defined."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CIGSS ;
    skos:definition "Granite with subsidiary greisen. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CRWA ,
        namedrockunit:SHAP ,
        namedrockunit:SKID ,
        namedrockunit:WENG ,
        namedrockunit:WRDG ;
    skos:notation "NEDP"@en ;
    skos:prefLabel "Northern England Devonian Plutonic Suite"@en ;
.

