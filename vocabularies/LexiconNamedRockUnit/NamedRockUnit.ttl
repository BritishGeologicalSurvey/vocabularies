namedrockunit:KSDSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold-phase sands and gravels representing the youngest deposits of the Proto-Trent, and the pre-Flandrian deposits of the Witham. The former are typically dominated by rounded pebbles of "Bunter" quartz/quartzite with subordinate subangular flint, etc. but the latter have a greater proportion of flint and local Jurassic limestone, etc. Surface c. 1 to 2 m above the Trent floodplain, at Spalford, and typically 3 to 6 m below Witham floodplain level in the Type Area. West of the Lincoln Gap, correlated with the Holme Pierrepont Member (Trent Valley Formation); whilst east of Lincoln Gap also includes older materials correlated with the Scarle and Fulbeck Sand and Gravel members (Trent Valley Formation) and Castle Sand and Gravel Member (Bain Valley Formation). \r
\r
Upper Pleistocene (MI Stage 2 west of the Lincoln Gap, or 5e to 2 east of the Lincoln Gap). The chronology is based on the assumption that west of the Lincoln Gap (where Scarle Sand and Gravel can be separated) it is broadly correlative with the Holme Pierrepont of the Trent, whereas east of the Gap it includes everything that is Ipswichian or later, thus including correlatives of the Scarle Sand and Gravel, as in the Castle Sand and Gravel Member of the Bain."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock or Wragby Till Member (Lowestoft Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2885 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 8.5 m; typically 4 to 5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or base of alluvium or blown sand (Spalford Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kirkstead Member [Obsolete: use KSDSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KSDSG"@en ;
    skos:prefLabel "Kirkstead Sand and Gravel Member"@en ;
.

