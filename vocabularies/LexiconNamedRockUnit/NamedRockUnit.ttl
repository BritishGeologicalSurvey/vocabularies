namedrockunit:DARW
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:AMND ,
        namedrockunit:BURT ,
        namedrockunit:DUNL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lenticular bedded, grey siltstones and fine-grained sandstones, heavily bioturbated locally to produce structureless sandy siltstones. Very fine- to coarse-grained sandstones occur in thin (c. 0.6 m), sharp based beds. Thicker (c. 1.3 m) well laminated, rippled and occasionally bioturbated, very fine-grained sandstones also occur. Sandstones are most common in the middle part of the formation. The heterolithic nature of the formation results in an erratic gamma-ray profile."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by a downwards passage from siltstones (Darwin Formation) to sandstones (Nansen Formation) and a marked decrease in gamma values."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5183 ,
        namedrockunit:H5184 ,
        namedrockunit:H5185 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 to 80 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is defined by a downward passage from interbedded sandstones, siltstones and coals (Pentland Formation) to siltstones. The boundary coincides with a marked increase in gamma values."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Amundsen Formation"@en ,
        "Burton Formation"@en ,
        "Dunlin Group"@en ,
        "Lower Beryl Floating Sand Grain Unit [Obsolete: use DARW]"@en ,
        "Lower Beryl Shale [Obsolete: use DARW]"@en ,
        "Upper Formation [Obsolete: use DARW]"@en ;
    skos:broader namedrockunit:DUNL ;
    skos:definition "Sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Pliensbachian Age - to - Toarcian Age (Jurassic Period) (192.9-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DARW"@en ;
    skos:prefLabel "Darwin Formation"@en ;
