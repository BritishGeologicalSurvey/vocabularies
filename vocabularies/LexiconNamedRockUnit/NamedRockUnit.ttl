    lexicon:hasLithologyDescription "Psammite; semipelite, locally pyritic; minor metaconglomerate."@en ;
    lexicon:hasLowerBoundaryDefinition "Overlying Eastern Gneisses (EGNS) (equivalent of Lewisian Gneiss), presumbaly via a highly sheared unconformity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
