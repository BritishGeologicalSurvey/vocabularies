namedrockunit:KTLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TFSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Kettla Formation consists primarily of dark grey-green tuffaceous siltstone grading to silty tuffite, which occurs as two units separated by a thin unit of mudstone. No cores are available and the precise nature of the tuffaceous material has not been established. The tuffaceous lithologies display characteristic low-gamma, high-velocity, high-density and high-resistivity wireline-log signatures."@en ;
