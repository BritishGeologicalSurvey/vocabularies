namedrockunit:RECF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lower and upper units of thick-bedded fine-grained sandstone and argillaceous sandstone (respectively the Nothe Grit and Bencliffe members), locally with large calcareous concretions, separated by an interval of mudstone and sandy mudstone with interbedded limestones (Nothe Clay Member). Pervasive bioturbation is evident in the Nothe Grit, and conspicuous cross stratification in the Bencliff Grit. There are common shelly and bioclastic-rich intervals, comprising particularly bivalves and ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "Base is a sharp, probably non-sequential, boundary with the underlying Oxford Clay Formation. This is marked by the upward change from the mudstone of the Oxford Clay to the sandstone of the Nothe Grit Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1139 ,
        namedrockunit:NTH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "29.2m at Osmington, about 28m at Sandsfoot."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is a sharp, planar, burrowed erosion surface at the top of the sandstone of the Bencliff Grit Member, which marks the upward change to thin argillaceous limestones and mudstones of the basal Osmington Oolite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Calcareous Grit and Berkshire Oolite Series [Obsolete: use RECF]"@en ,
        "Nothe Formation [Obsolete: use NGT, RECF]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Muddy sandstone, mudstone and sandstone with subsidiary calcareous sandstone and limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BFG ,
        namedrockunit:NGT ,
        namedrockunit:NOC ;
    skos:notation "RECF"@en ;
    skos:prefLabel "Redcliff Formation"@en ;
.

