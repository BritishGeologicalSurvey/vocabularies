namedrockunit:GRIS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Consists of thinly or thickly bedded, fine to medium grained, locally coarse-grained sandstone, interbedded with mudstone, grey to green-grey and variably silty. The sandstone commonly includes minor amounts of glauconite, and is locally shelly. Wireline-log signatures are mostly of 'blocky' character (e.g. 3/8-2, 16/17-8A, 22/1 a-3), but one or more upward-coarsening sandstone units are present in sandstones at the top of the Horda Formation in some well sections (e.g. 15/26a-3)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Grid Sandstone Member is drawn at the base of the lowest significant sandstone unit. Very thin sandstone units isolated by thick mudstones are excluded (e.g. 15/26a-3). Where thicker sandstone units are separated by a substantial thickness of mudstone, they are treated as upper and lower 'leafs' of the Grid Sandstone Member (e.g. 15/28a-3). The sandstone is normally underlain by green-grey or grey-green mudstone, but where the sandstone is limited to the uppermost part of the Horda Formation, grey, silty mudstone may occur immediately beneath. The base of the Grid Sandstone Member normally falls within, or at the base of, Horda unit 2, above the regionally recognizable gamma-ray marker."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEM> ;
    lexicon:hasOldestAgeValue 4.81e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickness of the Grid Sandstone Member is extremely variable, but is greatest in the South Viking Graben. The maximum thickness is over 300 m, although total sand thickness rarely exceeds 100 m, with individual units rarely exceeding 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Where the sandstone is restricted to the middle or lower part of the Horda Formation, the top is marked by a downward change from green-grey, variably silty, mudstone to sandstone. Where the sandstone extends into the upper part of the Horda Formation, it is commonly overlain directly by high-gamma, grey-brown, commonly glauconitic, mudstone or siltstone of the basal Lark Formation (e.g. 15/26a-3). In distal sections, however, there is a thin unit of grey to brown-grey, silty Horda mudstone between the Grid Sandstone Member and the basal mudstone of the Lark Formation (e.g. 3/8-2). Elsewhere, an alternation of mudstone and sandstone occurs above the main development of the Grid Sandstone Member (e.g. 16/17-8A)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GOE> ;
    lexicon:hasYoungestAgeValue 2.73e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HORD ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Mid Eocene - to - Early Oligocene (Palaeogene Period) (48.1-27.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BESA ,
        namedrockunit:CNSA ;
    skos:notation "GRIS"@en ;
    skos:prefLabel "Grid Sandstone Member"@en ;
.

namedrockunit:GRPE
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FESTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstone, yellow-grey siltstone and yellow-weathering, fine- to coarse-grained sandstone (fluvial, fluvio-deltaic and paralic lithofacies). Sandstones are commonly cross-bedded with sharp erosional bases and channel-fill bedforms. Thin coal seams, seatearth mudstone and nodular sideritic ironstone beds are present locally. Plant fragments and plant rootlets are common in some beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable, or disconformable, and taken at the abrupt transition from marine strata (Lebberston Member) comprising pale grey, shelly ooidal cross-bedded limestone (\"Whitwell Oolite\" facies; Howardian Hills [SE 72 65]) or yellow, shelly calcareous cross-bedded sandstone with bivalves (\"Millepore Bed\" facies; Yons Nab [TA 084 844], south of Scarborough) to sandstone, siltstone and mudstone with plant remains (Gristhorpe Member)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3938 ,
        namedrockunit:H3939 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 30m on the North Yorkshire coast; thins to the southwest to about 20m in the Hambleton Hills and about 10m in the Howardian Hills."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable, or disconformable, and taken at the abrupt upward transition from plant debris-rich, mudstone with plant rootlets, or cross-bedded sandstone of the upper part of the Gristhorpe Member (Cloughton Formation) to well laminated calcareous mudstone, or grey argillaceous limestone of the Scarborough Formation (Bate, 1965, p.83; Parsons, 1977; Gowland and Riding, 1991; Powell et al., 1992)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Deltaic Series [Obsolete: use CLH, GRPE]"@en ,
        "Middle Estuarine Series [Obsolete: use GRPE]"@en ;
    skos:broader namedrockunit:CLH ;
    skos:definition "Mudstone, sandstone and siltstone and trace coal, nodular ironstone and seat-earth mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GRPE"@en ;
    skos:prefLabel "Gristhorpe Member"@en ;
.

namedrockunit:GSD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dacite, interpreted to be a lava dome with associated coulee-type flow, partly intrusive and partly extrusive, interbedded with lapilli-tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "Irregular contact with lower ignimbrite sheet of the Lincomb Tarns Tuff Formation, which discordant relationship suggests that the lower parts of the dacite are intrusive. Elsewhere the dacite overlies the ignimbrite, but is obscured in places by later syn-BVG andesite intrusions."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2218 ,
        namedrockunit:H943 ;
