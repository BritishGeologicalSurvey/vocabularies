namedrockunit:DELA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone and pebbly sandstone with subordinate mudstone beds. Reddish-orange and pale yellow. Planar and trough cross-bedded or massive. Common intraformational pebbles of sandstone and mudstone and extraformational quartz, up to 2.5cm. The Member is more strongly cemented than those immediately above and below, and is therefore commonly more resistant and consequentially commonly feature-forming."@en ;
    lexicon:hasLowerBoundaryDefinition "Lowermost occurrence of dominantly pebbly sandstone overlying pebble-free weakly cemented sandstone of the Wilmslow Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "40m (Helsby area); c.90m (north Wirral)."@en ;
    lexicon:hasUpperBoundaryDefinition "Uppermost occurrence of pebbly sandstone under weakly cemented pebble-free sandstone of the Frodsham Soft Sandstone Member (Helsby Sandstone Formation), or under interbedded siltstone and sandstone of the Tarporley Siltstone Formation (Mercia Mudstone Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Mudstone, pebbly (gravelly) sandstone and sandstone with subsidiary quartzite. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DELA"@en ;
    skos:prefLabel "Delamere Sandstone Member"@en ;
.

