    lexicon:hasThicknessDescription "Maximum thickness 250 metres approximately."@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage of the Woodhouselee Group from trachytes, andesites and silicified acid rocks to basalts and basic andesite of the Carwethy and Hill End Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:WDH ;
