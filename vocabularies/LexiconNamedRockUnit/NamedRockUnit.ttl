namedrockunit:TSDC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red or reddish brown pebbly sandy silty clay containing well dispersed pebbles mainly of limestone and dolostone of the Zechstein Group (formerly Magnesian Limestone), with some Carboniferous lithologies (sandstone, mudstone, limestone, coal), typically overlying thinly laminated silts and clays, or locally overlying sand. Varves in these laminated clays have been tentatively \"wriggle-matched\" with the late glacial Greenland ice core record, and dated very approximately by thermoluminescence to 18,365 cal ka BP."@en ;
    lexicon:hasLowerBoundaryDefinition "Uneven, conformable, draped contact with underlying dark brown, stony silty sandy clay diamicton of the Blackhall Till Formation (possibly of the Horden Till Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3096 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 9.1m"@en ;
    lexicon:hasUpperBoundaryDefinition "Unevem, erosional contact with overlying alluvial or estuarine sands, silts and clays."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tees Laminated Clays [Obsolete: use TSDC]"@en ;
    skos:broader namedrockunit:NSG ;
    skos:definition "Clay with subsidiary silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TSDC"@en ;
    skos:prefLabel "Teesside Clay Formation"@en ;
.

