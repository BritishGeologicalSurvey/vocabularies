namedrockunit:ITCH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Floodplain alluvium and river terrace deposits. The floodplain alluvium comprises overbank deposits of brown organic silty clay, together with peaty clay and peat, overlying sand and gravel. Tufa occurs as 1 to 2m-high raised hummocky spreads. The surviving river terrace deposits comprise sand and gravel, planar bedded or cross-bedded, locally overlain by overbank deposits of clayey and sandy silts and silty clays. These fine-grained deposits may be partly aeolian in origin. The major gravel lithology is flint, dominantly sub-rounded to sub-angular and a little well-rounded, and subordinate quartz, ironstone and \"sarson\". The sand fraction is composed of fine- to coarse-grained well-rounded quartz grains, with subangular flint in the coarse fraction. The older, higher terraces are commonly cryoturbated."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on Palaeogene and Cretaceous bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.12m"@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SNTCA ;
    skos:definition "Clay, gravel, sand and silt with subsidiary peat and tufa. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Holocene Epoch (Quaternary Period) (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ITCH"@en ;
    skos:prefLabel "Itchen Formation"@en ;
.

