        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBAND"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basaltic trachyandesite with rhyolitic tuff."@en ;
    lexicon:hasLowerBoundaryDefinition "Lies conformably on sandstones and siltstones, plus tuffs of the Cwm Eigiau Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
