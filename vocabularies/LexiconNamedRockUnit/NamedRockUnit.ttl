namedrockunit:EN
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:BWH ,
        namedrockunit:CACG ,
        namedrockunit:EB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red mudstone and red-brown, fine- to coarse-grained sandstone, locally pebbly, and lenticular beds of conglomerate. Sandstone mostly sublitharenite; conglomerate clasts mostly Carboniferous limestone and chert."@en ;
    lexicon:hasLowerBoundaryDefinition "Poorly defined; taken arbitrarily at base of sandstone dominated succession that overlies the Alveley Member and is characterised by conglomerates and pebbly sandstones with extra-basinal clasts, commonly of Carboniferous limestone and chert."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BWH ,
        namedrockunit:CACG ,
        namedrockunit:EB ,
        namedrockunit:H2164 ,
        namedrockunit:HSB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "100-275m in West Midlands."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable/disconformable; sharp junctions with overlying Clent Formation (breccia) in the Clent Hills; gradational boundary with mudstone dominated Clent Formation; or taken at the base of red mudstone/sandstone with Uriconian volcanic clasts in Gospel End area (West Midlands)"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
