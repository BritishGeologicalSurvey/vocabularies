    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 300 m (estimate; unit is strongly deformed) thinner to SW and NE."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Crom Psammite Formation at its western maargin, where predominantly pelitic lithiloigies pass gradationally into predominantly psammitic lithologies."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
