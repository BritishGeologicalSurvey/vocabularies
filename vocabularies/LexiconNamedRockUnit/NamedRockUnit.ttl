namedrockunit:DTG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use FWW] \r
Red mudstones, red-brown, purple and green sandstones and fish-bearing intraformational conglomerates; some mature soil carbonate horizons, in addition to numerous calcrete glaebule horizons. The lithologies are commonly arranged in fining-upwards cycles."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at top of the Bishop's Frome (Psammosteus) Limestone Member at the top of the Raglan Mudstone Formation, where overlain by red mudstone of the St Maughans Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5136 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 600 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper  boundary is placed at the base of Brownstones Formation and (locally) Senni Formation, where sandstone-dominated sequences begin. The upper boundary is locally placed at top of the Upper Abdon Limestone Member in the Clee Hills."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:FWW ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Ditton Group [Obsolete: use DTG]"@en ,
        "Freshwater West Formation"@en ;
    skos:definition "Obsolete name. Conglomerate, mudstone and sandstone with subsidiary calcrete. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age - to - Pragian Age (Devonian Period) (419-410.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DTG"@en ;
    skos:prefLabel "Ditton Subgroup [Obsolete: use FWW]"@en ;
.

