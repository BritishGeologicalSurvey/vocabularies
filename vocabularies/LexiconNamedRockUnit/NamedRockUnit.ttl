namedrockunit:GOIN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:TRGO ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VQ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The intrusion is composed of two distinct types of granite: biotite-granite and Lithium-mica granite. Biotite granite of the Godolphin intrusion has rare megacrysts of potassium feldspar up to 20 mm long. Lithium-mica granite has a coarse, hypidiomorphic texture and is predominately composed of anhedral quartz, potassium feldspar, plagioclase and lithium mica (pale brown in colour) with accessory minerals including topaz, black tourmaline and fluorite. The biotite granite is seen as veins within the coarser lithium-mica granite; in a quarry at Tregonning Hill [SX 5998 3006] an inclusion of biotite granite is seen within lithium-mica granite."@en ;
    lexicon:hasLowerBoundaryDefinition "Not known."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasOldestAgeValue 3.075e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "Not known."@en ;
    lexicon:hasUpperBoundaryDefinition "Not known."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CS> ;
    lexicon:hasYoungestAgeValue 3.005e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tregonning-Godolphin Granite"@en ;
    skos:definition "Granite and trace quartz (vein). Igneous intrusive bedrock. Occurs onshore. Emplaced during the Stephanian Stage (Carboniferous Period) (307.5-300.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "GOIN"@en ;
    skos:prefLabel "Godolphin Intrusion"@en ;
.

