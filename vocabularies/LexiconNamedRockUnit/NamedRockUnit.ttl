    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "30-85m (in south Nottinghamshire and Lincolnshire), 43m in Cropwell Bridge borehole (SK63NE/28)."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational; taken at top of highest significant sandstone bed within gradual upward passage into thinly laminated beds of the Radcliffe Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
