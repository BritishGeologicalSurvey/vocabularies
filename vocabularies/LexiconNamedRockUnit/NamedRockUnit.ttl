    lexicon:hasLithologyDescription "Grey shale (marine fossils), limestone, sandstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Rapid change from massive red and white sandstones of Ballyvoy Sandstone Formation to grey shale of the member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4177 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
