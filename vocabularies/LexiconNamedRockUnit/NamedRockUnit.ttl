    skos:definition "Mudstone with subsidiary sandstone and trace conglomerate, metamudstone, metasandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Arnsbergian Substage (Carboniferous Period) (359.3-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SME"@en ;
    skos:prefLabel "St Mellion Formation"@en ;
.

namedrockunit:SOYSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold-phase sands and gravels that underlie the Southrey Terrace. At surface, dominated by rounded pebbles of \"Bunter\" quartz/quartzite (c. 60%) with subordinate subangular flint, etc. (c. 40%). Terrace surface highly dissected but rises to c. 6 to 7 m above the Witham floodplain in the Type Area. Associated silts yielding a temperate flora and fauna occur at at least two sites; these might occur at the base of the unit but relationships are uncertain. Correlated with the Balderton Sand and Gravel Member (Trent Valley Formation, west of the Lincoln Gap) and the Egginton Sand and Gravel Member (Trent Valley Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Anglian Wragby Till (Lowestoft Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H110 ,
        namedrockunit:H1837 ,
        namedrockunit:H4337 ,
        namedrockunit:ORSG ,
        namedrockunit:RTD ,
        namedrockunit:RTSG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Older river sand and gravel"@en ,
        "River terrace deposits"@en ,
        "River terrace sand and gravel"@en ,
        "Southrey Member [Obsolete: use SOYSG]"@en ,
        "Southrey Terrace Deposits [Obsolete: use THSG, CASSG, SOYSG]"@en ,
        "Upper River Terrace [Obsolete: use SOYSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SOYSG"@en ;
    skos:prefLabel "Southrey Sand and Gravel Member"@en ;
