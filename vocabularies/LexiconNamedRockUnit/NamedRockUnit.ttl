        namedrockunit:HOHI ,
        namedrockunit:PEMB ,
        namedrockunit:PKLM ,
        namedrockunit:RVGS ,
        namedrockunit:TRLI ,
        namedrockunit:ZELD ;
    skos:notation "CL"@en ;
    skos:prefLabel "Carboniferous Limestone Supergroup"@en ;
