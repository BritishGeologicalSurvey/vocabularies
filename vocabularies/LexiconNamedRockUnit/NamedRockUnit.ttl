namedrockunit:SCHE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Scolt Head Formation consists of mudstones with interbedded anhydrite. Stringers of sandstone are locally present. The mudstones and siltstones are commonly dolomitic and anhydritic and usually red-brown, but locally grey or mottled with grey and pale green. They vary from soft to firm, laminated and subfissile to amorphous and waxy. The anhydrite beds vary from soft, white and amorphous to pale grey, microcrystalline or sucrosic."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Scolt Head Formation is characterized by a downward change from red-brown mudstones to buff dolomite of the Plattendolomit Formation. It normally corresponds to a downward decrease in gamma values and an increase in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUG> ;
    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Scolt Head Formation attains a thickness of about 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Scolt Head Formation is normally characterized by a downward change from red-brown mudstones, siltstones and sandstones of the Bunter Shale Formation to white and pale grey anhydrite. It coincides with a sharp downward decrease in gamma ray values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:ZG ;
    skos:definition "Anhydrite-stone and mudstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Guadalupian Epoch - to - Lopingian Epoch (Permian Period) (274.4-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCHE"@en ;
    skos:prefLabel "Scolt Head Formation"@en ;
.

