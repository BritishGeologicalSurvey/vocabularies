    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/DY> ;
    lexicon:hasThicknessDescription "The dyke is generally 22 - 28 m. wide and 430 km. in mapped extent. [Macdonald, et al. 1988]."@en ;
    lexicon:hasUpperBoundaryDefinition "Not applicable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
