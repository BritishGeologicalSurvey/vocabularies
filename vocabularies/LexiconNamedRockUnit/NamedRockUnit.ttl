    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Formation comprises a rhythmic succession of thinly interbedded, fine-grained sands, ferruginous sandstones, silts and clays. The Formation varies laterally from ferruginous fine-grained sands and sandstones around Dersingham and Roydon Common, to silts in the Hunstanton Borehole. Clay (Snettisham Clay Member) is present at the top of the Formation, such as in the Hunstanton Borehole, at Dersingham and at Snettisham. It passes laterally into the Tealby Formation under The Wash."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is marked by an upward change from unconsolidated, fine- to medium-grained, cross-bedded, generally clean, pale quartz sands of the Leziate Member of the Sandringham Sands Formation into the ferruginous, fine-grained sandstone of the formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DESC ,
        namedrockunit:H3355 ,
        namedrockunit:SNDS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KH> ;
    lexicon:hasOldestAgeValue 1.326e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.16m."@en ;
    lexicon:hasUpperBoundaryDefinition "Around Dersingham and Snettisham, mudstone of the Snettisham Clay Member (Dersingham Formation) is overlain by ferruginous, generally pebbly, medium-grained sand, of the Carstone Formation (locally clayey at the base). At Hunstanton, silty, pebbly clays at the base of the Roach Formation overlie and are separated by an interburrowed erosion surface from a rhythmic succession of brown and red clay and clayey silt of the Dersingham Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KB> ;
    lexicon:hasYoungestAgeValue 1.214e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dersingham Beds [Obsolete: use DEB]"@en ,
        "Dersingham Beds/Snettisham Clay [Obsolete: use DEB, SNC]"@en ,
        "Sandringham Sands [Obsolete: use DEB, SAS]"@en ;
    skos:definition "Ferruginous sandstone, mudstone, sand and sandstone and trace clay. Stratified bedrock. Occurs onshore. Deposited during the Hauterivian Age - to - Barremian Age (Cretaceous Period) (132.6-121.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:SNC ;
    skos:notation "DEB"@en ;
    skos:prefLabel "Dersingham Formation"@en ;
.

