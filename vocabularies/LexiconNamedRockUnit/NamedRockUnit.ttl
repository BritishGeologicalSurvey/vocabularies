    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mud, locally silty, soft to stiff, red-grey to grey-brown, with sporadically distributed pebbles up to several centimetres diameter."@en ;
