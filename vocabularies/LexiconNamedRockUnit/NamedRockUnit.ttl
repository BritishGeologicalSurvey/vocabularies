namedrockunit:HPSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Predominantly cold-phase sands and gravels that underlie the Holme Pierrepont Terrace. Generally pinkish, poorly sorted and compositionally rather immature matrix-supported, sandy, trough-cross bedded (braided river) gravels with syndepositional ice-wedge casts. Gravel dominated by rounded pebbles of "Bunter" quartz/quartzite (typically c. 80%), plus flint, Triassic and Upper Carboniferous sandstone, Lower Carboniferous cherts, etc, and other "exotic" lithogies. Forms a fairly well preserved terrace typically 1 to 2 m above the floodplain in the upper and middle Trent, with the deposits extending beneath those of the younger Hemington Terrace and the floodplain alluvium. \r
\r
River terrace deposits. Upper Pleistocene (MI Stage 2)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on pre-Quaternary bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H325 ,
        namedrockunit:H3478 ,
        namedrockunit:H964 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 0 to c. 12 m; typically up to c. 8 m in the middle Trent valley."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface, or base of alluvium or of the Hemington Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Floodplain sand and gravel [Obsolete]"@en ,
        "Floodplain terrace [Obsolete]"@en ,
        "Holme Pierrepont Sand and Gravel [Obsolete: use HPSG]"@en ;
    skos:broader namedrockunit:TRVA ;
    skos:definition "Gravel and sand with subsidiary clay, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Late Pleistocene (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HPSG"@en ;
    skos:prefLabel "Holme Pierrepont Sand and Gravel Member"@en ;
.

namedrockunit:HPTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Happisburgh Till Member is a yellowish grey to grey matrix-supported diamicton that has a sandy clay matrix texture. The clast content of the diamicton is <1% and composed predominantly of flint, vein quartz and quartzite with a subsidiary assemblage of far-travelled British erratic lithologies including Carboniferous limestone, Carboniferous coal, Devonian Red Sandstone, Permian Red Sandstone, Permian \"Magnesian\" limestone, felsic and basaltic porphyry, Dalradian metasediments. The diamicton has been interpreted as a subglacial deformation till."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal contact between the Happisburgh Till Member and the underlying Wroxham Crag Formation is represented by an upward transition from tidally laminated sand and silt to till."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CMTL ,
        namedrockunit:H3479 ,
        namedrockunit:H965 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically between 2 to 7m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Happisburgh Till Member is variable but generally consists of a series of ridges and troughs that have been interpreted as a range of subglacial and ice-marginal landforms. The till is overlain by a series of laminated clays (Ostend Clay Member) and sands (Happisburgh Sand Member)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cromer Till (Lowest Member) [Obsolete: use HPTI]"@en ,
        "First Cromer Till [Obsolete: use HPTI]"@en ,
        "Happisburgh Diamicton [Obsolete: use HPTI]"@en ;
    skos:broader namedrockunit:HPGL ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HPTI"@en ;
    skos:prefLabel "Happisburgh Till Member"@en ;
.

namedrockunit:HSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MISLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A red and grey, planar-bedded, quartzose, sandstone with interbeds of micaceous siltstone and silty mudstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable on the Ishes Flagstone Formation.  At its type site, the base is taken as a gradual facies change from grey calcareous, laminated fine-grained flaggy sandstone of the Ishes Flagstone, to a red coarser-grained sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4101 ,
        namedrockunit:H966 ,
        namedrockunit:HRB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 920 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by red flaggy sandstone of the Nairn Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hillhead Group [Obsolete: use HSA]"@en ,
        "Hillhead Red Bed Subgroup [Obsolete: use HSA]"@en ,
        "Hillhead Sandstones, Flagstones and Shales [Obsolete: use HSA]"@en ;
    skos:broader namedrockunit:INS ;
    skos:definition "Micaceous siltstone and sandstone with subsidiary silty mudstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HSA"@en ;
    skos:prefLabel "Hillhead Sandstone Formation"@en ;
.

namedrockunit:HTFD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONGAP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red, laminated and cross-laminated silty sandstone interbedded with pebbly sandstone and lenses of breccio-conglomerate. The sandstone is medium- to thick-bedded, silty, medium- to fine-grained with small [<0.5mm] detrital mica flakes and including many frosted and rounded quartz grains. Intervals of pebbly sandstone and breccia occur within the sandstone, not necessarily at the top of the sandstone beds. The clasts are pebble sized, mostly tabular and platey and aligned parallel or near parallel to bedding, defining a crude lamination, and matrix supported in red sandy siltstone or silty sandstone. The clast composition is red or grey mudrock, grey micaceous wacke sandstone, cream-coloured quartzite and, locally, deeply weathered basalt and amygdaloidal basalt. The Formation may also include interbeds of brick red, dune cross-bedded, fine- or very fine-grained sandstone without detrital mica grains."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal strata unconformably overlie, or are faulted against, rocks of Lower Palaeozoic age. The underlying sequences are commonly steeply inclined, well-indurated, fine-grained wacke sandstone and mudrock and have a marked angular discordance with the overlying, shallowly inclined strata of the Hartfield Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2248 ,
        namedrockunit:MOFB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The thickness of the Hartfield Formation from the mapped extent in Kinnel Water [NY0679 9246] to [NY0671 9163] and Mollin Burn [NY 0575 9223] to [NY 0605 9141] is approximately 150m and 170m, respectively."@en ;
    lexicon:hasUpperBoundaryDefinition "Strata of the Hartfield Formation are conformably overlain by brick-red sandstone of the Corncockle Sandstone Formation. The boundary is picked at the base of a continuous sequence of fine-grained, well sorted sandstone with large scale cross-bedding and single grain \"pin stripe\" lamination typical of the overlying Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hartfield Breccia Formation [Obsolete: use HTFD]"@en ,
        "Moffat Breccia Formation [Obsolete: use HTFD]"@en ;
    skos:broader namedrockunit:STEW ;
    skos:definition "Sandstone with subsidiary pebbly (gravelly) sandstone and trace angular pebble-grade conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Cisuralian Epoch (Permian Period) (298.9-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LBIE ;
    skos:notation "HTFD"@en ;
    skos:prefLabel "Hartfield Formation"@en ;
.

namedrockunit:HYB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In north Dorset it is seen as coarsening upwards cycles typically from 8m  to 10m thick, and up to 20m thick, of grey to brown sandy mudstone, muddy sandstone and yellow, brown and grey very fine- to medium-grained quartzose sand, with thin sandy siltstone beds in parts. Sand is locally cemented into lenticular beds and doggers of calcareous, 'blue-hearted' sandstone to sandy limestone. In Wiltshire, the sandy mudstone beds are subordinate. The beds are generally very shelly and bioclastic in Dorset to west Wiltshire, but poorly fossiliferous in north Wiltshire to Oxfordshire. Well-cemented fossiliferous sandstone beds occur in the upper part: the Seend Cleeve Sandstone Member in west Wiltshire (Wright and Cox, 2001), Lyon's Gate Bed in Dorset (Bristow et al. 1995), and a spiculitic sanstone bed, near Purton, Wiltshire (Ringsbury Spiculite Member; Arkell, 1941). Contains a fauna of bivalves and ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "The base generally displays a change up from the grey mudstone of the Weymouth Member of the Oxford Clay Formation, into a sequence of sandy mudstone, muddy sandstone, sand and sandstone beds. In places, the basal bed is a fine-grained sand."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H101 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 6m to 53m thick in north Dorset, and 6m to 18m thick in Wiltshire."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary varies along the outcrop. In Dorset there is a sharp change from a sequence of sandy mudstone, sand and sandstone strata to a sand-free, or virtually sand-free, commonly ooidal, grey clay, of the Woodrow Clay Member and the Stour Formation. in East Somerset it is overlain unconformably by grey mudstone of the Gault Formation. In Wiltshire, the sandy strata are overlain non-sequentially by grey or brown mudstone of the Highworth Clay Member, or grey bioclastic ooidal and non-ooidal limestone of the Highworth Limestone Member, both part of the Kingston Formation, or else by a non-sequence, overlain by grey limestone of the Stanford Formation. In Oxfordshire, there is a passage up from poorly fossiliferous fine-grained sand, sandy siltstone and mudstone into moderately fossiliferous medium- to coarse-grained grey to brown sand of the Beckley Sand Member of the Kingston Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Calcareous Grit [Obsolete: use HYB, KTON, TECY, BYSA]"@en ;
    skos:broader namedrockunit:CR ;
    skos:definition "Calcareous sandstone, clay and sand with subsidiary limestone and siltstone and trace mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LYGB ,
        namedrockunit:RIS ;
    skos:notation "HYB"@en ;
    skos:prefLabel "Hazelbury Bryan Formation"@en ;
.

namedrockunit:HYBC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Soft, light to dark grey, commonly pale weathering, siliceous radiolarian shaly mudstones, typically thin-bedded (c. 10 cm), interbedded with thin silicified limestone and chert beds and thin, mottled and dolomitized limestones at the top."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the incoming of thin-bedded, light to dark grey siliceous radiolarian shaly mudstones and thin limestone beds above the hard, black, finely laminated cherty mudstones of the underlying Doddiscombe Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3483 ,
        namedrockunit:H3865 ,
        namedrockunit:H4108 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "About 40 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of abundant blocky chert with few limestones of the Kersdown Chert Member above the siliceous radiolarian shaly mudstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hayne Beech Beds [Obsolete: use HYBC]"@en ,
        "Hayne Beech Formation [Obsolete: use HYBC]"@en ,
        "Lower Bampton Limestones [Obsolete: use HYBC, BPLM]"@en ;
    skos:broader namedrockunit:BPLM ;
    skos:definition "Siliceous mudstone with subsidiary chert and trace dolomitic limestone and siliceous limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Asbian Substage (Carboniferous Period) (346.7-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HYBC"@en ;
    skos:prefLabel "Hayne Beech Member"@en ;
