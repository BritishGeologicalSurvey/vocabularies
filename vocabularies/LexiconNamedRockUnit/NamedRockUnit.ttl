namedrockunit:THCAT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Thames Catchments Subgroup comprises river terrace deposits of Anglian and younger age of the River Thames and its tributaries. Mass movement deposits and organic deposits (organic clay, tufa and peat) of the catchments are also included. The Thames river system is one of the most intensively studied in Britain. Organic fossiliferous beds interbedded with the 'cold stage' terrace sand and gravel aggradations have been correlated with interglacial 'warm stages' allowing the establishment of a detailed climate-related stratigraphical framework. \r
\r
Mainly river terrace sand and gravel, brickearth silt and alluvial floodplain silt, silty clay and sand. The subgroup includes interbedded units of locally fossilferous silty sand, silt, together with organic clay, tufa and peat that are biostratigraphically correlated with interglacial (warm) stages. Terrace deposit gravel clasts are mainly limestone lithogies (upper Thames) and flint, vein quartz and local bedrock lithologies including chert (middle and lower Thames). \r
\r
The subgroup is currently divided into the Upper Thames Valley Formation and the Maidenhead Formation (middle and lower Thames valley) for deposits of the main valley and some tributary valleys. The Kennet Valley Formation and the Medway Valley Formation is established for terrace deposits of those valleys. The terrace deposits are depicted on British Geological Survey maps using numbered terrace symbols. Modern British Geological Survey maps also show the terrace deposits as named units that are here interpreted as members of the relevant valley formation. \r
\r
Anglian to Holocene (MIS 12-1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on glacigenic deposits of the Anglian stage or on older Pleistocene strata or bedrock. Individual terrace deposit members rest unconformably on older Pleistocene strata."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Single terrace aggradations range from 3 to 12 m. Interglacial units are up to 12 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Clay, gravel, sand, silt and silty clay with subsidiary peat and trace tufa. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage - to - Holocene Epoch (Quaternary Period) (.48-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:KNTV ,
        namedrockunit:MEVA ,
        namedrockunit:MNHD ,
        namedrockunit:UTMS ;
    skos:notation "THCAT"@en ;
    skos:prefLabel "Thames Catchments Subgroup"@en ;
.

namedrockunit:THSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/M"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Predominantly cold-phase sands and gravels that underlie the Thorpe or Second Terrace of the River Bain. Dominated by clasts of flint with up to 50% chalk (though decalcified near ground surface) and a smaller proportion of Upper Jurassic and Lower Cretaceous lithologies plus minor exotics, notably Carboniferous sandstone and \"Bunter\" quartz/quartzite pebbles (mostly derived from Anglian tills). It forms a rather degraded terrace surface typically some 3 to 4m above the modern alluvial floodplain, and c.2m higher that the adjacent Castle Terrace, though deposits extend beneath the level of the latter. Sections show intraformational and epigenitic ice wedge casts, and upper part locally incorporates a rubified palaeosol (Hykeham Soil; Ipswichian). Locally includes cold-phase organic silts and peats, but channel-filling organic silts at the base (Kirkby Bed) yield a temperate flora and fauna assigned to MIS 7. Correlated with the Southrey and Balderton Sand and Gravel members and Egginton Sand and Gravel Member (all in the Trent Valley Formation)."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, commonly channelled base, resting on Anglian Wragby Till in the Type Area but possibly locally on Upper Jurassic mudstone bedrock if present elsewhere."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H110 ,
        namedrockunit:H3275 ,
        namedrockunit:H4908 ,
        namedrockunit:H568 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to c. 8 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or (locally) overlain by the Castle Sand and Gravel Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Second Terrace Deposits [Obsolete: use SURA, THSG, WAT]"@en ,
        "Southrey Terrace Deposits [Obsolete: use THSG, CASSG, SOYSG]"@en ,
        "Tattershall-Kirkby Terrace Deposits [Obsolete: use THSG, CASSG]"@en ,
        "Thorpe Member [Obsolete: use THSG]"@en ;
    skos:broader namedrockunit:BAINV ;
    skos:definition "Gravel and sand with subsidiary mud and peat. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene (Quaternary Period) (.78-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "THSG"@en ;
    skos:prefLabel "Thorpe Sand and Gravel Member"@en ;
.

