        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SHFEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, siltstone and mudstone in repeated cycles that most commonly coarsen upwards, but also fine upwards locally, with seatclay or seatearth and coal at the top. The mudstone and siltstone are usually grey to black, while the sandstone is fine- to medium-grained and off-white to grey. Coal seams are common and many exceed 0.3m in thickness."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of the Lowstone Marine Band, or its local correlative, or at the appropriate place of disconformity."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1017 ,
        namedrockunit:H4753 ,
        namedrockunit:LCM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "90 to 340m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the Vanderbeckei (Queenslie) Marine Band."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
