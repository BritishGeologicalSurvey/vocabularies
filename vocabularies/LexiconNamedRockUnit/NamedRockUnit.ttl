namedrockunit:BRLSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Briton's Land Sand and Gravel Member consists of horizontal, massive and low angle planar cross-bedded gravels and cobble gravels with thin seams of horizontal and rippled sand. The lithology has a distinctive high flint content (c.85-89%) of which the majority is of non-chatter marked variety (c.78-85%). The gravels also contain a wide range of far-travelled crystalline erratics including rocks of British and Scandinavian provenance."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is generally well defined with sands and gravels resting upon an erosion surface that cuts down into and draped over tills of the Sheringham Cliffs Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3872 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The maximum observed is 40m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Brition's Lane Sand and Gravel Member is commonly exposed at the surface although in places it has a thick palaeosol developed within the upper 2-3m."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Briton's Lane Sands and Gravels [Obsolete: use BRLSG]"@en ;
    skos:broader namedrockunit:BRLA ;
    skos:definition "Gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRLSG"@en ;
    skos:prefLabel "Briton's Lane Sand And Gravel Member"@en ;
.

namedrockunit:BRME
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S130 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Fluvial sands and gravels form a bench about 2-4 m above the present floodplain. Three units have been recognised: \r
\r
Uppermost - Cross-bedded sand with gravel and clay lenses; \r
Middle - coarse, poorly sorted, bedded gravel and sand; \r
Lowermost - sorted, cross-bedded gravel and sand. \r
\r
The terrace has yielded a rich fauna and flora."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on sands of Happisburgh Formation (formerly called Corton Formation)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "264 m."@en ;
    lexicon:hasUpperBoundaryDefinition "At surface or may be overlain by Blown Sand in the area around Outney Common and elsewhere locally overlain by Alluvium."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Second Terrace Of The Waveney (Moorlock Et Al,2000)"@en ;
    skos:broader namedrockunit:WAVV ;
    skos:definition "Gravel and sand with subsidiary clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BRME"@en ;
    skos:prefLabel "Broome Member"@en ;
.

namedrockunit:BRN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dull red or purple, fine- to very coarse-grained sandstones characterised by the presence of siliceous pebbles, which also form conglomeratic bands."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on the Ochil Volcanic Formation."@en ;
