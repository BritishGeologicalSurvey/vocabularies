namedrockunit:SSG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, red, yellow and brown, part pebbly; conglomeratic in lower part; pebbles generally extraformational quartz and quartzite, with some intraformational clasts; subordinate red mudstone and siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformable on the Lenton Sandstone Formation in the eponymous area and on the Kinnerton Sandstone Formation in Cheshire. Unconformable on the Aylesbeare Mudstone Group in east Devon, the Bridgnorth Sandstone Formation in the West Midlands, the Cumbrian Coast Group in Lancashire and Cumbria, and the Zechstein Group in north Nottinghamshire, Yorkshire and Durham. In other areas it rests unconformably on rocks ranging from Precambrian to Carboniferous in age."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1199 ,
        namedrockunit:KMS ,
        namedrockunit:KSR ,
        namedrockunit:LKSR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TI> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Variable, maximum >1500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational into the Tarporley Siltstone Formation of the MMG where mudstone/siltstone becomes dominant over sandstone. In the Bristol area it is taken at the upward change to red sandstones of the Redcliffe Sandstone Member of the MMG (Howard et al., 2008). In the East Midlands the boundary with the Tarporley Siltstone Formation is an unconformity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bunter Sandstone [Obsolete: use SSG, CHES]"@en ,
        "Keuper \"Series\" [Obsolete: use SSG, MMG]"@en ,
        "Keuper Marl and Sandstone [Obsolete: use MMG, SSG]"@en ,
        "Keuper Series, Lower [Obsolete: use SSG, MMG]"@en ;
    skos:broader namedrockunit:NRS ;
    skos:definition "Pebbly (gravelly) sandstone and sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Induan Age - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
