namedrockunit:KN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/B"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Sand and gravel, with cobbles and pebbles of Ordovician, Silurian, Devonian and Carboniferous rocks in a matrix of medium- to coarse-grained sand; typically pale yellow to palebrown. Granitic clasts are commonly a major component. Esker deposits are typically poorly sorted, cobbly and bouldery,well-bedded with high-angle cross-bedding, involutions and slumps. Some interbeds of coarse sand. Kame and kettle deposits are poorly exposed, but appear to be typically moderately sorted, silty, sandy, clast-supported gravel with rounded to subrounded cobbles and pebbles. \r
Glaciofluvial Sheet deposits are poorly exposed but appear to be typically well-sorted sandy gravel, with interbeds of coarse- to medium-grained sand."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on older glacigenic sediments, such as till of the Gretna Till Formation; locally rests directly on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Variable, typically 4-10m, esker deposits may be > 12m thick; moundy ice-contact deposits and sheet deposits are typically 2-8m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Locally overlain by Holocene alluvium and peat, and by Holocene and Lateglacial raised marine deposits. Some exposures are capped by gravelly friable pale brown to reddish brown diamicton (supraglacial flow till) typically 0.3-0.7m in thickness)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SUDR ;
    skos:definition "Gravel and sand with subsidiary boulders and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KN"@en ;
    skos:prefLabel "Kirkbean Sand And Gravel Formation"@en ;
.

