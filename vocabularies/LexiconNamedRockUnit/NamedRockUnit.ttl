namedrockunit:WIGM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S839 ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Lenses of \"drab\" clay within red clay containing Turritella communis, foraminifera and ostracods, recovered from a borehole only. The fossilliferous deposits are possibly Ipswichian in age, but were probably transported as glacial rafts from the Solway Firth during the Early Scottish Glaciation."@en ;
    lexicon:hasLowerBoundaryDefinition "Core recovery was poor, but the clays apparently rested on bedrock (Stanwix Shale) within a buried channel at about 46m depth. (-21m OD) at Wigton."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Probably a few metres, but core recovery was poor."@en ;
    lexicon:hasUpperBoundaryDefinition "Core recovery poor, but the fossilliferous deposits were found beneath \"clay containing foreign erratics\", presumably till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasYoungestAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Wigton Formation"@en ;
    skos:broader namedrockunit:GCBTI ;
    skos:definition "Clay. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage (Quaternary Period) (.126-.116 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WIGM"@en ;
    skos:prefLabel "Wigton Marine Bed"@en ;
.

