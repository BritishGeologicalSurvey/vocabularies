    lexicon:hasLateralEquivalent
        namedrockunit:IDA ,
        namedrockunit:OFFA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey laminated shales, and dark, pale and bluish grey mudstones; locally concretionary and tabular limestone beds; abundant argillaceous limestone, phosphatic or ironstone (sideritic mudstone) nodules in some areas; organic-rich paper shales at some levels; finely sandy beds in lower part in some areas."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the top of Blue Lias Formation or Scunthorpe Mudstone Formation. The top of the Blue Lias coincides with a marked upward decrease in frequency, thickness and lateral persistence of limestone beds. In many cases, the horizon to be taken is obvious. Where there is doubt, the thickness and vertical frequency of limestone beds should be considered, and the following guidelines used: at the top of a more or less persistent, thick (>0.10m) limestone above which the overlying mudstone (beneath any subsequent similar limestone) is at least twice the thickness typical of the underlying limestone-mudstone interbedded unit and above which there is no return, within the Lias Group, to limestone-mudstone spacing on that previous scale. In the type section, at the top of the Grey Ledge (bed 49 of Lang, W D, 1924). In the East Midlands Shelf (northwards), where the Blue Lias is absent but the Scunthorpe Mudstone occurs, the base of the Charmouth Mudstone is taken at the base of thin pebbly ferruginous oolite (Glebe Farm Bed) or, in north Lincolnshire, at the top of the Frodingham Ironstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BMN ,
        namedrockunit:CLM ,
        namedrockunit:H123 ,
        namedrockunit:H124 ,
        namedrockunit:H1425 ,
        namedrockunit:H2531 ,
        namedrockunit:H2691 ,
        namedrockunit:H3924 ,
        namedrockunit:LLIC ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.335m"@en ;
    lexicon:hasUpperBoundaryDefinition "At marked or gradational upward change to coarser siliciclastic deposits of the Dyrham Formation. In the type section, this is at the base of the Three Tiers Sandstone. Where the Dyrham Formation is absent (East Midlands Shelf northwards) it is taken at the base of the Marlstone Rock Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
