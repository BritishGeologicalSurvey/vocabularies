        namedrockunit:H2589 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "From 45 m in the Pontypool area [ST 268 990] to 200 m in the Swansea area [SS 660 945]."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is placed at the base of the Hughes (Cefn Glas) Coal, where the coal rests on either 'Pennant' sandstones or thin mudstones/siltstones at the top of the Brithdir Member. The coal is overlain by 'Pennant' sandstones or thin mudstones/siltstones of the Hughes Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
