namedrockunit:ALCR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GDBI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GNL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Composed of a grey, aphyric, biotite granodiorite, with a marginal zone of pink leucogranite up to 200m wide. The granodiorite is composed of oligoclase, quartz and microcline, partly chloritised biotite and minor hornblende. Abundant disorientated rafts of host rocks of psammite and semipelite up to 500m long occur in the southern part of the complex, preserving a disrupted ghost stratigraphy, mainly seen on Sheet 63E, Dalwhinnie. Elsewhere, the granodiorite includes an area where the rafts are predominantly composed of appinitic diorite. These rafts are penetrated by veins of granodiorite but otherwise generally intact, albeit thermally metamorphosed. Contact metamorphism is intense within the rafts, most noticeably affecting semipelites and any calc-silicate rocks, and recognised up to 1.4 km away from the external contacts of the intrusion. In the northern part of the complex, mainly Sheet 73E - Foyers, the metasedimentary rocks become progressively more coherent so that some areas may be regarded as intact metasedimentary formations permeated by granodiorite veins of a variety of scales and to varying degrees of intensity. Subdivisions of the complex are recognised on the basis of the character of the metasedimentary rocks enclosed."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H639 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasOldestAgeValue 4.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Allt Crom Pluton [Obsolete: use ALCR]"@en ;
    skos:broader namedrockunit:ANHGR ;
    skos:definition "Biotite granodiorite with subsidiary leucogranite. Bedrock. Occurs onshore. Formed during the Silurian Period - to - Devonian Period (443.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ALCRA ,
        namedrockunit:ALCRC ,
        namedrockunit:ALCRG ,
        namedrockunit:ALCRL ,
        namedrockunit:ALCRM ;
    skos:notation "ALCR"@en ;
    skos:prefLabel "Allt Crom Complex"@en ;
.

