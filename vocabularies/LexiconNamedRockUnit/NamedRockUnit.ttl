namedrockunit:CBTL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly plagioclase-macrophyric basalts (Markle type). There are also some plagioclase-microphyric basalts (Jedburgh type) and olivine-clinopyroxene-plagioclase-macrophyric basalts (Dunsapie type) as well as some mugearites near the base."@en ;
    lexicon:hasLowerBoundaryDefinition "The Carbeth Lava Member overlies the plagioclase-microphyric basalts (Jedburgh type) of the Auchineden Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3907 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-150 m, thins out to south-west partly due to erosion; thins to c. 80 m in north-east."@en ;
    lexicon:hasUpperBoundaryDefinition "The Carbeth Lava Member is unconformably overlain by the Greenside Volcaniclastic Member. West of Loch Humphrey [NS 455 760] the member is reduced to one lava flow which is preserved only in isolated patches below the volcaniclastic sedimentary rocks."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carbeth Lavas [Obsolete: use CBTL]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Plagioclase-macrophyric basalt with subsidiary mugearite, olivine-clinopyroxene-plagioclase-macrophyric basalt and plagioclase-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBTL"@en ;
    skos:prefLabel "Carbeth Lava Member"@en ;
.

