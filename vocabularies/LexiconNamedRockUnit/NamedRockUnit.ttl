    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSPYR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RY"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Silicified rhyolite or ignimbrite, typically brecciated, purple when fresh, pale pink, greenish or brown mottled on weathered surfaces.  The rock contains sparse euhedral phenocrysts of feldspar and locally exhibits well developed flow banding.  Vesicles lined with quartz and calcite are commonly present in the upper 1.5m.  The unit occurs as two lenticular bodies: one interstratified within the lower part of the Melby Sandstone Formation, and the second at the base of the Melby Sandstone Fm, at the NE end of its outcrop."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower unit displays a faulted contact along the Melby Fault, against the Sandness Formation  of the Lower ORS on the Walls Peninsula.  The upper unit displays a highly irregular contact with the 'blocks and tongues' of rhyolite that penetrated the underlying grey, micaceous, ripple laminated sandstone with rhyolite clasts, of the Melby Sandstone Formation, to a distance of about 60 cm whilst it was unconsolidated sediment."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H412 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The upper unit is at least 70 m thick, whereas mapping suggests that the lower unit is at least up to 150 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper unit shows a disconformable irregular brecciated contact against fine-to medium-grained planar bedded pink sandstone, with partings of flaggy sandstone and siltstone and containing scattered rhyolite clasts of the Melby Sandstone Formation.  The contact with the lower unit is not exposed but mapping suggests that it is disconformably overlain by similar sediments of the Melby Sandstone Formation to those overlying the upper unit."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Melby Rhyolites [Obsolete: use MYRH]"@en ;
    skos:broader namedrockunit:PSV ;
    skos:definition "Ignimbrite and rhyolite. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MYRH"@en ;
    skos:prefLabel "Melby Rhyolite Member"@en ;
.

namedrockunit:MYSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dull yellow-orange to dull yellowish brown stratified silty sands with a high abundance of detrital chalk in the lower horizons, and opaque heavy minerals. Typical bedding structures include planar cross-bedding, horizontal bedding, massive beds, climbing ripples and convolute bedding."@en ;
    lexicon:hasLowerBoundaryDefinition "Erosional lower contact with the chalky diamicton of the Walcott Till Member. The upper surface of the latter is slightly undulatory in form with the topographic lows filled by chalk-rich gravel before passing up into the silty sands of the Mundesley Sand Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1080 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The Mundesley Sand Member reaches a maximum observed thickness of 9m in its stratotype area."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the Mundesley Sand Member is variable. Where the deposit is overlain by the Bacton Green Till, such as between Bacton and Mundesley, the contact is gradational and marked by a zone of horizontally-bedded sands and diamicton. Alternatively, where the Ivy Farm Laminated Silt Member overlies the Mundesley Sand Member, the boundary is unconformable (?tectonic)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mundesley Sands [Obsolete: use MYSA]"@en ;
    skos:broader namedrockunit:SMCL ;
    skos:definition "Sand with subsidiary silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MYSA"@en ;
    skos:prefLabel "Mundesley Sand Member"@en ;
.

namedrockunit:MYTB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A thick heterogeneous, dominantly red succession of purple-red mudstone, with subsidiary sandstone and siltstone, and minor 'marl', thin coals and thin beds of limestone with Spirobis sp. \r
\r
The member was deposited in interdistributary bay or lacustrine environments with minor river channels (Akhurst et al., 1997). The reddening was either primary or early diagenetic. \r
\r
Bolsovian (Westphalian C) to Asturian (Westphalian D)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the unit is the top of the highest major channel sandstone unit in the Bransty Cliff Sandstone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3572 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 180 m maximum."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary of the member is the sub-Permian unconformity, which is overlain by the coarse, poorly bedded, poorly to moderately sorted, generally massive, matrix or clast-supported, typically pebble-grade, breccias of the Permian Brockram (Appleby Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Millyeat Beds Member [Obsolete: use MYTB]"@en ;
    skos:broader namedrockunit:WS ;
    skos:definition "Mudstone with subsidiary sandstone and siltstone and trace calcareous mudstone, coal and limestone. Stratified bedrock. Occurs onshore. Deposited during the Bolsovian Substage - to - Asturian Substage (Carboniferous Period) (314.75-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MYTB"@en ;
    skos:prefLabel "Millyeat Member"@en ;
.

