namedrockunit:SAH
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:MDVS ,
        namedrockunit:WCH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey and grey silty mudstone with variable but very subordinate amounts of laminae and thin beds of siltstone and sandstone. Bioturbation is locally present, especially in the lower part. There are scattered units of thin- to thick-bedded limestone (eg: Marble Cliff Limestone Member), thin- to thick-bedded sandstone (eg: Wearde Sandstone Member), basaltic lava (spilite), massive and bedded hyaloclastite, and bedded tuff (eg: St Germans Tuff Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is mainly thrust out in the east where it is assumed to overlie the Staddon Formation. In the west, on the north Cornish coast, it is taken at the incoming of dark and pale grey mudstones with scattered thin sandstones of the Saltash Formation above the sandstones and siltstones with subordinate mudstones of the underlying Bedruthan Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1158 ,
        namedrockunit:H1159 ,
        namedrockunit:H2406 ,
        namedrockunit:H3656 ,
        namedrockunit:H4311 ,
        namedrockunit:H4312 ,
        namedrockunit:JCS ,
        namedrockunit:TVS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "3900 m on the north Cornwall coast. Comparable thicknesses are expected elsewhere."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is predominantly tectonic, except in the east in the Tamar valley, where it is taken at the incoming of dark grey cherts and siliceous mudstones of the Winstow Chert Formation above the mid grey silty mudstones of the Saltash Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Jennycliff Slate Formation [Obsolete: use SAH]"@en ,
        "Jennycliff Slates [Obsolete: use SAH]"@en ,
        "Middle Devonian Slates"@en ,
        "Nordon Slate [Obsolete: use SAH]"@en ,
        "Plympton Slate Formation (in part) [Obsolete: use SAH]"@en ,
        "Tempellow, Rosenum and Mileport Slate Formation [Obsolete: use SAH]"@en ,
        "Trevose Slate Formation [Obsolete: use SAH]"@en ,
        "Trevose Slate [Obsolete: use BEDN, SAH]"@en ,
        "Upper Devonian Slate [Obsolete: use SAH]"@en ,
        "Winstow Chert Formation"@en ;
    skos:broader namedrockunit:TAMA ;
    skos:definition "Mudstone with subsidiary basalt lava, basaltic tuff, hyaloclastite, limestone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (410.5-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:MCLB ,
        namedrockunit:SGTU ,
        namedrockunit:WRG ;
    skos:notation "SAH"@en ;
    skos:prefLabel "Saltash Formation"@en ;
.

namedrockunit:SAL
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:CYS ,
        namedrockunit:ERB ,
        namedrockunit:MRD ,
        namedrockunit:RWD ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red and red-brown mudstone, and red-brown (mostly sublitharenite) sandstone containing beds of pebbly sandstone and conglomerate itself containing Carboniferous limestone and chert clasts, and thin 'Spirobis' limestone beds and caliche in the lower part of the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, transitional-gradational boundary taken at the base of the first, at least 1 m thick, red-bed stratum, overlying the grey mudstone-dominated Dark Slade Member of the underlying Halesowen Formation. Where this is also red, the boundary is drawn arbitrarily, above the top of the highest litharenite sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ERB ,
        namedrockunit:KE ,
        namedrockunit:MRD ,
        namedrockunit:RWD ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 200 m to 360m thick in Shropshire, and 625 m thick in Warwickshire."@en ;
    lexicon:hasUpperBoundaryDefinition "In the type area at the boundary occurs at the base of the Clent Formation. The boundary is an unconformable or disconformable sharp junction, in the Clent Hills where the Clent Formation is a red-brown breccia; or is a gradational boundary where there is red mudstone-dominated Clent Formation; but is taken at the base of red sandstone with Uriconian volcanic clasts in the Gospel End area of the West Midlands. In Warwickshire, the boundary is conformable below the red-brown mudstone-dominated succession of the Tile Hill Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Coventry Sandstone Formation [Obsolete: use ALY, ASY, MRD]"@en ,
        "Erbistock Formation [Obsolete: use HA, SAL]"@en ,
        "Keele Formation [Obsolete: use ALY, HA, MRD, SAL]"@en ,
        "Meriden Formation [Obsolete: use SAL]"@en ,
        "Radwood Formation [Obsolete: use SAL]"@en ;
    skos:broader namedrockunit:WAWK ;
    skos:definition "Mudstone and sandstone with subsidiary conglomerate and limestone and trace coal. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage (Carboniferous Period) - to - Cisuralian Epoch (Permian Period) (310-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
