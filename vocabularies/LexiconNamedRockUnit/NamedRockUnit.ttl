    skos:broader namedrockunit:MODS ;
    skos:definition "Breccia, conglomerate, nodular limestone (cornstone) and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Triassic Period (251.9-201.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "AMHAR"@en ;
    skos:prefLabel "A'Mharagach Member"@en ;
