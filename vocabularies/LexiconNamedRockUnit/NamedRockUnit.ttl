    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Wenlock Epoch (Silurian Period) - to - Early Devonian Epoch (Devonian Period) (432.9-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
