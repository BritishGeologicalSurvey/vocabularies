namedrockunit:PSLCM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent
        namedrockunit:PLCM ,
        namedrockunit:SWLCM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEATS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SISTCC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Interbedded grey mudstone, siltstone and pale grey sandstone, commonly with mudstones containing marine fossils in the lower part, and more numerous and thicker coal seams in the upper part. \r
\r
This composite unit is represented on the BGS 1:625 000 scale Bedrock Geology UK North and South geological maps (BGS 2007a, b) of the UK and some derived digital products such as the UK3D fence diagram model. See the entries for the constituent units for more information."""@en ;
    lexicon:hasLowerBoundaryDefinition "At the base of the dark grey, fissile mudstone of the Subcrenatum Marine Band with eponymous fossils (as defined by Stubblefield and Trotter, 1957), or at the base of the lowest coal of the coal-bearing sequence if this marker cannot be recognised. Typically, the unit rests conformably upon the Rossendale Formation (Millstone Grit Group) in central and northern England. However, in north, west and east Cumbria, the Solway Basin (except the Canonbie area), the Stainmore and Northumberland troughs, on the Alston Block and in northeast Northumberland, the formation overlies conformably the repetitive mudstones, siltstones, sandstones, thin limestones and thin coals of the Stainmore Formation (Yoredale Group). In the Canonbie Coalfield, the formation is underlain unconformably by the Alston Formation (Yoredale Group). In South Wales and Bristol-Somerset coalfields the Subcrenatum Marine Band conformably overlies the topmost mudstones or sandstones of the Marros Group. The unit rests unconformably on Visean, Tournaisian, or Devonian strata in the Berkshire and Kent coalfields."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GRM ,
        namedrockunit:H1759 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasOldestAgeValue 3.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 650 m thick in the North Staffordshire (Potteries) Coalfield, and 720 m thick in Lancashire and 100 m in the Canonbie Coalfield. c. 80 m on the east crop of the South Wales Coalfield to c.300 m in the Swansea area and from about 160 m in the Bristol district to 200 m in the Somerset Coalfield and 63m thick in the Kent Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "At the base of the mudstone of the Vanderbeckei Marine Band with eponymous fossils (as defined by Stubblefield and Trotter, 1957), where basal fossiliferous, marine mudstone of the marine band comformably overlies the top of the Pennine and South Wales Lower Coal Measures."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CA> ;
    lexicon:hasYoungestAgeValue 3.18e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Grey Measures of Yorkshire and Nottingham [Obsolete: use PLCM, PMCM, PSLCM, PSMCM]"@en ,
        "Lower Coal Measures [Obsolete: use PSLCM, SWLCM, PLCM]"@en ,
        "Pennine Lower Coal Measures Formation"@en ,
        "South Wales Lower Coal Measures Formation"@en ;
    skos:definition "Mudstone, sandstone and siltstone with subsidiary coal, ironstone and seat-earth mudstone and trace ganister and seat-earth sandstone. Bedrock. Occurs onshore. Formed during the Langsettian Substage (Carboniferous Period) (319-318 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "PSLCM"@en ;
    skos:prefLabel "Pennine Lower Coal Measures Formation and South Wales Lower Coal Measures Formation (Undifferentiated)"@en ;
.

namedrockunit:PSMCM
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:PMCM ,
        namedrockunit:SWMCM ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
