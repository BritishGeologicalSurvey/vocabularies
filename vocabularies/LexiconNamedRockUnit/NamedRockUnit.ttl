        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, yellow, grey, locally pebbly at base, and mudstone, red, purple, grey, buff with sporadic pale grey limestone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Basal sandstone bed, locally with clasts of Lickey Quartzite, unconformably overlying Lickey Quartzite (Wills and others, 1925)"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2991 ,
        namedrockunit:ULS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SL> ;
