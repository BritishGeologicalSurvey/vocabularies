        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium-grey greywacke, sub-greywacke, siltstones, mudstones and shales. Greywackes are mainly thin (<0.3 m ) except at top of formation where there is about 11 metres of thickly bedded greywackes. The middle part consists of firmly laminated silty mudstones and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the lowest occurrence of a persistent greywacke turbidite in the Ree Burn Formation to Smithy Burn Siltstone sequence."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ST> ;
    lexicon:hasOldestAgeValue 4.386e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "290m"@en ;
    lexicon:hasUpperBoundaryDefinition "Base of the overlying Parishholm Conglomerate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SS> ;
    lexicon:hasYoungestAgeValue 4.306e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:HGW ;
    skos:definition "Mudstone, sandstone, siltstone, silty mudstone and wacke. Stratified bedrock. Occurs onshore. Deposited during the Telychian Age - to - Sheinwoodian Age (Silurian Period) (438.6-430.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RBN"@en ;
    skos:prefLabel "Ree Burn Formation"@en ;
.

namedrockunit:RBPT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Raised bog peat refers to a bog with thickest accumulation of peat in the centre. The surface is largely covered by sphagnum mosses which because of their high degree of water retention make the bog more dependent on rainfall than on the water table. A raised bog peat may develop over a basin infilled with fen peat."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
