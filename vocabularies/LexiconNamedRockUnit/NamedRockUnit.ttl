namedrockunit:STGR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravel and sand, clayey near base. Gravel mostly composed of flints, up to 150mm in diameter, with a little quartz, quartzite and Lower Greensand chert in the fine fractions. Matrix of orange-brown, pale grey, red mottled clay and sandy clay, with pockets of coarse sand. Locally with layers of silt, clay or peat. Interpreted as offshore or beach gravels (Ellison et al 2004), or possibly fluvial (Bridgland 1994)."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on London Clay bedrock, base of deposit at 105-128 above O.D."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3054 ,
        namedrockunit:H3055 ,
