namedrockunit:GTLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A massive to weakly bedded, volcaniclastic breccia and pebbly coarse-grained, clast- to matrix-supported and very poorly sorted sandstone with dominantly silicic or andesitic fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the change from generally well bedded volcaniclastic sandstone to significantly coarser and weaker bedded volcaniclastic rocks."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H297 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 250m"@en ;
    lexicon:hasUpperBoundaryDefinition "The member is the uppermost unit of the Mardale Formation, and is overlain, along a sharp contact, by the Froswick Tuff Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Great Ladstones Member [Obsolete: use GTLA]"@en ;
    skos:broader namedrockunit:MRL ;
    skos:definition "Volcaniclastic-breccia with subsidiary volcaniclastic-sandstone. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GTLA"@en ;
    skos:prefLabel "Great Ladstones Breccia Member"@en ;
.

namedrockunit:GTQ
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, quartzitic to slightly feldspathic, with thin (<5cm) micaceous partings, and containing beds up to 1-2 metres thick of calc-silicate rock and impure limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Change from dominant calc-silicate rock to dominant psammite at top of Deeside Limestone Formation (not seen south of Mount Battock Granite)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DBGT ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "(i) North of Mount Battock Granite: probably no more than 500m (top cut out by granite). (ii) South of Mount Battock Granite: probably c. 1250m exposed, with little tectonic thickening (base not seen)."@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational change, by thickening of micaceous partings, to become interbedded psammite and semipelite (where Glen Turret Psammite and Semipelite Member is present). Elsewhere incoming of beds of semipelite with high magnetic susceptibility (Glen Effock Schist Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glen Tanner Quartzite [Obsolete: use GTQ]"@en ;
    skos:broader namedrockunit:TPS ;
    skos:definition "Psammite with subsidiary calcsilicate-rock and limestone and trace metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GTQ"@en ;
    skos:prefLabel "Glen Tanar Quartzite Member"@en ;
.

namedrockunit:GTSC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Graphitic pelite, silver-grey, locally garnetiferous with thin beds of metacarbonate rock. Striped psammites and graphitic pelites locally developed."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of dominantly graphitic succession stratigraphically overlying blue-grey metacarbonate rock at the top of the Glen Lochsie Calcareous Schist Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4064 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 300m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational contact with the overlying locally developed Carn an Daimh Transitional Member, marked by the increase in proportion of psammite and quartzite. Where the Transitional Member is absent, sharp boundary with Creag Leacach Quartzite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gleann Beag Schist [Obsolete: use GLCS, GTSC]"@en ;
    skos:broader namedrockunit:GBSC ;
    skos:definition "Pelite with subsidiary limestone and trace graphitic pelite and psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GTSC"@en ;
    skos:prefLabel "Glen Taitneach Schist Member"@en ;
.

