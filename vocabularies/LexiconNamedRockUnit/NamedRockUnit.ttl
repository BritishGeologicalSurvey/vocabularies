namedrockunit:MBO
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VLSS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use FELL] Interbedded sandstone, siltstone and mudstone with thin limestones (cementstones) below; mainly sandstone above. Marine faunal bands in places; local volcanic beds.\r
\r
Obsolete term Middle Border Group is replaced by Fell Sandstone Formation, Lumsden et al, 1968; Day, 1970."""@en ;
    lexicon:hasLowerBoundaryDefinition "At base of Harden Beds (Langholm) or the Whitberry Band (Bewcastle)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "550 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable upward passage to Upper Border Group; at base of Glencartholm Volcanic Beds (Langholm) or at base of Clattering Band (Bewcastle)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:FELL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Fell Sandstone Formation"@en ;
    skos:definition "Obsolete name. Mudstone, sandstone and siltstone with subsidiary calcilutite and trace volcaniclastic rocks (both pyroclastic and reworked volcanic rocks). Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Holkerian Substage (Carboniferous Period) (346.7-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MBO"@en ;
    skos:prefLabel "Middle Border Group [Obsolete: use FELL]"@en ;
.

