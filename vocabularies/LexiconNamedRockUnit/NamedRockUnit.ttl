    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Great Whinscale Rhyolite [Obsolete: use GWD]"@en ,
        "Tongue House Member [Obsolete: use LIT, GWD, GY]"@en ;
    skos:broader namedrockunit:BFA ;
    skos:definition "Dacite. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GWD"@en ;
    skos:prefLabel "Great Whinscale Dacite Member"@en ;
.

namedrockunit:GWHIN
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WHSI ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCQGB"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A  locally pegmatitic quartz-dolerite, with finer grained 'chilled' contact rock. Sills are typically columnar jointed, and comprise up to three leaves are present in places. The component sills and associated dykes cut strata up to and including those of Carboniferous, Duckmantian (Westphalian B) age, and derived pebbles are reworked into breccias of Early Permian age. Radiometric dates (K-Ar, Ar-Ar and U-Pb) are in the range of 301-294 Ma. The large volume of literature on this sill is listed, referred to and discussed in Stephenson et al., 2003."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp intrusive contact of the component sills, where they are in contact with sedimentary strata below."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WHSI ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CMIL> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SI> ;
    lexicon:hasThicknessDescription "Individual leaves average a thickness of about 30m; the thickest individual leaf is 73 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp intrusive contact with the strata overlying the sill."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whin Sill [Obsolete: use GWHIN, WHINS]"@en ;
    skos:broader namedrockunit:WHINS ;
    skos:definition "Dolerite and quartz-microgabbro. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Late Mississippian Epoch (Carboniferous Period) - to - Cisuralian Epoch (Permian Period) (330.3-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GWHIN"@en ;
    skos:prefLabel "Great Whin Sill"@en ;
.

namedrockunit:GWO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive ooidal grainstone, shelly, crinoidal bed at base; becomes dolomitized on the east crop of the coalfield."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at an erosion surface. In the type area, this is cut in micritic limestones of the underlying Coed Ffyddlwn Formation (Darren Ddu Member), which is overlain by coarse shelly, crinoidal grainstone (Craig-y-Gaer Coral Bed) at the base of the Gilwern Oolite Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2224 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10 m in the Clydach Gorge to 20 m on the east crop."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is a major palaeokarstic surface, with extensive dissolution and palaeosol formation of the ooidal grainstone at the top of the Formation. This is overlain by micritic limestones and green clay (Clydach Halt Member) forming the basal part of the overlying Llanelly Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Gilwern Oolite [Obsolete: use GWO]"@en ;
    skos:broader namedrockunit:CLD ;
    skos:definition "Dolostone and ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage (Carboniferous Period) (346.7-344.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:CYGC ;
    skos:notation "GWO"@en ;
    skos:prefLabel "Gilwern Oolite Formation"@en ;
.

namedrockunit:GYA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey to green, massive to autobrecciated, sparsely porphyritic high-silica andesite or dacite. Locally grades to monomictic (andesite-clast) block-breccia in Bardon Quarry."@en ;
    lexicon:hasLowerBoundaryDefinition "All boundaries seen are faulted, except where one small sheet is chilled against the Peldar Dacite Breccia in Whitwick Quarry."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1580 ,
        namedrockunit:H2225 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasOldestAgeValue 6.35e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LD> ;
    lexicon:hasThicknessDescription "0-500m"@en ;
    lexicon:hasUpperBoundaryDefinition "All boundaries seen are faulted, except where one small sheet is chilled against the Peldar Dacite Breccia in Whitwick Quarry."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AD> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bardon 'Good Rock' [Obsolete: use GYA]"@en ,
        "Grimley-Type Porphyroid [Obsolete: use GYA]"@en ;
    skos:broader namedrockunit:WVO ;
    skos:definition "Andesite with subsidiary volcaniclastic-breccia. Bedrock. Occurs onshore. Formed during the Ediacaran Period (Precambrian) (635-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GYA"@en ;
    skos:prefLabel "Grimley Andesite"@en ;
.

