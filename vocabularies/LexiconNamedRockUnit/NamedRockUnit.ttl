namedrockunit:BYTH
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation encompasses fluvial, lacustrine and organic deposits of the Bytham River. Commonly a basal coarse-grained gravel is overlain by red fine- to medium-grained sand. The gravels are composed of Triassic grey and purple quartzite, vein quartz, Jurassic limestone and ironstone, and Carboniferous sandstone and chert. Sedimentary structures imply deposition in a braided river environment. The gravels are distringuished from the Baginton Sand and Gravel Formation to the west by their including a significant proportion of Jurassic as well as Triassic material."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformably overlies Jurassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3890 ,
        namedrockunit:H744 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Individual aggradations are usually 3 to 5 m thick; may total 18 m locally."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by Middle Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is usually helpful."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bytham Formation [Obsolete: use BYTH]"@en ,
        "Bytham Sands and Gravels Formation [Obsolete: use BYTH]"@en ;
    skos:broader namedrockunit:BYCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BYTH"@en ;
    skos:prefLabel "Bytham Sand and Gravel Formation"@en ;
.

