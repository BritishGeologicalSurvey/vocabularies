namedrockunit:SOCG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WACKE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Subvolcanic explosion-breccia composite vent, comprising: carbonated vent agglomerate of wacke clasts in a fine-grained comminuted igneous matrix, altered bioitite-bearing olivine basaltic intrusion and kersantite intrusions."@en ;
    lexicon:hasLowerBoundaryDefinition "The intrusive contacts with the country rock of Llandovery Turbidites is poorly exposed, which together with diffuse internal structures, makes field relationships difficult to define."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/WT> ;
    lexicon:hasThicknessDescription "Thickness not known, but individual vents vary from 5 x 50 m, to 250 x 100 m. This unit may be one vent with two small subsidiary vents."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BSTM ;
    skos:definition "Basalt, volcaniclastic-breccia and wacke. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SOCG"@en ;
    skos:prefLabel "Shoulder O'Craig Vent"@en ;
.

