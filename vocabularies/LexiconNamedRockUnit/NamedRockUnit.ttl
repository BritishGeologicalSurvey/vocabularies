    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey, pale brownish grey to grey, fine- to medium-grained calcarenites, thick-bedded with scattered crinoid debris; mainly biosparites, but biopelsparites and pelsparites also occur. Peloidal calcarenites are present in the lower part and the back reef facies. Pedogenic crusts and palaeokarstic features are common on many of the major bedding planes. Towards the apron reef, the limestones become increasingly micritic and poorly bedded, with more peloids and ooids and the local development of conglomeratic limestones.Two volcanic members are present, namely the Ravensdale Tuff and the Lower Miller's Dale Lava."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken where the top of the highest dark micritic or calcilutitic bed of the Woo Dale Limestone Formation is overlain by pale grey limestone of the Bee Low Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:ALFL ,
        namedrockunit:H1992 ,
        namedrockunit:H3226 ,
        namedrockunit:H4470 ,
        namedrockunit:HW ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 68 to 213m in the Buxton district, with 161.94m measured in the BGS Eyam Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken where the base of the lowest dark limestone bed of the Monsal Dale Limestone Formation overlies the pale grey limestone of the Bee Low Limestone Formation. Volcanic horizons (including the Upper Miller's Dale Lava Member and the Winstermoor Lava Member or equivalent beds of altered clay) intervene locally."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
