namedrockunit:LF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded pale siliceous and feldspathic siltstones and greenish grey to buff micaceous mudstones, locally with abundant Lingulella davisii."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformity and gradationally overlies mudstones of the Menevian Group."@en ;
