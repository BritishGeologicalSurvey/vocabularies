    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasUpperBoundaryDefinition "Diachronous, interfingering with and passing upwards into the Teith (former Edzell Sandstone) formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CXF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
