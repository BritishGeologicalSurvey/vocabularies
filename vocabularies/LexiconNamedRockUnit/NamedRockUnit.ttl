namedrockunit:MI
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WVR ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DLMDM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMMD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the type area, comprises well-bedded mid-grey, crinoidal \"biosparites\" and dark grey cherty micrites of an inter-reef facies, passing vertically and laterally into knoll reef mud-mounds of poorly bedded grey micrite, which are locally partially or completely dolomitised. In the Loughborough area, comprises grey to buff, thin to thickly bedded, fine- to coarse-grained, locally pebbly dolostones, whereas altered tuff and vesicular basaltic lava are recorded in the Gun Hill Borehole (SJ96SE  18), [SJ9723 6182] between depths at 709 and 770.5m."@en ;
    lexicon:hasLowerBoundaryDefinition "Only seen in the Caldon Low Borehole, where fine-grained pale grey-white dolostones comprising the Rue Hill Dolomite, of Tournaisian age, pass up rapidly into a predominantly limestone sequence of the Milldale Limestone Formation, with the base of the Milldale Limestone Formation taken at the base of a 2cm-thick black fissile mudstone overlying 2.35m of very fine-grained dolostone. In the Hathern No.1 Hydrocarbon Borehole (SK52SW 3) [SK 5158 2416] limestones interpreted as the Milldale Limestone Formation are underlain by anhydrite, limestone and dolostone of the Hathern Anhydrite Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2323 ,
        namedrockunit:WVR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 305m in the type area, 470m in the Caldon Low Borehole (SK04NE 36) [SK 0804 4823], at least 380m at Breedon Hill, and 791.55m recorded in the Gun Hill Borehole (SJ96SE 18) [SJ 9723 6182], located 13km northwest of the Manifold Valley inlier."@en ;
    lexicon:hasUpperBoundaryDefinition "Seen as a rapid upward transition, from dark cherty micritic limestones to: a) grey coarsely bioclastic conglomeratic limestones of the Hopedale Limestone Formation;  b) to thicker bedded, paler peloidal and crinoidal bioclastic limestone of the Ecton Limestone Formation;  c) poorly sorted conglomerate of reef limestone pebbles at the base of the Kevin Limestone Formation; or d) a sharp discomformity at the base of dark to pale brown and grey calcareous mudstone and thinly bedded argillaceous limestones of the Widmerpool Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Milldale Limestones [Obsolete: use MI]"@en ,
        "Weaver Beds [Obsolete: use MI]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolomitic limestone, limestone and mudstone with subsidiary mudmound dolostone and mudmound limestone and trace basalt and chert. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage - to - Asbian Substage (Carboniferous Period) (359.3-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:HYBH ,
        namedrockunit:MIDK ,
        namedrockunit:MIK ;
    skos:notation "MI"@en ;
    skos:prefLabel "Milldale Limestone Formation"@en ;
.

namedrockunit:MRB
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:IDA ,
        namedrockunit:MRWB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FGSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandy, shell-fragmental and ooidal ferruginous limestone interbedded with ferruginous calcareous sandstone, and generally subordinate ferruginous mudstone beds. Locally any of these lithologies may pass by increase in iron content into generally ooidal ironstone, and in places any of these may dominate. The iron content (as ooids, altered shell material or in the groundmass) is berthierine (dark green iron-rich layered silicate formed in low-oxygen marine conditions), altering to siderite. Fossil content variable throughout but locally abundant especially in limestone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "At downward change to mudstone/siltstone of the Dyrham Formation, or (in East Midlands Shelf north) mudstone of Charmouth Mudstone Formation; base typically erosive and conglomeratic. Locally may rest on a sandstone bed at the top of the Dyrham Formation, which it may be impractical to map separately from the Marlstone Rock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1709 ,
        namedrockunit:H1710 ,
        namedrockunit:H2328 ,
        namedrockunit:H4803 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To about 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "At upward change to mudstone/nodular limestones of the Whitby Mudstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ida Formation"@en ,
        "Marlstone Rock Bed [Obsolete: use MRB]"@en ,
        "Marlstone Rock Member (Wessex Basin)"@en ,
        "Marlstone Rock Member [Obsolete: use MRB]"@en ,
        "Marlstone Rock [Obsolete: use MRB]"@en ,
        "Marlstone [Obsolete: use MRB]"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Ferruginous limestone, ferruginous sandstone, ironstone and ooid-ironstone with subsidiary calcareous sandstone, ferruginous mudstone and limestone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Pliensbachian Age - to - Toarcian Age (Jurassic Period) (192.9-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MRB"@en ;
    skos:prefLabel "Marlstone Rock Formation"@en ;
.

namedrockunit:NSK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
