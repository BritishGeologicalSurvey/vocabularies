    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "4.27m at type section, 20-30m over most of Midlands."@en ;
    lexicon:hasUpperBoundaryDefinition "Placed at the base of an interbedded argillaceous limestone ('cementstone') and mudstone sequence. At base of Bed 22 at type section. (Donovan, 1956)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasYoungestAgeValue 1.995e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Angulata Beds [Obsolete: use SASH]"@en ,
        "Psiloceras Shales [Obsolete: use SASH]"@en ;
    skos:broader namedrockunit:BLI ;
    skos:definition "Calcareous mudstone and mudstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Rhaetian Age (Triassic Period) - to - Hettangian Age (Jurassic Period) (205.7-199.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SASH"@en ;
    skos:prefLabel "Saltford Shale Member"@en ;
