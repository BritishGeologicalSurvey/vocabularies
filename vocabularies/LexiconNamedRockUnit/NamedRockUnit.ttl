namedrockunit:TRB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/S> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FECRTE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red-brown, gritty, argillaceous sandstones and very subordinate siltstones and mudstones with scattered thin to medium tabular beds of medium- to coarse-grained greyish purple quartzite. Calcretes, ferricretes and desiccation cracks occur sporadically. Breccias are also present, deposited in proximal settings."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal boundary of the formation is sharp but conformable with the underlying Mynydd Myddfai Sandstone Formation in the Afon Sawdde."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4936 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SG> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
