    lexicon:hasOldestAgeValue 2.744e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Highly variable, generally 0-15m but can range up to 55m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharply and in places unconformably overlain by sandstones or mudstones of Permian to Triassic age."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Moira Breccia [Obsolete: use HPBR, MOI]"@en ,
        "Permian Breccias or Marls [Obsolete: use MOI]"@en ;
    skos:broader namedrockunit:SSG ;
    skos:definition "Breccia with subsidiary mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Guadalupian Epoch (Permian Period) - to - Anisian Age (Triassic Period) (274.4-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MOI"@en ;
    skos:prefLabel "Moira Formation"@en ;
