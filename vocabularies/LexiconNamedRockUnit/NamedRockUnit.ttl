namedrockunit:GORS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brownish black, paralic mudstones with locally abundant coal fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal boundary of the Gorse Member (and Heather Formation) may be conformable or unconformable. It is defined by a down-section passage from mudstones to thinly bedded sandstones, mudstones and coals (Stroma Member, Pentland Formation).  It is marked by a sharp down-section decrease in gamma-ray and velocity values.  In some sections, the member is seen to rest unconformably on Triassic reddish and grey-brown mudstones (Smith Bank Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5143 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to c. 60 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by a down-section change from grey mudstone (Heather Formation) to brownish black mudstones; a down-section increase in resisitivity, a decrease in velocity and, often, a temporary increase in gamma."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Skene Member [Obsolete: use GORS, STRM]"@en ;
    skos:broader namedrockunit:HTHE ;
    skos:definition "Mudstone. Stratified bedrock. Occurs offshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GORS"@en ;
    skos:prefLabel "Gorse Mudstone Member"@en ;
