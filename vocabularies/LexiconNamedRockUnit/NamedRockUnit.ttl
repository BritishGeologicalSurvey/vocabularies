namedrockunit:ACLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAROCM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Plagioclase-microphyric basalts (Jedburgh type). Some mugearite and interbedded cone-facies tuffs. On the Langs Craigs [2430 6760] there is an olivine-clinopyroxene-macrophyric basalt lava (Craiglockhart type)."@en ;
    lexicon:hasLowerBoundaryDefinition "In the area around Saughen Braes [NS 462 783] the Auchineden Lava Member is underlain by, and interdigitates with, the Saughen Braes Lava Member. To the north and west of the outcrop, the Auchineden Lava Member is directly underlain by the Burncrooks Volcaniclastic Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4419 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0-100 m very variable. Thins out to north-east and south-west."@en ;
    lexicon:hasUpperBoundaryDefinition "The Auchineden Lava Member is overlain by the plagioclase-macrophyric lavas of the Carbeth Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Auchineden Lavas [Obsolete: use ACLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Plagioclase-microphyric basalt with subsidiary trachybasalt and trace olivine-clinopyroxene-macrophyric basaltic-rock. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ACLA"@en ;
    skos:prefLabel "Auchineden Lava Member"@en ;
.

