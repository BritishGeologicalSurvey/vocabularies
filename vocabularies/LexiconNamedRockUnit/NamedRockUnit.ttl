namedrockunit:ARPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDIAMT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium- to thickly-bedded psammite and semipelite; coastal section contains a basal quartzite member; elsewhere locally contains units of 'boulder bed', a metadiamicton with sparse cobble clasts of granitic and metasedimentary rocks."@en ;
    lexicon:hasLowerBoundaryDefinition "Base faulted out in coast section; elsewhere rapid transition is inferred from graphitic semipelites and limestones of Fordyce Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H26 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Increases from c.75m at Newton [542 619] to c.200m at coast, where it is partly repeated by a ductile thrust of the Keith Shear Zone."@en ;
    lexicon:hasUpperBoundaryDefinition "Change from interbedded psammite and semipelite to thick-bedded quartzite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Durn Hill Quartzite [Obsolete: use ARPS]"@en ;
    skos:broader namedrockunit:DBIS ;
    skos:definition "Psammite, quartzite and semipelite with subsidiary metadiamictite and trace micaceous psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:REDQ ;
    skos:notation "ARPS"@en ;
    skos:prefLabel "Arnbath Psammite Formation"@en ;
.

namedrockunit:ARYL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A thickly-bedded, pale grey, nodular limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably directly on Caledonian igneous or Precambrian Moine [basement] rocks as the basal unit of the Bighouse Formation on the Middle Old Red Sandstone unconformity. Locally interbedded with conglomerates of the Portskerra Conglomerate Member."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1954 ,
        namedrockunit:H1955 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "From 3.5m to 4.0m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by interbedded, sandstone-dominated rhythmic sequence of sandstones, siltstones and laminated carbonate mudstones (fish beds) of the Baligill Limestone Member of the Bighouse Formation. At the type section site, however, the unit is instead overlain directly by a thin bed of angular pebbly conglomerate."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Gunnscroft Limestone Bed [Obsolete: use ARYL]"@en ,
        "Marginal Limestone at Aryleive [Obsolete: use ARYL]"@en ;
    skos:broader namedrockunit:PSKA ;
    skos:definition "Limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ARYL"@en ;
    skos:prefLabel "Aryleive Limestone Bed"@en ;
.

namedrockunit:ASAG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Aldeby Sand and Gravel Member is lithogically very variable; it is composed predominantly of sand and gravel that also contains lenses of reworked chalky till, discrete beds of clay and silt, reconstituted chalk and masses of sand transported and apparently derived from the Happisburgh Formation. The gravel fraction is composed predominantly of clasts of angular flint with some quartz and quartzite. In places beds of well-rounded flint and quartz gravel are present. The Member is thought to have formed during wastage of the Lowestoft ice from the adjacent higher ground."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, most commonly overlies silt- and clay-rich chalky till (diamicton) of the Lowestoft Formation, but also locally overlies well-sorted sands and gravels of the Crag Group and Happisburgh Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3806 ,
        namedrockunit:LGRV ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Thicknesses are imprecisely known but 18m was exposed at Oaklands Pit, Aldeby and 4m at Aldeby Quarry, (see Stratotypes)."@en ;
    lexicon:hasUpperBoundaryDefinition "The Aldeby Sand and Gravel is overlain unconformably by variable Head deposits, and peat and silt of the Breydon Formation, and locally by river terrace sand and gravel of the Britannia Catchments Group. The overlying sand and gravel is typically better sorted and more well bedded."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Aldeby Sands and Gravels [Obsolete: use ASAG]"@en ,
        "Lowestoft Gravel Member [Obsolete: use ASAG]"@en ;
    skos:broader namedrockunit:LOFT ;
    skos:definition "Gravel and sand with subsidiary clay, diamicton and silt. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage (Quaternary Period) (.48-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ASAG"@en ;
    skos:prefLabel "Aldeby Sand and Gravel Member"@en ;
.

