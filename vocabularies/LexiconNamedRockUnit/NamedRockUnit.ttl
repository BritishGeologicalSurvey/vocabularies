namedrockunit:HOHI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """A pale to dark grey, typically darker towards the base, micritic to crystalline limestone, with subordinate partings and thin beds of dark grey shale, and locally abundant chert, crinoid and brachiopod debris. A thin vesicular brecciated basalt is present near the base of the type locality, and dolostone or dolomitic limestone is predominant in the basal 120 m above this. \r
\r
Shallow water platform to ramp carbonates. Chadian to Brigantian."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of grey and grey-brown dolostone of the Holme High Limestone Group, resting unconformably upon Lower Palaeozoic green slate strata in the type locality."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4550 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Seen as 613 m in the type locality, though seismic surveys over the high suggest that the group may be up to 1250 m thick (Evans and Kirby, 1999)."@en ;
    lexicon:hasUpperBoundaryDefinition "The sharply conformable base of overlying dark grey, carbonaceous, fissile mudstone of the Bowland Shale Formation, above the pale grey limestone of the Holme High Limestone Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Carboniferous Limestone [Obsolete: use CL, PKLM, CLWYD, PEMB, BOHI, HOHI, TRLI]"@en ;
    skos:broader namedrockunit:CL ;
    skos:definition "Dolomitic limestone and limestone with subsidiary mudstone and trace basalt. Stratified bedrock. Occurs onshore. Deposited during the Chadian Substage - to - Brigantian Substage (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HOHI"@en ;
    skos:prefLabel "Holme High Limestone Group"@en ;
.

