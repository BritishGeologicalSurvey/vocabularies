    lexicon:hasThicknessDescription "Some 2.5m at Allt na Teangaidh on Mull, about 1.9m at Feorlin tributary section [NM 5317 2225], 0.92 m at the type site on Beinn Iadain."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is disconformable at a sharp contact beneath Paleocene lavas."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasYoungestAgeValue 5.6e+01 ;
