namedrockunit:DSV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGBAO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MFLAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "(a) Basic lava (b) Tuff and tuffaceous sandstone (c) Agglomerate extrusions associated with sills of olivine-dolerite and teschenite locally, which can be distinguished only at coastal exposure. NOTE: The recognised lithologies crop out extensively on the Deerness Peninsula, Orkney. Poor exposure makes subdivision impractical inland, though intrusive and extrusive rock types have been recognised at some sites. Where intrusive basic rocks are recognised they are excluded from the Member. The name is changed from Eday Lavas because some of the rocks are sills, the Eday Flagstone, Eday Sandstone, etc. already exist, and the volcanic rocks do not occur on Eday, which is the type site for the remainder of the Eday sequence."@en ;
    lexicon:hasLowerBoundaryDefinition "(a) Conformable contact on Eday Flagstone, (b) Conformable contact on Eday Flagstone, (c) Conformable and cross cutting contacts within lavas."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:EDL ,
        namedrockunit:H219 ,
        namedrockunit:H2769 ,
        namedrockunit:H4009 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasOldestAgeValue 3.853e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "(a) 2 flows: one >7m, second thin (0.5m) (b) 5m at Muckle Castle type section (c) unknown-thin."@en ;
    lexicon:hasUpperBoundaryDefinition "(a) Conformably overlain by tuffaceous sandstone within Eday Flagstone, (b) Conformably overlain by Eday Flagstone, (c) Conformable with Eday Flags and conformable/cross-cutting within lavas."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Alkaline basic igneous rocks in the Orkneys [Obsolete: use DSV]"@en ,
        "Eday Lavas [Obsolete: use DSV]"@en ,
        "Eday Volcanic Rocks [Obsolete: use DSV]"@en ,
        "Eday Volcanics [Obsolete: use DSV]"@en ;
    skos:broader namedrockunit:EDF ;
    skos:definition "Agglomerate, dolerite, mafic lava, olivine analcime-microgabbro and tuff with subsidiary lava and trace basaltic-rock and tuffite. Stratified bedrock. Occurs onshore. Deposited during the Givetian Age (Devonian Period) (385.3-378.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DSV"@en ;
    skos:prefLabel "Deerness Volcanic Member"@en ;
