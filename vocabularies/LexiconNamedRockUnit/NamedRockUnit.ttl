namedrockunit:GBV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Volcaniclastic sandstones and siltstones, purple brown and well bedded. In the Glenburn Borehole volcaniclastic sedimentary rocks and agglomerates are interbedded with several (thin) lava flows."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary was penetrated by the BGS Glenburn Borehole [2478 6607] which shows that the lavas with interbedded volcaniclastic sedimentary rocks rest upon the Kinneswood Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GPVD ,
        namedrockunit:H4070 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "30 m+."@en ;
    lexicon:hasUpperBoundaryDefinition "In a waterfall at Craigie Linn [2475 6605] the vocaniclastic sedimentary rocks are overlain by a massive flow of plagioclase-microphyric basalt (Jedburgh type) which here marks the base of the Gleniffer Lava Member. Elsewhere the unit is overlain by the distinctive olivine-bearing plagioclase-macrophyric basalts (Markle type) that are characteristic of the overlying Gleniffer Lava Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glen Park Volcanic Detrital Member [Obsolete: use GBV]"@en ,
        "Glenburn Volcanic Detrital Member [Obsolete: use GBV, GPVD]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Volcaniclastic-sandstone and volcaniclastic-siltstone with subsidiary agglomerate and basalt lava. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GBV"@en ;
    skos:prefLabel "Glenburn Volcaniclastic Member"@en ;
