namedrockunit:DHMU
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Dornoch Mudstone unit typically displays an overall upward coarsening from silty mudstone to muddy siltstone. In many distal sections, a gamma-ray peak occurs within the mudstone section, as in 9/18a-4, 21/1-6. In more proximal sections, the Dornoch Mudstone consists of a single upward-coarsening unit, with the highest gamma-ray values occurring at the base (e.g. 14/25-1)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GPL> ;
    lexicon:hasOldestAgeValue 5.92e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GEE> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
