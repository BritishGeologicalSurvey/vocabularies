        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Fine to coarse grained, massive and cross bedded, locally pebbly sandstones, with minor interbedded mudstone and siltstone."@en ;
    lexicon:hasLowerBoundaryDefinition "The first sandstone or sandstones above the Verneulites sigma or Bilinguites Marine Bands. If no marine bands have been proved, it is the base of the second main sandstone or sandstones below the top of the Millstone Grit Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1426 ,
        namedrockunit:RVG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CZ> ;
