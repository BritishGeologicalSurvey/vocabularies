namedrockunit:WAHL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale brown, massive, very fine-grained sand and silt, typically with vertical cracks, containing rounded concretions and sparse pebbles. Grading upwards into horizontally stratified, very fine-grained sand and silt, with thin beds of coarser sand and stringers of fine pebbles."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, conformable, draped contact with underlying dark grey, shelly, silty sandy gravelly diamicton of the Warren House Gill Till Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LOES ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasOldestAgeValue 3.62e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "To 4 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Planar, subhorizontal to gently undulating, gradational glacitectonic contact with overlying dark grey, stiff, sandy, silty stony clay diamicton of the Blackhall Till Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Loess"@en ;
    skos:broader namedrockunit:WAHG ;
    skos:definition "Sand with subsidiary silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Wolstonian Stage (Quaternary Period) (.362-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WAHL"@en ;
    skos:prefLabel "Warren House Gill Loess Bed"@en ;
.

namedrockunit:WAL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANLTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ;
