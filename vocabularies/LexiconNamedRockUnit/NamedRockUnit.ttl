    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 - 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unexposed, but probably an upwards fining transition to grey, slaty mudrocks of the overlying Swithland Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasYoungestAgeValue 4.869e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Stable Pit Quartzite Member [Obsolete: use CBSP]"@en ;
    skos:broader namedrockunit:BRHI ;
    skos:definition "Sandstone and wacke with subsidiary siltstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Cambrian Period (541-486.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBSP"@en ;
    skos:prefLabel "Stable Pit Member"@en ;
