        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Diamicton, olive-grey, very stiff, fissile, with sparse shell material and silty sand. See also details of the Dalroy Sand (DROY), Clava Lodge Clay (CLOCL) and Culdoich Till (CUTI) members."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, glacitectonic boundary of the Clava Lodge Clay Member of the Clava Shelly Formation with the Drummore Gravel Formation below."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "11m at type section"@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, glacitectonic boundary with Finglack Till Formation above."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCD ;
    skos:definition "Clay, diamicton and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CLOCL ,
        namedrockunit:CUTI ,
        namedrockunit:DROY ;
    skos:notation "CLSH"@en ;
    skos:prefLabel "Clava Shelly Formation"@en ;
.

