    lexicon:hasThicknessDescription "400-500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable; at top of highest basaltic lava on tuff in transition to sediments of Pathhead or Lower Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
