namedrockunit:FWTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically a hard, moderate reddish brown, matrix-supported, massive, calcareous sandy silty clay diamicton, with dispersed subangular to rounded clasts up to 15cm in diameter. The clasts are mainly of red sandstone, Borrowdale Volcanic Group rocks, granite, granophyre, brown siltstone and sandstone; some coal, black shale and comminuted shell fragments."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally planar or undulating contact on the Drigg Holme Sand Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4662 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically c.2.5m, but up to c.5m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by silts, sands and clays of the Drigg Moorside Silt Member of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Upper Boulder Clay [Obsolete: use FWTI, GOGL, HMTI, PKSA, PLBT, RSTI, STPTG]"@en ;
    skos:broader namedrockunit:GOGL ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FWTI"@en ;
    skos:prefLabel "Fishgarth Wood Till Member"@en ;
.

namedrockunit:FZLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCPP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAPMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mainly plagioclase-macrophyric basalts (Markle type) and olivine-clinopyroxene-plagioclase basalts (Dunsapie type). Several flows of mugearite are present, two were encountered in a borehole at Crummock Park, Bieth and three in in Loanhead Quarry [NS 365 555] where a discontinuous bed of tuff is also seen. These flows are 15 m, 8 m and over 10 m thick and are separated by boles up to 50 cm thick, they are amygdaloidal with much hydrothermal alteration giving a range of secondary minerals such as calcite, prehnite, analcime, thomsonite, natrolite, bowlingite and heulandite. The quarry is well known for copper mineralisation with native copper, malachite and cuprite recorded. Some flows of plagioclase-microphyric basalt or hawaiite (Jedburgh type) and olivine-microphyric basalt (Dalmeny type) are present in the Fereneze Hills."@en ;
    lexicon:hasLowerBoundaryDefinition "The Markle- and Dunsapie-type basalts of the Fereneze Lava Member appears to cut or overlap most of the underlying Dalmeny- and Dunsapie-type lavas of the Sergeantlaw Lava Member in the area of the Fereneze Hills."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2195 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Max thickness >120 m."@en ;
    lexicon:hasUpperBoundaryDefinition "In the west of the Beith-Barrhead Hills, Bog Hall [NS 362 540] to Newton of Belltrees [NS 372 582], the Fereneze Lava Member is overlain by the olivine basalts of the Beith Lava Member. The upper boundary of the unit is not seen in the eastern Beith-Barrhead Hills."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Fereneze Lavas [Obsolete: use FZLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Olivine-clinopyroxene-plagioclase-phyric basalt and plagioclase-macrophyric basalt with subsidiary hawaiite, mugearite, olivine-microphyric basalt and plagioclase-microphyric basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FZLA"@en ;
    skos:prefLabel "Fereneze Lava Member"@en ;
.

