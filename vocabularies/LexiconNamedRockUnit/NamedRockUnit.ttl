namedrockunit:UIICP
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BSN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMPTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GNB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCGBPP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCQGB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MONCHQ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dolerite and Tholeiitic Basalt (DBAT) - quartz micro-gabbro (dolerite), basalt, basinite, camptonite or monchiquite; locally columnar jointed; Felsic Rock (FELSR) - granite, mainly biotite granite, locally lithium-mica granite in St Austell and Godolphin intrusions, with variable development of K-feldspar megacrysts."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/I> ;
    lexicon:hasThicknessDescription "Dolerite and Tholeiitic Basalt (DBAT) - Comprises 4 distinct leaves: Farne Island Sill up to about 30m; Alnwick Sill 6 to 21m; Great Whin Sill typically about 30m, locally up to 90m in Weardale and Little Whin Sill up to 13m. Felsic Rock (FELSR) - 10 to 20 km."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Basalt, basaltic-rock, basanite, biotite granite, dolerite, granite, monchiquite and quartz-microgabbro with subsidiary camptonite and trace plagioclase-phyric microgabbro. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Carboniferous Period - to - Permian Period (359.3-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:notation "UIICP"@en ;
    skos:prefLabel "Unnamed Igneous Intrusion, Carboniferous to Permian"@en ;
