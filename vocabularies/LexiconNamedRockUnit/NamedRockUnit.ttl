namedrockunit:STAT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The formation comprises interbedded sandstones, siltstones, mudstones and occasional minor coals. In the East Shetland Basin, sandstones are pale grey to white, fine- to very coarse-grained, sometimes pebbly, micaceous, variably kaolinitic and sometimes cross-bedded. Siltstones and mudstones are grey, green, reddish-brown, occasionally red, micaceous and sometimes carbonaceous. Coal seams up to 3.5 m thick occur locally. \r
\r
In the Beryl Embayment sandstone beds usually have sharp bases and frequently form upward fining cycles. Cross-bedding and ripple-lamination are present. Carbonized wood is present. Thin sandstones, which are interbedded with siltstones, mudstones and coal, show parallel to sub-parallel laminations, ripple laminations and water escape structures. The associated mudstones are mid-grey, generally blocky and massive (but occasionally fissile)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by a downward change from mainly pale grey, white and green coloured, mainly arenaceous deposits to predominantly red argillaceous facies (Cormorant Formation). A down-section increase in gamma values may occur."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5195 ,
        namedrockunit:H5203 ,
        namedrockunit:H5204 ,
        namedrockunit:H5205 ,
        namedrockunit:H5206 ,
        namedrockunit:H5207 ,
        namedrockunit:H5208 ,
        namedrockunit:H5209 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TR> ;
    lexicon:hasOldestAgeValue 2.057e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "East Shetland Basin: up to more than 300 m. Beryl Embayment: up to c. 80 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Defined by a downward change from sandstones (Nansen Formation) to interbedded sandstones, mudstones and minor coals, associated with a down-section increase in gamma values and a more erratic gamma-ray log response."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eriksson Formation [Obsolete: use STAT]"@en ,
        "Eriksson Member [Obsolete: use STAT]"@en ,
        "Lower Beryl Sandstone 1 [Obsolete: use STAT]"@en ,
        "Lower Formation [Obsolete: use STAT]"@en ,
        "Nansen Member [Obsolete: use NANN, STAT]"@en ,
        "Raude Member [Obsolete: use STAT]"@en ,
        "Scott Formation [Obsolete: use STAT]"@en ,
        "Statfjord Sand Formation [Obsolete: use STAT]"@en ;
    skos:broader namedrockunit:BAKS ;
    skos:definition "Sandstone with subsidiary mudstone and siltstone and trace coal. Stratified bedrock. Occurs offshore. Deposited during the Rhaetian Age (Triassic Period) - to - Sinemurian Age (Jurassic Period) (205.7-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STAT"@en ;
    skos:prefLabel "Statfjord Formation"@en ;
.

namedrockunit:STK
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:S452 ,
        namedrockunit:SCSH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The term Stockdale Group was introduced by Kneller et al. (1994) to include the mudstone and siltstone sequence of latest Hirnantian and Llandovery age which occurs throughout the Lake District, Cross Fell, Cautley and Dent, and Craven inliers. \r
\r
Uppermost Ashgill (Hirnantian in part) and Llandovery."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary of the group coincides with the base of the Skelgill Mudstone Formation. Unconformably overlies the Red Gill Formation of the Dent Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CMK ,
        namedrockunit:H2413 ,
        namedrockunit:H3661 ,
        namedrockunit:H4556 ;
