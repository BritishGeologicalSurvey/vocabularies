namedrockunit:SQLM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Well-bedded, thin and thick beds of mid and mid dark grey, fine- to coarse-grained limestone, with minor mudstone beds. Bioclastic packstones characterize the lower part of the Member, passing up to packstones and grainstones. Bands and nodules of black chert occur locally in the lower part of the Member. The member contains an abundant macrofauna, characterized by cerioid and fasciculate lithostrotionids."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where grey limestone of the Scaleber Quarry Limestone Member overlies dark grey limestone and mudstones of the Scaleber Force Limestone Member. This boundary is typically gradational and for convenience the base is taken at top of highest prominent mudstone."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1626 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To 134m thick at the type locality, decreasing to 29m at outcrop at Kilnsey Crag."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Member is drawn at the conformable, gradational and slightly diachronous upward passage from mid dark-grey limestone of the Scaleber Quarry Limestone Member to the pale grey limestone of the Cove Limestone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kilnsey Limestone [Obsolete: use SQLM, KLSL]"@en ;
    skos:broader namedrockunit:KLSL ;
    skos:definition "Limestone and trace chert and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage (Carboniferous Period) (343-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SQLM"@en ;
    skos:prefLabel "Scaleber Quarry Limestone Member"@en ;
.

