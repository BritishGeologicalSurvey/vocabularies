    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 4m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Third Terrace of the Ouse [Obsolete: use BIDM]"@en ;
    skos:broader namedrockunit:OUSE ;
    skos:definition "Gravel with subsidiary sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BIDM"@en ;
    skos:prefLabel "Biddenham Member"@en ;
.

namedrockunit:BIES
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SVZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominantly yellow to pale brown and reddish yellow slightly clayey to slightly silty sand with local fine-grained gravels. The material is usually reddish brown and grey colour mottled as a result of near surface water processes. It is typically composed of moderately well sorted medium-grained quartz grains with minor bands of finer, coarser or pooly sorted material, including flint and chert. Thin beds (<5cm) of clayey sandy peat can occur within the unit."@en ;
    lexicon:hasLowerBoundaryDefinition "The Bielby Sand Member rests mainly on the Pocklington Gravel Formation or the Hemingbrough Glaciolacustrine Formation. In places there is a thin peat bed at the base. The contact is commonly sharp but locally gradational, with an increase in clay, gravel and/or peat content. North of Bielby, an increase in gravel and peat content marks the lower boundary."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:SDVY ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "General thickness is between 1 and 2m, but it can exceed 6m in parts and may form elevated topographic features."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper surface of the Bielby Sand Member is usually eroded and overlain by younger alluvial and aeolian deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Sands of 25-Foot Drift of Vale of York [Obsolete: use BIES, BREI, NABS, SKIS]"@en ;
    skos:broader namedrockunit:BREI ;
    skos:definition "Clayey sand and silty sand with subsidiary silty gravelly sand and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BIES"@en ;
    skos:prefLabel "Bielby Sand Member"@en ;
.

