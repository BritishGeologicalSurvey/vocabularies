namedrockunit:CKML
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOP"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Olivine-phyric basalt and tholeiitic andesite. Up to four sheets of massive to intensely amygdaloidal and scoriaceous rock, dark blue-grey to grey. Interpreted to be lavas. No intercalated pyroclastic or sedimentary rocks are present."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at base of lowest basalt sheet that conformably overlies conglomerate of the Marsett Formation; the formation oversteps the eastwards, unconformably to overlie the Skiddaw and Eycott groups."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3933 ,
        namedrockunit:H3934 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "105m in the Cockermouth area, thinning to 30m near Sunderland; 67m thick in the type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by interbedded mudstone, sandstone and thin limestone of the Marsett Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cockermouth Lavas Formation [Obsolete: use CKML]"@en ,
        "Cockermouth Lavas [Obsolete: use CKML]"@en ;
    skos:broader namedrockunit:RVS ;
    skos:definition "Olivine-phyric basalt with subsidiary andesite. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CKML"@en ;
    skos:prefLabel "Cockermouth Volcanic Formation"@en ;
.

