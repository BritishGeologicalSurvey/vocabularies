namedrockunit:NHC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Includes all of the late glacial and post-glacial deposits within river catchments of the Northern Highlands and Argyll. The subgroup contains a similar suite of deposits to those of the Grampian Catchments Subgroup, but the drainage basins of the rivers are much less extensive than those of the Cromarty area. \r
\r
Sand, gravel, silt, and clay. Clasts are derived from sedimentary, metamorphic and igneous rocks cropping out in the northern and western Highlands and Argyll. \r
\r
A suite of fluvial (alluvium, river terrace) and associated organic and lacustrine deposits. \r
\r
Devensian to Holocene (MIS 2-1)."""@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable contact with units of the Northwest Highlands Glacigenic Subgroup, the Central Grampian Glacigenic Subgroup, the Banffshire Coast and Caithness Glacigenic Subgroup, and with bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Up to 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface, but units of this Subgroup locally interfinger with units of the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Gravel and sand with subsidiary clay, diamicton, peat and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LNGR ;
    skos:notation "NHC"@en ;
    skos:prefLabel "Northern Highlands and Argyll Catchments Subgroup"@en ;
.

