namedrockunit:CATC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A bimodal, clast-supported conglomerate with clasts mainly of lava, but also containing psammite, quartzite, vein-quartz and feldspar porphyry in a medium-grained lithic sandstone matrix, with single flows of andesite and three sandstone members."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable upon the eroded top of the highest lava flow of the Crawton Volcanic Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BBCO ,
        namedrockunit:CDC ,
        namedrockunit:H3903 ,
        namedrockunit:JNF ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 870 m to 1080 m thick, Carroll 1995a."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable and diachronous, north and south of the Bervie Bay Fault. The formation passes laterally westwards and northwards into the lavas of the Montrose Volcanic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DP> ;
    lexicon:hasYoungestAgeValue 4.105e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
