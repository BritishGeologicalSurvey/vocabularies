namedrockunit:TACH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FLNT"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Soft white chalk with relatively widely spaced but large flint seams."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable. As defined (Mortimore, 1986), the base of the Culver Chalk lies low in the quadrata Zone, at the Castle Hill Marl. Well-developed marls commonly occur for several metres above the Castle Hill Marls, up to and including the Pepper Box Marls, which are now taken as the base. Approximately coincident with the Arundel Sponge Beds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasOldestAgeValue 8.37e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "35 to 45 m in Sussex, about 30 m in Dorset, but can be considerably reduced where synsedimentary channelling occurs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper bounday is conformable (but see note on thickness). Inferred to be at the Whitecliff Flint at the boundary between the Sompting and Whitecliff beds of Mortimore (1986)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KC> ;
    lexicon:hasYoungestAgeValue 7.22e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CUCK ;
    skos:definition "Chalk with subsidiary calcareous mudstone and flint. Stratified bedrock. Occurs onshore. Deposited during the Campanian Age (Cretaceous Period) (83.7-72.2 Ma BP)."@en ;
