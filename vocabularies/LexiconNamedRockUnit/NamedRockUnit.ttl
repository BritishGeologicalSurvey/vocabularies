    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To c.125m"@en ;
    lexicon:hasUpperBoundaryDefinition "At base of ferruginous limestone or ironstone of the Marlstone Rock Formation or Marlstone Member of the Beacon Limestone Formation."@en ;
