namedrockunit:FRM
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, reddish-orange, predominantly fine-grained; well-sorted with spherical to subspherical-grains; large-scale dune bedding common; characrterised by presence of 'dome-shaped dune' structures. Weakly cemented in comparison to underlying Delamere Pebbly Sandstone Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Lowermost occurrence of non-pebbly weakly-cemented sandstone, with characteristic 'dome-shaped dune' structures on the dominantly pebbly sandstone of the underlying Delamere Pebbly Sandstone Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3812 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "55m in the Marston region, North Cheshire. 30.14m at Ford Pumping Station (SJ28NE/3), Wirral. 21.1m in the Heron Road Borehole (SJ28NW/22), Wirral."@en ;
    lexicon:hasUpperBoundaryDefinition "Uppermost occurrence of weakly-cemented non-pebbly sandstone with characteristic dome-shaped dune structures, under interbedded siltstone and subordinate sandstone of the Tarporley Siltstone Formation (Mercia Mudstone Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasYoungestAgeValue 2.415e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ;
    skos:broader namedrockunit:HEY ;
    skos:definition "Sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Early Triassic Epoch - to - Anisian Age (Triassic Period) (251.9-241.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FRM"@en ;
    skos:prefLabel "Frodsham Sandstone Member"@en ;
.

