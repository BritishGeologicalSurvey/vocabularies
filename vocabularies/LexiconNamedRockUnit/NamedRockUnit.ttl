namedrockunit:WBCO
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CLCRET"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarse, unsorted conglomerate containing clasts derived from a Precambrian source. It consists of well rounded pebbles (averaging 2 cm) and cobbles (up to 15 cm), predominately of vein quartz and dark red/brown quartzite, set in a coarse grained sandstone matrix cemented by quartz and calcite. In addition to quartz and quartzite, rare lenses up to 30 cm thick of yellow, coarse grained, cross-bedded sandstone also occur."@en ;
    lexicon:hasLowerBoundaryDefinition "At irregular erosion surface, representing a regional unconformity, where the basal conglomerate rests on the underlying red-brown sandstones of the Black Nore Sandstone Formation. A mature, masssive calcrete extends 1 to 2 m below the contact."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "At top of highest conglomerate bed, where it is overlain by sandstones of the Portishead Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:POB ;
    skos:definition "Conglomerate with subsidiary calcrete and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Famennian Age (Devonian Period) (371.1-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WBCO"@en ;
    skos:prefLabel "Woodhill Bay Congomerate Member"@en ;
.

