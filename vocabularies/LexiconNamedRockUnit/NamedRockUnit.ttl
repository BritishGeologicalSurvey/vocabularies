    lexicon:hasThicknessDescription "1 to 31.5m."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the overlying Billingham Anhydrite Formation, or where the latter has been dissolved, at the base of the overlying mudstones and siltstones of the Roxby Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PUL> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
