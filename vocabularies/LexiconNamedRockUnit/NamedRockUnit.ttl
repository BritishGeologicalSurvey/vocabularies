        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A suite of glacial, glaciofluvial and glaciolacustrine deposits that contain clasts derived predominantly from Lewisian, Torridonian, Cambrian, Caledonian igneous and Moine psammitic rocks of the northern Highlands. Including sandy diamictons (till), sand, gravel, silt and clay. Deposited by ice that radiated outwards from an ice divide positioned inland of the western seaboard of the Northern Highlands."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, unconformable contact with bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Ground surface or unconformable contact with various Flandrian deposits, predominantly peat."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CALI ;
