        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Basal glauconitic sand or sandy clay, locally with shells and flint pebbles, overlain by mottled red, orange and grey silty clay. Locally developed beds of coarse-grained cross-bedded lignitic sand."@en ;
    lexicon:hasLowerBoundaryDefinition "Glauconitic basal bed overlying Chalk at an erosive contact."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "8-30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp contact between red-stained clays and fine-grained pebbly sand of the overlying Warmwell Farm Sand."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Reading Formation"@en ;
    skos:broader namedrockunit:LC ;
    skos:definition "Clay with subsidiary sand, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WPF"@en ;
    skos:prefLabel "West Park Farm Member"@en ;
.

namedrockunit:WPIT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/H"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Woolpit Beds comprise silty clay, clayey silt and silty fine-grained sand. A detailed account is given in Bristow and Gregory (1982). Borehooles have yielded a sparse foraminiferal fauna. The Woolpit Beds are underlain and overlain by chalky till. It is generally assumed that the till is Lowestoft Formation, although this had not been proved."@en ;
    lexicon:hasLowerBoundaryDefinition "The Woolpit Beds overlie chalky till of the Lowestoft Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:BRK ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasOldestAgeValue 4.8e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Maximum recorded thickness in boreholes is 23.25 m. BGS Registered No. TL96SE/158."@en ;
    lexicon:hasUpperBoundaryDefinition "The Woolpit Beds are either at outcrop or are overlain by glaciofluvial sand and gravel and till of the Lowestoft Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Brickearth [Obsolete: use FAEOL]"@en ;
    skos:broader namedrockunit:LOFT ;
    skos:definition "Clay, sand and silt and trace shells. Stratified superficial deposits. Occurs onshore. Formed during the Anglian Stage (Quaternary Period) (.48-.423 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WPIT"@en ;
    skos:prefLabel "Woolpit Beds"@en ;
.

namedrockunit:WPSL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLTE"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Strongly folded and cleaved silvery grey slates with subordinate thin sandstones, siltstones and limestones, which are generally ferruginous and iron-stained."@en ;
    lexicon:hasLowerBoundaryDefinition "The top part of the underlying Hangman Grits are comprised of alternations of grey silty shales and siltstones, with sandstone content decreasing upwards. The basal bed of the Wild Pear Slates is a limestone bed with many fossils of Myalina; the contact is conformable with the underlying Hangman Grits, but is locally faulted."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:WPEAR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasOldestAgeValue 3.853e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Obscured by folding and faulting, but likely to be gradational and conformable; estimated to be below the lowest thick sandstone of the overlying Lester Slates and Sandstones Member (a sequence of slates, sandstones, gritty sandstones, siltstones and mudstones)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DV> ;
    lexicon:hasYoungestAgeValue 3.789e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Wild Pear Beds [Obsolete: use WPSL]"@en ;
    skos:broader namedrockunit:IFS ;
    skos:definition "Limestone and slate with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Givetian Age (Devonian Period) (385.3-378.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WPSL"@en ;
    skos:prefLabel "Wild Pear Slates Member"@en ;
.

