namedrockunit:GL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent
        namedrockunit:CTLS ,
        namedrockunit:LM1 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone (bioclastic packstone), medium to dark blue-grey, thickly bedded with thin shaly mudstone partings along uneven or wavy bedding planes. There is much crinoid debris throughout and there are many other beds rich in brachiopods and/or corals. The internal stratigraphy of the member is, in parts, remarkably consistent throughout the region and four informal divisions are recognised (Fairbairn, 1980), and referred to from the base upwards as the Bench, Main and Transitional posts and the Tumbler Beds. Beds rich in fossils are widespread. Most noteable and widespread are: the Chaetetes Band (Johnson, 1958) which occurs near the base; this comprises a sponge biostrome along with locally abundant brachiopods, corals and ostracods; within the Main Posts are the Brunton Band comprising the rare alga Calcifolium (Johnson, 1958; Cossey, et al, 2004), and the Frosterly Marble (Johnson, 1958). At the top, the Tumbler Beds, typically 2-5m thich, comprise thick beds of limestone interbedded with persistent mudstone units."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the generally conformable, sharp base of the first bed of limestone that overlies measures of the Alston Formation; in most localities the limestone directly overlies the Tuft Sandstone, a brown, micaceous fine-grained sandstone that has a rooty upper part and which locally may be overlain by a thin carbonaceous smear or a coal."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CTLS ,
        namedrockunit:H2826 ,
        namedrockunit:H3434 ,
        namedrockunit:H931 ,
        namedrockunit:ML ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "14-18m north of the Lake District;  c 12m in the Vale of Eden; 16-22m on the Alston Block; 22-24m with a maximum of 40m on the Askrigg Block and 8-15m in the Northumberland Trough; c 22m in the Langholm area and Archerbeck Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the uppermost limestone beds that is overlain by a sequence of dark grey siltstones and mudstones at the base of the Stainmore Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasYoungestAgeValue 3.27e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Catsbit Limestone [Obsolete: use GL]"@en ,
        "Dryburn Limestone [Obsolete: use GL]"@en ,
        "First Limestone (Cumbria)"@en ,
        "First Limestone [Obsolete: use GL]"@en ,
        "Great Limestone [Obsolete: use GL]"@en ,
        "Main Limestone [Obsolete: use EML, GL, GML, ORTL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage (Carboniferous Period) (330.3-327 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GL"@en ;
    skos:prefLabel "Great Limestone Member"@en ;
