    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be from 440m in the reference section in the Duneaton Water tributary to at least 1200 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the pile of volcanic rocks seen in the Duneaton Water below the Auchtitench Sandstone Formation rudites and arenites."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
