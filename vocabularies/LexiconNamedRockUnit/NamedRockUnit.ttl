        namedrockunit:WHS ,
        namedrockunit:WSEX ;
    skos:notation "W"@en ;
    skos:prefLabel "Wealden Group"@en ;
.

namedrockunit:APP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent
        namedrockunit:DSE ,
        namedrockunit:S9 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELGP"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alternating units of psammite to quartzite and semipelite to pelite in Lochaber Subgroup. In the Ballachulish and Blair Atholl Subgroups, pelitic and calcareous lithologies dominate, although one clean-washed, locally pebbly quartzite in the Ballachulish Subgroup is persistent from Donegal to Banffshire. Many of the pelitic and calcareous rocks are graphitic."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally rapid transition from monotonous psammite, generally flaggy, with thin quartzite and semipelite units of underlying Grampian Group, to better sorted psammite or quartzite and semipelite or pelite."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DA ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Typically 4km where untectonised, but thinned sequence (1km or less) occurs over structural highs."@en ;
    lexicon:hasUpperBoundaryDefinition "Transition from graphitic semipelite and limestone to psammite and quartzite with rare semipelite, or locally to diamictite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Dalradian"@en ,
        "Lower Dalradian Group [Obsolete: use APP]"@en ,
        "Scatsta Division"@en ;
    skos:broader namedrockunit:DALN ;
    skos:definition "Limestone, pelite, psammite, quartzite and semipelite with subsidiary dolomitic limestone and trace breccia, calcsilicate-rock, graphitic pelite and metalimestone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
