        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCABR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Calcareous, banded psammite and semipelite, grey and pale green, normally flaggy. Some beds of impure metalimestone locally."@en ;
    lexicon:hasLowerBoundaryDefinition "At incoming of calcareous (greenish, tremolite-bearing) psammites and semipelites above the non-calcareous Findlater Flag Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription ">50 - 1200m (based on outcrop width and average dip). Real thickness is probably closer to lower estimate, owing to prevalent open folds."@en ;
    lexicon:hasUpperBoundaryDefinition "Below graphitic pelites with beds of pure metalimestone comprising the Mortlach Graphitic Schist Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DALO ;
    skos:definition "Psammite and semipelite with subsidiary limestone and quartzite and trace brecciated quartzite, calcareous psammite, calcareous semipelite and metacarbonate-rock. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:DRUC ;
    skos:notation "PCFL"@en ;
    skos:prefLabel "Pitlurg Calcareous Flag Formation"@en ;
