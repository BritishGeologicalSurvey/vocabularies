    skos:altLabel "Farragon Beds [Obsolete: use FAVO]"@en ;
    skos:broader namedrockunit:DBED ;
    skos:definition "Hornblende schist, metalava and metatuff with subsidiary psammite and trace amphibolite and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "FAVO"@en ;
    skos:prefLabel "Farragon Volcanic Formation"@en ;
