namedrockunit:WPN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish-brown silty, clayey, sand and weakly cemented sandstone, with some clayey silt, mudstone and breccia units."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests directly and unconformably on Crackington Formation (Namurian), except where local patches of basalt intervene. A marked hiatus is present between the basalts at 290 Ma, and the Whipton Formation at c.260 Ma."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "20m (Ide area), 25m at least (Exeter City centre), c.60m (type section), 10m (Pinhoe [c.SX 970 943])."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain mostly by Alphington Breccia; junction gradational over a vertical interval of about 10m, with upward passage into breccia. Overlain by Monkerton Formation around [SX 965 940]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Sand and sandstone with subsidiary breccia, mudstone and silt. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WPN"@en ;
    skos:prefLabel "Whipton Formation"@en ;
.

