namedrockunit:LGFL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of several thin (six of 0.04 to 0.14 m thick in type section) probably impersistent limestone beds separated by mudstone beds (up to 0.3m thick). Limestones are hard, grey, brown-weathering, silty, bioclastic, fine- to medium-grained, with numerous bored Gryphaea and Pseudopecten. Fauna also includes gastropods, other bivalves, ostracods and echinoderms. Forms a weak feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey mudstone with phosphatic nodules of the undifferentiated Foston Member; at 30.90 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H361 ,
        namedrockunit:H4160 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1.0 to 3.5 m; 1.39 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up from grey mudstone of the undifferentiated Foston Member; at 29.51 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lodge Farm Limestone [Obsolete: use LGFL]"@en ,
        "Plungar Ironstone [Obsolete: use LGFL, STBL]"@en ;
    skos:broader namedrockunit:FSTL ;
