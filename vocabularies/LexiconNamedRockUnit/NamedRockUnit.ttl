namedrockunit:BHSF
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use HEY] Sandstone, red, medium-grained with well-rounded \"millet seed\" grains, cross-stratified, interbedded with mudstone, red-brown and grey-green, and sandstone, brown, fine-grained, flaggy, micaceous."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable, within a gradational, interdigitating transition from the red, fine- to medium-grained sandstones of the Wilmslow Sandstone Formation to the interbedded red and green mudstone, brown flaggy sandstone and red-brown cross-stratified sandstone of the Bulkeley Hill Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4463 ,
        namedrockunit:H56 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 22 m at outcrop in the Bulkeley area, Cheshire (Poole and Whiteman, 1966), may reach up to 200 m in the subsurface to the east, based on seismic evidence (Evans et al., 1993)."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, at the abrupt upward transition from the interbedded red and green mudstone, brown flaggy sandstone and red-brown cross-stratified sandstone of the Bulkeley Hill Sandstone Formation to deep red and grey mottled, coarse-grained pebbly sandstone at the base of the Helsby Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:HEY ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Bulkeley Hill Formation [Obsolete: use BHSF]"@en ,
        "Helsby Sandstone Formation"@en ,
        "Keuper Sandstone Passage Beds [Obsolete: use BHSF, HEY]"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHSF"@en ;
    skos:prefLabel "Bulkeley Hill Sandstone Formation [Obsolete: use HEY]"@en ;
.

namedrockunit:BHT
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and gravel, with possible lenses of silt, clay or peat. [Generic description]. Poorly sorted, stratified gravel and locally tabular cross-bedded sand beds. Gravel assemblage is characterised by abundant angular flint (77-81%), sparse rounded flint (5-10%), sparse vein quartz (4-7%), sparse quartzite (1.5-5%), sparse Greensand chert (2.5-4%) and less than 1% of other types."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on bedrock geology or older superficial deposits."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3851 ,
        namedrockunit:H57 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QX> ;
    lexicon:hasOldestAgeValue 4.23e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "1-9m, average 5m"@en ;
    lexicon:hasUpperBoundaryDefinition "At surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QO> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Boyn Hill Gravel Formation [Obsolete: use BHT]"@en ,
        "Boyn Hill Terrace [Obsolete: use BHT]"@en ;
    skos:broader namedrockunit:MNHD ;
    skos:definition "Gravel and sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Hoxnian Stage - to - Wolstonian Stage (Quaternary Period) (.423-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHT"@en ;
    skos:prefLabel "Boyn Hill Gravel Member"@en ;
.

namedrockunit:BHTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S246 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey to greyish brown, locally reddish brown, very stiff, stony sandy silty clay diamicton with sparse fragments of shell. It contains clasts mostly of Carboniferous lthologies in southern Northumberland, with far-travelled rocks from the Southern Uplands and, south of Blyth, from the Lake District too; local Permian lithologies predominate south of the Tyne. Generally becomes more clayey and plastic upwards. Includes local lenses of sand and gravel."@en ;
    lexicon:hasLowerBoundaryDefinition "Either rests directly on bedrock or as a sharp, subhorizontal, planar to gently undulating contact with limestone-rich gravel of the Limekiln Gill Gravel Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3214 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 15m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp, uneven, erosional contact with overlying red fine-grained sand of the Peterlee Sand Formation along the Durham coast."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Blackhall Member"@en ,
        "Durham Lower Till [Obsolete: use BHTI]"@en ;
    skos:broader namedrockunit:NSG ;
    skos:definition "Diamicton with subsidiary gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BHTI"@en ;
    skos:prefLabel "Blackhall Till Formation"@en ;
.

namedrockunit:BHV
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAOCM"^^xsd:anyURI ,
