    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 20m"@en ;
    lexicon:hasUpperBoundaryDefinition "Variable, but commonly the ground surface or a sharp, planar, unconformable contact with reddish brown pebbly sandy clay diamicton units of the Gosforth Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
