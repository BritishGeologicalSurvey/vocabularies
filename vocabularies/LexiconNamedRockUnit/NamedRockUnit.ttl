namedrockunit:USPS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PHNOD"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Upper Spilsby Sandstone. Thin, coarse-grained, grey or brown pebbly sandstone with iron ooliths (Ferruginous Grit of Swinnerton, 1937), underlain by fine-to medium-grained, buff, yellow and white sands with sparse calcareous \"doggers\" (the upper part of Swinnerton's, 1937, \"Glauconitic Sands\"). The latter sands become coarser and greener towards the base of the member. A bed of phosphatic nodules and small (generally chert) pebbles occurs at the base (the Mid Spilsby Nodule Bed of Casey, 1963, 1973). Offshore, in the Southern North Sea, the Upper Spilsby Sandstone has not been recognised."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is taken where coarse-grained, pebbly, glauconitic sands and sandstones with calcareous \"doggers\" and sporadic phosphatic nodules towards the top (Lower Spilsby Sandstone) are overlain by medium-grained, buff and green sands with sparse calcareous \"doggers\" and a basal bed of phosphatic nodules and small (generally chert) pebbles of the Upper Spilsby Sandstone. An erosion surface separates the two units."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2519 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KR> ;
    lexicon:hasOldestAgeValue 1.431e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To c. 11.5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the up-section change from pale yellow, medium-grained sand and sandstone (Upper Spilsby Sandstone) into the purple-grey and brown mottled mudstones with sporadic iron ooliths of the Hundleby Clay Member, Claxby Ironstone Formation or argillaceous oolitic ironstone of the Claxby Ironstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KV> ;
    lexicon:hasYoungestAgeValue 1.326e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Glauconitic sands (in part) and ferruginous grit [Obsolete: use USPS]"@en ;
    skos:broader namedrockunit:SYS ;
    skos:definition "Sandstone and trace chert and nodular phosphorite. Stratified bedrock. Occurs onshore. Deposited during the Berriasian Age - to - Valanginian Age (Cretaceous Period) (143.1-132.6 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "USPS"@en ;
    skos:prefLabel "Upper Spilsby Sandstone Member"@en ;
.

