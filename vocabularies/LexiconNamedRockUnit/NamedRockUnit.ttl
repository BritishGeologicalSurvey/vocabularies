namedrockunit:BX
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:S29 ,
        namedrockunit:S626 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALVPW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAVBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CESCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QDI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEPITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Tectonically assembled complex consisting largely of sepentinised ultramafic rock and basaltic pillow lavas. The latter are associated with basaltic breccias and a range of volcaniclastic rocks, conglomerate, mudstone-supported melange and chert. Some of the sedimentary rocks contain a graptolite fauna. There are several generations of dolerite and gabbro intrusions, and tectonism has locally produced amphibolite and greenschist."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen; speculatively a thrust contact on crystalline basement."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BVS ,
        namedrockunit:H2653 ,
        namedrockunit:H3887 ,
        namedrockunit:H4510 ,
        namedrockunit:S626 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasOldestAgeValue 4.865e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/C> ;
    lexicon:hasThicknessDescription "Highly speculative; at least several kilometres and possibly as much as 10km."@en ;
    lexicon:hasUpperBoundaryDefinition "Major unconformity beneath the overlying sedimentary cover. Above different parts of the Complex this cover is assigned to the Barr and/or Ardmillan groups and/or the Old Red Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OR> ;
    lexicon:hasYoungestAgeValue 4.68e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ballantrae Complex"@en ,
        "Ballantrae Group [Obsolete: use BX]"@en ,
        "Ballantrae Igneous Complex [Obsolete: use BX]"@en ,
        "Ballantrae Igneous Series [Obsolete: use BX]"@en ,
        "Ballantrae Ophiolite [Obsolete: use BX]"@en ,
        "Girvan - Ballantrae Complex [Obsolete: use BX]"@en ;
    skos:definition "Basaltic volcaniclastic-breccia, pillowed basalt lava and serpentinite with subsidiary agglomerate, chert, conglomerate, dolerite, gabbro, leucotonalite, quartz-diorite and volcaniclastic-sandstone and trace amphibolite and chlorite-epidote schist. Bedrock. Occurs onshore. Formed during the Tremadoc Series - to - Arenig Series (Ordovician Period) (486.5-468 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BCN ,
        namedrockunit:BYNE ;
    skos:notation "BX"@en ;
    skos:prefLabel "Ballantrae Ophiolite Complex"@en ;
.

