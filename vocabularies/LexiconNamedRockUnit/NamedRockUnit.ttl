namedrockunit:PRTS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "At Portavadie: soft to hard, grey to dark grey, poorly sorted silty sand and sandy silt with subangular to angular clasts up to 200mm across, particularly in the upper 1.5m. Gravel and cobbles were more common above -4m OD in the generally matrix supported sediment. Brown staining was noted at the unconformity with the overlying Flandrian sand. Seaweed and plant fragments were present at one or two horizons and the intact marine shells were of arctic aspect. At Ardyne Units 3 and 4 of Peacock (1997) consisted of very poorly sorted, pebbly clayey silt and silty sand 2.5m-2.9m thick. Crude interbeds of pale brownish grey sand are present in places along with pockets and lenticles of similar throughout.The top of the unit is more sandy and with crude lamination. Clasts up to 80mm across are scattered through the member but are more common near the top. These are generally sub-rounded to sub-angular in shape and of metamorphic lithologies (psammite, quartz-schist and phyllite). Intact marine shells of arctic affinities are also present."@en ;
    lexicon:hasLowerBoundaryDefinition "The Portavadie Sand and Silt Member of the Clyde Clay Formation rests with angular unconformity on older Quaternary sediments. It normally rests unconformably on either the Linwood Clay or the Paisley Clay Members of the Clyde Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1375 ,
        namedrockunit:H4850 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to over 3m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Portavadie Sand and Silt Member of the Clyde Clay Formation is overlain unconformably by younger Quaternary sediments, normally the Gourock Sand Member of the Clydebank Clay Formation of the British Coastal Deposits Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Clyde Beds [Obsolete: use PRTS, BOCH, LIWD, PAIS, KARN, CLYD]"@en ,
        "Portavadie Formation [Obsolete: use PRTS]"@en ;
    skos:broader namedrockunit:CLYD ;
    skos:definition "Silty sand and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PRTS"@en ;
    skos:prefLabel "Portavadie Sand And Silt Member"@en ;
.

namedrockunit:PSKA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A pebble and boulder conglomerate, typically containing rounded to subangular clasts of Moine psammite, Reay diorite and some granitic rocks in a matrix of greenish grey fine- to medium-grained sandstone. The unit is locally intercalated with thin beds of grey nodular limestone of the Aryleive Limestone Bed."@en ;
    lexicon:hasLowerBoundaryDefinition "The unit rests unconformably, directly on Caledonian igneous or Precambrian Moine (basement) rocks as the basal unit of the Bighouse Formation on the Middle Old Red Sandstone unconformity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1130 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 5 - 10m, and locally more than 40m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by an interbedded, sandstone-dominated rhythmic sequence of sandstones, siltstones and laminated carbonate mudstones (fish beds) of the Baligill Limestone Member of the Bighouse Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasYoungestAgeValue 3.853e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basal Conglomerate [Obsolete: use PSKA, TCM]"@en ;
    skos:broader namedrockunit:BIGH ;
    skos:definition "Conglomerate with subsidiary limestone and trace sandstone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Eifelian Age (Devonian Period) (394.3-385.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:ARYL ;
    skos:notation "PSKA"@en ;
    skos:prefLabel "Portskerra Conglomerate Member"@en ;
.

