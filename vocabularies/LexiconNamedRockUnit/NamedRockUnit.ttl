        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red, friable sandstone with conglomerate bands and thin intercalated lava flows."@en ;
    lexicon:hasLowerBoundaryDefinition "Change from siltstone to sandstone."@en ;
