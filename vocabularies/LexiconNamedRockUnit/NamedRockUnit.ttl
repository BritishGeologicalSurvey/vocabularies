    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use LIT, GWD, GY] Dacitic ignimbrites and lava contains three defined beds - in ascending order these are the Little Stand Tuff, Great Whinscale Dacite and the Grey Friar Tuff; in places bedded tuffs and other laterally impersistent andesitic ignimbrites separate these named beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Defined at base of thin-bedded tuffs underlying the nodular rhyolitic ignimbrite (Little Stand Tuff)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:GWM ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "200 metres in type section; lateral variations 85-200m; absent north of Hard Knott-Stonesty Gill."@en ;
    lexicon:hasUpperBoundaryDefinition "Top defined by overlying bedded tuffs on porphyritic andesite sheets."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    lexicon:isObsoleteEquivalentOf
        namedrockunit:GWD ,
        namedrockunit:GY ,
        namedrockunit:LIT ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Great Whinscale Dacite Member"@en ,
        "Great Whinscale Member [Obsolete: use TNM]"@en ,
        "Grey Friar Tuff Member"@en ,
        "Little Stand Tuff Member"@en ;
    skos:definition "Obsolete name. Lava and tuff. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TNM"@en ;
    skos:prefLabel "Tongue House Member [Obsolete: use LIT, GWD, GY]"@en ;
.

namedrockunit:TNPL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCABR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Semipelite, commonly thinly bedded, with white to pale grey metacarbonate and green-grey calc-silicate rocks. Prominent white limestone (Linkbrae Limestone Member) near base well developed on coast. Dolomitic metalimestone developed in lower part in Tarnash area. Less calcareous in the Grange area (River Isla)."@en ;
    lexicon:hasLowerBoundaryDefinition "At upper limit of quartzite of the Corryhabbie Quartzite Formation, where present. Otherwise at lowest appearance of white limestone or muscovite-rich semipelite above Mortlach Graphitic Schist Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DASG ,
        namedrockunit:H3525 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "240m from Deskford ORS outlier to Sandend Bay; c.400m in Grange area; c.250m in Tarnash area."@en ;
    lexicon:hasUpperBoundaryDefinition "Rapid gradation from calcareous semipelite and limestone to graphitic pelite/semipelite and dark-grey limestone of Fordyce Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle part of Sandend Group [Obsolete: use LINK, TNPL]"@en ,
        "Sandend Formation [Obsolete: use FORD, SNDL, TNPL]"@en ;
    skos:broader namedrockunit:DABH ;
    skos:definition "Metalimestone and semipelite with subsidiary calcsilicate-rock and trace metacarbonate-rock, metadolostone, micaceous psammite, pelite and psammite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:LINK ;
    skos:notation "TNPL"@en ;
    skos:prefLabel "Tarnash Phyllite And Limestone Formation"@en ;
.

namedrockunit:TRGP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey or pinkish grey quartzose sandstone. Quartzose conglomerate beds are common at the base of the formation, increasing in thickness and clast size towards the north."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal conglomerate of the Trenchard Formation rests unconformably upon the quartzitic sandstone of the Cromhall Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:S336 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasOldestAgeValue 3.1e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 120 m thick in the north of the Forest of Dean Coalfield."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the lowermost sandstone of \"Pennant\"- type (lithic arenite) of the Pennant Sandstone Formation, resting conformably above coarse-grained sandstone of the Trenchard Formation. This is a significant change to the Trotter (1942), who included all strata below the Coleford High Delf as part of his Trenchard Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CAS> ;
    lexicon:hasYoungestAgeValue 3.075e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Trenchard Group [Obsolete: use TRGP]"@en ;
    skos:broader namedrockunit:WAWK ;
    skos:definition "Conglomerate and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Asturian Substage (Carboniferous Period) (310-307.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:LTRC ,
        namedrockunit:UTRC ;
    skos:notation "TRGP"@en ;
    skos:prefLabel "Trenchard Formation"@en ;
.

namedrockunit:TTB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S222 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Terrington Beds result from a transgression that caused marine and brackish water silt and fine-grained sand to be deposited far inland in the major river courses and gave rise to extensive salt-marsh deposits of interlaminated dull, reddish brown clays and pale brown silts which were sufficiently well drained by the time of the Roman occupancy for them to have been extensively colonised."@en ;
    lexicon:hasLowerBoundaryDefinition "The Terrington Beds disconformably overlie the Nordelph Peat or the Barroway Drove Beds. Both the Terrington Beds and the Barroway Drove beds comprise former saltmarsh deposits and thus have very similar lithologies. However the Nordelph Peat is commonly interbedded and this aids differentiation between the units."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2501 ,
        namedrockunit:WARP ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Generally up to about 3 m but locally may be somewhat thicker."@en ;
    lexicon:hasUpperBoundaryDefinition "The Terrington Beds are at surface or locally overlain by Storm Beach gravels."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Upper Silt [Obsolete: use TTB]"@en ,
        "Warp"@en ,
        "Younger Salt Marsh Deposits"@en ;
    skos:broader namedrockunit:FEND ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TTB"@en ;
    skos:prefLabel "Terrington Beds"@en ;
.

namedrockunit:TUSC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
