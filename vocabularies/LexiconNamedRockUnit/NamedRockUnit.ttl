namedrockunit:RAVL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Rattray Volcanics Member comprises lavas, volcanics and subordinate clastics. Lavas include ankaramites, alkali olivine basalt, hawaiites and mugearites (Fall et al., 1982). The associated agglomerates, tuffs and tuffaceous claystone may be pyritic, chloritic, sometimes felsic, calcareous and/or glassy. Sandstones and mudstones are locally interbedded with the volcanics."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is placed at a down section change from volcanic rocks to sedimentary successions of either coal-bearing Pentland Formation, Lower Jurassic mudstones, Triassic red beds or Permian evaporites. The volcanic member interdigitates with sedimentary successions."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5144 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 1500 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by the down-section change from dominantly sedimentary deposits to essentially volcanic. Coal-bearing sediments (Pentland Formation) or marine sandstones and mudstones (Piper, Hugin, Heather or Kimmeridge Clay formations) overlie volcanic rocks. The volcanic member interdigitates with sedimentary successions."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rattray Formation [Obsolete: use RAVL, ROVL]"@en ;
    skos:broader namedrockunit:PNTL ;
    skos:definition "Olivine-basalt with subsidiary agglomerate and tuff and trace mudstone and sandstone. Stratified bedrock. Occurs offshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RAVL"@en ;
    skos:prefLabel "Rattray Volcanics Member"@en ;
.

namedrockunit:RBD1
    a skos:Concept ;
