namedrockunit:LTG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey speckled with orange brown very shelly and shell-detrital moderately sandy peloid wackestones, packstones and grainstones with thin marl and sand beds, some shelly; some of the peloids are ferruginous ('ironshot'); commonly pebbly at the base, thins and becomes more marly, ironshot and conglomeratic northwards; the fauna includes bivalves (notably trigoniids), brachiopods, corals and the colonial serpulid Sarcinella (See Sumbler, M G, Barron, A J M and Morigi, A N, 2000)."@en ;
    lexicon:hasLowerBoundaryDefinition "Disconformity: upward change from peloid and ooid limestone (Scottsquar Member) or sand, clay and sandy limestone (Harford Member) where present (both of Birdlip Formation) into limestone as described in lithology. Generally marked by a hardground."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H379 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Typically 1 to 2m, maximum c.3m: type section (Leckhampton Hill); 1.5m (British Geological Survey files; Cox, B M, and Sumbler, M G. 2002) to 2.2m (Richardson, L, 1906)."@en ;
    lexicon:hasUpperBoundaryDefinition "Upward transition from limestone as described in lithology into sandier, more coarsely shell-detrital, less ironshot limestones (Gryphite Grit Member) or hardground overlain by Salperton Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Trigonia Grit [Obsolete: use LTG]"@en ;
    skos:broader namedrockunit:ASLS ;
    skos:definition "Limestone with subsidiary calcareous mudstone and sand. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age (Jurassic Period) (170.9-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LTG"@en ;
    skos:prefLabel "Lower Trigonia Grit Member"@en ;
.

namedrockunit:LTGL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Group of one to three, typically two, limestone beds, separated by mudstone. Lower limestone is hard grey, very shelly, including ammonites, bioclastic and about 0.25 m thick. Upper limestone is less shelly, fine, very sandy, ferruginous limestone, with pectiniids. Fauna (mainly from the lower limestone bed) also includes forams, gastropods, brachiopods, belemnites (lowest recorded in area), ostracods, echinoderms, and Chondrites burrows. Forms a strong feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey mudstone with phosphate nodules of undifferentiated Foston member; at c 3.3 m depth in type section Fulbeck Airfield Borehole F/B1 (SK85SE/25)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1049 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0.2 to 1.5 m; c.1.5 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up from grey mudstone of undifferentiated Foston member; at c.1.8 m depth in type section Fulbeck Airfield Borehole F/B1 (SK85SE/25)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Littlegate Limestone [Obsolete: use LTGL]"@en ;
    skos:broader namedrockunit:FSTL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LTGL"@en ;
    skos:prefLabel "Littlegate Limestones Bed"@en ;
.

namedrockunit:LTHM
    a skos:Concept ;
