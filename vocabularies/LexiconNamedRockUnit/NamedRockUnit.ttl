namedrockunit:DRWN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CASLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A white-buff and yellow medium- to fine-grained, thinly planar bedded sandstone intercalated with finely laminated grey calcareous siltstone, calcareous mudstone, grey silty mudstone and rare thin non-marine, dolomitic muddy limestone (\"cementstone\")."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal contact is faulted in the type area. The presence of grey silty mudstone and dolomitic limestone (\"cementstone\") interbedded with sandstone distinguishes this basal member of the Ballagan Formation from the underlying sandstone-dominated Kinnesswood Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4007 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 275m at the type area, but the base is faulted. The unit is interpreted to be laterally variable in thickness."@en ;
    lexicon:hasUpperBoundaryDefinition "Mapped as a conformable contact on NS20SE in the Lindsaystone Burn section at (NS 2824 0080), but not actually exposed.  Defined as the lithological change from yellow sandstone with grey silty mudstone to red-purple sandstone with conglomerate and pedogenic carbonate typical of the Lindsayston Burn Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Basal Sandstone [Obsolete: use DRWN]"@en ;
    skos:broader namedrockunit:BGN ;
    skos:definition "Calcareous siltstone and sandstone with subsidiary calcareous mudstone and silty mudstone and trace calcilutite. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DRWN"@en ;
    skos:prefLabel "Drumwhirn Member"@en ;
.

