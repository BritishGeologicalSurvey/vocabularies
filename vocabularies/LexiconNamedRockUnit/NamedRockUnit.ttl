namedrockunit:RSSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The lithological association consists of flat and ripple-laminated medium- to fine-grained sand with laminae and thin bands of silt. It is moderately dense. Sedimentary structures were formerly visible at Ferniegair Gravel Pit [NS 734 543] and at Bothwell [NS 708 589]. At Ferniegair the dominant structures were large-scale trough cross-bedding in sands and gravelly sands and horizontal bedding in finer sands. At Bothwell, the sedimentary structures were largely horizontal lamination and ripple lamination. The climbing ripples preserved rose southwards (sediment transport up the Clyde valley). Thin beds of reddish brown silty clay were also present. The sedimentological features of the Member are consistent with deposition by glaciodeltaic processes. At Ferniegair, the Avon was probably building a lateral delta into the ice-dammed \"Lake Clydesdale\". It also seems likely that the Bothwell deposit was deltaic, with the interfingering bands of laminated clay passing laterally southwards into the Bellshill Clay Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Uncomformity on bedrock or more commonly on older Quaternary strata, particularly the Wilderness Till Formation of the Midland Valley Glacigenic Subgroup. Conformably with the Bellshill Clay Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1149 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to about 20m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformity below younger Quaternary strata such as the Clyde Clay Formation but also exposed at the surface. Locally passes conformably laterally and upwards with the Bellshill Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ross Sand Formation [Obsolete: use RSSA]"@en ;
    skos:broader namedrockunit:BHSE ;
    skos:definition "Sand with subsidiary clay, gravel and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RSSA"@en ;
    skos:prefLabel "Ross Sand Member"@en ;
.

