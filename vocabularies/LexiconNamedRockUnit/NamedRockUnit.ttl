namedrockunit:HNTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S537 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Typically very stiff, dark brown or purplish brown, stony silty sandy diamicton containing clasts mainly of limestone and dolostone of the Zechstein Group (formerly Magnesian Limestone; mostly Upper Division), Carboniferous lithologies, purple porphyry from the Cheviots and shell fragments. The till is invariably weathered reddish brown at the top, and locally throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally planar, unconformable, subhorizontal boundary with underlying gravel of the Peterlee Sand and Gravel Formation, where the contacts may be sharp or gradational with glacitectonic intercalation. The till locally rests directly on bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H321 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 12.2m"@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly a gradational contact with overlying brown pebbly clay with vertical prismatic jointing (Prismatic Clay Member). Lateral interdigitating boundary with the Tyne-Wear Glaciolacustrine Formation to the west."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Durham Upper Till [Obsolete: use HNTI]"@en ,
        "Horden Member"@en ;
    skos:broader namedrockunit:NSG ;
    skos:definition "Diamicton with subsidiary gravel and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ELWK ,
        namedrockunit:PRIS ;
    skos:notation "HNTI"@en ;
    skos:prefLabel "Horden Till Formation"@en ;
.

namedrockunit:HORD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Horda Formation consists predominantly of mudstone with subordinate sandstone. The mudstone is typically green-grey to olive-grey, but grades to brown-grey in the siltier, proximal sections and near the top of the formation in the Outer Moray Firth and South Viking Graben. Grey-red to purple mudstones, grading to waxy claystones, are prominent in the lower parts of many distal, condensed sections, especially in the Central Graben. They are associated with sporadic thin tephra layers, often preserved as green bentonitic clay. Minor amounts of variegated mudstone also occur in these condensed sections, with colours including cream, pale grey, pale green, and dark grey.\r
\r
Isolated sand bodies occur within the lower and middle parts of the formation, with more continuous sands occurring at the top of the formation in the South Viking Graben and Outer Moray Firth."""@en ;
    lexicon:hasLowerBoundaryDefinition "Over most of its area, the Horda Formation rests on the Balder Formation, the boundary being marked by a downward change from variegated mudstone and claystone to dark grey, carbonaceous claystone. Horda mudstones rest on sandstones of the Mousa Formation in western sections of the Northern North Sea (e.g. 9/7-1, 9/12b-6); elsewhere, they rest on mudstones of the Balder Formation or, in parts of the Outer Moray Firth, on sandstones or lignites of the Beauly Member. The base of the Horda Formation is unconformable over salt-induced highs in the south of Quadrant 21, with the Tay Sandstone Member resting variously on the Balder Formation, Sele Formation (e.g. 21/25-6), or Lista Formation (e.g. 21/22-1)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GE> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Horda Formation can reach over 800 m in thickness in the northern North Sea."@en ;
    lexicon:hasUpperBoundaryDefinition "In mudstone-dominated sections, the upper boundary is characterized by a downward change from brown mudstone of the Lark Formation to green-grey mudstone (e.g. 22/1-1A, 21/22-1). On wireline logs, the boundary is marked by a downward decrease in gamma-ray values. In the South Viking Graben and Outer Moray Firth, the high-gamma mudstone at the base of the Lark Formation rests directly on glauconitic sandstone (e.g. 9/4-1) or on laterally equivalent brown-grey, silty mudstone (e.g. 16/18-1)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GO> ;
    lexicon:hasYoungestAgeValue 2.304e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:STRY ;
    skos:definition "Mudstone with subsidiary sandstone. Stratified bedrock. Occurs offshore. Deposited during the Eocene Epoch - to - Oligocene Epoch (Palaeogene Period) (56-23.04 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:FRIS ,
        namedrockunit:GRIS ,
        namedrockunit:SKRS ,
        namedrockunit:TAYS ;
    skos:notation "HORD"@en ;
    skos:prefLabel "Horda Formation"@en ;
.

namedrockunit:HP
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A heterogeneous succession of typically mid grey, locally dark grey, fine- to coarse-grained calcarenites, with limestone clasts and coarse crinoid debris common at the base of the Formation, and in the vicinity of knoll-reefs."@en ;
    lexicon:hasLowerBoundaryDefinition "Upward change from dark cherty micritic limestone of the underlying Milldale Limestone Formation, to grey, coarsely bioclastic or conglomeratic limestones present at the base of the Hopedale Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H962 ,
        namedrockunit:NDL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "60m  in Hopedale [SK 129 549], to 300m around Gag Lane, to the northnortheast of Thorpe [SK 16 51]."@en ;
    lexicon:hasUpperBoundaryDefinition "In the upper part, seen as mostly calcarenites, with a sharp change to darker mudstones at the base of the Widmerpool Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hopedale Limestones [Obsolete: use HP]"@en ,
        "Narrowdale Limestone [Obsolete: use HP]"@en ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CCN ,
        namedrockunit:HPK ;
    skos:notation "HP"@en ;
    skos:prefLabel "Hopedale Limestone Formation"@en ;
.

namedrockunit:HYSA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Unbedded to weakly bedded and cross-bedded, pale grey and brown to off-white, medium- to fine-grained, quartzose sand, locally cemented into calcareous or weakly ferruginous sandstone with thin dark grey mudstone and siltstone beds in places, rootlets and lignitic debris common, shells and shell debris very rare."@en ;
    lexicon:hasLowerBoundaryDefinition "Seen as the passage from lithologically similar sand and sandstone beds with marine shelly fauna, ooidal and shell-detrital limestones of the Northampton Sand Formation (Inferior Oolite Group) where present, or mudstone beds of the Whitby Mudstone Formation (Lias Group) into barren, sand-dominated beds. The non-sequential boundary with the Northampton Sand Formation, may appear conformable or gradational probably as a result of weathering effects, or locally channelled and disconformable [Horton et al. 1987, p.56]."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2255 ,
        namedrockunit:H2858 ,
        namedrockunit:H4110 ,
        namedrockunit:H976 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 7m"@en ;
    lexicon:hasUpperBoundaryDefinition "Marked by the presence of mudstones, marls and limestone beds of the Sharp's Hill Formation where present, or ooidal and shell detrital limestones of the Taynton Limestone Formation. The boundary is non-sequential, and may be marked by an eroded or leached and rootleted surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Lower Estuarine Series (Inferior Oolite) [Obsolete: use HYSA]"@en ,
        "Swerford Beds [Obsolete: use HYSA]"@en ,
        "Swerford Member [Obsolete: use HYSA]"@en ,
        "White Sands [Obsolete: use HYSA, STAM]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Sand and sandstone with subsidiary mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Bajocian Age - to - Bathonian Age (Jurassic Period) (170.9-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "HYSA"@en ;
    skos:prefLabel "Horsehay Sand Formation"@en ;
.

namedrockunit:HYTIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Gravelly, clayey silty sand diamicton. Typically brown/dark brown (10YR 4/3), with greyish brown/grey ped faces, very stiff, non-calcareous, matrix-supported. Clast angularity ranges from angular to subrounded. Clast lithologies are varied and include psammitic, pelitic and quartzitic metasedimentary rock, felsite, mafic igneous rocks, slate, grey granite and sparse red sandstone, flint and a single Norwegian \"Rhomb Porphyry\". Clast fabrics indicate glacial transport from the west and westsouthwest. Interpreted as a subglacial till."@en ;
    lexicon:hasLowerBoundaryDefinition "Typically the formation has a sharp, planar, subhorizontal, erosional basal boundary on sediments of the Corsend Gelifluctate Bed (e.h. east and south faces, Kirkhill Quarry (infilled). In other situations the basal boundary can be more complex - e.g. northeast face, Leys Quarry (disused). Here the formation displays either a sharp, undulating, unconformable, basal boundary on brown diamicton of the Rottenhill Till Formation; or a sharp to gradational basal/lateral, glaciotectonic, boundary with sheets and rafts of black clayey diamicton of the Corse Diamicton Member (Whitehills Glacigenic Formation)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2256 ,
        namedrockunit:H2859 ,
        namedrockunit:H977 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 3m"@en ;
    lexicon:hasUpperBoundaryDefinition "Typically the upper boundary is the present ground surface. Within the valleys of the north and south Ugie Waters the upper boundary can be sharp, erosional with overlying glaciofluvial or alluvial sands and gravels."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Hythie Member [Obsolete: use HYTIL]"@en ,
        "Kirkhill Upper Till [Obsolete: use HYTIL]"@en ,
        "Unweathered Kirkhill Till [Obsolete: use HYTIL]"@en ;
    skos:broader namedrockunit:EGD ;
    skos:definition "Diamicton. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:MANSE ;
    skos:notation "HYTIL"@en ;
    skos:prefLabel "Hythie Till Formation"@en ;
.

namedrockunit:ICGN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/GDGNS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MTO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OGNSM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OGNSS"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises grey to pink biotite- and locally hornblende-bearing, granodioritic to tonalitic felsic gneisses, with subordinate bodies of gneissose mafic and ultramafic rock. The general grade of metamorphism is amphobilite facies. The gneiss is comonly migmatitic."@en ;
    lexicon:hasLowerBoundaryDefinition "Has a sheared contact with the Scourian Gneiss to the southwest. It is unconformably overlain by the Torridonian Group, and in the east, by the Eribol Formation. The unit is aso intruded by the Rubha Ruadh Granite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1609 ,
        namedrockunit:H2257 ,
        namedrockunit:H2861 ,
        namedrockunit:LLX ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AR> ;
    lexicon:hasOldestAgeValue 4e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AR> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LD> ;
    lexicon:hasThicknessDescription "It is probably at least several kilometres thick, and it is thought that it potentially extends down to the Moho; i.e. greater than 5km."@en ;
    lexicon:hasUpperBoundaryDefinition "Not applicable, but see details under \"Lower Boundary\"."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AR> ;
    lexicon:hasYoungestAgeValue 2.5e+03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Laxfordian (in part Rhiconich Group) [Obsolete: use ICGN, RUBR]"@en ,
        "Laxfordian [Obsolete: use RUBR, ICGN]"@en ,
        "Rhiconich Gneisses [Obsolete: use ICGN]"@en ,
        "Rhiconich Group [Obsolete: use ICGN]"@en ;
    skos:broader namedrockunit:L ;
    skos:definition "Gneissose granodiorite, metatonalite and orthogneiss with subsidiary mafic orthogneiss. Bedrock. Occurs onshore. Formed during the Archean Eon (Precambrian) (4000-2500 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ICGN"@en ;
    skos:prefLabel "Inchard Gneisses"@en ;
.

namedrockunit:IDA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent
        namedrockunit:CDI ,
        namedrockunit:CHAM ,
        namedrockunit:MRB ,
        namedrockunit:STA ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Ida Formation consists of thinly interbedded brown to grey siltstones, fine sandstones and argillaceous, occasionally oolitic (chamositic) and carbonaceous, limestones."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is defined by an abrupt downward transition from sandy and calcareous sediments to mudstones (Offa Formation). It coincides with an increase in gamma values and a decrease in velocity, which may be marked in some wireline logs."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to c. 30 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The boundary is characterised by a downward change from mudstones (Cerdic Formation) to harder, sandy and calcareous, interbedded sequence of the Ida Formation. There is a sharp downward decrease in gamma values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Charmouth Mudstone Formation"@en ,
        "Cleveland Ironstone Formation"@en ,
        "Marlstone Rock Formation"@en ,
        "Staithes Sandstone Formation"@en ;
    skos:broader namedrockunit:LI ;
    skos:definition "Limestone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Pliensbachian Age (Jurassic Period) (192.9-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IDA"@en ;
    skos:prefLabel "Ida Formation"@en ;
.

namedrockunit:IMCA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Alluvial gravel, sand, silt and clay forming floodplains, alluvial fans and river terrace deposits. Peat, mud and pebbly sand infilling lowland basins and blanketing upland hillsides and peat, humic clayey silt and calcareous silt infilling kettleholes."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally an unconformable boundary with units of the Caledonia Glacigenic Group."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/UG> ;
    lexicon:hasThicknessDescription "Typically 2.5 m thick, but highly variable and greater than 20 m locally."@en ;
