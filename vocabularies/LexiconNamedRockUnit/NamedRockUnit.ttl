namedrockunit:COS
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises conglomerate and pebbly quartzitic sandstones, coarse- to fine-grained. The sandstones are orange or brown, locally stained red, and thick-bedded. Thin mudstone beds, bluish grey or green. locally red, with seatearths and thin coals. The base of the formation comprises of a massive conglomerate with clasts up to 25 cms in diameter of quartz and quartzite, and subordinate slate, with sandstone from the Old Red Sandstone Group, and Dinantian limestone."@en ;
    lexicon:hasLowerBoundaryDefinition "The pebbly sandstones of the Cornbrook Sandstone Formation are considered to rest unconformably upon limestones of the Oreton Limestone Formation at the type locality of Cornbrook Dingle, although the exposed contact is faulted, and upon the Devonian St Maughans Formation (Lower Old Red Sandstone Group at the reference section in Benson's Brook."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2071 ,
        namedrockunit:H2715 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CE> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "From 55m to 215m"@en ;
    lexicon:hasUpperBoundaryDefinition "At Benson's Brook, the boundary has been considered to occur where thick seatearths and sandstones of the Pennine Coal Measures Group rest unconformably upon thick sandstones and conglomerates of the Cornbrook Sandstone Formation (Dixon, 1917). In contrast, the boundary has been argued to be faulted at this locality (Jones and Owen, 1961)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cornbrook Sandstone [Obsolete: use COS]"@en ,
        "Millstone Grit [Obsolete: use COS, MG, CFS]"@en ;
    skos:broader namedrockunit:MG ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Pendleian Substage - to - Arnsbergian Substage (Carboniferous Period) (330.3-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "COS"@en ;
    skos:prefLabel "Cornbrook Sandstone Formation"@en ;
.

