namedrockunit:WMCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Buff, grey and off-white, soft, marly chalk and hard grey limestone arranged in couplets."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is unconformable. Base marked by an erosion surface, commonly bored, at the base of the Glauconitic Marl Member (Southern Province), Melbury Sandstone Member (western Southern Province) or Cambridge Greensand Member (Transitional Province)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CKM ,
        namedrockunit:H3139 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "In general between 15 and 25 m of these beds are preserved but they are absent over the Mid-Dorset Swell (Drummond, 1970; Kennedy, 1970; Bristow et al., 1995) and thin over other syndepositional structural highs."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is conformable in 'full' sequences at the erosional base of the overlying Cast Bed 'Member' (bed C1 of Gale, 1995) of the Zig Zag Chalk Formation in the Southern Province and by the base of the Totternhoe Stone Member, its lateral equivalent, in the Transitional Province north of the Thames. This mid-Cenomanian erosional break marks the change from well-defined limestone marl couplets below to chalks with marls above, and the boundary between the 'B' and 'C' Chalk Marl couplets of Gale (1995). In full sequences the 'Tenuis Limestone' is the bed immediately beneath the mid-Cenomanian break. Elsewhere a variable number of the upper 'B' beds of  Gale (1995) are absent through erosion."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Chalk Marl [Obsolete: use WMCH, BRHD]"@en ,
        "West Melbury Chalk Member [Obsolete: use WMCH]"@en ;
    skos:broader namedrockunit:GYCK ;
    skos:definition "Calcareous mudstone and chalk with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BOOC ,
        namedrockunit:CBG ,
        namedrockunit:GLML ,
        namedrockunit:M3LM ,
        namedrockunit:MYS ,
        namedrockunit:TELM ;
    skos:notation "WMCH"@en ;
    skos:prefLabel "West Melbury Marly Chalk Formation"@en ;
.

namedrockunit:WSTS
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:FLDN ,
        namedrockunit:RAG ,
        namedrockunit:RDBN ,
