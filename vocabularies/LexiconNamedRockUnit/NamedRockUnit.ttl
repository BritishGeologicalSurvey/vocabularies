    lexicon:hasThicknessDescription "To 11.9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Gradational, conformable contact with brownish grey sandy silt of the Stubble Green Silt Member of the Glannoventia Formation, or, sharp, planar, unconformable contact with stony diamicton of the Holmrook Till Member of the Blengdale Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
