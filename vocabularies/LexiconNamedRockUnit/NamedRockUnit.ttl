namedrockunit:BSP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/T> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use CHES] In Exeter and Newton Abbot districts: predominantly brown horizontally-bedded gravel with subordinate lenticular beds of trough cross-bedded pebbly sand and sand. The gravel is composed of well-rounded pebbles, cobbles and boulders in a coarse to fine gravel and silty sand matrix. The clasts are mainly (84 to 90%) metaquartzite together with porphyry, vein quartz, tourmalinite, and feldspathic conglomerate. From just south of Hillhead (ST 067 136), locally derived Devonian and Carboniferous clasts begin to appear. Near Milverton, the Formation is massive calcareous conglomerate with limestone clasts."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests sharply with marked lithological contrast on Aylesbeare Mudstone Group. Probable disconformity at the contact."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1399 ,
        namedrockunit:H2645 ,
        namedrockunit:H3877 ,
        namedrockunit:H733 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasOldestAgeValue 2.519e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Budleigh Salterton: 30m. Exeter district: 15-20m. Hillhead: 24m. Taunton district: 30-35m."@en ;
    lexicon:hasUpperBoundaryDefinition "Ventifact bed at top of the formation is present from Budleigh Salterton to Hillhead: it is overlain by sands or pebbly sands of the Otter Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
    lexicon:hasYoungestAgeValue 2.467e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CHES ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Budleigh Salterton Conglomerate [Obsolete: use BSP]"@en ,
        "Budleigh Salterton Pebble Bed [Obsolete: use BSP, CHES]"@en ,
        "Budleigh Salterton Pebble Beds [Obsolete: use BSP]"@en ,
        "Chester Formation"@en ,
        "Pebble Beds [Obsolete: use BSP, CHES]"@en ;
    skos:definition "Obsolete name. Conglomerate with subsidiary pebbly (gravelly) sandstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Early Triassic Epoch (Triassic Period) (251.9-246.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BSP"@en ;
    skos:prefLabel "Budleigh Salterton Pebble Beds Formation [Obsolete: use CHES]"@en ;
.

