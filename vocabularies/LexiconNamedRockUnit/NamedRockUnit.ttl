    lexicon:hasThicknessDescription "Up to at least 50 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "At the type locality, taken where there is a change from the dark grey blocky mudstone of the Leagram Mudstone Member to the overlying thin-bedded, laminated calcisiltites and dark grey, fissile mudstones of the Hodder Mudstone Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CI> ;
    lexicon:hasYoungestAgeValue 3.445e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
