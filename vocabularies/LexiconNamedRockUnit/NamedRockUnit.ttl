    lexicon:hasLithologyDescription "Olivine basalt."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp boundary with chilled margin and some baking of bedding ranging from the middle part of the Pennine Coal Measures Group in Eymore Wood in the south [782 797] to the lower part of the Etruria Formation near Witnells End in the north [795 815]. Locally vesicular at base."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasOldestAgeValue 3.1475e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SI> ;
    lexicon:hasThicknessDescription "About 15 m at type area. A minimum thickness of 8.6 m is present at the bottom of the Shatterford Deep Sinking (SO78SE/15) [SO 7901 8103]."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper contact demonstrates complex interfingering of the basalt and the country-rock, partly altered, ranging from the middle part of the Pennine Coal Measures Group in Eymore Wood in the south [782 797] to the lower part of the Etruria Formation near Witnells End in the north [795 815]. Locally vesicular at top."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CC> ;
    lexicon:hasYoungestAgeValue 3.1e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CLEE ;
    skos:definition "Microgabbro and olivine-phyric basalt. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Bolsovian Substage (Carboniferous Period) (314.75-310 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
