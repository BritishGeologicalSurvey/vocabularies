namedrockunit:ORVAL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FPHAW"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HAW"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The eastern face of Orval consists of at least three thick flows of basaltic hawaiite and feldspar-phyric basaltic hawaiite. The flows are difficult to separate since no intervening boles are present. They lie directly on granophyre except in the steep valley north-east of Orval summit where they abut against a former valley wall eroded from the uppermost lavas of the Lower Fionchra Member."@en ;
    lexicon:hasLowerBoundaryDefinition "Lies on granophyre or the eroded surface of the Lower Fionchra Member (LFION)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GP> ;
