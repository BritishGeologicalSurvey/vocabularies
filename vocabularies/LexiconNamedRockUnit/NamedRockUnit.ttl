namedrockunit:NSBR
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLateralEquivalent namedrockunit:S319 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown, mainly fine-grained breccia; clasts (mostly < 5cm) of shale, slate, hornfels, chert, potassium feldspar (murchisonite), vein quartz, quartz-porphyry, acid lava and tuff, microgranite and tourmalinised igneous rocks. Locally well cemented. Local sandstone beds. Sub-vertical sandstone bodies."@en ;
    lexicon:hasLowerBoundaryDefinition "Correlates with Heavitree Breccia of Exeter area. Rests on Crediton Breccia, locally with a scarp at the junction. Distinguished from Crediton Breccia by more sandy matrix, greater degree of cementation and presence (increasing towards the top) of potassium feldspar (murchisonite)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2344 ,
        namedrockunit:H4229 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "180m southwest of Newton St Cyres, 10m at Creedy Barton (SX 865 995)."@en ;
    lexicon:hasUpperBoundaryDefinition "Passes gradationally upwards and laterally into the Shute Sandstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
