namedrockunit:BRSF
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AROC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Water-lain poorly sorted, brownish to grey arkosic pebbly sandstone; fine- to coarse-grained. Commonly cross-bedded or laminated, some massive. Some conglomerate beds and beds with common mudstone interclasts. Few siltstone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "Around Lossiemouth the base of the formation is the base of the predominantly waterlain pebbly sandstones unconformably overlying the Upper Old Red Sandstone strata. Farther to the west the formation overlies the Triassic Hopeman Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3875 ,
        namedrockunit:H726 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TE> ;
