namedrockunit:IMC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A conglomerate with clast sizes mostly from 10 to 15 cm, predominantly of quartzite in the lower part but with igneous and volcanic clasts also, at higher levels."@en ;
    lexicon:hasLowerBoundaryDefinition "The Inchmurrin Conglomerate Member is commonly faulted against Dalradian or Highland Border Complex rocks. Mapping in the Gualann area suggests that the Inchmurrin Conglomerate Member lies within the Ruchill Flagstone Formation, overlying the Craig of Monievreckie Conglomerate Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2864 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "At least 300 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Originally, the top of the Inchmurrin Conglomerate Member was found to be unexposed or obscured by faulting (Paterson, Hall and Stephenson, 1992, p.7). Later mapping in the Balmaha-Gualann area (1995 season), suggests that the Inchmurrin Conglomerate Member is a conglomerate body within the Ruchill Flagstone Formation. Where not affected by faulting, it is overlain by a flaggy, locally pebbly sandstone of the Ruchill Flagstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Inchmurrin Conglomerate Formation [Obsolete: use IMC]"@en ;
    skos:broader namedrockunit:RLF ;
    skos:definition "Conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "IMC"@en ;
    skos:prefLabel "Inchmurrin Conglomerate Member"@en ;
.

namedrockunit:INCH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLateralEquivalent namedrockunit:S291 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, blue-grey, medium to coarsely crystalline, thin- to medium-bedded, rarely thick-bedded. Chert nodules in parts. Thin interbeds of graphitic to calcareous pelite and semipelite. Amphibolite pods in some areas."@en ;
    lexicon:hasLowerBoundaryDefinition "Above Clashnoir Semipelite Formation at lower limit of grey crystalline limestone lithology. In parts grades downwards into semipelites with limestone interbeds."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "50 - 150m, possibly locally thicker (to 400m) due to folding/faulting."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper limit of grey crystalline limestone. Marked change or rarely rapid transition to overlying pelite and semipelite of the Glenfiddich Pelite Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lismore Limestone [Obsolete: use DALL]"@en ;
    skos:broader namedrockunit:DABA ;
    skos:definition "Limestone with subsidiary pelite and semipelite and trace amphibolite and chert. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "INCH"@en ;
    skos:prefLabel "Inchrory Limestone Formation"@en ;
.

