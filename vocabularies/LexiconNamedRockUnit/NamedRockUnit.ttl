    skos:broader namedrockunit:MULD ;
    skos:definition "Basaltic-andesite, dolerite and porphyritic basaltic andesite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Paleocene Epoch (Palaeogene Period) (66-56 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CADY"@en ;
    skos:prefLabel "Armathwaite-Cleveland Dyke"@en ;
.

namedrockunit:CAFS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Banded alternation of rusty-weathering semipelite with 5 - 10cm beds of psammite in equal proportions; however 25% of upper part of formation consists of white, quartz-rich psammite alternating with dark, biotitic, graded pelite."@en ;
    lexicon:hasLowerBoundaryDefinition "Transitional, with interbanding of calcareous semipelite with thin grey limestone beds marks junction with upper limestone of Blair Atholl Dark Limestone and Dark Schist Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H103 ,
        namedrockunit:H104 ,
        namedrockunit:H3896 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "0 - 150m in Sheet 55W; probably tectonically attenuated."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp boundary with buff limestone of Drumchastle Pale Limestone Formation at type locality; elsewhere taken at base of calc-muscovite-biotite pelite lithology transitional to Drumchastle Pale Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Banded Group within Blair Atholl Subgroup [Obsolete: use CAFS]"@en ,
        "Banded Schist within Blair Atholl Subgroup [Obsolete: use CAFS]"@en ,
        "Banded Series within Pale Group of Blair Atholl Series [Obsolete: use CAFS]"@en ;
    skos:broader namedrockunit:DABA ;
    skos:definition "Psammite and semipelite with subsidiary micaceous psammite and pelite and trace metadolostone. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CAFS"@en ;
    skos:prefLabel "Cnoc An Fhithich Banded Semipelite Formation"@en ;
.

namedrockunit:CAS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLateralEquivalent namedrockunit:LEVL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A white or pale to dark grey, medium- to fine-grained, crinoidal, bioclastic, locally dolomitic limestone, interpreted to be of marine origin, and containing algal nodules."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally marked by a change from marine mudstone, or resting on a thin coal or seatrock belonging to the Upper Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H4516 ,
        namedrockunit:LEVL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasOldestAgeValue 3.27e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "Generally up to 5m, but may be absent due to erosion in areas such as in Strathclyde, Ayrshire and parts of the Stirling district."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly seen as an abrupt change to bituminous non-marine mudstone containing Curvirimula belonging to the Passage Formation. Marine mudstone roof in Fife, except where absent due to penecontemporaneous erosion, especially in the western Midland Valley of Scotland and in the centre of the Kincardine basin, where erosive-based sandstones form the base of the overlying Passage Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CG> ;
    lexicon:hasYoungestAgeValue 3.2375e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Craigenbush Limestone [Obsolete: use CAS]"@en ,
        "Levenseat Limestone [Obsolete: use CAS]"@en ;
    skos:broader namedrockunit:ULGS ;
    skos:definition "Limestone with subsidiary calcareous mudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Arnsbergian Substage (Carboniferous Period) (327-323.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CAS"@en ;
    skos:prefLabel "Castlecary Limestone"@en ;
.

namedrockunit:CBA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/E> ;
    lexicon:hasLithology
