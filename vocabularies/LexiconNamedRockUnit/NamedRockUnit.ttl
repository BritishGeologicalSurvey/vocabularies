namedrockunit:FCS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, pale brown to pink, coarse-grained, thickly bedded and massive, feldspathic, with ferruginous concretions and scattered mudstone clasts, and subordinate mudstone beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is taken at the base of a thickly bedded sandstone overlying grey mudstone of undivided Millstone Grit Group in the Upper Hulme Stream Section (SK06SW/14); the precise nature of the boundary is not recorded."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4040 ;
