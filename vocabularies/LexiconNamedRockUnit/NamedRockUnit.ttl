    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WAL"@en ;
    skos:prefLabel "Wallowbarrow Tuff Formation"@en ;
.

namedrockunit:WALD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:KGSG ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand and gravel, containing only durable, mostly angular and sub-angular lithologies, particularly flint. Also contains significant quartz and quartzite clasts. Compared to older members the Waldringfield Member contains more flint, and quartzites are less commonly colourless. Palaeo current directions are to the north-east."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 5.3 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Lowestoft Formation till and outwash sand and gravel. Outwash sand and gravel may contain chalk clasts and is generally less well sorted than the Waldringfield Member. Palaeo-current directions in the overlying sands and gravels are typically towards the south or south-east."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kesgrave Sands and Gravels [Obsolete: use KGCA]"@en ;
    skos:broader namedrockunit:CCHR ;
    skos:definition "Gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WALD"@en ;
    skos:prefLabel "Waldringfield Member"@en ;
.

namedrockunit:WAM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CZS"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LIGN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ZC"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Walton Member comprises partly bioturbated, silty clays and clayey silts, interbedded with some very fine-grained sandy silty clay. It is micaceous, frequently with lignitic debris and pyrite, but is generally not glauconitic nor calcareous. There is usually a thin basal glauconitic sandy and gravelly bed, or a layer of dispersed well-rounded gravel. Where the Walton Member is thin, it includes several coarse sandy and gravelly seams. It is also characterised by the occurrence of numerous whitish streaks of silt, 1-3 mm diameter and about 5 mm long, which are the remains of a type of tubular foraminiferid (King, 1981; in prep., and unpublished notes). Disseminated lignite is abundant and marine molluscs and fish teeth occur in places. \r
\r
Marine: inner to outer shelf. \r
\r
Eocene (Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The Walton Member rests on a discontinuity, usually marked by a flint gravel bed or a glauconitic horizon, or both. It generally overlies the Harwich Formation except where it locally overlies the Lambeth Group (King, 1981; Ellison et al., 1994)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:LCBA ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The Walton Member thickens generally eastwards to a maximum of 17 m (King, 1981, in prep.)."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Walton Member is marked by the upwards appearance of more homogeneous strata comprising grey claystones and silty clays, in the overlying Ockendon Member (Division A3 of King, 1981)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "London Clay Basement Bed [Obsolete: use HWH, WAM]"@en ;
    skos:broader namedrockunit:LC ;
    skos:definition "Clayey silt, sandy silty clay and silty clay with subsidiary gravel and lignite. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WAM"@en ;
    skos:prefLabel "Walton Member"@en ;
.

