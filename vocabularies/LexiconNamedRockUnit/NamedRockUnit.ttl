namedrockunit:RIS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to brownish grey sandstone, mainly composed of abundant siliceous spicules of Rhaxella perforata (tetractinellid sponge), with scattered ferruginous ooids. Notably low density (highly porous?). Weathers in soil to angular blocks"@en ;
    lexicon:hasLowerBoundaryDefinition "Base is a change up from interbedded yellowish fine quartz sand, clayey in parts and locally cemented into calcareous sandstone, and sandy mudstone of undifferentiated Hazelbury Bryan Formation into grey sandstone with siliceous sponge spicules of the Ringsbury Spiculite Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:RCH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 6m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is a change up from grey sandstone with siliceous sponge spicules of Ringsbury Spiculite Member, into interbedded yellowish fine quartz, calcareous sandstone, and sandy mudstone of undifferentiated Hazelbury Bryan Formation or, where absent, into bedded, finely bioclastic limestone of the Stanford Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rhaxella Chert [Obsolete: use AGSP, RIS]"@en ;
    skos:broader namedrockunit:HYB ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RIS"@en ;
    skos:prefLabel "Ringsbury Spiculite Member"@en ;
.

namedrockunit:RISA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The member comprises thick-bedded, structureless, medium-grained, poorly to well sorted sandstones. It lacks bioturbation. Composition is sub-arkosic. The sandstones contain clay clasts and thinly interbedded laminated, fissile mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is defined by a sharp, down-section change from sandstones to dark grey, fissile mudstones (Kimmeridge Clay). The boundary is marked by a sharp, down-section increase in gamma-ray values and a sharp increase in velocity."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5173 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JD> ;
    lexicon:hasOldestAgeValue 1.548e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 55 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is defined by a sharp, down-section change from dark grey, fissile mudstones (Kimmeridge Clay) to sandstones. A down-section decrease in gamma-ray values and a sharp or transitional down-section decrease in velocity coincides with the boundary."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ribble Unit [Obsolete: use RISA]"@en ;
    skos:broader namedrockunit:KC ;
    skos:definition "Sandstone with subsidiary mudstone. Stratified bedrock. Occurs offshore. Deposited during the Kimmeridgian Age - to - Tithonian Age (Jurassic Period) (154.8-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RISA"@en ;
    skos:prefLabel "Ribble Sandstone Member"@en ;
.

namedrockunit:RKM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A dark to pale olive-and blue-grey, calcareous, bioturbated mudstone, interbedded with dark, laminated, micromicaceous, calcareous siltstones andsporadic fine-grained, grey-blue packstones and wackestones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the first mudstone above the characteristic pale noduliferous wackestones of the Hodderense Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4864 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasOldestAgeValue 3.43e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 100 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the base of the lowest packstone of the Pendleside Limestone Formation with less than 50% interbedded mudstone."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CQ> ;
    lexicon:hasYoungestAgeValue 3.37e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Rad Brook Beds [Obsolete: use RKM]"@en ;
    skos:broader namedrockunit:PDL ;
    skos:definition "Mudstone with subsidiary siltstone and trace limestone. Stratified bedrock. Occurs onshore. Deposited during the Holkerian Substage (Carboniferous Period) (343-337 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RKM"@en ;
    skos:prefLabel "Rad Brook Mudstone Member"@en ;
.

namedrockunit:RL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Coarsely bioclastic, shelly and crinoidal limestones, conglomeratic in places, with subordinate shaly mudstone beds and partings."@en ;
    lexicon:hasLowerBoundaryDefinition "The limestone of the Ravensholme Limestone Member either conformably overlies dark mudstones of the Bowland Shale Formation (undifferentiated) or rests directly on the relatively fine-grained limestones of the Pendleside Limestone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1142 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasOldestAgeValue 3.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "To c.35m"@en ;
    lexicon:hasUpperBoundaryDefinition "Top is overlain conformably by the predominantly mudstone sequence of the Bowland Shale Formation (undifferentiated)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Ravensholme Limestone [Obsolete: use RL]"@en ;
    skos:broader namedrockunit:BSG ;
    skos:definition "Limestone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Asbian Substage - to - Brigantian Substage (Carboniferous Period) (337-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RL"@en ;
    skos:prefLabel "Ravensholme Limestone Member"@en ;
.

