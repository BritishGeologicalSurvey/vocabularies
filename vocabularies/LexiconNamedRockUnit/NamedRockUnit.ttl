    skos:altLabel
        "Haddenham Formation"@en ,
        "Portland Beds [Obsolete: use HADD, PL, PLND]"@en ,
        "Portland Group"@en ;
    skos:definition "Obsolete name. Limestone, sand and sandstone with subsidiary conglomerate and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "PLND"@en ;
    skos:prefLabel "Portland Formation (Wiltshire, Oxfordshire and Buckinghamshire) [Obsolete: use PL]"@en ;
