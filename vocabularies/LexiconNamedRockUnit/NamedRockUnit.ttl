        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey compact even-bedded limestone and subordinate shaly calcareous mudstone."@en ;
