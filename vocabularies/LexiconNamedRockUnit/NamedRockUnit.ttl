namedrockunit:TLL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Thinly interbedded red, fine-grained, commonly bioturbated sandstones and siltstones. \r
\r
Perennial flood basin lakes; reduced amounts of calcrete and an abundance of burrowing structures suggest a high water table and less prolonged periods of subaerial exposure. \r
\r
Probably Lochkovian, but no diagnostic fauna has yet been found."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed 477 m (1565 feet) from the base of the section measured by Allen (1965a), where the basal sandstone of a thinly bedded sandstone/red siltstone succession of this formation overlies the thicker bedded succession of the underlying Porth-y-Mor Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "25 m+."@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is not seen."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:DULB ;
    skos:definition "Sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Lochkovian Age (Devonian Period) (419-412.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TLL"@en ;
    skos:prefLabel "Traeth Lligwy Formation"@en ;
