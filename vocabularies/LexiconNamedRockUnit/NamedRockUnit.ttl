namedrockunit:SCK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Red and bright red, cross-bedded sandstones with scattered mudstone clasts and a few quartz pebbles in the lower part, overlain by purple, yellow and pink sandstones with sporadic cornstones of the Kinnesswood Formation in the upper part, which has scattered quartz pebbles near the base. The unit is faulted against the underlying grey and red-purple sandstones and mudstones of the Lower Devonian, Arbuthnott-Garvock Group."@en ;
    lexicon:hasLowerBoundaryDefinition "Passes downwards and laterally into the Rosneath Conglomerate Formation in the Inverclyde-Loch Lomond area. Further east in the Kippen area, Francis, Forsyth, Read and Armstrong (1970) record Gargunnock Sandstones (~SCK) resting on the Teith Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GKS ,
        namedrockunit:UORS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "In excess of 400m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The base of the Kinnesswood Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DU> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Gargunnock Sandstone [Obsolete: use KPF, SCK]"@en ,
        "Upper Old Red Sandstone [Obsolete: use ORSU]"@en ;
    skos:broader namedrockunit:SAG ;
    skos:definition "Sandstone with subsidiary mudstone and trace pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Late Devonian Epoch (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SCK"@en ;
    skos:prefLabel "Stockiemuir Sandstone Formation"@en ;
.

namedrockunit:SCS
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/FEST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MCASST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Scalpay Sandstone Formation comprises siltstones and sandstone, in a gradually coarsening-upwards succession to massive fine-grained sandstone. Locally cross-bedded and bioturbated. Fossiliferous horizons of Pseudopecten and other bivalves exist. The top of the formation is characterised by thin beds, ferriginous material and of chamosite-rich oolidal ironstone."@en ;
    lexicon:hasLowerBoundaryDefinition "Diachronous coarsening upwards from fissile mudstone of the Pabay Shale Formation (PABS) to sandstone of the Scalpay Sandstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1169 ,
        namedrockunit:H1807 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasOldestAgeValue 1.929e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10 m exposed."@en ;
