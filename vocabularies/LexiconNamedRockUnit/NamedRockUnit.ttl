namedrockunit:MBP
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:S427 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Peat, highly compressed, black, < 0.6 m thick, with lenses of pebbly peaty sand and bleached white sand. Contains beetle remains and pollen indicative of (early Devensian) interstadial conditions. Sharp, draped, conformable contact with < 2 m underlying cobble gravel with lenses of finer gravel and sand, mainly clast-supported, containing subangular to rounded clasts of pink granite with psammites, gneiss and schist. All but psammite clasts commonly weathered. Iron pan commonly developed."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, erosional, undulating contact with underlying yellowish brown sandy clayey diamicton of the Suidheig Till Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H390 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QI> ;
    lexicon:hasOldestAgeValue 1.26e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "2.6 m, of which the Allt Odhar Peat Member is 0.6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Unconformable, glacitectonic contact with stiff, yellowish brown, stony sand/clay diamicton of the overlying Athais Till Formation"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Allt And Odhar Members Of The Allt Odhar Formation Of Bowen 1999"@en ,
        "Separate Allt Odhar Peat and Odhar Gravel Formations [Obsolete: use MBP]"@en ;
    skos:broader namedrockunit:BCAT ;
    skos:definition "Peat with subsidiary gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Ipswichian Stage - to - Devensian Stage (Quaternary Period) (.126-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:AOPT ,
        namedrockunit:BBP ,
        namedrockunit:BLYP ,
        namedrockunit:BNAN ,
        namedrockunit:CBFMP ,
        namedrockunit:ODGR ;
