namedrockunit:RSI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dark grey, locally red, purple and green stained, micaceous siltstone with subordinate thin beds of pale grey or purple-stained, fine- to medium-grained, locally bioturbated sandstone. Near the base there are small-scale rhythmic cycles of sandstone, siltstone and black shale."@en ;
    lexicon:hasLowerBoundaryDefinition "At the type locality the base of the formation is faulted against mid to pale grey oolitic limestone of the Pembroke Limestone Group. A non-tectonized base of the Formation has not been recorded at crop or in boreholes, suggesting that the formation was displaced to its current location above a low-angle lag fault, (Whittaker, 1975)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H3650 ,
        namedrockunit:ROS ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CZ> ;
    lexicon:hasOldestAgeValue 3.215e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "More than 138m, with 138m exposed (top not seen) at the type locality."@en ;
    lexicon:hasUpperBoundaryDefinition "The grey siltstones of the Rodway Silstone Formation are overlain unconformably by red, yellow and buff mottled, fine- to medium-grained sandstone of the Otter Sandstone Formation (Sherwood Sandstone Group)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CY> ;
    lexicon:hasYoungestAgeValue 3.19e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Rodway Beds [Obsolete: use RSI]"@en ,
        "Rodway Siltstones [Obsolete: use RSI]"@en ;
    skos:broader namedrockunit:MARR ;
    skos:definition "Siltstone with subsidiary sandstone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Marsdenian Substage - to - Yeadonian Substage (Carboniferous Period) (321.5-319 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "RSI"@en ;
    skos:prefLabel "Rodway Siltstone Formation"@en ;
.

