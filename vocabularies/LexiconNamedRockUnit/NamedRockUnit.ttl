namedrockunit:CLPL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Two c 0.25m limestone units, separated by c 1m of mudstone beds with nodular limestone beds in the upper part.  The limestone beds are shelly, medium grey, argillaceous packstone/grainstone.  Fauna includes forams, bivalves, ammonites, ostracods and echinoderms.  The lower part forms a positive feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey, calcareous mudstone with rare thin limestones of the undifferentiated Granby Member; at 71.78m depth in type section Fulbeck Airfield Borehole f/B5 (SK95SW/17)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3307 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasOldestAgeValue 2.014e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "1.48 to 3m; 1.48m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey, calcareous mudstone of the undifferentiated Granby Member; at 70.30m depth in type section Fulbeck Airfield Borehole f/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JH> ;
    lexicon:hasYoungestAgeValue 1.995e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Claypole Limestone [Obsolete: use CLPL]"@en ;
    skos:broader namedrockunit:GRBL ;
    skos:definition "Limestone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Hettangian Age (Jurassic Period) (201.4-199.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLPL"@en ;
    skos:prefLabel "Claypole Limestones Bed"@en ;
.

namedrockunit:CLRG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMOOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Limestone, coralliferous, variably ooidal, shelly: member typically formed of two beds: a lower shelly, ooidal, bioclastic packstone/wackestone with coral debris, and an upper very fossiliferous calcilutite with many corals \r
in life position, coral debris and a shelly fauna of bivalves, gastropods and echinoids. This passes laterally in places into a sparsely fossiliferous, laminated limestone facies."""@en ;
    lexicon:hasLowerBoundaryDefinition "Non sequence or erosional disconformity: generally a poorly to moderately shelly ooid-limestone (Malton Oolite Member, Coralline Oolite Formation) sharply overlain by a moderately to highly fossiliferous, moderately ooidal, lime-muddy, bioclastic limestone (Coral Rag Member); locally boulders of Malton Oolite may be set in Coral Rag limestone (Wright, 1972, p. 241)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2706 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 12m: Tabular Hills 1 to 9m, Hambleton Hills 4.5 to 8m, Howardian Hills 0 to at least 12m."@en ;
    lexicon:hasUpperBoundaryDefinition "Non-sequence: rubbly coralliferous shelly limestone (Coral Rag Member) sharply overlain by silty mudstone and fine-grained sandstone (Newbridge Member) or fine-grained calcareous sandstone (Spaunton Sandstone Member) or unfossiliferous fine-grained limestone (North Grimston Cementstone Member) or mudstone (Langton Clay Member) or sandstone (Limekiln Member), all of Upper Calcareous Grit Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Coral Rag [Obsolete: use CLRG, WYLS]"@en ;
    skos:broader namedrockunit:COO ;
    skos:definition "Limestone with subsidiary ooid-limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CLRG"@en ;
    skos:prefLabel "Coral Rag Member (Cleveland Basin)"@en ;
.

