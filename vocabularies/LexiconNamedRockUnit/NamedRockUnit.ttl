namedrockunit:POSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:PLS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The lower part of the formation comprises mixed siliciclastic and carbonate sediments, including bioturbated clay-rich siltstones, fine-grained sandstones and silty mudstones with variable amounts of calcite and dolomite. Some beds are shell-rich, especially with oysters. The upper part of the formation comprises purer carbonate lithologies, including finely crystalline, bioturbated dolomite (usually described as sandstone in lithological accounts). A number of local informal stratigraphic divisions are named (Barton et al., in press), but no formal members are recognised.\r
At depth in the Weald, the formation is much more clayey than in Dorset and difficult to distinguish from the Kimmeridge Clay Formation below (Gallois, 1965). \r
The continuation of the formation offshore into the Channel is doubtful (Hamblin et al., 1992)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is recognised by the upward change from the silicate mudstone to finely sandy siltstone of the Kimmeridge Clay Formation to the coarser siliciclastic clayey siltstone or sandstone and limestone facies of the basal Portland Sand Formation. In most parts of south Dorset this change in facies appears to be gradational."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2373 ,
        namedrockunit:PSND ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasOldestAgeValue 1.492e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to about 39m (Isle of Purbeck), 30m (Isle of Portland), 8.5m (Ringstead Bay)."@en ;
    lexicon:hasUpperBoundaryDefinition "On the Isle of Portland (Dorset), the upper boundary is marked by the facies change from mudstone ('Portland Clay') to lime mud-rich limestone with common chert nodules, here coincident with a slight unconformity and a shell-rich horizon (Basal Shell Bed) at the base of the Portland Stone Formation. On the Isle of Purbeck (Dorset), the boundary is marked by the conformable upward facies change from finely crystalline dolomitic limestone (Black Sandstones) to chert-bearing bioturbated calcilutite (Lower Cherty Beds) of the Portland Chert Member of the Portland Stone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JI> ;
    lexicon:hasYoungestAgeValue 1.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Portland Sand Formation [Duplicate: use POSA]"@en ,
        "Portland Sand Member (Wiltshire, Oxfordshire and Buckinghamshire) [Obsolete: use POSA]"@en ,
        "Portland Sand [Obsolete: use POSA, PLS, PSND, WAR]"@en ;
    skos:broader namedrockunit:PL ;
    skos:definition "Dolostone, sandstone and siltstone with subsidiary limestone. Stratified bedrock. Occurs both onshore and offshore. Deposited during the Tithonian Age (Jurassic Period) (149.2-143.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BNRB ,
        namedrockunit:BNRS ,
        namedrockunit:POCL ;
    skos:notation "POSA"@en ;
    skos:prefLabel "Portland Sand Formation"@en ;
.

namedrockunit:PYL
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:MDVL ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Comprises irregular masses of fine-grained pale grey stromatoporoid boundstone that pass laterally and vertically into coarse-grained crinoidal packstone and grainstone with scattered stromatoporoids and corals. Erosive floatstone and rudstone beds of reworked and broken coral and stromatoporoid colonies are also present. Beds of fine-grained skeletal packstone interdigitate with normal facies. Red argillaceous calcite mudstone and breccia are found as fissure fill."@en ;
    lexicon:hasLowerBoundaryDefinition "Faulted out."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H901 ,
        namedrockunit:TPL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DI> ;
    lexicon:hasOldestAgeValue 3.943e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Not known. (This is a reef, which varies from 0 where not developed)."@en ;
    lexicon:hasUpperBoundaryDefinition "Faulted out."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasYoungestAgeValue 3.711e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Middle Devonian Limestone"@en ,
        "Plymouth Limestone [Obsolete: use FAR, PRK, PYL]"@en ,
        "Torquay and Plymouth Limestones [Obsolete: use TQL, PYL]"@en ;
    skos:broader namedrockunit:TAMA ;
    skos:definition "Limestone and trace mudstone. Stratified bedrock. Occurs onshore. Deposited during the Eifelian Age - to - Frasnian Age (Devonian Period) (394.3-371.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CATTE ,
        namedrockunit:FAR ,
        namedrockunit:PRK ;
    skos:notation "PYL"@en ;
    skos:prefLabel "Plymouth Limestone Formation"@en ;
.

