namedrockunit:BGSI
    a skos:Concept ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/OLBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Medium-grained dark grey basalt showing strong horizontal joints and a rude columnar structure. \r
\r
Petrographically, it is an olivine-basalt with scattered phenocrysts of olivine and plagioclase (up to 2.5 mm long) in a matrix of labradorite laths which occasionally show zoning, sub-ophitic augite, olivine, accessory magnetite and interstitial chlorite."""@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
    lexicon:hasOldestAgeValue 6.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/G> ;
