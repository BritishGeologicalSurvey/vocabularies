    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TKB"@en ;
    skos:prefLabel "Tickwood Member"@en ;
.

namedrockunit:TKLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BATRAT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Tappetknowe Lava Member consists of of several lavas with a total thickness of approximately 40 metres. These include, near Tappetknowe [NS 750 815] microporphyritic basaltic-trachyandesite (mugearite), trachybasalt and rare plagioclase-macrophyric trachybasalt (of 'Markle' type). The rocks are intensely faulted and jointed and deeply weathered, with exposure limited to small crags. Craig (1980) has inferrred that the source of the lavas was nearby to the present outcrop."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is conformable or locally disconformable on the underlying Laird's Loup Lava Member which comprises plagioclase-macrophyric trachybasalt; it is taken as the incoming of microporphyritic lavas (basaltic-trachyandesite to trachybasalt)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1864 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "40 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Tappetknowe Lava Member is overlain to the north-east of the Takmadoon Fault (Craig, 1980) by the Denny Muir Lava Member. The lithological change here is to massive, well-featured plagioclase-macrophyric basalt (of 'Markle' type), trachybasalt and rare basaltic trachyandesite (mugearite). To the south-east of the Tak-ma-doon Fault, the Tappetknowe Lava Member is overlain by the Kilsyth Hills Lava Member, and the lithological change is mainly to plagioclase-macrophyric basalts and trachybasalts (hawaiites of 'Markle' type)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Tappetknowe Lavas [Obsolete: use TKLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basaltic-trachyandesite and trachybasalt with subsidiary basalt. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TKLA"@en ;
    skos:prefLabel "Tappetknowe Lava Member"@en ;
.

namedrockunit:TKTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very compact, olive grey, sandy, silty, clayey, stony diamicton containing clasts mainly of \"Borrowdale Volcanic Group\" lithologies, slate and Threlkeld microgranite. Locally includes masses of weathered diamicton (Thornsgill Till) at base. Commonly weathered to yellowish grey."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally an unconformable boundary on bedrock. Locally a sharp, planar, or gradational glacitectonic boundary with yellowish brown sandy gravelly clay diamicton (Thornsgill Till Formation)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H571 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasOldestAgeValue 2.6e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 25 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Mostly ground surface or overlain unconformably by glaciofluvial sand and gravel."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QDD> ;
    lexicon:hasYoungestAgeValue 1.47e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Threlkeld Member [Obsolete: use TKTI]"@en ;
    skos:broader namedrockunit:CCGL ;
    skos:definition "Gravel with subsidiary sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Dimlington Stadial (Quaternary Period) (.026-.0147 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TKTI"@en ;
    skos:prefLabel "Threlkeld Till Formation"@en ;
.

