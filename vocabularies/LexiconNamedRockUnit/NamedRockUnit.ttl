    lexicon:hasLithologyDescription "[Obsolete: use CWA, PENN, POB] An upper portion of sandstones with alternations of marl, and a lower portion of lenticular quartz-conglomerate beds with sandstones, grits and quartzites."@en ;
    lexicon:hasLowerBoundaryDefinition "Drawn at the base of lenticular quartz-conglomerate beds with sandstones, grits and quartzites, where they rest unconformably on Early Devonian sandstones of the Brownstones Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasOldestAgeValue 3.711e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "c.77m"@en ;
    lexicon:hasUpperBoundaryDefinition "Drawn at the conformable upward passage from sandstones and marls of the Quartz Conglomerate Group into limestones and calcareous mudstones of the \"Carboniferous Limestone\" [generally the Lower Limestone Shale Group or its lateral equivalents]."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    lexicon:isObsoleteEquivalentOf
        namedrockunit:CWA ,
