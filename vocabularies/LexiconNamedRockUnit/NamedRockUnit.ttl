namedrockunit:GLEV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Formation encompasses marine, estuarine and terrestrial deposits that were formed in the Gwent Levels area during the Holocene transgression. The deposits are dark blue-grey silty clays and silts with subordinate sands and beds of peat, submerged forests and gravel. The deposits rest on a rockhead platform at -5 to -7.5m OD, intricately dissected by river valleys, and their upper surface is approximately level at c 4.5 to 7m OD. The river valleys are infilled with gravels and sands that become shelly upwards. Typically two beds of peat are included, up to 0.6m thick. The lower of these forms the lowest unit in the formation, except where it rests upon the valley-fill sands and gravels, and was formed c 8500-8000 years BP when a birch forest was inundated by the rising sea. The other formed c.5000-4500 years BP during a slowing down of the rising sea level, and is now found resting horizontally at OD."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests unconformably on Triassic bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:ESAL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10 to 15m, increasing to 35m in buried channels."@en ;
    lexicon:hasUpperBoundaryDefinition "Surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Estuarine Alluvium [Obsolete: use TFD]"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Clay and silt with subsidiary gravel, peat and sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:WLLEV ;
    skos:notation "GLEV"@en ;
    skos:prefLabel "Gwent Levels Formation"@en ;
.

namedrockunit:GLGT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PEL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SCHM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Mixed psammite, semipelite and pelite. Psammites typically gritty. Pelites include types rich in staurolite and muscovite, and some are also kyanite-bearing. Schists rich in iron-ore minerals form mappable units in places. Beds of quartzite with specks of green mica occur rarely near the base of the Formation. "@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational transition from Glen Effock Schist Formation marked by incoming of silvery muscovite-rich pelite, increase in proportion of gritty psammite and decrease in proportion of green feldspathic semipelite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:DCGL ,
        namedrockunit:H4066 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "At least 3000m indicated in Glen Esk; tectonic thickening probably less than in Glen Effock Schist Formation."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen: faulted against Highland Border Complex."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glen Lethnot (Grit) Group [Obsolete: use GLGT]"@en ,
        "Glen Lethnot Grits [Obsolete: use GLGT]"@en ;
    skos:broader namedrockunit:SOHI ;
    skos:definition "Pelite, psammite and semipelite with subsidiary schist and trace gritty psammite, mica schist and quartzite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GLGT"@en ;
    skos:prefLabel "Glen Lethnot Grit Formation"@en ;
.

