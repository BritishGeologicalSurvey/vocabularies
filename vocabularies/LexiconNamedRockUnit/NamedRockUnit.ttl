    lexicon:hasThicknessDescription "3 to 34m"@en ;
    lexicon:hasUpperBoundaryDefinition "Either the ground surface or the basal surface of red silt of the Trysull Silt Formation or till and sand and gravel of the Stockport Glacigenic Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QA> ;
    lexicon:hasYoungestAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Trysull Sands and Gravel [Obsolete: use SDNSG]"@en ;
    skos:broader namedrockunit:ISCAG ;
