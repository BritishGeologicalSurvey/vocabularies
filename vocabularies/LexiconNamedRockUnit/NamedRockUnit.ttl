namedrockunit:LESI
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Very fine- to coarse-grained sand, silt and clay, grey and brownish grey, well laminated to thin-bedded, some pebbles up to 4cm, finely micaceous, rooty near top below sub-Carse Peat (where developed), depending on location within the palaeo-estuary, the dominant material varies from sand to clay. The deposit forms a series of buried raised beaches/terraces related to transgressive and regressive cycles of sea-level change."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable and transgressive base on older units including the Bothkennar Gravel, Abbotsgrange Silt and Kinneil Kerse Silt members of the Forth Clay Formation and the Errol Clay Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1650 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 9m"@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain unconformably by the sub-Carse Peat (where present) and transgressive estuarine clay, silt and sand of the Carse of Stirling Clay Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Letham Beds [Obsolete: use LESI]"@en ;
    skos:broader namedrockunit:CARCL ;
    skos:definition "Clay, sand and silt and trace gravel. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage - to - Holocene Epoch (Quaternary Period) (.116-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LESI"@en ;
    skos:prefLabel "Letham Silt Member"@en ;
.

