namedrockunit:ESP
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In type area, laminated volcaniclastic mudstone and siltstone (\"hornstone\") with interbeds of volcaniclastic sandstone and eutaxitic lapilli tuff. Becoming massive bedded volcaniclastic sandstone with intercalations of volcaniclastic breccia, tuff and lapilli-tuff to the east."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of bedded volcaniclastic sedimentary rock sequence, unconformably overlying Lincomb Tarns Tuff Formation (dacitic lapilli-tuff)."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2790 ,
        namedrockunit:H895 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasOldestAgeValue 4.582e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "170m in Central Fells, reaching 200m in the Helvellyn area"@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen in type area, but around Hellvellyn it is defined by the base of various overlying formations, including the Middle Dodd Dacite, Deepdale and Helvellyn formations."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Esk Pike Formation [Obsolete: use ESP]"@en ,
        "Esk Pike Hornstone [Obsolete: use ESP]"@en ;
    skos:broader namedrockunit:BVG ;
    skos:definition "Volcaniclastic-mudstone, volcaniclastic-sandstone and volcaniclastic-siltstone with subsidiary lapilli-tuff, tuff and volcaniclastic-breccia. Stratified bedrock. Occurs onshore. Deposited during the Caradoc Series (Ordovician Period) (458.2-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ESP"@en ;
    skos:prefLabel "Esk Pike Sandstone Formation"@en ;
.

namedrockunit:ESTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pebbly sandy silty clay diamicton, calcareous, dark bluish grey but mottled orangey brown near top, and dark greenish grey at depth, containing well-dispersed clasts of red granite, quartzite and schistose metasediments, and sparse fragments of shell, red marl, red sandstone and chalk. The unit locally includes rafts of red clayey diamicton and black fossiliferous mudstone. Commonly including a lower unit that is dark reddish brown."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp uncomformable, undulating contact with Hatton Till Formation or bedrock, or gradational, planar, glacitectonic contact with laminated silt and clay of the Ugie Clay Formation. At partial type section NK05SE 1 the unit unconformably overlies unnamed greenish grey sand and gravel, which in turn rests on olive brown diamicton of the Hythie Till Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H673 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 10m."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally sharp, erosional with overlying glaciofluvial or alluvial sand and gravel or ground surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Blue-Grey Series [Obsolete: use BCD, ESTI]"@en ;
    skos:broader namedrockunit:BCD ;
    skos:definition "Clay and silt with subsidiary gravel and sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:ARTI ;
    skos:notation "ESTI"@en ;
    skos:prefLabel "Essie Till Formation"@en ;
.

namedrockunit:ETVE
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/COAL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Brown to grey, massive, fine- to medium-grained, cross-bedded sandstones. Upward coarsening (e.g. 3/3-3 and 211/27-10) and upward fining (211/18a-21) sections occur. Thin coal seams occur locally."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is placed at a down-section change from less micaceous and/or coarser sandstones to finer, more micaceous, sandstones (Rannoch Formation). A down-section increase in gamma values and increase in velocity occurs at the boundary."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H5190 ,
        namedrockunit:H5191 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JA> ;
    lexicon:hasOldestAgeValue 1.747e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 40 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The Etive/Ness boundary is an erosion surface. In the type section it is placed at the base of the lowest significant mudstone or coal seam, and significant down-section decrease in gamma values. In north-eastern East Shetland Basin sandstones of the Ness or Tarbert formations overlie without a distinctive argillaceous interval and the boundary is difficult to define on wireline logs. Locally the upper boundary is placed at a downward change from siltstones and mudstones (Heather Formation) to sandstones."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Etive Sub-Unit [Obsolete: use ETVE]"@en ,
        "Massive Sand Bed [Obsolete: use ETVE]"@en ;
    skos:broader namedrockunit:BRNT ;
    skos:definition "Sandstone and trace coal. Stratified bedrock. Occurs offshore. Deposited during the Aalenian Age - to - Bajocian Age (Jurassic Period) (174.7-168.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ETVE"@en ;
    skos:prefLabel "Etive Formation"@en ;
.

namedrockunit:EWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, massive, grey, bioclastic, generally devoid of mudstone partings; typically rich in algal remains with a prominent fauna of brachiopods and corals; appreciably dolomitized in part, giving a brown-weathered and vuggy appearance."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the generally conformable, sharp base of the first bed of limestone that overlies measures of the Alston Formation, typically sandstone."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:HLLS ,
        namedrockunit:S156 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "5 to 10 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the top of the uppermost limestone bed that is overlain by a sequence of dark grey mudstones and siltstones, containing ironstone nodules locally."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Eelwell Limestone [Obsolete: use EWL]"@en ,
        "Harelawhill Limestone [Obsolete: use EWL]"@en ;
    skos:broader namedrockunit:AG ;
    skos:definition "Limestone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "EWL"@en ;
    skos:prefLabel "Eelwell Limestone Member"@en ;
.

namedrockunit:EXM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Grey mudstones with subordinate thin- to medium-bedded siltstones, sandstones and a few limestones. The Group is punctuated by three sandstone-dominated formations. The lower two are predominantly red, purple green and grey sandstones with minor conglomerates and trace mudstones. The upper one is interbedded grey to buff sandstones, siltstones and mudstones."@en ;
    lexicon:hasLowerBoundaryDefinition "Not seen."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "c.7000m"@en ;
    lexicon:hasUpperBoundaryDefinition "The upper boundary is taken at the incoming of hard black finely laminated unfossiliferous and silty mudstones of the Teign Valley Group (Doddiscombe Formation) above the soft mid to dark grey mudstones with scattered very thin fossiliferous limestones, siltstones and sandstones of the underlying Exmoor Group (Pilton Mudstone Formation)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:definition "Mudstone and siltstone with subsidiary limestone and sandstone and trace conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) - to - Tournaisian Age (Carboniferous Period) (410.5-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:isTopConceptOf lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:BYS ,
        namedrockunit:PLT ;
    skos:notation "EXM"@en ;
    skos:prefLabel "Exmoor Group"@en ;
.

