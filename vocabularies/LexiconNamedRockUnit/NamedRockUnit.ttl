    lexicon:hasThicknessDescription "About 450 - 500 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The sandstone of the Auchencar Sandstone Formation, and the top of the Creag Mhor Conglomerate Member are overlain by the base of the Machrie Burn and Allt an Brighide Siltstones of the Am Binnein Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
