namedrockunit:MPA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BAANDT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LPTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use WB] Dacitic lapilli-tuff and tuff. Mostly massive with some interbeds of parallel bedded tuff. Intruded by basalt, basaltic andesite and andesite and locally contains intercalated andesite lava."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformity. Overlies less widely distributed older Formations (Po House and Whinney Bank) in the Borrowdale Volcanic Group and locally rests directly on the Skiddaw Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1707 ,
        namedrockunit:H405 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O2> ;
    lexicon:hasOldestAgeValue 4.68e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "1800-2600m"@en ;
    lexicon:hasUpperBoundaryDefinition "Parallel bedded tuffs of the Duddon Hall Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O4> ;
    lexicon:hasYoungestAgeValue 4.4975e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:WB ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "A variety of local names [Obsolete: use MPA]"@en ,
        "Middle Tuffs [Obsolete: use MPA]"@en ,
        "Waberthwaite Tuff Formation"@en ;
    skos:definition "Obsolete name. Lapilli-tuff with subsidiary andesite, basalt, basaltic-andesite and tuff. Stratified bedrock. Occurs onshore. Deposited during the Abereiddian Stage - to - Caradoc Series (Ordovician Period) (468-449.75 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MPA"@en ;
    skos:prefLabel "Millom Park Formation [Obsolete: use WB]"@en ;
.

namedrockunit:MPMU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
