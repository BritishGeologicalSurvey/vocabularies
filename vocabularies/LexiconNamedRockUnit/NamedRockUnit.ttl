namedrockunit:DWS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PESST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use CYD] Dominantly of white sandstone with subordinate pebbly sandstone and conglomerate containing abundant pebbles of limestone, quartz and mudstone. There are also some highly calcareous sandy beds (Francis et al., 1970). Sandstones within the unit are characterised by large scale cross-stratification (Read and Johnson, 1967). Toward the top of the formation increasing amounts of volcanic detritus appear (Francis et al., 1970)."@en ;
    lexicon:hasLowerBoundaryDefinition "There is passage by alternation with strata of the underlying Ballagan Formation, although locally the base is abrupt and possibly disconformable with erosion confined to local channels. The base of the unit is generally drawn at the lowest bed that is coarser than a fine-grained sandstone."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "108m (330 feet) at Stronend [NS 6300 8900], decreasing eastnortheastwards to 41.3m (126 feet) in the Stirling No.1 (Kaimes) Borehole [NS79SE/21] at NS7720 9454."@en ;
    lexicon:hasUpperBoundaryDefinition "Lavas of the Clyde Plateau Volcanic Formation seem to rest without angular discordance on and define the upper boundary of the unit. In detail, the base of the lava pile is diachronous, as different flows seem to form the base of the volcanic succession at different localities."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:CYD ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Clyde Sandstone Formation"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary conglomerate and pebbly (gravelly) sandstone. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DWS"@en ;
    skos:prefLabel "Downie's Loup Sandstone Formation [Obsolete: use CYD]"@en ;
.

