namedrockunit:HEAD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent
        namedrockunit:H4947 ,
        namedrockunit:HDTS ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/REGOL"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """Head is poorly sorted and poorly stratified, angular rock debris and/or clayey hillwash and soil creep, mantling a hillslope and deposited by solifluction and gelifluction processes. Solifluction is the slow viscous downslope flow of waterlogged soil and other unsorted and unsaturated superficial deposits. The term gelifluction is restricted to the slow flow of fluidized superficial deposits during the thawing of seasonally frozen ground. The flow is initiated by meltwater from thawing ice lenses. \r
\r
Polymict deposit: comprises gravel, sand and clay depending on upslope source and distance from source. Locally with lenses of silt, clay or peat and organic material."""@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:HEG ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
