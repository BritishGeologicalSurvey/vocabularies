namedrockunit:DBH
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Limestone, with interbedded subordinate claystone and siltstone. Limestones vary from packstone to wackestone and grainstone. They are typically grey, bioclastic including crinoids and corals and bioturbated. Sedimentary structures vary but include cross-bedding, wave ripples and hummocky cross-bedding. Claystones and siltstones are grey, bioclastic, forming thin, discontinuous beds. Interpreted to represent a carbonate ramp facies."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the formation is taken at the base of the Turkeyland Member,which is poorly defined. It rests directly on conglomerate of the Langness Conglomerate Formation on the foreshore at Derbyhaven [SC 2820 6607], although outcrops are discontinuous and poorly exposed. It was formerly exposed at the now infilled Turkeyland Quarry [SC 2950 6940], where it rested directly on conglomerates of the Langness Conglomerate Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2743 ,
        namedrockunit:H3349 ,
        namedrockunit:H845 ,
        namedrockunit:H846 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Greater than 90m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is poorly defined. It is overlain by the Knockrushen Formation, with the boundary taken as immediately above a byozoan bed which is exposed to the north-east of the airport light gantry at Ronaldsway, at Port St Mary and Ballasalla (Dickson et al.1987). No grid references are quoted in the Dickson et al. (1987) papers for these localities."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Ballasalla Formation [Obsolete: use DBH]"@en ,
        "Derbyhaven Beds [Obsolete: use DBH]"@en ,
        "Lower Castletown Limestones [Obsolete: use DBH]"@en ,
        "Lower Grey and Dark Limestones of Lewis [Obsolete: use DBH]"@en ;
    skos:broader namedrockunit:GSCL ;
    skos:definition "Limestone with subsidiary claystone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:SKIL ,
        namedrockunit:SWIK ,
        namedrockunit:TURK ;
    skos:notation "DBH"@en ;
    skos:prefLabel "Derbyhaven Formation"@en ;
.

namedrockunit:DDC
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Hard, black, slightly siliceous, finely laminated mudstones with sparse very thin siltstone beds. There are scattered thin lenticular ?chert and phosphate nodules and sparse impure limestones and local pale calcareous mudstones. The formation is rarely fossiliferous."@en ;
    lexicon:hasLowerBoundaryDefinition "Between Brushford and Wellington the lower boundary is taken at the incoming of hard black finely laminated unfossiliferous, slightly siliceous mudstones of the Doddiscombe Formation above the soft medium to dark grey mudstones with scattered very thin limestones, siltstones and sandstones of the underlying Pilton Mudstone Formation. West of South Molton, the lower boundary is taken at the incoming of dark grey to black, rarely fossiliferous slightly siliceous, finely laminated mudstones (Unit D of the Pilton Beds of Prentice, 1960), known to equate with the Doddiscombe Formation, above the fossiliferous mudstones with thin sandstones and siltstones of the underlying Pilton Mudstone Formation. The Doddiscombe Formation has not been mapped by BGS west of South Molton; instead it has been included in the Pilton Mudstone Formation and/or the Codden Hill Chert Formation. Further work is therefore needed."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1494 ,
        namedrockunit:H205 ,
        namedrockunit:H2150 ,
        namedrockunit:H3354 ,
        namedrockunit:H3812 ,
        namedrockunit:H4598 ,
        namedrockunit:H4599 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CT> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "8 to 80 m; lower thickness likely to be tectonic."@en ;
    lexicon:hasUpperBoundaryDefinition "Between Brushford and Wellington the upper boundary is taken at the incoming of thin to medium bedded soft siliceous mudstones with impure limestones and cherts of the Bampton Limestone Formation above the hard black, finely laminated unfossiliferous cherty mudstones of the underlying Doddiscombe Formation. West of South Molton, the upper boundary is taken at the incoming of dark grey interbedded siliceous mudstones and shaly mudstones of the overlying Coddon Hill Chert Formation above the dark unfossiliferous slightly siliceous mudstones (Unit D of the Pilton Beds of Prentice, 1960), known to equate with the Doddiscombe Formation. Neither this boundary nor the Doddiscombe Formation has been mapped by BGS west of South Molton and further work is needed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Basement Beds [Obsolete: use WAR, HEY, BRCT, BABE, LFSB, LLW, DELA, FRM, PLT, FRFA, PFLD, DDC]"@en ,
        "Basement Formation (Pars) [Obsolete: use DDC]"@en ,
        "Doddiscombe Beds [Obsolete: use DDC]"@en ,
        "Landkey Formation [Obsolete: use DDC]"@en ,
        "Lower Culm Measures (pars) [Obsolete: use TCH, DDC]"@en ,
        "Pilton Beds (pars) [Obsolete: use DDC]"@en ,
        "Pilton Shales (pars) [Obsolete: use DDC]"@en ;
    skos:broader namedrockunit:TEVY ;
    skos:definition "Siliceous mudstone and trace chert, limestone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Tournaisian Age - to - Visean Age (Carboniferous Period) (359.3-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DDC"@en ;
    skos:prefLabel "Doddiscombe Formation"@en ;
.

