namedrockunit:KCM
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SIMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use LLL] Silicate- and calcareous mudstone, interbedded with thin and more or less argillaceous limestones (calcilutite and shelly and peloidal wackestone). Locally includes coralliferous limestone bodies (knoll reef)."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable contact between the underlying less argillaceous limestone (peloidal or ooidal wackestones and packstones - Santon Oolite) and calcareous siltstone (Raventhorpe Beds) succession, generally lacking mudstone interbeds, overlain by interbedded calcareous mudstone and argillaceous limestone of the Kirton Cementstone Beds."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2872 ,
        namedrockunit:H339 ,
        namedrockunit:H3491 ,
        namedrockunit:H4114 ,
        namedrockunit:H988 ,
        namedrockunit:H989 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "0 to c. 9.5 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Disconformable, commonly channelled contact between interbedded calcareous mudstone and argillaceous limestone of the Kirton Cementstone and high energy ooidal limestones of the overlying Upper Lincolnshire Limestone Member [Hibaldstow Limestone/Cave Oolite]. Near its northern limit only, disconformable contact with ferruginous sandy calcareous sediments of the Hunstanton Formation (Cretaceous)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasYoungestAgeValue 1.682e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:LLL ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Kirkton Cementstones Member plus Kirton Cement Shale [Obsolete: use KCM]"@en ,
