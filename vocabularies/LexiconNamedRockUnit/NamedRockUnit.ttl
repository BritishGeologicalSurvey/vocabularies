namedrockunit:STRW
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:CLH ,
        namedrockunit:GLF ,
        namedrockunit:LL ,
        namedrockunit:PNTL ,
        namedrockunit:S970 ,
        namedrockunit:S971 ,
        namedrockunit:SCR ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The formation comprises predominantly sandstones with interbedded siltstones, mudstones and occasional limestones.  Sandstones are pale grey to white, poorly to well cemented, very fine- to medium-grained, occasionally glauconitic and carbonaceous.  Interbedded mudstones are pale green-grey, dark grey or variegated.  Limestones are grey, buff or cream, micritic, oolitic or bioclastic."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is characterised by a change from sandstones to dominantly mudstones (Wroot Formation) and a corresponding down-section increase in gamma values and decrease in velocity."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JB> ;
    lexicon:hasOldestAgeValue 1.709e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 150 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the formation is marked by a sharp downward change from variegated mudstones (Hudleston Formation) to sandstones or siltstones with interbedded mudstones.  The lithological change coincides with a down-section decrease in gamma-ray values and, usually, an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
