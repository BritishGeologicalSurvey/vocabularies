    skos:altLabel
        "Second Brimham Grit [Obsolete: use UPBM]"@en ,
        "Upper Plompton Grit"@en ;
    skos:broader namedrockunit:HEBD ;
    skos:definition "Sandstone. Stratified bedrock. Occurs onshore. Deposited during the Kinderscoutian Substage (Carboniferous Period) (322-321.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "UPBM"@en ;
    skos:prefLabel "Upper Brimham Grit"@en ;
