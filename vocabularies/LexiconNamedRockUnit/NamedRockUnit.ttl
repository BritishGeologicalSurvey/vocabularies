namedrockunit:DRCR
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANDLAV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRAND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Conglomerate, clast-supported, with angular to well-rounded boulders, cobbles and pebbles. In the lower part these consist predominantly of lava, psammite and quartzite, but in the upper part the conglomerates are of markedly different provenance and were deposited from streams flowing in opposing directions. Poorly-sorted volcaniclastic sandstone and conglomerate are interbedded with non-volcaniclastic conglomerate. Non-volcaniclastic deposits consist of poorly-sorted conglomerate, with angular clasts, and bimodally-sorted conglomerate with rounded clasts. Flows of trachybasalt, trachyandesite and andesitic lava occur in the lower and middle parts of the group. The top of the Dunnottar-Crawton Group is characterised by the intermittent occurrence of volcanic rocks including trachybasaltic lavas and welded dacitic tuff (Lintrathen Tuff Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "Base of Downie Point Conglomerate Member (Dunnottar Castle Conglomerate Formation), where thickly-bedded or massive conglomerate overlies pebbly sandstone of Carron Sandstone Formation with apparent conformity. This marks the base of a thick, conglomerate-dominated succession."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:CRNG ,
        namedrockunit:DRG ,
        namedrockunit:GBC ,
        namedrockunit:H870 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SU> ;
    lexicon:hasOldestAgeValue 4.267e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "Variable; 3300m in the Stonehaven area, thinning southwestward to less than 1500m. Presumed to be overlapped by younger groups to the southwest."@en ;
    lexicon:hasUpperBoundaryDefinition "In the type area, this is taken as the top of the highest lava of the Crawton Volcanic Formation, where it is overlain by a clast-supported conglomerate at the base of the Arbuthnott-Garvock Group. Elsewhere it is taken as the top of the thick deposit of welded tuff (Lintrathen Tuff Member), or at the base of the lowest of the series of lavas belonging to the Arbuthnott-Garvock Group. Believed to be progressively overstepped towards the south-west by the Arbuthnott-Garvock Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DO> ;
    lexicon:hasYoungestAgeValue 4.124e+02 ;
