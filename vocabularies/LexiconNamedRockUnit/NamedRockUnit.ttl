namedrockunit:STSK
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Stack Skerry Formation is made up of white to grey, firm to hard, very fine- to occasionally coarse-grained, well-sorted, subangular to subrounded, carbonate- and kaolinite-cemented, micromicaceous, slightly carbonaceous sandstones with interbedded grey, firm, blocky to subfissile, calcareous, micromicaceous, microcarbonaceous, slightly silty mudstones and grey to black, calcareous, micromicaceous, microcarbonaceous, slightly sandy siltstones."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Stack Skerry Formation is not defined as no wells have penetrated it."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "It attains an unbottomed thickness of 513 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Stack Skerry Formation is marked by a downward change from Sule Skerry Formation mudstones to an interbedded succession of sandstones, mudstones and siltstones. This transition is represented on wireline logs by a downward decrease in gamma-ray log values and an increase in velocity."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JE> ;
    lexicon:hasYoungestAgeValue 1.842e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:SKRY ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs offshore. Deposited during the Sinemurian Age - to - Pliensbachian Age (Jurassic Period) (199.5-184.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STSK"@en ;
    skos:prefLabel "Stack Skerry Formation"@en ;
.

