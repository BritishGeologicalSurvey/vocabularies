namedrockunit:CHSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sand, quartzose, fine- to medium-grained, generally unbedded, with seams of poorly sorted predominantly limestone gravel, especially in the lower part. Sand probably derived by aeolian processes from nearby river terrace deposits. Gravel largely Middle Jurassic ooidal limestone derived probably by solifluction from the nearby Cotswold escarpment, plus ironstone and derived fossils. Rare clay lenticles."@en ;
    lexicon:hasLowerBoundaryDefinition "Bedrock surface beneath deposit or underlying superficial deposit. Base channelled, notably under Cheltenham."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H127 ,
        namedrockunit:H3297 ,
        namedrockunit:H781 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to about 15 m, very variable."@en ;
    lexicon:hasUpperBoundaryDefinition "Upper surface of deposit, other deposits may overlie. Generally planar surface."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cheltenham Sands [Obsolete: use CHSG]"@en ,
        "Combined Cheltenham Sand and Fan Gravel [Obsolete: use CHSG]"@en ,
        "Jurassic gravels [Obsolete: use CHSG]"@en ;
    skos:broader namedrockunit:SACA ;
    skos:definition "Gravel and sand and trace clay. Stratified superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CHSG"@en ;
    skos:prefLabel "Cheltenham Sand and Gravel"@en ;
.

