namedrockunit:LSBU
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMSTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Between (NS 2821 0082) and (NS 2272 0089), the strata are characterized by buff-white-grey, hard, flaggy sandstone, interbedded soft red-green sandstone with pedogenic carbonate nodules and pipes, and rarer red-green siltstone and mudstone with pedogenic carbonate nodules. Thick channelised sandstone and conglomerate a few metres thick and tens of metres wide are observed at several localities. In the northwestern part of the Lindsayston Burn section (NS 2272 0089) to (NS 2749 0097) the upper part of the member records a gradational change.  Medium- to coarse-grained sandstone interbedded with red-grey siltstone with pedogenic carbonate are common, but intercalations of grey calcareous siltstone and mudstone and thinly bedded fine-grained sandstone in packages up to about 0.7m thick are also observed."@en ;
    lexicon:hasLowerBoundaryDefinition "Mapped as a conformable contact on NS20SE in the type section at (NS 2824 0080) but not actually exposed. Defined as the lithological change from the yellow sandstone with grey silty mudstone of the underlying Drumwhirn Member to red-purple sandstone with conglomerate and pedogenic carbonate."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2922 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Approximately 200m at the type section with 134m proven by logging where exposed, interpreted to be laterally variable and up to 285m in other parts of NS20SE."@en ;
    lexicon:hasUpperBoundaryDefinition "Mapped as a conformable contact on NS20SE in the type section at (NS 2735 0112) but not actually exposed. Defined as the lithological change from red-purple sandstone with conglomerate and pedogenic carbonate to the grey-green mudstone with thin non-marine limestones and sandstone that is typical of the Ballagan Formation in the Midland Valley of Scotland."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Cornstone-bearing Beds [Obsolete: use LSBU]"@en ;
    skos:broader namedrockunit:BGN ;
    skos:definition "Sandstone and siltstone with subsidiary conglomerate, mudstone and nodular limestone (cornstone) and trace calcareous mudstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LSBU"@en ;
    skos:prefLabel "Lindsayston Burn Member"@en ;
.

namedrockunit:LSCL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """The Lower Shelly Clay consists almost entirely of a low-diversity fauna of fossil shells (of types indicating brackish water deposition) in dark grey, dark brown or black organic clay. The shell debris is concentrated into distinct beds or drifts (coquinas), which in some cases have been cemented to form limestones. The basal part is locally a shelly, clayey sand. \r
\r
The Lower Shelly Clay represents deposition in marginal marine lagoons. In the far west, this environment occurred during a very brief interval, but in the east of the London Basin lagoonal conditions persisted for longer, depositing the lower part of the Woolwich Formation. However, in the east the depositional conditions also varied in time and space, resulting in the different lithologies of the lower Woolwich Formation. \r
\r
Early Eocene (earliest Ypresian)."""@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Lower Shelly Clay is a sharply-defined contact on the Lower Mottled Clay or, passing eastwards, locally on the Shorne Member or on the Upnor Formation. In the London area, the basal Woolwich Formation rests on a burrowed omission surface at the top of a pedogenically-altered interval within the Lower Mottled Clay and, in places, the Upnor Formation. This omission surface corresponds to the mid-Lambeth Group Hiatus of Page and Skipper (2000)."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H5087 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasOldestAgeValue 5.6e+01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/U> ;
    lexicon:hasThicknessDescription "Up to 6 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The top of the Lower Shelly Clay is generally a sharply conformable boundary with the Laminated Beds, or locally in south London with the Upper Shelly Clay."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/GY> ;
    lexicon:hasYoungestAgeValue 4.81e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Woolwich Shell Bed(s) [Obsolete: use LSCL, UPSCL]"@en ;
    skos:broader namedrockunit:WL ;
    skos:definition "Shelly clay with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Ypresian Age (Palaeogene Period) (56-48.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LSCL"@en ;
    skos:prefLabel "Lower Shelly Clay (Woolwich Formation)"@en ;
.

