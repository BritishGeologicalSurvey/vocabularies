        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, much of it quartzitic, and calcareous psammite, with minor pelite and semipelite, passing up into mixed psammite and semipelite: beds of meta-limestone and calc-silicate rock throughout."@en ;
    lexicon:hasLowerBoundaryDefinition "Top of Deeside Limestone Formation - change from dominant calc-silicate rock to dominant psammite."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2499 ,
        namedrockunit:H3731 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "(i) Probably no more than 500m north of Mount Battock Granite (top not seen): (ii) 1250 - 2750m south of Mount Battock Granite; upper figure probably overestimate, due to tectonic thickening of Glen Turret Member."@en ;
    lexicon:hasUpperBoundaryDefinition "Base of Glen Effock Schist Formation - change to semipelite with much psammite and pelite: marked by incoming of magnetic horizons within the semipelites."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AZ> ;
    lexicon:hasYoungestAgeValue 5.41e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glen Tanar Quartzite and Mica Schist Group [Obsolete: use TPS]"@en ,
        "Tarfside Group [Obsolete: use TPS]"@en ;
    skos:broader namedrockunit:DBTV ;
    skos:definition "Psammite with subsidiary calcsilicate-rock, metalimestone, pelite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Neoproterozoic Era (Precambrian) (1000-541 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:GTP ,
        namedrockunit:GTQ ;
    skos:notation "TPS"@en ;
    skos:prefLabel "Tarfside Psammite Formation"@en ;
