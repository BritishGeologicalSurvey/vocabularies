namedrockunit:BYSA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A grey, weathering brown to yellow, quartzose, fine- to medium-grained Sand in the east, becoming coarser in the west, with calcareous sandstone beds and doggers, and thin, sandy, shelly bioclastic limestone beds. It is moderately fossiliferous, containing bivalves and ammonites."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary is gradational. East of Cumnor, there is an upward transition from the muddy and more finely sandy Temple Cowley Member or the spiculitic sandstone of the Arngrove Spiculite Member, into non-spiculitic sands and calcareous sandstone. West of Cumnor, there is a gradational change up from poorly fossiliferous fine-grained and sandy mudstone of the Hazelbury Bryan Formation, into medium- to coarse-grained sand and sandstone, with possibly some lateral passage."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:BOS ,
        namedrockunit:H101 ,
        namedrockunit:H2039 ,
        namedrockunit:H2656 ,
        namedrockunit:H2657 ,
        namedrockunit:LCR ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasOldestAgeValue 1.615e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 20 m thick, measured as 11.15 m thick in the Cumnor borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "East of Garford, Oxon, there is a sharp non-sequential boundary with fine- to medium-grained sand and sandstone, overlain by bioclastic limestones or grey calcareous mudstones of the Stanford Formation, commonly marked by a pebble bed. West of Garford, there is a change up from medium- to coarse-grained sand and sandstone into shelly ooidal limestone commonly with a basal pebble bed of the Highworth Limestone Member."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JO> ;
    lexicon:hasYoungestAgeValue 1.548e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Beckley Sands [Obsolete: use BYSA]"@en ,
        "Berkshire Oolite \"Series\" [Obsolete: use BYSA]"@en ,
        "Berkshire Oolite Series [Obsolete: use BYSA]"@en ,
        "Highworth Formation [Obsolete: use BYSA]"@en ,
        "Lower Calcareous Grit [Obsolete: use HYB, KTON, TECY, BYSA]"@en ,
        "Lower Corallian [Obsolete: use TECY, BYSA, KTON]"@en ;
    skos:broader namedrockunit:KTON ;
    skos:definition "Sand and sandstone with subsidiary limestone. Stratified bedrock. Occurs onshore. Deposited during the Oxfordian Age (Jurassic Period) (161.5-154.8 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BYSA"@en ;
    skos:prefLabel "Beckley Sand Member"@en ;
