namedrockunit:TTST
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLateralEquivalent namedrockunit:CASB ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CARN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHLK"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A distinctly harder unit in the Grey Chalk Subgroup (\"Lower Chalk\"). Typically brownish-grey, fine-grained calcarenite. Has been described as \"sandy\" because of coarse fossil fragments - not because of quartz sand grains. Thin to thickly bedded. Phosphatic in part with dark brown pellets a few mm across, up to nodules several cm across. Fossiliferous. Locally used as a building stone."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is commonly an indistinct conformable boundary with the underlying West Melbury Marly Chalk Formation (\"Lower Chalk\", \"Chalk Marl\" unit) but there may be an erosion surface with a concentration of phosphatic pebbles in the base of the Totternhoe Stone above. May be difficult to locate, even in sections."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4942 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasOldestAgeValue 1.005e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0.3 to 6.0m in the Hitchin district. Typically 1 to 2m thick but expanded sequences in synsedimentary channels may be up to 6m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "The top is commonly an indistinct conformable boundary with the overlying strata of the Zig Zag Chalk Formation (\"Lower Chalk\", \"Grey Chalk\" unit). Upward reversion to softer, finer-grained more typical chalk or marly chalk. May be difficult to locate, even in sections."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KE> ;
    lexicon:hasYoungestAgeValue 9.39e+01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Cast Bed"@en ,
        "Chilton Stone [Obsolete: use TTST]"@en ;
    skos:broader namedrockunit:ZZCH ;
    skos:definition "Calcarenite and chalk. Stratified bedrock. Occurs onshore. Deposited during the Cenomanian Age (Cretaceous Period) (100.5-93.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TTST"@en ;
    skos:prefLabel "Totternhoe Stone Member"@en ;
.

namedrockunit:TUFA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Tufa is a sedimentary rock composed of calcium carbonate or silica, formed by evaporation as a thin, surficial, soft, spongy, semifriable encrustation around the mouth of springs, seeps or along streams carrying calcium carbonate in solution, and exceptionally as a thick deposit along lake shores. Travertine is a hard, dense variety of tufa; it also occurs in caves as stalactites and stalagmites. Synonyms: sinter, travertine."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/LU> ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:CHEMD ;
    skos:definition "Tufa. Superficial deposits. Occurs onshore. Formed during the Quaternary Period (2.58-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CAT ,
        namedrockunit:SITU ;
    skos:notation "TUFA"@en ;
    skos:prefLabel "Tufa"@en ;
.

