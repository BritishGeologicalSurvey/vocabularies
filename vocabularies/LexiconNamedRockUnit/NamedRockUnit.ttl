namedrockunit:MLLA
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BCLAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PYRBRC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYCLAV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RYTUF"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRAND"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRLAV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRTUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Trachyte and rhyolite lavas with associated volcaniclastic rocks, including pyroclastic breccias and tuffs, minor amounts of trachyandesite and trachybasalt (capping Totterie Law [NS 293 621]) and one major basaltic intercalation."@en ;
    lexicon:hasLowerBoundaryDefinition "Along  western margin of the centre, the contact of the basal trachytes of the Misty Law Trachytic Member with the underlying Strathgryfe Lava Member is not exposed but appears to be conformable and to dip gently to the south-east."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2940 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Up to 300 m."@en ;
    lexicon:hasUpperBoundaryDefinition "The more steeply dipping upper boundary of the Misty Law Trachytic Member is believed to be overstepped by the overlying lavas of the Strathgryfe Lava Member but, where exposed, the contacts are generally faulted. Unfaulted junctions are seens only in the River Garnock [NS 293 593] and in the Rough Burn [NS 315 617] outside the faulted south-eastern margin of the main mass."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Misty Law Trachytic Centre [Obsolete: use MLLA]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Rhyolitic lava and trachytic lava with subsidiary basaltic lava, pyroclastic-breccia, rhyolitic tuff, trachyandesite, trachybasalt and trachytic tuff. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MLLA"@en ;
    skos:prefLabel "Misty Law Trachytic Member"@en ;
.

namedrockunit:MLLL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Two grey, weathering brown, sandy, shelly limestone or highly calcareous siltstone beds up to c.0.3 m thick, separated by up to 1 m of mudstone. Limestone/siltstone becoming nodular in south of range. Fauna includes gastropods, brachiopds, bivalves (including numerous pectiniids and common Gryphaea), ammonites, belemnites, ostracods and echinoderms. Forms a variably strong feature."@en ;
    lexicon:hasLowerBoundaryDefinition "Change up from grey mudstone with large limestone nodules of undifferentiated Foston Member; at 19.58 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)"@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2941 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasOldestAgeValue 1.995e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/B> ;
    lexicon:hasThicknessDescription "0 to 1.1 m; 1.07 m in type section."@en ;
    lexicon:hasUpperBoundaryDefinition "Change up into grey mudstone with thin impersistent limestone beds of undifferentiated Foston Member; at 18.51 m depth in type section Fulbeck Airfield Borehole F/B5 (SK95SW/17)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JS> ;
    lexicon:hasYoungestAgeValue 1.929e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Mill Lane Limestone [Obsolete: use MLLL]"@en ;
    skos:broader namedrockunit:FSTL ;
    skos:definition "Limestone, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Sinemurian Age (Jurassic Period) (199.5-192.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "MLLL"@en ;
    skos:prefLabel "Mill Lane Limestones Bed"@en ;
.

