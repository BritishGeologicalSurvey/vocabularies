namedrockunit:LYFS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SALMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Calcareous sandstones and sandy limestones (grainstones), locally cross-bedded and dolomitised. Records high energy, near shore bar deposition during the early stages of the Arundian transgression of North Wales, at a time when siliciclastic detritus was still actively being supplied to the developing carbonate ramp margin."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken as corresponding to the entry of calcareous sandstone 13m above the base of the Llanarmon Limestone Formation in the Alyn Valley Borehole.."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "20 to 30m"@en ;
    lexicon:hasUpperBoundaryDefinition "Entry of dark brown-grey, less sandy, crinoidal limestones (packstones) of the overlying part of the Llanarmon Limestone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasYoungestAgeValue 3.43e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:LNML ;
    skos:definition "Calcareous sandstone and sandy limestone with subsidiary dolomitic limestone. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage (Carboniferous Period) (344.5-343 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LYFS"@en ;
    skos:prefLabel "Llwyn-y-frân Sandstone Member"@en ;
.

