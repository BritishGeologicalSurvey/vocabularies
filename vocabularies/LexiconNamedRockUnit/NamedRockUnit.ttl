    lexicon:hasLithologyDescription """[Obsolete: use TPSF] \r
\r
Mudstone and siltstone, reddish brown, interbedded with buff-grey, fine- to medium-grained sandstone, micaceous, pebbly beds in lower half."""@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp; at transition from sandstone at top of Nottingham Castle Sandstone Formation to mudstone dominated lithologies; boundary marked locally by conglomerate up to 1m thick."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
