namedrockunit:NRV
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/O> ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Medium blue, silty mudstone. Homogenous or finely laminated (0.5-1cm)."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower boundary can be examined at Aberllefenni Quarry, where the contact is transitional, over 0.5m, from the pale-blue of the Broad Vein Mudstone Formation to a medium-blue, laminated silty mudstone of the Narrow Vein Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1731 ,
        namedrockunit:H4226 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/OW> ;
