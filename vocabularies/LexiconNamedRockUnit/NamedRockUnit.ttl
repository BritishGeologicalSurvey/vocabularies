namedrockunit:GSDT
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, grey, very fine- to fine-grained, muddy coarsening upwards to silty, with interbeds of muddy siltstone, all micaceous, and subordinate thin beds of silty mudstone. Sandstone and siltstone beds include sideritic concretions and lenses that weather reddish, mudstone beds in the basal part include small phosphate nodules. Bioturbated throughout with paler burrow fills, 'nests' of shells, especially bivalves, and common belemnites."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational; rapid upward transition from dark grey mudstone of the Whitby Mudstone Formation to paler burrow-mottled silt and sand-rich sediment."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H296 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasOldestAgeValue 1.842e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "7.8 to 9.0m"@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp change up from grey-weathering sandstone to yellow-weathering sandstone of Yellow Sandstone Member (Blea Wyke Sandstone Formation) which corresponds with the base of a well-defined upward-coarsening cycle."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JT> ;
    lexicon:hasYoungestAgeValue 1.747e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Grey Sands [Obsolete: use GSDT]"@en ;
    skos:broader namedrockunit:BW ;
    skos:definition "Sandstone and siltstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Toarcian Age (Jurassic Period) (184.2-174.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "GSDT"@en ;
    skos:prefLabel "Grey Sandstone Member"@en ;
.

