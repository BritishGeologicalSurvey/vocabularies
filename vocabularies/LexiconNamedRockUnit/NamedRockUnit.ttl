namedrockunit:BUB
    a skos:Concept ;
    lexicon:hasLateralEquivalent
        namedrockunit:S26 ,
        namedrockunit:S496 ,
        namedrockunit:S625 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SH"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sands and gravels. The sands are fine-grained and quartzose, with beds of comminuted shell. The gravels, which are composed of Chalk flint, quartz, sandstone, cherts, rounded lumps of red, green and grey Triassic mudstones and Liassic fossils, are marine in origin with a few interbedded palaeosols and freshwater sands. They contain fossilised marine, fresh water and terrestrial shells and remains of elephant, rhinoceras, horse, auroch, red, fallow and roe deer, hyaena and wolf. The marine shells indicate both cold and warm water climates and sandy, muddy and rocky habitat, and the freshwater shell Corbicula fluminalis indicates a climate warmer than now. The deposits form low mounds protruding through the surface of the Holocene silts and clays of the Somerset Levels Formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The formation rests upon Jurassic and Triassic bedrock. It commonly overlies or fringes \"reefs\" or \"islands\" of Lower Lias or Late Triassic rocks."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1403 ,
        namedrockunit:H4505 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasOldestAgeValue 7.8e-01 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.5m"@en ;
    lexicon:hasUpperBoundaryDefinition "At surface, or else overlain by Holocene silts, clays and peats of the Somerset Levels Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPL> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Burtle Beds [Obsolete: use BUB]"@en ,
        "Burtle Sands Beds [Obsolete: use BUB]"@en ,
        "Greylake Member"@en ,
        "Kenn Church Member"@en ,
        "Middlezoy Member"@en ;
    skos:broader namedrockunit:COAS ;
    skos:definition "Gravel and sand and trace shelly sand. Stratified superficial deposits. Occurs onshore. Formed during the Mid Pleistocene - to - Late Pleistocene (Quaternary Period) (.78-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "BUB"@en ;
    skos:prefLabel "Burtle Formation"@en ;
.

namedrockunit:BUG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
