namedrockunit:STHSG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Member consists of beds of matrix-supported gravel separated by thick beds of horizontally bedded sand. Up to 92% of the clast content is flint, with a small (c.6%) subsidiary quartzose content."@en ;
    lexicon:hasLowerBoundaryDefinition "The Stow Hill Sand and Gravel Member rests unconformably on the upper surface of the Bacton Green Till Member between Bacton Green [TG338345] and Mundesley [TG319361], and on the Weybourne Town Till Member within large, tectonically-controlled synclines between Trimingham [TG279389] and Sidestrand [TG265397]."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The maximum observed thickness of the deposit is 8m, in the Trimingham area."@en ;
    lexicon:hasUpperBoundaryDefinition "The sand and gravel deposit is truncated by the ground surface which forms its upper boundary."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QP> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BRLA ;
    skos:definition "Gravel with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Pleistocene Epoch (Quaternary Period) (2.58-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "STHSG"@en ;
    skos:prefLabel "Stow Hill Sand And Gravel Member"@en ;
.

