namedrockunit:BWL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to off-white or yellowish limestones with thin marls and mudstones, fossiliferous, bioturbated peloidal, ooidal and shell-fragmental more-or-less argillaceous packstones and wackestones, subordinate cross-bedded ooidal shell-fragmental grainstones: fauna may include rhynchonellids particularly in the lower part in the south (see the Roade Member), and may be dominated by oysters, notably in the upper part in the north (see the Longthorpe Member)."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the limestones overlying mudstones of the Rutland Formation."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:GLF ,
        namedrockunit:GOL ,
        namedrockunit:SNL ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Typically from 6 m to 7m thick in the type area, up to about 12m to the south-west, and 4m thick at Ketton."@en ;
    lexicon:hasUpperBoundaryDefinition "Generally a sharp boundary of the limestones with mudstone, or locally an erosive contact with cross-bedded shell-fragmental ooidal limestone, both of the Blisworth Clay Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Glentham Formation [Obsolete: use BWL, BWC, RLD]"@en ,
        "Great Oolite Limestone [Obsolete: use BWL, CFDO, GOG, IRCH, WHL]"@en ,
        "Snitterby Limestone Formation [Obsolete: use BWL]"@en ;
    skos:broader namedrockunit:GOG ;
    skos:definition "Limestone with subsidiary calcareous mudstone and mudstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:ARDY ,
        namedrockunit:IRCH ,
        namedrockunit:LONG ,
        namedrockunit:ROAD ;
    skos:notation "BWL"@en ;
    skos:prefLabel "Blisworth Limestone Formation"@en ;
