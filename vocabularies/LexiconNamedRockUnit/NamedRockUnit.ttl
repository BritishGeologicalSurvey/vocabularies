namedrockunit:KLPS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PELMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMMI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SPELGN"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pink-grey feldspathic and micaceous psammite, gneissose, locally migmatitic. Medium-coarse grained. Layers of garnet-biotite-muscovite pelite, gneissose to migmatitic. No sedimentary structures preserved."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable upon Lewisian Gneiss inlier (L); unconformity highly sheared. In many places, base is cut and deformed by the Naver thrust."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:DMCB ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
