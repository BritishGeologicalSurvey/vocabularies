namedrockunit:LLOB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/K> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDSST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MIMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAMDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale blue grey mudstone with brown nodules (Bed 7) passing up into thin dark blue micaceous mudstone with yellow sand lenses (Bed 8), into brown sandy mudstone (Bed 9), dark blue micaceous mudstone with yellow sandy lenses (Bed 10), laminated and sporadically glauconitic brown sandy mudstone (Bed 11) and dark blue argillaceous sandstone (Bed 12)."@en ;
    lexicon:hasLowerBoundaryDefinition "The conformable boundary is placed (Simpson, 1985) at the base of his Bed 7, and is identified by the upward change from pale grey, poorly-laminated mudstone of the Chale Clay Member into pale blue grey mudstone with small brown nodules of the Lower Lobster Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H367 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasOldestAgeValue 1.214e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "11.6m at the type site."@en ;
    lexicon:hasUpperBoundaryDefinition "Boundary placed at the upward conformable change from dark blue argillaceous sandstone of Simpson (1985) Bed 12 (top Lower Lobster Member) into the compact dark blue sandstone of Simpson (1985) Bed 13 (The Crackers Member). This boundary is gradational."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/KP> ;
    lexicon:hasYoungestAgeValue 1.132e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Lower Lobster Bed [Obsolete: use LLOB]"@en ;
    skos:broader namedrockunit:AC ;
    skos:definition "Mudstone with subsidiary micaceous mudstone, muddy sandstone and sandy mudstone. Stratified bedrock. Occurs onshore. Deposited during the Aptian Age (Cretaceous Period) (121.4-113.2 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LLOB"@en ;
    skos:prefLabel "Lower Lobster Member"@en ;
