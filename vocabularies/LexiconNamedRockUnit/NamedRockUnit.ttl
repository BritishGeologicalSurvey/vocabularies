namedrockunit:ERRCL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:S885 ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Massive to thinly bedded and coarsely laminated calcareous, silty and sandy clay interbedded with sand, commonly forming a fining-upwards sequence. Generally reddish brown, but locally brownish and yellowish grey or pale to dark grey. Streaks and mottling of dark grey to black sulphide are common and calcareous concretions occur towards the base locally. Contains a sparse glaciomarine fauna."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable, draped contact with underlying glaciofluvial sand and gravel or till."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H892 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
