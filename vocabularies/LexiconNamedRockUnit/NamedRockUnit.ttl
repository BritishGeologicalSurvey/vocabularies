namedrockunit:KILD
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/A> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSAMM"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSMQZ"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QZITE"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SEMPEL"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Psammite, siliceous to micaceous, medium-grained. Psammite shows locally tabular and trough cross-bedding. Subordinate layers of quartz and schistose semipelite. Locally very thin (<5 cm) schistose para-amphibolite."@en ;
    lexicon:hasLowerBoundaryDefinition "Not exposed. Base is interpreted to be cut by the Skinsdale Thrust."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2874 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasOldestAgeValue 1e+03 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasUpperBoundaryDefinition "Conformable overlain by the Suisgill Semipelite Formation (SUIS), with a gradational (100 m) boundary marked by increasing semipelitic layers. Locally overlain by the Scaraben Quartzite Formation (SCAB), but not exposed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/AT> ;
    lexicon:hasYoungestAgeValue 7.2e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kildonan Psammite [Obsolete: use KILD]"@en ;
    skos:broader namedrockunit:LEIL ;
    skos:definition "Psammite with subsidiary quartzite, quartzose psammite and semipelite. Stratified bedrock. Occurs onshore. Deposited during the Tonian Period (Precambrian) (1000-720 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KILD"@en ;
    skos:prefLabel "Kildonan Psammite Formation"@en ;
.

namedrockunit:KILDN
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/J> ;
    lexicon:hasLateralEquivalent namedrockunit:KIDO ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Dominated by silty fissile mudstones intercalated with shell beds, shelly limestones, bone beds and one sandstone bed (Emeleus, 1997, appendix 1). The biota comprises bivalves, conchostracans, gastropods and plants (ferns), shark teeth and plesiosaur bones. There is a prominent bed of stromatolitic algal limestone, 0.20 m thick, with gypsum pseudomorphs at the top of the member recognisable throughout the Hebrides Basin."@en ;
    lexicon:hasLowerBoundaryDefinition "As for parent formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Lonfearn Member (LONFN)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasYoungestAgeValue 1.653e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kildonnan Member [Duplicate: use KILDN]"@en ;
    skos:broader namedrockunit:LASH ;
    skos:definition "Siltstone and silty mudstone with subsidiary limestone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age (Jurassic Period) (168.2-165.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KILDN"@en ;
    skos:prefLabel "Kildonnan Member"@en ;
.

namedrockunit:KILK
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Mains of Kilmaronock Borehole (Browne and McMillan, 1989, Figure 6) contains the standard (and only) section in the Kilmaronock Silt Member (13.6-19.95m in depth). The typical lithology is a very thinly bedded lacustrine silt with many clayey silt and silty clay layers. Sand layers are also common. The deposits are brown, dark brown, browish grey and grey, with plant remains and locally with dark organic-rich bands. Grains and flecks of vivianite are present throughout. The deposit is of a firm and locally stiff consistency and medium to low plasticity."@en ;
    lexicon:hasLowerBoundaryDefinition "The Kilmaronock Silt Member of the Strathendrick Formation rests by transitional passage on the underlying Buchanan Clay Member (Clydebank Clay Formation) or with angular unconformity on other, older, Quaternary sediments or bedrock."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2265 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasOldestAgeValue 1.18e-02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Veneer to over 6 metres."@en ;
    lexicon:hasUpperBoundaryDefinition "The Kilmaronoch Silt Member is only known to be overlain conformably by the Endrick Sand Member forming the lower part of an upwards coarsening unit."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QH> ;
    lexicon:hasYoungestAgeValue 0e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Kilmaronock Formation [Obsolete: use KILK]"@en ;
    skos:broader namedrockunit:SRCK ;
    skos:definition "Clay and silt with subsidiary sand. Stratified superficial deposits. Occurs onshore. Formed during the Holocene Epoch (Quaternary Period) (.0118-0 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "KILK"@en ;
    skos:prefLabel "Kilmaronock Silt Member"@en ;
.

