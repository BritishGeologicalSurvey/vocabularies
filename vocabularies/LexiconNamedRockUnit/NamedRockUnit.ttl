        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Stoney clayey sand diamicton, matrix-supported, moderate brown to yellowish brown, extremely compact, containing clasts of Devonian sandstone and siltstone, with some psammite, granite and schist. Many clasts are weathered, with orange weathering rinds. Mainly massive lodgement till, but contains lenses of stratified gravelly sandy diamicton and bedded sandy gravel. Locally includes a bed of glacitectonite at the base (Allt Odhar site)."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp, undulating or planar, glacitectonic, unconformable contact with white, sandy, organic deposits of the Dalcharn Palaeosol Formation, compressed peat of the Allt Odhar Peat Formation, or bedrock."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H1318 ,
        namedrockunit:H3181 ,
        namedrockunit:H658 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Either a gradational contact with dark yellowish brown to olive grey stony sandy clay diamicton of the overlying Beinn an Uain Till Formation or a sharp, glacitectonic, boundary with some wedge structures filled by that till."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Dalcharn Lower Till Formation [Obsolete: use ATTI]"@en ,
        "Moy Lower Till Member [Obsolete: use ATTI]"@en ,
        "Moy Paraglacial Complex Member [Obsolete: use ATTI]"@en ;
    skos:broader namedrockunit:INVG ;
    skos:definition "Diamicton and gravel with subsidiary sand and trace clay and silt. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ATTI"@en ;
    skos:prefLabel "Athais Till Formation"@en ;
.

namedrockunit:AUF
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:MWH ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Parallel bedded turbiditic sandstones separated by laminated siltstone. Laminated argillaceous siltstone up to 80m thick at base contain an abundant graptolite fauna indicative of the Sheinwoodian Stage of the Wenlock."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the base of carbonaceous siltstones that are overlain by turbiditic sandstones.  Oversteps Crummack Formation and Ashgill strata to overlie the Ingleton Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:AFG ,
        namedrockunit:MWH ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/SS> ;
