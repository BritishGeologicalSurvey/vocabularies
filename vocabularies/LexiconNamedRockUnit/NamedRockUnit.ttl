namedrockunit:YDTI
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DMTN"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Generally dark grey to greyish brown, extremely compact, stony sandy silty clay diamicton with clasts dominated by, or exclusively, local Carboniferous lithologies (limestone, sandstone, granule-conglomerate and mudstone). Mostly mudstone and limestone at Partial Type Section. Some clasts of wacke sandstone and siltstone from the Howgill Fells occur in tills in upper Wensleydale."@en ;
    lexicon:hasLowerBoundaryDefinition "Generally a sharp uneven contact on bedrock, but locally a complex gradational glaciotectonic contact with fractured or decomposed bedrock."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasOldestAgeValue 1.16e-01 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Generally less than 10m"@en ;
    lexicon:hasUpperBoundaryDefinition "Generally the ground surface or overlain unconformably by glaciofluvial sand and gravel or younger Superficial deposits."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QD> ;
    lexicon:hasYoungestAgeValue 1.18e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:NPEG ;
    skos:definition "Diamicton with subsidiary gravel and trace sand. Stratified superficial deposits. Occurs onshore. Formed during the Devensian Stage (Quaternary Period) (.116-.0118 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "YDTI"@en ;
    skos:prefLabel "Yorkshire Dales Till Formation"@en ;
.

namedrockunit:YEL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Reddish brown silty and sandy mudstone; clayey sandy siltstone; and silty clayey fine-grained sandstone. Laterally equivalent to the Crediton Breccia."@en ;
    lexicon:hasLowerBoundaryDefinition "Rests on Thorverton Sandstone, probably unconformably, around Dunsmore (SS 957 015). Basalt at the top of the Thorverton Sandstone is directly overlain by basal Yellowford Formation clay. East of Poundsland (SS 961 013) change from Thorverton Sandstone to Yellowford Formation less clear, due to greater proportion of sand in the Yellowford Formation. "@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasOldestAgeValue 2.989e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "To 150m. Lower 75m penetrated in Yellowford Farm Borehole (SS9255 0089)."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by Shute Sandstone; gradational boundary."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/P> ;
    lexicon:hasYoungestAgeValue 2.519e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:EXE ;
    skos:definition "Mudstone, sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Permian Period (298.9-251.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "YEL"@en ;
    skos:prefLabel "Yellowford Formation"@en ;
.

