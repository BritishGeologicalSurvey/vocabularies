namedrockunit:LWHIN
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:WHSI ;
    lexicon:hasLithology "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "A  very fine to fine-grained porphyritic dolerite, with finer grained 'chilled' contact rock. Sills are typically columnar jointed, and emplaced into the Three Yard Limestone. The literature on this sill is listed, referred to and discussed in Stephenson et al., 2003."@en ;
    lexicon:hasLowerBoundaryDefinition "Taken at the sharp intrusive contact of the sill, where it is in contact with sedimentary strata below."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CMIL> ;
    lexicon:hasOldestAgeValue 3.303e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/SI> ;
    lexicon:hasThicknessDescription "Up to 13 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the sharp intrusive contact with the strata overlying the sill."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/PLC> ;
    lexicon:hasYoungestAgeValue 2.744e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Whin Sill [Obsolete: use GWHIN, WHINS]"@en ;
    skos:broader namedrockunit:WHINS ;
    skos:definition "Dolerite. Igneous intrusive bedrock. Occurs onshore. Emplaced during the Late Mississippian Epoch (Carboniferous Period) - to - Cisuralian Epoch (Permian Period) (330.3-274.4 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "LWHIN"@en ;
    skos:prefLabel "Little Whin Sill"@en ;
.

