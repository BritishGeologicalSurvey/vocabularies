namedrockunit:YNYSS
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/Q> ;
    lexicon:hasLateralEquivalent namedrockunit:KNFIG ;
