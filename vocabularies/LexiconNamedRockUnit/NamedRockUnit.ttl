namedrockunit:CBB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLR"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In the Haddon Fields Borehole the member comprises three flows of compact and amygdaloidal basalt.  At Conksbury Bridge the member includes two flows: the upper flow includes a vesicular basalt at the top and base and a central non-vesicular dolerite; the lower flow has a highly vesicular and slightly haematised upper margin, which grades down into a non-vesicular dolerite (Walters, et al., 1981)."@en ;
    lexicon:hasLowerBoundaryDefinition "In the Haddon Fields Borehole basalt of the Conksbury Bridge Lava Member is underlain by pale grey and cherty limestones with some calcilutites, included within the Fallgate Volcanic Formation"@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H112 ,
        namedrockunit:H2055 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "The thickest development is 51.71m, proved in the Haddon Fields Borehole."@en ;
    lexicon:hasUpperBoundaryDefinition "At Conksbury Bridge, limestone of the Monsal Dale Limestone Formation rests upon a vesicular upper margin of a 5m thick lava flow of the Conksbury Bridge Lava Member (Walters and Ineson., 1981)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Conksbury Bridge Basalt [Obsolete: use CBB]"@en ,
        "Conksbury Bridge Lava [Obsolete: use CBB]"@en ;
    skos:broader namedrockunit:FV ;
    skos:definition "Basalt and dolerite. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "CBB"@en ;
    skos:prefLabel "Conksbury Bridge Lava Member"@en ;
