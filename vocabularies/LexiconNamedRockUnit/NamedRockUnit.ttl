namedrockunit:ELD
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BREC"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Pale grey to buff, flaggy, laminated dolostones with intraformational breccias and minor chert development towards base and top of unit. Stromatolites particularly abundant in Durness area."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformably overlies dark grey dolostones of the Ghrudaidh Formation. A zone of interbedded dark and pale grey dolostones occurs at the boundary. The base of the Eilean Dubh Formation is taken at the appearance of laminations and/or chert layers."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H2781 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/ED> ;
    lexicon:hasOldestAgeValue 5.08e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "About 150 m thick."@en ;
    lexicon:hasUpperBoundaryDefinition "Conformably overlain by dark dolostones and white chert of the Sailmhor Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/O1> ;
    lexicon:hasYoungestAgeValue 4.771e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Eilean Dubh Group [Obsolete: use ELD]"@en ;
    skos:broader namedrockunit:DNG ;
    skos:definition "Dolomitic limestone and dolostone with subsidiary breccia, chert and limestone. Stratified bedrock. Occurs onshore. Deposited during the St David's Series (Cambrian Period) - to - Tremadoc Series (Ordovician Period) (508-477.1 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELD"@en ;
    skos:prefLabel "Eilean Dubh Formation"@en ;
.

namedrockunit:ELLA
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUF"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The East Linton Lava Member consists characteristically of macroporphyritic ankaramites (Craiglockhart type) and basaltic hawaiites (Dunsapie type), both with olivine and clinopyroxene (large augite) phenocrysts and the latter, also plagioclase. Non-porphytic trachybasalts of mugearite type and one of leucite-bearing kulaite are also present. Beds of tuff and lapilli tuff also occur in the succession. Flows are usually 5 to 15m thick, the upper half being slaggy and vesicular."@en ;
    lexicon:hasLowerBoundaryDefinition "The base is conformable or locally unconformable on the North Berwick Pyroclastic Member. The change is from basaltic pyroclastic rocks to mafic lava flows."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1525 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasOldestAgeValue 3.467e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "0 to 90m"@en ;
    lexicon:hasUpperBoundaryDefinition "The Member is overlain by the Hailes Lava Member. The contact is conformable and locally unconformable. The change is from either ankaramite and basaltic hawaiites to olivine-basalt and mugearite."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CV> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "East Linton Member [Obsolete: use ELLA]"@en ;
    skos:broader namedrockunit:GHV ;
    skos:definition "Subsidiary mugearite and tuff. Stratified bedrock. Occurs onshore. Deposited during the Visean Age (Carboniferous Period) (346.7-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELLA"@en ;
    skos:prefLabel "East Linton Lava Member"@en ;
.

namedrockunit:ELM
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/HALI"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription """[Obsolete: use SIM] \r
\r
Mainly structureless red-brown silty mudstones and siltstones in the upper part (c.130m); lower part comprises alternating structureless and laminated beds with common green beds. Thin sandstones common in basal 20m. Includes Droitwich Halite Member."""@en ;
    lexicon:hasLowerBoundaryDefinition "As for base of the Mercia Mudstone Group, where mudstone and siltstone become dominant over sandstone in transition with underlying Sherwood Sandstone Group."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H4022 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TA> ;
    lexicon:hasOldestAgeValue 2.467e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c.366m in Eldersfield Borehole; c.410m in Kempsey Borehole; 120-130m in eastern Warwickshire."@en ;
    lexicon:hasUpperBoundaryDefinition "Sharp or transitional junction from red mudstone to green beds of the overlying Arden Sandstone Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasYoungestAgeValue 2.273e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:SIM ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel
        "Eldersfield Formation [Obsolete: use ELM]"@en ,
        "Sidmouth Mudstone Formation"@en ;
    skos:definition "Obsolete name. Mudstone, siltstone and silty mudstone with subsidiary halite and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Anisian Age - to - Carnian Age (Triassic Period) (246.7-227.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELM"@en ;
    skos:prefLabel "Eldersfield Mudstone Formation [Obsolete: use SIM]"@en ;
.

namedrockunit:ELMU
    a skos:Concept ;
    lexicon:hasLateralEquivalent namedrockunit:BCMU ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANHY"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "In 110/13-8, and by analogy with the Brooks Mill Mudstone Formation of the Cheshire Basin, the Elswick Mudstone Formation consists dominantly of structureless chocolate-coloured mudstone overlying red mudstone with lesser green-grey intervals (Wilson, 1993; Poole and Whiteman, 1966). The proportion of anhydrite, as irregular nodules, porphyroblasts and a significant bedded deposit (6.4 m thick in the Wilkesley Borehole), is the highest within the Mercia Mudstone Group. Very thin interbedded siltstone and sandstone occur sporadically."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the Elswick Mudstone Formation is taken at the downward change from red mudstones to clean halite of the Warton Halite Formation (110/13-8). The contact in this well is probably a 'wet' rockhead on stratigraphically low halites within the Warton Halite Formation; however such contacts are expected to be the norm offshore. On wireline logs the contact is marked by a sharp downward decrease in gamma values (Penn, 1987; Wilkesley Borehole, Evans et al., 1993), and a smaller downward shift to higher velocities. The wireline log responses for 110/13-8 are affected by thick casing and are not truly representative."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TC> ;
    lexicon:hasOldestAgeValue 2.37e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "The Elswick Mudstone Formation is likely to thicken towards the Keys Basin depocentre, where the full thickness of Mercia Mudstone Group (3025 m) is preserved. Estimates of thickness from seismic data indicate a possible maximum of 800 m there, thinning to an estimated minimum of 200 m adjacent to the Llyn-Rossendale Ridge in the south-east; the formation (believed to be collapse strata above a 'wet' rockhead) exceeds 69.5 m in 110/13-8, which provides the only available section. It is likely that the upper part of the collapse strata comprises Quaternary deposits, since these have not been identified in all wells, and the till is likely to be argillaceous and lithologically similar to the mudstones of the Mercia Mudstone Group."@en ;
    lexicon:hasUpperBoundaryDefinition "By analogy with the Cheshire Basin, the top of the Elswick Mudstone Formation is placed at the downward change from the pale green and pale grey mudstones and dolomitic siltstones of the Blue Anchor Formation to the red mudstones of the Elswick Mudstone Formation. On wireline logs, the boundary is marked by a small but noticeable downward increase in gamma values (Penn, 1987)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/TN> ;
    lexicon:hasYoungestAgeValue 2.057e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Branscombe Mudstone Formation"@en ;
    skos:broader namedrockunit:MMG ;
    skos:definition "Mudstone with subsidiary anhydrite-stone. Stratified bedrock. Occurs offshore. Deposited during the Carnian Age - to - Norian Age (Triassic Period) (237-205.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "ELMU"@en ;
    skos:prefLabel "Elswick Mudstone Formation"@en ;
.

