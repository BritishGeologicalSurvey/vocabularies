namedrockunit:SEG
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CONG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded sandstone and siltstone. These interfinger with clast-supported conglomerate containing well-rounded boulders, cobbles and pebbles predominantly of psammite, quartzite and lava in areas adjacent to the Highland Boundary Fault. Siltstone and mudstone are interbedded with the sandstone, particularly in Strathallan."@en ;
    lexicon:hasLowerBoundaryDefinition "At base of bright red, massive, poorly-sorted siltstone and silty sandstone of Cromlix Formation and its correlatives, where this overlies coarser-grained sandstone or conglomerate of Arbuthnott-Garvock Group. Locally diachronous in areas adjacent to Highland Boundary Fault where conglomerate and sandstone interfingers with Cromlix Mudstone Formation."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1811 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasOldestAgeValue 4.105e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/G> ;
    lexicon:hasThicknessDescription "1800-2400m over much of the outcrop."@en ;
    lexicon:hasUpperBoundaryDefinition "Not seen. Base of Upper Devonian succession in the northern Midland Valley is unconformable."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DE> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Strathmore Beds [Obsolete: use SEG]"@en ;
    skos:broader namedrockunit:ORS ;
    skos:definition "Sandstone with subsidiary conglomerate, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Emsian Age (Devonian Period) (410.5-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:CXF ,
        namedrockunit:GYF ,
        namedrockunit:SXS ,
        namedrockunit:THF ;
    skos:notation "SEG"@en ;
    skos:prefLabel "Strathmore Group"@en ;
.

