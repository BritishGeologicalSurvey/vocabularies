namedrockunit:PLB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "[Obsolete: use PNYF] The Plateau Beds Formation unconformably overlies the Brownstones Formation. A slight angular discordance between the formations is present on Bannau Sir Gaer and Fan Brycheiniog (Allen, 1964; Lovell, 1975). Descriptions were given by Hall et al. (1973) and Taylor and Thomas (1975). The formation comprises red-brown and purple quartzitic sandstones, locally pebbly and conglomeratic, and interbeds of red-brown mudstone. The sandstones are generally harder than the Brownstones, and form resistant cappings to the Brecon Beacons."@en ;
    lexicon:hasLowerBoundaryDefinition "Sharp junction where the formation unconformably overlies the softer drab red sandstones of the Brownstones Formation, a slight angular discordance between the formations being visible locally, as on Bannau Sir Gaer and Fan Brycheiniog. A quartz granule bed marks the base of the formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Up to 36 m."@en ;
    lexicon:hasUpperBoundaryDefinition "At sharp junction where the red sandstones of the formation are overlain by the grey and grey-green sandstones of the Grey Grits Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    lexicon:isObsoleteEquivalentOf namedrockunit:PNYF ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:altLabel "Pen y Fan Formation"@en ;
    skos:definition "Obsolete name. Sandstone with subsidiary mudstone. Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age - to - Famennian Age (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
