namedrockunit:TIL
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CAMDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DOLO"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Buff to pale grey, fine- to medium-grained massive to thinly bedded dolostone and limestones, with shaly mudstone interbeds, common palaeosols and karstic surfaces with green clayey drapes, and bioclastic grainstones and calcaeous mudstones where undolomitised. Some sandy dolostones and dolomitic sandstones are present at the base of the formation."@en ;
    lexicon:hasLowerBoundaryDefinition "The lower unconformable boundary is taken at the base of the lowest palaeosol, recognised by 1- 2 m of heterogeneous, friable siltstone and sandstone with carbonate nodules, above fine- to coarse-grained dolostones containing shaly mudstone partings, of the Cloud Hill Dolostone Formation."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasOldestAgeValue 3.309e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be 60 m thick in the type area, and possibly up to 90 m between the Worthington Borehole and Cloud Hill Quarry."@en ;
    lexicon:hasUpperBoundaryDefinition "The highest bed of limestone or dolostone in the Peak Limestone Group, is overlain rapidly by grey mudstone, siltstone or sandstone of the Millstone Grit Group or red-bed Permo-Triassic breccia of the Moira Formation."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CX> ;
    lexicon:hasYoungestAgeValue 3.303e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:PKLM ;
    skos:definition "Dolostone and limestone with subsidiary calcareous mudstone and mudstone and trace sandstone. Stratified bedrock. Occurs onshore. Deposited during the Brigantian Substage (Carboniferous Period) (330.9-330.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "TIL"@en ;
    skos:prefLabel "Ticknall Limestone Formation"@en ;
.

