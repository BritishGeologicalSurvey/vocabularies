namedrockunit:AUC
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/D> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANDLAV"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCCNG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCSST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Yellow to red-brown, medium- and coarse-grained, poorly-sorted volcaniclastic sandstones with pebble beds and substantial interbeds of andesitic lava pebble conglomerates, and thin fine-grained sandstone, siltstone, mudstone and andesitic and basaltic lava beds."@en ;
    lexicon:hasLowerBoundaryDefinition "The base of the substantial thickness in excess of 30m of volcanogenic sandstones and conglomerates above the andesitic volcanic pile of the Duneaton Volcanic Formation seen in Duneaton Water in the New Cumnock area, and above the Biggar Formation in the Biggar area."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H659 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasOldestAgeValue 4.19e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "Estimated to be up to at least 1800 m thick along the Duneaton Water, where the youngest beds lie in the core of a syncline."@en ;
    lexicon:hasUpperBoundaryDefinition "The unconformity with the overlying Upper Devonian-Carboniferous strata, exposed in the burn north of Clocklowie Hill at NS 696 179, below a cornstone bed."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DL> ;
    lexicon:hasYoungestAgeValue 3.943e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Auchtitench Formation [Obsolete: use AUC]"@en ;
    skos:broader namedrockunit:LNK ;
    skos:definition "Sandstone and volcaniclastic-sandstone with subsidiary andesite lava, basalt, mudstone, siltstone and volcaniclastic-conglomerate. Stratified bedrock. Occurs onshore. Deposited during the Early Devonian Epoch (Devonian Period) (419-394.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower
        namedrockunit:DGHC ,
        namedrockunit:LABN ,
        namedrockunit:WGVS ;
    skos:notation "AUC"@en ;
