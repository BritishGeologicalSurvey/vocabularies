namedrockunit:WRG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LAVA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Channel sandstone: Thickly bedded massive sandstone beds with rare interbeds of mudstone and siltstone. Non-channel sandstone: Fine- to coarse-grained sandstone in parallel beds up to 1m thick with interbeds of interlaminated siltstone and mudstone. Mudstone with sandstone streaks, lenses, thin to thick laminae and thin beds. Associated basaltic lava and hyaloclastite form an important but subordinate facies of this division."@en ;
    lexicon:hasLowerBoundaryDefinition "Conformable transition with the slate and mudstone of the undivided Saltash Formation below."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H619 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DR> ;
    lexicon:hasOldestAgeValue 3.789e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "c.25m"@en ;
    lexicon:hasUpperBoundaryDefinition "Conformable transition with the slate and mudstone of the undivided Saltash Formation above"@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/DA> ;
    lexicon:hasYoungestAgeValue 3.593e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Wearde-Efford Grit [Obsolete: use WRG]"@en ;
    skos:broader namedrockunit:SAH ;
    skos:definition "Sandstone with subsidiary lava, mudstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Frasnian Age - to - Famennian Age (Devonian Period) (378.9-359.3 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "WRG"@en ;
    skos:prefLabel "Wearde Sandstone Member"@en ;
.

