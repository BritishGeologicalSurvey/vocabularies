namedrockunit:ISAG
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/C"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/P"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/S"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/V"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/Z"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Formation encompasses fluvial, lacustrine and organic deposits of the pre-Glacial Bytham River. Deposits of four separate terrace levels are recognized as members of the formation. Commonly a basal fine to coarse-grained sandy gravel is overlain by fine- to coarse-grained pebbly sands, with few clay and silt beds. The gravels contain a high proportion (up to 54%) of rounded pebbles of grey and purple \"Bunter\" quartzite of Triassic derivation, up to 47% vein quartz, and up to 56% flint derived from the local Chalk. There are traces of chalk and of igneous and metamorphic rocks. Sedimentary structures indicate deposition by braided rivers. The formation can be distinguished from formations of the Kesgrave Subgroup by the high ratio of quartzite to vein quartz in the gravels."@en ;
    lexicon:hasLowerBoundaryDefinition "Unconformable on bedrock of the Chalk Group and Crag Group."@en ;
    lexicon:hasObsoleteEquivalent
        namedrockunit:H2868 ,
        namedrockunit:S174 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPE> ;
    lexicon:hasOldestAgeValue 2.58e+00 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "c. 13.2 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Commonly overlain by Mid Pleistocene glacigenic deposits. Upper boundary may be difficult to determine where overlain by glaciofluvial sand and gravel, but the presence of more angular clasts, chalk, and poorer sorting in the latter is usually helpful."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/QPM> ;
    lexicon:hasYoungestAgeValue 1.26e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel
        "Bytham Sands and Gravels [Obsolete: use ISAG]"@en ,
        "Ingham Sands and Gravels [Obsolete: use ISAG]"@en ;
    skos:broader namedrockunit:BYCA ;
    skos:definition "Gravel and sand with subsidiary clay and silt and trace peat. Stratified superficial deposits. Occurs onshore. Formed during the Early Pleistocene - to - Mid Pleistocene (Quaternary Period) (2.58-.126 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:narrower namedrockunit:TIMW ;
    skos:notation "ISAG"@en ;
    skos:prefLabel "Ingham Sand and Gravel Formation"@en ;
.

