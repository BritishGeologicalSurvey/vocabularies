        "Heavitree Breccia Member [Obsolete: use HVBR]"@en ,
        "Heavitree Breccia [Obsolete: use HVBR]"@en ,
        "Heavitree Conglomerate [Obsolete: use HVBR]"@en ,
        "Kennford Breccias and Langstone Breccia [Obsolete: use HVBR]"@en ;
