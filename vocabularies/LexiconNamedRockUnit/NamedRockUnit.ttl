namedrockunit:DOLL
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Sandstone, medium-grained, white, soft, pure quartz, massive and cross-bedded, cross-laminated and parallel laminated, up to 20 m thick (Doll Sandstone Unit (= Bed) of Hurst (1981), overlain by over 30 m of grey shaly mudstone with thin interbedded sideritic mudstone beds ('cementstones' of early usage) that are laterally extensive; together these two units constitute the Doll Member. Its top is marked by a prominent brecciated siderite-cemented mudstone horizon (Bed 1 of Hurst, 1981)."@en ;
    lexicon:hasLowerBoundaryDefinition "As for Brora Coal Formation (BOCO)."@en ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JN> ;
    lexicon:hasOldestAgeValue 1.682e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "Over 50 m."@en ;
    lexicon:hasUpperBoundaryDefinition "Overlain by the Inverbrora Member (INVBR)."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/JC> ;
    lexicon:hasYoungestAgeValue 1.615e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader namedrockunit:BOCO ;
    skos:definition "Mudstone and sandstone. Stratified bedrock. Occurs onshore. Deposited during the Bathonian Age - to - Callovian Age (Jurassic Period) (168.2-161.5 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "DOLL"@en ;
    skos:prefLabel "Doll Member"@en ;
.

