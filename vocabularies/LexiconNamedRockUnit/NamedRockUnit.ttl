namedrockunit:SHB
    a skos:Concept ;
    lexicon:hasBroaderPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/C> ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SDST"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SLST"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "Interbedded, thin- to medium-bedded red, green and grey mudstone, limestone, sandstone and siltstone with a thick red crinoidal limestone, known as the Bryozoa Bed, developed at the top.  Mainly deposited in a marine influenced lagoonal environment."@en ;
    lexicon:hasLowerBoundaryDefinition "Gradational, but taken for convenience at the top of the Sneyd Park Fish Bed, a conglomeratic fish-bearing sandstone at the top of the red sandstones, mudstones, siltstones and conglomerates of the underlying Portishead Formation. Above the Sneyd Park Fish Bed grey mudstones and limestones of the Formation appear interbedded with red sandstones and mudstones. This boundary is in need of work."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H1817 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasOldestAgeValue 3.593e+02 ;
    lexicon:hasPredominantAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/F> ;
    lexicon:hasThicknessDescription "30 to 50m"@en ;
    lexicon:hasUpperBoundaryDefinition "Taken at the irregular erosive contact between the red crinoidal limestone [Bryozoa Bed] of the Formation and the overlying pebbly phosphatic limestone [Palate Bed], the basal bed of the interbedded limestones and mudstones of the undivided Avon Group."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CF> ;
    lexicon:hasYoungestAgeValue 3.467e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Shirehampton Beds [Obsolete: use SHB]"@en ;
    skos:broader namedrockunit:AVO ;
    skos:definition "Limestone and mudstone with subsidiary sandstone and siltstone. Stratified bedrock. Occurs onshore. Deposited during the Courceyan Substage (Carboniferous Period) (359.3-346.7 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHB"@en ;
    skos:prefLabel "Shirehampton Formation"@en ;
.

namedrockunit:SHEB
    a skos:Concept ;
    lexicon:hasLithology
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BA"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MUG"^^xsd:anyURI ,
        "http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA"^^xsd:anyURI ;
    lexicon:hasLithologyDescription "The Shelloch Burn Lava Member consists of a varied assemblage of lavas including: trachybasalt, basaltic trachyandesite (mugearite), microporphyritic basalt (of Jedburgh' type); plagioclase-macrophyric basalt (of 'Markle' type); and transitional plagioclase-microphyric to plagioclase-macrophyric basalts. The lavas are variably massive to locally platy jointed, slaggy and vesicular, dull red 'boles' are common and a lava tube has been observed."@en ;
    lexicon:hasLowerBoundaryDefinition "The basal trachbasalt lava of the member is conformable or disconformable on the underlying plagioclase-microphyric basalts of the Spout of Ballochleam Lava Member."@en ;
    lexicon:hasObsoleteEquivalent namedrockunit:H3672 ;
    lexicon:hasOldestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CJ> ;
    lexicon:hasOldestAgeValue 3.445e+02 ;
    lexicon:hasRockUnitRank <http://data.bgs.ac.uk/id/Lexicon/RockUnitRank/M> ;
    lexicon:hasThicknessDescription "40-61 m"@en ;
    lexicon:hasUpperBoundaryDefinition "The member is overlain unconformably by the Fintry Hills Lava Member. The lithological change is from basaltic trachyandesite (mugearite) or trachybasalt to plagioclase-microphyric basalt."@en ;
    lexicon:hasYoungestAge <http://data.bgs.ac.uk/id/Geochronology/Division/CR> ;
    lexicon:hasYoungestAgeValue 3.309e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Lexicon/NamedRockUnit"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:altLabel "Shelloch Burn Group [Obsolete: use SHEB]"@en ;
    skos:broader namedrockunit:CPV ;
    skos:definition "Basalt and trachybasalt with subsidiary mugearite. Stratified bedrock. Occurs onshore. Deposited during the Arundian Substage - to - Asbian Substage (Carboniferous Period) (344.5-330.9 Ma BP)."@en ;
    skos:inScheme lexicon:NamedRockUnit ;
    skos:notation "SHEB"@en ;
    skos:prefLabel "Shelloch Burn Lava Member"@en ;
.

