PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX lexicon: <http://data.bgs.ac.uk/ref/Lexicon/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

lexicon:RockUnitRank
    a skos:ConceptScheme ;
    dcterms:creator <http://data.bgs.ac.uk/id/org/bgs> ;
    dcterms:identifier "http://data.bgs.ac.uk/ref/Lexicon/RockUnitRank"^^xsd:anyURI ;
    dcterms:publisher <http://data.bgs.ac.uk/id/org/bgs> ;
    skos:definition "Dictionary of the controlled vocabulary for ranks of lithostratigraphical, lithodemic, litho-morpho-genetic and other types of deposits."@en ;
    skos:historyNote "Created for internal use in corporate BGS relational database"@en ;
    skos:prefLabel "Lexicon Rock Unit Rank"@en ;
.

<http://data.bgs.ac.uk/id/org/bgs>
    a schema:Organization ;
    schema:name "British Geological Survey" ;
    schema:url "https://www.bgs.ac.uk/"^^xsd:anyURI ;
.
