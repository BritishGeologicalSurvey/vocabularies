rank:CHRON
    a skos:Concept ;
    rdfs:label "Chron"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Rank"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:definition "Chron is not currently used by BGS as a geochronological rank."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/Geochronology/Rank> ;
    skos:prefLabel "Chron"@en ;
.

rank:AGE
    a skos:Concept ;
