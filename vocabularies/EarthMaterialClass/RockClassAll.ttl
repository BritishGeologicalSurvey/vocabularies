    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PHSND> ;
    skos:broader rockclassall:PHSD ;
    skos:definition "Phosphate-sand - A type of phosphate-sediment. In the Rock Classification Scheme, it is one in which clasts are predominantly 32 µm to 2 mm, with less than 75% of the clasts smaller than 32 µm and less than 25% larger than 2 mm. The grain size classes are defined in the same way as the siliciclastic sediments. British Geological Survey Research Report RR/99/03, section 4.1, table 10 and fig. 8. See also: silicate-sand."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PHSND"@en ;
    skos:prefLabel "Phosphate-sand"@en ;
