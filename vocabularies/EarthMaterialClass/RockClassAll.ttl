    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:LUCTI ,
        rockclassall:NEI ;
    skos:notation "FDI"@en ;
    skos:prefLabel "Foidite"@en ;
