    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/COLEST> ;
    skos:broader rockclassall:NCSLTR ;
    skos:definition "Colemanite-stone - A type of non-carbonate salt that is composed of particles of the borate mineral colemanite. British Geological Survey Research Report RR/99/03, section 7.1 and fig. 11."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "COLEST"@en ;
    skos:prefLabel "Colemanite-stone"@en ;
.

rockclassall:COLLW
    a skos:Concept ;
    rdfs:label "Colliery waste"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/COLLW> ;
    skos:broader rockclassall:ARTDP ;
    skos:definition "Colliery waste - A type of artifical deposit. It consists of heterolithic waste material produced from the mining of coal or associated ironstone and fireclay. It is commonly a mixture of mudstone, siltstone, sandstone, carbonaceous shale and coal, with minor amounts of ironstone. It may contain secondary minerals such as pyrite and sulphur. British Geological Survey Research Report RR/99/04, appendix 1. Synonyms: spoil, tip, bing (Scotland)."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "COLLW"@en ;
    skos:prefLabel "Colliery waste"@en ;
.

