    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "LPDLRM"@en ;
    skos:prefLabel "Diopside-leucite-richterite-madupitic lamproite"@en ;
