    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PS_SASR> ;
    skos:broader rockclassall:PS_SSSR ;
    skos:definition "Siliciclastic argillaceous sediment and rock - In the Rock Classification Scheme, this class includes siliciclastic argillaceous sediment and siliciclastic argillaceous rock. British Geological Survey Research Report RR/99/03, section 2.3 and fig. 5."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
