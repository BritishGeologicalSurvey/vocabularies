rockclassall:PHT_IR
    a skos:Concept ;
    rdfs:label "Meta-igneous rock"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PHT_IR> ;
    skos:broader rockclassall:PH_MET ;
    skos:definition "Meta-igneous rock - In the Rock Classification Scheme, a rock is classified within this category if it is considered to be a metamorphic rock derived from an igneous protolith, either because of its lithological characteristics (i.e. preservation of igneous textures and in some cases composition or mineralogy) or its lithological associations. The class includes meta-igneous rock based on protolith name, meta-igneous rock based on modal composition, and meta-igneous rock based on textural attributes. British Geological Survey Research Report RR/99/02, section 5 and fig. 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:PHT_IPN ,
        rockclassall:PHT_MOD ,
        rockclassall:PHT_TEX ;
    skos:notation "+#~IR"@en ;
    skos:prefLabel "Meta-igneous rock"@en ;
.

