rockclassall:RYT
    a skos:Concept ;
    rdfs:label "Rhyolite (TAS)"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/RYT> ;
    skos:broader rockclassall:RYR ;
    skos:definition "Rhyolite (TAS) - A type of rhyolitic-rock, classified using the total alkali silica (TAS) classification. The TAS classification may be used if the mineral mode of a normal fine-grained crystalline rock cannot be determined due either to the presence of glass or to the fine-grained nature of the rock. The definition of rhyolite (TAS) is as shown in British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17b, 20."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:CMRY ,
        rockclassall:PTRY ,
        rockclassall:RYPK ,
        rockclassall:RYTRLT ;
    skos:notation "RYT"@en ;
    skos:prefLabel "Rhyolite (TAS)"@en ;
.

rockclassall:SCOAL
    a skos:Concept ;
    rdfs:label "Sapropelic-coal"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/SCOAL> ;
    skos:broader rockclassall:COAL ;
    skos:definition "Sapropelic-coal - A type of coal. It is a member of the sapropelic coal series. The members of the sapropelic coal series can be ranked in order as sapropel (the unlithified form), sapropelic-lignite, and sapropelic-coal (the lithified forms) based on increasing carbon content and decreasing volatile content. It is characteristically fine-grained, faintly bedded to homogeneous and massive. It is generally dark in colour with dull to greasy lustre and typically displays conchoidal fracture. Sapropelic coals are subdivided into cannel-coal and boghead-coal based on type of organic matter and other physical properties. British Geological Survey Research Report RR/99/03, section 6.2, table 17 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:BGCCOL ,
        rockclassall:BGCOL ,
        rockclassall:CANL ,
        rockclassall:CBCOAL ;
    skos:notation "SCOAL"@en ;
    skos:prefLabel "Sapropelic-coal"@en ;
.

