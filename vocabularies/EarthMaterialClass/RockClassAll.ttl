    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/ANMUD> ;
    skos:broader rockclassall:AKSED ;
    skos:definition "Ankerite-mud - A type of ankerite-sediment. In the Rock Classification Scheme, it is one in which over 75% of the clasts are smaller than 32 µm. The grain size classes are defined in the same way as the siliciclastic sediments. British Geological Survey Research Report RR/99/03, section 3.2, table 6 and fig. 7. See also: silicate-mud."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "ANMUD"@en ;
    skos:prefLabel "Ankerite-mud"@en ;
.

rockclassall:ANO
    a skos:Concept ;
    rdfs:label "Anorthosite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/ANO> ;
    skos:broader rockclassall:ANOR ;
    skos:definition "Anorthosite - A type of anorthositic-rock. In the Rock Classification Scheme, it is a coarse-grained crystalline igneous rock whose mineral mode plots in field 10 of the quartz - alkali feldspar - plagioclase - feldspathoid (QAPF) diagram. Diorite, gabbro and anorthosite are separated according to the average composition of their plagioclase and the proportion of mafic minerals (M): if M is less than 10% the rock is anorthosite. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 11, 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "ANO"@en ;
    skos:prefLabel "Anorthosite"@en ;
.

