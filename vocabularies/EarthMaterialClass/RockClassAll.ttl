rockclassall:BATHL
    a skos:Concept ;
    rdfs:label "Tholeiitic basalt"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/BATHL> ;
    skos:broader rockclassall:BASBA ;
    skos:definition "Basalt, tholeiitic - A subgroup of subalkali basalt. Tholeiitic describes a variety of basalt which is saturated or slightly oversaturated in silica with respect to alkalis so that hypersthene appears in the CIPW norm and hypersthene or pigeonite amongst the modal pyroxenes. Olivine may be present in widely varying amounts, or absent. The term is also used for a suite of rocks showing marked iron-enrichment on AFM diagrams. British Geological Survey Research Report RR/99/06, section 8.4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:DBAT ,
        rockclassall:MGTBAT ;
    skos:notation "BATHL"@en ;
    skos:prefLabel "Tholeiitic basalt"@en ;
.

