rockclassall:TUF
    a skos:Concept ;
    rdfs:label "Tuff"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/TUF> ;
    skos:broader rockclassall:PYRR ;
    skos:definition "Tuff - A type of pyroclastic-rock. In the Rock Classification Scheme, it is a pyroclastic-rock in which the average size of more than 75% of the pyroclastic fragments is less than 64 mm. Lapillistone, lapilli-tuff, and tuff are separated according to the relative proportion of lapilli-grade (2 - 64 mm) and ash-grade (<2 mm) fragments: if less than 25% of the fragments are lapilli the rock is tuff. It is the consolidated equivalent of ash. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
