    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/CAOCBT> ;
    skos:broader rockclassall:CBT ;
    skos:definition "Calciocarbonatite - A type of carbonatite. In the Rock Classification Scheme, this term may be used when a chemical classification is necessary because the rock is too fine grained for an accurate mode to be determined, or if the carbonate minerals are complex Ca-Mg-Fe solid solutions. The definition of calciocarbonatite is as shown in British Geological Survey Research Report RR/99/06, section 6.1 and figs. 25, 26. See also: calcite-carbonatite."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "CAOCBT"@en ;
    skos:prefLabel "Calciocarbonatite"@en ;
.

