    skos:broader rockclassall:PHOST ;
    skos:definition "Phosphorite, pebble-grade"@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PGPHN"@en ;
    skos:prefLabel "Pebble-grade phosphorite"@en ;
.

rockclassall:PGRNF
    a skos:Concept ;
    rdfs:label "Paragranofels"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PGRNF> ;
    skos:broader rockclassall:PHS_TEX ;
    skos:definition "Paragranofels - A type of metasedimentary rock based on textural attributes. It lacks any obvious foliation and layering and is commonly characterised by a granoblastic texture. A granofels can occur at any metamorphic grade with a range of lithologies. Note the para- prefix indicates a rock that is thought to have a sedimentary protolith, in contrast with orthogranofels which has an igneous protolith, and granofels where the nature of the protolith is not defined. British Geological Survey Research Report RR/99/02, section 3.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PGRNF"@en ;
    skos:prefLabel "Paragranofels"@en ;
.

