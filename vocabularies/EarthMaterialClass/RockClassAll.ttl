    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/NAMG> ;
    skos:broader rockclassall:PS_CSSR ;
    skos:definition "Na carbonate sedimentary rock - In the Rock Classification Scheme, these are carbonate sedimentary rocks in which the dominant carbonate mineral is sodium carbonate. The Na carbonate sedimentary rocks are primary precipitates and do not have an unlithified equivalent. They are classified as gaylussite, natron, thermonatrite and trona. British Geological Survey Research Report RR/99/03, section 3.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:GAYLUS ,
        rockclassall:NATRON ,
        rockclassall:THERM ,
        rockclassall:TRONA ;
    skos:notation "NAMG"@en ;
    skos:prefLabel "Na carbonate sedimentary rock"@en ;
.

rockclassall:PHS_SSR
    a skos:Concept ;
    rdfs:label "Metasedimentary rock"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PHS_SSR> ;
    skos:broader rockclassall:PH_MET ;
    skos:definition "Metasedimentary rock - In the Rock Classification Scheme, a rock is classified within this category if it is known to be a metamorphic rock derived from a sedimentary protolith, either because of its lithological characteristics or its lithological associations. The class includes metasedimentary rock based on protolith name, metasedimentary rock based on modal composition, and metasedimentary rock based on textural attributes. British Geological Survey Research Report RR/99/02, section 3 and fig. 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:PHS_MOD ,
        rockclassall:PHS_SPN ,
        rockclassall:PHS_TEX ,
        rockclassall:SDGN ;
    skos:notation "+#*SSR"@en ;
    skos:prefLabel "Metasedimentary rock"@en ;
.

