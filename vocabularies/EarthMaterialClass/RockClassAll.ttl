    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/FOIDR> ;
    skos:broader rockclassall:MAFI ;
    skos:definition "Foiditic-rock - A type of mafite. In the Rock Classification Scheme, this class includes foidite and similar rocks. The term may be used as a field classification when an accurate mineral mode from thin section examination, or a chemical analysis, is not available. British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17, 18."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:BSNFDI ,
        rockclassall:FDI ,
        rockclassall:FDIT ,
        rockclassall:PNFDI ,
        rockclassall:TEPFDI ;
    skos:notation "FOIDR"@en ;
    skos:prefLabel "Foiditic-rock"@en ;
.

rockclassall:GRNFEL
    a skos:Concept ;
    rdfs:label "Granofels"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/GRNFEL> ;
    skos:broader rockclassall:PH_UTEX ;
    skos:definition "Granofels - A type of metamorphic rock with unknown protolith based on textural attributes. It lacks any obvious foliation and layering and is commonly characterised by a granoblastic texture. A granofels can occur at any metamorphic grade with a range of lithologies. Note that orthogranofels indicates a rock that is thought to have an igneous protolith, and paragranofels indicates a rock that is thought to have a sedimentary protolith. British Geological Survey Research Report RR/99/02, sections 3.3, 6.1 and fig. 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:GCSP ,
        rockclassall:GCSQ ,
        rockclassall:GRCS ,
        rockclassall:GRNPX ,
        rockclassall:SSPG ;
    skos:notation "GRNFEL"@en ;
    skos:prefLabel "Granofels"@en ;
.

rockclassall:HBT
    a skos:Concept ;
    rdfs:label "Hornblendite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/HBT> ;
    skos:broader rockclassall:UMR ;
    skos:definition "Hornblendite - A type of ultramafic-rock. In the Rock Classification Scheme, it is a coarse-grained ultramafic rock with less than 40% olivine, and hornblende dominant over pyroxene. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 15, 16."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:AMHO ,
        rockclassall:HBTSS ,
        rockclassall:OLHBT ,
        rockclassall:OLPXHB ,
        rockclassall:PXHBT ;
    skos:notation "HBT"@en ;
    skos:prefLabel "Hornblendite"@en ;
.

rockclassall:KALR
    a skos:Concept ;
    rdfs:label "Kalsilitic rock"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/KALR> ;
    skos:broader rockclassall:ECR ;
    skos:definition "Kalsilitic rock - A type of exotic crystalline igneous rock. In the Rock Classification Scheme, it is defined as a rock that contains more than 10% modal kalsilite. Kalsilite is a very rare mineral, and its presence is sufficiently important to merit defining rocks with notable kalsilite as a separate group. In the present scheme a threshold value of 10% modal kalsilite has been adopted, the same as the threshold for melilitic rock and leucitic rock. Kalsilite behaves metastably and only rarely survives slow cooling, so virtually all rocks containing kalsilite are fine- or very fine-grained lavas. Coarse-grained rocks containing kalsilite (e.g. kalsilite-bearing syenite and kalsilite-bearing-biotite pyroxenite) have been reported from Russia; however they are extremely rare. British Geological Survey Research Report RR/99/06, section 6.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:KALI ,
        rockclassall:KALO ,
        rockclassall:MCKALR ,
        rockclassall:OLPXK ,
        rockclassall:OLPXKO ;
    skos:notation "KALR"@en ;
    skos:prefLabel "Kalsilitic rock"@en ;
.

rockclassall:MCGNL
    a skos:Concept ;
