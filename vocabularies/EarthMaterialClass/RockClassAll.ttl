rockclassall:G1KMB
    a skos:Concept ;
    rdfs:label "Group-1-kimberlite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/G1KMB> ;
    skos:broader rockclassall:KMB ;
    skos:definition "Group-1-kimberlite - A type of kimberlite. Group-1-kimberlite corresponds to archetypal rocks from Kimberley, South Africa that formerly were termed basaltic kimberlites. These are volatile-rich (dominantly CO<sub>2</sub>), potassic, ultrabasic rocks which commonly exhibit a distinctive inequigranular texture resulting from the presence of macrocrysts (and in some instances megacrysts) set in a fine-grained matrix. British Geological Survey Research Report RR/99/06, section 6.4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "G1KMB"@en ;
    skos:prefLabel "Group-1-kimberlite"@en ;
.

rockclassall:G2KMB
    a skos:Concept ;
    rdfs:label "Group-2-kimberlite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/G2KMB> ;
    skos:broader rockclassall:KMB ;
    skos:definition "Group-2-kimberlite - A type of kimberlite. Group-2-kimberlite corresponds to micaceous or lamprophyric kimberlites. They are characterised by the presence of macrocrysts, phenocrysts and groundmass micas, which vary from phlogopite to tetraferriphlogopite. British Geological Survey Research Report RR/99/06, section 6.4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "G2KMB"@en ;
    skos:prefLabel "Group-2-kimberlite"@en ;
.

