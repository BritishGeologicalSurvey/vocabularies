rockclassall:REGOL
    a skos:Concept ;
    rdfs:label "Regolith"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/REGOL> ;
    skos:broader rockclassall:RESDP ;
    skos:definition "Regolith - A type of residual deposit. It is a general term used to describe the in situ or nearly in situ weathered products (including disintegrated rock, rock fragments and mineral grains) overlying fresh or relatively fresh rock (the weathered mantle). It can be subdivided into weathered rock and saprolite, and classified according to engineering geological weathered rock grades. British Geological Survey Research Report RR/99/04, appendix 2. Synonym: blanket head."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:SAPRO ,
        rockclassall:WRC ;
    skos:notation "REGOL"@en ;
    skos:prefLabel "Regolith"@en ;
.

