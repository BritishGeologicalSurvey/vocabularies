rockclassall:BGCOL
    a skos:Concept ;
    rdfs:label "Boghead-coal"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/BGCOL> ;
    skos:broader rockclassall:SCOAL ;
    skos:definition "Boghead-coal - A type of sapropelic-coal. It is similar to cannel-coal but browner and rich in alginite with very few miospores. It appears unstratified on macroscopic examination. Microscopic examination shows that boghead-coal consists of alginite and very finely dispersed inertinite and vitrinite. The proportion of alginite can vary widely. Boghead-coal is sometimes referred to as torbanite. This term is not recommended for usage. British Geological Survey Research Report RR/99/03, section 6.2 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "BGCOL"@en ;
    skos:prefLabel "Boghead-coal"@en ;
.

