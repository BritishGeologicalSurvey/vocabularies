    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/BGCCOL> ;
    skos:broader rockclassall:SCOAL ;
    skos:definition "Boghead-cannel-coal - A type of sapropelic-coal. It is a transitional stage between cannel-coal and boghead-coal in which miospores dominate over alginite. British Geological Survey Research Report RR/99/03, section 6.2 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "BGCCOL"@en ;
    skos:prefLabel "Boghead-cannel-coal"@en ;
