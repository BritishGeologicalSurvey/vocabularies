    rdfs:label "Quartz-rich-medium-grained-crystalline-rock"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/MQRCR> ;
    skos:broader rockclassall:MGNCR ;
    skos:definition "Quartz-rich-medium-grained-crystalline-rock - A type of medium-grained normal crystalline rock. In the Rock Classification Scheme, it is the medium-grained equivalent of quartz-rich-coarse-grained-crystalline-rock. The class includes microquartzolite and similar rocks. The term may be used as a field classification when an accurate mineral mode from thin section examination is not available. British Geological Survey Research Report RR/99/06, section 5.1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:MCQGR ,
        rockclassall:MCQZLT ;
    skos:notation "MQRCR"@en ;
    skos:prefLabel "Quartz-rich-medium-grained-crystalline-rock"@en ;
.

