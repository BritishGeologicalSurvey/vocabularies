    skos:broader rockclassall:FGNR ;
    skos:definition "Porphyry - A type of fine-grained normal crystalline rock. It is a rock containing phenocrysts and with an aphanitic groundmass of indeterminate origin. British Geological Survey Research Report RR/99/06, section 8.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:PPHYF ,
