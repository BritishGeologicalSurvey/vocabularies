    skos:broader rockclassall:PYRSD ;
    skos:definition "Ash-breccia - A type of pyroclastic-sediment. In the Rock Classification Scheme, it is a pyroclastic-sediment which contains more than 25% of each of the main pyroclastic fragment size divisions: blocks and bombs (>64 mm), lapilli (2 - 64 mm), and ash (<2 mm). It is the unconsolidated equivalent of tuff-breccia. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "ASHBRC"@en ;
    skos:prefLabel "Ash-breccia"@en ;
