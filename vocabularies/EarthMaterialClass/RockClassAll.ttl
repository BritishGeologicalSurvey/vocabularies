    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/SIMUD> ;
    skos:broader rockclassall:SAS ;
    skos:definition "Silicate-mud - A type of siliciclastic argillaceous sediment. In the Rock Classification Scheme, all siliciclastic argillaceous sediments are given this group name. They may be further classified as silicate-silt or silicate-clay based on the proportion of silt to clay. British Geological Survey Research Report RR/99/03, section 2.3 and fig. 5. See also: lime-mud."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:CSIMD ,
        rockclassall:SICLY ,
        rockclassall:SISILT ;
    skos:notation "SIMUD"@en ;
    skos:prefLabel "Silicate-mud"@en ;
