    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/FEOCBT> ;
    skos:broader rockclassall:CBT ;
    skos:definition "Ferrocarbonatite - A type of carbonatite. In the Rock Classification Scheme, this term may be used when a chemical classification is necessary because the rock is too fine grained for an accurate mode to be determined, or if the carbonate minerals are complex Ca-Mg-Fe solid solutions. The definition of ferrocarbonatite is as shown in British Geological Survey Research Report RR/99/06, section 6.1 and figs. 25, 26. See also: ferroan-carbonatite."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "FEOCBT"@en ;
    skos:prefLabel "Ferrocarbonatite"@en ;
.

