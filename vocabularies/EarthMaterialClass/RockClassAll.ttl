    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:DAGB ,
        rockclassall:DAGL ,
        rockclassall:DALAVA ,
        rockclassall:DAP ,
        rockclassall:RADA ;
    skos:notation "DA"@en ;
    skos:prefLabel "Dacite"@en ;
.

