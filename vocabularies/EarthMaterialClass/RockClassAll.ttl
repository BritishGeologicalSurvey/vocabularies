    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/FENITE> ;
    skos:broader rockclassall:MESO ;
    skos:definition "Fenite - A type of metasomatic-rock. Fenites are desilicated crustal rocks formed by reaction with Na- and K-rich fluids expelled during the emplacement of carbonatite or undersaturated alkaline magmas. British Geological Survey Research Report RR/99/02, section 8."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "FENITE"@en ;
    skos:prefLabel "Fenite"@en ;
.

rockclassall:FEOCBT
    a skos:Concept ;
    rdfs:label "Ferrocarbonatite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
