    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:FDGB ,
        rockclassall:FMZGB ;
    skos:notation "FDGBR"@en ;
    skos:prefLabel "Foid-gabbroic-rock"@en ;
