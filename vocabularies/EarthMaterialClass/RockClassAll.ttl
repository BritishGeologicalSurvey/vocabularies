    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/EFLUE> ;
    skos:broader rockclassall:ARTDP ;
    skos:definition "Effluent - A type of artifical deposit. It consists of waste liquid flowing from a sewage tank or industrial process etc. British Geological Survey Research Report RR/99/04, appendix 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "EFLUE"@en ;
    skos:prefLabel "Effluent"@en ;
.

rockclassall:FBAFSY
    a skos:Concept ;
    rdfs:label "Foid-bearing-alkali-feldspar-syenite"@en ;
