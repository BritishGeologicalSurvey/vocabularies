    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PNFDI> ;
    skos:broader rockclassall:FOIDR ;
    skos:definition "Phonolitic-foidite - A type of foiditic-rock. In the Rock Classification Scheme, this name is used for a fine-grained crystalline igneous rock when the modal mineralogy is available, and the mineral mode plots in field 15a of the quartz - alkali feldspar - plagioclase - feldspathoid (QAPF) diagram. British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17a, 19."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PNFDI"@en ;
    skos:prefLabel "Phonolitic-foidite"@en ;
.

rockclassall:PNLUC
    a skos:Concept ;
    rdfs:label "Phonolitic-leucitite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PNLUC> ;
    skos:broader rockclassall:LUCTI ;
    skos:definition "Phonolitic-leucitite - A type of leucitite. In the Rock Classification Scheme, this rock plots in field 15a on the quartz - alkali feldspar - plagioclase - feldspathoid (QAPF) diagram; foids constitute 60 to 90% of light-coloured constituents; alkali feldspar is dominant over plagioclase. British Geological Survey Research Report RR/99/06, sections 5.2, 6.6."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PNLUC"@en ;
    skos:prefLabel "Phonolitic-leucitite"@en ;
.

rockclassall:PNT
    a skos:Concept ;
    rdfs:label "Phonolite (TAS)"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/PNT> ;
    skos:broader rockclassall:PNR ;
    skos:definition "Phonolite (TAS) - A type of phonolitic-rock, classified using the total alkali silica (TAS) classification. The TAS classification may be used if the mineral mode of a normal fine-grained crystalline rock cannot be determined due either to the presence of glass or to the fine-grained nature of the rock. The definition of phonolite (TAS) is as shown in British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17b, 20."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:notation "PNT"@en ;
    skos:prefLabel "Phonolite (TAS)"@en ;
.

