rockclassall:QDI
    a skos:Concept ;
    rdfs:label "Quartz-diorite"@en ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockName/QDI> ;
    skos:broader rockclassall:DIR ;
    skos:definition "Quartz-diorite - A type of dioritic-rock. In the Rock Classification Scheme, it is a coarse-grained crystalline igneous rock whose mineral mode plots in field 10* of the quartz - alkali feldspar - plagioclase - feldspathoid (QAPF) diagram. Quartz-diorite, quartz-gabbro and quartz-anorthosite are separated according to the average composition of their plagioclase and the proportion of mafic minerals (M): if M is greater than 10% and An (the anorthite content of plagioclase) is less than 50% the rock is quartz-diorite. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 11, 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockClassAll> ;
    skos:narrower
        rockclassall:DIQD ,
        rockclassall:QDIF ,
        rockclassall:TOQD ;
    skos:notation "QDI"@en ;
    skos:prefLabel "Quartz-diorite"@en ;
.

