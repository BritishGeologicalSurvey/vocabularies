rockname:PSCH
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PSCH> ;
    skos:broader rockname:PHS_TEX ;
    skos:definition "Paraschist - A type of metasedimentary rock based on textural attributes. In the Rock Classification Scheme, it is defined as a medium-grained strongly foliated rock that can be readily split into flakes or slabs due to the well-developed preferred orientation of the majority of the minerals present, particularly those of platy or prismatic habit. Schists occur characteristically in areas of medium-grade metamorphism and can encompass a wide range of lithologies. Note the para- prefix indicates a rock that is thought to have a sedimentary protolith, in contrast with orthoschist which has an igneous protolith, and schist where the nature of the protolith is not defined. British Geological Survey Research Report RR/99/02, section 3.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower rockname:PSCHAC ;
    skos:notation "PSCH"@en ;
    skos:prefLabel "Paraschist"@en ;
.

rockname:PS_SNCS
