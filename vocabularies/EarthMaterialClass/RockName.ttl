rockname:LMPSST
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMPSST> ;
    skos:broader rockname:LMST ;
    skos:definition "Lime-pseudosparstone - A type of limestone, classified on the basis of its diagenetic texture. It is a limestone composed almost totally of a divergent radial fibrous calcite cement in which grains or in-situ biogenic material do not constitute a framework. The calcite pseudospar occurs as in-situ botryoidal masses commonly found in the core of algal mounds and probably formed from early diagenetic alteration of aragonite masses. The diagenetic process does not cause any alteration to the depositional or biological texture. British Geological Survey Research Report RR/99/03, section 3.1, table 3 and fig. 6."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "LMPSST"@en ;
    skos:prefLabel "Lime-pseudosparstone"@en ;
.

