rockname:LMBST
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMBST> ;
    skos:broader rockname:LMST ;
    skos:definition "Lime-boundstone - A type of limestone, classified on the basis of its biogenic texture. It is a limestone in which the original components were bound and encrusted together by the action of plants and animals in the position of growth (e.g. reef limestones). British Geological Survey Research Report RR/99/03, section 3.1, table 3 and fig. 6."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "LMBST"@en ;
    skos:prefLabel "Lime-boundstone"@en ;
.

rockname:LMFST
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/LMFST> ;
    skos:broader rockname:LMST ;
    skos:definition "Lime-framestone - A type of limestone, classified on the basis of its biogenic texture. It is a type of reef rock consisting of a rigid framework of colonies, shells or skeletons. Internal cavities are filled with fine sediment. British Geological Survey Research Report RR/99/03, section 3.1, table 3 and fig. 6."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "LMFST"@en ;
    skos:prefLabel "Lime-framestone"@en ;
.

