rockname:CHRT
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CHRT> ;
    skos:broader rockname:SILICR ;
    skos:definition "Chert - A type of siliceous rock. It usually has a porosity of less than 10%. Chert is dense, very hard, and has a vitreous lustre. It can be further classified as opaline-chert and quartzose-chert according to the type of silica. It may not be possible to accurately use this classification without X-ray analysis. In addition, the root names jasper, flint, and agate are available to describe distinctive types. British Geological Survey Research Report RR/99/03, section 8.2 and fig. 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:AGATE ,
        rockname:FLNT ,
        rockname:JASPER ,
        rockname:OCHERT ,
        rockname:QCHERT ;
    skos:notation "CHRT"@en ;
    skos:prefLabel "Chert"@en ;
.

