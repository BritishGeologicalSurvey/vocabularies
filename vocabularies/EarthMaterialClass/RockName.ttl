    skos:broader rockname:LMST ;
    skos:definition "Lime-grainstone - A type of limestone, classified on the basis of its depositional texture. It is a grain-supported limestone with little matrix (mud-grade material smaller than 32 µm). British Geological Survey Research Report RR/99/03, section 3.1, table 3 and fig. 6."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "LMGST"@en ;
    skos:prefLabel "Lime-grainstone"@en ;
.

