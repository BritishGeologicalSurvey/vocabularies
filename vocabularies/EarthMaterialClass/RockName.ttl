    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PS_SASR> ;
    skos:broader rockname:PS_SSSR ;
    skos:definition "Siliciclastic argillaceous sediment and rock - In the Rock Classification Scheme, this class includes siliciclastic argillaceous sediment and siliciclastic argillaceous rock. British Geological Survey Research Report RR/99/03, section 2.3 and fig. 5."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:AROC ,
        rockname:SAS ;
    skos:notation "+*SASR"@en ;
    skos:prefLabel "Siliciclastic argillaceous sediment and rock"@en ;
.

rockname:PS_SSRO
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PS_SSRO> ;
    skos:broader rockname:PS_SSR ;
    skos:definition "Organic-rich sediment and sedimentary rock - In the Rock Classification Scheme, these are defined as those sediments and sedimentary rocks where the organic content is sufficiently high to have a noticeable effect on the lithology. A definition based on a greater than 50% volumetric abundance of organic matter is not possible because historically the definitions of sediments and sedimentary rocks rich in organic-matter have been based on their quality as fossil fuels. British Geological Survey Research Report RR/99/03, section 6 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:OROC ,
        rockname:OSD ;
    skos:notation "+*SSRO"@en ;
    skos:prefLabel "Organic-rich sediment and sedimentary rock"@en ;
.

rockname:PTST
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PTST> ;
    skos:broader rockname:GLIG ;
    skos:definition "Pitchstone - A type of glassy-igneous-rock. It is a glassy, altered (hydrated/devitrified), igneous rock. The term has no compositional inference. British Geological Survey Research Report RR/99/06, section 8.3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:PRPTST ,
        rockname:PTSTAC ;
    skos:notation "PTST"@en ;
    skos:prefLabel "Pitchstone"@en ;
.

rockname:QRCGCR
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/QRCGCR> ;
    skos:broader rockname:CGR ;
    skos:definition "Quartz-rich-coarse-grained-crystalline-rock - A type of coarse-grained normal crystalline rock. In the Rock Classification Scheme, this class includes quartzolite and similar rocks. The term may be used as a field classification when an accurate mineral mode from thin section examination is not available. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:QRGNR ,
        rockname:QTZOLT ;
    skos:notation "QRCGCR"@en ;
    skos:prefLabel "Quartz-rich-coarse-grained-crystalline-rock"@en ;
.

rockname:REGOL
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/REGOL> ;
    skos:broader rockname:RESDP ;
    skos:definition "Regolith - A type of residual deposit. It is a general term used to describe the in situ or nearly in situ weathered products (including disintegrated rock, rock fragments and mineral grains) overlying fresh or relatively fresh rock (the weathered mantle). It can be subdivided into weathered rock and saprolite, and classified according to engineering geological weathered rock grades. British Geological Survey Research Report RR/99/04, appendix 2. Synonym: blanket head."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:SAPRO ,
        rockname:WRC ;
    skos:notation "REGOL"@en ;
    skos:prefLabel "Regolith"@en ;
.

rockname:RESDP
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/RESDP> ;
    skos:broader rockname:NATD ;
    skos:definition "Residual deposit - A type of natural superficial deposit. In the Rock Classification Scheme, this class includes duricrust and regolith. British Geological Survey Research Report RR/99/04, section 4.8."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:DURI ,
        rockname:REGOL ;
    skos:notation "RESDP"@en ;
    skos:prefLabel "Residual deposit"@en ;
.

rockname:SAPEL
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SAPEL> ;
    skos:broader rockname:OROC ;
    skos:definition "Sapropelite - A type of sedimentary-rock rich in organic matter. Sapropelite and cannel-mudstone are both derived from the unlithified fine organic mud termed sapropel. These sapropels contain more inorganic matter and plant matter than the sapropels that form sapropelic coals. Inorganic sedimentary rocks rich in sapropel are classified according to their type of organic matter. Sapropelite is rich in alginite, whereas cannel-mudstone is rich in miospores. The total organic carbon content (TOC) can vary from less than 1% to as much as 81% in a sapropelite from Tasmania, although most sapropelites fall in the range of 8 to 55% TOC. In the Rock Classification Scheme, it is recommended that the lower limit for sapropelite should be 8% TOC and the upper limit 50% TOC. A sapropelite can be recognised in hand specimen by its bituminous smell and by the curled sliver of rock produced when it is scraped with a pen knife. Sapropelites can be subdivided into lamalginite and telaginite by reference to the properties of the organic matter. British Geological Survey Research Report RR/99/03, section 6.3, table 18 and fig. 10. Synonym: oil shale."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:LAMGNT ,
        rockname:TELGNT ;
    skos:notation "SAPEL"@en ;
    skos:prefLabel "Sapropelite"@en ;
.

rockname:SICRET
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/SICRET> ;
    skos:broader rockname:SICOG ;
    skos:definition "Silcrete - A type of silicate-conglomerate, consisting of surficial sand and gravel cemented into a hard mass by silica. British Geological Survey Research Report RR/99/03, section 8.5."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:CSCRET ,
        rockname:NSCRET ;
    skos:notation "SICRET"@en ;
    skos:prefLabel "Silcrete"@en ;
.

rockname:TRBA
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRBA> ;
    skos:broader rockname:TRR ;
    skos:definition "Trachybasalt - A type of trachytic-rock, classified using the total alkali silica (TAS) classification. The TAS classification may be used if the mineral mode of a normal fine-grained crystalline rock cannot be determined due either to the presence of glass or to the fine-grained nature of the rock. The definition of trachybasalt is as shown in British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17b, 20."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:HAW ,
        rockname:KTRBA ;
    skos:notation "TRBA"@en ;
    skos:prefLabel "Trachybasalt"@en ;
.

rockname:TROCT
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TROCT> ;
    skos:broader rockname:GB ;
    skos:definition "Troctolite - A type of gabbro. In the Rock Classification Scheme, it is a gabbro with plagioclase 10 - 90%, pyroxene >5% and olivine 5 - 85% of plagioclase + pyroxene + olivine. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 13, 14."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:MLTROC ,
        rockname:TRCTBY ;
    skos:notation "TROCT"@en ;
    skos:prefLabel "Troctolite"@en ;
.

rockname:TRT
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TRT> ;
    skos:broader rockname:TRR ;
    skos:definition "Trachyte (TAS) - A type of trachytic-rock, classified using the total alkali silica (TAS) classification. The TAS classification may be used if the mineral mode of a normal fine-grained crystalline rock cannot be determined due either to the presence of glass or to the fine-grained nature of the rock. The definition of trachyte (TAS) is as shown in British Geological Survey Research Report RR/99/06, section 5.2 and figs. 17b, 20."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:CMTR ,
        rockname:PTTR ;
    skos:notation "TRT"@en ;
    skos:prefLabel "Trachyte (TAS)"@en ;
.

rockname:TUFA
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFA> ;
    skos:broader rockname:CHEMDP ;
    skos:definition "Tufa - A type of chemical deposit (natural superficial). It is a sedimentary rock composed of calcium carbonate or silica, formed by evaporation as a thin, surficial, soft, spongy, semifriable encrustation around the mouth of springs, seeps or along streams carrying calcium carbonate in solution, and exceptionally as a thick deposit along lake shores. Travertine is a hard, dense variety of tufa; it also occurs in caves as stalactites and stalagmites. British Geological Survey Research Report RR/99/03; RR/99/04, appendix 2 and tables 5, 17. Synonyms: sinter, travertine."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:CATUFA ,
        rockname:SITUFA ;
    skos:notation "TUFA"@en ;
    skos:prefLabel "Tufa"@en ;
.

rockname:TUFCY
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/TUFCY> ;
    skos:broader rockname:TUF ;
    skos:definition "Tuff, crystal"@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:TFEC ,
        rockname:TFWC ;
    skos:notation "TUFCY"@en ;
    skos:prefLabel "Crystal tuff"@en ;
.

rockname:UPRO
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/UPRO> ;
    skos:broader rockname:PH_MET ;
    skos:definition "Metamorphic rock with unknown protolith - In the Rock Classification Scheme, a rock is classified within this category if the nature of the protolith is not known. The class includes metamorphic rock with unknown protolith based on textural attributes, and metamorphic rock with unknown protolith based on modal composition. British Geological Survey Research Report RR/99/02, section 6 and fig. 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:PH_UMOD ,
        rockname:PH_UTEX ;
    skos:notation "UPRO"@en ;
    skos:prefLabel "Metamorphic rock with unknown protolith"@en ;
.

rockname:VCBR
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/VCBR> ;
    skos:broader rockname:VCSR ;
    skos:definition "Volcaniclastic-breccia - A type of volcaniclastic-sedimentary-rock. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4. See also: breccia."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:BAVBR ,
        rockname:VCBRPW ;
    skos:notation "VCBR"@en ;
    skos:prefLabel "Volcaniclastic-breccia"@en ;
.

rockname:AGG
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AGG> ;
    skos:broader rockname:PYRR ;
    skos:definition "Agglomerate - A type of pyroclastic-rock. In the Rock Classification Scheme, it is a pyroclastic-rock in which more than 75% of the pyroclastic fragments exceed 64 mm in size. Agglomerate and pyroclastic-breccia are separated according to the relative proportion of blocks (angular fragments exceeding 64 mm) and bombs (rounded fragments exceeding 64 mm): if bombs dominate over blocks the rock is agglomerate. It is the consolidated equivalent of bomb-tephra or block-bomb-tephra. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:AGBA ,
        rockname:AGTR ,
        rockname:RYAG ;
    skos:notation "AGG"@en ;
    skos:prefLabel "Agglomerate"@en ;
.

rockname:AKSED
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AKSED> ;
    skos:broader rockname:PS_DSRM ;
    skos:definition "Ankerite-sediment - In the Rock Classification Scheme, this is a dolomite-sediment where it is known that the carbonate is composed dominantly of ankerite. British Geological Survey Research Report RR/99/03, section 3.2 and fig. 7."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ANGV ,
        rockname:ANMUD ,
        rockname:ANSA ;
    skos:notation "AKSED"@en ;
    skos:prefLabel "Ankerite-sediment"@en ;
.

rockname:AMPHB
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/AMPHB> ;
    skos:broader rockname:PH_UMOD ;
    skos:definition "Amphibolite - A type of metamorphic rock with unknown protolith based on modal composition. In the Rock Classification Scheme, it is one composed largely of hornblende and plagioclase. This mineralogy reflects amphibolite facies conditions. Note that para-amphibolite indicates a rock that is thought to have a sedimentary protolith, and ortho-amphibolite indicates a rock that is thought to have an igneous protolith. British Geological Survey Research Report RR/99/02, section 6.2."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:AMPHFO ,
        rockname:AMPQXN ,
        rockname:AMPSCH ;
    skos:notation "AMPHB"@en ;
    skos:prefLabel "Amphibolite"@en ;
.

rockname:ANOR
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANOR> ;
    skos:broader rockname:CGR ;
    skos:definition "Anorthositic-rock - A type of coarse-grained normal crystalline rock. In the Rock Classification Scheme, this class includes anorthosite and similar rocks. The term may be used as a field classification when an accurate mineral mode from thin section examination is not available. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ANO ,
        rockname:FBANO ,
        rockname:QANO ;
    skos:notation "ANOR"@en ;
    skos:prefLabel "Anorthositic-rock"@en ;
.

rockname:ARSED
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ARSED> ;
    skos:broader rockname:LMSD ;
    skos:definition "Aragonite-sediment - A type of lime-sediment in which the carbonate is composed dominantly of aragonite. British Geological Survey Research Report RR/99/03, section 3.1 and table 2."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ARGV ,
        rockname:ARMUD ,
        rockname:ARSA ;
    skos:notation "ARSED"@en ;
    skos:prefLabel "Aragonite-sediment"@en ;
.

rockname:ASH
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ASH> ;
    skos:broader rockname:PYRSD ;
    skos:definition "Ash - A type of pyroclastic-sediment. In the Rock Classification Scheme, it is a pyroclastic-sediment in which the average size of more than 75% of the pyroclastic fragments is less than 64 mm. Lapilli-tephra, lapilli-ash, and ash are separated according to the relative proportion of lapilli-grade (2 - 64 mm) and ash-grade (<2 mm) fragments: if less than 25% of the fragments are lapilli the sediment is ash. It is the unconsolidated equivalent of tuff. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ASHC ,
        rockname:ASHL ,
        rockname:ASHV ;
    skos:notation "ASH"@en ;
    skos:prefLabel "Ash"@en ;
.

rockname:BALAVA
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BALAVA> ;
    skos:broader
        rockname:BA ,
        rockname:LAVA ;
    skos:definition "Lava, basalt"@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
