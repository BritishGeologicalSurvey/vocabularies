    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PS_ISSR> ;
    skos:broader rockname:PS_SSR ;
    skos:definition "Iron-sediment and ironstone - In the Rock Classification Scheme, these are defined as those sediments and sedimentary rocks which have more than 50% iron-bearing minerals (ironstones should have greater than 15% wt. iron). British Geological Survey Research Report RR/99/03, section 5 and fig. 9."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
