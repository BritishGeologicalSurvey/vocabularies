rockname:WEBS
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WEBS> ;
    skos:broader rockname:PXTSS ;
    skos:definition "Websterite - A type of pyroxenite (s.s.) in which orthopyroxene and clinopyroxene are both present in significant proportion. In the Rock Classification Scheme, it is a pyroxenite with olivine <5%, clinopyroxene 5 - 90% and orthopyroxene 5 - 90% of olivine + orthopyroxene + clinopyroxene. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 15, 16."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WEBS"@en ;
    skos:prefLabel "Websterite"@en ;
.

rockname:WEHRL
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WEHRL> ;
    skos:broader rockname:PXPRD ;
    skos:definition "Wehrlite - A type of pyroxene-peridotite. In the Rock Classification Scheme, it is a pyroxene-peridotite with olivine 40 - 90%, clinopyroxene 5 - 60% and orthopyroxene <5% of olivine + orthopyroxene + clinopyroxene. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 15, 16."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WEHRL"@en ;
    skos:prefLabel "Wehrlite"@en ;
.

