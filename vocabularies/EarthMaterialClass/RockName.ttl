rockname:CALSIR
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/CALSIR> ;
    skos:broader rockname:MRCCBM ;
    skos:definition "Calcsilicate-rock - A type of metasedimentary rock composed largely of calcsilicate and/or carbonate minerals. In the Rock Classification Scheme, it is one in which the modal calcsilicate mineral content exceeds the modal abundance of carbonate minerals. British Geological Survey Research Report RR/99/02, section 3.2 and fig. 7."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:CALGNF ,
        rockname:CALSCH ,
        rockname:CALSGN ,
        rockname:CALSMY ,
        rockname:PAMPHB ;
    skos:notation "CALSIR"@en ;
    skos:prefLabel "Calcsilicate-rock"@en ;
.

