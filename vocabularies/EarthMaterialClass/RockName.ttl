rockname:DSSA
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/DSSA> ;
    skos:broader rockname:DLSD ;
    skos:definition "Dolomite-sand - A type of dolomite-sediment. In the Rock Classification Scheme, it is one in which clasts are predominantly 32 µm to 2 mm, with less than 75% of the clasts smaller than 32 µm and less than 25% larger than 2 mm. The grain size classes are defined in the same way as the siliciclastic sediments. British Geological Survey Research Report RR/99/03, section 3.2, table 6 and fig. 7. See also: silicate-sand."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "DSSA"@en ;
    skos:prefLabel "Dolomite-sand"@en ;
.

