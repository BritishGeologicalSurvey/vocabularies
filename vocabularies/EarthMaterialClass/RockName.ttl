rockname:BLTPH
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/BLTPH> ;
    skos:broader rockname:PYRSD ;
    skos:definition "Block-tephra - A type of pyroclastic-sediment. In the Rock Classification Scheme, it is a pyroclastic-sediment in which the average size of more than 75% of the pyroclastic fragments exceeds 64 mm. Block-tephra, bomb-block-tephra, block-bomb-tephra, and bomb-tephra are separated according to the relative proportion of blocks (angular fragments exceeding 64 mm) and bombs (rounded fragments exceeding 64 mm): if more than 75% of all pyroclastic fragments bigger than 64 mm are blocks the sediment is block-tephra. It is the unconsolidated equivalent of pyroclastic-breccia. British Geological Survey Research Report RR/99/06, section 4.2 and fig. 4."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "BLTPH"@en ;
    skos:prefLabel "Block-tephra"@en ;
.

