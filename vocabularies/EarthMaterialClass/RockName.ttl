    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PS_RSSR> ;
    skos:broader rockname:PS_SSSR ;
    skos:definition "Siliciclastic rudaceous sediment and rock - In the Rock Classification Scheme, this class includes siliciclastic rudaceous sediment and siliciclastic rudaceous rock. British Geological Survey Research Report RR/99/03, section 2.1 and fig. 2."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
