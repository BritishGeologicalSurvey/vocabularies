rockname:MZGAB
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/MZGAB> ;
    skos:broader rockname:GBR ;
    skos:definition "Monzogabbro - A type of gabbroic-rock. In the Rock Classification Scheme, it is a coarse-grained crystalline igneous rock whose mineral mode plots in field 9 of the quartz - alkali feldspar - plagioclase - feldspathoid (QAPF) diagram. Monzodiorite and monzogabbro are separated according to the average composition of their plagioclase: if An (the anorthite content of plagioclase) is greater than 50% the rock is monzogabbro. British Geological Survey Research Report RR/99/06, section 5.1 and figs. 9, 11, 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "MZGAB"@en ;
    skos:prefLabel "Monzogabbro"@en ;
.

