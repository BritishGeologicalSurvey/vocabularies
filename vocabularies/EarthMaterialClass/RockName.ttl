    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/PS_SNCS> ;
    skos:broader rockname:PS_SSR ;
    skos:definition "Sedimentary rock and sediment composed of non-carbonate salts - In the Rock Classification Scheme, this is a non-genetic term for what are commonly called evaporite minerals. Non-carbonate salts are commonly present in a host rock. The host rock may consist of other non-carbonate salts or other types of sediment. British Geological Survey Research Report RR/99/03, section 7 and fig. 11."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower rockname:NSLT ;
    skos:notation "+*SNCS"@en ;
    skos:prefLabel "Sedimentary rock and sediment composed of non-carbonate salts"@en ;
.

