        rockname:LMPYFO ,
        rockname:MINET ,
        rockname:MONCHQ ,
        rockname:SANN ,
        rockname:SPESS ,
        rockname:VOGS ;
    skos:notation "LMPY"@en ;
    skos:prefLabel "Lamprophyre"@en ;
.

