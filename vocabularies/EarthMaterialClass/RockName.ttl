    skos:notation "WOODU"@en ;
    skos:prefLabel "Wood"@en ;
.

rockname:WRCI
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCI> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade I rock - A type of weathered rock. Fresh, no visible sign of rock material weathering. Perhaps slight discolouration on major discontinuity surfaces. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCI"@en ;
    skos:prefLabel "Weathered-grade I rock"@en ;
.

rockname:WRCII
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCII> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade II rock - A type of weathered rock. Slightly weathered. Discolouration indicates weathering of rock material and discontinuity surfaces. All the rock material may be discoloured by weathering. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCII"@en ;
    skos:prefLabel "Weathered-grade II rock"@en ;
.

rockname:WRCIII
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCIII> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade III rock - A type of weathered rock. Moderately weathered. Less than half of the rock material is decomposed or disintegrated to a soil. Fresh or discoloured rock is present either as a continuous framework or as corestones. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCIII"@en ;
    skos:prefLabel "Weathered-grade III rock"@en ;
.

rockname:WRCIV
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCIV> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade IV rock - A type of weathered rock. Highly weathered. More than half of the rock material is decomposed or disintegrated to a soil. Fresh or discoloured rock is present either as a continuous framework or as corestones. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCIV"@en ;
    skos:prefLabel "Weathered-grade IV rock"@en ;
.

rockname:WRCV
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCV> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade V rock - A type of weathered rock. Completely weathered. All rock material is decomposed and/or disintegrated to soil. The original mass structure is still largely intact. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCV"@en ;
    skos:prefLabel "Weathered-grade V rock"@en ;
.

rockname:WRCVI
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/WRCVI> ;
    skos:broader rockname:WRC ;
    skos:definition "Weathered-grade VI rock - A type of weathered rock. Residual soil. All rock material is converted to soil. The mass structure and material fabric are destroyed. There is a large change in volume, but the soil has not been significantly transported. British Geological Survey Research Report RR/99/04, table 12."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "WRCVI"@en ;
    skos:prefLabel "Weathered-grade VI rock"@en ;
.

