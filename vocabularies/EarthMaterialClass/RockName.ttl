    skos:broader rockname:PHT_TEX ;
    skos:definition "Granitic-rock, gneissose"@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:GDGNS ,
        rockname:GNGNS ,
        rockname:GNSGA ;
    skos:notation "GGNR"@en ;
    skos:prefLabel "Gneissose granitic-rock"@en ;
.

rockname:GNM
    a skos:Concept ;
