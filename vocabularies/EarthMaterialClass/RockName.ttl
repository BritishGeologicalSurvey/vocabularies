    skos:broader rockname:LMSD ;
    skos:definition "Lime-mud - A type of lime-sediment. In the Rock Classification Scheme, it is a lime-sediment in which over 75% of the clasts are smaller than 32 µm. The grain size classes are defined in the same way as the siliciclastic sediments. British Geological Survey Research Report RR/99/03, section 3.1, table 2 and fig. 6. See also: silicate-mud."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ARMUD ,
        rockname:CAMUD ;
    skos:notation "LMMUD"@en ;
    skos:prefLabel "Lime-mud"@en ;
