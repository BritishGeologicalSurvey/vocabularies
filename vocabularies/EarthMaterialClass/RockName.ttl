    skos:broader rockname:SCOAL ;
    skos:definition "Boghead-cannel-coal - A type of sapropelic-coal. It is a transitional stage between cannel-coal and boghead-coal in which miospores dominate over alginite. British Geological Survey Research Report RR/99/03, section 6.2 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "BGCCOL"@en ;
    skos:prefLabel "Boghead-cannel-coal"@en ;
