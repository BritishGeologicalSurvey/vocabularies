rockname:ANTHRA
    a skos:Concept ;
    dcterms:source "http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    owl:sameAs <http://data.bgs.ac.uk/id/EarthMaterialClass/RockClassAll/ANTHRA> ;
    skos:broader rockname:COAL ;
    skos:definition "Anthracite - A type of coal. It is a member of the pure humic coal series. The members of the pure humic coal series can be ranked in order as peat (the unlithified form), lignite, bituminous-coal, and anthracite (the lithified forms) based on increasing carbon content and decreasing volatile content. Anthracite is a hard black coal with a semi-metallic lustre and semiconchoidal fracture. It ignites with difficulty and burns without smoke. British Geological Survey Research Report RR/99/03, section 6.1, table 16 and fig. 10."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:notation "ANTHRA"@en ;
    skos:prefLabel "Anthracite"@en ;
.

