    skos:broader rockname:PH_MET ;
    skos:definition "Metavolcaniclastic rock - In the Rock Classification Scheme, a rock is classified within this category if it is known to be a metamorphic rock derived from a volcaniclastic protolith. British Geological Survey Research Report RR/99/02, section 4 and fig. 1."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
