    skos:broader rockname:PS_SSSR ;
    skos:definition "Siliciclastic arenaceous sediment and rock - In the Rock Classification Scheme, this class includes siliciclastic arenaceous sediment and siliciclastic arenaceous rock. British Geological Survey Research Report RR/99/03, section 2.2 and fig. 3."@en ;
    skos:inScheme <http://data.bgs.ac.uk/ref/EarthMaterialClass/RockName> ;
    skos:narrower
        rockname:ARENR ,
        rockname:SARS ;
    skos:notation "+*SARS"@en ;
    skos:prefLabel "Siliciclastic arenaceous sediment and rock"@en ;
.

