reg-statuses:addition
    a
        reg:Status ,
        skos:Concept ;
    skos:broader reg-statuses:stable ;
    skos:definition "The item's status is stable and was supplied to the register after its creation"@en ;
    skos:inScheme def:reg-statuses ;
    skos:prefLabel "addition"@en ;
    skos:scopeNote "Stable and usable. An addition to original register issue" ;
    schema:color "#4ac11b" ;
