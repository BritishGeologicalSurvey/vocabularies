reg-statuses:invalid
    a
        reg:Status ,
        skos:Concept ;
    owl:sameAs reg:statusInvalid ;
    skos:broader reg-statuses:notAccepted ;
    skos:definition "An entry which has been invalidated due to serious flaws, distinct from retrirement."@en ;
    skos:inScheme def:reg-statuses ;
    skos:prefLabel "invalid"@en ;
    skos:scopeNote "Not approved for use: invalid" ;
    schema:color "#ea3c2c" ;
.

reg-statuses:original
    a
        reg:Status ,
        skos:Concept ;
    skos:broader reg-statuses:stable ;
    skos:definition "The item's status is stable and was supplied to the registry after initial creation."@en ;
    skos:inScheme def:reg-statuses ;
    skos:prefLabel "original"@en ;
    skos:scopeNote "Stable and usable. Created at initial register issue" ;
    schema:color "#38a30e" ;
.

reg-statuses:reserved
    a
        reg:Status ,
        skos:Concept ;
    owl:sameAs reg:statusReserved ;
    skos:broader reg-statuses:notAccepted ;
    skos:definition "A reserved entry allocated for some as yet undetermined future use."@en ;
    skos:inScheme def:reg-statuses ;
    skos:prefLabel "reserved"@en ;
    skos:scopeNote "Placeholder: not yet approved for use" ;
