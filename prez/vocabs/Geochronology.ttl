    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QH ;
    skos:definition "Meghalayan Age is a division of geological time within the Quaternary Period. It is the last of three ages within the Holocene Epoch. It is preceded by the Northgrippian Age (Geologic Time Scale 2020, figs. 2.1, 30.1; https://timescalefoundation.org/)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QHL"@en ;
    skos:prefLabel "Meghalayan Age"@en ;
.

division:QHM
    a skos:Concept ;
    rdfs:label "Northgrippian Age"@en ;
