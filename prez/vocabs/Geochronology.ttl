    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:CW ;
    skos:definition "Asturian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the last of four substages of the Westphalian Stage. It is preceded by the Bolsovian Substage and succeeded by the Cantabrian Substage (Stephanian Stage) (Geologic Time Scale 2020, fig. 23.5). Replaces: Westphalian Substage D."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "CAS"@en ;
    skos:prefLabel "Asturian Substage"@en ;
.

