division:QHE
    a skos:Concept ;
    rdfs:label "Greenlandian Age"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/AGE> ;
    geochronology:maxAgeValue 1.18e-02 ;
    geochronology:minAgeValue 8.236e-03 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QH ;
    skos:definition "Greenlandian Age is a division of geological time within the Quaternary Period. It is the first of three ages within the Holocene Epoch. It is preceded by the Upper Pleistocene Age (Pleistocene Epoch) and succeeded by the Northgrippian Age (Geologic Time Scale 2020, figs. 2.1, 30.1; https://timescalefoundation.org/)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QHE"@en ;
    skos:prefLabel "Greenlandian Age"@en ;
.

division:QHL
