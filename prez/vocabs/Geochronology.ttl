    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QH ;
    skos:definition "Northgrippian Age is a division of geological time within the Quaternary Period. It is the second of three ages within the Holocene Epoch. It is preceded by the Greenlandian Age and succeeded by the Meghalayan Age (Geologic Time Scale 2020, figs. 2.1, 30.1; https://timescalefoundation.org/)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QHM"@en ;
    skos:prefLabel "Northgrippian Age"@en ;
.

division:QI
    a skos:Concept ;
    rdfs:label "Ipswichian Stage"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 1.26e-01 ;
    geochronology:minAgeValue 1.16e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Ipswichian> ;
    skos:broader division:QPL ;
    skos:definition "Ipswichian Stage is a Late Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Wolstonian Stage and succeeded by the Devensian Stage. It is contemporaneous with the Eemian Stage of NW Europe, and with Marine Isotope Stage 5e (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the town of Ipswich, Suffolk, England."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QI"@en ;
    skos:prefLabel "Ipswichian Stage"@en ;
.

division:QL
    a skos:Concept ;
    rdfs:label "Ludhamian Stage"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 2.42e+00 ;
    geochronology:minAgeValue 2.27e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QPE ;
    skos:definition "Ludhamian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Pre-Ludhamian Stage and succeeded by the Thurnian Stage. It is contemporaneous with Tiglian Substage A of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the town of Ludham, England."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QL"@en ;
    skos:prefLabel "Ludhamian Stage"@en ;
.

