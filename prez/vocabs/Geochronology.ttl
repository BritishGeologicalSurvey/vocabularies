    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        division:QPE ,
        division:QPM ;
    skos:definition "Cromerian Complex is an Early-to-Mid Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Bavelian Stage and succeeded by the Elsterian Stage. It is contemporanerous with the Cromerian Stage in Great Britain, and with marine isotope stages 13-21 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "BC"@en ;
    skos:prefLabel "Cromerian Complex"@en ;
