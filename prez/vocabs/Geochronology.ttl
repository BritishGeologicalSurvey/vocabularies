    rdfs:seeAlso <http://dbpedia.org/resource/Anglian_Stage> ;
    skos:broader division:QPM ;
    skos:definition "Anglian Stage is a Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Cromerian Stage and succeeded by the Hoxnian Stage. It is contemporaneous with the Elsterian Stage of NW Europe, and with Marine Isotope Stage 12 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QA"@en ;
    skos:prefLabel "Anglian Stage"@en ;
.

division:QB
    a skos:Concept ;
    rdfs:label "Beestonian Stage"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 1.78e+00 ;
    geochronology:minAgeValue 8.6e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Beestonian_stage> ;
    skos:broader division:QPE ;
    skos:definition "Beestonian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Pastonian Stage and succeeded by the Cromerian Stage. It is contemporaneous with the Eburonian to Bavelian stages of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Beeston, Norfolk, England."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QB"@en ;
    skos:prefLabel "Beestonian Stage"@en ;
.

division:QDD
    a skos:Concept ;
    rdfs:label "Dimlington Stadial"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/SUBSTAGE> ;
    geochronology:maxAgeValue 2.6e-02 ;
    geochronology:minAgeValue 1.47e-02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QD ;
    skos:definition "Dimlington Stadial is a relatively cold period near the end of the Devensian Stage. It is succeeded by the Windermere Interstadial (BGS Research Report RR/10/003, table 1b; BGS British Regional Geology: Northern England (Fifth edition), fig. 64)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QDD"@en ;
    skos:prefLabel "Dimlington Stadial"@en ;
.

