division:OH
    a skos:Concept ;
    rdfs:label "Hirnantian Age"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/AGE> ;
    geochronology:maxAgeValue 4.452e+02 ;
    geochronology:minAgeValue 4.431e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Hirnantian> ;
    skos:broader
        division:OA ,
        division:OLA ;
    skos:definition "Hirnantian Age is a division of geological time within the Ordovician Period. It is the last of the three ages within the Late Ordovician Epoch. It is preceded by the Katian Age and succeeded by the Rhuddanian Age (Silurian Period). The Hirnantian Stage is also the last of four stages in the Ashgill Series in the British regional Ordovician stratigraphic scheme. It is preceded by the Rawtheyan Stage (Geologic Time Scale 2020, figs. 2.1, 20.1, 20.12; https://timescalefoundation.org/)."@en ;
    skos:exactMatch
        <http://resource.geosciml.org/classifier/ics/ischart/Hirnantian> ,
        <https://inspire.ec.europa.eu/codelist/GeochronologicEraValue/hirnantian> ;
    skos:inScheme geochronology:Division ;
    skos:notation "OH"@en ;
    skos:prefLabel "Hirnantian Age"@en ;
    schema:color "#A6DBAB" ;
.

division:QC
    a skos:Concept ;
    rdfs:label "Cromerian Stage"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 8.6e-01 ;
    geochronology:minAgeValue 4.8e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader
        division:QPE ,
        division:QPM ;
    skos:definition "Cromerian Stage is an Early-to-Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Beestonian Stage and succeeded by the Anglian Stage. It is contemporaneous with the Cromerian Complex of NW Europe, and with marine isotope stages 13-21 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QC"@en ;
    skos:prefLabel "Cromerian Stage"@en ;
.

