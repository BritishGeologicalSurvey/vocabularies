division:QA
    a skos:Concept ;
    rdfs:label "Anglian Stage"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 4.8e-01 ;
    geochronology:minAgeValue 4.23e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
