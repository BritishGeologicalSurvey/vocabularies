division:OC
    a skos:Concept ;
    rdfs:label "Caradoc Series [Historical British usage]"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/SERIES> ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Ordovician> ;
    skos:definition "Prior to revision of the Ordovician series and stages in the type area of England and Wales by Fortey et al. (1995), the base of the Caradoc Series was considered to be at a much higher stratigraphic level, approximating to the base of the Costonian Stage. This is now a deprecated definition of the Caradoc Series, approximately equating to the modern Costonian Substage - Onnian Substage interval (Fortey et al., 1995, fig. 1)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "OC"@en ;
    skos:prefLabel "Caradoc Series [Historical British usage]"@en ;
.

