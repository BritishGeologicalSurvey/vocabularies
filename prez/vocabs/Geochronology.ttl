division:N1
    a skos:Concept ;
    rdfs:label "Neogene Period [Pre-2009 definition]"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/PERIOD> ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Neogene> ;
    skos:definition "Prior to the 2009 decision by the International Union of Geological Sciences (IUGS) to place the base of the Quaternary Period at a level coinciding with the base of the Gelasian Age, the Neogene Period was considered to include the Gelasian Age and to have an upper boundary at approximately 1.8 Ma BP. This is now a deprecated definition and equates to the modern Neogene Period - Gelasian Age interval (Geologic Time Scale 2020, fig. 30.1)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "N1"@en ;
    skos:prefLabel "Neogene Period [Pre-2009 definition]"@en ;
.

