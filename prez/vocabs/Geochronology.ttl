    geochronology:maxAgeValue 4.23e-01 ;
    geochronology:minAgeValue 3.62e-01 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Hoxnian_Stage> ;
    skos:broader division:QPM ;
    skos:definition "Hoxnian Stage is a Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Anglian Stage and succeeded by the Wolstonian Stage. It is contemporaneous with the Holsteinian Stage of NW Europe, and with Marine Isotope Stage 11 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Hoxne, Suffolk, England."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QX"@en ;
    skos:prefLabel "Hoxnian Stage"@en ;
.

division:SA
    a skos:Concept ;
    rdfs:label "Aeronian Age"@en ;
    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/AGE> ;
    geochronology:maxAgeValue 4.405e+02 ;
    geochronology:minAgeValue 4.386e+02 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Silurian> ;
    skos:broader division:SL ;
    skos:definition "Aeronian Age is a division of geological time within the Silurian Period. It is the second of the three ages within the Llandovery Epoch. It is preceded by the Rhuddanian Age and succeeded by the Telychian Age (Geologic Time Scale 2020, figs. 2.1, 21.1; https://timescalefoundation.org/)."@en ;
    skos:exactMatch
        <http://resource.geosciml.org/classifier/ics/ischart/Aeronian> ,
        <https://inspire.ec.europa.eu/codelist/GeochronologicEraValue/aeronian> ;
    skos:inScheme geochronology:Division ;
    skos:notation "SA"@en ;
    skos:prefLabel "Aeronian Age"@en ;
    schema:color "#B3E1C2" ;
.

