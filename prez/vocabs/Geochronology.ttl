    geochronology:hasGeochronologyRank <http://data.bgs.ac.uk/id/Geochronology/Rank/STAGE> ;
    geochronology:maxAgeValue 2e+00 ;
    geochronology:minAgeValue 1.82e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QPE ;
    skos:definition "Pre-Pastonian/Baventian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Antian/Bramertonian Stage and succeeded by the Pastonian Stage. It is contemporaneous with Tiglian Substage C4c of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). Replaces: Baventian Stage."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QV"@en ;
    skos:prefLabel "Pre-Pastonian/Baventian Stage"@en ;
.

division:QX
