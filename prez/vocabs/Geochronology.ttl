    geochronology:maxAgeValue 2.58e+00 ;
    geochronology:minAgeValue 2.42e+00 ;
    dcterms:source "http://data.bgs.ac.uk/ref/Geochronology/Division"^^xsd:anyURI ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QPE ;
    skos:definition "Pre-Ludhamian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is succeeded by the Ludhamian Stage. It is contemporaneous with Marine Isotope Stage 96 and greater (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "QR"@en ;
    skos:prefLabel "Pre-Ludhamian Stage"@en ;
.

division:QS
    a skos:Concept ;
