    reg:status <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    rdfs:seeAlso <http://dbpedia.org/resource/Ordovician> ;
    skos:definition "Llandeilo Series is a deprecated term, a British regional Ordovician series approximately equating to the modern Llandeilian Stage - Velfreyan Substage interval (Fortey et al., 1995, fig. 1)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "OD"@en ;
    skos:prefLabel "Llandeilo Series [Historical British usage]"@en ;
