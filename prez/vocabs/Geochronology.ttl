    reg:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    skos:broader division:QPE ;
    skos:definition "Eburonian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Tiglian Stage and succeeded by the Waalian Stage. It is contemporaneous with the early part of the Beestonian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:inScheme geochronology:Division ;
    skos:notation "BE"@en ;
    skos:prefLabel "Eburonian Stage"@en ;
.

