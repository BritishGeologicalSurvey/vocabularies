qb:order
    rdfs:label "order"@en ;
    rdfs:comment "Indicates a priority order for the components of sets with this structure, used to guide presentations - lower order numbers come before higher numbers, un-numbered components come last."@en ;
.

reg:Status
    skos:definition "Open set of status code for entries in a register"@en ;
    skos:prefLabel "Status"@en ;
.

reg:status
    rdfs:label "Status"@en ;
    rdfs:comment "The status of this register entry"@en ;
.

<http://schema.org/color>
    rdfs:label "Color"@en ;
    rdfs:comment "The color of the product."@en ;
.

<http://schema.org/latitude>
    rdfs:label "Latitude"@en ;
    rdfs:comment "The latitude of a location. For example <code>37.42242</code> https://en.wikipedia.org/wiki/World_Geodetic_System (WGS 84)."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
    sh:order "5020" ;
.

<http://schema.org/longitude>
    rdfs:label "Longitude"@en ;
    rdfs:comment "The longitude of a location. For example <code>-122.08585</code> https://en.wikipedia.org/wiki/World_Geodetic_System (WGS 84)."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
    sh:order "5021" ;
.

<http://vocabulary.odm2.org/samplingfeaturetype/borehole>
    rdfs:label "Borehole"@en ;
.

rdf:resource
    rdfs:label "Resource"@en ;
    rdfs:comment "Sets the object URI of a statement, which may be absolute or resolved relative to the base href of the document"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdf:type
    rdfs:label "Type"@en ;
    rdfs:comment "Identifies the Class of a resource. The target of an rdf:type arc must be an instance of rdfs:Class."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdf:value
    rdfs:label "Value"@en ;
    rdfs:comment "Identifies the principal value (usually a string) of a property."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
    sh:order "3000" ;
.

rdfs:Class
    rdfs:label "Class"@en ;
    rdfs:comment "The concept of Class"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdfs:Resource
    rdfs:label "Resource"@en ;
    rdfs:comment "All things described by RDF are called resources, and are instances of the class rdfs:Resource. This is the class of everything. "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdfs:comment
    rdfs:label "Comment"@en ;
    rdfs:comment "This is used to provide a human-readable description of a resource."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
    sh:order "3000" ;
.

rdfs:isDefinedBy
    rdfs:label "Is Defined By"@en ;
    rdfs:comment "Indicates a resource containing and defining the subject resource. The target of an rdfs:isDefinedBy arc must be a Resource."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdfs:label
    rdfs:label "Label"@en ;
    rdfs:comment "Short label for user display"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

rdfs:range
    rdfs:label "Range"@en ;
    rdfs:comment "States that the VALUES of a property are instances of one or more classes."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdfs:seeAlso
    rdfs:label "See Also"@en ;
    rdfs:comment "Indicates a resource that provides information about the subject. The object must be a resource."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
    sh:order "15000" ;
.

rdfs:subPropertyOf
    rdfs:label "Sub Property Of"@en ;
    rdfs:comment "Defines that the property is a subproperty of some other property"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

rdfs:type
    rdfs:label "Type"@en ;
    rdfs:comment "Object is of type {schema}"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

owl:DatatypeProperty
    rdfs:label "Data Type Property"@en ;
    rdfs:comment "Link individuals to data VALUES."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

owl:DeprecatedClass
    rdfs:label "Deprecated Class"@en ;
    rdfs:comment "The term should not be used in new documents that commit to the ontology; it is preserved for backward-compatibility purposes, but may be phased out in the future"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

owl:ObjectProperty
    rdfs:label "Object Property"@en ;
    rdfs:comment "Link individuals to individuals"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

owl:inverseOf
    rdfs:label "Inverse Of"@en ;
    rdfs:comment "Indicates that a predicate has an inverse predicate"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

owl:sameAs
    rdfs:label "Same As"@en ;
    rdfs:comment "Indicates that two URI references actually refer to the same thing: the individuals have the same identity. "@en ;
    owl:inverseOf "http://www.w3.org/2002/07/owl#sameAs"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
    sh:order "15000" ;
.

<http://www.w3.org/2003/01/geo/wgs84_pos#lat>
    rdfs:label "Latitude"@en ;
    rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
    sh:order "5031" ;
.

<http://www.w3.org/2003/01/geo/wgs84_pos#long>
    rdfs:label "Longitude"@en ;
    rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
    sh:order "5030" ;
.

skos:Concept
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea or notion; a unit of thought"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "6000" ;
.

skos:ConceptScheme
    rdfs:label "Concept Scheme"@en ;
    rdfs:comment "An aggregation of one or more SKOS concepts"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "6000" ;
.

skos:OrderedCollection
    rdfs:label "Ordered Collection"@en ;
    rdfs:comment "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:TopConcept
    rdfs:label "top concept"@en ;
    rdfs:comment "represent the fact that the concept is intended to sit at the top of the concept hierarchy"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:altLabel
    rdfs:label "alternate label"@en ;
    rdfs:comment "Alternate label - not usually displayed"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
    sh:order "1000" ;
.

skos:broadMatch
    rdfs:label "has broad match"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - incompatible with 'skos:exactMatch'"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#narrowMatch"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:broader
    rdfs:label "has broader"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - direct parents only"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#narrower"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:broaderTransitive
    rdfs:label "has broader transitive"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - direct parents only"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#narrowerTransitive"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:changeNote
    rdfs:label "change note"@en ;
    rdfs:comment "Documents fine-grained changes to a concept, for the purposes of administration and maintenance"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
    sh:order "14000" ;
.

skos:closeMatch
    rdfs:label "has close match"@en ;
    rdfs:comment "Two concepts are sufficiently similar that they can be used interchangeably in some information retrieval applications."@en ;
.

skos:definition
    rdfs:label "definition"@en ;
    rdfs:comment "A complete explanation of the intended meaning of a concept"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
    sh:order "3000" ;
.

skos:editorialNote
    rdfs:label "editorial note"@en ;
    rdfs:comment "Information that is an aid to administrative housekeeping, such as reminders of editorial work still to be done, or warnings in the event that future editorial changes might be made"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
    sh:order "14000" ;
.

skos:exactMatch
    rdfs:label "exact match"@en ;
    rdfs:comment "Two concepts are sufficiently similar that they can be used interchangeably - incompatible with 'skos:broadMatch' & 'skos:narrowMatch'"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#exactMatch"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
    sh:order "15000" ;
.

skos:example
    rdfs:label "example"@en ;
    rdfs:comment "An example of the use of a concept"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
    sh:order "3000" ;
.

skos:externalID
    rdfs:label "external id"@en ;
    rdfs:comment "link to a non-URI unique identifier"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

skos:hasTopConcept
    rdfs:label "has top concept"@en ;
    rdfs:comment "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#topConceptOf"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:hiddenLabel
    rdfs:label "hidden label"@en ;
    rdfs:comment "Hidden label - not displayed"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

skos:historyNote
    rdfs:label "history note"@en ;
    rdfs:comment "Describes significant changes to the meaning or the form of a concept"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
    sh:order "14000" ;
.

skos:inScheme
    rdfs:label "in scheme"@en ;
    rdfs:comment "express that a concept is a part of a scheme"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:member
    rdfs:label "has member"@en ;
    rdfs:comment "Has Member"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "1000" ;
.

skos:narrowMatch
    rdfs:label "has narrow match"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - incompatible with 'skos:exactMatch'"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#broadMatch"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:narrower
    rdfs:label "has narrower"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - direct children only"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#broader"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:narrowerTransitive
    rdfs:label "has narrower transitive"@en ;
    rdfs:comment "Hierarchical mapping link between two concepts - direct children only"@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#broaderTransitive"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

skos:notation
    rdfs:label "notation"@en ;
    rdfs:comment "A notation is a string of characters such as T58.5 or 303.4833 used to uniquely identify a concept within the scope of a given concept scheme"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

skos:note
    rdfs:label "note"@en ;
    rdfs:comment "Notes are used to provide information relating to SKOS concepts. There is no restriction on the nature of this information, e.g., it could be plain text, hypertext, or an image; it could be a definition, information about the scope of a concept, editorial information, or any other type of information."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
    sh:order "3000" ;
.

skos:prefLabel
    rdfs:label "preferred label"@en ;
    rdfs:comment "Short label for user display"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

skos:related
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
    sh:order "15000" ;
.

skos:relatedMatch
    rdfs:label "has related"@en ;
    rdfs:comment "An associative mapping link between two conceptual resources in different concept schemes"@en ;
.

skos:scopeNote
    rdfs:label "scope note"@en ;
    rdfs:comment "Some, possibly partial, information about the intended meaning of a concept, especially as an indication of how the use of a concept is limited in indexing practice."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
    sh:order "14000" ;
.

skos:topConceptOf
    rdfs:label "top concept of"@en ;
    rdfs:comment "Relates a concept to the concept scheme that it is a top level concept of."@en ;
    owl:inverseOf "http://www.w3.org/2004/02/skos/core#hasTopConcept"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6000" ;
.

dcat:landingPage
    rdfs:label "Landing Page"@en ;
    rdfs:comment "A Web page that can be navigated to in a Web browser to gain access to the catalog, a dataset, its distributions and/or additional information."@en ;
.

odrl:Action
    rdfs:label "Action"@en ;
.

org:Organization
    rdfs:label "Organization"@en ;
.

org:subOrganizationOf
    rdfs:label
        "sub-organization of"@en ,
        "subOrganization of"@en ;
    rdfs:comment "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an organization which is a sub-part or child of this organization."@en ;
.

sh:group
    rdfs:label "Group"@en ;
    rdfs:comment "A link to a group of related properties for display purposes"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "6000" ;
.

sh:order
    rdfs:label "Order"@en ;
    rdfs:comment "Relative order of the property or property group for display purposes such as form building"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "6000" ;
.

foaf:Organization
    rdfs:label "Organization"@en ;
.

foaf:Project
    rdfs:label "Project"@en ;
    rdfs:comment "A project (a collective endeavour of some kind)."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CON> ;
    sh:order "12000" ;
.

foaf:based_near
    rdfs:label "Based Near"@en ;
    rdfs:comment "A location that something is based near, for some broadly human notion of near."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
    sh:order "5000" ;
.

foaf:depiction
    rdfs:label "Depiction"@en ;
    rdfs:comment "A depiction of some thing. "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/IMG> ;
    sh:order "4000" ;
.

foaf:fundedBy
    rdfs:label "Funded By"@en ;
    rdfs:comment "An organization funding a project or person. "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/LIC> ;
    sh:order "11000" ;
.

foaf:homepage
    rdfs:label "Home page"@en ;
    rdfs:comment "A homepage for some thing."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DOC> ;
    sh:order "9000" ;
.

foaf:img
    rdfs:label "Image"@en ;
    rdfs:comment "An image that can be used to represent some thing (ie. those depictions which are particularly representative of something, eg. one's photo on a homepage). "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/IMG> ;
    sh:order "4000" ;
.

foaf:isPrimaryTopicOf
    rdfs:label "Primary Topic Of"@en ;
    rdfs:comment "A document that this thing is the primary topic of. "@en ;
    owl:inverseOf "http://xmlns.com/foaf/0.1/primaryTopic"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

foaf:logo
    rdfs:label "Logo"@en ;
    rdfs:comment "A logo representing some thing. "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/IMG> ;
    sh:order "4000" ;
.

foaf:mbox
    rdfs:label "Email"@en ;
    rdfs:comment "An e-mail mailbox"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CON> ;
    sh:order "12000" ;
.

foaf:member
    rdfs:label "Member"@en ;
    rdfs:comment "Indicates a member of a Group"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CON> ;
    sh:order "12000" ;
.

foaf:name
    rdfs:label "Name"@en ;
    rdfs:comment "Short label for user display"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "1000" ;
.

foaf:page
    rdfs:label "Page"@en ;
    rdfs:comment "A page or document about this thing. "@en ;
    owl:inverseOf "http://xmlns.com/foaf/0.1/topic"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DOC> ;
    sh:order "9000" ;
.

foaf:phone
    rdfs:label "Phone"@en ;
    rdfs:comment "A phone, specified using fully qualified tel: URI scheme (refs: http://www.w3.org/Addressing/schemes.html#tel). "@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CON> ;
    sh:order "12000" ;
.

foaf:primaryTopic
    rdfs:label "Primary Topic"@en ;
    rdfs:comment "The primary topic of some page or document. "@en ;
    owl:inverseOf "http://xmlns.com/foaf/0.1/isPrimaryTopicOf"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/CPT> ;
    sh:order "2000" ;
.

foaf:seeAlso
    rdfs:label "See Also"@en ;
    rdfs:comment "Indicates a resource that provides information about the subject. The object must be a resource."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
    sh:order "15000" ;
.

foaf:thumbnail
    rdfs:label "Thumbnail"@en ;
    rdfs:comment "A derived thumbnail image."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/IMG> ;
    sh:order "4000" ;
.

foaf:topic
    rdfs:label "Topic"@en ;
    rdfs:comment "Relates a document to a thing that the document is about. Inverse of the foaf:page property"@en ;
    owl:inverseOf "http://xmlns.com/foaf/0.1/page"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DOC> ;
    sh:order "9000" ;
.

<https://linked.data.gov.au/def/reg-statuses>
    skos:definition """This vocabulary is a re-published and only marginally changed version of the Registry Ontology's (http://epimorphics.com/public/vocabulary/Registry.html) *Status* vocabulary (online in RDF: http://purl.org/linked-data/registry). The only real change to content has been the addition of the term `unstable`. This re-publication has been performed to allow the IRIs of each vocab term (skos:Concept) to resolve to both human-readable and machine-readable forms of content (HTML and RDF), using HTTP content negotiation.

Note that just like the original form of this vocabulary, while it is a SKOS vocabulary implemented as a single skos:ConceptScheme, it is also an OWL Ontology and that each *Status* is both a skos:Concept and a reg:Status individual."""@en ;
    skos:prefLabel "Registry Status Vocabulary"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/accepted>
    skos:definition "An entry that has been accepted for use and is visible in the default register listing. Includes entries that have seen been retired or superseded."@en ;
    skos:prefLabel "accepted"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/addition>
    skos:definition "The item's status is stable and was supplied to the register after its creation"@en ;
    skos:prefLabel "addition"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/deprecated>
    skos:definition "An entry that has been Retired or Superseded or has become Unstable and is no longer to be used."@en ;
    skos:prefLabel "deprecated"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/experimental>
    skos:altLabel "provisional"@en ;
    skos:definition "An entry that has been accepted into the register temporarily and may be subject to change or withdrawal."@en ;
    skos:prefLabel "experimental"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/invalid>
    skos:definition "An entry which has been invalidated due to serious flaws, distinct from retrirement."@en ;
    skos:prefLabel "invalid"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/notAccepted>
    skos:definition "An entry that should not be visible in the default register listing."@en ;
    skos:prefLabel "notAccepted"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/original>
    skos:definition "The item's status is stable and was supplied to the registry after initial creation."@en ;
    skos:prefLabel "original"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/reserved>
    skos:definition "A reserved entry allocated for some as yet undetermined future use."@en ;
    skos:prefLabel "reserved"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/retired>
    skos:altLabel "withdrawn"@en ;
    skos:definition "An entry that has been withdrawn from use."@en ;
    skos:prefLabel "retired"@en ;
.

<https://linked.data.gov.au/def/reg-statuses/submitted>
