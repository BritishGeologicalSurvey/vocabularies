PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX reg: <http://purl.org/linked-data/registry#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/BGS>
    a sh:PropertyGroup ;
    sh:order "700" ;
.

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/BGSDM>
    a sh:PropertyGroup ;
    sh:order "1100" ;
.

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/BGSEMC>
    a sh:PropertyGroup ;
    sh:order "1200" ;
.

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/BGSGC>
    a sh:PropertyGroup ;
    sh:order "3000" ;
.

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/BGSLXN>
    a sh:PropertyGroup ;
    sh:order "4000" ;
.

<http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/GRP>
    a sh:PropertyGroup ;
    sh:order "550" ;
.

<http://data.bgs.ac.uk/ref/625KGeologyMap/hasColourRGB>
    rdfs:label "Map colour RGB"@en ;
    rdfs:comment "RGB Colour"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/625KGeologyMap/hasEarthMaterialClass>
    rdfs:label "BGS Earth Material Class"@en ;
    rdfs:comment "This property links to the Earth Material Class assigned to the geological map feature"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/625KGeologyMap/hasLexicon>
    rdfs:label "BGS Named Rock"@en ;
    rdfs:comment "This property links to the Lexicon of Named Rocks entry assigned to the geological map feature"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/625KGeologyMap/hasMapCode>
    rdfs:label "Map code"@en ;
    rdfs:comment "Map code"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/ID> ;
    sh:order "5000" ;
.

<http://data.bgs.ac.uk/ref/625KGeologyMap/hasRank>
    rdfs:label "Rank"@en ;
    rdfs:comment "Rank"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "6500" ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/componentRock>
    rdfs:label "rock type"@en ;
    rdfs:comment "This property is a link to the single lithology that defines this rock component"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/hasComponentNature>
    rdfs:label "form"@en ;
    rdfs:comment "This property describes the nature or form that a rock component part is observed within its parent composite material"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/hasComponentPart>
    rdfs:label "has component part"@en ;
    rdfs:comment "This property links a composite earth material class with a described component part"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/isComponentPartOf"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/hasComponentRank>
    rdfs:label "rank"@en ;
    rdfs:comment "This property describes the relative rank of a described component part in terms of volume compared to other components of the same composite material"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/isComponentPartOf>
    rdfs:label "is a component part of"@en ;
    rdfs:comment "This property links a described rock component part with the composite earth material class that it is a component of"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/hasComponentPart"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassMain>
    rdfs:label "sub type in main hierarchy"@en ;
    rdfs:comment "This property links an earth material class with a child sub class defined by the main BGS rock classification hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassMain"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassTAS>
    rdfs:label "sub type in Total Alkalis Versus Silica Classification hierarchy"@en ;
    rdfs:comment "This property links an earth material class with a child sub class defined by the Total Alkalis Versus Silica Classification hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassTAS"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassUDCS>
    rdfs:label "sub type in Unconsolidated Deposits Classification Scheme hierarchy"@en ;
    rdfs:comment "This property links an earth material class with a child sub class defined by the Unconsolidated Deposits Classification Scheme hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassUDCS"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassMain>
    rdfs:label "super type in main hierarchy"@en ;
    rdfs:comment "This property links an earth material class with its parent super-class as defined by the main BGS rock classification hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassMain"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassTAS>
    rdfs:label "super type in Unconsolidated Deposits Classification Scheme hierarchy"@en ;
    rdfs:comment "This property links an earth material class with its parent super-class as defined by the Total Alkalis Versus Silica Classification hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassTAS"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/EarthMaterialClass/superClassUDCS>
    rdfs:label "super type in Total Alkalis Versus Silica Classification hierarchy"@en ;
    rdfs:comment "This property links an earth material class with its parent super-class as defined by the Unconsolidated Deposits Classification Scheme hierarchy"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/EarthMaterialClass/subClassUDCS"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/ageDetermination>
    rdfs:label "age determination type"@en ;
    rdfs:comment "A property that describes the method by which the age has been determined."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/ageValue>
    rdfs:label "millions of years before present"@en ;
    rdfs:comment "A property that provides an age value in millions of years before present."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/ageValueUncertainty>
    rdfs:label "uncertainty (millions of years)"@en ;
    rdfs:comment "A property that provides the uncertainty on an age value in millions of years."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/divisionList>
    rdfs:label "Ordered list of divisions"@en ;
    rdfs:comment "Ordered list of divisions"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
    sh:order "1000" ;
.

<http://data.bgs.ac.uk/ref/Geochronology/end>
    rdfs:label "minimum age"@en ;
    rdfs:comment "A property linking to the latest date (ie minimum age) of a geological time division."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/hasDivisions>
    rdfs:label "has divisions"@en ;
    rdfs:comment "Ordered list of divisions"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/hasGeochronologyRank>
    rdfs:label "rank"@en ;
    rdfs:comment "This property indicates the rank of the geological time division that it describes."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/hasRanks>
    rdfs:label "has ranks"@en ;
    rdfs:comment "Ordered list of ranks"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/maxAgeValue>
    rdfs:label "maximum age in millions of years before present"@en ;
    rdfs:comment "A property that provides a maximum age value in millions of years before present."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/minAgeValue>
    rdfs:label "minimum age in millions of years before present"@en ;
    rdfs:comment "A property that provides a minimum age value in millions of years before present."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/olderDivisionOfSameRank>
    rdfs:label "previous division"@en ;
    rdfs:comment "This property links a geological division of time to the older division of the same rank so that it it is possible to put each time division in the correct order."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/rankInOrderedList>
    rdfs:label "in ordered list"@en ;
    rdfs:comment "This property links the name of a rank - a level of geological time division - to the ordered list of ranks that it is contained in. Ranks are ordered from the largest division level to the smallest."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/rankList>
    rdfs:label "Ordered list of ranks"@en ;
    rdfs:comment "Ordered list of ranks"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/start>
    rdfs:label "maximum age"@en ;
    rdfs:comment "A property linking to the earliest date (ie maximum age) of a geological time division."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/subDivisions>
    rdfs:label "subdivisions"@en ;
    rdfs:comment "Geological time is divided into multiple levels of sub-division. This property links a given division to an ordered lists of its immediate child divisions."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Geochronology/youngerDivisionOfSameRank>
    rdfs:label "next division"@en ;
    rdfs:comment "This property links a geological division of time to the younger one of the same rank so that it it is possible to put each time division in the correct order."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasBroaderPredominantAge>
    rdfs:label "has broader predominant age"@en ;
    rdfs:comment "The name of the broader predominant geological age of the rock, which is the predominant age generalised to either 'Precambrian' or the name of the relevant Phanerozoic period."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasDefinitionStatus>
    rdfs:label "has definition status"@en ;
    rdfs:comment "Property links to the status of the lexicon definition"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasFormality>
    rdfs:label "has formality"@en ;
    rdfs:comment "Property indicates if the lexicon entry is formal or informal"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasGeographicalDistribution>
    rdfs:label "has geographical distribution"@en ;
    rdfs:comment "Property describes the geographical distribution of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLateralEquivalent>
    rdfs:label "has lateral equivalent"@en ;
    rdfs:comment "Property links to a lexicon entry that is geographically laterally equivalent to this rock unit"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/hasLateralEquivalent"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLateralEquivalentRelationship>
    rdfs:label "lateral equivalent relationship"@en ;
    rdfs:comment "Property links to a relationship between this lexicon entry and one that is geographically laterally equivalent"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLithogenesis>
    rdfs:label "has lithogenesis"@en ;
    rdfs:comment "Property links to the lithogenetic type applicable to this rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLithogenesisDescription>
    rdfs:label "has lithogenesis description"@en ;
    rdfs:comment "Property describes the lithogenesis, environment of deposition or mode of origin of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLithologyComponent>
    rdfs:label "has lithology component"@en ;
    rdfs:comment "Property links to a lithological component of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLithologyDescription>
    rdfs:label "has lithology description"@en ;
    rdfs:comment "Property describes the lithology of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasLowerBoundaryDefinition>
    rdfs:label "has lower boundary definition"@en ;
    rdfs:comment "Property describes the lower boundary of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasMapNotation>
    rdfs:label "has map notation"@en ;
    rdfs:comment "The notation used on BGS geological maps and in the map legend, if different to the identifying notation code. In cases where a symbol is used on the BGS map (as for example drift or alluvium) then preferred map code takes the value symb."@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasObsoleteEquivalent>
    rdfs:label "has obsolete equivalent"@en ;
    rdfs:comment "Property links to an obsolete lexicon entry that the current entry replaces"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/isObsoleteEquivalentOf"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasObsoleteEquivalentRelationship>
    rdfs:label "obsolete equivalent relationship"@en ;
    rdfs:comment "Property links to a relationship between this lexicon entry and one that it replaces"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasOldestAge>
    rdfs:label "has oldest age"@en ;
    rdfs:comment "Property links to the oldest geological age of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasOldestAgeValue>
    rdfs:label "has oldest age value"@en ;
    rdfs:comment "Property describes the oldest age of the rock unit in millions of years before the present (Ma)"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasPredominantAge>
    rdfs:label "has predominant age"@en ;
    rdfs:comment "Property links to the predominant geological age of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasRevisionNumber>
    rdfs:label "has revision number"@en ;
    rdfs:comment "The revision number of the resource."@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/NOTE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasRockUnitRank>
    rdfs:label "has rock unit rank"@en ;
    rdfs:comment "Property links to the rank of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasShapeType>
    rdfs:label "has shape type"@en ;
    rdfs:comment "Property links to the type of shape that the rock unit takes in the ground"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasSourceInfo>
    rdfs:label "has reference source info"@en ;
    rdfs:comment "Property links to a SourceInfo resource which describes reference source information used for a lexicon entry, a NamedRockUnit resource"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/isSourceInfoFor"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/PUB> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasSourceInfoType>
    rdfs:label "has reference source info type"@en ;
    rdfs:comment "Links a SourceInfo resource to a SourceReferenceType, indicating if the reference is a principal or non-principal reference"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasSpatialScopeOfDefinition>
    rdfs:label "definition has spatial scope"@en ;
    rdfs:comment "Property links to a named spatial scope in which the definition applies"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasStratotypeType>
    rdfs:label "Type of Stratotype"@en ;
    rdfs:comment "Type of Stratotype"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasTheme>
    rdfs:label "has theme"@en ;
    rdfs:comment "Property links to the geological theme that the rock unit is assigned to"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasThicknessDescription>
    rdfs:label "has thickness description"@en ;
    rdfs:comment "Property describes the thickness of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasTypeLocality>
    rdfs:label "has Type Locality"@en ;
    rdfs:comment "Links a NamedRockUnit to a TypeLocality, giving the real life locations where the rock unit is defined and illustrated"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/isTypeLocalityFor"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/EXT> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasTypeLocalityType>
    rdfs:label "is of Type Locality type"@en ;
    rdfs:comment "Links a TypeLocality to a TypeLocalityType, indicating whether the type locality is a definition or an illustration of the rock unit"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasUnitClass>
    rdfs:label "has classification"@en ;
    rdfs:comment "Property links to the classification of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/HIER> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasUpperBoundaryDefinition>
    rdfs:label "has upper boundary definition"@en ;
    rdfs:comment "Property describes the upper boundary of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/DESC> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasYoungestAge>
    rdfs:label "has youngest age"@en ;
    rdfs:comment "Property links to the youngest geological age of the rock unit"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/hasYoungestAgeValue>
    rdfs:label "has youngest age value"@en ;
    rdfs:comment "Property describes the youngest age of the rock unit in millions of years before the present (Ma)"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/AGE> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isContainedByMapSheet>
    rdfs:label "is contained by map sheet extent"@en ;
    rdfs:comment "The 50k map sheet code which a Named Rock Unit has been mapped on"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isLateralEquivalentInRelationship>
    rdfs:label "is laterally equivalent in"@en ;
    rdfs:comment "Property links to a relationship where this lexicon entry is the geographically laterally equivalent one to another lexicon entry"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isObsoleteEquivalentInRelationship>
    rdfs:label "is obsolete equivalent in"@en ;
    rdfs:comment "Property links to a relationship between this lexicon entry and one that it is replaced by"@en ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isObsoleteEquivalentOf>
    rdfs:label "is obsolete equivalent of"@en ;
    rdfs:comment "Property links to an equivalent rock unit term that replaced this obsolete term"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/hasObsoleteEquivalent"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/REL> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isSourceInfoFor>
    rdfs:label "is reference source info for"@en ;
    rdfs:comment "Property links to a NamedRockUnit that this reference source information defines"@en ;
    owl:inverseOf "http://data.bgs.ac.uk/ref/Lexicon/hasSourceInfo"^^xsd:anyURI ;
    sh:group <http://data.bgs.ac.uk/id/LinkedDataPredicateGroup/PUB> ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isSourceInfoType>
    rdfs:label
        "has reference source info type"@en ,
        "is of source info type"@en ;
    rdfs:comment "Links a SourceInfo resource to a SourceReferenceType, indicating the type of reference e.g. principal or non-principal"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isStratotypeFor>
    rdfs:label "Is Stratotype for"@en ;
    rdfs:comment "Is Stratotype for"@en ;
.

<http://data.bgs.ac.uk/ref/Lexicon/isTypeLocalityFor>
    rdfs:label "is Type Locality for"@en ;
